@layout(c) @align(8) @packed @soa pub type Record[T] { dir: Dir
 file: File of .dir, items: Inline[T,4] }
flat type Flat { x: u32 }
resource type Resource { dir: Dir } drop(x) {}
distinct type Percent(v: u8) where v <= 100
type Choice = A | B(u32) | C(x: box Choice)
type Single = Single()
type Alias = Map[String,T]
@capability(global) pub opaque type Cap: plain uses {Cap}
pub const C: u32 = comptime f()

