// Inputs beyond the corpus step budget: 100 KB of words, 70 KB of noise and
// 200 KB of byte runs, so the window slides, blocks split at 16383 symbols and
// stored blocks win, at every level. Lengths and CRC-32s of zlib 1.3's raw
// deflate output (madler/zlib 09155ea, windowBits 15, memLevel 8); each input is
// also compressed in uneven pieces and must decode back.
fn corpus(kind: u64, size: u64) -> unique Bytes {
  let words: List[String] = [
    "the ",
    "sheep ",
    "graze ",
    "on ",
    "a ",
    "hill ",
    "while ",
    "wolves ",
    "watch\n",
    "quietly, ",
    "zlib ",
    "deflate "
  ]
  let mut out: List[u8] = []
  let mut x: u64 = 12345
  while core@1/list.len(out) < size {
    x = core@1/int.wrapping_add(
      u64.wrapping_mul(x, 6364136223846793005),
      1442695040888963407
    )
    if kind == 0 {
      let w = words[(x >> 33) % 12]
      for b in string.as_bytes(w) {
        if core@1/list.len(out) < size {
          list.push(mut out, b)
        }
      }
    } else if kind == 1 {
      list.push(mut out, core@1/int.truncate(x >> 56))
    } else {
      let n = (x >> 40) % 300
      let b: u8 = core@1/int.truncate(x >> 32 & 3)
      let mut i: u64 = 0
      while i < n && core@1/list.len(out) < size {
        list.push(mut out, b)
        i += 1
      }
    }
  }
  core@1/bytes.from_list(take out)
}

const LENGTHS: Inline[u64, 30] = [
  100010,
  21304,
  19906,
  17396,
  17270,
  16038,
  14845,
  14188,
  13779,
  13779,
  70010,
  70025,
  70025,
  70025,
  70025,
  70025,
  70025,
  70025,
  70025,
  70025,
  200020,
  4110,
  4046,
  3989,
  3083,
  3131,
  2960,
  2790,
  2031,
  1851
]

const CRCS: Inline[u32, 30] = [
  0x5beb3b45,
  0x92d72d85,
  0x482170a9,
  0x671b15a6,
  0xb3350fd5,
  0x19faf51a,
  0x900a856b,
  0x6c7fa3ca,
  0x997555eb,
  0x997555eb,
  0x66b1b310,
  0x85efabd5,
  0x85efabd5,
  0x85efabd5,
  0xeb3ecdd8,
  0xeb3ecdd8,
  0xeb3ecdd8,
  0xeb3ecdd8,
  0xeb3ecdd8,
  0xeb3ecdd8,
  0x063d2b08,
  0x22be846c,
  0xabf3f109,
  0x0ddb8117,
  0x60d23088,
  0xc13d622f,
  0x7b146ecf,
  0x52a36225,
  0xf006892f,
  0xc9ba8208
]

pub fn main() -> Result[(), ()] {
  let sizes: List[u64] = [100000, 70000, 200000]
  for kind in 0u64..3 {
    let data = corpus(kind, sizes[kind])
    for level in 0u64..10 {
      let z = flate.deflate(data, level)
      let row = kind * 10 + level
      failure.check(
        core@1/bytes.len(z) == LENGTHS[row] && crc32.digest(z) == CRCS[row],
        Arithmetic()
      )
      let mut e = flate.encoder(Raw(), level)
      let mut s: List[u8] = []
      let mut at: u64 = 0
      let mut step: u64 = 1
      while at < core@1/bytes.len(data) {
        let mut end = at + step
        if end > core@1/bytes.len(data) {
          end = core@1/bytes.len(data)
        }
        flate.encode(mut e, core@1/bytes.slice(data, at, end), mut s)
        at = end
        step = step * 3 + 7
        if step > 40000 {
          step = 5
        }
      }
      flate.finish(mut e, mut s)
      failure.check(core@1/bytes.from_list(take s) == z, Arithmetic())
      failure.check(flate.inflate(z, sizes[kind]) == Ok(copy data), Arithmetic())
    }
  }
  Ok(())
}
