// rust-lang/regex 80b9d14e testdata vectors (MIT; third-party/LICENSE.regex).
// Original expected spans/captures are unchanged. Forced candidates are also
// checked at every start, independently of public eligibility thresholds.
fn check(pattern: String, source: String, maximum: u64, expected: List[regex.Captures]) -> Result[(), ()] {
  let Ok(re) = regex.compile(pattern, 10000) else { return Error(()) }
  failure.check(regex.find_all_captures(re, source, maximum, 18446744073709551615) == Ok(expected), TextInvariant())
  failure.check(regex.prefilter_test_case(pattern, source), TextInvariant())
  Ok(())
}
pub fn main() -> Result[(), ()] {
