// Ryū d2d (d2s.c:91): the shortest decimal (output, exponent), output * 10^exponent,
// that rounds to the binary64 with these IEEE fields, the closest one on a tie of
// length. Every finite nonzero value; the caller spells zero, infinity and NaN.
@noalloc
fn retained_shortest64(ieee_mantissa: u64, ieee_exponent: u64) -> (u64, i32) uses {} {
  match small_integer64(ieee_mantissa, ieee_exponent) {
    Some(small) => return small,
    None => (),
  }
  // Step 1: unify normal and subnormal; e2 is two less for the two bound bits.
  let biased: i32 = core@1/int.narrow(ieee_exponent)
  let e2: i32 = if ieee_exponent == 0 {
    1 - 1023 - 52 - 2
  } else {
    biased - 1023 - 52 - 2
  }
  let m2: u64 = if ieee_exponent == 0 {
    ieee_mantissa
  } else {
    1u64 << 52 | ieee_mantissa
  }
  let accept_bounds = m2 & 1 == 0
  // Step 2: the interval of valid decimal representations.
  let mv = 4 * m2
  let mm_shift: u64 = if ieee_mantissa != 0 || ieee_exponent <= 1 {
    1
  } else {
    0
  }
  // Step 3: convert to a decimal power base with 128-bit products.
  let mut vr: u64 = 0
  let mut vp: u64 = 0
  let mut vm: u64 = 0
  let mut e10: i32 = 0
  let mut vm_is_trailing_zeros = false
  let mut vr_is_trailing_zeros = false
  if e2 >= 0 {
    let q = log10_pow2(e2) - if e2 > 3 {
      1
    } else {
      0
    }
    e10 = q
    let k = 125 + pow5bits(q) - 1
    let i = -e2 + q + k
    let index: u64 = core@1/int.narrow(q * 2)
    let low = DOUBLE_POW5_INV_SPLIT[index]
    let high = DOUBLE_POW5_INV_SPLIT[index + 1]
    vr = mul_shift64(mv, low, high, i)
    vp = mul_shift64(mv + 2, low, high, i)
    vm = mul_shift64(mv - 1 - mm_shift, low, high, i)
    if q <= 21 {
      // Only one of mp, mv and mm can be a multiple of 5, if any.
      if mv % 5 == 0 {
        vr_is_trailing_zeros = multiple_of_power_of5(mv, q)
      } else if accept_bounds {
        vm_is_trailing_zeros = multiple_of_power_of5(mv - 1 - mm_shift, q)
      } else if multiple_of_power_of5(mv + 2, q) {
        vp -= 1
      }
    }
  } else {
    let q = log10_pow5(-e2) - if -e2 > 1 {
      1
    } else {
      0
    }
    e10 = q + e2
    let i = -e2 - q
    let k = pow5bits(i) - 125
    let j = q - k
    let index: u64 = core@1/int.narrow(i * 2)
    let low = DOUBLE_POW5_SPLIT[index]
    let high = DOUBLE_POW5_SPLIT[index + 1]
    vr = mul_shift64(mv, low, high, j)
    vp = mul_shift64(mv + 2, low, high, j)
    vm = mul_shift64(mv - 1 - mm_shift, low, high, j)
    if q <= 1 {
      // mv = 4 * m2 has at least two trailing zero bits, mp = mv + 2 one.
      vr_is_trailing_zeros = true
      if accept_bounds {
        vm_is_trailing_zeros = mm_shift == 1
      } else {
        vp -= 1
      }
    } else if q < 63 {
      vr_is_trailing_zeros = multiple_of_power_of2(mv, q)
    }
  }
  // Step 4: the shortest representation in the interval.
  let mut removed: i32 = 0
  let mut output: u64 = 0
  if vm_is_trailing_zeros || vr_is_trailing_zeros {
    // The general case (about 0.7%).
    let mut last_removed_digit: u64 = 0
    while vp / 10 > vm / 10 {
      vm_is_trailing_zeros = vm_is_trailing_zeros && vm % 10 == 0
      vr_is_trailing_zeros = vr_is_trailing_zeros && last_removed_digit == 0
      last_removed_digit = vr % 10
      vr /= 10
      vp /= 10
      vm /= 10
      removed += 1
    }
    if vm_is_trailing_zeros {
      while vm % 10 == 0 {
        vr_is_trailing_zeros = vr_is_trailing_zeros && last_removed_digit == 0
        last_removed_digit = vr % 10
        vr /= 10
        vp /= 10
        vm /= 10
        removed += 1
      }
    }
    if vr_is_trailing_zeros && last_removed_digit == 5 && vr % 2 == 0 {
      // Round to even when the exact value is .....50..0.
      last_removed_digit = 4
    }
    output = vr + if vr == vm && (!accept_bounds || !vm_is_trailing_zeros) || last_removed_digit >= 5 {
      1
    } else {
      0
    }
  } else {
    // The common case (about 99.3%), removing two digits at a time first.
    let mut round_up = false
    if vp / 100 > vm / 100 {
      round_up = vr % 100 >= 50
      vr /= 100
      vp /= 100
      vm /= 100
      removed += 2
    }
    while vp / 10 > vm / 10 {
      round_up = vr % 10 >= 5
      vr /= 10
      vp /= 10
      vm /= 10
      removed += 1
    }
    output = vr + if vr == vm || round_up {
      1
    } else {
      0
    }
  }
  (output, e10 + removed)
}
