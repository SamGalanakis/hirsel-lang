resource type Item {
  key: u64,
  id: u64,
  output: Stdout,
}
drop(x) {
  let _ = out.print(x.output, f"D {x.id}\n")
}

@noalloc
fn compare(a: Item, b: Item) -> i32 uses {} {
  if a.id == 41 {
    failure.check(false, Bounds())
  }
  if a.key < b.key {
    -1i32
  } else if a.key > b.key {
    1i32
  } else {
    0i32
  }
}

pub fn main(rt: Io, args: Args) -> Result[(), String] {
  let output = match io.stdout(rt) {
    Ok(o) => o,
    Error(_) => return Error("stdout"),
  }
  let mut input: List[Item] = []
  for i in 0u64..129u64 {
    list.push(mut input, Item(key: (i * 37 + 13) % 17, id: i, output: output))
  }
  let mut xs = unique take input
  list.sort(mut xs, compare)
  let mut seen: Inline[bool, 129] = [false; 129]
  let mut h: u64 = 0
  for i in 0u64..list.len(xs) {
    failure.check(xs[i].id < 129 && !seen[xs[i].id], Bounds())
    seen[xs[i].id] = true
    if i > 0 {
      failure.check(xs[i - 1].key <= xs[i].key, Bounds())
    }
    h = int.wrapping_add(u64.wrapping_mul(h, 31u64), xs[i].id)
  }
  let _ = out.print(output, f"H {h}\n")
  Ok(())
}
