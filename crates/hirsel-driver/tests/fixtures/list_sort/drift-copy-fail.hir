type Item { key: u64, id: u64 }
// Plain values use direct scratch; fail at the same Rust comparison site.

@noalloc
fn compare(a: Item, b: Item) -> i32 uses {} {
  if a.id == 41 { failure.check(false, Bounds()) }
  if b.id == 41 { failure.check(false, Arithmetic()) }
  if a.key < b.key { -1i32 } else if a.key > b.key { 1i32 } else { 0i32 }
}

pub fn main(rt: Io, args: Args) -> Result[(), String] {
  let output = match io.stdout(rt) { Ok(o) => o, Error(_) => return Error("stdout") }
  let mut input: List[Item] = []
  for i in 0u64..129u64 {
    list.push(mut input, Item(key: (i * 37 + 13) % 17, id: i))
  }
  let mut xs = unique take input
  list.sort_stable_plain(mut xs, compare)
  for i in 1u64..129u64 {
    failure.check(xs[i - 1].key <= xs[i].key, Bounds())
    if xs[i - 1].key == xs[i].key {
      failure.check(xs[i - 1].id < xs[i].id, Bounds())
    }
  }
  Ok(())
}
