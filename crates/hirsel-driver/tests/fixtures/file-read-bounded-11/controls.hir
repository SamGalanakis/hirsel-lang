// Tiny max-u64 case is also run in the allocation-audited heap executor.
pub fn main(t: Test) -> Result[(), FileError] {
  let d = test.dir(t, [(path.of("tiny"), b"\x00\xffx")])
  let mut f = file.open(d, path.of("tiny"))?
  match file.read_all_bounded(d, mut f, 18446744073709551615u64) {
    Ok(data) => {
      let owned: unique Bytes = take data
      test.check(t, owned == b"\x00\xffx")
    },
    Error(_) => test.check(t, false),
  }
  let mut next: List[u8] = []
  test.check(t, file.read(d, mut f, mut next, 1)? == 0)
  // A writable handle produces a real read error. Compare it with the core
  // operation rather than baking in a host-specific fault code.
  let mut writable = file.create(d, path.of("write-only"))?
  let direct = file.read(d, mut writable, mut next, 1)
  match direct {
    Error(e) => test.check(
      t,
      file.read_all_bounded(d, mut writable, 4) == Error(File(e))
    ),
    Ok(_) => test.check(t, false),
  }
  match file.read(d, mut writable, mut next, 1) {
    Error(e) => test.check(
      t,
      file.read_all_bounded(d, mut writable, 0) == Error(File(e))
    ),
    Ok(_) => test.check(t, false),
  }
  Ok(())
}
