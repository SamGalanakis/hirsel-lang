// Go writer_test.go:22-118, all 29 binary-mode vectors; BSD-3-Clause.
// Independent 72-77 column/tab edges and complete 00-FF byte control follow.
fn writer(data: Bytes, expected: String) -> () uses {} {
  let encoded = std@1/quoted_printable.encode(data)
  failure.check(encoded == expected, TextInvariant())
  failure.check(
    std@1/quoted_printable.decode(string.as_bytes(encoded)) == Ok(data),
    TextInvariant()
  )
  let wire = string.as_bytes(encoded)
  let mut i: u64 = 0
  let mut column: u64 = 0
  while i < bytes.len(wire) {
    if wire[i] == b'=' {
      if i + 2 < bytes.len(wire) && wire[i + 1] == b'\r' {
        failure.check(wire[i + 2] == b'\n' && column <= 75, TextInvariant())
        column = 0
      } else {
        failure.check(i + 2 < bytes.len(wire), TextInvariant())
        failure.check(
          std@1/ascii.digit_value_radix(wire[i + 1], 16) != None(),
          TextInvariant()
        )
        failure.check(
          std@1/ascii.digit_value_radix(wire[i + 2], 16) != None(),
          TextInvariant()
        )
        column += 3
      }
      i += 3
    } else {
      failure.check(wire[i] != b'\r' && wire[i] != b'\n', TextInvariant())
      column += 1
      i += 1
    }
    failure.check(column <= 75, TextInvariant())
  }
}

