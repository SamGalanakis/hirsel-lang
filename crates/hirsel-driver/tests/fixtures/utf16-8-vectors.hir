fn check(units: List[u16], expected: String, invalid: Option[u64]) -> () {
  failure.check(std@1/utf16.decode_lossy(units) == expected, TextInvariant())
  match invalid {
    Some(index) => failure.check(std@1/utf16.decode_strict(units) == Error(std@1/utf16.DecodeError(index: index)), TextInvariant()),
    None() => {
      failure.check(std@1/utf16.decode_strict(units) == Ok(expected), TextInvariant())
      failure.check(std@1/utf16.encode(expected) == units, TextInvariant())
    },
  }
}

pub fn main() -> Result[(), ()] {
  check([0x0001u16, 0x0002u16, 0x0003u16, 0x0004u16], "\u{1}\u{2}\u{3}\u{4}", None())
  check([0xffffu16, 0xd800u16, 0xdc00u16, 0xd800u16, 0xdc01u16, 0xd808u16, 0xdf45u16, 0xdbffu16, 0xdfffu16], "\u{ffff}\u{10000}\u{10001}\u{12345}\u{10ffff}", None())
  check([0xd800u16, 0x0061u16], "\u{fffd}\u{61}", Some(0))
  check([0xdfffu16], "\u{fffd}", Some(0))
  check([], "", None())
  check([0x0000u16], "\u{0}", None())
  check([0xfeffu16], "\u{feff}", None())
  check([0x0061u16, 0x0000u16, 0xfeffu16, 0x0062u16], "\u{61}\u{0}\u{feff}\u{62}", None())
  check([0xd7ffu16, 0xe000u16, 0xffffu16], "\u{d7ff}\u{e000}\u{ffff}", None())
  check([0xd800u16], "\u{fffd}", Some(0))
  check([0xdbffu16], "\u{fffd}", Some(0))
  check([0xdc00u16], "\u{fffd}", Some(0))
  check([0xd800u16, 0xd800u16, 0xdc00u16], "\u{fffd}\u{10000}", Some(0))
  check([0xdbffu16, 0xdbffu16, 0xdfffu16], "\u{fffd}\u{10ffff}", Some(0))
  check([0xd800u16, 0xdc00u16, 0xdc00u16, 0x0061u16, 0xd800u16], "\u{10000}\u{fffd}\u{61}\u{fffd}", Some(2))
  check([0x0061u16, 0xd800u16, 0xdc00u16, 0x0062u16, 0xdbffu16, 0x0063u16], "\u{61}\u{10000}\u{62}\u{fffd}\u{63}", Some(4))
  check([0xd800u16, 0x0061u16, 0xdc00u16, 0x0062u16, 0xdbffu16, 0x0063u16, 0xdfffu16], "\u{fffd}\u{61}\u{fffd}\u{62}\u{fffd}\u{63}\u{fffd}", Some(0))
  check([0xd7ffu16, 0xd7ffu16], "\u{d7ff}\u{d7ff}", None())
  check([0xd7ffu16, 0xd800u16], "\u{d7ff}\u{fffd}", Some(1))
  check([0xd7ffu16, 0xdbffu16], "\u{d7ff}\u{fffd}", Some(1))
  check([0xd7ffu16, 0xdc00u16], "\u{d7ff}\u{fffd}", Some(1))
  check([0xd7ffu16, 0xdfffu16], "\u{d7ff}\u{fffd}", Some(1))
  check([0xd7ffu16, 0xe000u16], "\u{d7ff}\u{e000}", None())
  check([0xd800u16, 0xd7ffu16], "\u{fffd}\u{d7ff}", Some(0))
  check([0xd800u16, 0xd800u16], "\u{fffd}\u{fffd}", Some(0))
  check([0xd800u16, 0xdbffu16], "\u{fffd}\u{fffd}", Some(0))
  check([0xd800u16, 0xdc00u16], "\u{10000}", None())
  check([0xd800u16, 0xdfffu16], "\u{103ff}", None())
  check([0xd800u16, 0xe000u16], "\u{fffd}\u{e000}", Some(0))
  check([0xdbffu16, 0xd7ffu16], "\u{fffd}\u{d7ff}", Some(0))
  check([0xdbffu16, 0xd800u16], "\u{fffd}\u{fffd}", Some(0))
  check([0xdbffu16, 0xdbffu16], "\u{fffd}\u{fffd}", Some(0))
  check([0xdbffu16, 0xdc00u16], "\u{10fc00}", None())
  check([0xdbffu16, 0xdfffu16], "\u{10ffff}", None())
  check([0xdbffu16, 0xe000u16], "\u{fffd}\u{e000}", Some(0))
  check([0xdc00u16, 0xd7ffu16], "\u{fffd}\u{d7ff}", Some(0))
  check([0xdc00u16, 0xd800u16], "\u{fffd}\u{fffd}", Some(0))
  check([0xdc00u16, 0xdbffu16], "\u{fffd}\u{fffd}", Some(0))
  check([0xdc00u16, 0xdc00u16], "\u{fffd}\u{fffd}", Some(0))
  check([0xdc00u16, 0xdfffu16], "\u{fffd}\u{fffd}", Some(0))
  check([0xdc00u16, 0xe000u16], "\u{fffd}\u{e000}", Some(0))
  check([0xdfffu16, 0xd7ffu16], "\u{fffd}\u{d7ff}", Some(0))
  check([0xdfffu16, 0xd800u16], "\u{fffd}\u{fffd}", Some(0))
  check([0xdfffu16, 0xdbffu16], "\u{fffd}\u{fffd}", Some(0))
  check([0xdfffu16, 0xdc00u16], "\u{fffd}\u{fffd}", Some(0))
  check([0xdfffu16, 0xdfffu16], "\u{fffd}\u{fffd}", Some(0))
  check([0xdfffu16, 0xe000u16], "\u{fffd}\u{e000}", Some(0))
  check([0xe000u16, 0xd7ffu16], "\u{e000}\u{d7ff}", None())
  check([0xe000u16, 0xd800u16], "\u{e000}\u{fffd}", Some(1))
  check([0xe000u16, 0xdbffu16], "\u{e000}\u{fffd}", Some(1))
  check([0xe000u16, 0xdc00u16], "\u{e000}\u{fffd}", Some(1))
  check([0xe000u16, 0xdfffu16], "\u{e000}\u{fffd}", Some(1))
  check([0xe000u16, 0xe000u16], "\u{e000}\u{e000}", None())
  check([0xd800u16, 0xdc00u16], "\u{10000}", None())
  check([0xd800u16, 0xdfffu16], "\u{103ff}", None())
  check([0xdbffu16, 0xdc00u16], "\u{10fc00}", None())
  check([0xdbffu16, 0xdfffu16], "\u{10ffff}", None())
  let mut units: List[u16] = [0x41u16, 0xd800u16, 0xdc00u16]
  let output = std@1/utf16.decode_lossy(units)
  units[0] = 0x42u16
  failure.check(output == "A\u{10000}", TextInvariant())
  let original = "A\0\u{feff}\u{10ffff}"
  let mut encoded = std@1/utf16.encode(original)
  encoded[0] = 0x42u16
  failure.check(original == "A\0\u{feff}\u{10ffff}", TextInvariant())
  Ok(())
}
