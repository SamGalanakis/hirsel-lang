// Inputs past the corpus step budget: 900 lines a side from a fixed linear
// congruential generator, where the new side copies runs of 30 old lines
// between single random lines, so Myers' search costs more than 256 and its
// cutoff gives up minimality (624 changed lines against 608). Expected unified
// diffs are imara-diff's (pascalkuthe/imara-diff f02e46a7) Algorithm::Myers,
// Algorithm::MyersMinimal and Algorithm::Histogram with
// postprocess_no_heuristic, printed as git diff -U3 prints hunks. git 2.43.0
// agrees for --minimal and --histogram; its default myers heuristic picks
// another non-minimal split here.
fn lcg(x: u64) -> u64 uses {} {
  (x * 1103515245 + 12345) % 2147483648
}

fn line(x: u64) -> unique String uses {} {
  string.concat(string.concat("l", u64.to_string((x >> 8) % 200)), "\n")
}

fn inputs() -> (String, String) uses {} {
  let mut x: u64 = 1
  let mut old: List[String] = []
  for _ in 0u64..900 {
    x = lcg(x)
    list.push(mut old, line(x))
  }
  let mut new: List[String] = []
  let mut i: u64 = 0
  while i < 900 {
    x = lcg(x)
    if (x >> 8) % 16 == 0 {
      let mut k = i
      while k < i + 30 && k < 900 {
        list.push(mut new, unique old[k])
        k += 1
      }
      i += 30
    } else {
      x = lcg(x)
      list.push(mut new, line(x))
      i += 1
    }
  }
  (string.join(old, ""), string.join(new, ""))
}

