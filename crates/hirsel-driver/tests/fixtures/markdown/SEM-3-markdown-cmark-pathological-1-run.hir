// rule: SEM-3
// expect: run
// Pinned upstream vectors; tools/generate-markdown-hostile.py.
// cmark-gfm test/pathological_tests.py:14-121; nested strong emph
// Each program is bounded by the corpus step budget and runner timeout.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  let mut options = std@1/markdown.default_options()
  options.tables = true
  failed += harness.check(
    s,
    "cmark-pathological/1",
    "*a **a *a **a *a **a *a **a *a **a *a **a *a **a *a **a *a **a *a **a *a **a *a **a *a **a *a **a *a **a *a **a *a **a *a **a *a **a *a **a *a **a *a **a *a **a *a **a b a** a* a** a* a** a* a** a* a** a* a** a* a** a* a** a* a** a* a** a* a** a* a** a* a** a* a** a* a** a* a** a* a** a* a** a* a** a* a** a* a** a* a** a* a** a* a** a*",
    "<p><em>a <strong>a <em>a <strong>a <em>a <strong>a <em>a <strong>a <em>a <strong>a <em>a <strong>a <em>a <strong>a <em>a <strong>a <em>a <strong>a <em>a <strong>a <em>a <strong>a <em>a <strong>a <em>a <strong>a <em>a <strong>a <em>a <strong>a <em>a <strong>a <em>a <strong>a <em>a <strong>a <em>a <strong>a <em>a <strong>a <em>a <strong>a <em>a <strong>a <em>a <strong>a <em>a <strong>a b a</strong> a</em> a</strong> a</em> a</strong> a</em> a</strong> a</em> a</strong> a</em> a</strong> a</em> a</strong> a</em> a</strong> a</em> a</strong> a</em> a</strong> a</em> a</strong> a</em> a</strong> a</em> a</strong> a</em> a</strong> a</em> a</strong> a</em> a</strong> a</em> a</strong> a</em> a</strong> a</em> a</strong> a</em> a</strong> a</em> a</strong> a</em> a</strong> a</em> a</strong> a</em> a</strong> a</em></p>\n",
    options
  )
  failed += harness.check(
    s,
    "cmark-pathological/1/malformed",
    "*a **a *a **a *a **a *a **a *a **a *a **a *a **a *a **a *a **a *a **a *a **a *a **a *a **a *a **a *a **a *a **a *a **a *a **a *a **a *a **a *a **a *a **a *a **a *a **a \u{0}[&unterminated",
    "<p>*a **a *a **a *a **a *a **a *a **a *a **a *a **a *a **a *a **a *a **a *a **a *a **a *a **a *a **a *a **a *a **a *a **a *a **a *a **a *a **a *a **a *a **a *a **a *a **a �[&amp;unterminated</p>\n",
    options
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
