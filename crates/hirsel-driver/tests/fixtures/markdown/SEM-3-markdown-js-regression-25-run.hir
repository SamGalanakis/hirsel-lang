// rule: SEM-3
// expect: run
// Pinned upstream vectors; tools/generate-markdown-hostile.py.
// js test/regression.txt:257
// Each program is bounded by the corpus step budget and runner timeout.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  let mut options = std@1/markdown.default_options()
  failed += harness.check(
    s,
    "js-regression/25",
    "## Case 1\n\n- > a\n  >\n- b\n\n\n## Case 2\n\n- > - a\n  >\n- b\n\n\n## Case 3\n\n- > > a\n  >\n- b\n\n\n## Case 4\n\n- > # a\n  >\n- b\n\n\n## Case 5\n\n- ```\n  The following line is part of code block.\n\n- b\n\n## Case 6\n\n-     The following line is **not** part of code block.\n      \n- b\n\n## Case 7\n\n- <pre>The following line is part of HTML block.\n\n- </pre>\n- b\n",
    "<h2>Case 1</h2>\n<ul>\n<li>\n<blockquote>\n<p>a</p>\n</blockquote>\n</li>\n<li>b</li>\n</ul>\n<h2>Case 2</h2>\n<ul>\n<li>\n<blockquote>\n<ul>\n<li>a</li>\n</ul>\n</blockquote>\n</li>\n<li>b</li>\n</ul>\n<h2>Case 3</h2>\n<ul>\n<li>\n<blockquote>\n<blockquote>\n<p>a</p>\n</blockquote>\n</blockquote>\n</li>\n<li>b</li>\n</ul>\n<h2>Case 4</h2>\n<ul>\n<li>\n<blockquote>\n<h1>a</h1>\n</blockquote>\n</li>\n<li>b</li>\n</ul>\n<h2>Case 5</h2>\n<ul>\n<li>\n<pre><code>The following line is part of code block.\n\n</code></pre>\n</li>\n<li>b</li>\n</ul>\n<h2>Case 6</h2>\n<ul>\n<li>\n<pre><code>The following line is **not** part of code block.\n</code></pre>\n</li>\n<li>\n<p>b</p>\n</li>\n</ul>\n<h2>Case 7</h2>\n<ul>\n<li>\n<pre>The following line is part of HTML block.\n\n</li>\n<li>\n</pre>\n</li>\n<li>b</li>\n</ul>\n",
    options
  )
  failed += harness.check(
    s,
    "js-regression/25/malformed",
    "## Case 1\n\n- > a\n  >\n- b\n\n\n## Case 2\n\n- > - a\n  >\n- b\n\n\n## Case 3\n\n- > > a\n  >\n- b\n\n\n## Case 4\n\n- > # a\n  >\n- b\n\n\n## Case 5\n\n- ```\n  The following line is part of code\u{0}[&unterminated",
    "<h2>Case 1</h2>\n<ul>\n<li>\n<blockquote>\n<p>a</p>\n</blockquote>\n</li>\n<li>b</li>\n</ul>\n<h2>Case 2</h2>\n<ul>\n<li>\n<blockquote>\n<ul>\n<li>a</li>\n</ul>\n</blockquote>\n</li>\n<li>b</li>\n</ul>\n<h2>Case 3</h2>\n<ul>\n<li>\n<blockquote>\n<blockquote>\n<p>a</p>\n</blockquote>\n</blockquote>\n</li>\n<li>b</li>\n</ul>\n<h2>Case 4</h2>\n<ul>\n<li>\n<blockquote>\n<h1>a</h1>\n</blockquote>\n</li>\n<li>b</li>\n</ul>\n<h2>Case 5</h2>\n<ul>\n<li>\n<pre><code>The following line is part of code�[&amp;unterminated\n</code></pre>\n</li>\n</ul>\n",
    options
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
