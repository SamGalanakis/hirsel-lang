// Missing nested hooks: accepted twin is examples/schema-recipes/main.hir.
type Service {
  name: String,
}

type Retry {
  attempts: u32,
}

type Outer {
  service: Service,
  retry: Retry,
}

fn outer_schema_encode(value: Outer, mut check: schema.CheckState) -> Result[
  unique json.Value,
  schema.SchemaError
] uses {} = comptime derive.schema_encode(shape(Outer), schema.strict_policy())
