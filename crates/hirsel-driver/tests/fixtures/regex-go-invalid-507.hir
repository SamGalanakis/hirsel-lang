// Go syntax/parse_test.go:507 (ebe2feef; BSD-3-Clause).
// Exact vector exceeds the corpus 1M-step budget; run by stdlib_patterns.rs.
fn invalid(pattern: String, size_error: bool) {
  failure.check(
    match regex.compile(pattern, 1000) {
      Error(Syntax(_)) => !size_error,
      Error(ProgramTooLarge()) => size_error,
      _ => false,
    },
    TextInvariant()
  )
}

