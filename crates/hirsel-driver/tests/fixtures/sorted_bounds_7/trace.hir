@noalloc
fn compare(a: u64, b: u64) -> i32 uses {} {
  if a < b {
    -1i32
  } else if a > b {
    1i32
  } else {
    0i32
  }
}

pub fn probe(n: u64, value: u64, operation: u64) -> (u64, u64) {
  let mut xs: List[u64] = []
  for i in 0u64..n {
    list.push(
      mut xs,
      if operation >= 3 {
        0u64
      } else {
        i / 3
      }
    )
  }
  if operation % 3 == 0 {
    let i = sorted.lower_bound(xs, value, compare)
    (i, i)
  } else if operation % 3 == 1 {
    let i = sorted.upper_bound(xs, value, compare)
    (i, i)
  } else {
    sorted.equal_range(xs, value, compare)
  }
}

pub fn main() -> Result[(), ()] {
  Ok(())
}
