// Expectations are generated by the host oracle, never by Hirsel operations.
type Expected {
  data: Bytes,
  text: String,
  scalars: List[char],
  offsets: List[u64],
  slices: List[String],
}

fn builder(data: Bytes) -> List[u8] {
  let mut out: List[u8] = []
  for byte in data {
    list.push(mut out, byte)
  }
  take out
}

fn accept(take expected: Expected, take composed: Expected) -> () {
  let input = copy expected.data
  let Ok(decoded) = string.from_bytes(copy input) else {
    failure.check(false, TextInvariant())
    return
  }
  views(decoded, expected)
  let raw = builder(input)
  let Ok(finished) = std@1/text.finish(copy raw) else {
    failure.check(false, TextInvariant())
    return
  }
  views(finished, expected)
  // The original byte/list inputs remain reusable after finishing owned copies.
  failure.check(input == expected.data, TextInvariant())
  failure.check(bytes.from_list(copy raw) == expected.data, TextInvariant())
  let mut out: List[u8] = []
  std@1/text.append(mut out, "é")
  std@1/text.append(mut out, decoded)
  std@1/text.append(mut out, "𐀀")
  let appended = std@1/text.finish_valid(take out)
  views(appended, composed)
  let joined = string.concat(string.concat("é", finished), "𐀀")
  views(joined, composed)
  let formatted = f"é{decoded}𐀀"
  views(formatted, composed)
  // Whole-buffer lossy decoding is an additional valid-String constructor control.
  views(std@1/utf8.decode_lossy(input), expected)
}

fn reject(take input: Bytes) -> () {
  match string.from_bytes(copy input) {
    Ok(_) => failure.check(false, TextInvariant()),
    Error(returned) => failure.check(returned == input, TextInvariant()),
  }
  match std@1/text.finish(builder(input)) {
    Ok(_) => failure.check(false, TextInvariant()),
    Error(returned) => failure.check(returned == input, TextInvariant()),
  }
  failure.check(bytes.from_list(builder(input)) == input, TextInvariant())
}
