// rule: SEM-3
// expect: run
// Independent exact-rational, ties-to-even oracle; Rust Clinger bounds and twins.
fn check64(text: String, expected: u64) -> () uses {} {
  match f64.parse(text) {
    Ok(value) => failure.check(core@1/f64.bits(value) == expected, TextInvariant()),
    _ => failure.check(false, TextInvariant()),
  }
}

fn check32(text: String, expected: u32) -> () uses {} {
  match f32.parse(text) {
    Ok(value) => failure.check(core@1/f32.bits(value) == expected, TextInvariant()),
    _ => failure.check(false, TextInvariant()),
  }
}

