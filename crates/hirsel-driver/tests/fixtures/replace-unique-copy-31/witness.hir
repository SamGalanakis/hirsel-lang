type State[T] { current: T, frontier: List[T] }
fn advance[T: copyable + inert](mut state: unique State[T]) uses {} {
 let candidate = unique state.frontier[0u64]
 let old = replace(mut state.current, take candidate)
}
pub fn main()->Result[(),()] {
 let mut state: unique State[List[i64]] = State(current: [11i64], frontier: [[0i64]])
 advance(mut state)
 Ok(())
}
