// Independent json-patch/specs vectors, revision 1b0f707f9f4aad1009f0364f6ca73c5e88cdd85c.
// MIT, Copyright (c) 2017 Ivan Dubrov; see docs/json-merge-patch-LICENSE-MIT.txt.
fn read(source: String) -> std@1/json.Value uses {} {
  match std@1/json.parse(unique source) {
    Ok(v) => take v,
    Error(_) => {
      core@1/failure.check(false, TextInvariant())
      Null()
    },
  }
}

// Independent structural oracle: map insertion order is deliberately ignored.
// Numeric lexemes in these edit-result vectors are preserved exactly.
fn same_value(a: std@1/json.Value, b: std@1/json.Value) -> bool uses {} {
  match (a, b) {
    (Object(x), Object(y)) => {
      if core@1/map.len(x) != core@1/map.len(y) {
        return false
      }
      for (key, child) in x {
        let Some(other) = core@1/map.get(y, key) else {
          return false
        }
        if !same_value(child, other) {
          return false
        }
      }
      true
    },
    (Array(x), Array(y)) => {
      if core@1/list.len(x) != core@1/list.len(y) {
        return false
      }
      for i in 0u64..core@1/list.len(x) {
        if !same_value(x[i], y[i]) {
          return false
        }
      }
      true
    },
    _ => a == b,
  }
}

fn check_case(doc: String, patch_text: String, expected: String, fails: bool) -> () uses {} {
  let limits = std@1/json_patch.default_limits()
  let original = Some(read(doc))
  let alias = copy original
  let parsed = std@1/json_patch.parse_text(unique patch_text, limits)
  match parsed {
    Error(_) => core@1/failure.check(fails, TextInvariant()),
    Ok(patch) => {
      let outcome = std@1/json_patch.apply(original, patch, limits)
      match outcome {
        Error(_) => core@1/failure.check(fails, TextInvariant()),
        Ok(actual) => {
          core@1/failure.check(!fails, TextInvariant())
          let Some(actual_value) = actual else {
            core@1/failure.check(false, TextInvariant())
            return
          }
          core@1/failure.check(
            same_value(actual_value, read(expected)),
            TextInvariant()
          )
        },
      }
    },
  }
  // Compare both the borrowed input and a retained alias after every outcome.
  let preserved_inputs: List[Option[std@1/json.Value]] = [copy original, copy alias]
  for preserved in preserved_inputs {
    let Some(v) = preserved else {
      core@1/failure.check(false, TextInvariant())
      return
    }
    let Ok(text) = std@1/json.stringify(v) else {
      core@1/failure.check(false, TextInvariant())
      return
    }
    let Ok(original_text) = std@1/json.stringify(read(doc)) else {
      core@1/failure.check(false, TextInvariant())
      return
    }
    core@1/failure.check(text == original_text, TextInvariant())
  }
}

pub fn main() -> Result[(), u64] {
  // 0: 4.1. add with missing object
  check_case(
    "{\"q\":{\"bar\":2}}",
    "[{\"op\":\"add\",\"path\":\"/a/b\",\"value\":1}]",
    "{\"q\":{\"bar\":2}}",
    true
  )
  // 1: A.1.  Adding an Object Member
  check_case(
    "{\"foo\":\"bar\"}",
    "[{\"op\":\"add\",\"path\":\"/baz\",\"value\":\"qux\"}]",
    "{\"baz\":\"qux\",\"foo\":\"bar\"}",
    false
  )
  // 2: A.2.  Adding an Array Element
  check_case(
    "{\"foo\":[\"bar\",\"baz\"]}",
    "[{\"op\":\"add\",\"path\":\"/foo/1\",\"value\":\"qux\"}]",
    "{\"foo\":[\"bar\",\"qux\",\"baz\"]}",
    false
  )
  // 3: A.3.  Removing an Object Member
  check_case(
    "{\"baz\":\"qux\",\"foo\":\"bar\"}",
    "[{\"op\":\"remove\",\"path\":\"/baz\"}]",
    "{\"foo\":\"bar\"}",
    false
  )
  // 4: A.4.  Removing an Array Element
  check_case(
    "{\"foo\":[\"bar\",\"qux\",\"baz\"]}",
    "[{\"op\":\"remove\",\"path\":\"/foo/1\"}]",
    "{\"foo\":[\"bar\",\"baz\"]}",
    false
  )
  // 5: A.5.  Replacing a Value
  check_case(
    "{\"baz\":\"qux\",\"foo\":\"bar\"}",
    "[{\"op\":\"replace\",\"path\":\"/baz\",\"value\":\"boo\"}]",
    "{\"baz\":\"boo\",\"foo\":\"bar\"}",
    false
  )
  // 6: A.6.  Moving a Value
  check_case(
    "{\"foo\":{\"bar\":\"baz\",\"waldo\":\"fred\"},\"qux\":{\"corge\":\"grault\"}}",
    "[{\"op\":\"move\",\"from\":\"/foo/waldo\",\"path\":\"/qux/thud\"}]",
    "{\"foo\":{\"bar\":\"baz\"},\"qux\":{\"corge\":\"grault\",\"thud\":\"fred\"}}",
    false
  )
  // 7: A.7.  Moving an Array Element
  check_case(
    "{\"foo\":[\"all\",\"grass\",\"cows\",\"eat\"]}",
    "[{\"op\":\"move\",\"from\":\"/foo/1\",\"path\":\"/foo/3\"}]",
    "{\"foo\":[\"all\",\"cows\",\"eat\",\"grass\"]}",
    false
  )
  // 8: A.8.  Testing a Value: Success
  check_case(
    "{\"baz\":\"qux\",\"foo\":[\"a\",2,\"c\"]}",
    "[{\"op\":\"test\",\"path\":\"/baz\",\"value\":\"qux\"},{\"op\":\"test\",\"path\":\"/foo/1\",\"value\":2}]",
    "{\"baz\":\"qux\",\"foo\":[\"a\",2,\"c\"]}",
    false
  )
  // 9: A.9.  Testing a Value: Error
  check_case(
    "{\"baz\":\"qux\"}",
    "[{\"op\":\"test\",\"path\":\"/baz\",\"value\":\"bar\"}]",
    "{\"baz\":\"qux\"}",
    true
  )
  // 10: A.10.  Adding a nested Member Object
  check_case(
    "{\"foo\":\"bar\"}",
    "[{\"op\":\"add\",\"path\":\"/child\",\"value\":{\"grandchild\":{}}}]",
    "{\"foo\":\"bar\",\"child\":{\"grandchild\":{}}}",
    false
  )
  // 11: A.11.  Ignoring Unrecognized Elements
  check_case(
    "{\"foo\":\"bar\"}",
    "[{\"op\":\"add\",\"path\":\"/baz\",\"value\":\"qux\",\"xyz\":123}]",
    "{\"foo\":\"bar\",\"baz\":\"qux\"}",
    false
  )
  // 12: A.12.  Adding to a Non-existent Target
  check_case(
    "{\"foo\":\"bar\"}",
    "[{\"op\":\"add\",\"path\":\"/baz/bat\",\"value\":\"qux\"}]",
    "{\"foo\":\"bar\"}",
    true
  )
  // 14: A.14. ~ Escape Ordering
  check_case(
    "{\"/\":9,\"~1\":10}",
    "[{\"op\":\"test\",\"path\":\"/~01\",\"value\":10}]",
    "{\"/\":9,\"~1\":10}",
    false
  )
  // 15: A.15. Comparing Strings and Numbers
  check_case(
    "{\"/\":9,\"~1\":10}",
    "[{\"op\":\"test\",\"path\":\"/~01\",\"value\":\"10\"}]",
    "{\"/\":9,\"~1\":10}",
    true
  )
  // 16: A.16. Adding an Array Value
  check_case(
    "{\"foo\":[\"bar\"]}",
    "[{\"op\":\"add\",\"path\":\"/foo/-\",\"value\":[\"abc\",\"def\"]}]",
    "{\"foo\":[\"bar\",[\"abc\",\"def\"]]}",
    false
  )
  Ok(())
}
