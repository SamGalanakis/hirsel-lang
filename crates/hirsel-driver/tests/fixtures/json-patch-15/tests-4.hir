// Independent json-patch/specs vectors, revision 1b0f707f9f4aad1009f0364f6ca73c5e88cdd85c.
// MIT, Copyright (c) 2017 Ivan Dubrov; see docs/json-merge-patch-LICENSE-MIT.txt.
fn read(source: String) -> std@1/json.Value uses {} {
  match std@1/json.parse(unique source) {
    Ok(v) => take v,
    Error(_) => {
      core@1/failure.check(false, TextInvariant())
      Null()
    },
  }
}

// Independent structural oracle: map insertion order is deliberately ignored.
// Numeric lexemes in these edit-result vectors are preserved exactly.
fn same_value(a: std@1/json.Value, b: std@1/json.Value) -> bool uses {} {
  match (a, b) {
    (Object(x), Object(y)) => {
      if core@1/map.len(x) != core@1/map.len(y) {
        return false
      }
      for (key, child) in x {
        let Some(other) = core@1/map.get(y, key) else {
          return false
        }
        if !same_value(child, other) {
          return false
        }
      }
      true
    },
    (Array(x), Array(y)) => {
      if core@1/list.len(x) != core@1/list.len(y) {
        return false
      }
      for i in 0u64..core@1/list.len(x) {
        if !same_value(x[i], y[i]) {
          return false
        }
      }
      true
    },
    _ => a == b,
  }
}

fn check_case(doc: String, patch_text: String, expected: String, fails: bool) -> () uses {} {
  let limits = std@1/json_patch.default_limits()
  let original = Some(read(doc))
  let alias = copy original
  let parsed = std@1/json_patch.parse_text(unique patch_text, limits)
  match parsed {
    Error(_) => core@1/failure.check(fails, TextInvariant()),
    Ok(patch) => {
      let outcome = std@1/json_patch.apply(original, patch, limits)
      match outcome {
        Error(_) => core@1/failure.check(fails, TextInvariant()),
        Ok(actual) => {
          core@1/failure.check(!fails, TextInvariant())
          let Some(actual_value) = actual else {
            core@1/failure.check(false, TextInvariant())
            return
          }
          core@1/failure.check(
            same_value(actual_value, read(expected)),
            TextInvariant()
          )
        },
      }
    },
  }
  // Compare both the borrowed input and a retained alias after every outcome.
  let preserved_inputs: List[Option[std@1/json.Value]] = [copy original, copy alias]
  for preserved in preserved_inputs {
    let Some(v) = preserved else {
      core@1/failure.check(false, TextInvariant())
      return
    }
    let Ok(text) = std@1/json.stringify(v) else {
      core@1/failure.check(false, TextInvariant())
      return
    }
    let Ok(original_text) = std@1/json.stringify(read(doc)) else {
      core@1/failure.check(false, TextInvariant())
      return
    }
    core@1/failure.check(text == original_text, TextInvariant())
  }
}

pub fn main() -> Result[(), u64] {
  // 83: Removing nonexistent field
  check_case(
    "{\"foo\":\"bar\"}",
    "[{\"op\":\"remove\",\"path\":\"/baz\"}]",
    "{\"foo\":\"bar\"}",
    true
  )
  // 84: Removing nonexistent index
  check_case(
    "[\"foo\",\"bar\"]",
    "[{\"op\":\"remove\",\"path\":\"/2\"}]",
    "[\"foo\",\"bar\"]",
    true
  )
  // 85: Patch with different capitalisation than doc
  check_case(
    "{\"foo\":\"bar\"}",
    "[{\"op\":\"add\",\"path\":\"/FOO\",\"value\":\"BAR\"}]",
    "{\"foo\":\"bar\",\"FOO\":\"BAR\"}",
    false
  )
  // 86: Cannot index literal (add)
  check_case(
    "{\"foo\":true}",
    "[{\"op\":\"add\",\"path\":\"/foo/bar\",\"value\":\"BAR\"}]",
    "{\"foo\":true}",
    true
  )
  // 87: Cannot index literal (remove)
  check_case(
    "{\"foo\":true}",
    "[{\"op\":\"remove\",\"path\":\"/foo/bar\"}]",
    "{\"foo\":true}",
    true
  )
  // 88: Invalid index
  check_case(
    "{\"foo\":true}",
    "[{\"op\":\"add\",\"path\":\"hello\",\"value\":\"boo\"}]",
    "{\"foo\":true}",
    true
  )
  // 89: Changes are atomic
  check_case(
    "{\"foo\":true}",
    "[{\"op\":\"add\",\"path\":\"/foo\",\"value\":false},{\"op\":\"remove\",\"path\":\"/bar\"}]",
    "{\"foo\":true}",
    true
  )
  // 90: Slashes in object keys
  check_case(
    "{\"a/b\":true}",
    "[{\"op\":\"add\",\"path\":\"/a~1b\",\"value\":false}]",
    "{\"a/b\":false}",
    false
  )
  // 91: Slashes in parent object key
  check_case(
    "{\"a/b\":{\"foo\":true}}",
    "[{\"op\":\"add\",\"path\":\"/a~1b/foo\",\"value\":false}]",
    "{\"a/b\":{\"foo\":false}}",
    false
  )
  // 92: Substitution order (add)
  check_case(
    "{\"~1\":true}",
    "[{\"op\":\"add\",\"path\":\"/~01\",\"value\":false}]",
    "{\"~1\":false}",
    false
  )
  // 93: Substitution order (remove)
  check_case("{\"~1\":true}", "[{\"op\":\"remove\",\"path\":\"/~01\"}]", "{}", false)
  // 94: Leading zeroes are not supported
  check_case(
    "{\"foo\":[1,2,3]}",
    "[{\"op\":\"add\",\"path\":\"/foo/002\",\"value\":4}]",
    "{\"foo\":[1,2,3]}",
    true
  )
  // 95: Useless move is fine
  check_case(
    "{\"foo\":[1,2,3]}",
    "[{\"op\":\"move\",\"path\":\"/foo\",\"from\":\"/foo\"}]",
    "{\"foo\":[1,2,3]}",
    false
  )
  // 96: Cannot move inside children
  check_case(
    "{\"foo\":{\"bar\":{\"baz\":true}}}",
    "[{\"op\":\"move\",\"path\":\"/foo/bar\",\"from\":\"/foo\"}]",
    "{\"foo\":{\"bar\":{\"baz\":true}}}",
    true
  )
  // 97: Can move into similar path
  check_case(
    "{\"foo\":{\"bar\":{\"baz\":true}}}",
    "[{\"op\":\"move\",\"path\":\"/foobar\",\"from\":\"/foo\"}]",
    "{\"foobar\":{\"bar\":{\"baz\":true}}}",
    false
  )
  // 98: Can move outside children
  check_case(
    "{\"foo\":{\"bar\":{\"baz\":true}}}",
    "[{\"op\":\"move\",\"path\":\"/foo\",\"from\":\"/foo/bar\"}]",
    "{\"foo\":{\"baz\":true}}",
    false
  )
  // 99: Can move into root
  check_case(
    "{\"foo\":{\"bar\":{\"baz\":true}}}",
    "[{\"op\":\"move\",\"path\":\"\",\"from\":\"/foo/bar\"}]",
    "{\"baz\":true}",
    false
  )
  // 100: cannot remove last
  check_case(
    "{\"foo\":[1,2,3]}",
    "[{\"op\":\"remove\",\"path\":\"/foo/-\"}]",
    "{\"foo\":[1,2,3]}",
    true
  )
  // 101: cannot copy from last
  check_case(
    "{\"foo\":[1,2,3]}",
    "[{\"op\":\"copy\",\"from\":\"/foo/-\",\"path\":\"/bar\"}]",
    "{\"foo\":[1,2,3]}",
    true
  )
  // 102: cannot move from last
  check_case(
    "{\"foo\":[1,2,3]}",
    "[{\"op\":\"move\",\"from\":\"/foo/-\",\"path\":\"/bar\"}]",
    "{\"foo\":[1,2,3]}",
    true
  )
  Ok(())
}
