// Independent json-patch/specs vectors, revision 1b0f707f9f4aad1009f0364f6ca73c5e88cdd85c.
// MIT, Copyright (c) 2017 Ivan Dubrov; see docs/json-merge-patch-LICENSE-MIT.txt.
fn read(source: String) -> std@1/json.Value uses {} {
  match std@1/json.parse(unique source) {
    Ok(v) => take v,
    Error(_) => {
      core@1/failure.check(false, TextInvariant())
      Null()
    },
  }
}

// Independent structural oracle: map insertion order is deliberately ignored.
// Numeric lexemes in these edit-result vectors are preserved exactly.
fn same_value(a: std@1/json.Value, b: std@1/json.Value) -> bool uses {} {
  match (a, b) {
    (Object(x), Object(y)) => {
      if core@1/map.len(x) != core@1/map.len(y) {
        return false
      }
      for (key, child) in x {
        let Some(other) = core@1/map.get(y, key) else {
          return false
        }
        if !same_value(child, other) {
          return false
        }
      }
      true
    },
    (Array(x), Array(y)) => {
      if core@1/list.len(x) != core@1/list.len(y) {
        return false
      }
      for i in 0u64..core@1/list.len(x) {
        if !same_value(x[i], y[i]) {
          return false
        }
      }
      true
    },
    _ => a == b,
  }
}

fn check_case(doc: String, patch_text: String, expected: String, fails: bool) -> () uses {} {
  let limits = std@1/json_patch.default_limits()
  let original = Some(read(doc))
  let alias = copy original
  let parsed = std@1/json_patch.parse_text(unique patch_text, limits)
  match parsed {
    Error(_) => core@1/failure.check(fails, TextInvariant()),
    Ok(patch) => {
      let outcome = std@1/json_patch.apply(original, patch, limits)
      match outcome {
        Error(_) => core@1/failure.check(fails, TextInvariant()),
        Ok(actual) => {
          core@1/failure.check(!fails, TextInvariant())
          let Some(actual_value) = actual else {
            core@1/failure.check(false, TextInvariant())
            return
          }
          core@1/failure.check(
            same_value(actual_value, read(expected)),
            TextInvariant()
          )
        },
      }
    },
  }
  // Compare both the borrowed input and a retained alias after every outcome.
  let preserved_inputs: List[Option[std@1/json.Value]] = [copy original, copy alias]
  for preserved in preserved_inputs {
    let Some(v) = preserved else {
      core@1/failure.check(false, TextInvariant())
      return
    }
    let Ok(text) = std@1/json.stringify(v) else {
      core@1/failure.check(false, TextInvariant())
      return
    }
    let Ok(original_text) = std@1/json.stringify(read(doc)) else {
      core@1/failure.check(false, TextInvariant())
      return
    }
    core@1/failure.check(text == original_text, TextInvariant())
  }
}

pub fn main() -> Result[(), u64] {
  // 62: replacing the root of the document is possible with add
  check_case(
    "{\"foo\":\"bar\"}",
    "[{\"op\":\"add\",\"path\":\"\",\"value\":{\"baz\":\"qux\"}}]",
    "{\"baz\":\"qux\"}",
    false
  )
  // 63: Adding to "/-" adds to the end of the array
  check_case(
    "[1,2]",
    "[{\"op\":\"add\",\"path\":\"/-\",\"value\":{\"foo\":[\"bar\",\"baz\"]}}]",
    "[1,2,{\"foo\":[\"bar\",\"baz\"]}]",
    false
  )
  // 64: Adding to "/-" adds to the end of the array, even n levels down
  check_case(
    "[1,2,[3,[4,5]]]",
    "[{\"op\":\"add\",\"path\":\"/2/1/-\",\"value\":{\"foo\":[\"bar\",\"baz\"]}}]",
    "[1,2,[3,[4,5,{\"foo\":[\"bar\",\"baz\"]}]]]",
    false
  )
  // 65: test remove with bad number should fail
  check_case(
    "{\"foo\":1,\"baz\":[{\"qux\":\"hello\"}]}",
    "[{\"op\":\"remove\",\"path\":\"/baz/1e0/qux\"}]",
    "{\"foo\":1,\"baz\":[{\"qux\":\"hello\"}]}",
    true
  )
  // 66: test remove on array
  check_case("[1,2,3,4]", "[{\"op\":\"remove\",\"path\":\"/0\"}]", "[2,3,4]", false)
  // 67: test repeated removes
  check_case(
    "[1,2,3,4]",
    "[{\"op\":\"remove\",\"path\":\"/1\"},{\"op\":\"remove\",\"path\":\"/2\"}]",
    "[1,3]",
    false
  )
  // 68: test remove with bad index should fail
  check_case("[1,2,3,4]", "[{\"op\":\"remove\",\"path\":\"/1e0\"}]", "[1,2,3,4]", true)
  // 69: test replace with bad number should fail
  check_case(
    "[\"\"]",
    "[{\"op\":\"replace\",\"path\":\"/1e0\",\"value\":false}]",
    "[\"\"]",
    true
  )
  // 70: test copy with bad number should fail
  check_case(
    "{\"baz\":[1,2,3],\"bar\":1}",
    "[{\"op\":\"copy\",\"from\":\"/baz/1e0\",\"path\":\"/boo\"}]",
    "{\"baz\":[1,2,3],\"bar\":1}",
    true
  )
  // 71: test move with bad number should fail
  check_case(
    "{\"foo\":1,\"baz\":[1,2,3,4]}",
    "[{\"op\":\"move\",\"from\":\"/baz/1e0\",\"path\":\"/foo\"}]",
    "{\"foo\":1,\"baz\":[1,2,3,4]}",
    true
  )
  // 72: test add with bad number should fail
  check_case(
    "[\"foo\",\"sil\"]",
    "[{\"op\":\"add\",\"path\":\"/1e0\",\"value\":\"bar\"}]",
    "[\"foo\",\"sil\"]",
    true
  )
  // 73: missing 'value' parameter to add
  check_case("[1]", "[{\"op\":\"add\",\"path\":\"/-\"}]", "[1]", true)
  // 74: missing 'value' parameter to replace
  check_case("[1]", "[{\"op\":\"replace\",\"path\":\"/0\"}]", "[1]", true)
  // 75: missing 'value' parameter to test
  check_case("[null]", "[{\"op\":\"test\",\"path\":\"/0\"}]", "[null]", true)
  // 76: missing value parameter to test - where undef is falsy
  check_case("[false]", "[{\"op\":\"test\",\"path\":\"/0\"}]", "[false]", true)
  // 77: missing from parameter to copy
  check_case("[1]", "[{\"op\":\"copy\",\"path\":\"/-\"}]", "[1]", true)
  // 78: missing from parameter to move
  check_case("{\"foo\":1}", "[{\"op\":\"move\",\"path\":\"\"}]", "{\"foo\":1}", true)
  // 80: unrecognized op should fail
  check_case(
    "{\"foo\":1}",
    "[{\"op\":\"spam\",\"path\":\"/foo\",\"value\":1}]",
    "{\"foo\":1}",
    true
  )
  // 81: test with bad array number that has leading zeros
  check_case(
    "[\"foo\",\"bar\"]",
    "[{\"op\":\"test\",\"path\":\"/00\",\"value\":\"foo\"}]",
    "[\"foo\",\"bar\"]",
    true
  )
  // 82: test with bad array number that has leading zeros
  check_case(
    "[\"foo\",\"bar\"]",
    "[{\"op\":\"test\",\"path\":\"/01\",\"value\":\"bar\"}]",
    "[\"foo\",\"bar\"]",
    true
  )
  Ok(())
}
