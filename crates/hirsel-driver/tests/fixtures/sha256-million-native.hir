// Million-a SHA-256 reference: compiled binary only.
pub fn main() -> Result[(), ()] {
  let mut state = std@1/sha256.new()
  let chunk = b""
  for i in 0u64..1000u64 {
    std@1/sha256.update(mut state, chunk)
  }
  let digest = std@1/sha256.finish(take state)
  let mut bytes: List[u8] = []
  for byte in digest {
    list.push(mut bytes, byte)
  }
  failure.check(
    std@1/hex.encode(core@1/bytes.from_list(take bytes)) == "cdc76e5c9914fb9281a1c7e284d73e67f1809a48a497200e046d39ccc7112cd0",
    Arithmetic()
  )
  Ok(())
}
