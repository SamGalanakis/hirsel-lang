fn check_graph(n: u64, edges: List[toposort.Edge], blocked_mask: u64) -> () {
  match toposort.order(n, edges, n, list.len(edges)) {
    Ok(vertices) => {
      failure.check(blocked_mask == 0 && list.len(vertices) == n, Bounds())
      let mut positions: unique List[u64] = []
      for v in 0u64..n {
        list.push(mut positions, n)
      }
      for i in 0u64..n {
        let v = vertices[i]
        failure.check(v < n && positions[v] == n, Bounds())
        positions[v] = i
      }
      for edge in edges {
        failure.check(positions[edge.from] < positions[edge.to], Bounds())
      }
    },
    Error(Blocked(vertices)) => {
      failure.check(blocked_mask != 0, Bounds())
      let mut expected: List[u64] = []
      for v in 0u64..n {
        if blocked_mask & 1u64 << v != 0 {
          list.push(mut expected, v)
        }
      }
      failure.check(vertices == expected, Bounds())
    },
    Error(_) => failure.check(false, Bounds()),
  }
}

fn fixed() -> () {
  failure.check(toposort.order(0, [], 0, 0) == Ok([]), Bounds())
  failure.check(toposort.order(4, [], 4, 0) == Ok([0, 1, 2, 3]), Bounds())
  // Descending chain: CPython test_simple_cases (dense IDs).
  let chain: List[toposort.Edge] = [
    toposort.Edge(from: 3, to: 2),
    toposort.Edge(from: 2, to: 1),
    toposort.Edge(from: 1, to: 0)
  ]
  failure.check(toposort.order(4, chain, 4, 3) == Ok([3, 2, 1, 0]), Bounds())
  check_graph(4, chain, 0)
  let diamond: List[toposort.Edge] = [
    toposort.Edge(from: 0, to: 2),
    toposort.Edge(from: 0, to: 1),
    toposort.Edge(from: 1, to: 3),
    toposort.Edge(from: 2, to: 3)
  ]
  failure.check(toposort.order(4, diamond, 4, 4) == Ok([0, 2, 1, 3]), Bounds())
  check_graph(4, diamond, 0)
  // FIFO retains initially ready 2 before newly released 1.
  let fifo: List[toposort.Edge] = [toposort.Edge(from: 0, to: 1)]
  failure.check(toposort.order(3, fifo, 3, 1) == Ok([0, 2, 1]), Bounds())
  check_graph(3, fifo, 0)
  // CPython test_no_dependencies and test_the_node_multiple_times.
  let disconnected: List[toposort.Edge] = [
    toposort.Edge(from: 2, to: 1),
    toposort.Edge(from: 4, to: 3),
    toposort.Edge(from: 6, to: 5)
  ]
  failure.check(
    toposort.order(7, disconnected, 7, 3) == Ok([0, 2, 4, 6, 1, 3, 5]),
    Bounds()
  )
  check_graph(7, disconnected, 0)
  let duplicate: List[toposort.Edge] = [
    toposort.Edge(from: 0, to: 1),
    toposort.Edge(from: 0, to: 1),
    toposort.Edge(from: 0, to: 1)
  ]
  failure.check(toposort.order(2, duplicate, 2, 3) == Ok([0, 1]), Bounds())
  check_graph(2, duplicate, 0)
  check_graph(1, [toposort.Edge(from: 0, to: 0)], 1)
  check_graph(
    3,
    [
      toposort.Edge(from: 0, to: 1),
      toposort.Edge(from: 1, to: 2),
      toposort.Edge(from: 2, to: 0)
    ],
    7
  )
  // Two cycles, an acyclic component, and a downstream tail: blocked != cycle.
  check_graph(
    8,
    [
      toposort.Edge(from: 0, to: 1),
      toposort.Edge(from: 1, to: 0),
      toposort.Edge(from: 2, to: 3),
      toposort.Edge(from: 3, to: 2),
      toposort.Edge(from: 1, to: 4),
      toposort.Edge(from: 4, to: 5),
      toposort.Edge(from: 6, to: 7)
    ],
    63
  )
  failure.check(toposort.order(2, [], 1, 0) == Error(NodeLimit(2)), Bounds())
  failure.check(
    toposort.order(18446744073709551615, [], 0, 0) == Error(
      NodeLimit(18446744073709551615)
    ),
    Bounds()
  )
  failure.check(
    toposort.order(0, [toposort.Edge(from: 0, to: 0)], 0, 0) == Error(EdgeLimit(1)),
    Bounds()
  )
  failure.check(
    toposort.order(1, [toposort.Edge(from: 0, to: 0)], 1, 0) == Error(EdgeLimit(1)),
    Bounds()
  )
  failure.check(
    toposort.order(1, [toposort.Edge(from: 1, to: 0)], 1, 1) == Error(Endpoint(0, 1)),
    Bounds()
  )
  failure.check(
    toposort.order(1, [toposort.Edge(from: 0, to: 1)], 1, 1) == Error(Endpoint(0, 1)),
    Bounds()
  )
  failure.check(
    toposort.order(0, [toposort.Edge(from: 0, to: 0)], 0, 1) == Error(Endpoint(0, 0)),
    Bounds()
  )
  failure.check(
    toposort.order(
      1,
      [toposort.Edge(from: 0, to: 0), toposort.Edge(from: 0, to: 18446744073709551615)],
      1,
      2
    ) == Error(Endpoint(1, 18446744073709551615)),
    Bounds()
  )
}

fn additional_boundaries() -> () {
  failure.check(
    toposort.order(1, [toposort.Edge(from: 18446744073709551615, to: 0)], 1, 1) == Error(
      Endpoint(0, 18446744073709551615)
    ),
    Bounds()
  )
  // Caps take precedence over invalid endpoints; exact and generous caps work.
  failure.check(
    toposort.order(2, [toposort.Edge(from: 18446744073709551615, to: 0)], 1, 0) == Error(
      NodeLimit(2)
    ),
    Bounds()
  )
  failure.check(
    toposort.order(1, [], 18446744073709551615, 18446744073709551615) == Ok([0]),
    Bounds()
  )
  // CPython's repeated predecessor in a graph with several ready nodes.
  let edges: List[toposort.Edge] = [
    toposort.Edge(from: 2, to: 1),
    toposort.Edge(from: 4, to: 3),
    toposort.Edge(from: 2, to: 0),
    toposort.Edge(from: 4, to: 0),
    toposort.Edge(from: 4, to: 0),
    toposort.Edge(from: 4, to: 0),
    toposort.Edge(from: 4, to: 0),
    toposort.Edge(from: 4, to: 0)
  ]
  failure.check(toposort.order(5, edges, 5, 8) == Ok([2, 4, 1, 3, 0]), Bounds())
  check_graph(5, edges, 0)
}
