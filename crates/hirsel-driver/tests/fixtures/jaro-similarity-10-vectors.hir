  check("", "", 1.0, 0.0, true)
  check("", "jaro-winkler", 0.0, 0.0, true)
  check("distance", "", 0.0, 0.0, true)
  check("Jaro-Winkler", "Jaro-Winkler", 1.0, 0.0, true)
  check("testabctest", "testöঙ香test", 0.89, 0.001, true)
  check("testöঙ香test", "testabctest", 0.89, 0.001, true)
  check("dixon", "dicksonx", 0.813, 0.001, true)
  check("dicksonx", "dixon", 0.813, 0.001, true)
  check("a", "b", 0.0, 0.0, true)
  check("a", "a", 1.0, 0.0, true)
  check("dwayne", "duane", 0.84, 0.001, true)
  check("martha", "marhta", 0.961, 0.001, true)
  check("a jke", "jane a k", 0.6, 0.001, true)
  check("Friedrich Nietzsche", "Fran-Paul Sartre", 0.452, 0.001, true)
  check("cheeseburger", "cheese fries", 0.866, 0.001, true)
