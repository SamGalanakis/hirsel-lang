    0.98519,
    1e-05,
    true
  )
  check("aaabaa", "baaaab", 0.8222222222222223, 0.0, false)
  check("aaabaa", "baaaab", 0.8222222222222223, 0.0, true)
  check("baaaab", "aaabaa", 0.8222222222222223, 0.0, false)
  check("baaaab", "aaabaa", 0.8222222222222223, 0.0, true)
  check("aaaabc", "aaabca", 0.9444444444444445, 0.0, false)
  check("aaaabc", "aaabca", 0.9611111111111111, 0.0, true)
  check("aaabca", "aaaabc", 0.9444444444444445, 0.0, false)
  check("aaabca", "aaaabc", 0.9611111111111111, 0.0, true)
  check("é", "é", 0.0, 0.0, false)
