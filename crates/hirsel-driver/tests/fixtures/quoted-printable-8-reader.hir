// Go reader_test.go:21-96, all 31 vectors (partial-error output becomes Error).
// Added literal-equals, original-offset, trimming and atomic-refusal controls.
fn reader(data: Bytes, expected: Bytes) -> () uses {} {
  failure.check(std@1/quoted_printable.decode(data) == Ok(expected), TextInvariant())
}

pub fn main() -> Result[(), ()] {
  reader(b"", b"")
  reader(b"\x66\x6f\x6f\x20\x62\x61\x72", b"\x66\x6f\x6f\x20\x62\x61\x72")
  reader(
    b"\x66\x6f\x6f\x20\x62\x61\x72\x3d\x33\x44",
    b"\x66\x6f\x6f\x20\x62\x61\x72\x3d"
  )
  reader(
    b"\x66\x6f\x6f\x20\x62\x61\x72\x3d\x33\x64",
    b"\x66\x6f\x6f\x20\x62\x61\x72\x3d"
  )
  reader(b"\x66\x6f\x6f\x20\x62\x61\x72\x3d\x0a", b"\x66\x6f\x6f\x20\x62\x61\x72")
  reader(b"\x66\x6f\x6f\x20\x62\x61\x72\x0a", b"\x66\x6f\x6f\x20\x62\x61\x72\x0a")
  reader(
    b"\x66\x6f\x6f\x20\x62\x61\x72\x3d\x30",
    b"\x66\x6f\x6f\x20\x62\x61\x72\x3d\x30"
  )
  reader(
    b"\x66\x6f\x6f\x20\x62\x61\x72\x3d\x30\x44\x3d\x30\x41",
    b"\x66\x6f\x6f\x20\x62\x61\x72\x0d\x0a"
  )
  reader(
    b"\x20\x41\x20\x42\x20\x20\x20\x20\x20\x20\x20\x20\x0d\x0a\x20\x43\x20",
    b"\x20\x41\x20\x42\x0d\x0a\x20\x43"
  )
  reader(
    b"\x20\x41\x20\x42\x20\x3d\x0d\x0a\x20\x43\x20",
    b"\x20\x41\x20\x42\x20\x20\x43"
  )
  reader(b"\x20\x41\x20\x42\x20\x3d\x0a\x20\x43\x20", b"\x20\x41\x20\x42\x20\x20\x43")
  reader(b"\x66\x6f\x6f\x3d\x0a\x62\x61\x72", b"\x66\x6f\x6f\x62\x61\x72")
  reader(b"\x66\x6f\x6f\x20\x62\x61\x72\xff", b"\x66\x6f\x6f\x20\x62\x61\x72\xff")
  reader(b"\x3d\x33\x44\x33\x30\x0a", b"\x3d\x33\x30\x0a")
  reader(b"\x3d\x30\x30\x3d\x46\x46\x30\x3d\x0a", b"\x00\xff\x30")
  reader(b"\x66\x6f\x6f\x20\x20\x0a", b"\x66\x6f\x6f\x0a")
  reader(
    b"\x66\x6f\x6f\x20\x20\x0a\x0a\x66\x6f\x6f\x20\x3d\x0a\x0a\x66\x6f\x6f\x3d\x32\x30\x0a\x0a",
    b"\x66\x6f\x6f\x0a\x0a\x66\x6f\x6f\x20\x0a\x66\x6f\x6f\x20\x0a\x0a"
  )
  reader(b"\x66\x6f\x6f\x0a\x62\x61\x72", b"\x66\x6f\x6f\x0a\x62\x61\x72")
  reader(b"\x66\x6f\x6f\x0d\x62\x61\x72", b"\x66\x6f\x6f\x0d\x62\x61\x72")
  reader(b"\x66\x6f\x6f\x0d\x0a\x62\x61\x72", b"\x66\x6f\x6f\x0d\x0a\x62\x61\x72")
  reader(b"\x66\x6f\x6f\x3d\x0d\x0a\x62\x61\x72", b"\x66\x6f\x6f\x62\x61\x72")
  reader(b"\x66\x6f\x6f\x3d\x0a\x62\x61\x72", b"\x66\x6f\x6f\x62\x61\x72")
  reader(b"\x66\x6f\x6f\x3d", b"\x66\x6f\x6f")
  reader(
    b"\x4e\x6f\x77\x27\x73\x20\x74\x68\x65\x20\x74\x69\x6d\x65\x20\x3d\x0a\x66\x6f\x72\x20\x61\x6c\x6c\x20\x66\x6f\x6c\x6b\x20\x74\x6f\x20\x63\x6f\x6d\x65\x3d\x0a\x20\x74\x6f\x20\x74\x68\x65\x20\x61\x69\x64\x20\x6f\x66\x20\x74\x68\x65\x69\x72\x20\x63\x6f\x75\x6e\x74\x72\x79\x2e",
    b"\x4e\x6f\x77\x27\x73\x20\x74\x68\x65\x20\x74\x69\x6d\x65\x20\x66\x6f\x72\x20\x61\x6c\x6c\x20\x66\x6f\x6c\x6b\x20\x74\x6f\x20\x63\x6f\x6d\x65\x20\x74\x6f\x20\x74\x68\x65\x20\x61\x69\x64\x20\x6f\x66\x20\x74\x68\x65\x69\x72\x20\x63\x6f\x75\x6e\x74\x72\x79\x2e"
  )
  reader(
    b"\x61\x63\x63\x65\x70\x74\x20\x55\x54\x46\x2d\x38\x20\x72\x69\x67\x68\x74\x20\x71\x75\x6f\x74\x61\x74\x69\x6f\x6e\x20\x6d\x61\x72\x6b\x3a\x20\xe2\x80\x99",
    b"\x61\x63\x63\x65\x70\x74\x20\x55\x54\x46\x2d\x38\x20\x72\x69\x67\x68\x74\x20\x71\x75\x6f\x74\x61\x74\x69\x6f\x6e\x20\x6d\x61\x72\x6b\x3a\x20\xe2\x80\x99"
  )
  reader(b"\x66\x6f\x6f\x3d\x20\x0d\x0a\x62\x61\x72", b"\x66\x6f\x6f\x62\x61\x72")
  reader(b"\x66\x6f\x6f\x3d\x09\x20\x0d\x0a\x62\x61\x72", b"\x66\x6f\x6f\x62\x61\x72")
  reader(b"\x3d\x47\x30", b"\x3d\x47\x30")
  reader(b"\x3d\x30\x47", b"\x3d\x30\x47")
  reader(b"\x3d\x78", b"\x3d\x78")
  reader(b"\x3d\x3d\x34\x31", b"\x3d\x41")
  reader(b"\x66\x6f\x6f\x3d\x20\x09", b"\x66\x6f\x6f")
  reader(b"\x0d\x0d", b"")
  reader(b"\x66\x6f\x6f\x0d", b"\x66\x6f\x6f")
  reader(b"\x66\x6f\x6f\x0d\x0d\x0a", b"\x66\x6f\x6f\x0d\x0a")
  reader(b"\x78\x3d\x0d\x0a\x3d\x0a\x5a", b"\x78\x5a")
  reader(b"\x78\x3d\x32\x30\x20\x09\x0d\x0a", b"\x78\x20\x0d\x0a")
  reader(b"\x20\x09", b"")
  failure.check(
    std@1/quoted_printable.decode(b"\x66\x6f\x6f\x00\x62\x61\x72") == Error(
      InvalidByte(3)
    ),
    TextInvariant()
  )
  failure.check(
    std@1/quoted_printable.decode(b"\x66\x6f\x6f\x3d\x0d\x62\x61\x72") == Error(
      InvalidHex(4)
    ),
    TextInvariant()
  )
  failure.check(
    std@1/quoted_printable.decode(b"\x66\x6f\x6f\x3d\x0d\x0d\x0d\x20\x0a\x62\x61\x72") == Error(
      InvalidSoftBreak(3)
    ),
    TextInvariant()
  )
  failure.check(
    std@1/quoted_printable.decode(b"\x3d") == Error(InvalidSoftBreak(0)),
    TextInvariant()
  )
  failure.check(
    std@1/quoted_printable.decode(b"\x3d\x20\x09") == Error(InvalidSoftBreak(0)),
    TextInvariant()
  )
  failure.check(
    std@1/quoted_printable.decode(b"\x66\x6f\x6f\x3d\x0d") == Error(InvalidSoftBreak(3)),
    TextInvariant()
  )
  failure.check(
    std@1/quoted_printable.decode(b"\x61\x0a\x3d") == Error(InvalidSoftBreak(2)),
    TextInvariant()
  )
  failure.check(
    std@1/quoted_printable.decode(b"\x6f\x6b\x3d\x0d\x0a\x61\x62\x63\x7f") == Error(
      InvalidByte(8)
    ),
    TextInvariant()
  )
  failure.check(
    std@1/quoted_printable.decode(b"\x6f\x6b\x3d\x0a\x61\x62\x63\x3d\x0d\x58") == Error(
      InvalidHex(8)
    ),
    TextInvariant()
  )
  failure.check(
    std@1/quoted_printable.decode(b"\x61\x62\x63\x3d\x3d") == Error(UnexpectedEof(3)),
    TextInvariant()
  )
  failure.check(
    std@1/quoted_printable.decode(b"\x61\x62\x63\x3d\x0d\x0a\x01") == Error(
      InvalidByte(6)
    ),
    TextInvariant()
  )
  failure.check(
    std@1/quoted_printable.decode(b"\x61\x62\x63\x3d\x0d\x00") == Error(InvalidHex(4)),
    TextInvariant()
  )
  failure.check(
    std@1/quoted_printable.decode(b"\x3d\x00\x3d\x0d") == Error(InvalidByte(1)),
    TextInvariant()
  )
  Ok(())
}
