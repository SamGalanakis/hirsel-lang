// rust-lang/regex 80b9d14e; supported scalar/non-overlapping cases only.
@serializable
pub type CaptureTestFailure {
  pattern: String,
  src: String,
  stage: u64,
}

fn capture_case(pattern: String, src: String) -> bool uses {} {
  let Ok(re) = compile(pattern, 10000) else {
    return false
  }
  let mut work = 18446744073709551615u64
  let Ok(subject) = make_subject(src, mut work) else {
    return false
  }
  let mut scratch = capture_scratch()
  let mut cache = dfa_cache(re, true, 65024)
  let mut tiny = dfa_cache(re, true, 1)
  let mut start = 0u64
  while start <= core@1/list.len(subject.scalars) {
    let mut expected_work = work
    let Ok((span, expected)) = pike_find_from(
      re,
      subject,
      start,
      true,
      mut expected_work
    ) else {
      return false
    }
    if let Some(found) = span {
      if capture_replay(re, subject, found, mut scratch) != expected {
        return false
      }
    }
    let mut actual_work = work
    let Ok(actual) = capture_find_from(
      re,
      subject,
      start,
      re.prefilter.enabled,
      core@1/string.as_bytes(src),
      mut cache,
      mut scratch,
      mut actual_work
    ) else {
      return false
    }
    if actual != (span, copy expected) {
      return false
    }
    actual_work = work
    let Ok(retry) = capture_find_from(
      re,
      subject,
      start,
      false,
      core@1/string.as_bytes(src),
      mut tiny,
      mut scratch,
      mut actual_work
    ) else {
      return false
    }
    if retry != (span, expected) || actual_work != expected_work {
      return false
    }
    start += 1
  }
  true
}

fn capture_work(pattern: String, src: String) -> bool uses {} {
  let Ok(re) = compile(pattern, 10000) else {
    return false
  }
  let mut budget = 0u64
  while budget < 240 {
    let mut work = budget
    let expected: Result[Option[Captures], MatchError] = match make_subject(
      src,
      mut work
    ) {
      Error(e) => Error(e),
      Ok(subject) => match pike_find_from(re, subject, 0, true, mut work) {
        Error(e) => Error(e),
        Ok((matched, captures)) => Ok(
          if matched == None() {
            None()
          } else {
            Some(captures)
          }
        ),
      },
    }
    if find_captures(re, src, budget) != expected {
      return false
    }
    budget += 1
  }
  true
}

fn capture_callback(state: u64, src: String, captures: Captures) -> String uses {} {
  // Arbitrary output, including zero length. Trace is separately instrumented.
  let mut bytes: List[u8] = []
  let mut i = 0u64
  while i < state {
    core@1/list.push(mut bytes, b'x')
    i += 1
  }
  text.finish_valid(take bytes)
}

fn capture_replace_case(pattern: String, src: String, output_size: u64) -> bool uses {} {
  let Ok(re) = compile(pattern, 10000) else {
    return false
  }
  let mut work = 18446744073709551615u64
  let Ok(subject) = make_subject(src, mut work) else {
    return false
  }
  let mut exact = work
  let mut pos = 0u64
  let mut count = 0u64
  while pos <= core@1/list.len(subject.scalars) {
    count += 1
    let Ok((matched, _)) = pike_find_from(re, subject, pos, true, mut exact) else {
      return false
    }
    let Some(span) = matched else {
      break
    }
    if pos < core@1/list.len(subject.scalars) && subject.offsets[pos + 1] > span.end {
      pos += 1
    } else if span.end == subject.offsets[pos] {
      pos += 1
    } else {
      while subject.offsets[pos] < span.end {
        pos += 1
      }
    }
  }
  let bound = work - exact
  let mut replay_work = work
  if replacement_resolve(re, subject, count, true, mut replay_work) != Ok(()) || replay_work != exact {
    return false
  }
  let mut budget = 0u64
  while budget < bound + 120 {
    let mut expected_trace: List[u64] = []
    let expected = traced_replace_pike(
      re,
      src,
      "",
      2,
      output_size,
      capture_callback,
      budget,
      mut expected_trace
    )
    let mut actual_trace: List[u64] = []
    // A tighter proven bound forces debt resolution at realistic tiny budgets.
    let actual = traced_replace_accelerated(
      re,
      src,
      "",
      2,
      output_size,
      capture_callback,
      budget,
      bound,
      mut actual_trace
    )
    if actual != expected || actual_trace != expected_trace {
      return false
    }
    budget += 1
  }
  true
}

fn capture_exhaustive_pattern(pattern: String) -> Result[(), CaptureTestFailure] uses {} {
  let mut bits = 1u64
  while bits < 16 {
    let mut value = bits
    let mut bytes: List[u8] = []
    while value > 1 {
      core@1/list.push(
        mut bytes,
        if value % 2 == 0 {
          97u8
        } else {
          98u8
        }
      )
      value /= 2
    }
    let src = text.finish_valid(take bytes)
    if !capture_case(pattern, src) {
      return Error(CaptureTestFailure(pattern: unique pattern, src: src, stage: 1))
    }
    bits += 1
  }
  let samples: List[String] = [
    "éa😀b",
    "a\nb\na",
    "Kkſs",
    " a_a a ",
    "aaabbb",
    "axxbzz",
    "éaaaé",
    "\naaa\n",
    "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaab"
  ]
  for src in samples {
    if !capture_case(pattern, src) {
      return Error(CaptureTestFailure(pattern: unique pattern, src: src, stage: 2))
    }
  }
  Ok(())
}

pub fn capture_exhaustive() -> Result[(), CaptureTestFailure] uses {} {
  let patterns: List[String] = [
    "",
    "(a){0}(a)",
    "(a*)*",
    "((a?)*)*",
    "(a|ab)(b?)",
    "(ab|a)(b?)",
    "(a)+",
    "(?P<x>a)?(b*)",
    "(?U)(a+)",
    "(?U)(a+?)",
    "(?m)^(a*)$",
    "(a)\\b",
    "(?i)(k|s)+",
    "(a.*z|a)(b*)",
    "(a|a.*z)(b*)",
    "((a)?b)*"
  ]
  for pattern in patterns {
    capture_exhaustive_pattern(pattern)?
  }
  Ok(())
}

pub fn capture_budgets() -> Result[(), CaptureTestFailure] uses {} {
  let patterns: List[String] = ["(a)", "(a?)*", "(a|ab)", "(?P<x>a)?b", "\\b(a)"]
  for pattern in patterns {
    if !capture_work(pattern, "aba") {
      return Error(CaptureTestFailure(pattern: pattern, src: "aba", stage: 3))
    }
  }
  Ok(())
}

pub fn capture_replacements() -> Result[(), CaptureTestFailure] uses {} {
  let patterns: List[String] = ["(a)", "(a?)*", "(a|ab)", "(?P<x>a)?b"]
  for pattern in patterns {
    let sizes: List[u64] = [0u64, 30u64, 60u64]
    for output_size in sizes {
      if !capture_replace_case(pattern, "aba", output_size) {
        return Error(CaptureTestFailure(pattern: pattern, src: "aba", stage: 4))
      }
    }
  }
  Ok(())
}

fn traced_replace_pike[T](
  re: Regex,
  src: String,
  replacement: String,
  mode: u8,
  state: T,
  callback: fn(T, String, Captures) -> String uses {},
  work_limit: u64,
  mut trace: List[u64]
) -> Result[String, MatchError] uses {} {
  let mut work = work_limit
  let source_input = make_subject(src, mut work)?
  let data = core@1/string.as_bytes(src)
  let mut dst: List[u8] = []
  let mut pos = 0u64
  let mut last_end = 0u64
  while pos <= core@1/list.len(source_input.scalars) {
    let (matched, captures) = pike_find_from(re, source_input, pos, mode != 1, mut work)?
    let Some(span) = matched else {
      break
    }
    append_bytes(mut dst, data, last_end, span.start, mut work)?
    if span.end > last_end || span.start == 0 {
      if mode == 2 {
        core@1/list.push(mut trace, span.start)
        core@1/list.push(mut trace, span.end)
        let value = callback(state, src, captures)
        let bytes = core@1/string.as_bytes(value)
        append_bytes(mut dst, bytes, 0, core@1/bytes.len(bytes), mut work)?
      } else if mode == 1 {
        let bytes = core@1/string.as_bytes(replacement)
        append_bytes(mut dst, bytes, 0, core@1/bytes.len(bytes), mut work)?
      } else {
        expand_into(re, mut dst, replacement, src, captures, mut work)?
      }
    }
    last_end = span.end
    // Go replaceAll advances at least one scalar from the search position.
    spend(mut work)?
    if pos < core@1/list.len(source_input.scalars) && source_input.offsets[pos + 1] > span.end {
      pos += 1
    } else if span.end == source_input.offsets[pos] {
      pos += 1
    } else {
      while source_input.offsets[pos] < span.end {
        spend(mut work)?
        pos += 1
      }
    }
  }
  append_bytes(mut dst, data, last_end, core@1/bytes.len(data), mut work)?
  Ok(text.finish_valid(take dst))
}

fn traced_replace_accelerated[T](
  re: Regex,
  src: String,
  replacement: String,
  mode: u8,
  state: T,
  callback: fn(T, String, Captures) -> String uses {},
  work_limit: u64,
  initial_bound: u64,
  mut trace: List[u64]
) -> Result[String, MatchError] uses {} {
  let mut work = work_limit
  let source_input = make_subject(src, mut work)?
  let data = core@1/string.as_bytes(src)
  let mut dst: List[u8] = []
  let mut bound = initial_bound
  let mut pending = 0u64
  let mut cache = dfa_cache(re, true, 65024)
  let mut scratch = capture_scratch()
  let mut pos = 0u64
  let mut last_end = 0u64
  while pos <= core@1/list.len(source_input.scalars) {
    replacement_afford(re, source_input, mode != 1, 0, pending, mut bound, mut work)?
    let search_outcome = if bound != 0 && !cache.disabled {
      dfa_search(re, source_input, pos, data, mut cache)
    } else {
      DfaQuit()
    }
    let (matched, captures) = match search_outcome {
      DfaMatch(span) => {
        pending += 1
        (
          Some(span),
          if mode == 1 {
            Captures(spans: [])
          } else {
            capture_replay(re, source_input, span, mut scratch)
          }
        )
      },
      DfaMiss() => {
        pending += 1
        (None(), Captures(spans: []))
      },
      DfaQuit() => {
        if bound != 0 {
          replacement_resolve(re, source_input, pending, mode != 1, mut work)?
          bound = 0
        }
        pike_find_from(re, source_input, pos, mode != 1, mut work)?
      },
    }
    let Some(span) = matched else {
      break
    }
    replacement_afford(
      re,
      source_input,
      mode != 1,
      span.start - last_end,
      pending,
      mut bound,
      mut work
    )?
    append_bytes(mut dst, data, last_end, span.start, mut work)?
    if span.end > last_end || span.start == 0 {
      if mode == 2 {
        core@1/list.push(mut trace, span.start)
        core@1/list.push(mut trace, span.end)
        let value = callback(state, src, captures)
        let bytes = core@1/string.as_bytes(value)
        replacement_afford(
          re,
          source_input,
          mode != 1,
          core@1/bytes.len(bytes),
          pending,
          mut bound,
          mut work
        )?
        append_bytes(mut dst, bytes, 0, core@1/bytes.len(bytes), mut work)?
      } else if mode == 1 {
        let bytes = core@1/string.as_bytes(replacement)
        replacement_afford(
          re,
          source_input,
          mode != 1,
          core@1/bytes.len(bytes),
          pending,
          mut bound,
          mut work
        )?
        append_bytes(mut dst, bytes, 0, core@1/bytes.len(bytes), mut work)?
      } else {
        if bound != 0 {
          replacement_resolve(re, source_input, pending, true, mut work)?
          bound = 0
        }
        expand_into(re, mut dst, replacement, src, captures, mut work)?
      }
    }
    last_end = span.end
    // Go replaceAll advances at least one scalar from the search position.
    replacement_afford(re, source_input, mode != 1, 1, pending, mut bound, mut work)?
    spend(mut work)?
    if pos < core@1/list.len(source_input.scalars) && source_input.offsets[pos + 1] > span.end {
      pos += 1
    } else if span.end == source_input.offsets[pos] {
      pos += 1
    } else {
      while source_input.offsets[pos] < span.end {
        replacement_afford(re, source_input, mode != 1, 1, pending, mut bound, mut work)?
        spend(mut work)?
        pos += 1
      }
    }
  }
  replacement_afford(
    re,
    source_input,
    mode != 1,
    core@1/bytes.len(data) - last_end,
    pending,
    mut bound,
    mut work
  )?
  append_bytes(mut dst, data, last_end, core@1/bytes.len(data), mut work)?
  Ok(text.finish_valid(take dst))
}

pub fn capture_goldens() -> Result[(), CaptureTestFailure] uses {} {
  // flags.toml:1 1
  {
    let Ok(re) = compile("(?i)abc", 10000) else {
      return Error(CaptureTestFailure(pattern: "(?i)abc", src: "ABC", stage: 5))
    }
    let Ok(actual) = find_all_captures(re, "ABC", 100, 18446744073709551615) else {
      return Error(CaptureTestFailure(pattern: "(?i)abc", src: "ABC", stage: 6))
    }
    let expected: List[Captures] = [Captures(spans: [Some(Span(start: 0, end: 3))])]
    if core@1/list.len(actual) != core@1/list.len(expected) {
      return Error(CaptureTestFailure(pattern: "(?i)abc", src: "ABC", stage: 7))
    }
    let mut i = 0u64
    while i < core@1/list.len(expected) {
      let mut j = 0u64
      while j < core@1/list.len(expected[i].spans) {
        if actual[i].spans[j] != expected[i].spans[j] {
          return Error(CaptureTestFailure(pattern: "(?i)abc", src: "ABC", stage: 8))
        }
        j += 1
      }
      i += 1
    }
    if !capture_case("(?i)abc", "ABC") {
      return Error(CaptureTestFailure(pattern: "(?i)abc", src: "ABC", stage: 9))
    }
  }
  // flags.toml:7 2
  {
    let Ok(re) = compile("(?i)a(?-i)bc", 10000) else {
      return Error(CaptureTestFailure(pattern: "(?i)a(?-i)bc", src: "Abc", stage: 5))
    }
    let Ok(actual) = find_all_captures(re, "Abc", 100, 18446744073709551615) else {
      return Error(CaptureTestFailure(pattern: "(?i)a(?-i)bc", src: "Abc", stage: 6))
    }
    let expected: List[Captures] = [Captures(spans: [Some(Span(start: 0, end: 3))])]
    if core@1/list.len(actual) != core@1/list.len(expected) {
      return Error(CaptureTestFailure(pattern: "(?i)a(?-i)bc", src: "Abc", stage: 7))
    }
    let mut i = 0u64
    while i < core@1/list.len(expected) {
      let mut j = 0u64
      while j < core@1/list.len(expected[i].spans) {
        if actual[i].spans[j] != expected[i].spans[j] {
          return Error(
            CaptureTestFailure(pattern: "(?i)a(?-i)bc", src: "Abc", stage: 8)
          )
        }
        j += 1
      }
      i += 1
    }
    if !capture_case("(?i)a(?-i)bc", "Abc") {
      return Error(CaptureTestFailure(pattern: "(?i)a(?-i)bc", src: "Abc", stage: 9))
    }
  }
  // flags.toml:13 3
  {
    let Ok(re) = compile("(?i)a(?-i)bc", 10000) else {
      return Error(CaptureTestFailure(pattern: "(?i)a(?-i)bc", src: "ABC", stage: 5))
    }
    let Ok(actual) = find_all_captures(re, "ABC", 100, 18446744073709551615) else {
      return Error(CaptureTestFailure(pattern: "(?i)a(?-i)bc", src: "ABC", stage: 6))
    }
    let expected: List[Captures] = []
    if core@1/list.len(actual) != core@1/list.len(expected) {
      return Error(CaptureTestFailure(pattern: "(?i)a(?-i)bc", src: "ABC", stage: 7))
    }
    let mut i = 0u64
    while i < core@1/list.len(expected) {
      let mut j = 0u64
      while j < core@1/list.len(expected[i].spans) {
        if actual[i].spans[j] != expected[i].spans[j] {
          return Error(
            CaptureTestFailure(pattern: "(?i)a(?-i)bc", src: "ABC", stage: 8)
          )
        }
        j += 1
      }
      i += 1
    }
    if !capture_case("(?i)a(?-i)bc", "ABC") {
      return Error(CaptureTestFailure(pattern: "(?i)a(?-i)bc", src: "ABC", stage: 9))
    }
  }
  // flags.toml:19 4
  {
    let Ok(re) = compile("(?is)a.", 10000) else {
      return Error(CaptureTestFailure(pattern: "(?is)a.", src: "A\n", stage: 5))
    }
    let Ok(actual) = find_all_captures(re, "A\n", 100, 18446744073709551615) else {
      return Error(CaptureTestFailure(pattern: "(?is)a.", src: "A\n", stage: 6))
    }
    let expected: List[Captures] = [Captures(spans: [Some(Span(start: 0, end: 2))])]
    if core@1/list.len(actual) != core@1/list.len(expected) {
      return Error(CaptureTestFailure(pattern: "(?is)a.", src: "A\n", stage: 7))
    }
    let mut i = 0u64
    while i < core@1/list.len(expected) {
