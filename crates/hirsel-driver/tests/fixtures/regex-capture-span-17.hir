fn capture_context_pattern(pattern: String) -> bool uses {} {
  let samples: List[String] = [
    "éaa\naaaa\n",
    "aa😀a",
    "aKſb",
    "ababxxzbb",
    "abbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbz ab",
    "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaab"
  ]
  for src in samples {
    if !capture_case(pattern, src) {
      return false
    }
  }
  true
}

pub fn capture_retention() -> Result[(), CaptureTestFailure] uses {} {
  let Ok(re) = compile("(ab+)(c?)", 100) else {
    return Error(CaptureTestFailure(pattern: "retained", src: "abb abbbc", stage: 11))
  }
  let mut work = 100000u64
  let Ok(subject) = make_subject("abb abbbc", mut work) else {
    return Error(CaptureTestFailure(pattern: "retained", src: "abb abbbc", stage: 12))
  }
  let mut scratch = capture_scratch()
  let first = capture_replay(re, subject, Span(start: 0, end: 3), mut scratch)
  let second = capture_replay(re, subject, Span(start: 4, end: 9), mut scratch)
  if first.spans != [
    Some(Span(start: 0, end: 3)),
    Some(Span(start: 0, end: 3)),
    Some(Span(start: 3, end: 3))
  ] || second.spans != [
    Some(Span(start: 4, end: 9)),
    Some(Span(start: 4, end: 8)),
    Some(Span(start: 8, end: 9))
  ] {
    return Error(CaptureTestFailure(pattern: "retained", src: "abb abbbc", stage: 13))
  }
  let mut cache = dfa_cache(re, true, 65024)
  let mut no_rows = capture_scratch()
  let Ok(miss_subject) = make_subject(
    "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
    mut work
  ) else {
    return Error(CaptureTestFailure(pattern: "miss", src: "x64", stage: 14))
  }
  let Ok((matched, _)) = capture_find_from(
    re,
    miss_subject,
    0,
    true,
    b"xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
    mut cache,
    mut no_rows,
    mut work
  ) else {
    return Error(CaptureTestFailure(pattern: "miss", src: "x64", stage: 15))
  }
  if matched != None() || core@1/list.len(no_rows.data) != 0 {
    return Error(CaptureTestFailure(pattern: "miss", src: "x64", stage: 16))
  }
  let cases: List[(String, String)] = [
    ("(a){0}(a)", "a"),
    ("(?:(\\d+)[:.])?(\\d{1,2})[:.](\\d{2})", "102:12:39"),
    ("(?:([0-9][0-9][0-9]):)?([0-9][0-9]):([0-9][0-9])", "102:12:39"),
    ("\\b[0-9]+\\b", "β123"),
    ("\\b[0-9]+\\b", "123β")
  ]
  for (pattern, src) in cases {
    if !capture_case(pattern, src) {
      return Error(CaptureTestFailure(pattern: pattern, src: src, stage: 17))
    }
  }
  Ok(())
}

pub fn capture_expand_partial() -> Result[(), CaptureTestFailure] uses {} {
  let Ok(re) = compile("(a)", 100) else {
    return Error(CaptureTestFailure(pattern: "expand", src: "aé", stage: 18))
  }
  let invalid: List[Captures] = [
    Captures(spans: [Some(Span(start: 1, end: 2))]),
    Captures(spans: [Some(Span(start: 4, end: 5))]),
    Captures(spans: [Some(Span(start: 2, end: 1))])
  ]
  for captures in invalid {
    let mut budget = 0u64
    while budget < 30 {
      let mut actual: List[u8] = [b'x']
      let mut expected: List[u8] = [b'x']
      let mut exact = budget
      let a = expand(re, mut actual, "q$0", "aé", captures, budget)
      let b = expand_into(re, mut expected, "q$0", "aé", captures, mut exact)
      if a != b || actual != expected {
        return Error(CaptureTestFailure(pattern: "expand", src: "aé", stage: 19))
      }
      budget += 1
    }
  }
  Ok(())
}

