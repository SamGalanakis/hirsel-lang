fn capture_forced_limits_inner() -> bool uses {} {
  let src = "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxabb abbbc"
  let Ok(re) = compile("(ab+)(c?)", 100) else {
    return false
  }
  let mut work = 1000000u64
  let Ok(subject) = make_subject(src, mut work) else {
    return false
  }
  let mut exact = work
  let Ok(expected) = pike_find_from(re, subject, 0, true, mut exact) else {
    return false
  }
  let mut scratch = capture_scratch()
  let mut tiny = dfa_cache(re, true, 1)
  let mut i = 0u64
  while i < 2 {
    let mut remaining = work
    let Ok(actual) = capture_find_from(
      re,
      subject,
      0,
      true,
      core@1/string.as_bytes(src),
      mut tiny,
      mut scratch,
      mut remaining
    ) else {
      return false
    }
    if actual != expected || core@1/list.len(scratch.data) != 0 {
      return false
    }
    i += 1
  }
  let Ok(boundary_re) = compile("\\b([0-9]+)\\b", 100) else {
    return false
  }
  let Ok(preceding) = make_subject("β123", mut work) else {
    return false
  }
  let Ok(after) = make_subject("123β", mut work) else {
    return false
  }
  // substring.toml:23-35, supported ASCII boundary mode, original expected rows.
  let preceding_caps = capture_replay(
    boundary_re,
    preceding,
    Span(start: 2, end: 5),
    mut scratch
  )
  let following_caps = capture_replay(
    boundary_re,
    after,
    Span(start: 0, end: 3),
    mut scratch
  )
  if preceding_caps.spans != [
    Some(Span(start: 2, end: 5)),
    Some(Span(start: 2, end: 5))
  ] || following_caps.spans != [
    Some(Span(start: 0, end: 3)),
    Some(Span(start: 0, end: 3))
  ] {
    return false
  }
  true
}

pub fn capture_forced_limits() -> Result[(), CaptureTestFailure] uses {} {
  if !capture_forced_limits_inner() {
    return Error(
      CaptureTestFailure(
        pattern: "limits",
        src: "long ASCII and β boundaries",
        stage: 20
      )
    )
  }
  Ok(())
}

pub fn capture_context_0() -> Result[(), CaptureTestFailure] uses {} {
  if !capture_context_pattern("(a){0}(a)") {
    return Error(
      CaptureTestFailure(pattern: "(a){0}(a)", src: "context samples", stage: 10)
    )
  }
  Ok(())
}

