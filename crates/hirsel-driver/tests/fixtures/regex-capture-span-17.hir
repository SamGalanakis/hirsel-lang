  // flags.toml:31 6
  {
    let Ok(re) = compile("(?is)a.(?-is)a.", 10000) else {
      return Error(
        CaptureTestFailure(pattern: "(?is)a.(?-is)a.", src: "A\na\n", stage: 5)
      )
    }
    let Ok(actual) = find_all_captures(re, "A\na\n", 100, 18446744073709551615) else {
      return Error(
        CaptureTestFailure(pattern: "(?is)a.(?-is)a.", src: "A\na\n", stage: 6)
      )
    }
    let expected: List[Captures] = []
    if core@1/list.len(actual) != core@1/list.len(expected) {
      return Error(
        CaptureTestFailure(pattern: "(?is)a.(?-is)a.", src: "A\na\n", stage: 7)
      )
    }
    let mut i = 0u64
    while i < core@1/list.len(expected) {
      let mut j = 0u64
      while j < core@1/list.len(expected[i].spans) {
        if actual[i].spans[j] != expected[i].spans[j] {
          return Error(
            CaptureTestFailure(pattern: "(?is)a.(?-is)a.", src: "A\na\n", stage: 8)
          )
        }
        j += 1
      }
      i += 1
    }
    if !capture_case("(?is)a.(?-is)a.", "A\na\n") {
      return Error(
        CaptureTestFailure(pattern: "(?is)a.(?-is)a.", src: "A\na\n", stage: 9)
      )
    }
  }
  // flags.toml:37 7
  {
    let Ok(re) = compile("(?is)a.(?-is:a.)?", 10000) else {
      return Error(
        CaptureTestFailure(pattern: "(?is)a.(?-is:a.)?", src: "A\na\n", stage: 5)
      )
    }
    let Ok(actual) = find_all_captures(re, "A\na\n", 1, 18446744073709551615) else {
      return Error(
        CaptureTestFailure(pattern: "(?is)a.(?-is:a.)?", src: "A\na\n", stage: 6)
      )
    }
    let expected: List[Captures] = [Captures(spans: [Some(Span(start: 0, end: 2))])]
    if core@1/list.len(actual) != core@1/list.len(expected) {
      return Error(
        CaptureTestFailure(pattern: "(?is)a.(?-is:a.)?", src: "A\na\n", stage: 7)
      )
    }
    let mut i = 0u64
    while i < core@1/list.len(expected) {
      let mut j = 0u64
      while j < core@1/list.len(expected[i].spans) {
        if actual[i].spans[j] != expected[i].spans[j] {
          return Error(
            CaptureTestFailure(pattern: "(?is)a.(?-is:a.)?", src: "A\na\n", stage: 8)
