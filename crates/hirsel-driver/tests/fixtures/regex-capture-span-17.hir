pub fn capture_context_and_retention() -> Result[(), CaptureTestFailure] uses {} {
  capture_context_0()?
  capture_context_1()?
  capture_context_2()?
  capture_context_3()?
  capture_context_4()?
  capture_context_5()?
  capture_context_6()?
  capture_context_7()?
  capture_context_8()?
  capture_retention()
}
