  // flags.toml:44 8
  {
    let Ok(re) = compile("(?U)a+", 10000) else {
      return Error(CaptureTestFailure(pattern: "(?U)a+", src: "aa", stage: 5))
    }
    let Ok(actual) = find_all_captures(re, "aa", 1, 18446744073709551615) else {
      return Error(CaptureTestFailure(pattern: "(?U)a+", src: "aa", stage: 6))
    }
    let expected: List[Captures] = [Captures(spans: [Some(Span(start: 0, end: 1))])]
    if core@1/list.len(actual) != core@1/list.len(expected) {
      return Error(CaptureTestFailure(pattern: "(?U)a+", src: "aa", stage: 7))
    }
    let mut i = 0u64
    while i < core@1/list.len(expected) {
      let mut j = 0u64
      while j < core@1/list.len(expected[i].spans) {
        if actual[i].spans[j] != expected[i].spans[j] {
