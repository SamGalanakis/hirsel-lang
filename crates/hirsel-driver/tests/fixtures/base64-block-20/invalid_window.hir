// Seed zero runs the union natively; each nonzero seed is one bounded
// position/mode run under the interpreter and checked-H default step budgets.
pub fn main(t: Test) -> Result[(), ()] {
  let seed = test.seed(t)
  let index = (seed - 1) % 1216
  let window = (seed - 1) / 1216
  let pos = index % 304
  let alphabet: std@1/base64.Alphabet = if index / 304 < 2 { Standard() } else { UrlSafe() }
  let padding: std@1/base64.Padding = if index / 304 % 2 == 0 { Required() } else { Omitted() }
  window_cases.invalid_window(alphabet, padding, pos, pos + 1, window)?

  Ok(())
}
