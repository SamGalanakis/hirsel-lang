// strsim dacc84c0dc61eff0ee0ff66962bcf2e17018ad26; MIT, docs/text-similarity.md.
fn check(a: String, b: String, expected: f64, tolerance: f64, winkler: bool) -> () {
  let alias_a = a
  let alias_b = b
  let answer = if winkler {
    std@1/text_similarity.jaro_winkler(a, b, 1000000, 10000)
  } else {
    std@1/text_similarity.jaro(a, b, 1000000, 10000)
  }
  match answer {
    Ok(value) => {
      let delta = value - expected
      failure.check(delta <= tolerance && delta >= -tolerance, TextInvariant())
    },
    Error(_) => failure.check(false, TextInvariant()),
  }
  failure.check(a == alias_a && b == alias_b, TextInvariant())
}

