pub fn main(rt: Io, args: Args) -> Result[(), LaunchError] {
  let root = arg.path(args, 0) ? Usage
  let dir = io.dir(rt, root) ? Files
  let n = normalize_tree(dir) ? Files
  out.print(io.stdout(rt) ? Grant, std@1/u64.to_string(n)) ? Output
  Ok(())
}

pub fn normalize_tree(dir: Dir) -> Result[u64, FileError] {
  let mut changed: u64 = 0
  let walk = file.walk(dir)? // opening may fail
  for step in take walk { // items are Result[Path, FileError]
    let path = step?
    let old = file.read_bytes(dir, path)? // scoped: lives in a region, never counted
    let new = std@1/bytes.replace(old, b"\r\n", b"\n")
    if new != old {
      file.write_bytes(dir, path, take new)?
      changed += 1
    }
  }
  Ok(changed)
}

pub type LaunchError = Grant(GrantError) | Output(OutputError) | Usage(ArgError) | Files(
  FileError
)
