// A thaw racing a release (lane R3): the child gives up its root and then stores, so its
// release takes effect at the store's entry; the parent's thaw after its load sees count 1
// only when the schedule ran that entry first. The recorded bit replays either outcome.
fn discard[T](take x: T) -> () {
  ()
}

pub fn main(rt: Io, args: Args) -> Result[(), GrantError] {
  let tasks = io.tasks(rt)?
  let out = io.stdout(rt)?
  let built: String = "s"
  let s: Shared[String] = shared.freeze(take built)
  let held = copy s
  let x: Atomic[u64] = atomic.create(tasks, 0u64)
  let ok = task.scope(
    tasks,
    fn(scope: Scope) -> bool {
      let child = task.async(
        scope,
        fn() -> () {
          discard(take held)
          atomic.store(tasks, x, 1u64)
        }
      )
      let seen = atomic.load(tasks, x)
      let ok = match shared.thaw(take s) {
        Ok(text) => true,
        Error(root) => {
          discard(take root)
          false
        },
      }
      task.await(scope, take child)
      ok
    }
  )
  let _ = out.print(out, if ok { "thawed\n" } else { "shared\n" })
  Ok(())
}
