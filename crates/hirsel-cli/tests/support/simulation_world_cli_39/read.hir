// AfterWrite reduction of native_harness_gaps_30 and host_replay_parity_31 (MIT).
pub fn main(rt: Io, args: Args) -> Result[(), FileError] {
  let tasks = io.tasks(rt)? grant_error
  let input = io.dir(rt, path.of("input"))?
  let output = io.dir(rt, path.of("output"))?
  let failed = arg.text(args, 0u64) == Ok("failed")
  let put = arg.text(args, 0u64) == Ok("put_new")
  task.scope(tasks, fn(s: Scope) {
    let child = task.async(s, fn() -> bool {
      let mut Ok(f) = file.open(input, path.of("data")) else { return false }
      let mut bytes: List[u8] = []
      let reading = file.read(input, mut f, mut bytes, 2u64)
      if failed { reading == Error(Canceled(Requested())) && bytes == [] }
      else { reading == Ok(2u64) && bytes == [0u8, 255u8] }
    })
    let _ = file.metadata(input, path.of("data"))
    let _ = file.metadata(input, path.of("data"))
    if failed {
      failure.check(file.write_bytes(output, path.of("release"), b"x") == Error(PermissionDenied()), Arithmetic())
      let _ = file.metadata(input, path.of("data"))
      task.cancel(s, child)
    } else if put {
      let _ = file.put_new(output, path.of("release"), b"x", Volatile())
    } else {
      failure.check(file.write_bytes(output, path.of("release"), b"x") == Ok(()), Arithmetic())
    }
    failure.check(task.await(s, take child), Arithmetic())
  })
  let _ = out.print(io.stdout(rt)? grant_error, "read checked\n")
  Ok(())
}
@noalloc
fn grant_error(e: GrantError) -> FileError uses {} { NotGranted() }
