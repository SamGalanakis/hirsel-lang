// o2: an opaque type's representation changes in its package; a user in another package is cached
// entry: hirsel.json
=== hirsel.json
{
  "schema": 1,
  "package": {
    "name": "app",
    "version": "1"
  },
  "sources": [
    {
      "path": "main.hir",
      "module": []
    }
  ],
  "dependencies": [
