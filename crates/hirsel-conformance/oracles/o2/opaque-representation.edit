=== main.hir
pub fn main() -> u64 {
  lib.api.read(lib.api.build())
}
=== lib@1/hirsel.json
{
  "schema": 1,
  "package": {
    "name": "lib",
    "version": "1"
  },
  "sources": [
    {
      "path": "api.hir",
      "module": [
        "api"
