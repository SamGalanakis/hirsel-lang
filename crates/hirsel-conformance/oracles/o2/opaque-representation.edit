=== lib@1/api.hir
pub opaque type Secret: data + copyable uses {} {
  value: u64,
}

pub fn build() -> Secret {
  Secret(value: 11)
}

pub fn read(s: Secret) -> u64 {
  s.value
}
+++ lib@1/api.hir
pub opaque type Secret: data + copyable uses {} {
  value: u64,
  extra: u64,
}

pub fn build() -> Secret {
  Secret(value: 11, extra: 0)
}

pub fn read(s: Secret) -> u64 {
  s.value
}
