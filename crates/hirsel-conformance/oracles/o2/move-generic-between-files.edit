// o2: a generic item moves to another file, with cached and fresh callers and nested staged expressions
// entry: hirsel.json
=== hirsel.json
{
  "schema": 1,
  "package": {
    "name": "app",
    "version": "1"
  },
  "sources": [
    {
      "path": "main.hir",
      "module": []
    },
    {
      "path": "a.hir",
      "module": []
    },
    {
      "path": "b.hir",
      "module": []
    }
  ],
  "dependencies": [],
  "entry": {
    "module": [],
    "name": "main"
  }
}
=== a.hir
fn pick[T](take x: T, take y: T) -> T {
  take y
}

fn cached_caller() -> u64 {
  pick(1, 2)
}
=== b.hir
fn other_caller() -> String {
  pick("x", "y")
}
=== main.hir
const STAGED: u64 = comptime (pick(comptime (pick(1, 3) + 1), 6) + 1)

pub fn main() -> u64 {
  cached_caller() + STAGED
}
+++ a.hir
fn cached_caller() -> u64 {
  pick(1, 2)
}
+++ b.hir
fn other_caller() -> String {
  pick("x", "y")
}

fn fresh_caller() -> u64 {
  pick(7, 8)
}

fn pick[T](take x: T, take y: T) -> T {
  take y
}
