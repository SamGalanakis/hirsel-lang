// o2: the comptime budget drops below what a constant needs (41 units), then nothing else changes
// before: limits=budget=1000000,depth=64
// after: limits=budget=40,depth=64
=== main.hir
fn spin(n: u64) -> u64 {
  if n == 0 {
    0
  } else {
    spin(n - 1) + 1
  }
}

const DEEP: u64 = comptime spin(40)

pub fn main() -> u64 {
  DEEP
}
