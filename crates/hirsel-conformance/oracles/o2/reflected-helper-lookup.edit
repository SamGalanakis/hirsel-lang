=== reflect.hir
fn field_count[T](s: TypeShape[T]) -> u64 {
  match type_shape.info(s).body {
    Record(found) => list.len(found) + bonus(),
    Choice(_) => 0,
  }
}
=== extra.hir
fn unrelated() -> u64 {
  0
}
=== main.hir
const COUNT: u64 = comptime field_count(shape(Secret))

pub fn main() -> u64 {
  COUNT
}
+++ extra.hir
fn unrelated() -> u64 {
  0
}

fn bonus() -> u64 {
  10
}
