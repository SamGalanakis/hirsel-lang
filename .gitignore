# Logs
*.log
*.log.*

# Cargo build output
/target/

# Build inputs tools/buck2/sync.py derives (tools/buck2/generated.py): generated on
# demand by bootstrap.py and every Buck2 entry point, never committed.
/BUCK
/third-party/BUCK
/third-party/Cargo.toml
/third-party/Cargo.lock
/third-party/lib.rs
/tools/buck2/exec_sizes.bzl
/tools/buck2/test_sizes.bzl
/tools/buck2/workspace-metadata.json
/tools/native-toolchain/pins.bzl

# Buck2: pinned tools, build outputs and the local remote-execution configuration.
/.buck2/
/buck-out/
/.buckconfig.local
/tools/buck2/toolchains/rust-files/
/tools/buck2/toolchains/llvm-files/
/tools/buck2/bin/

# Python bytecode
__pycache__/

# Editors and operating systems
.DS_Store
.idea/
.vscode/
*.swp
*~
