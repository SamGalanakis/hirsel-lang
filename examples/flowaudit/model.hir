// Typed admission precedes residual allocation. The std DOM is bounded by bytes.
pub const INPUT_BYTES: u64 = 65536

pub const MAX_VERTICES: u64 = 16

pub const MAX_ARCS: u64 = 64

pub const MAX_CAPACITY: u64 = 1000000

pub const MAX_SCENARIOS: u64 = 4

pub type Arc {
  name: String,
  source: String,
  target: String,
  capacity: u64,
}

pub type Override {
  arc: String,
  capacity: u64,
}

pub type Scenario {
  name: String,
  overrides: List[Override],
}

pub type Manifest {
  version: u64,
  vertices: List[String],
  arcs: List[Arc],
  source: String,
  sink: String,
  scenarios: List[Scenario],
}

pub type Edge {
  source: u64,
  target: u64,
  capacity: u64,
}

pub type Topology {
  vertices: u64,
  source: u64,
  sink: u64,
  arcs: List[Edge],
}

fn arc_from_json(value: json.Value) -> Result[Arc, String] uses {} = comptime derive.from_json(
  shape(Arc)
)

fn override_from_json(value: json.Value) -> Result[Override, String] uses {} = comptime derive.from_json(
  shape(Override)
)

fn scenario_from_json(value: json.Value) -> Result[Scenario, String] uses {} = comptime derive.from_json(
  shape(Scenario)
)

fn manifest_from_json(value: json.Value) -> Result[Manifest, String] uses {} = comptime derive.from_json(
  shape(Manifest)
)

pub fn collection(value: json.Value, key: String, limit: u64, problem: report.Problem) -> Result[
  u64,
  report.Problem
] uses {} {
  let Some(member) = json_access.member(value, key) else {
    return Error(Shape())
  }
  let Some(items) = json_access.as_array(member) else {
    return Error(Shape())
  }
  let count = list.len(items)
  if count > limit {
    return Error(problem)
  }
  Ok(count)
}

pub fn parse(take data: Bytes, limit: u64) -> Result[json.Value, report.Problem] uses {} {
  if bytes.len(data) > limit {
    return Error(InputLimit())
  }
  let Ok(text) = string.from_bytes(take data) else {
    return Error(Json())
  }
  let Ok(value) = json.parse(take text) else {
    return Error(Json())
  }
  Ok(take value)
}

fn bounded_name(value: json.Value) -> Result[(), report.Problem] uses {} {
  let Some(text) = json_access.as_text(value) else {
    return Error(Shape())
  }
  name(text)
}

fn named_field(value: json.Value, key: String) -> Result[(), report.Problem] uses {} {
  let Some(member) = json_access.member(value, key) else {
    return Error(Shape())
  }
  bounded_name(member)
}

// Inspect text before derived decoding copies names into typed collections.
fn preflight_names(value: json.Value) -> Result[(), report.Problem] uses {} {
  let Some(vertices) = json_access.member(value, "vertices") else {
    return Error(Shape())
  }
  let Some(items) = json_access.as_array(vertices) else {
    return Error(Shape())
  }
  for item in items {
    bounded_name(item)?
  }
  named_field(value, "source")?
  named_field(value, "sink")?
  let Some(arcs) = json_access.member(value, "arcs") else {
    return Error(Shape())
  }
  let Some(edges) = json_access.as_array(arcs) else {
    return Error(Shape())
  }
  for edge in edges {
    named_field(edge, "name")?
    named_field(edge, "source")?
    named_field(edge, "target")?
  }
  let Some(scenarios) = json_access.member(value, "scenarios") else {
    return Error(Shape())
  }
  let Some(rows) = json_access.as_array(scenarios) else {
    return Error(Shape())
  }
  for row in rows {
    named_field(row, "name")?
    let Some(overrides) = json_access.member(row, "overrides") else {
      return Error(Shape())
    }
    let Some(changes) = json_access.as_array(overrides) else {
      return Error(Shape())
    }
    for change in changes {
      named_field(change, "arc")?
    }
  }
  Ok(())
}

pub fn decode(take data: Bytes) -> Result[unique Manifest, report.Problem] uses {} {
  let value = parse(take data, INPUT_BYTES)?
  let _ = collection(value, "vertices", MAX_VERTICES, Vertices())?
  let _ = collection(value, "arcs", MAX_ARCS, Arcs())?
  let count = collection(value, "scenarios", MAX_SCENARIOS, Scenarios())?
  let Some(scenarios) = json_access.member(value, "scenarios") else {
    return Error(Shape())
  }
  for i in 0u64..count {
    let Some(item) = json_access.element(scenarios, i) else {
      return Error(Shape())
    }
    let _ = collection(item, "overrides", MAX_ARCS, Overrides())?
  }
  preflight_names(value)?
  let Ok(manifest) = manifest_from_json(value) else {
    return Error(Shape())
  }
  validate(manifest)?
  Ok(take manifest)
}

fn name(value: String) -> Result[(), report.Problem] uses {} {
  if string.byte_len(value) == 0 || string.byte_len(value) > 128 {
    return Error(Name())
  }
  Ok(())
}

pub fn ordinal(names: List[String], value: String) -> Result[u64, report.Problem] uses {} {
  for i in 0u64..list.len(names) {
    if names[i] == value {
      return Ok(i)
    }
  }
  Error(Endpoint())
}

fn indexed_ordinal(names: Map[String, u64], value: String) -> Result[
  u64,
  report.Problem
] uses {} {
  match map.get(names, value) {
    Some(index) => Ok(index),
    None() => Error(Endpoint()),
  }
}

pub fn validate(m: Manifest) -> Result[(), report.Problem] uses {} {
  if m.version != 1 {
    return Error(Version())
  }
  let n = list.len(m.vertices)
  let a = list.len(m.arcs)
  let count = list.len(m.scenarios)
  if n < 2 || n > MAX_VERTICES {
    return Error(Vertices())
  }
  if a > MAX_ARCS {
    return Error(Arcs())
  }
  if count == 0 || count > MAX_SCENARIOS {
    return Error(Scenarios())
  }
  // Derived maxima: 256 matrix cells, 128 paired edges, two 16-item frontiers,
  // path <=16 vertices; sum <=64,000,000, residual <=2,000,000.
  // Every product fits u64, every signed update fits i64, before growth.
  if n * n > 256 || a * 2 > 128 || a * MAX_CAPACITY > 64000000 {
    return Error(Bounds())
  }
  // Index bounded names as versionaudit does; retain input-order validation.
  let mut vertex_names: Map[String, u64] = map.empty()
  for i in 0u64..n {
    name(m.vertices[i])?
    if map.contains(vertex_names, m.vertices[i]) {
      return Error(Duplicate())
    }
    map.insert(mut vertex_names, unique m.vertices[i], i)
  }
  let source = indexed_ordinal(vertex_names, m.source)?
  let sink = indexed_ordinal(vertex_names, m.sink)?
  if source == sink {
    return Error(Endpoint())
  }
  let mut arc_names: Map[String, u64] = map.empty()
  // n <=16, so each source's target membership fits in one u64.
  let mut endpoints = list.filled(n, 0u64)
  for i in 0u64..a {
    let e = m.arcs[i]
    name(e.name)?
    let u = indexed_ordinal(vertex_names, e.source)?
    let v = indexed_ordinal(vertex_names, e.target)?
    if u == v {
      return Error(Endpoint())
    }
    if e.capacity > MAX_CAPACITY {
      return Error(Capacity())
    }
    let target = 1u64 << v
    if map.contains(arc_names, e.name) || endpoints[u] & target != 0 {
      return Error(Duplicate())
    }
    map.insert(mut arc_names, unique e.name, i)
    endpoints[u] = endpoints[u] | target
  }
  let mut scenario_names: Map[String, u64] = map.empty()
  for i in 0u64..count {
    let scenario = m.scenarios[i]
    name(scenario.name)?
    if map.contains(scenario_names, scenario.name) {
      return Error(Duplicate())
    }
    map.insert(mut scenario_names, unique scenario.name, i)
    if list.len(scenario.overrides) > MAX_ARCS {
      return Error(Overrides())
    }
    let mut overrides: Map[String, u64] = map.empty()
    for k in 0u64..list.len(scenario.overrides) {
      let o = scenario.overrides[k]
      if o.capacity > MAX_CAPACITY {
        return Error(Capacity())
      }
      if !map.contains(arc_names, o.arc) {
        return Error(Override())
      }
      if map.contains(overrides, o.arc) {
        return Error(Duplicate())
      }
      map.insert(mut overrides, unique o.arc, k)
    }
  }
  Ok(())
}

pub fn topology(m: Manifest) -> Result[unique Topology, report.Problem] uses {} {
  let mut names: Map[String, u64] = map.empty()
  for i in 0u64..list.len(m.vertices) {
    // Match ordinal's first occurrence even for a caller's unvalidated manifest.
    if !map.contains(names, m.vertices[i]) {
      map.insert(mut names, unique m.vertices[i], i)
    }
  }
  let mut arcs: List[Edge] = []
  for e in m.arcs {
    list.push(
      mut arcs,
      Edge(
        source: indexed_ordinal(names, e.source)?,
        target: indexed_ordinal(names, e.target)?,
        capacity: e.capacity
      )
    )
  }
  Ok(
    unique Topology(
      vertices: list.len(m.vertices),
      source: indexed_ordinal(names, m.source)?,
      sink: indexed_ordinal(names, m.sink)?,
      arcs: take arcs
    )
  )
}

pub fn capacities(m: Manifest, s: Scenario) -> unique List[u64] uses {} {
  // Match the independent oracle.py capacities dictionary, retaining last-write wins.
  let mut overrides: Map[String, u64] = map.empty()
  for o in s.overrides {
    map.insert(mut overrides, unique o.arc, o.capacity)
  }
  let mut values: List[u64] = []
  for arc in m.arcs {
    let capacity = match map.get(overrides, arc.name) {
      Some(value) => value,
      None() => arc.capacity,
    }
    list.push(mut values, capacity)
  }
  take values
}
