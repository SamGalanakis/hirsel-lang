[
  {
    "id": "one-success",
    "grants": {
      "args": [
        "50",
        "{\"id\":\"a\",\"method\":\"normalize\",\"text\":\"  HELLO  \"}",
        "/firstreply/0.sock"
      ],
      "io": {
        "stdout": "stdout.bytes@1",
        "tasks": "tasks.cooperative@1",
        "monotonic_clock": "clock.monotonic.ns@1",
        "dirs": [],
        "net": {
          "provider": "net.script@2",
          "rules": [
            {
              "address": "/firstreply/0.sock",
              "service": "0",
              "operation": "unix_connect"
            }
          ],
          "peers": [
            {
              "address": "/firstreply/0.sock",
              "port": 0,
              "resolves_to": [],
              "tls": "plain",
              "connections": [
                {
                  "open": [
                    {
                      "send": [0, 0, 0, 27, 123, 34, 105, 100, 34, 58, 34, 97, 34, 44, 34, 114, 101, 115, 117, 108, 116, 34, 58, 34, 104, 101, 108, 108, 111, 34, 125]
                    }
                  ]
                }
              ]
            }
          ]
        }
      }
    },
    "expected": {
      "status": 0,
      "stdout": "{\"endpoint\":0,\"response\":{\"id\":\"a\",\"result\":\"hello\"}}\n",
      "stderr": ""
    },
    "cleanup": {
      "children": 1,
      "join_all_before_output": true,
      "no_client_io_after_output": true,
      "allow_already_delivered_requests": true
    }
  },
