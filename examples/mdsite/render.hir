// The renderer remains std.markdown (CommonMark.js BSD-2-Clause port).
// Layout escaping retains std.html spellings; URI segments retain percent-encode policy.
pub fn page(title: String, take source: String) -> String uses {} {
  let body = markdown.to_html(take source, markdown.default_options())
  f"<!doctype html>\n<meta charset=\"utf-8\">\n<title>{html.esc(title)}</title>\n{body}"
}

// The publication renderer has one admitted output buffer, including layout.
// html.esc's Go HTML spelling and uri.percent_encode's unreserved alphabet are
// emitted directly so a small remaining budget cannot allocate a layout fragment.
type LayoutBuffer {
  data: List[u8],
  limit: u64,
}

fn append_byte(mut buffer: LayoutBuffer, value: u8) -> Result[(), ()] uses {} {
  let used = list.len(buffer.data)
  if used == buffer.limit {
    return Error(())
  }
  if used == 0 {
    list.reserve(mut buffer.data, buffer.limit)
  }
  list.push(mut buffer.data, value)
  Ok(())
}

fn literal(mut buffer: LayoutBuffer, value: String) -> Result[(), model.Problem] uses {} {
  if string.byte_len(value) > buffer.limit - list.len(buffer.data) {
    return Error(Limit("output_bytes"))
  }
  for b in string.as_bytes(value) {
    if let Error(_) = append_byte(mut buffer, b) {
      return Error(Limit("output_bytes"))
    }
  }
  Ok(())
}

fn escaped(mut buffer: LayoutBuffer, value: String) -> Result[(), model.Problem] uses {} {
  // Same five replacements as std.html.escape_into (Go html/escape.go).
  for b in string.as_bytes(value) {
    if b == b'&' {
      literal(mut buffer, "&amp;")?
    } else if b == b'<' {
      literal(mut buffer, "&lt;")?
    } else if b == b'>' {
      literal(mut buffer, "&gt;")?
    } else if b == b'"' {
      literal(mut buffer, "&#34;")?
    } else if b == b'\'' {
      literal(mut buffer, "&#39;")?
    } else if let Error(_) = append_byte(mut buffer, b) {
      return Error(Limit("output_bytes"))
    }
  }
  Ok(())
}

fn url_into(mut buffer: LayoutBuffer, value: String) -> Result[(), model.Problem] uses {} {
  let hex = b"0123456789ABCDEF"
  for b in string.as_bytes(value) {
    if ascii.is_alnum(b) || b == b'-' || b == b'_' || b == b'.' || b == b'~' || b == b'/' {
      if let Error(_) = append_byte(mut buffer, b) {
        return Error(Limit("output_bytes"))
      }
    } else {
      if buffer.limit - list.len(buffer.data) < 3 {
        return Error(Limit("output_bytes"))
      }
      if let Error(_) = append_byte(mut buffer, b'%') {
        return Error(Limit("output_bytes"))
      }
      if let Error(_) = append_byte(mut buffer, hex[int.widen(b / 16u8)]) {
        return Error(Limit("output_bytes"))
      }
      if let Error(_) = append_byte(mut buffer, hex[int.widen(b % 16u8)]) {
        return Error(Limit("output_bytes"))
      }
    }
  }
  Ok(())
}

fn head(mut buffer: LayoutBuffer, title: String) -> Result[(), model.Problem] uses {} {
  literal(mut buffer, "<!doctype html>\n<meta charset=\"utf-8\">\n<title>")?
  escaped(mut buffer, title)?
  Ok(())
}

fn finish_page(take buffer: LayoutBuffer, take source: String, suffix: String) -> Result[
  String,
  model.Problem
] uses {} {
  let mut layout_owned = take buffer
  let tail = string.byte_len(suffix)
  let left = layout_owned.limit - list.len(layout_owned.data)
  if tail > left {
    return Error(Limit("output_bytes"))
  }
  let document = markdown.parse(take source, markdown.default_options())
  if let Error(_) = markdown.render_html_to(
    document,
    markdown.default_options(),
    left - tail,
    mut layout_owned,
    append_byte
  ) {
    return Error(Limit("output_bytes"))
  }
  literal(mut layout_owned, suffix)?
  let LayoutBuffer(data: data, limit: _) = take layout_owned
  Ok(text.finish_valid(take data))
}

pub fn page_bounded(title: String, take source: String, limit: u64) -> Result[
  String,
  model.Problem
] uses {} {
  let mut buffer = LayoutBuffer(data: [], limit: limit)
  head(mut buffer, title)?
  literal(mut buffer, "</title>\n")?
  finish_page(take buffer, take source, "")
}

fn configured_page(
  item: model.Page,
  config: model.Config,
  rows: List[model.Navigation],
  limit: u64
) -> Result[String, model.Problem] uses {} {
  let mut buffer = LayoutBuffer(data: [], limit: limit)
  head(mut buffer, item.title)?
  literal(mut buffer, " | ")?
  escaped(mut buffer, config.title)?
  literal(mut buffer, "</title>\n<nav><ul>\n")?
  let parts = path.components(path.of(item.destination))
  for row in rows {
    literal(mut buffer, "<li><a href=\"")?
    for _ in 1u64..list.len(parts) {
      literal(mut buffer, "../")?
    }
    url_into(mut buffer, row.destination)?
    literal(mut buffer, "\">")?
    escaped(mut buffer, row.title)?
    literal(mut buffer, "</a></li>\n")?
  }
  literal(mut buffer, "</ul></nav>\n<main>\n")?
  finish_page(take buffer, unique item.source, "</main>\n")
}

pub fn url(name: String) -> String uses {} {
  string.join(
    list.map(
      string.split(unique name, "/"),
      fn(s: String) -> String {
        uri.percent_encode(string.as_bytes(s))
      }
    ),
    "/"
  )
}

fn prefix(destination: String) -> String uses {} {
  let mut out: List[u8] = []
  let parts = path.components(path.of(destination))
  for _ in 1u64..list.len(parts) {
    text.append(mut out, "../")
  }
  text.finish_valid(take out)
}

pub fn navigation(rows: List[model.Navigation], destination: String) -> String uses {} {
  let base = prefix(destination)
  let mut out: List[u8] = []
  text.append(mut out, "<nav><ul>\n")
  for row in rows {
    let link = f"{base}{url(row.destination)}"
    text.append(
      mut out,
      f"<li><a href=\"{html.esc(link)}\">{html.esc(row.title)}</a></li>\n"
    )
  }
  text.append(mut out, "</ul></nav>\n")
  text.finish_valid(take out)
}

pub fn output(destination: String, input_hash: String, take body: String) -> model.Output uses {} {
  let data = string.as_bytes(body)
  model.Output(
    destination: unique destination,
    input_hash: unique input_hash,
    output_hash: sha256.digest_hex(data),
    bytes: unique data
  )
}

pub fn layout(
  item: model.Page,
  config: model.Config,
  rows: List[model.Navigation],
  limit: u64
) -> Result[model.Output, model.Problem] uses {} {
  // Input memory has its own cap; Markdown emission receives the remaining output budget.
  if string.byte_len(item.source) > model.PAGE_BYTES {
    return Error(Limit("page_bytes"))
  }
  let body = if config.legacy {
    let raw = string.as_bytes(item.destination)
    let Ok(title) = string.from_bytes(unique bytes.slice(raw, 0, bytes.len(raw) - 5)) else {
      return Error(Utf8())
    }
    page_bounded(title, unique item.source, limit)?
  } else {
    configured_page(item, config, rows, limit)?
  }
  Ok(output(item.destination, item.digest, take body))
}

pub fn index(config: model.Config, rows: List[model.Navigation]) -> model.Output uses {} {
  let mut out: List[u8] = []
  text.append(
    mut out,
    f"<!doctype html>\n<meta charset=\"utf-8\">\n<title>{html.esc(config.title)}</title>\n<ul>\n"
  )
  for row in rows {
    text.append(
      mut out,
      f"<li><a href=\"{html.esc(url(row.destination))}\">{html.esc(row.title)}</a></li>\n"
    )
  }
  text.append(mut out, "</ul>\n")
  output("index.html", config.digest, text.finish_valid(take out))
}

// Taking the captured owners happens outside the borrowing Shared callback.
pub fn job(
  take item: unique model.Page,
  take config: unique model.Config,
  nav: Shared[List[model.Navigation]],
  limit: u64
) -> model.WorkResult[unique model.Output, unique model.Problem] {
  shared.with(
    nav,
    fn(links: List[model.Navigation]) -> model.WorkResult[
      unique model.Output,
      unique model.Problem
    ] {
      match layout(item, config, links, limit) {
        Ok(value) => Done(unique value),
        Error(problem) => Failed(unique problem),
      }
    }
  )
}

pub fn legacy_index(rows: List[model.Navigation]) -> String uses {} {
  let mut out: List[u8] = []
  text.append(
    mut out,
    "<!doctype html>\n<meta charset=\"utf-8\">\n<title>Index</title>\n<ul>\n"
  )
  for row in rows {
    text.append(
      mut out,
      f"<li><a href=\"{html.esc(url(row.destination))}\">{html.esc(row.title)}</a></li>\n"
    )
  }
  text.append(mut out, "</ul>\n")
  text.finish_valid(take out)
}
