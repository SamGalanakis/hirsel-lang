type Room = Meadow | Cave | Home

fn play(take commands: String) -> Result[String, common.Error] {
  let mut room: Room = Meadow()
  let mut key: bool = false
  let mut builder: List[u8] = []
  for raw in string.split(take commands, "\n") {
    let command = string.trim(raw)
    if string.byte_len(command) == 0 {
      continue
    }
    let reply: String = match room {
      Meadow() => if command == "north" {
        room = Cave()
        "A dark cave."
      } else if command == "east" && key {
        room = Home()
        "Home. You win!"
      } else if command == "east" {
        "The gate is locked."
      } else {
        "Meadow: north is a cave, east a gate."
      },
      Cave() => if command == "take key" {
        key = true
        "Key collected."
      } else if command == "south" {
        room = Meadow()
        "Back in the meadow."
      } else {
        "Cave: a key glints on the floor."
      },
      Home() => "The adventure is complete.",
    }
    text.append(mut builder, f"{reply}\n")
  }
  common.finish(take builder)
}

pub fn main(rt: Io, args: Args) -> Result[(), common.Error] {
  let commands = common.input(rt, args, "look\nnorth\ntake key\nsouth\neast\n")?
  common.print(rt, play(take commands)?)
}

@test
fn gate_requires_key_and_home_is_terminal(t: Test) {
  test.check(
    t,
    play("east\nnorth\ntake key\nsouth\neast\nlook") == Ok(
      "The gate is locked.\nA dark cave.\nKey collected.\nBack in the meadow.\nHome. You win!\nThe adventure is complete.\n"
    )
  )
  test.check(t, play(" \n") == Ok(""))
}
