// One HTTP exchange over a Unix domain socket the program serves itself, as curl
// --unix-socket would reach a local service. The listener's backlog holds the client's
// connection until the program accepts it, so no task is needed.
pub type ExchangeError = Grant(GrantError) | Usage(ArgError) | Network(NetError) | Http(
  http.HttpError
) | Output(OutputError)

fn serve(tasks: Tasks, n: Net, mut listener: Listener of n) -> Result[
  String,
  ExchangeError
] {
  let (stream, _) = net.accept(n, mut listener) ?
  let mut connection = http.server_connection(
    tasks,
    n,
    take stream,
    http.default_config()
  )
  let Some((current1, incoming)) = http.next_stream(mut connection, None()) ? else {
    return Error(Http(Closed()))
  }
  let mut exchange1 = take current1
  let reply = f"served {incoming.target}"
  http.respond(
    mut exchange1,
    200u16,
    [http.Header(name: "Content-Type", value: "text/plain")],
    string.as_bytes(reply),
    true
  ) ?
  Ok(incoming.target)
}

pub fn main(rt: Io, args: Args) -> Result[(), ExchangeError] {
  let tasks = io.tasks(rt) ?
  let n = io.net(rt) ?
  let output = io.stdout(rt) ?
  let socket = arg.path(args, 0u64) ?
  let mut listener = net.unix_listen(n, socket) ?
  let mut config = http.default_config()
  config.unix_socket = Some(socket)
  let mut request = http.request(n, config, Get(), "http://localhost/status", []) ?
  http.send_bodiless(mut request) ?
  let target = serve(tasks, n, mut listener)?
  let head = http.receive_head(mut request) ?
  let body = http.read_all(mut request, 1024u64) ?
  let text = match string.from_bytes(take body) {
    Ok(s) => s,
    Error(_) => "",
  }
  let _ = out.print(output, f"request {target}; status {head.status}; body {text}\n") ?
  Ok(())
}
