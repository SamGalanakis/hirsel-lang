{
  "io": {
    "stdout": "stdout.bytes@1",
    "net": {
      "provider": "net.stream@1",
      "rules": [
        {
          "address": "/tmp/hirsel-unix-http.sock",
          "service": "0",
          "operation": "unix_listen_remove_stale"
        },
        {
          "address": "/tmp/hirsel-unix-http.sock",
          "service": "0",
          "operation": "unix_connect"
        }
      ]
    },
    "dirs": []
  },
  "args": ["/tmp/hirsel-unix-http.sock"]
}
