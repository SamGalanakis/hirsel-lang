// Expression sessions from stdin (-) or a file; i64 terms evaluated left to right.
fn evaluate(take line: String) -> Result[i64, common.Error] {
  let tokens = string.split_ascii_whitespace(take line)
  if list.len(tokens) % 2 == 0 {
    return Error(Invalid())
  }
  let mut value = match i64.parse(tokens[0]) {
    Ok(n) => n,
    Error(_) => return Error(Invalid()),
  }
  let mut i: u64 = 1
  while i < list.len(tokens) {
    let rhs = match i64.parse(tokens[i + 1]) {
      Ok(n) => n,
      Error(_) => return Error(Invalid()),
    }
    let op = tokens[i]
    if op == "+" {
      value += rhs
    } else if op == "-" {
      value -= rhs
    } else if op == "*" {
      value *= rhs
    } else if op == "/" {
      if rhs == 0 || value == -9223372036854775808i64 && rhs == -1 {
        return Error(Invalid())
      }
      value /= rhs
    } else {
      return Error(Invalid())
    }
    i += 2
  }
  Ok(value)
}

fn append_result(take line: String, mut builder: List[u8]) -> () {
  if string.byte_len(string.trim(line)) == 0 {
    return ()
  }
  match evaluate(take line) {
    Ok(n) => i64.format_into(n, mut builder),
    Error(_) => text.append(mut builder, "error"),
  }
  text.append(mut builder, "\n")
}

fn repl(rt: Io) -> Result[(), common.Error] {
  let stream = io.stdin(rt) ? Grant
  while true {
    match input.read_line(stream) ? Input {
      None() => return Ok(()),
      Some(line) => {
        let mut builder: List[u8] = []
        append_result(take line, mut builder)
        common.print(rt, common.finish(take builder)?)?
      },
    }
  }
  Ok(())
}

pub fn main(rt: Io, args: Args) -> Result[(), common.Error] {
  match arg.path(args, 0) {
    Ok(p) => if path.text(p) == "-" {
      return repl(rt)
    },
    Error(_) => (),
  }
  let text = common.input(rt, args, "12 + 7 * 2\n-9 / 2\n100 - 1\n")?
  let mut builder: List[u8] = []
  for line in string.split(take text, "\n") {
    append_result(copy line, mut builder)
  }
  common.print(rt, common.finish(take builder)?)
}
