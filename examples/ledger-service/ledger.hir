// The ledger's rules: transaction bodies over typed tables. They hold only a
// Tx and data (`uses {}`), so a store can run them again to verify or trial
// them.
@serializable
pub type Receipt {
  from: u64,
  to: u64,
  moved: u64,
  fee: u64,
}

@serializable
pub type Refusal = NoAccount(u64) | Insufficient(u64) | Table(table.TxError)

fn balances() -> table.Table[u64, u64] {
  table.named("balances")
}

/// Sets `account`'s balance to `cents`, creating the table on first use.
pub fn open(mut tx: store.Tx, account: u64, cents: u64) -> Result[u64, Refusal] {
  match table.create(mut tx, balances()) {
    Ok(()) => {},
    Error(TableExists()) => {},
    Error(e) => return Error(Table(e)),
  }
  table.put(mut tx, balances(), account, cents) ? Table
  Ok(cents)
}

/// Moves `cents` from one account to another.
pub fn transfer(mut tx: store.Tx, from: u64, to: u64, cents: u64) -> Result[
  Receipt,
  Refusal
] {
  let Some(have) = table.get(tx, balances(), from) ? Table else {
    return Error(NoAccount(from))
  }
  let Some(other) = table.get(tx, balances(), to) ? Table else {
    return Error(NoAccount(to))
  }
  if have < cents {
    return Error(Insufficient(have))
  }
  table.put(mut tx, balances(), from, have - cents) ? Table
  table.put(mut tx, balances(), to, other + cents) ? Table
  Ok(Receipt(from: from, to: to, moved: cents, fee: 0))
}
