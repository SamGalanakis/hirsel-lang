pub const OUTPUT_BYTES: u64 = 16384

pub type Stage = Open | Read | Create | Write | Commit

pub type Problem = Usage | Jobs | Json | Shape | Version | Resources | JobCount | Pairs | Disabled | Manifests | Identifier | Duplicate | Endpoint | InputLimit | OutputLimit | Certificate | Grant | File(
  Stage,
  FileError
) | Canceled(CancelCause)

pub type Document {
  version: u64,
  revision: u64,
  results: List[explain.Certificate],
}

fn document_to_json(value: Document) -> json.Value uses {} = comptime derive.json_value(
  shape(Document)
)

pub fn encode(revision: u64, take results: List[explain.Certificate]) -> Result[
  unique Bytes,
  Problem
] uses {} {
  if list.len(results) > model.MAX_MANIFESTS {
    return Error(Manifests())
  }
  let document = Document(version: 1, revision: revision, results: take results)
  let Ok(text) = json.stringify(document_to_json(document)) else {
    return Error(Shape())
  }
  // Include the trailing newline before allocating the final output owner.
  if string.byte_len(text) >= OUTPUT_BYTES {
    return Error(OutputLimit())
  }
  let encoded = f"{text}\n"
  Ok(unique string.as_bytes(encoded))
}

pub fn file_error(stage: Stage, error: FileError) -> Problem {
  match error {
    Canceled(cause) => Canceled(cause),
    _ => File(stage, error),
  }
}

pub fn publish(d: Dir, output: Path, data: Bytes) -> Result[(), Problem] {
  if bytes.len(data) > OUTPUT_BYTES {
    return Error(OutputLimit())
  }
  let mut destination = match file.create_atomic(d, output) {
    Ok(value) => take value,
    Error(error) => return Error(file_error(Create(), error)),
  }
  match file.write_all(d, mut destination, data) {
    Ok(()) => (),
    Error(error) => return Error(file_error(Write(), error)),
  }
  match file.commit(d, take destination) {
    Ok(()) => Ok(()),
    Error(error) => Error(file_error(Commit(), error)),
  }
}

pub fn name(problem: Problem) -> String uses {} {
  match problem {
    Usage() => "usage",
    Jobs() => "jobs",
    Json() => "json",
    Shape() => "shape",
    Version() => "version",
    Resources() => "resources",
    JobCount() => "job_count",
    Pairs() => "pairs",
    Disabled() => "disabled",
    Manifests() => "manifests",
    Identifier() => "identifier",
    Duplicate() => "duplicate",
    Endpoint() => "endpoint",
    InputLimit() => "input_limit",
    OutputLimit() => "output_limit",
    Certificate() => "certificate",
    Grant() => "grant",
    Canceled(_) => "canceled",
    File(_, NotGranted()) => "denied",
    File(_, PermissionDenied()) => "denied",
    File(Open(), _) => "file_open",
    File(Read(), _) => "file_read",
    File(Create(), _) => "file_create",
    File(Write(), _) => "file_write",
    File(Commit(), _) => "file_commit",
  }
}
