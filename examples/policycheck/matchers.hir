// Generic, authority-free predicates own their environments. apply borrows
// both the callback and typed input; no view can escape through its bool result.
pub type Predicate[T] {
  test: fn(T) -> bool uses {},
}

pub fn apply[T](predicate: Predicate[T], value: T) -> bool uses {} {
  predicate.test(value)
}

pub fn equality[T: data + copyable](take expected: T) -> Predicate[T] uses {} {
  Predicate(
    test: fn(actual: T) -> bool uses {} {
      actual == expected
    }
  )
}

pub fn principal(take name: String) -> Predicate[model.Principal] uses {} {
  Predicate(
    test: fn(value: model.Principal) -> bool uses {} {
      value.id == name
    }
  )
}

// The same bulk byte scanner used by std/json stops at separators and every
// byte outside ASCII letters, digits, underscore, dot and hyphen.
const PATH_STOP: Bytes = b"\x00\x01\x02\x03\x04\x05\x06\x07\x08\x09\x0a\x0b\x0c\x0d\x0e\x0f\x10\x11\x12\x13\x14\x15\x16\x17\x18\x19\x1a\x1b\x1c\x1d\x1e\x1f\x20\x21\x22\x23\x24\x25\x26\x27\x28\x29\x2a\x2b\x2c\x2f\x3a\x3b\x3c\x3d\x3e\x3f\x40\x5b\x5c\x5d\x5e\x60\x7b\x7c\x7d\x7e\x7f\x80\x81\x82\x83\x84\x85\x86\x87\x88\x89\x8a\x8b\x8c\x8d\x8e\x8f\x90\x91\x92\x93\x94\x95\x96\x97\x98\x99\x9a\x9b\x9c\x9d\x9e\x9f\xa0\xa1\xa2\xa3\xa4\xa5\xa6\xa7\xa8\xa9\xaa\xab\xac\xad\xae\xaf\xb0\xb1\xb2\xb3\xb4\xb5\xb6\xb7\xb8\xb9\xba\xbb\xbc\xbd\xbe\xbf\xc0\xc1\xc2\xc3\xc4\xc5\xc6\xc7\xc8\xc9\xca\xcb\xcc\xcd\xce\xcf\xd0\xd1\xd2\xd3\xd4\xd5\xd6\xd7\xd8\xd9\xda\xdb\xdc\xdd\xde\xdf\xe0\xe1\xe2\xe3\xe4\xe5\xe6\xe7\xe8\xe9\xea\xeb\xec\xed\xee\xef\xf0\xf1\xf2\xf3\xf4\xf5\xf6\xf7\xf8\xf9\xfa\xfb\xfc\xfd\xfe\xff"

pub fn path(value: json.Value, pattern: bool) -> Result[unique String, model.Problem] uses {} {
  let Text(s) = value else {
    return Error(PathSyntax())
  }
  let n = string.byte_len(s)
  if n == 0 || n > 256 {
    return Error(PathSyntax())
  }
  let data = string.as_bytes(s)
  if data[0] != 47 {
    return Error(PathSyntax())
  }
  let mut end = n
  if pattern && n >= 2 {
    if data[n - 2] == 47 && data[n - 1] == 42 {
      end = n - 2
    }
  }
  if end == 0 || n == 1 {
    return Ok(unique s)
  }
  if end == 1 {
    return Error(PathSyntax())
  }
  let mut start: u64 = 1
  while true {
    let stop = bytes.find_any(data, PATH_STOP, start)
    let next = if stop > end {
      end
    } else {
      stop
    }
    let width = next - start
    if width == 0 {
      return Error(PathSyntax())
    }
    if width == 1 && data[start] == 46 {
      return Error(PathSyntax())
    }
    if width == 2 && data[start] == 46 && data[start + 1] == 46 {
      return Error(PathSyntax())
    }
    if next == end {
      break
    }
    if data[next] != 47 {
      return Error(PathSyntax())
    }
    start = next + 1
  }
  Ok(unique s)
}

pub fn path_matches(pattern: String, actual: String) -> bool uses {} {
  if pattern == actual {
    return true
  }
  let p = string.as_bytes(pattern)
  let a = string.as_bytes(actual)
  let n = bytes.len(p)
  if n < 2 || p[n - 2] != 47 || p[n - 1] != 42 {
    return false
  }
  if bytes.len(a) < n {
    return false
  }
  // Keep the slash in the prefix: /data/* never matches /database/a.
  bytes.slice(a, 0, n - 1) == bytes.slice(p, 0, n - 1)
}

pub fn target(take pattern: String, take owner: String) -> Predicate[model.Resource] uses {} {
  Predicate(
    test: fn(value: model.Resource) -> bool uses {} {
      let owner_test = equality(copy owner)
      (owner == "*" || apply(owner_test, value.owner)) && path_matches(
        pattern,
        value.path
      )
    }
  )
}

pub fn action(expected: String, actual: String) -> bool uses {} {
  let predicate = equality(unique expected)
  expected == "*" || apply(predicate, actual)
}
