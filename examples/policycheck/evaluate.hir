// Casbin default_effector.go:64-91, c35c93d (Apache-2.0): allow AND
// no deny. We retain all matching IDs, deliberately avoiding its short circuit.
fn fold(policy: model.Policy, query: model.Query) -> model.Decision uses {} {
  let principal_test = matchers.principal(unique query.principal)
  let mut held: List[String] = []
  for principal in policy.principals {
    if matchers.apply(principal_test, principal) {
      held = roles.closure(policy, principal)
    }
  }
  let mut allowed = false
  let mut denied = false
  let mut explanation: unique List[String] = []
  for rule in policy.rules {
    if !roles.contains(held, rule.role) || !matchers.action(rule.action, query.action) {
      continue
    }
    let resource_test = matchers.target(unique rule.path, unique rule.owner)
    if !matchers.apply(resource_test, query.target) {
      continue
    }
    list.push(mut explanation, unique rule.id)
    match rule.effect {
      Allow() => {
        allowed = true
      },
      Deny() => {
        denied = true
      },
    }
  }
  model.Decision(
    id: unique query.id,
    allow: allowed && !denied,
    rules: take explanation
  )
}

type Answer {
  principal: String,
  action: String,
  path: String,
  owner: String,
  allow: bool,
  rules: List[String],
}

fn same_query(answer: Answer, query: model.Query) -> bool uses {} {
  answer.principal == query.principal && answer.action == query.action && answer.path == query.target.path && answer.owner == query.target.owner
}

// The admitted batch has at most32 queries and fixes one policy revision.
// Reuse pure decisions by every matcher input. Each job still owns its ID
// and an independent explanation, including when queries share an answer.
fn prepare(snapshot: Option[Shared[model.Policy]], queries: List[model.Query]) -> unique List[
  Answer
] uses {} {
  let mut answers: unique List[Answer] = []
  for query in queries {
    let mut found = false
    for answer in answers {
      if same_query(answer, query) {
        found = true
        break
      }
    }
    if found {
      continue
    }
    let decision = match snapshot {
      None() => model.Decision(id: unique query.id, allow: false, rules: []),
      Some(policy) => shared.with(
        policy,
        fn(value: model.Policy) -> unique model.Decision uses {} {
          fold(value, query)
        }
      ),
    }
    list.push(
      mut answers,
      Answer(
        principal: unique query.principal,
        action: unique query.action,
        path: unique query.target.path,
        owner: unique query.target.owner,
        allow: decision.allow,
        rules: unique decision.rules
      )
    )
  }
  take answers
}

fn decide(answers: Shared[List[Answer]], query: model.Query) -> unique model.Decision uses {} {
  shared.with(
    answers,
    fn(values: List[Answer]) -> unique model.Decision uses {} {
      for answer in values {
        if same_query(answer, query) {
          return model.Decision(
            id: unique query.id,
            allow: answer.allow,
            rules: unique answer.rules
          )
        }
      }
      model.Decision(id: unique query.id, allow: false, rules: [])
    }
  )
}

// Independent jobs each own a unique explanation; borrowed shared policy and
// query views are confined to nested callbacks. Publication awaits add order.
pub fn batch(
  tasks: Tasks,
  snapshot: Option[Shared[model.Policy]],
  take queries: unique List[model.Query],
  jobs: u64
) -> Result[unique List[unique model.Decision], model.Problem] {
  let answers = shared.freeze(prepare(snapshot, queries))
  let count = list.len(queries)
  let input = shared.freeze(take queries)
  task.scope(
    tasks,
    fn(s: Scope) -> Result[unique List[unique model.Decision], model.Problem] {
      let mut output: unique List[unique model.Decision] = []
      let mut first: u64 = 0
      while first < count {
        let mut pending: TaskSet[Result[unique model.Decision, model.Problem]] of s = task.set(
          s
        )
        let mut added: u64 = 0
        while added < jobs && first + added < count {
          let index = first + added
          task.add(
            s,
            mut pending,
            task.async(
              s,
              fn() -> Result[unique model.Decision, model.Problem] {
                Ok(
                  shared.with(
                    input,
                    fn(rows: List[model.Query]) -> unique model.Decision uses {} {
                      decide(answers, rows[index])
                    }
                  )
                )
              }
            )
          )
          added += 1
        }
        for i in 0u64..added {
          let joined = task.await_at(s, mut pending, i)
          match take joined {
            Ok(decision) => list.push(mut output, take decision),
            Error(problem) => {
              task.cancel_all(s, take pending)
              return Error(problem)
            },
          }
        }
        task.cancel_all(s, take pending)
        first += added
      }
      Ok(take output)
    }
  )
}

pub fn encode(
  value: model.Decision,
  mut output: unique List[u8],
  mut previous: List[String],
  mut escaped: Bytes
) -> () uses {} {
  text.append(mut output, "{\"id\":")
  json.write_text_into(value.id, mut output)
  text.append(mut output, f",\"allow\":{value.allow},\"rules\":")
  if value.rules != previous {
    let mut builder: List[u8] = []
    text.append(mut builder, "[")
    let mut first = true
    for id in value.rules {
      if !first {
        text.append(mut builder, ",")
      }
      first = false
      json.write_text_into(id, mut builder)
    }
    text.append(mut builder, "]")
    escaped = bytes.from_list(take builder)
    previous = unique value.rules
  }
  bytes.append(mut output, escaped)
  text.append(mut output, "}")
}
