const HELP: String = "depplan FILE\nDry-run dependency planner; never executes nodes.\nReads FILE beneath the read-only input directory grant.\nLimits: 65536 bytes, 64 nodes, 128 raw prerequisites, 64 per node, 128 bytes per name.\nExit: 0 ordered/help, 1 blocked (includes downstream), 2 invalid input or I/O.\n"

fn read_local(rt: Io, name: String) -> Result[Bytes, model.Invalid] {
  let Ok(dir) = io.dir(rt, path.of("input")) else {
    return Error(Input("directory_grant"))
  }
  let mut Ok(handle) = file.open(dir, path.of(name)) else {
    return Error(Input("file_open"))
  }
  let mut reader = bufio.new(4096)
  let mut data: List[u8] = []
  while true {
    let remaining = model.INPUT_BYTES - list.len(data)
    let request = if remaining < 4096 {
      remaining + 1
    } else {
      4096u64
    }
    let Ok(count) = bufio.file_read_more(dir, mut handle, mut reader, request) else {
      return Error(Input("file_read"))
    }
    if count > remaining {
      return Error(Input("input_bytes_limit"))
    }
    if count == 0 {
      break
    }
    for byte in bufio.peek(reader, count) {
      list.push(mut data, byte)
    }
    bufio.consume(mut reader, count)
  }
  Ok(unique bytes.from_list(take data))
}

fn execute(rt: Io, args: Args) -> Result[model.Plan, model.Invalid] {
  if arg.len(args) != 1 {
    return Error(Input("usage"))
  }
  let Ok(name) = arg.text(args, 0) else {
    return Error(Input("arguments"))
  }
  let manifest = model.decode(read_local(rt, name)?)?
  model.plan(manifest)
}

pub fn main(rt: Io, args: Args) -> std@1/process.ExitCode {
  let Ok(output) = io.stdout(rt) else {
    return std@1/process.exit_code(2u8)
  }
  if arg.len(args) == 1 {
    if let Ok(name) = arg.text(args, 0) {
      if name == "--help" {
        let Ok(()) = out.print(output, HELP) else {
          return std@1/process.exit_code(2u8)
        }
        return std@1/process.SUCCESS
      }
    }
  }
  match execute(rt, args) {
    Ok(plan) => {
      let Ok(encoded) = json.stringify(model.plan_to_json(plan)) else {
        return std@1/process.exit_code(2u8)
      }
      let Ok(()) = out.print(output, f"{encoded}\n") else {
        return std@1/process.exit_code(2u8)
      }
      std@1/process.SUCCESS
    },
    Error(error) => {
      let report = model.report(error)
      let code = if report.error == "blocked" {
        1u8
      } else {
        2u8
      }
      let Ok(sink) = io.stderr(rt) else {
        return std@1/process.exit_code(2u8)
      }
      let Ok(encoded) = json.stringify(model.report_to_json(report)) else {
        return std@1/process.exit_code(2u8)
      }
      let Ok(()) = err.print(sink, f"{encoded}\n") else {
        return std@1/process.exit_code(2u8)
      }
      std@1/process.exit_code(code)
    },
  }
}
