// Replies and request helpers over std's HTTP/1.1 server connection, which reads
// requests (keep-alive and pipelining included) and frames responses.

pub type Reply {
  status: u16,
  headers: List[http.Header],
  body: Bytes,
}

/// Request size limits and timeouts. A request must arrive within `request` of its
/// first byte when a monotonic clock is granted; an idle keep-alive connection is
/// closed after `idle` either way.
pub type Limits {
  head: u64,
  body: u64,
  headers: u64,
  request: time.Duration,
  idle: time.Duration,
}

/// The std server configuration for `limits`; `timed` when a monotonic clock is
/// granted, which std needs to time a request.
pub fn config(limits: Limits, timed: bool) -> http.Config uses {} {
  let mut c = http.default_config()
  c.max_head_bytes = limits.head
  c.max_body_bytes = limits.body
  c.max_headers = limits.headers
  c.idle_timeout = Some(limits.idle)
  c.read_timeout = if timed {
    Some(limits.request)
  } else {
    None()
  }
  take c
}

pub fn reply(status: u16, content_type: String, take body: Bytes) -> Reply uses {} {
  Reply(
    status: status,
    headers: [http.Header(name: "Content-Type", value: unique content_type)],
    body: take body
  )
}

pub fn empty(status: u16) -> Reply uses {} {
  Reply(status: status, headers: [], body: b"")
}

pub fn text_reply(status: u16, message: String) -> Reply uses {} {
  reply(status, "text/plain; charset=utf-8", unique string.as_bytes(message))
}

/// The status that answers a request std could not read, or `None()` when the
/// connection just ends: closed, cut short, timed out (std answers 408) or failed.
pub fn rejection(error: http.HttpError) -> Option[u16] uses {} {
  match error {
    HeadTooLarge() => Some(431),
    BodyTooLarge() => Some(413),
    Malformed(_) | Chunk() => Some(400),
    UnsupportedTransferEncoding() => Some(501),
    _ => None(),
  }
}

/// Sends `response` to the request `connection` last received. A HEAD request, a
/// 204 and a 304 get the head alone.
pub fn send(mut connection: http.ServerStream, response: Reply) -> Result[
  (),
  http.HttpError
] {
  http.respond(mut connection, response.status, response.headers, response.body, false)
}

/// The request path without its query.
pub fn route_path(request: http.ServerRequest) -> String in request uses {} {
  match string.split_once(request.target, "?") {
    Some((p, _)) => p,
    None() => request.target,
  }
}

/// The decoded query parameters of the request target; malformed queries give none.
pub fn query(request: http.ServerRequest) -> unique List[(unique String, unique String)] uses {} {
  let Some((_, raw)) = string.split_once(request.target, "?") else {
    return []
  }
  match uri.query_pairs(raw) {
    Ok(pairs) => take pairs,
    Error(_) => [],
  }
}

/// The first value of query parameter `name`.
pub fn param(pairs: List[(String, String)], name: String) -> Option[String] uses {} {
  for (key, value) in pairs {
    if key == name {
      return Some(unique value)
    }
  }
  None()
}

/// The fields of an `application/x-www-form-urlencoded` body.
pub fn form(request: http.ServerRequest) -> Result[
  unique List[(unique String, unique String)],
  u16
] uses {} {
  let media = option.unwrap_or(http.header(request.headers, "content-type"), "")
  if !string.starts_with(string.ascii_lower(media), "application/x-www-form-urlencoded") {
    return Error(415)
  }
  let body = match string.from_bytes(unique request.body) {
    Ok(text) => take text,
    Error(_) => return Error(400),
  }
  match uri.query_pairs(body) {
    Ok(pairs) => Ok(take pairs),
    Error(_) => Error(400),
  }
}
