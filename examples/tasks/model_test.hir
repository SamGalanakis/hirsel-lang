fn make_draft(title: String, priority: String, due: String, tags: String) -> Draft uses {} {
  Draft(
    title: unique title,
    description: "",
    priority: unique priority,
    due: unique due,
    tags: unique tags
  )
}

fn board_of(names: List[String]) -> Board uses {} {
  let mut board = empty_board()
  for title in names {
    let Ok(item) = validate(make_draft(title, "", "", "")) else {
      continue
    }
    let _ = create(mut board, unique item)
  }
  take board
}

fn names_of(items: List[Item]) -> List[String] uses {} {
  list.map(
    items,
    fn(i: Item) -> String {
      unique i.title
    }
  )
}

@test
fn validation_normalizes_and_rejects(t: Test) {
  let Ok(item) = validate(
    make_draft("  Shear the sheep ", "high", " 2026-02-03", "Farm, wool,farm, ,WOOL")
  ) else {
    test.fail(t)
  }
  test.check(t, item.title == "Shear the sheep" && item.priority == High())
  test.check(
    t,
    item.due == results.ok(date.parse("2026-02-03")) && item.tags == ["farm", "wool"]
  )
  test.check(
    t,
    validate(make_draft("   ", "", "", "")) == Error(Title("a task needs a title"))
  )
  test.check(t, results.is_error(validate(make_draft("x", "urgent", "", ""))))
  test.check(t, results.is_error(validate(make_draft("x", "", "2026-02-30", ""))))
  test.check(t, results.is_error(validate(make_draft("x", "", "", "a b"))))
  test.check(
    t,
    results.is_error(validate(make_draft("x", "", "", "a,b,c,d,e,f,g,h,i")))
  )
}

@test
fn mutations_bump_the_revision_only_when_they_change_something(t: Test) {
  let mut board = board_of(["a", "b", "c"])
  test.check(t, board.revision == 3 && board.next_id == 4)
  test.check(t, move(mut board, 3, Up()))
  test.check(t, names_of(board.tasks) == ["a", "c", "b"])
  test.check(
    t,
    !move(mut board, 1, Up()) && !move(mut board, 2, Down()) && board.revision == 4
  )
  test.check(t, set_status(mut board, 2, next_status(Todo())))
  test.check(t, delete(mut board, 1) && !delete(mut board, 1))
  let Ok(edit) = validate(make_draft("B!", "low", "", "x")) else {
    test.fail(t)
  }
  test.check(t, update(mut board, 2, unique edit) && !update(mut board, 9, unique edit))
  let Some(b) = find(board, 2) else {
    test.fail(t)
  }
  // An edit keeps the status it does not mention.
  test.check(t, b.title == "B!" && b.status == Doing() && b.tags == ["x"])
  test.check(t, board.revision == 7 && board.next_id == 4)
}

@test
fn select_filters_searches_and_sorts_stably(t: Test) {
  let mut board = empty_board()
  let specs: List[(String, String, String, String)] = [
    ("Write report", "high", "2026-03-01", "work"),
    ("buy hay", "low", "", "farm"),
    ("Call vet", "high", "2026-02-01", "farm, urgent"),
    ("Report taxes", "medium", "2026-02-15", "")
  ]
  for (title, priority, due, tags) in specs {
    let Ok(item) = validate(make_draft(title, priority, due, tags)) else {
      test.fail(t)
    }
    let _ = create(mut board, unique item)
  }
  let _ = set_status(mut board, 4, Done())
  let everything = Query(status: "", tag: "", text: "", sort: "manual")
  test.check(
    t,
    names_of(select(board, everything)) == [
      "Write report",
      "buy hay",
      "Call vet",
      "Report taxes"
    ]
  )
  let mut q = unique everything
  q.sort = "due"
  test.check(
    t,
    names_of(select(board, q)) == [
      "Call vet",
      "Report taxes",
      "Write report",
      "buy hay"
    ]
  )
  q.sort = "priority"
  test.check(
    t,
    names_of(select(board, q)) == [
      "Write report",
      "Call vet",
      "Report taxes",
      "buy hay"
    ]
  )
  q.sort = "title"
  test.check(
    t,
    names_of(select(board, q)) == [
      "Call vet",
      "Report taxes",
      "Write report",
      "buy hay"
    ]
  )
  q.sort = "manual"
  q.text = "REPORT"
  test.check(t, names_of(select(board, q)) == ["Write report", "Report taxes"])
  q.text = "urg"
  test.check(t, names_of(select(board, q)) == ["Call vet"])
  q.text = ""
  q.tag = "farm"
  test.check(t, names_of(select(board, q)) == ["buy hay", "Call vet"])
  q.tag = ""
  q.status = "done"
  test.check(t, names_of(select(board, q)) == ["Report taxes"])
  test.check(t, all_tags(board) == ["work", "farm", "urgent"])
  test.check(t, counts(board) == (3, 0, 1))
}

@test
fn boards_round_trip_through_json(t: Test) {
  let mut board = board_of(["one", "two"])
  let Some(item) = find(board, 1) else {
    test.fail(t)
  }
  let mut dated = unique item
  dated.due = date.new(2028, 2, 29)
  test.check(t, update(mut board, 1, take dated))
  let _ = set_status(mut board, 2, Done())
  let mut encoded: List[u8] = []
  test.check(t, results.is_ok(board_json_into(board, mut encoded, 0)))
  let Ok(decoded) = board_from_json_bytes(bytes.from_list(take encoded)) else {
    test.fail(t)
  }
  test.check(t, decoded == board)
  let Ok(back) = board_from_json(board_to_json(board)) else {
    test.fail(t)
  }
  test.check(t, back == board)
}

fn selected_ids(board: Board, query: Query) -> List[u64] uses {} {
  let mut ids: List[u64] = []
  for i in selected_positions(board, query) {
    list.push(mut ids, board.tasks[i].id)
  }
  take ids
}

fn owned_ids(board: Board, query: Query) -> List[u64] uses {} {
  list.map(
    select(board, query),
    fn(item: Item) -> u64 {
      item.id
    }
  )
}

@test
fn rendering_positions_match_owned_selection_and_are_recomputed(t: Test) {
  let mut board = empty_board()
  let specs: List[(String, String, String, String)] = [
    ("Straße", "high", "2026-03-01", "farm,FARM,farm"),
    ("same", "low", "", "farm"),
    ("same", "high", "2026-03-01", "work"),
    ("Élan", "medium", "", "work"),
    ("same", "high", "2026-02-01", "farm")
  ]
  for (title, priority, due, tags) in specs {
    let Ok(item) = validate(make_draft(title, priority, due, tags)) else {
      test.fail(t)
    }
    let _ = create(mut board, unique item)
  }
  let _ = set_status(mut board, 3, Done())
  let orders: List[String] = ["manual", "due", "priority", "title", "unknown"]
  let filters: List[(String, String, String)] = [
    ("", "", ""),
    ("", "", "STRASSE"),
    ("", "", " éLAN "),
    ("", "farm", ""),
    ("done", "", ""),
    ("todo", "farm", "same"),
    ("", "missing", ""),
    ("missing", "", ""),
    ("", "", "absent")
  ]
  for order in orders {
    for (status, tag, text) in filters {
      let q = Query(
        status: unique status,
        tag: unique tag,
        text: unique text,
        sort: unique order
      )
      test.check(t, selected_ids(board, q) == owned_ids(board, q))
      test.check(t, list.len(selected_ids(empty_board(), q)) == 0)
    }
  }
  let q = Query(status: "", tag: "", text: "same", sort: "title")
  let owned = select(board, q)
  test.check(t, selected_ids(board, q) == [2, 3, 5])
  let Ok(edit) = validate(make_draft("changed", "", "", "")) else {
    test.fail(t)
  }
  test.check(t, update(mut board, 2, unique edit))
  test.check(t, delete(mut board, 3))
  test.check(t, selected_ids(board, q) == [5])
  test.check(t, names_of(owned) == ["same", "same", "same"])
  test.check(
    t,
    list.map(
      owned,
      fn(item: Item) -> u64 {
        item.id
      }
    ) == [2, 3, 5]
  )
}

@test
fn rendering_ties_keep_manual_positions_across_quicksort_partitions(t: Test) {
  let mut board = empty_board()
  for _ in 0u64..40u64 {
    let Ok(item) = validate(make_draft("same", "high", "", "")) else {
      test.fail(t)
    }
    let _ = create(mut board, unique item)
  }
  let _ = move(mut board, 40, Up())
  let manual = selected_positions(
    board,
    Query(status: "", tag: "", text: "", sort: "manual")
  )
  let orders: List[String] = ["due", "priority", "title"]
  for order in orders {
    test.check(
      t,
      selected_positions(
        board,
        Query(status: "", tag: "", text: "", sort: unique order)
      ) == manual
    )
  }
}
