fn request_of(method: String, target: String) -> http.ServerRequest uses {} {
  http.ServerRequest(
    method: unique method,
    target: unique target,
    version: Http11(),
    headers: [],
    body: b"",
    trailers: [],
    keep_alive: true
  )
}

fn routed(method: String, target: String) -> Route uses {} {
  route(request_of(method, target))
}

@test
fn requests_route_by_method_and_path(t: Test) {
  test.check(t, routed("GET", "/") == Home(view.default_query()))
  test.check(
    t,
    routed("GET", "/?status=done&tag=farm&q=hay&sort=due") == Home(
      model.Query(status: "done", tag: "farm", text: "hay", sort: "due")
    )
  )
  // An unknown status or sort falls back to the default.
  test.check(
    t,
    routed("GET", "/?status=later&sort=random") == Home(view.default_query())
  )
  test.check(t, routed("POST", "/") == NotAllowed("GET, HEAD"))
  test.check(t, routed("GET", "/updates") == Updates())
  test.check(t, routed("HEAD", "/static/app.css") == Static("app.css"))
  test.check(t, routed("POST", "/tasks") == Create())
  test.check(t, routed("GET", "/tasks") == NotAllowed("POST"))
  test.check(t, routed("GET", "/tasks/7") == Detail(7))
  test.check(t, routed("POST", "/tasks/7") == Edit(7))
  test.check(t, routed("DELETE", "/tasks/7") == Remove(7))
  test.check(t, routed("PUT", "/tasks/7") == NotAllowed("GET, HEAD, POST, DELETE"))
  test.check(t, routed("POST", "/tasks/7/advance") == Advance(7))
  test.check(t, routed("POST", "/tasks/7/move?dir=up") == Move(7, Up()))
  test.check(t, routed("POST", "/tasks/7/move?dir=down") == Move(7, Down()))
  test.check(t, routed("POST", "/tasks/7/move?dir=left") == NotFound())
  test.check(t, routed("GET", "/tasks/0") == NotFound())
  test.check(t, routed("GET", "/tasks/x") == NotFound())
  test.check(t, routed("GET", "/elsewhere") == NotFound())
}

fn item_of(title: String) -> model.Item uses {} {
  let draft = model.Draft(
    title: unique title,
    description: "",
    priority: "",
    due: "",
    tags: ""
  )
  match model.validate(draft) {
    Ok(item) => take item,
    Error(_) => model.Item(
      id: 0,
      title: "",
      description: "",
      status: Todo(),
      priority: Medium(),
      due: None(),
      tags: []
    ),
  }
}

@test
fn changes_save_a_snapshot_only_when_the_board_changes(t: Test) {
  let mut board = model.empty_board()
  let added = apply(mut board, Add(item_of("a")))
  test.check(t, added.found && added.id == 1)
  let Some((revision, data)) = added.saved else {
    test.fail(t)
  }
  let back = test.expect_ok(t, store.decode(unique data))
  test.check(t, revision == 1 && back == board)
  let _ = apply(mut board, Add(item_of("b")))
  let edge = apply(mut board, Shift(1, Up()))
  test.check(t, edge.found && option.is_none(edge.saved))
  let missing = apply(mut board, Next(9))
  test.check(t, !missing.found && option.is_none(missing.saved))
  let advanced = apply(mut board, Next(2))
  test.check(
    t,
    advanced.found && option.is_some(advanced.saved) && board.tasks[1].status == Doing()
  )
  let dropped = apply(mut board, Drop(1))
  test.check(t, dropped.found && board.revision == 4 && list.len(board.tasks) == 1)
}

fn services(tasks: Tasks) -> Services {
  Services(
    tasks: tasks,
    logger: Logger(sink: None(), minimum: Error()),
    wall: None(),
    clock: None(),
    limits: httpd.Limits(
      head: 16384,
      body: 65536,
      headers: 64,
      request: time.Duration(nanoseconds: 1000000000),
      idle: time.Duration(nanoseconds: 1000000000)
    ),
    state: mutex.create(tasks, model.empty_board()),
    assets: shared.freeze(map.empty())
  )
}

fn on_disk(d: Dir, revision: u64) -> bool {
  results.is_ok(file.metadata(d, path.of(store.snapshot_name(revision))))
}

// A change is on disk before any stream hears of it; a change that alters nothing
// saves and publishes nothing.
@test
fn changes_are_saved_before_they_are_published(t: Test) {
  let tasks = test.tasks(t)
  let d = test.dir(t, [])
  let svc = services(tasks)
  task.scope(
    tasks,
    fn(s: Scope) -> () {
      let (saves, jobs): (Sender[SaveJob], Receiver[SaveJob]) = channel.open(tasks)
      let (updates, commands): (Sender[hub.Command], Receiver[hub.Command]) = channel.open(
        tasks
      )
      let writer = task.async(
        s,
        fn() -> () {
          write_loop(tasks, d, Durable(), svc.logger, take jobs)
        }
      )
      let broadcaster = task.async(
        s,
        fn() -> () {
          hub.run(tasks, take commands)
        }
      )
      let mut to_writer = take saves
      let mut to_hub = take updates
      let Some(subscription) = hub.subscribe(tasks, mut to_hub) else {
        test.fail(t)
      }
      let mut wakeups = take subscription
      test.check(t, commit(svc, mut to_writer, mut to_hub, Add(item_of("a"))) == Ok(1))
      test.check(t, channel.receive(tasks, mut wakeups) == Ok(1) && on_disk(d, 1))
      test.check(t, commit(svc, mut to_writer, mut to_hub, Next(9)) == Error(404))
      test.check(t, commit(svc, mut to_writer, mut to_hub, Shift(1, Up())) == Ok(1))
      test.check(t, commit(svc, mut to_writer, mut to_hub, Next(1)) == Ok(1))
      // The move changed nothing, so the next wakeup is the advance's revision.
      test.check(t, channel.receive(tasks, mut wakeups) == Ok(2) && on_disk(d, 2))
      let status = mutex.with(
        tasks,
        svc.state,
        fn(mut board: unique model.Board) -> model.Status uses {} {
          board.tasks[0].status
        }
      )
      test.check(t, status == Doing())
      hub.stop(tasks, mut to_hub)
      close_sender(take to_hub)
      close_sender(take to_writer)
      task.await(s, take broadcaster)
      task.await(s, take writer)
    }
  )
}
