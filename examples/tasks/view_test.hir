fn parsed_day(t: Test, spelling: String) -> time.Date {
  let Ok(value) = date.parse(spelling) else {
    test.fail(t)
  }
  value
}

// Built directly rather than validated, as a snapshot on disk might hold it: the
// view escapes whatever a task holds, not only what validation lets through.
fn hostile_board() -> model.Board uses {} {
  let mut board = model.empty_board()
  let item = model.Item(
    id: 0,
    title: "<script>alert(\"x\")</script>",
    description: "a & b",
    status: Todo(),
    priority: High(),
    due: date.new(2026, 3, 1),
    tags: ["x'y"]
  )
  let _ = model.create(mut board, unique item)
  take board
}

fn screen_on(selected: u64) -> Screen uses {} {
  Screen(
    query: default_query(),
    selected: selected,
    today: results.ok(date.parse("2026-03-04"))
  )
}

@test
fn due_dates_read_relative_to_today(t: Test) {
  let today = results.ok(date.parse("2026-03-04"))
  test.check(t, due_text(parsed_day(t, "2026-03-04"), today) == "due today")
  test.check(t, due_text(parsed_day(t, "2026-03-05"), today) == "due tomorrow")
  test.check(t, due_text(parsed_day(t, "2026-03-14"), today) == "due in 10 days")
  test.check(t, due_text(parsed_day(t, "2026-03-03"), today) == "due yesterday")
  test.check(t, due_text(parsed_day(t, "2026-02-26"), today) == "6 days overdue")
  test.check(t, due_text(parsed_day(t, "2026-03-04"), None()) == "due 2026-03-04")
}

@test
fn task_text_is_escaped_everywhere_it_is_shown(t: Test) {
  let board = hostile_board()
  let shown = live(board, screen_on(1))
  test.check(t, !string.contains(shown, "<script>"))
  test.check(
    t,
    string.contains(shown, ">&lt;script&gt;alert(&#34;x&#34;)&lt;/script&gt;</a>")
  )
  test.check(
    t,
    string.contains(shown, "<h2>&lt;script&gt;alert(&#34;x&#34;)&lt;/script&gt;</h2>")
  )
  test.check(t, string.contains(shown, "<p class=\"description\">a &amp; b</p>"))
  // A tag lands in a JavaScript string inside an attribute: quoted, then escaped.
  test.check(
    t,
    string.contains(
      shown,
      "data-on:click=\"$filter.tag = &#34;x&#39;y&#34;\">#x&#39;y</button>"
    )
  )
  test.check(
    t,
    string.contains(
      shown,
      "<time class=\"due overdue\" datetime=\"2026-03-01\">3 days overdue</time>"
    )
  )
  // Streaming the nested JSON/HTML context must preserve the old composition,
  // including all short/control escapes, punctuation and multi-byte scalars.
  let cases: List[String] = ["", "\"\\/<>&'\t\n\r\x08\x0cé😀", "\0\x01\x1f", "plain"]
  for value in cases {
    let quoted = match json.stringify(Text(unique value)) {
      Ok(q) => take q,
      Error(_) => "invalid",
    }
    let expected = html.escape(string.replace(quoted, "<", "\\u003c"))
    let mut out: List[u8] = []
    text.append(mut out, "prefix")
    js_string_into(mut out, value)
    test.check(t, text.finish_valid(take out) == f"prefix{expected}")
  }
}

@test
fn the_live_patch_holds_every_element_the_stream_replaces(t: Test) {
  let board = hostile_board()
  let lines = string.split(live(board, screen_on(0)), "\n")
  test.check(t, list.len(lines) == 4)
  test.check(
    t,
    string.starts_with(
      lines[0],
      "<p id=\"stats\">1 to do &middot; 0 doing &middot; 0 done</p>"
    )
  )
  test.check(t, string.starts_with(lines[1], "<select id=\"tag-filter\""))
  test.check(
    t,
    string.starts_with(
      lines[2],
      "<ul id=\"list\"><li id=\"task-1\" class=\"task status-todo priority-high\">"
    )
  )
  test.check(t, lines[3] == "<aside id=\"detail\" class=\"empty\"></aside>")
  let none = live(model.empty_board(), screen_on(0))
  test.check(
    t,
    string.contains(none, "<li class=\"empty\">No tasks yet. Add one above.</li>")
  )
}

@test
fn the_page_carries_its_signals_and_the_update_stream(t: Test) {
  let shown = page(hostile_board(), screen_on(1))
  test.check(t, string.contains(shown, "<body data-signals=\"{&#34;"))
  test.check(t, string.contains(shown, "&#34;draft&#34;:{&#34;"))
  test.check(t, string.contains(shown, "&#34;selected&#34;:1"))
  test.check(t, string.contains(shown, "@get('/updates', {openWhenHidden: true"))
  test.check(
    t,
    string.contains(
      shown,
      "<script type=\"module\" src=\"/static/datastar.js\"></script>"
    )
  )
}

// Keep the owning selection as an independent byte oracle for projection.
fn owning_task_list(board: model.Board, screen: Screen) -> String uses {} {
  let shown = model.select(board, screen.query)
  let mut out: List[u8] = []
  text.append(mut out, "<ul id=\"list\">")
  if list.len(shown) == 0 {
    let message = if list.len(board.tasks) == 0 {
      "No tasks yet. Add one above."
    } else {
      "No tasks match."
    }
    text.append(mut out, f"<li class=\"empty\">{message}</li>")
  }
  for item in shown {
    row(mut out, item, screen.today, screen.selected)
  }
  text.append(mut out, "</ul>")
  text.finish_valid(take out)
}

fn check_selection_bytes(t: Test, board: model.Board) {
  let orders: List[String] = ["manual", "due", "priority", "title", "unknown"]
  let queries: List[String] = ["", "STRASSE", "éLAN", "missing"]
  for order in orders {
    for text in queries {
      let mut screen = screen_on(999)
      screen.query.sort = unique order
      screen.query.text = unique text
      let mut out: List[u8] = []
      task_list(mut out, board, screen)
      test.check(t, text.finish_valid(take out) == owning_task_list(board, screen))
    }
  }
}

@test
fn indexed_rows_preserve_bytes_across_requests(t: Test) {
  let mut board = hostile_board()
  let titles: List[String] = ["same", "Straße", "same", "Élan"]
  for title in titles {
    let item = model.Item(
      id: 0,
      title: unique title,
      description: "<>&é",
      status: Todo(),
      priority: High(),
      due: None(),
      tags: ["farm", "farm"]
    )
    let _ = model.create(mut board, take item)
  }
  check_selection_bytes(t, board)
  let item = model.Item(
    id: 0,
    title: "updated",
    description: "",
    status: Done(),
    priority: Low(),
    due: date.new(2026, 1, 1),
    tags: []
  )
  test.check(t, model.update(mut board, 2, take item))
  test.check(t, model.delete(mut board, 3))
  check_selection_bytes(t, board)
  check_selection_bytes(t, model.empty_board())
}
