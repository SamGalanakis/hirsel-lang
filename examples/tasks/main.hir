// A task manager served over HTTP with Datastar: server-rendered HTML, live updates
// to every open browser over a long-lived event stream, and snapshots on disk.
//
// Grants: tasks, net (listen on the configured address), the `data` directory
// (read_write) and the `static` directory (read). Optional: stdout announces the
// address, stderr receives JSON log lines, the wall clock dates log lines and
// "due in 3 days", signals stop it on SIGINT/SIGTERM, and stdin provides the
// deterministic stop control used by the end-to-end tests.

pub type StartError = Grant(GrantError) | Files(FileError) | Store(store.StoreError) | Network(
  NetError
) | Usage(String)

pub type Config {
  host: String,
  port: u16,
  durability: Durability,
  level: log.Level,
}

pub const ENV_KEYS: List[String] = [
  "TASKS_HOST",
  "TASKS_PORT",
  "TASKS_DURABILITY",
  "TASKS_LOG_LEVEL"
]

fn flags() -> List[cli.Flag] uses {} {
  [
    cli.Flag(
      name: "host",
      short: None(),
      kind: Value(),
      help: "listen address (TASKS_HOST, default 127.0.0.1)"
    ),
    cli.Flag(
      name: "port",
      short: Some(b'p'),
      kind: Value(),
      help: "listen port, 0 for any (TASKS_PORT, default 8080)"
    ),
    cli.Flag(
      name: "durability",
      short: None(),
      kind: Value(),
      help: "volatile or durable snapshots (TASKS_DURABILITY, default volatile)"
    ),
    cli.Flag(
      name: "log-level",
      short: None(),
      kind: Value(),
      help: "debug, info, warn or error (TASKS_LOG_LEVEL, default info)"
    ),
    cli.Flag(name: "help", short: Some(b'h'), kind: Switch(), help: "print this help")
  ]
}

fn level_from(text: String) -> Option[log.Level] uses {} {
  match text {
    "debug" => Some(Debug()),
    "info" => Some(Info()),
    "warn" => Some(Warn()),
    "error" => Some(Error()),
    _ => None(),
  }
}

// The last occurrence of a flag, else the environment value, else the default.
fn setting(
  parsed: cli.Parsed,
  environment: Map[String, String],
  flag: String,
  key: String,
  fallback: String
) -> String uses {} {
  if let Some(values) = map.get(parsed.flags, flag) {
    if list.len(values) > 0 {
      return unique values[list.len(values) - 1]
    }
  }
  match map.get(environment, key) {
    Some(value) => unique value,
    None() => unique fallback,
  }
}

/// The configuration from the arguments and the environment, the arguments winning;
/// `Ok(None())` when help was asked for.
pub fn configure(take args: List[String], environment: Map[String, String]) -> Result[
  Option[Config],
  String
] uses {} {
  let parsed = match cli.parse(take args, flags()) {
    Ok(p) => take p,
    Error(UnknownFlag(i)) => return Error(f"unknown option at argument {i}"),
    Error(MissingValue(i)) => return Error(f"missing value at argument {i}"),
    Error(_) => return Error("invalid arguments"),
  }
  if map.contains(parsed.flags, "help") {
    return Ok(None())
  }
  if list.len(parsed.positional) > 0 {
    return Error(f"unexpected argument {parsed.positional[0]}")
  }
  let host = setting(parsed, environment, "host", "TASKS_HOST", "127.0.0.1")
  let port_text = setting(parsed, environment, "port", "TASKS_PORT", "8080")
  let Ok(port) = u16.parse(port_text) else {
    return Error(f"port must be 0 to 65535, not {port_text}")
  }
  let durability_text = setting(
    parsed,
    environment,
    "durability",
    "TASKS_DURABILITY",
    "volatile"
  )
  let durability: Durability = if durability_text == "durable" {
    Durable()
  } else if durability_text == "volatile" {
    Volatile()
  } else {
    return Error(f"durability is volatile or durable, not {durability_text}")
  }
  let level_text = setting(parsed, environment, "log-level", "TASKS_LOG_LEVEL", "info")
  let Some(level) = level_from(level_text) else {
    return Error(f"log level is debug, info, warn or error, not {level_text}")
  }
  Ok(Some(Config(host: take host, port: port, durability: durability, level: level)))
}

fn arguments(args: Args) -> Result[List[String], StartError] {
  let mut all: List[String] = []
  for i in 0u64..arg.len(args) {
    match arg.text(args, i) {
      Ok(text) => list.push(mut all, take text),
      Error(_) => return Error(Usage("arguments must be UTF-8")),
    }
  }
  Ok(take all)
}

// Granted environment keys only; a key the run does not grant reads as unset.
fn environment_of(environment: Env) -> Map[String, String] {
  let mut found: Map[String, String] = map.empty()
  for key in ENV_KEYS {
    if let Ok(Some(value)) = env.get(environment, key) {
      map.insert(mut found, unique key, unique value)
    }
  }
  take found
}

pub fn main(rt: Io, args: Args, environment: Env) -> Result[(), StartError] {
  let stdout = results.ok(io.stdout(rt))
  let config = match configure(arguments(args)?, environment_of(environment)) {
    Ok(Some(c)) => take c,
    Ok(None()) => {
      if let Some(out) = stdout {
        let _ = out.print(out, cli.usage("tasks", flags()))
      }
      return Ok(())
    },
    Error(message) => return Error(Usage(message)),
  }
  let Ok(ip) = net.parse_ip(config.host) else {
    return Error(Usage(f"host must be an IP address, not {config.host}"))
  }
  let n = io.net(rt)?
  let tasks = io.tasks(rt)?
  let data = io.dir(rt, path.of("data"))?
  let static_files = io.dir(rt, path.of("static"))?
  let logger = app.Logger(sink: results.ok(io.stderr(rt)), minimum: config.level)
  let wall = results.ok(io.wall_clock(rt))
  let signals = results.ok(io.signals(rt))
  let board = store.load(data)?
  let files = app.load_assets(static_files)?
  app.note(
    logger,
    Info(),
    "loaded",
    [
      ("tasks", u64.to_string(list.len(board.tasks))),
      ("revision", u64.to_string(board.revision))
    ],
    wall
  )
  let svc = app.Services(
    tasks: tasks,
    logger: logger,
    wall: wall,
    clock: results.ok(io.monotonic_clock(rt)),
    limits: httpd.Limits(
      head: 16384,
      body: 65536,
      headers: 64,
      request: time.Duration(nanoseconds: 30000000000),
      idle: time.Duration(nanoseconds: 120000000000)
    ),
    state: mutex.create(tasks, take board),
    assets: shared.freeze(take files)
  )
  let listener = net.listen(n, SocketAddr(ip: ip, port: config.port))?
  let bound = net.local_addr(n, listener)?
  let shown = net.socket_addr_to_string(bound)
  app.note(logger, Info(), "listening", [("address", copy shown)], wall)
  if let Some(out) = stdout {
    let _ = out.print(out, f"listening on http://{shown}/\n")
  }
  app.serve(
    n,
    svc,
    take listener,
    data,
    config.durability,
    results.ok(io.stdin(rt)),
    signals
  )
  Ok(())
}
