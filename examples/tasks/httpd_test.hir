fn small() -> Limits uses {} {
  Limits(head: 2048, body: 64)
}

fn status_of(raw: String) -> u16 uses {} {
  match parse(string.as_bytes(raw), small()) {
    Ok(Some(_)) => 0,
    Ok(None()) => 1,
    Error(status) => status,
  }
}

fn with_headers(count: u64) -> unique String uses {} {
  let mut out: List[u8] = []
  text.append(mut out, "GET / HTTP/1.1\r\n")
  for i in 0u64..count {
    text.append(mut out, f"X-H{i}: {i}\r\n")
  }
  text.append(mut out, "\r\n")
  text.finish_valid(take out)
}

@test
fn parse_reads_one_request_and_reports_its_length(t: Test) {
  let first = "POST /tasks/3?x=1 HTTP/1.1\r\nHost: a\r\nContent-Type: application/x-www-form-urlencoded\r\nContent-Length: 19\r\n\r\ntitle=Hay+%26+oats&"
  let raw = f"{first}GET / HTTP/1.1\r\n\r\n"
  let Ok(Some((request, used))) = parse(string.as_bytes(raw), small()) else {
    test.fail(t)
  }
  test.check(t, used == string.byte_len(first))
  test.check(
    t,
    request.method == "POST" && request.target == "/tasks/3?x=1" && route_path(request) == "/tasks/3"
  )
  test.check(t, request.keep_alive && http.header(request.headers, "host") == Some("a"))
  test.check(t, form(request) == Ok([("title", "Hay & oats")]))
  test.check(
    t,
    param(query(request), "x") == Some("1") && param(query(request), "y") == None()
  )
}

@test
fn parse_waits_for_the_whole_head_and_body(t: Test) {
  test.check(t, status_of("GET / HTTP/1.1\r\nHost: a\r\n") == 1)
  test.check(t, status_of("POST / HTTP/1.1\r\nContent-Length: 5\r\n\r\nabc") == 1)
  test.check(t, status_of("POST / HTTP/1.1\r\nContent-Length: 5\r\n\r\nabcde") == 0)
}

@test
fn parse_takes_more_headers_than_std_and_rejects_bad_requests(t: Test) {
  test.check(t, status_of(with_headers(40)) == 0)
  test.check(t, status_of(with_headers(65)) == 431)
  test.check(t, status_of("GET / HTTP/1.1\r\nX: y\r\n\r\n") == 0)
  test.check(t, status_of("GET /\r\n\r\n") == 400)
  test.check(
    t,
    status_of("POST / HTTP/1.1\r\nTransfer-Encoding: chunked\r\n\r\n") == 411
  )
  test.check(t, status_of("POST / HTTP/1.1\r\nContent-Length: 65\r\n\r\n") == 413)
}

@test
fn form_needs_the_urlencoded_media_type(t: Test) {
  let Ok(Some((request, _))) = parse(
    string.as_bytes(
      "POST / HTTP/1.1\r\nContent-Type: application/json\r\nContent-Length: 2\r\n\r\n{}"
    ),
    small()
  ) else {
    test.fail(t)
  }
  test.check(t, form(request) == Error(415))
}

@test
fn encode_frames_bodies_except_for_head_and_no_content(t: Test) {
  let ok = text_reply(200, "hi")
  test.check(
    t,
    string.from_bytes(encode(ok, true, false)) == Ok(
      "HTTP/1.1 200 OK\r\nContent-Type: text/plain; charset=utf-8\r\nContent-Length: 2\r\nConnection: keep-alive\r\n\r\nhi"
    )
  )
  test.check(
    t,
    string.from_bytes(encode(ok, false, true)) == Ok(
      "HTTP/1.1 200 OK\r\nContent-Type: text/plain; charset=utf-8\r\nContent-Length: 2\r\nConnection: close\r\n\r\n"
    )
  )
  test.check(
    t,
    string.from_bytes(encode(empty(204), true, false)) == Ok(
      "HTTP/1.1 204 No Content\r\nConnection: keep-alive\r\n\r\n"
    )
  )
}
