fn small() -> Limits uses {} {
  Limits(
    head: 2048,
    body: 64,
    headers: 64,
    request: time.Duration(nanoseconds: 1000000000),
    idle: time.Duration(nanoseconds: 1000000000)
  )
}

fn parsed(raw: String) -> Result[Option[http.ServerRequest], http.HttpError] uses {} {
  match http.parse_server_request(string.as_bytes(raw), config(small(), false)) {
    Ok(Some((request, _))) => Ok(Some(take request)),
    Ok(None()) => Ok(None()),
    Error(e) => Error(e),
  }
}

fn rejected(raw: String) -> Option[u16] uses {} {
  match parsed(raw) {
    Error(e) => rejection(e),
    _ => None(),
  }
}

fn with_headers(count: u64) -> String uses {} {
  let mut out: List[u8] = []
  text.append(mut out, "GET / HTTP/1.1\r\n")
  for i in 0u64..count {
    text.append(mut out, f"X-H{i}: {i}\r\n")
  }
  text.append(mut out, "\r\n")
  text.finish_valid(take out)
}

@test
fn requests_give_their_path_query_and_form(t: Test) {
  let Ok(Some(request)) = parsed(
    "POST /tasks/3?x=1 HTTP/1.1\r\nHost: a\r\nContent-Type: application/x-www-form-urlencoded\r\nContent-Length: 19\r\n\r\ntitle=Hay+%26+oats&"
  ) else {
    test.fail(t)
  }
  test.check(t, route_path(request) == "/tasks/3")
  test.check(t, form(request) == Ok([("title", "Hay & oats")]))
  test.check(
    t,
    param(query(request), "x") == Some("1") && param(query(request), "y") == None()
  )
  let Ok(Some(json_post)) = parsed(
    "POST / HTTP/1.1\r\nContent-Type: application/json\r\nContent-Length: 2\r\n\r\n{}"
  ) else {
    test.fail(t)
  }
  test.check(t, form(json_post) == Error(415))
}

@test
fn limits_take_browser_sized_heads_and_reject_larger_requests(t: Test) {
  test.check(t, results.is_ok(parsed(with_headers(40))))
  test.check(t, rejected(with_headers(65)) != None())
  test.check(t, rejected("POST / HTTP/1.1\r\nContent-Length: 65\r\n\r\n") == Some(413))
  test.check(t, rejected("GET /\r\n\r\n") == Some(400))
  let c = config(small(), false)
  test.check(
    t,
    c.max_head_bytes == 2048 && c.max_body_bytes == 64 && c.max_headers == 64
  )
  test.check(
    t,
    c.read_timeout == None() && c.idle_timeout == Some(
      time.Duration(nanoseconds: 1000000000)
    )
  )
  test.check(
    t,
    config(small(), true).read_timeout == Some(time.Duration(nanoseconds: 1000000000))
  )
}

// HEAD retains the representation length; 204/304 omit payload and length.
// A normal GET still sends its body on the same keep-alive connection.
@test
fn send_frames_each_reply(t: Test) {
  let requests = "HEAD / HTTP/1.1\r\nHost: a\r\n\r\nDELETE /x HTTP/1.1\r\nHost: a\r\n\r\nGET /cached HTTP/1.1\r\nHost: a\r\n\r\nGET /y HTTP/1.1\r\nHost: a\r\nConnection: close\r\n\r\n"
  let n = test.net(
    t,
    [],
    [
      NetListener(
        address: "127.0.0.1",
        port: 7332,
        clients: [
          NetClient(
            from: SocketAddr(ip: V4([127u8, 0u8, 0u8, 1u8]), port: 50001),
            tls: Plain(),
            steps: [
              Send(string.as_bytes(requests)),
              Expect(
                b"HTTP/1.1 200 \r\nContent-Type: text/plain; charset=utf-8\r\nContent-Length: 2\r\nConnection: keep-alive\r\n\r\n"
              ),
              Expect(b"HTTP/1.1 204 \r\nConnection: keep-alive\r\n\r\n"),
              Expect(b"HTTP/1.1 304 \r\nConnection: keep-alive\r\n\r\n"),
              Expect(
                b"HTTP/1.1 200 \r\nContent-Type: text/plain; charset=utf-8\r\nContent-Length: 2\r\nConnection: close\r\n\r\nhi"
              )
            ]
          )
        ]
      )
    ]
  )
  let Ok(listener) = net.listen(
    n,
    SocketAddr(ip: V4([127u8, 0u8, 0u8, 1u8]), port: 7332)
  ) else {
    test.fail(t)
  }
  let mut accepting = take listener
  let Ok((stream, _)) = net.accept(n, mut accepting) else {
    test.fail(t)
  }
  let mut connection = http.server_connection(
    test.tasks(t),
    n,
    take stream,
    config(small(), false)
  )
  for _ in 0u64..4 {
    let Ok(Some((exchange, request))) = http.next_stream(mut connection, None()) else {
      test.fail(t)
    }
    let mut responding = take exchange
    let response = if request.method == "DELETE" {
      empty(204)
    } else if request.target == "/cached" {
      Reply(status: 304, headers: [], body: b"suppressed")
    } else {
      text_reply(200, "hi")
    }
    test.check(t, results.is_ok(send(mut responding, response)))
  }
}
