// Query a top-level object member, preserving JSON number spelling.
fn query(take text: String, key: String) -> Result[String, common.Error] {
  let Ok(Object(object)) = json.parse(take text) else {
    return Error(Invalid())
  }
  let Some(selected) = map.get(object, key) else {
    return Error(Invalid())
  }
  let Ok(output) = json.stringify(selected) else {
    return Error(Invalid())
  }
  Ok(f"{output}\n")
}

pub fn main(rt: Io, args: Args) -> Result[(), common.Error] {
  let text = common.input(rt, args, r#"{"flock":["ewe","lamb"],"count":2}"#)?
  let key = results.unwrap_or(arg.text(args, 1), "flock")
  common.print(rt, query(take text, key)?)
}

@test
fn selects_nested_values_and_retains_number_spelling(t: Test) {
  test.check(t, query(r#"{"n":1.00,"v":[true,null]}"#, "n") == Ok("1.00\n"))
  test.check(t, query(r#"{"v":[true,null]}"#, "v") == Ok("[true,null]\n"))
}

@test
fn rejects_missing_keys_and_non_objects(t: Test) {
  test.check(t, results.is_error(query("{}", "missing")))
  test.check(t, results.is_error(query("[]", "missing")))
  test.check(t, results.is_error(query("{", "missing")))
}
