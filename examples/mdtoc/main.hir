// Print a table of contents for a Markdown file: one nested list item per ATX
// heading outside fenced code, linking to its GitHub-style anchor.
//
// usage: mdtoc FILE
pub type Heading {
  level: u64,
  title: String,
}

// Lowercase NFC text with Unicode simple case mapping. Spaces become `-`,
// `-` and `_` stay, other ASCII punctuation is dropped. Non-ASCII scalars stay.
fn slug(title: String) -> String {
  let mut out: List[u8] = []
  for scalar in string.scalars(unicode.normalize_nfc(title)) {
    let c = unicode.simple_lower(scalar)
    match c {
      'a'..='z' | '0'..='9' | '-' | '_' | '\u{80}'..='\u{10FFFF}' => {
        char.format_into(c, mut out)
      },
      ' ' => char.format_into('-', mut out),
      _ => (),
    }
  }
  match text.finish(take out) {
    Ok(s) => take s,
    Error(_) => "",
  }
}

// `#` to `######`, then a space or the end of the line; the closing `#`
// sequence and surrounding spaces are not part of the title.
fn heading(line: String) -> Option[Heading] {
  let bytes = string.as_bytes(line)
  let mut level = 0u64
  while level < bytes.len(bytes) && bytes[level] == b'#' {
    level += 1
  }
  if level == 0 || level > 6 {
    return None()
  }
  if level < bytes.len(bytes) && !blank(bytes[level]) {
    return None()
  }
  let mut end = bytes.len(bytes)
  while end > level && blank(bytes[end - 1]) {
    end -= 1
  }
  let mut closing = end
  while closing > level && bytes[closing - 1] == b'#' {
    closing -= 1
  }
  if closing == level || blank(bytes[closing - 1]) {
    end = closing
  }
  let raw = match string.from_bytes(unique bytes.slice(bytes, level, end)) {
    Ok(s) => take s,
    Error(_) => return None(),
  }
  Some(Heading(level: level, title: unique string.trim(raw)))
}

// A space or a tab.
fn blank(byte: u8) -> bool {
  match byte {
    b' ' | b'\t' => true,
    _ => false,
  }
}

// A fence opens with three or more backticks or tildes and closes with the same.
fn fence(line: String) -> Option[String] {
  let trimmed = string.trim(line)
  if string.starts_with(trimmed, "```") {
    return Some("```")
  }
  if string.starts_with(trimmed, "~~~") {
    return Some("~~~")
  }
  None()
}

fn headings(take text: String) -> List[Heading] {
  let mut found: List[Heading] = []
  let mut open: Option[String] = None()
  for raw in string.split(take text, "\n") {
    let line = match string.ends_with(raw, "\r") {
      true => match string.split_once(raw, "\r") {
        Some((content, _)) => unique content,
        None() => unique raw,
      },
      false => unique raw,
    }
    if let Some(marker) = open {
      if string.starts_with(string.trim(line), marker) {
        open = None()
      }
      continue
    }
    if let Some(marker) = fence(line) {
      open = Some(take marker)
      continue
    }
    if let Some(h) = heading(line) {
      list.push(mut found, take h)
    }
  }
  take found
}

fn toc(found: List[Heading]) -> String {
  let mut top = 6u64
  for h in found {
    if h.level < top {
      top = h.level
    }
  }
  let mut seen: Map[String, u64] = map.empty()
  let mut out: List[u8] = []
  for h in found {
    let base = slug(h.title)
    let anchor = match map.get(seen, base) {
      Some(n) => f"{base}-{n}",
      None() => copy base,
    }
    let count = option.unwrap_or(map.get(seen, base), 0u64) + 1
    map.insert(mut seen, take base, count)
    for _ in top..h.level {
      text.append(mut out, "  ")
    }
    text.append(mut out, f"- [{h.title}](#{anchor})\n")
  }
  match text.finish(take out) {
    Ok(s) => take s,
    Error(_) => "",
  }
}

fn run(rt: Io, args: Args) -> Result[String, String] {
  if arg.count(args) != 1 {
    return Error("usage: mdtoc FILE")
  }
  let Ok(name) = arg.text(args, 0) else {
    return Error("usage: mdtoc FILE")
  }
  let Ok(dir) = io.dir(rt, path.of("")) else {
    return Error("no file access granted")
  }
  let data = match file.read_bytes(dir, path.of(name)) {
    Ok(d) => copy d,
    Error(NotFound()) => return Error(f"no such file: {name}"),
    Error(_) => return Error(f"cannot read {name}"),
  }
  let Ok(text) = string.from_bytes(take data) else {
    return Error(f"{name} is not UTF-8")
  }
  Ok(toc(headings(take text)))
}

pub fn main(rt: Io, args: Args) -> Result[(), String] {
  // The host reports a returned error as `error: <message>` and exits 1.
  let text = run(rt, args)?
  let Ok(output) = io.stdout(rt) else {
    return Error("no stdout")
  }
  match out.print(output, text) {
    Ok(()) => Ok(()),
    Error(_) => Error("cannot write output"),
  }
}

@test
fn anchors_normalize_unicode_and_punctuation(t: Test) {
  test.check(t, slug("Hello, World!") == "hello-world")
  test.check(t, slug("CAFÉ") == "café")
}

@test
fn headings_require_a_separator(t: Test) {
  match heading("## title ##") {
    Some(found) => {
      test.check(t, found.level == 2)
      test.check(t, found.title == "title")
    },
    None() => test.fail(t),
  }
  if let Some(_) = heading("##not-a-heading") {
    test.fail(t)
  }
}
