// Query a JSON-lines or plain log: filter by level, message substring and JSON field,
// then print counts per level and the most frequent messages.
//
// usage: logq [--level LEVEL] [--match TEXT] [--field KEY=VALUE] [--top N] FILE
pub type Query {
  level: Option[String],
  pattern: Option[String],
  field: Option[(String, String)],
  top: u64,
  file: String,
}

pub type Entry {
  level: String,
  message: String,
  fields: Map[String, json.Value],
}

pub type Ranked {
  message: String,
  count: u64,
}

const USAGE: String = "usage: logq [--level LEVEL] [--match TEXT] [--field KEY=VALUE] [--top N] FILE"

const MAX_LINE: u64 = 65536

fn flag_value(args: Args, i: u64, flag: String) -> Result[String, String] {
  if i >= arg.len(args) {
    return Error(f"{flag} needs a value")
  }
  let Ok(text) = arg.text(args, i) else {
    return Error(f"{flag} value must be UTF-8")
  }
  Ok(take text)
}

fn parse_args(args: Args) -> Result[Query, String] {
  let mut level: Option[String] = None()
  let mut pattern: Option[String] = None()
  let mut field: Option[(String, String)] = None()
  let mut top = 5u64
  let mut file: Option[String] = None()
  let mut i = 0u64
  while i < arg.len(args) {
    let Ok(text) = arg.text(args, i) else {
      return Error("arguments must be UTF-8")
    }
    i += 1
    if text == "--level" {
      level = Some(string.ascii_upper(flag_value(args, i, text)?))
      i += 1
    } else if text == "--match" {
      pattern = Some(flag_value(args, i, text)?)
      i += 1
    } else if text == "--field" {
      let value = flag_value(args, i, text)?
      let Some((key, wanted)) = string.split_once(value, "=") else {
        return Error("--field needs KEY=VALUE")
      }
      field = Some((unique key, unique wanted))
      i += 1
    } else if text == "--top" {
      let Ok(n) = u64.parse(flag_value(args, i, text)?) else {
        return Error("--top needs a number")
      }
      top = n
      i += 1
    } else if string.starts_with(text, "--") {
      return Error(f"unknown flag {text}")
    } else if option.is_some(file) {
      return Error(USAGE)
    } else {
      file = Some(take text)
    }
  }
  match file {
    Some(f) => Ok(
      Query(
        level: take level,
        pattern: take pattern,
        field: take field,
        top: top,
        file: unique f
      )
    ),
    None() => Error(USAGE),
  }
}

fn text_member(fields: Map[String, json.Value], key: String) -> Option[String] {
  match map.get(fields, key) {
    Some(Text(s)) => Some(unique s),
    Some(Number(n)) => Some(unique n),
    Some(Bool(b)) => Some(
      if b {
        "true"
      } else {
        "false"
      }
    ),
    _ => None(),
  }
}

// A line starting with `{` is a JSON object with `level` and `msg` (or `message`)
// members; any other line is `LEVEL message...`.
fn parse_line(number: u64, line: String) -> Result[Option[Entry], String] {
  let trimmed = string.trim(line)
  if string.byte_len(trimmed) == 0 {
    return Ok(None())
  }
  if string.starts_with(trimmed, "{") {
    let fields = match json.parse(unique trimmed) {
      Ok(Object(fields)) => copy fields,
      _ => return Error(f"line {number}: invalid JSON object"),
    }
    let level = match text_member(fields, "level") {
      Some(l) => string.ascii_upper(l),
      None() => "UNKNOWN",
    }
    let message = option.unwrap_or_else(
      text_member(fields, "msg"),
      fn() -> String {
        option.unwrap_or(text_member(fields, "message"), "")
      }
    )
    return Ok(Some(Entry(level: level, message: take message, fields: take fields)))
  }
  let words = string.split_ascii_whitespace(unique trimmed)
  let level = string.ascii_upper(words[0])
  let rest = match string.split_once(trimmed, " ") {
    Some((_, after)) => unique string.trim(after),
    None() => "",
  }
  Ok(Some(Entry(level: level, message: take rest, fields: map.empty())))
}

fn keep(query: Query, entry: Entry) -> bool {
  if let Some(l) = query.level {
    if entry.level != l {
      return false
    }
  }
  if let Some(p) = query.pattern {
    if string.find(entry.message, p) == None() {
      return false
    }
  }
  match query.field {
    Some((key, wanted)) => match text_member(entry.fields, key) {
      Some(v) => v == wanted,
      None() => false,
    },
    None() => true,
  }
}

fn bump(mut counts: Map[String, u64], take key: String) {
  let n = option.unwrap_or(map.get(counts, key), 0u64)
  map.insert(mut counts, take key, n + 1)
}

@noalloc
fn by_count(a: Ranked, b: Ranked) -> i32 uses {} {
  if a.count > b.count {
    return -1
  }
  if a.count < b.count {
    return 1
  }
  string.compare(a.message, b.message)
}

fn report(query: Query, levels: Map[String, u64], messages: Map[String, u64]) -> String {
  let mut names: List[String] = []
  for (name, _) in levels {
    list.push(mut names, unique name)
  }
  let mut sorted_names = unique take names
  list.sort(mut sorted_names, string.compare)
  let mut out: List[u8] = []
  let mut total = 0u64
  for (_, n) in levels {
    total += n
  }
  text.append(mut out, f"matched {total}\n")
  for name in sorted_names {
    let n = option.unwrap_or(map.get(levels, name), 0u64)
    text.append(mut out, f"{name} {n}\n")
  }
  let mut ranked: List[Ranked] = []
  for (message, n) in messages {
    list.push(mut ranked, Ranked(message: unique message, count: n))
  }
  let mut sorted = unique take ranked
  list.sort(mut sorted, by_count)
  text.append(mut out, "top messages:\n")
  let mut shown = 0u64
  for r in sorted {
    if shown == query.top {
      break
    }
    shown += 1
    text.append(mut out, f"  {r.count} {r.message}\n")
  }
  match text.finish(take out) {
    Ok(s) => take s,
    Error(_) => "",
  }
}

fn read_line(
  d: Dir,
  mut f: File of d,
  mut reader: bufio.Reader,
  file: String,
  number: u64
) -> Result[Option[String], String] {
  match bufio.file_read_line(d, mut f, mut reader, MAX_LINE) {
    Ok(line) => Ok(take line),
    Error(Limit()) => Error(f"line {number + 1}: too long"),
    Error(InvalidUtf8()) => Error(f"line {number + 1}: invalid UTF-8"),
    Error(_) => Error(f"cannot read {file}"),
  }
}

fn run(rt: Io, args: Args) -> Result[String, String] {
  let query = parse_args(args)?
  let Ok(dir) = io.dir(rt, path.of("")) else {
    return Error("no file access granted")
  }
  let mut f = match file.open(dir, path.of(query.file)) {
    Ok(f) => take f,
    Error(NotFound()) => return Error(f"no such file: {query.file}"),
    Error(_) => return Error(f"cannot open {query.file}"),
  }
  let mut reader = bufio.new(4096)
  let mut levels: Map[String, u64] = map.empty()
  let mut messages: Map[String, u64] = map.empty()
  let mut number = 0u64
  while let Some(line) = read_line(dir, mut f, mut reader, query.file, number)? {
    number += 1
    let Some(entry) = parse_line(number, line)? else {
      continue
    }
    if keep(query, entry) {
      bump(mut levels, copy entry.level)
      bump(mut messages, copy entry.message)
    }
  }
  Ok(report(query, levels, messages))
}

pub fn main(rt: Io, args: Args) -> Result[(), String] {
  match run(rt, args) {
    Ok(text) => {
      let Ok(output) = io.stdout(rt) else {
        return Error("no stdout")
      }
      match out.print(output, text) {
        Ok(()) => Ok(()),
        Error(_) => Error("cannot write output"),
      }
    },
    Error(message) => Error(take message),
  }
}

@test
fn parses_json_fallbacks_and_blank_lines(t: Test) {
  let Ok(Some(entry)) = parse_line(3, r#"{"level":"warn","message":"retry","ok":true}"#) else {
    test.fail(t)
    return ()
  }
  test.check(t, entry.level == "WARN" && entry.message == "retry")
  test.check(t, text_member(entry.fields, "ok") == Some("true"))
  test.check(t, parse_line(4, " \t") == Ok(None()))
  test.check(t, parse_line(5, "{") == Error("line 5: invalid JSON object"))
}

@test
fn combines_filters_and_ranks_ties_by_message(t: Test) {
  let query = Query(
    level: Some("INFO"),
    pattern: Some("ready"),
    field: None(),
    top: 2,
    file: ""
  )
  let entry = Entry(level: "INFO", message: "ready now", fields: map.empty())
  test.check(t, keep(query, entry))
  let other = Entry(level: "WARN", message: "ready now", fields: map.empty())
  test.check(t, !keep(query, other))
  let mut ranked: unique List[Ranked] = [
    Ranked(message: "z", count: 1),
    Ranked(message: "a", count: 1)
  ]
  list.sort(mut ranked, by_count)
  test.check(t, ranked[0].message == "a")
}
