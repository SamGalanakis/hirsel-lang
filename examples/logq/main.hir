// Query a JSON-lines or plain log: filter by level, message substring and JSON field,
// then print counts per level and the most frequent messages.
//
// usage: logq [--level LEVEL] [--match TEXT] [--field KEY=VALUE] [--top N] FILE
pub type Query {
  level: Option[String],
  pattern: Option[String],
  field: Option[(String, String)],
  top: u64,
  file: String,
}

pub type Entry {
  level: String,
  message: String,
  fields: Map[String, box json.Value],
}

pub type Ranked {
  message: String,
  count: u64,
}

const USAGE: String = "usage: logq [--level LEVEL] [--match TEXT] [--field KEY=VALUE] [--top N] FILE"

const MAX_LINE: u64 = 65536

fn flag_value(args: Args, i: u64, flag: String) -> Result[String, String] {
  if i >= arg.count(args) {
    return Error(string.concat(flag, " needs a value"))
  }
  match arg.text(args, i) {
    Ok(text) => Ok(take text),
    Error(_) => Error(string.concat(flag, " value must be UTF-8")),
  }
}

fn parse_args(args: Args) -> Result[Query, String] {
  let mut level: Option[String] = None()
  let mut pattern: Option[String] = None()
  let mut field: Option[(String, String)] = None()
  let mut top = 5u64
  let mut file: Option[String] = None()
  let mut i = 0u64
  while i < arg.count(args) {
    let text = match arg.text(args, i) {
      Ok(t) => take t,
      Error(_) => return Error("arguments must be UTF-8"),
    }
    i += 1
    if text == "--level" {
      level = Some(string.ascii_upper(flag_value(args, i, text)?))
      i += 1
    } else if text == "--match" {
      pattern = Some(flag_value(args, i, text)?)
      i += 1
    } else if text == "--field" {
      let value = flag_value(args, i, text)?
      field = match string.split_once(value, "=") {
        Some((key, wanted)) => Some((unique key, unique wanted)),
        None() => return Error("--field needs KEY=VALUE"),
      }
      i += 1
    } else if text == "--top" {
      top = match u64.parse(flag_value(args, i, text)?) {
        Ok(n) => n,
        Error(_) => return Error("--top needs a number"),
      }
      i += 1
    } else if string.starts_with(text, "--") {
      return Error(string.concat("unknown flag ", text))
    } else {
      match file {
        Some(_) => return Error(USAGE),
        None() => {
          file = Some(take text)
        },
      }
    }
  }
  match file {
    Some(f) => Ok(
      Query(
        level: take level,
        pattern: take pattern,
        field: take field,
        top: top,
        file: unique f
      )
    ),
    None() => Error(USAGE),
  }
}

fn text_member(fields: Map[String, box json.Value], key: String) -> Option[String] {
  match map.get(fields, key) {
    Some(Text(s)) => Some(unique s),
    Some(Number(n)) => Some(unique n),
    Some(Bool(b)) => Some(
      if b {
        "true"
      } else {
        "false"
      }
    ),
    _ => None(),
  }
}

// A line starting with `{` is a JSON object with `level` and `msg` (or `message`)
// members; any other line is `LEVEL message...`.
fn parse_line(number: u64, line: String) -> Result[Option[Entry], String] {
  let trimmed = string.trim(line)
  if string.byte_len(trimmed) == 0 {
    return Ok(None())
  }
  if string.starts_with(trimmed, "{") {
    let fields = match json.parse(unique trimmed) {
      Ok(Object(fields)) => copy fields,
      _ => return Error(
        string.concat(
          "line ",
          string.concat(u64.to_string(number), ": invalid JSON object")
        )
      ),
    }
    let level = match text_member(fields, "level") {
      Some(l) => string.ascii_upper(l),
      None() => "UNKNOWN",
    }
    let message = match text_member(fields, "msg") {
      Some(m) => take m,
      None() => match text_member(fields, "message") {
        Some(m) => take m,
        None() => "",
      },
    }
    return Ok(Some(Entry(level: level, message: take message, fields: take fields)))
  }
  let words = string.split_ascii_whitespace(unique trimmed)
  let level = string.ascii_upper(words[0])
  let rest = match string.split_once(trimmed, " ") {
    Some((_, after)) => unique string.trim(after),
    None() => "",
  }
  Ok(Some(Entry(level: level, message: take rest, fields: map.empty())))
}

fn keep(query: Query, entry: Entry) -> bool {
  match query.level {
    Some(l) => if entry.level != l {
      return false
    },
    None() => (),
  }
  match query.pattern {
    Some(p) => match string.find(entry.message, p) {
      Some(_) => (),
      None() => return false,
    },
    None() => (),
  }
  match query.field {
    Some((key, wanted)) => match text_member(entry.fields, key) {
      Some(v) => v == wanted,
      None() => false,
    },
    None() => true,
  }
}

fn bump(mut counts: Map[String, u64], key: String) {
  let n = match map.get(counts, key) {
    Some(n) => n,
    None() => 0u64,
  }
  map.insert(mut counts, key, n + 1)
}

@noalloc
fn by_count(a: Ranked, b: Ranked) -> i32 uses {} {
  if a.count > b.count {
    return -1
  }
  if a.count < b.count {
    return 1
  }
  string.compare(a.message, b.message)
}

fn report(query: Query, levels: Map[String, u64], messages: Map[String, u64]) -> String {
  let mut names: List[String] = []
  for (name, _) in levels {
    list.push(mut names, unique name)
  }
  let mut sorted_names = unique take names
  list.sort(mut sorted_names, string.compare)
  let mut out: List[u8] = []
  let mut total = 0u64
  for (_, n) in levels {
    total += n
  }
  text.append(mut out, "matched ")
  u64.format_into(total, mut out)
  text.append(mut out, "\n")
  for name in sorted_names {
    text.append(mut out, name)
    text.append(mut out, " ")
    match map.get(levels, name) {
      Some(n) => u64.format_into(n, mut out),
      None() => (),
    }
    text.append(mut out, "\n")
  }
  let mut ranked: List[Ranked] = []
  for (message, n) in messages {
    list.push(mut ranked, Ranked(message: unique message, count: n))
  }
  let mut sorted = unique take ranked
  list.sort(mut sorted, by_count)
  text.append(mut out, "top messages:\n")
  let mut shown = 0u64
  for r in sorted {
    if shown == query.top {
      break
    }
    shown += 1
    text.append(mut out, "  ")
    u64.format_into(r.count, mut out)
    text.append(mut out, " ")
    text.append(mut out, r.message)
    text.append(mut out, "\n")
  }
  match text.finish(take out) {
    Ok(s) => take s,
    Error(_) => "",
  }
}

fn run(rt: Io, args: Args) -> Result[String, String] {
  let query = parse_args(args)?
  let dir = match io.dir(rt, path.of("")) {
    Ok(d) => d,
    Error(_) => return Error("no file access granted"),
  }
  let mut f = match file.open(dir, path.of(query.file)) {
    Ok(f) => take f,
    Error(NotFound()) => return Error(string.concat("no such file: ", query.file)),
    Error(_) => return Error(string.concat("cannot open ", query.file)),
  }
  let mut reader = bufio.new(4096)
  let mut levels: Map[String, u64] = map.empty()
  let mut messages: Map[String, u64] = map.empty()
  let mut number = 0u64
  while true {
    let line = match bufio.file_read_line(dir, mut f, mut reader, MAX_LINE) {
      Ok(l) => take l,
      Error(Limit()) => return Error(
        string.concat("line ", string.concat(u64.to_string(number + 1), ": too long"))
      ),
      Error(InvalidUtf8()) => return Error(
        string.concat(
          "line ",
          string.concat(u64.to_string(number + 1), ": invalid UTF-8")
        )
      ),
      Error(_) => return Error(string.concat("cannot read ", query.file)),
    }
    if string.byte_len(line) == 0 {
      break
    }
    number += 1
    let entry = match parse_line(number, line)? {
      Some(e) => take e,
      None() => continue,
    }
    if keep(query, entry) {
      bump(mut levels, entry.level)
      bump(mut messages, entry.message)
    }
  }
  Ok(report(query, levels, messages))
}

pub fn main(rt: Io, args: Args) -> Result[(), String] {
  match run(rt, args) {
    Ok(text) => {
      let output = match io.stdout(rt) {
        Ok(o) => o,
        Error(_) => return Error("no stdout"),
      }
      match out.print(output, text) {
        Ok(()) => Ok(()),
        Error(_) => Error("cannot write output"),
      }
    },
    Error(message) => Error(take message),
  }
}
