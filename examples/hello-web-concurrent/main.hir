pub type ServerError = Grant(GrantError) | Network(NetError) | Http(http.HttpError)

fn grant_error(e: GrantError) -> ServerError uses {} {
  Grant(e)
}

fn network_error(e: NetError) -> ServerError uses {} {
  Network(e)
}

fn http_error(e: http.HttpError) -> ServerError uses {} {
  Http(e)
}

fn serve(n: Net, take incoming_stream: Stream of n) -> Result[(), ServerError] {
  let mut stream = take incoming_stream
  let mut config = http.default_config()
  config.max_head_bytes = 16384
  config.max_body_bytes = 1048576
  let mut connection = http.server_connection(n, take stream, config)
  let mut serving = true
  while serving {
    match http.receive_request(mut connection) {
      Ok(incoming) => http.respond(
        mut connection,
        200u16,
        [http.Header(name: "Content-Type", value: "text/plain")],
        b"Hello, world",
        false
      ) ? http_error,
      Error(Closed()) => {
        serving = false
      },
      Error(_) => {
        http.respond(mut connection, 400u16, [], b"Bad Request", true) ? http_error
        serving = false
      },
    }
  }
  Ok(())
}

pub fn main(rt: Io, args: Args) -> Result[(), ServerError] {
  let n = io.net(rt) ? grant_error
  let listener = net.listen(
    n,
    SocketAddr(ip: V4([127u8, 0u8, 0u8, 1u8]), port: 8080u16)
  ) ? network_error
  task.scope(
    io.tasks(rt) ? grant_error,
    fn(s: Scope) -> Result[(), ServerError] {
      let mut accepting = take listener
      while true {
        let (stream, _) = net.accept(n, mut accepting) ? network_error
        let child = task.async(
          s,
          fn() -> Result[(), ServerError] {
            serve(n, take stream)
          }
        )
        task.detach(s, take child)
      }
      Ok(())
    }
  )?
  Ok(())
}
