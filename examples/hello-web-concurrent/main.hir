pub type ServerError = Grant(GrantError) | Network(NetError) | Http(http.HttpError)

fn serve(tasks: Tasks, n: Net, clock: MonotonicClock, take incoming_stream: Stream of n) -> Result[
  (),
  ServerError
] {
  let mut stream = take incoming_stream
  let mut config = http.default_config()
  config.max_head_bytes = 16384
  config.max_body_bytes = 1048576
  config.read_timeout = Some(duration.from_parts(30, 0))
  let mut connection = http.server_connection(tasks, n, take stream, config)
  while true {
    let (owned, _) = match http.next_stream(mut connection, Some(clock)) {
      Ok(Some(exchange)) => take exchange,
      Ok(None()) | Error(_) => break,
    }
    let mut responding = take owned
    http.respond(
      mut responding,
      200u16,
      [http.Header(name: "Content-Type", value: "text/plain")],
      b"Hello, world",
      false
    ) ?
  }
  Ok(())
}

pub fn main(rt: Io, args: Args) -> Result[(), ServerError] {
  let tasks = io.tasks(rt) ?
  let n = io.net(rt) ?
  let clock = io.monotonic_clock(rt) ?
  let listener = net.listen(
    n,
    SocketAddr(ip: V4([127u8, 0u8, 0u8, 1u8]), port: 8080u16)
  ) ?
  task.scope(
    io.tasks(rt) ?,
    fn(s: Scope) -> Result[(), ServerError] {
      let mut accepting = take listener
      // Accept connections until stopped.
      while true {
        let (stream, _) = net.accept(n, mut accepting) ?
        let child = task.async(
          s,
          fn() -> Result[(), ServerError] {
            serve(tasks, n, clock, take stream)
          }
        )
        task.detach(s, take child)
      }
      Ok(())
    }
  )?
  Ok(())
}
