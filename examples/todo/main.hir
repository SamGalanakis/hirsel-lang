// Commands: init, add TEXT, done NUMBER (1-based), list. State is newline-separated UTF-8.
pub fn main(rt: Io, args: Args) -> Result[(), common.Error] {
  let commands = common.input(
    rt,
    args,
    "init\nadd feed sheep\nadd mend gate\ndone 1\nlist\n"
  )?
  let state = match arg.path(args, 1) {
    Ok(p) => p,
    Error(_) => path.of("todo.txt"),
  }
  let dir = io.dir(rt, path.of("")) ? Files
  let mut tasks: List[String] = []
  if !string.starts_with(commands, "init\n") && commands != "init" {
    let data = file.read_bytes(dir, state) ? Files
    let text = string.from_bytes(copy data) ? Utf8
    for line in string.split(take text, "\n") {
      if string.byte_len(line) > 0 {
        list.push(mut tasks, copy line)
      }
    }
  }
  for raw in string.split(take commands, "\n") {
    let line = string.trim(raw)
    if string.starts_with(line, "add ") {
      list.push(mut tasks, common.slice(line, 4, string.byte_len(line)))
    } else if string.starts_with(line, "done ") {
      let n = match u64.parse(common.slice(line, 5, string.byte_len(line))) {
        Ok(n) => n,
        Error(_) => return Error(Invalid()),
      }
      if n == 0 || n > list.len(tasks) {
        return Error(Invalid())
      }
      let mut remaining: List[String] = []
      for i in 0u64..list.len(tasks) {
        if i + 1 != n {
          list.push(mut remaining, copy tasks[i])
        }
      }
      tasks = take remaining
    } else if line != "init" && line != "list" && string.byte_len(line) > 0 {
      return Error(Invalid())
    }
  }
  let saved = string.join(tasks, "\n")
  let mut file = file.create_atomic(dir, state) ? Files
  file.write_all(dir, mut file, string.as_bytes(saved)) ? Files
  file.commit(dir, take file) ? Files
  let mut builder: List[u8] = []
  for i in 0u64..list.len(tasks) {
    u64.format_into(i + 1, mut builder)
    text.append(mut builder, ". ")
    text.append(mut builder, tasks[i])
    text.append(mut builder, "\n")
  }
  common.print(rt, common.finish(take builder)?)
}
