// A deliberately small line-oriented subset, escaping all raw HTML.
fn escape(take text: String) -> String {
  let amp = bytes.replace(string.as_bytes(text), b"&", b"&amp;")
  let lt = bytes.replace(amp, b"<", b"&lt;")
  let gt = bytes.replace(lt, b">", b"&gt;")
  match string.from_bytes(take gt) {
    Ok(s) => take s,
    Error(_) => "",
  }
}

pub fn main(rt: Io, args: Args) -> Result[(), common.Error] {
  let text = common.input(rt, args, r"# Flock

Sheep & <grass>
- ewe
- lamb
")?
  let mut builder: List[u8] = []
  let mut in_list: bool = false
  for raw in string.split(take text, "\n") {
    let line = string.trim(raw)
    let item = string.starts_with(line, "- ")
    if in_list && !item {
      text.append(mut builder, "</ul>\n")
      in_list = false
    }
    if string.byte_len(line) == 0 {
      continue
    }
    let mut tag: String = "p"
    let mut start: u64 = 0
    if string.starts_with(line, "# ") {
      tag = "h1"
      start = 2
    } else if string.starts_with(line, "## ") {
      tag = "h2"
      start = 3
    } else if item {
      if !in_list {
        text.append(mut builder, "<ul>\n")
        in_list = true
      }
      tag = "li"
      start = 2
    }
    text.append(mut builder, "<")
    text.append(mut builder, tag)
    text.append(mut builder, ">")
    text.append(mut builder, escape(common.slice(line, start, string.byte_len(line))))
    text.append(mut builder, "</")
    text.append(mut builder, tag)
    text.append(mut builder, ">\n")
  }
  if in_list {
    text.append(mut builder, "</ul>\n")
  }
  common.print(rt, common.finish(take builder)?)
}
