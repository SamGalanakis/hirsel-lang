// A deliberately small line-oriented subset, escaping all raw HTML.
fn escape(text: String) -> String {
  string.replace(
    string.replace(string.replace(text, "&", "&amp;"), "<", "&lt;"),
    ">",
    "&gt;"
  )
}

fn render(take text: String) -> Result[String, common.Error] {
  let mut builder: List[u8] = []
  let mut in_list: bool = false
  for raw in string.split(take text, "\n") {
    let line = string.trim(raw)
    let item = string.starts_with(line, "- ")
    if in_list && !item {
      text.append(mut builder, "</ul>\n")
      in_list = false
    }
    if string.byte_len(line) == 0 {
      continue
    }
    let mut tag: String = "p"
    let mut start: u64 = 0
    if string.starts_with(line, "# ") {
      tag = "h1"
      start = 2
    } else if string.starts_with(line, "## ") {
      tag = "h2"
      start = 3
    } else if item {
      if !in_list {
        text.append(mut builder, "<ul>\n")
        in_list = true
      }
      tag = "li"
      start = 2
    }
    let content = escape(common.slice(line, start, string.byte_len(line)))
    text.append(mut builder, f"<{tag}>{content}</{tag}>\n")
  }
  if in_list {
    text.append(mut builder, "</ul>\n")
  }
  common.finish(take builder)
}

pub fn main(rt: Io, args: Args) -> Result[(), common.Error] {
  let text = common.input(
    rt,
    args,
    r"# Flock

Sheep & <grass>
- ewe
- lamb
"
  )?
  common.print(rt, render(take text)?)
}

@test
fn escapes_html_and_closes_lists(t: Test) {
  test.check(
    t,
    render("- <&>\nplain") == Ok("<ul>\n<li>&lt;&amp;&gt;</li>\n</ul>\n<p>plain</p>\n")
  )
  test.check(
    t,
    render("## title\n- last") == Ok("<h2>title</h2>\n<ul>\n<li>last</li>\n</ul>\n")
  )
}
