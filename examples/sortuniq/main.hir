@noalloc
fn compare(a: String, b: String) -> i32 uses {} {
  let aa = string.as_bytes(a)
  let bb = string.as_bytes(b)
  let mut i: u64 = 0
  while i < bytes.len(aa) && i < bytes.len(bb) {
    if aa[i] < bb[i] {
      return -1
    }
    if aa[i] > bb[i] {
      return 1
    }
    i += 1
  }
  if bytes.len(aa) < bytes.len(bb) {
    -1
  } else if bytes.len(aa) > bytes.len(bb) {
    1
  } else {
    0
  }
}

pub fn main(rt: Io, args: Args) -> Result[(), common.Error] {
  let text = common.input(rt, args, "pear\napple\npear\nbanana\napple")?
  // Eliminate duplicate comparisons before sorting large repeated inputs.
  let mut seen: Set[String] = set.empty()
  let mut lines: List[String] = []
  for line in std@1/string.split(take text, "\n") {
    if !set.contains(seen, line) {
      set.insert(mut seen, copy line)
      list.push(mut lines, copy line)
    }
  }
  let mut ordered = unique take lines
  std@1/list.sort(mut ordered, compare)
  common.print(rt, std@1/string.concat(std@1/string.join(ordered, "\n"), "\n"))
}
