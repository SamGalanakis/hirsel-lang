fn sorted_lines(take text: String) -> String {
  // Eliminate duplicate comparisons before sorting large repeated inputs.
  let mut seen: Set[String] = set.empty()
  let mut lines: List[String] = []
  for line in string.split(take text, "\n") {
    if !set.contains(seen, line) {
      set.insert(mut seen, copy line)
      list.push(mut lines, copy line)
    }
  }
  let mut ordered = unique take lines
  list.sort(mut ordered, string.compare)
  f"{string.join(ordered, "\n")}\n"
}

pub fn main(rt: Io, args: Args) -> Result[(), common.Error] {
  let text = common.input(rt, args, "pear\napple\npear\nbanana\napple")?
  common.print(rt, sorted_lines(take text))
}

@test
fn retains_empty_fields_and_sorts_utf8(t: Test) {
  test.check(t, sorted_lines("é\na\né\n") == "\na\né\n")
  test.check(t, sorted_lines("") == "\n")
}
