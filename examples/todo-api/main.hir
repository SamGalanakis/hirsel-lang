// A JSON todo API. Each connection is served by its own task; the todo list lives in a
// Mutex, and one writer task saves every change atomically to data/todos.json.
pub type Todo {
  id: u64,
  title: String,
  done: bool,
}

pub type Store {
  next_id: u64,
  version: u64,
  todos: List[Todo],
}

// A snapshot of the store after a change, and where to report whether it was saved.
pub type SaveJob {
  version: u64,
  text: unique String,
  reply: Sender[bool],
}

// What a request does to the store, decided before taking the lock.
pub type Action = Index | Create(String) | Show(u64) | Update(u64, bool) | Remove(u64)

pub type Reply {
  status: u16,
  body: String,
  allow: String,
  save: Option[(u64, String)],
}

pub type ServerError = Grant(GrantError) | Network(NetError) | Files(FileError) | Corrupt(
  String
) | Usage(String)

const STATE: String = "todos.json"

// ---- JSON ----
fn text_value(s: String) -> json.Value uses {} {
  Text(unique s)
}

// A todo's JSON object and its decoding are generated from Todo's shape (CT-5).
fn todo_value(t: Todo) -> json.Value uses {} = comptime derive.json_value(shape(Todo))

fn todo_from(value: json.Value) -> Result[Todo, String] uses {} = comptime derive.from_json(
  shape(Todo)
)

fn todo_json(t: Todo) -> String uses {} {
  match json.stringify(todo_value(t)) {
    Ok(s) => take s,
    Error(_) => "{}",
  }
}

fn list_value(todos: List[Todo]) -> json.Value uses {} {
  let mut items: List[json.Value] = []
  for t in todos {
    list.push(mut items, todo_value(t))
  }
  Array(take items)
}

fn store_json(st: Store) -> String uses {} {
  let mut fields: Map[String, json.Value] = map.empty()
  map.insert(mut fields, "next_id", Number(u64.to_string(st.next_id)))
  map.insert(mut fields, "todos", list_value(st.todos))
  match json.stringify(Object(take fields)) {
    Ok(s) => take s,
    Error(_) => "{}",
  }
}

fn error_json(message: String) -> String uses {} {
  let mut fields: Map[String, json.Value] = map.empty()
  map.insert(mut fields, "error", text_value(message))
  match json.stringify(Object(take fields)) {
    Ok(s) => take s,
    Error(_) => "{}",
  }
}

fn text_field(fields: Map[String, json.Value], key: String) -> Option[String] uses {} {
  match map.get(fields, key) {
    Some(Text(s)) => Some(unique s),
    _ => None(),
  }
}

fn bool_field(fields: Map[String, json.Value], key: String) -> Option[bool] uses {} {
  match map.get(fields, key) {
    Some(Bool(b)) => Some(b),
    _ => None(),
  }
}

fn u64_field(fields: Map[String, json.Value], key: String) -> Option[u64] uses {} {
  match map.get(fields, key) {
    Some(Number(n)) => results.ok(u64.parse(n)),
    _ => None(),
  }
}

fn parse_object(body: Bytes) -> Option[Map[String, json.Value]] uses {} {
  let Ok(text) = string.from_bytes(unique body) else {
    return None()
  }
  match json.parse(take text) {
    Ok(Object(fields)) => Some(copy fields),
    _ => None(),
  }
}

fn parse_store(take text: String) -> Result[Store, ServerError] uses {} {
  let Ok(Object(fields)) = json.parse(take text) else {
    return Error(Corrupt("state is not a JSON object"))
  }
  let Some(next_id) = u64_field(fields, "next_id") else {
    return Error(Corrupt("next_id"))
  }
  let Some(Array(items)) = map.get(fields, "todos") else {
    return Error(Corrupt("todos"))
  }
  let mut todos: List[Todo] = []
  for item in items {
    match todo_from(item) {
      Ok(decoded) => list.push(mut todos, take decoded),
      Error(message) => return Error(Corrupt(take message)),
    }
  }
  Ok(Store(next_id: next_id, version: 0, todos: take todos))
}

// ---- persistence ----
fn load(dir: Dir) -> Result[Store, ServerError] {
  match file.read_bytes(dir, path.of(STATE)) {
    Ok(data) => {
      let Ok(text) = string.from_bytes(copy data) else {
        return Error(Corrupt("state is not UTF-8"))
      }
      parse_store(take text)
    },
    Error(NotFound()) => Ok(Store(next_id: 1, version: 0, todos: [])),
    Error(e) => Error(Files(e)),
  }
}

fn save(dir: Dir, text: String) -> Result[(), FileError] {
  let mut f = file.create_atomic(dir, path.of(STATE))?
  file.write_all(dir, mut f, string.as_bytes(text))?
  file.commit(dir, take f)
}

// Saves arrive in lock order up to channel interleaving; a later version already
// written makes an earlier one redundant, so the file only moves forward.
fn write_loop(tasks: Tasks, dir: Dir, take receiver: Receiver[SaveJob]) -> () {
  let mut jobs = take receiver
  let mut written: u64 = 0
  while let Ok(SaveJob(version: version, text: text, reply: reply_to)) = channel.receive(
    tasks,
    mut jobs
  ) {
    let mut ok = true
    if version > written {
      ok = results.is_ok(save(dir, text))
      if ok {
        written = version
      }
    }
    let mut reply = take reply_to
    let _ = channel.send(tasks, mut reply, ok)
  }
}

// ---- routing ----
fn not_found() -> Reply uses {} {
  Reply(status: 404u16, body: error_json("not found"), allow: "", save: None())
}

fn bad_request(message: String) -> Reply uses {} {
  Reply(status: 400u16, body: error_json(message), allow: "", save: None())
}

fn method_not_allowed(allow: String) -> Reply uses {} {
  Reply(
    status: 405u16,
    body: error_json("method not allowed"),
    allow: unique allow,
    save: None()
  )
}

fn unsupported_media() -> Reply uses {} {
  Reply(
    status: 415u16,
    body: error_json("Content-Type must be application/json"),
    allow: "",
    save: None()
  )
}

fn find(todos: List[Todo], id: u64) -> Option[u64] uses {} {
  for i in 0u64..list.len(todos) {
    if todos[i].id == id {
      return Some(i)
    }
  }
  None()
}

// The caller has already bumped the version; the snapshot goes to the writer task.
fn snapshot_reply(st: Store, status: u16, take body: unique String) -> Reply uses {} {
  Reply(
    status: status,
    body: take body,
    allow: "",
    save: Some((st.version, store_json(st)))
  )
}

fn apply(mut st: unique Store, action: Action) -> unique Reply uses {} {
  match action {
    Index() => Reply(
      status: 200u16,
      body: match json.stringify(list_value(st.todos)) {
        Ok(s) => take s,
        Error(_) => "[]",
      },
      allow: "",
      save: None()
    ),
    Create(title) => {
      let item = Todo(id: st.next_id, title: unique title, done: false)
      st.next_id += 1
      let body = todo_json(item)
      list.push(mut st.todos, take item)
      st.version += 1
      snapshot_reply(st, 201u16, take body)
    },
    Show(id) => match find(st.todos, id) {
      Some(i) => Reply(
        status: 200u16,
        body: todo_json(st.todos[i]),
        allow: "",
        save: None()
      ),
      None() => not_found(),
    },
    Update(id, done) => match find(st.todos, id) {
      Some(i) => {
        st.todos[i].done = done
        let body = todo_json(st.todos[i])
        st.version += 1
        snapshot_reply(st, 200u16, take body)
      },
      None() => not_found(),
    },
    Remove(id) => match find(st.todos, id) {
      Some(i) => {
        let _ = list.remove(mut st.todos, i)
        st.version += 1
        snapshot_reply(st, 204u16, "")
      },
      None() => not_found(),
    },
  }
}

// `application/json`, in any case and with or without parameters such as a charset.
fn json_content(request: http.ServerRequest) -> bool uses {} {
  let value = match http.header(request.headers, "content-type") {
    Some(v) => string.ascii_lower(v),
    None() => return false,
  }
  let media = match string.split_once(value, ";") {
    Some((media, _)) => media,
    None() => value,
  }
  string.trim(media) == "application/json"
}

// Decide the action from method, path and body; an error is the reply to send.
fn route(request: http.ServerRequest) -> Result[Action, Reply] uses {} {
  let target = match string.split_once(request.target, "?") {
    Some((target_path, _)) => target_path,
    None() => request.target,
  }
  let parts = string.split(unique target, "/")
  if list.len(parts) < 2 || parts[0] != "" || parts[1] != "todos" || list.len(parts) > 3 {
    return Error(not_found())
  }
  if list.len(parts) == 2 {
    if request.method == "GET" {
      return Ok(Index())
    }
    if request.method != "POST" {
      return Error(method_not_allowed("GET, POST"))
    }
    if !json_content(request) {
      return Error(unsupported_media())
    }
    let fields = match parse_object(request.body) {
      Some(f) => copy f,
      None() => return Error(bad_request("body must be a JSON object")),
    }
    return match text_field(fields, "title") {
      Some(title) => if string.byte_len(title) == 0 {
        Error(bad_request("title must not be empty"))
      } else {
        Ok(Create(copy title))
      },
      None() => Error(bad_request("title must be a string")),
    }
  }
  let id = match u64.parse(parts[2]) {
    Ok(n) => n,
    Error(_) => return Error(not_found()),
  }
  if request.method == "GET" {
    return Ok(Show(id))
  }
  if request.method == "DELETE" {
    return Ok(Remove(id))
  }
  if request.method != "PATCH" {
    return Error(method_not_allowed("GET, PATCH, DELETE"))
  }
  if !json_content(request) {
    return Error(unsupported_media())
  }
  let fields = match parse_object(request.body) {
    Some(f) => copy f,
    None() => return Error(bad_request("body must be a JSON object")),
  }
  match bool_field(fields, "done") {
    Some(done) => Ok(Update(id, done)),
    None() => Error(bad_request("done must be a boolean")),
  }
}

// ---- connections ----
fn send_reply(mut connection: http.ServerStream, reply: Reply) -> Result[
  (),
  http.HttpError
] {
  let mut headers: List[http.Header] = []
  if string.byte_len(reply.body) > 0 {
    list.push(mut headers, http.Header(name: "Content-Type", value: "application/json"))
  }
  if string.byte_len(reply.allow) > 0 {
    list.push(mut headers, http.Header(name: "Allow", value: unique reply.allow))
  }
  http.respond(mut connection, reply.status, headers, string.as_bytes(reply.body), true)
}

fn handle(
  tasks: Tasks,
  state: Mutex[Store],
  mut saves: Sender[SaveJob],
  request: http.ServerRequest
) -> Reply {
  let action = match route(request) {
    Ok(a) => take a,
    Error(reply) => return take reply,
  }
  let mut reply = mutex.with(
    tasks,
    state,
    fn(mut store: unique Store) -> unique Reply uses {} {
      apply(mut store, action)
    }
  )
  let Some((version, snapshot)) = option.remove(mut reply.save) else {
    return take reply
  }
  let (done_tx, done_rx): (Sender[bool], Receiver[bool]) = channel.open(tasks)
  let mut done = take done_rx
  let saved = match channel.send(
    tasks,
    mut saves,
    SaveJob(version: version, text: take snapshot, reply: take done_tx)
  ) {
    Ok(()) => match channel.receive(tasks, mut done) {
      Ok(ok) => ok,
      Error(_) => false,
    },
    Error(_) => false,
  }
  if saved {
    take reply
  } else {
    Reply(status: 500u16, body: error_json("could not save"), allow: "", save: None())
  }
}

fn serve(
  n: Net,
  tasks: Tasks,
  state: Mutex[Store],
  take saves: Sender[SaveJob],
  take incoming: Stream of n
) -> () {
  let mut stream = take incoming
  let mut jobs = take saves
  let mut config = http.default_config()
  config.max_head_bytes = 16384
  config.max_body_bytes = 65536
  let mut connection = http.server_connection(tasks, n, take stream, config)
  let Ok(Some((owned, request))) = http.next_stream(mut connection, None()) else {
    return ()
  }
  let mut responding = take owned
  let reply = handle(tasks, state, mut jobs, request)
  let _ = send_reply(mut responding, reply)
}

fn port_arg(args: Args) -> Result[u16, ServerError] {
  if arg.len(args) == 0 {
    return Ok(8080u16)
  }
  let text = match arg.text(args, 0) {
    Ok(t) => take t,
    Error(_) => return Error(Usage("port must be UTF-8")),
  }
  match u16.parse(text) {
    Ok(p) => Ok(p),
    Error(_) => Error(Usage("port must be a number from 0 to 65535")),
  }
}

// Arguments: [port], default 8080; port 0 picks a free port. Prints the bound address.
pub fn main(rt: Io, args: Args) -> Result[(), ServerError] {
  let port = port_arg(args)?
  let n = io.net(rt)?
  let tasks = io.tasks(rt)?
  let dir = io.dir(rt, path.of("data"))?
  let store = load(dir)?
  let state: Mutex[Store] = mutex.create(tasks, take store)
  let (saves, jobs): (Sender[SaveJob], Receiver[SaveJob]) = channel.open(tasks)
  let listener = net.listen(n, SocketAddr(ip: V4([127u8, 0u8, 0u8, 1u8]), port: port))?
  let bound = net.local_addr(n, listener)?
  let output = io.stdout(rt)?
  let _ = out.print(output, f"listening on 127.0.0.1:{bound.port}\n")
  task.scope(
    tasks,
    fn(s: Scope) -> Result[(), ServerError] {
      let writer = task.async(
        s,
        fn() -> () {
          write_loop(tasks, dir, take jobs)
        }
      )
      task.detach(s, take writer)
      let mut accepting = take listener
      while true {
        let (stream, _) = net.accept(n, mut accepting)?
        let jobs_tx = sender.dup(tasks, saves)
        let child = task.async(
          s,
          fn() -> () {
            serve(n, tasks, state, take jobs_tx, take stream)
          }
        )
        task.detach(s, take child)
      }
      Ok(())
    }
  )
}

@test
fn ids_are_not_reused_after_removal(t: Test) {
  let mut st: unique Store = Store(next_id: 1, version: 0, todos: [])
  test.check(t, apply(mut st, Create("first")).status == 201u16)
  test.check(t, apply(mut st, Update(1, true)).status == 200u16)
  test.check(t, st.todos[0].done)
  test.check(t, apply(mut st, Remove(1)).status == 204u16)
  test.check(t, apply(mut st, Create("second")).status == 201u16)
  test.check(t, st.todos[0].id == 2 && st.next_id == 3 && st.version == 4)
  test.check(t, apply(mut st, Show(1)).status == 404u16)
}

@test
fn state_round_trips_and_rejects_wrong_field_types(t: Test) {
  let original = Store(
    next_id: 4,
    version: 0,
    todos: [Todo(id: 3, title: "é", done: true)]
  )
  test.check(t, parse_store(store_json(original)) == Ok(original))
  test.check(
    t,
    results.is_error(
      parse_store(r#"{"next_id":4,"todos":[{"id":3,"title":"x","done":"yes"}]}"#)
    )
  )
  test.check(t, results.is_error(parse_store("{}")))
}
