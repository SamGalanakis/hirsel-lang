// RFC 2104 HMAC over any digest.Digest, from Go crypto/internal/fips140/hmac
// hmac.go (BSD-3-Clause): keys longer than the block are hashed first, then
// zero-padded to the block and masked with 0x36 and 0x5c.
pub opaque type State[S: plain + inert]: plain + inert uses {} {
  inner: S,
  outer: S,
}

// The key block masked with `pad`; `key` is at most one block long.
fn padded(key: Bytes, block_size: u64, pad: u8) -> Bytes uses {} {
  let mut out: List[u8] = []
  core@1/list.reserve(mut out, block_size)
  let len = core@1/bytes.len(key)
  let mut i: u64 = 0
  while i < block_size {
    if i < len {
      core@1/list.push(mut out, key[i] ^ pad)
    } else {
      core@1/list.push(mut out, pad)
    }
    i += 1
  }
  core@1/bytes.from_list(take out)
}

fn keyed[H: implementation std@1/digest.Digest](key: Bytes) -> State[H.State] uses {} {
  let mut inner = H.new()
  let mut outer = H.new()
  if core@1/bytes.len(key) > H.block {
    let mut long = H.new()
    H.update(mut long, key)
    let short = std@1/bytes.from_inline(H.finish(take long))
    H.update(mut inner, padded(short, H.block, 0x36))
    H.update(mut outer, padded(short, H.block, 0x5c))
  } else {
    H.update(mut inner, padded(key, H.block, 0x36))
    H.update(mut outer, padded(key, H.block, 0x5c))
  }
  State(inner: inner, outer: outer)
}

pub fn new[H: implementation std@1/digest.Digest](key: Bytes) -> State[H.State] uses {} {
  keyed with (H = H)(key)
}

pub fn update[H: implementation std@1/digest.Digest](
  mut state: State[H.State],
  data: Bytes
) -> () uses {} {
  H.update(mut state.inner, data)
}

pub fn finish[H: implementation std@1/digest.Digest](take state: State[H.State]) -> Inline[
  u8,
  H.bytes
] uses {} {
  let State(inner: inner, outer: outer) = take state
  let mut outer_state = outer
  let inner_digest = H.finish(take inner)
  H.update(mut outer_state, std@1/bytes.from_inline(inner_digest))
  H.finish(take outer_state)
}

pub fn mac[H: implementation std@1/digest.Digest](key: Bytes, data: Bytes) -> Inline[
  u8,
  H.bytes
] uses {} {
  let mut state = new with (H = H)(key)
  update with (H = H)(mut state, data)
  finish with (H = H)(take state)
}

// Compares the MAC of `data` with `expected` through constant_time.equal.
pub fn verify[H: implementation std@1/digest.Digest](
  key: Bytes,
  data: Bytes,
  expected: Bytes
) -> bool uses {} {
  std@1/constant_time.equal(
    std@1/bytes.from_inline(mac with (H = H)(key, data)),
    expected
  )
}
