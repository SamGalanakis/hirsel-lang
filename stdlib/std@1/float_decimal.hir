@noalloc
fn pow5bits(e: i32) -> i32 uses {} {
  // common.h:56; ((e * 1217359) >> 19) + 1 for 0 <= e <= 3528.
  let wide: i64 = core@1/int.widen(e)
  core@1/int.narrow((wide * 1217359 >> 19) + 1)
}

@noalloc
fn log10_pow2(e: i32) -> i32 uses {} {
  // common.h:71; floor(log10(2^e)) for 0 <= e <= 1650.
  let wide: i64 = core@1/int.widen(e)
  core@1/int.narrow(wide * 78913 >> 18)
}

@noalloc
fn log10_pow5(e: i32) -> i32 uses {} {
  // common.h:79; floor(log10(5^e)) for 0 <= e <= 2620.
  let wide: i64 = core@1/int.widen(e)
  core@1/int.narrow(wide * 732923 >> 20)
}

// d2s_intrinsics.h:191: the multiplicative inverse of 5 modulo 2^64 divides
// exactly while the product stays at most 2^64 / 5.
@noalloc
fn pow5_factor(value: u64) -> i32 uses {} {
  let mut rest = value
  let mut count: i32 = 0
  while true {
    let wide: u128 = core@1/int.widen(rest)
    rest = core@1/int.truncate(wide * 14757395258967641293)
    if rest > 3689348814741910323 {
      break
    }
    count += 1
  }
  count
}

@noalloc
fn multiple_of_power_of5(value: u64, p: i32) -> bool uses {} {
  pow5_factor(value) >= p
}

@noalloc
fn multiple_of_power_of2(value: u64, p: i32) -> bool uses {} {
  let bits: u64 = core@1/int.narrow(p)
  value & (1u64 << bits) - 1 == 0
}

// d2s_intrinsics.h:259 (the uint128 case): the top bits of m * (high:low) >> j.
@noalloc
fn mul_shift64(m: u64, low: u64, high: u64, j: i32) -> u64 uses {} {
  let wide: u128 = core@1/int.widen(m)
  let low_wide: u128 = core@1/int.widen(low)
  let high_wide: u128 = core@1/int.widen(high)
  let distance: u64 = core@1/int.narrow(j - 64)
  let shift: u128 = core@1/int.widen(distance)
  let product: u128 = (wide * low_wide >> 64) + wide * high_wide >> shift
  core@1/int.narrow(product)
}

// d2s.c:422 d2d_small_int, with d2s.c:478's trailing-zero removal: an integer
// in [1, 2^53) is its own shortest representation.
@noalloc
fn small_integer64(ieee_mantissa: u64, ieee_exponent: u64) -> Option[(u64, i32)] uses {} {
  let biased: i32 = core@1/int.narrow(ieee_exponent)
  let e2 = biased - 1075
  if e2 > 0 || e2 < -52 {
    return None
  }
  let m2 = 1u64 << 52 | ieee_mantissa
  let shift: u64 = core@1/int.narrow(-e2)
  if m2 & (1u64 << shift) - 1 != 0 {
    return None
  }
  let mut output = m2 >> shift
  let mut exponent: i32 = 0
  while output % 10 == 0 {
    output /= 10
    exponent += 1
  }
  Some((output, exponent))
}

