// zmij 1.0.23, 7b7cc48b, src/lib.rs:1369-1504 (MIT).
// Portable binary64 to_decimal: the shorter candidate is constructed directly.
// DECIMAL_POWERS stores independently regenerated floor-normalized 128-bit 10^q.
// For finite nonzero fields: bin_exp in [-1074,971], dec_exp in [-324,292],
// shift in [3,7], and the shifted significand fits 60 bits. Both 64x64 products
// fit u128, the middle sum fits 65 bits and the high sum fits 60 bits.
@noalloc
pub fn shortest64(ieee_mantissa: u64, ieee_exponent: u64) -> (u64, i32) uses {} {
  match small_integer64(ieee_mantissa, ieee_exponent) {
    Some(small) => return small,
    None => (),
  }
  let biased: i32 = core@1/int.narrow(ieee_exponent)
  let bin_exp: i32 = if ieee_exponent == 0 {
    1i32
  } else {
    biased
  } - 1075
  let bin_sig = if ieee_exponent == 0 {
    ieee_mantissa
  } else {
    ieee_mantissa | 4503599627370496u64
  }
  let irregular = ieee_exponent != 0 && ieee_mantissa == 0
  let dec_exp = bin_exp * 315653 - if irregular {
    131072
  } else {
    0
  } >> 20
  let shift: u64 = core@1/int.narrow(bin_exp + ((-dec_exp - 1) * 217707 >> 16) + 7)
  let index: u64 = core@1/int.narrow((-dec_exp - 1 + 293) * 2)
  let high = DECIMAL_POWERS[index]
  let low = DECIMAL_POWERS[index + 1]
  let sig: u128 = core@1/int.widen(bin_sig << shift)
  let high_wide: u128 = core@1/int.widen(high)
  let low_wide: u128 = core@1/int.widen(low)
  let product = sig * high_wide
  let product_low: u64 = core@1/int.truncate(product)
  let product_low_wide: u128 = core@1/int.widen(product_low)
  let middle = product_low_wide + (sig * low_wide >> 64)
  let upper: u64 = core@1/int.narrow((product >> 64) + (middle >> 64))
  let lower: u64 = core@1/int.truncate(middle)
  let mut integral = upper >> 6
  let fractional = upper << 58 | lower >> 6
  let mut half_ulp = high >> 7u64 - shift
  if !irregular {
    half_ulp += 1u64 - (bin_sig & 1)
  }
  let round_up = half_ulp > 18446744073709551615u64 - fractional
  let round_down = if irregular {
    half_ulp >> 1
  } else {
    half_ulp
  } > fractional
  integral += if round_up {
    1u64
  } else {
    0u64
  }
  let fraction_wide: u128 = core@1/int.widen(fractional)
  let mut digit: u64 = core@1/int.narrow(
    fraction_wide * 10 + if irregular {
      9223372036854775807u128
    } else {
      9223372036854775814u128
    } >> 64
  )
  if irregular {
    let lower_fraction = core@1/int.wrapping_sub(fractional, half_ulp >> 1)
    let lower_wide: u128 = core@1/int.widen(lower_fraction)
    let lower_digit: u64 = core@1/int.narrow(
      lower_wide * 10 + 18446744073709551615u128 >> 64
    )
    if digit < lower_digit {
      digit = lower_digit
    }
  } else if fractional == 4611686018427387904u64 {
    digit = 2
  }
  // Upstream separates the final digit for its renderer. Recombine only when
  // neither shorter candidate is in the rounding interval, then canonicalize
  // trailing zeros for Hirsel's existing (digits, scale) interface.
  let mut digits = integral
  let mut exponent = dec_exp + 1
  if !(round_up || round_down) {
    digits = integral * 10 + digit
    exponent -= 1
  }
  while digits % 10 == 0 {
    digits /= 10
    exponent += 1
  }
  (digits, exponent)
}

// f2s_intrinsics.h:67 (the 64-bit case): m * factor >> shift for shift > 32.
@noalloc
fn mul_shift32(m: u64, factor: u64, shift: i32) -> u64 uses {} {
  let bits0 = m * (factor & 4294967295)
  let bits1 = m * (factor >> 32)
  let distance: u64 = core@1/int.narrow(shift - 32)
  (bits0 >> 32) + bits1 >> distance
}

@noalloc
fn mul_pow5_inv_div_pow2(m: u64, q: i32, j: i32) -> u64 uses {} {
  let index: u64 = core@1/int.narrow(q)
  mul_shift32(m, FLOAT_POW5_INV_SPLIT[index], j)
}

@noalloc
fn mul_pow5_div_pow2(m: u64, i: i32, j: i32) -> u64 uses {} {
  let index: u64 = core@1/int.narrow(i)
  mul_shift32(m, FLOAT_POW5_SPLIT[index], j)
}

// Ryū f2d (f2s.c:50) with RYU_FLOAT_FULL_TABLE: shortest64's contract for binary32.
@noalloc
pub fn shortest32(ieee_mantissa: u64, ieee_exponent: u64) -> (u64, i32) uses {} {
  let biased: i32 = core@1/int.narrow(ieee_exponent)
  let e2: i32 = if ieee_exponent == 0 {
    1 - 127 - 23 - 2
  } else {
    biased - 127 - 23 - 2
  }
  let m2: u64 = if ieee_exponent == 0 {
    ieee_mantissa
  } else {
    1u64 << 23 | ieee_mantissa
  }
  let accept_bounds = m2 & 1 == 0
  let mv = 4 * m2
  let mp = 4 * m2 + 2
  let mm_shift: u64 = if ieee_mantissa != 0 || ieee_exponent <= 1 {
    1
  } else {
    0
  }
  let mm = 4 * m2 - 1 - mm_shift
  let mut vr: u64 = 0
  let mut vp: u64 = 0
  let mut vm: u64 = 0
  let mut e10: i32 = 0
  let mut vm_is_trailing_zeros = false
  let mut vr_is_trailing_zeros = false
  let mut last_removed_digit: u64 = 0
  if e2 >= 0 {
    let q = log10_pow2(e2)
    e10 = q
    let k = 59 + pow5bits(q) - 1
    let i = -e2 + q + k
    vr = mul_pow5_inv_div_pow2(mv, q, i)
    vp = mul_pow5_inv_div_pow2(mp, q, i)
    vm = mul_pow5_inv_div_pow2(mm, q, i)
    if q != 0 && (vp - 1) / 10 <= vm / 10 {
      // The loop below removes no digit, so compute the last removed one here.
      let l = 59 + pow5bits(q - 1) - 1
      last_removed_digit = mul_pow5_inv_div_pow2(mv, q - 1, -e2 + q - 1 + l) % 10
    }
    if q <= 9 {
      if mv % 5 == 0 {
        vr_is_trailing_zeros = multiple_of_power_of5(mv, q)
      } else if accept_bounds {
        vm_is_trailing_zeros = multiple_of_power_of5(mm, q)
      } else if multiple_of_power_of5(mp, q) {
        vp -= 1
      }
    }
  } else {
    let q = log10_pow5(-e2)
    e10 = q + e2
    let i = -e2 - q
    let k = pow5bits(i) - 61
    let j = q - k
    vr = mul_pow5_div_pow2(mv, i, j)
    vp = mul_pow5_div_pow2(mp, i, j)
    vm = mul_pow5_div_pow2(mm, i, j)
    if q != 0 && (vp - 1) / 10 <= vm / 10 {
      let shift = q - 1 - (pow5bits(i + 1) - 61)
      last_removed_digit = mul_pow5_div_pow2(mv, i + 1, shift) % 10
    }
    if q <= 1 {
      vr_is_trailing_zeros = true
      if accept_bounds {
        vm_is_trailing_zeros = mm_shift == 1
      } else {
        vp -= 1
      }
    } else if q < 31 {
      vr_is_trailing_zeros = multiple_of_power_of2(mv, q - 1)
    }
  }
  let mut removed: i32 = 0
  let mut output: u64 = 0
  if vm_is_trailing_zeros || vr_is_trailing_zeros {
    while vp / 10 > vm / 10 {
      vm_is_trailing_zeros = vm_is_trailing_zeros && vm % 10 == 0
      vr_is_trailing_zeros = vr_is_trailing_zeros && last_removed_digit == 0
      last_removed_digit = vr % 10
      vr /= 10
      vp /= 10
      vm /= 10
      removed += 1
    }
    if vm_is_trailing_zeros {
      while vm % 10 == 0 {
        vr_is_trailing_zeros = vr_is_trailing_zeros && last_removed_digit == 0
        last_removed_digit = vr % 10
        vr /= 10
        vp /= 10
        vm /= 10
        removed += 1
      }
    }
    if vr_is_trailing_zeros && last_removed_digit == 5 && vr % 2 == 0 {
      last_removed_digit = 4
    }
    output = vr + if vr == vm && (!accept_bounds || !vm_is_trailing_zeros) || last_removed_digit >= 5 {
      1
    } else {
      0
    }
  } else {
    while vp / 10 > vm / 10 {
      last_removed_digit = vr % 10
      vr /= 10
      vp /= 10
      vm /= 10
      removed += 1
    }
    output = vr + if vr == vm || last_removed_digit >= 5 {
      1
    } else {
      0
    }
  }
  (output, e10 + removed)
}

// slow.rs:27 get_shift: the largest binary shift that keeps a decimal_point of
// n moving toward zero.
@noalloc
fn get_shift(n: i32) -> u64 uses {} {
  if n < 19 {
    let index: u64 = core@1/int.narrow(n)
    core@1/int.widen(SHIFT_POWERS[index])
  } else {
    60
  }
}

// Rust dec2flt slow.rs:27 parse_long_mantissa (Lemire, arXiv:2101.11408,
// section 11): scale the exact digits by powers of two into [1/2, 1), then
// round the significand bits. The IEEE fields without the sign, infinity as the
// all-ones exponent (Rust's fp_inf).
@noalloc
fn long_mantissa(mut d: internal.decimal_seq.DecimalSeq, fraction: u64, bias: i32) -> u64 uses {} {
  let exp_min = 1 - bias
  let infinite_power = 2 * bias + 1
  let infinity: u64 = core@1/int.narrow(infinite_power)
  if d.num_digits == 0 || d.decimal_point < -324 {
    return 0
  }
  if d.decimal_point >= 310 {
    return infinity << fraction
  }
  let mut exp2: i32 = 0
  // Shift right toward (1/2 ... 1].
  while d.decimal_point > 0 {
    let shift = get_shift(copy d.decimal_point)
    internal.decimal_seq.right_shift(mut d, shift)
    if d.decimal_point < -2047 {
      return 0
    }
    let step: i32 = core@1/int.narrow(shift)
    exp2 += step
  }
  // Shift left toward (1/2 ... 1].
  while d.decimal_point <= 0 {
    if d.decimal_point == 0 && d.digits[0] >= 5 {
      break
    }
    let shift: u64 = if d.decimal_point == 0 {
      if d.digits[0] <= 1 {
        2
      } else {
        1
      }
    } else {
      get_shift(-d.decimal_point)
    }
    internal.decimal_seq.left_shift(mut d, shift)
    if d.decimal_point > 2047 {
      return infinity << fraction
    }
    let step: i32 = core@1/int.narrow(shift)
    exp2 -= step
  }
  // [1/2, 1) to the binary format's [1, 2).
  exp2 -= 1
  while exp_min > exp2 {
    let n: i32 = if exp_min - exp2 > 60 {
      60
    } else {
      exp_min - exp2
    }
    internal.decimal_seq.right_shift(mut d, core@1/int.narrow(n))
    exp2 += n
  }
  if exp2 - exp_min + 1 >= infinite_power {
    return infinity << fraction
  }
  // Shift to the hidden bit and round to the significand plus that bit.
  internal.decimal_seq.left_shift(mut d, fraction + 1)
  let mut mantissa = internal.decimal_seq.round(d)
  if mantissa >= 1u64 << fraction + 1 {
    // Rounding carried into a new bit: shift back to the hidden bit.
    internal.decimal_seq.right_shift(mut d, 1)
    exp2 += 1
    mantissa = internal.decimal_seq.round(d)
    if exp2 - exp_min + 1 >= infinite_power {
      return infinity << fraction
    }
  }
  let mut power2 = exp2 - exp_min + 1
  if mantissa < 1u64 << fraction {
    power2 -= 1
  }
  let biased: u64 = core@1/int.narrow(power2)
  biased << fraction | mantissa & (1u64 << fraction) - 1
}

// Number::toString fixed/scientific thresholds:
// https://tc39.es/ecma262/#sec-numeric-types-number-tostring
// Ryū d2s.c:314-419 (4c0618b, Apache-2.0 or BSL-1.0): count first,
// then emit significand segments at their final positions. Hirsel uses checked
// Inline indexing, fixed notation in [-6, 21), lowercase e and no positive sign.
@noalloc
pub fn render[n: size](
  significand: u64,
  scale: i32,
  negative: bool,
  mut buffer: Inline[u8, n]
) -> Result[u64, scalar.FormatError] uses {} {
  let mut count: u64 = 1
  let mut remaining = significand
  while remaining >= 10000 {
    count += 4
    remaining /= 10000
  }
  if remaining >= 1000 {
    count += 3
  } else if remaining >= 100 {
    count += 2
  } else if remaining >= 10 {
    count += 1
  }
  let count_i: i32 = core@1/int.narrow(count)
  let exponent = scale + count_i - 1
  let scientific = exponent < -6 || exponent >= 21
  let prefix: u64 = if negative {
    1
  } else {
    0
  }
  let mut length = prefix + count
  let mut exponent_digits: u64 = 1
  let absolute = if exponent < 0 {
    -exponent
  } else {
    exponent
  }
  if absolute >= 10 {
    exponent_digits = 2
  }
  if absolute >= 100 {
    exponent_digits = 3
  }
  if scientific {
    length += 1 + exponent_digits + if exponent < 0 {
      1
    } else {
      0
    } + if count > 1 {
      1
    } else {
      0
    }
  } else if exponent < 0 {
    length += core@1/int.narrow(-exponent) + 1
  } else if scale > 0 {
    length += core@1/int.narrow(scale)
  } else if scale < 0 {
    length += 1
  }
  if n < length {
    return Error(BufferTooSmall)
  }
  if negative {
    buffer[0] = 45
  }
  if scientific {
    let mut at = prefix + count
    if count > 1 {
      let leading = render_segment(significand, count - 1, at + 1, mut buffer)
      buffer[prefix] = core@1/int.narrow(leading) + 48u8
      buffer[prefix + 1] = 46
      at += 1
    } else {
      buffer[prefix] = core@1/int.narrow(significand) + 48u8
    }
    buffer[at] = 101
    at += 1
    if exponent < 0 {
      buffer[at] = 45
      at += 1
    }
    let _ = render_segment(
      core@1/int.narrow(absolute),
      exponent_digits,
      length,
      mut buffer
    )
  } else if exponent < 0 {
    buffer[prefix] = 48
    buffer[prefix + 1] = 46
    let start = length - count
    let mut at = prefix + 2
    while at < start {
      buffer[at] = 48
      at += 1
    }
    let _ = render_segment(significand, count, length, mut buffer)
  } else if scale < 0 {
    let trailing: u64 = core@1/int.narrow(-scale)
    let point = length - trailing - 1
    let leading = render_segment(significand, trailing, length, mut buffer)
    buffer[point] = 46
    let _ = render_segment(leading, count - trailing, point, mut buffer)
  } else {
    let end = prefix + count
    let _ = render_segment(significand, count, end, mut buffer)
    let mut at = end
    while at < length {
      buffer[at] = 48
      at += 1
    }
  }
  Ok(length)
}

// Write exactly count low digits ending at end, including leading zeros in
// a fractional segment; return the remaining high digits. The loop has no
// layout decisions. Unlike Ryū's pointer/table copies, use checked writes and
// quotient/remainder arithmetic without changing the shared integer writer.
@noalloc
fn render_segment[n: size](value: u64, count: u64, end: u64, mut buffer: Inline[u8, n]) -> u64 uses {} {
  let start = end - count
  let mut at = end
  let mut rest = value
  while at - start >= 2 {
    at -= 2
    let pair = rest % 100
    rest /= 100
    buffer[at] = core@1/int.narrow(pair / 10) + 48u8
    buffer[at + 1] = core@1/int.narrow(pair % 10) + 48u8
  }
  if at > start {
    buffer[start] = core@1/int.narrow(rest % 10) + 48u8
    rest /= 10
  }
  rest
}

@noalloc
pub fn special[n: size](text: String, mut buffer: Inline[u8, n]) -> Result[
  u64,
  scalar.FormatError
] uses {} {
  let data = core@1/string.as_bytes(text)
  let length = core@1/bytes.len(data)
  if n < length {
    return Error(BufferTooSmall)
  }
  let mut i: u64 = 0
  while i < length {
    buffer[i] = data[i]
    i += 1
  }
  Ok(length)
}

// Validates the whole text, then decides with Eisel-Lemire and, when that is
// undecidable, with Rust's exact DecimalSeq path over the first 768 significant
// digits and a truncated flag for the rest. Long input is still validated.
@noalloc
pub fn parse(text: String, fraction: u64, bias: i32) -> Result[u64, scalar.ParseError] uses {} {
  parse_bytes(core@1/string.as_bytes(text), fraction, bias)
}

// Rust core f6c1107f dec2flt/decimal.rs:39-85 and mod.rs:108-179 (MIT):
// Clinger's path uses an exactly representable mantissa and power of ten,
// followed by ONE correctly rounded operation at the destination precision.
// Hirsel's scalar operations already require binary32/binary64 rounding; no
// x87 precision mutation or disguised-fast-path extension is needed here.
const CLINGER64: Inline[f64, 23] = [1e0f64, 1e1f64, 1e2f64, 1e3f64, 1e4f64, 1e5f64, 1e6f64, 1e7f64, 1e8f64, 1e9f64, 1e10f64, 1e11f64, 1e12f64, 1e13f64, 1e14f64, 1e15f64, 1e16f64, 1e17f64, 1e18f64, 1e19f64, 1e20f64, 1e21f64, 1e22f64]
const CLINGER32: Inline[f32, 11] = [1e0f32, 1e1f32, 1e2f32, 1e3f32, 1e4f32, 1e5f32, 1e6f32, 1e7f32, 1e8f32, 1e9f32, 1e10f32]

// The same parser over a borrowed interval, for typed JSON numeric tokens.
@noalloc
pub fn parse_bytes(bytes: Bytes, fraction: u64, bias: i32) -> Result[
  u64,
  scalar.ParseError
] uses {} {
  let length = core@1/bytes.len(bytes)
  if length == 0 {
    return Error(Invalid)
  }
  let negative = bytes[0] == 45
  let mut at: u64 = if negative {
    1
  } else {
    0
  }
  let start = at
  // Rust core f6c1107f dec2flt/parse.rs:55-76 (MIT): accumulate exactly
  // through the nineteenth significant digit, then only validate/count digits.
  // Separate integer/fraction phases retain Hirsel's required integer and
  // nonempty fraction. Checked byte loads and the original fallback bounds stay.
  while at < length && bytes[at] == 48 {
    at += 1
  }
  let integer_significant_start = at
  let mut leading: u64 = 0
  while at < length && leading < 1000000000000000000 {
    let byte = bytes[at]
    if byte < 48 || byte > 57 {
      break
    }
    leading = leading * 10 + core@1/int.widen(byte - 48)
    at += 1
  }
  if leading >= 1000000000000000000 {
    while at < length && bytes[at] >= 48 && bytes[at] <= 57 {
      at += 1
    }
  }
  let integer_digits = at - start
  let mut significant = at - integer_significant_start
  if integer_digits == 0 {
    return Error(Invalid)
  }
  let mut fractional_digits: u64 = 0
  if at < length && bytes[at] == 46 {
    at += 1
    let fractional_start = at
    if significant == 0 {
      while at < length && bytes[at] == 48 {
        at += 1
      }
    }
    let fractional_significant_start = at
    while at < length && leading < 1000000000000000000 {
      let byte = bytes[at]
      if byte < 48 || byte > 57 {
        break
      }
      leading = leading * 10 + core@1/int.widen(byte - 48)
      at += 1
    }
    if leading >= 1000000000000000000 {
      while at < length && bytes[at] >= 48 && bytes[at] <= 57 {
        at += 1
      }
    }
    fractional_digits = at - fractional_start
    significant += at - fractional_significant_start
    if fractional_digits == 0 {
      return Error(Invalid)
    }
  }
  let digits_end = at
  let mut decimal_exponent: i128 = 0
  if at < length && (bytes[at] == 101 || bytes[at] == 69) {
    at += 1
    let mut exponent_negative: bool = false
    if at < length && (bytes[at] == 45 || bytes[at] == 43) {
      exponent_negative = bytes[at] == 45
      at += 1
    }
    let exponent_start = at
    while at < length && bytes[at] >= 48 && bytes[at] <= 57 {
      // Saturating at 2^65 is safe: String lengths are u64 and cannot cancel it.
      if decimal_exponent < 36893488147419103232 {
        decimal_exponent = decimal_exponent * 10 + core@1/int.widen(bytes[at] - 48)
      }
      at += 1
    }
    if at == exponent_start {
      return Error(Invalid)
    }
    if exponent_negative {
      decimal_exponent = -decimal_exponent
    }
  }
  if at != length {
    return Error(Invalid)
  }
  let sign: u64 = if negative {
    1u64 << fraction + if bias == 127 {
      8
    } else {
      11
    }
  } else {
    0
  }
  if significant == 0 {
    return Ok(sign)
  }
  decimal_exponent -= core@1/int.widen(fractional_digits)
  let order = decimal_exponent + core@1/int.widen(significant) - 1
  if order > 309 {
    return Error(OutOfRange)
  }
  if order < -325 {
    return Ok(sign)
  }
  // Eisel-Lemire decides almost every input from the leading digits. With
  // digits beyond the 19th, the next leading significand up must round the same.
  let taken = if significant < 19 {
    significant
  } else {
    19
  }
  let q: i64 = core@1/int.narrow(
    decimal_exponent + core@1/int.widen(significant - taken)
  )
  if significant == taken {
    if fraction == 52 && bias == 1023 && leading <= 9007199254740992 && q >= -22 && q <= 22 {
      let value: f64 = core@1/float.from_int(leading)
      let scaled = if q < 0 {
        value / CLINGER64[core@1/int.narrow(-q)]
      } else {
        value * CLINGER64[core@1/int.narrow(q)]
      }
      return Ok(sign | core@1/f64.bits(scaled))
    }
    if fraction == 23 && bias == 127 && leading <= 16777216 && q >= -10 && q <= 10 {
      let value: f32 = core@1/float.from_int(leading)
      let scaled = if q < 0 {
        value / CLINGER32[core@1/int.narrow(-q)]
      } else {
        value * CLINGER32[core@1/int.narrow(q)]
      }
      return Ok(sign | core@1/int.widen(core@1/f32.bits(scaled)))
    }
  }
  match internal.float_lemire.compute(q, leading, fraction, bias) {
    Some(bits) => {
      if significant == taken {
        return signed(sign, bits, fraction, bias)
      }
      match internal.float_lemire.compute(q, leading + 1, fraction, bias) {
        Some(above) => if above == bits {
          return signed(sign, bits, fraction, bias)
        },
        None => (),
      }
    },
    None => (),
  }
  // The significant digits of the validated text, without the dot, leading
  // or trailing zeros (decimal_seq.rs:222 parse_decimal_seq). The decimal point
  // comes from the exact order above rather than from re-reading the exponent.
  let mut d = internal.decimal_seq.empty()
  let mut kept: u64 = 0
  let mut scan = start
  while scan < digits_end {
    let byte = bytes[scan]
    if byte != 46 && (byte != 48 || d.num_digits > 0) {
      internal.decimal_seq.try_add_digit(mut d, byte - 48)
      if byte != 48 {
        kept = copy d.num_digits
      }
    }
    scan += 1
  }
  d.num_digits = kept
  if d.num_digits > 768 {
    d.truncated = true
    d.num_digits = 768
  }
  d.decimal_point = core@1/int.narrow(order + 1)
  signed(sign, long_mantissa(mut d, fraction, bias), fraction, bias)
}

// The signed bits of decided IEEE fields; infinity is out of range.
@noalloc
fn signed(sign: u64, fields: u64, fraction: u64, bias: i32) -> Result[
  u64,
  scalar.ParseError
] uses {} {
  let infinite: u64 = core@1/int.narrow(2 * bias + 1)
  if fields == infinite << fraction {
    Error(OutOfRange)
  } else {
    Ok(sign | fields)
  }
}
