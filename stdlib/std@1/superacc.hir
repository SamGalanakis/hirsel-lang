// Exact binary superaccumulator (Kulisch): 2240 bits, separate signs.
// Binary64 needs 2098 value bits plus 64 count bits; 70 limbs suffice for
// every u64-sized Array. Cancellation precedes one ties-even rounding.
// See Kulisch, Computer Arithmetic and Validity, de Gruyter 2008.
pub type Accumulator {
  plus: Inline[u64, 70],
  minus: Inline[u64, 70],
}

@noalloc
pub fn acc_zero() -> Accumulator uses {} {
