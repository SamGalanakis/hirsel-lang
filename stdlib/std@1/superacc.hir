// Radford Neal's xsum small accumulator: signed, overlapping 32-bit chunks.
// Port of radfordneal/xsum @ b766b3e104cdbd6769c8df033fb430700fce32dd:
// xsum.h:59-95; xsum.c:180-459 (carry), :852-995 (split/add).
// Copyright 2015, 2018, 2021, 2024 Radford M. Neal, MIT; see
// native-tests/library/vectors/LICENSE.xsum and third-party/NOTICES.md.
// Adaptations: 68 chunks cover every u64-sized Array, binary-point origin
// is the least subnormal bit, and finish rounds directly to either precision.
pub type Accumulator {
  chunk: Inline[i64, 68],
  adds_until_propagate: u64,
}

@noalloc
pub fn acc_zero() -> Accumulator uses {} {
  Accumulator(
    chunk: [
      0i64,
      0i64,
      0i64,
      0i64,
      0i64,
      0i64,
      0i64,
      0i64,
      0i64,
      0i64,
      0i64,
      0i64,
      0i64,
      0i64,
      0i64,
      0i64,
      0i64,
      0i64,
      0i64,
      0i64,
      0i64,
      0i64,
      0i64,
      0i64,
      0i64,
      0i64,
      0i64,
      0i64,
      0i64,
      0i64,
      0i64,
      0i64,
      0i64,
      0i64,
      0i64,
      0i64,
      0i64,
      0i64,
      0i64,
      0i64,
      0i64,
      0i64,
      0i64,
      0i64,
      0i64,
      0i64,
      0i64,
      0i64,
      0i64,
      0i64,
      0i64,
      0i64,
      0i64,
      0i64,
      0i64,
      0i64,
      0i64,
      0i64,
      0i64,
      0i64,
      0i64,
      0i64,
      0i64,
      0i64,
      0i64,
      0i64,
      0i64,
      0i64
    ],
    adds_until_propagate: 2047
  )
}

// Normalize lower chunks to [0, 2^32); the top chunk carries the sign.
// As in xsum_carry_propagate, do not extend a negative sign into zero
// chunks, and collapse redundant -1 top chunks after cancellation.
@noalloc
fn acc_carry(mut accumulator: Accumulator) -> u64 uses {} {
  let mut top: u64 = 67
  while top > 0 && accumulator.chunk[top] == 0 {
    top -= 1
  }
  let mut i: u64 = 0
  while i <= top {
    let value = copy accumulator.chunk[i]
    let high = value >> 32
    if high != 0 {
      if i == top {
        if high == -1 {
          break
        }
        top += 1
      }
      accumulator.chunk[i] = value & 4294967295i64
      accumulator.chunk[i + 1] += high
    }
    i += 1
  }
  while top > 0 && accumulator.chunk[top] == 0 {
    top -= 1
  }
  while top > 0 && accumulator.chunk[top] == -1 {
    accumulator.chunk[top - 1] -= 4294967296i64
    accumulator.chunk[top] = 0
    top -= 1
  }
  accumulator.adds_until_propagate = 2046
  top
}

@noalloc
pub fn acc_add(mut accumulator: Accumulator, mantissa: u64, shift: u64, negative: bool) -> () uses {} {
  if accumulator.adds_until_propagate == 0 {
    acc_carry(mut accumulator);
  }
  let index = shift / 32
  let low: i64 = core@1/int.narrow(mantissa << shift % 32 & 4294967295u64)
  let high: i64 = core@1/int.narrow(mantissa >> 32 - shift % 32)
  if negative {
    accumulator.chunk[index] -= low
    accumulator.chunk[index + 1] -= high
  } else {
    accumulator.chunk[index] += low
    accumulator.chunk[index + 1] += high
  }
  accumulator.adds_until_propagate -= 1
}

// A single guard/sticky ties-even rounding shared by binary32 and binary64.
// Normalize the magnitude of a negative sum before extracting its bits; this
// permits direct binary32 rounding without a binary64 intermediate.
@noalloc
pub fn acc_finish(
  accumulator: Accumulator,
  fraction: u64,
  exponent_limit: u64,
  sign_bit: u64,
  all_negative_zero: bool
) -> u64 uses {} {
  let mut state = copy accumulator
  let mut top_index = acc_carry(mut state)
  if top_index == 0 && state.chunk[0] == 0 {
    return if all_negative_zero {
      sign_bit
    } else {
      0
    }
  }
  let negative = state.chunk[top_index] < 0
  if negative {
    let mut j: u64 = 0
    while j <= top_index {
      state.chunk[j] = -state.chunk[j]
      j += 1
    }
    top_index = acc_carry(mut state)
  }
  let sign = if negative {
    sign_bit
  } else {
    0u64
  }
  let mut i = top_index + 1
  let mut top: u64 = core@1/int.narrow(state.chunk[i - 1])
  let mut highest = (i - 1) * 32
  while top > 1 {
    top >>= 1
    highest += 1
  }
  if highest >= fraction + exponent_limit - 1 {
    return sign | exponent_limit << fraction
  }
  let mut shift: u64 = if highest > fraction {
    highest - fraction
  } else {
    0
  }
  let mut mantissa: u64 = 0
  i = highest + 1
  while i > shift {
    i -= 1
    let offset: i64 = core@1/int.narrow(i % 32)
    let bit: u64 = core@1/int.narrow(state.chunk[i / 32] >> offset & 1i64)
    mantissa = mantissa << 1 | bit
  }
  if highest < fraction {
    return sign | mantissa
  }
  if shift > 0 {
    let guard_limb = (shift - 1) / 32
    let guard_offset: i64 = core@1/int.narrow((shift - 1) % 32)
    let guard = state.chunk[guard_limb] >> guard_offset & 1i64
    let mut sticky: bool = false
    i = 0
    while i < guard_limb {
      sticky = sticky || state.chunk[i] != 0
      i += 1
    }
    sticky = sticky || state.chunk[guard_limb] & (1i64 << guard_offset) - 1 != 0
    if guard != 0 && (sticky || mantissa % 2 != 0) {
      mantissa += 1
    }
  }
  if mantissa == 1u64 << fraction + 1 {
    mantissa >>= 1
    shift += 1
  }
  let encoded = shift + 1
  if encoded >= exponent_limit {
    return sign | exponent_limit << fraction
  }
  sign | encoded << fraction | mantissa - (1u64 << fraction)
}
