// POSIX lexical paths. normalize collapses separators and dot components but
// rejects a `..` above an absolute root (Invalid at that component), NUL and
// backslash (Invalid at that byte). Relative leading `..` is retained and an
// empty normalized relative path is `.`. join requires a relative child.
// parent/filename operate on raw components, ignoring trailing separators;
// empty and root paths have neither. extension excludes the dot, ignores a
// leading dot, and returns Some("") for a trailing dot. These differ from Go's
// Clean/Dir/Base/Ext; see SEM-3-path-go-run and reports/pa-codec-small.md.
// Slash-only lexical policy. No host authority.
@serializable
pub type PathError = Invalid(u64)

fn owned_piece(text: String, begin: u64, end: u64) -> String uses {} {
  // Component delimiters are ASCII, so the selected offsets are UTF-8 boundaries.
  let Some(a) = core@1/string.position(text, begin) else {
    core@1/failure.check(false, TextInvariant())
    return ""
  }
  let Some(b) = core@1/string.position(text, end) else {
    core@1/failure.check(false, TextInvariant())
    return ""
  }
  unique core@1/string.slice(text, a, b)
}

// Adapted from Zig lib/std/fs/path.zig mem.tokenizeScalar used by resolveAppendPosix.
// Reference commit bff490a23889750de7096d9057c0a432efc929a8; copyright Zig contributors (third-party/NOTICES.md).
pub fn components(p: Path) -> unique List[String] uses {} {
  let text = core@1/path.text(p)
  let bytes = core@1/string.as_bytes(text)
  let len = core@1/bytes.len(bytes)
  let mut parts: List[String] = []
  let mut i: u64 = 0
  while i < len {
    while i < len && bytes[i] == 47 {
      i += 1
    }
    let begin = i
    while i < len && bytes[i] != 47 {
      i += 1
    }
    if begin < i {
      core@1/list.push(mut parts, owned_piece(text, begin, i))
    }
  }
  take parts
}

fn invalid_byte(text: String) -> Option[u64] uses {} {
  let bytes = core@1/string.as_bytes(text)
  let mut i: u64 = 0
  while i < core@1/bytes.len(bytes) {
    if bytes[i] == 0 || bytes[i] == 92 {
      return Some(i)
    }
    i += 1
  }
  None()
}

// Adapted from Zig lib/std/fs/path.zig resolveAppendPosix (active prefix instead of raw buffer truncation).
// Reference commit bff490a23889750de7096d9057c0a432efc929a8; copyright Zig contributors (third-party/NOTICES.md).
pub fn normalize(p: Path) -> Result[Path, PathError] uses {} {
  let text = core@1/path.text(p)
  if let Some(i) = invalid_byte(text) {
    return Error(Invalid(i))
  }
  let absolute = string.starts_with(text, "/")
  let bytes = core@1/string.as_bytes(text)
  let len = core@1/bytes.len(bytes)
  // Keep an active stack prefix; dormant entries are replaced or released on exit.
  let mut parts: List[String] = []
  let mut depth: u64 = 0
  let mut i: u64 = 0
  while i < len {
    while i < len && bytes[i] == 47 {
      i += 1
    }
    let begin = i
    while i < len && bytes[i] != 47 {
      i += 1
    }
    if begin < i {
      let part = owned_piece(text, begin, i)
      if part == ".." && depth != 0 && parts[depth - 1] != ".." {
        depth -= 1
      } else if part != "." {
        if part == ".." && absolute {
          return Error(Invalid(begin))
        }
        if depth < core@1/list.len(parts) {
          parts[depth] = take part
        } else {
          core@1/list.push(mut parts, take part)
        }
        depth += 1
      }
    }
  }
  let mut builder: List[u8] = []
  let mut j: u64 = 0
  while j < depth {
    if j != 0 {
      core@1/list.push(mut builder, 47)
    }
    text.append(mut builder, parts[j])
    j += 1
  }
  let joined = match text.finish(take builder) {
    Ok(value) => take value,
    Error(_) => {
      core@1/failure.check(false, TextInvariant())
      ""
    },
  }
  Ok(
    core@1/path.of(
      if absolute {
        string.concat("/", joined)
      } else if joined == "" {
        "."
      } else {
        take joined
      }
    )
  )
}

// Adapted from Zig lib/std/fs/path.zig joinSepMaybeZ/resolveAppendPosix (relative child contract).
// Reference commit bff490a23889750de7096d9057c0a432efc929a8; copyright Zig contributors (third-party/NOTICES.md).
pub fn join(base: Path, child: Path) -> Result[Path, PathError] uses {} {
  let left = core@1/path.text(base)
  let right = core@1/path.text(child)
  if let Some(i) = invalid_byte(left) {
    return Error(Invalid(i))
  }
  if let Some(i) = invalid_byte(right) {
    return Error(Invalid(i))
  }
  if string.starts_with(right, "/") {
    return Error(Invalid(0))
  }
  if left == "" {
    normalize(child)
  } else {
    normalize(core@1/path.of(string.join([left, right], "/")))
  }
}

// Adapted from Zig lib/std/fs/path.zig dirnameInner (raw component prefix; singleton parent is dot).
// Reference commit bff490a23889750de7096d9057c0a432efc929a8; copyright Zig contributors (third-party/NOTICES.md).
pub fn parent(p: Path) -> Option[Path] uses {} {
  let text = core@1/path.text(p)
  let parts = components(p)
  let count = core@1/list.len(parts)
  if count == 0 {
    return None()
  }
  let absolute = string.starts_with(text, "/")
  let mut prefix: List[String] = []
  let mut i: u64 = 0
  while i + 1 < count {
    core@1/list.push(mut prefix, copy parts[i])
    i += 1
  }
  let joined = string.join(prefix, "/")
  Some(
    core@1/path.of(
      if absolute {
        string.concat("/", joined)
      } else if joined == "" {
        "."
      } else {
        take joined
      }
    )
  )
}

// Adapted from Zig lib/std/fs/path.zig basenameInner (last component; owned UTF-8 result).
// Reference commit bff490a23889750de7096d9057c0a432efc929a8; copyright Zig contributors (third-party/NOTICES.md).
pub fn filename(p: Path) -> Option[unique String] uses {} {
  let text = core@1/path.text(p)
  let bytes = core@1/string.as_bytes(text)
  let mut end = core@1/bytes.len(bytes)
  while end != 0 && bytes[end - 1] == 47 {
    end -= 1
  }
  if end == 0 {
    return None()
  }
  let mut begin = end
  while begin != 0 && bytes[begin - 1] != 47 {
    begin -= 1
  }
  Some(owned_piece(text, begin, end))
}

// None without a non-leading dot; Some("") for an empty suffix ("a."), as Rust's
// Path::extension. Adapted from Zig lib/std/fs/path.zig extension (suffix excludes dot).
// Reference commit bff490a23889750de7096d9057c0a432efc929a8; copyright Zig contributors (third-party/NOTICES.md).
pub fn extension(p: Path) -> Option[unique String] uses {} {
  let Some(name) = filename(p) else {
    return None()
  }
  let bytes = core@1/string.as_bytes(name)
  let len = core@1/bytes.len(bytes)
  let mut i = len
  while i > 1 {
    i -= 1
    if bytes[i] == 46 {
      return Some(owned_piece(name, i + 1, len))
    }
  }
  None()
}
