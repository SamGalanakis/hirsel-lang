// Zig unicode.utf8Encode and Rust str validation/lossy error-span semantics.
pub type EncodeError = InvalidScalar(u32)

@preserves_unique(out)
pub fn append_scalar(mut out: List[u8], scalar: u32) -> Result[(), EncodeError] uses {} {
  if scalar > 1114111u32 || scalar >= 55296u32 && scalar <= 57343u32 {
    return Error(InvalidScalar(scalar))
  }
  if scalar < 128u32 {
    core@1/list.push(mut out, core@1/int.narrow(scalar))
  } else {
    if scalar < 2048u32 {
      core@1/list.push(mut out, core@1/int.narrow(192u32 + scalar / 64u32))
    } else {
      if scalar < 65536u32 {
        core@1/list.push(mut out, core@1/int.narrow(224u32 + scalar / 4096u32))
      } else {
        core@1/list.push(mut out, core@1/int.narrow(240u32 + scalar / 262144u32))
        core@1/list.push(mut out, core@1/int.narrow(128u32 + scalar / 4096u32 % 64u32))
      }
      core@1/list.push(mut out, core@1/int.narrow(128u32 + scalar / 64u32 % 64u32))
    }
    core@1/list.push(mut out, core@1/int.narrow(128u32 + scalar % 64u32))
  }
  Ok(())
}

pub fn decode_lossy(data: Bytes) -> unique String uses {} {
  let mut out: List[u8] = []
  let len = core@1/bytes.len(data)
  let mut i: u64 = 0
  while i < len {
    let first = data[i]
    let width: u64 = if first < 128 {
      1
    } else if first >= 194 && first <= 223 {
      2
    } else if first >= 224 && first <= 239 {
      3
    } else if first >= 240 && first <= 244 {
      4
    } else {
      0
    }
    let mut consumed: u64 = 1
    let mut valid = width != 0
    while valid && consumed < width {
      if consumed >= len - i {
        valid = false
      } else {
        let next = data[i + consumed]
        let low: u8 = if consumed == 1 && first == 224 {
          160
        } else if consumed == 1 && first == 240 {
          144
        } else {
          128
        }
        let high: u8 = if consumed == 1 && first == 237 {
          159
        } else if consumed == 1 && first == 244 {
          143
        } else {
          191
        }
        if next < low || next > high {
          valid = false
        } else {
          consumed += 1
        }
      }
    }
    if valid {
      let mut j: u64 = 0
      while j < width {
        core@1/list.push(mut out, data[i + j])
        j += 1
      }
    } else {
      core@1/list.push(mut out, 239u8)
      core@1/list.push(mut out, 191u8)
      core@1/list.push(mut out, 189u8)
    }
    i += consumed
  }
  match text.finish(take out) {
    Ok(s) => take s,
    Error(_) => {
      core@1/failure.check(false, TextInvariant())
      ""
    },
  }
}
