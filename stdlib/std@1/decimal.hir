// The 16 least significant digits of `value`, zero padded, at
// buffer[start..start + 16] (Rust's `enc_16lsd`).
fn sixteen_digits(value: u64, mut buffer: Inline[u8, 39], start: u64) -> () uses {} {
  let mut remain = value
  let mut offset = start + 16
  while offset > start {
    offset -= 4
    let quad = remain % 10000
    let high = quad / 100 * 2
    let low = quad % 100 * 2
    buffer[offset] = DECIMAL_PAIRS[high]
    buffer[offset + 1] = DECIMAL_PAIRS[high + 1]
    buffer[offset + 2] = DECIMAL_PAIRS[low]
    buffer[offset + 3] = DECIMAL_PAIRS[low + 1]
    remain /= 10000
  }
}

// The digits of `value` end at buffer[end]; returns the index of the first.
// Four digits per step from the pair table, then one pair, then a last
// digit; zero is the one digit "0".
fn leading_digits(value: u64, mut buffer: Inline[u8, 39], end: u64) -> u64 uses {} {
  let mut offset = end
  let mut remain = value
  while remain > 999 {
    offset -= 4
    let quad = remain % 10000
    let high = quad / 100 * 2
    let low = quad % 100 * 2
    buffer[offset] = DECIMAL_PAIRS[high]
    buffer[offset + 1] = DECIMAL_PAIRS[high + 1]
    buffer[offset + 2] = DECIMAL_PAIRS[low]
    buffer[offset + 3] = DECIMAL_PAIRS[low + 1]
    remain /= 10000
  }
  if remain > 9 {
    offset -= 2
    let pair = remain % 100 * 2
    remain /= 100
    buffer[offset] = DECIMAL_PAIRS[pair]
    buffer[offset + 1] = DECIMAL_PAIRS[pair + 1]
  }
  if remain != 0 || value == 0 {
    offset -= 1
    buffer[offset] = DECIMAL_PAIRS[remain * 2 + 1]
  }
  offset
}

// The decimal digits of `magnitude` at the end of `buffer`; returns the
// offset of the first. Adapted from Rust core::fmt::num u128 `_fmt_inner`
// (third-party/NOTICES.md): a magnitude above u64 takes its least significant
// sixteen digits one or two times, and the rest fill the 39-byte scratch from
// its end, four per step from the pair table.
fn fill_digits(magnitude: u128, mut buffer: Inline[u8, 39]) -> u64 uses {} {
  if magnitude <= 18446744073709551615 {
    return leading_digits(core@1/int.narrow(magnitude), mut buffer, 39)
  }
  sixteen_digits(core@1/int.narrow(magnitude % 10000000000000000), mut buffer, 23)
  let high = magnitude / 10000000000000000
  if high < 10000000000000000 {
    return leading_digits(core@1/int.narrow(high), mut buffer, 23)
  }
  sixteen_digits(core@1/int.narrow(high % 10000000000000000), mut buffer, 7)
  leading_digits(core@1/int.narrow(high / 10000000000000000), mut buffer, 7)
}

// Appends the decimal text of `magnitude` to `out`, after a minus sign when
// `negative`, after one reservation of its exact count. A magnitude within
// u64 is written inline into a local 20-byte scratch: passing the scratch to
// a helper by `mut` costs about twice the digit work. Wider magnitudes take
// `fill_digits`.
@preserves_unique(out)
pub fn append(mut out: List[u8], magnitude: u128, negative: bool) -> () uses {} {
  let sign: u64 = if negative {
    1
  } else {
    0
  }
  if magnitude > 18446744073709551615 {
    let mut buffer: Inline[u8, 39] = [
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8
    ]
    let mut first = fill_digits(magnitude, mut buffer)
    core@1/list.reserve(mut out, core@1/list.len(out) + sign + 39 - first)
    if negative {
      core@1/list.push(mut out, 45)
    }
    while first < 39 {
      core@1/list.push(mut out, buffer[first])
      first += 1
    }
    return ()
  }
  append_u64(mut out, core@1/int.narrow(magnitude), negative)
}

// dtolnay/itoa src/lib.rs:264-320 at 1577ed901354d0d7448ac162328f9dbf5183124c:
// four digits per step, then a pair and a leading digit. Keep the u64 path
// word-sized, so ordinary u64/i64 formatters need no u128 dispatch.
@preserves_unique(out)
pub fn append_u64(mut out: List[u8], value: u64, negative: bool) -> () uses {} {
  let sign: u64 = if negative {
    1
  } else {
    0
  }
  // itoa's leading digit: one-byte integers need no pair-table lookups.
  if value < 10 {
    core@1/list.reserve(mut out, core@1/list.len(out) + sign + 1)
    if negative {
      core@1/list.push(mut out, 45)
    }
    core@1/list.push(mut out, core@1/int.narrow(value) + 48u8)
    return
  }
  // Emit the leading one/two digits and the low pair as bulk spans from
  // itoa's pair table. There is no scratch initialization or second digit pass.
  if value < 10000 {
    if negative {
      core@1/list.push(mut out, 45)
    }
    if value >= 100 {
      let high = value / 100 * 2
      let start = if value >= 1000 { high } else { high + 1 }
      core@1/bytes.append(mut out, core@1/bytes.slice(DECIMAL_PAIR_BYTES, start, high + 2))
    }
    let low = value % 100 * 2
    core@1/bytes.append(mut out, core@1/bytes.slice(DECIMAL_PAIR_BYTES, low, low + 2))
    return
  }
  let mut buffer: Inline[u8, 20] = [
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8
  ]
  let count = core@1/bytes.decimal_word(value, mut buffer)
  core@1/list.reserve(mut out, core@1/list.len(out) + sign + count)
  if negative {
    core@1/list.push(mut out, 45)
  }
  let mut offset: u64 = 0
  while offset < count {
    core@1/list.push(mut out, buffer[offset])
    offset += 1
  }
}
