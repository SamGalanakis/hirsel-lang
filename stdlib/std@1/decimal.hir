// Count first so capacity failure leaves every byte unchanged.
@noalloc
pub fn write_unsigned[n: size](value: u128, negative: bool, mut buffer: Inline[u8, n]) -> Result[
  u64,
  scalar.FormatError
] uses {} {
  let mut count: u64 = 1
  let mut remaining = value
  while remaining >= 10 {
    count += 1
    remaining /= 10
  }
  let prefix: u64 = if negative {
    1
  } else {
    0
  }
  if n < count + prefix {
    return Error(BufferTooSmall)
  }
  remaining = value
  let mut i = count + prefix
  while i > prefix {
    i -= 1
    let digit: u8 = core@1/int.narrow(remaining % 10)
    buffer[i] = digit + 48
    remaining /= 10
  }
  if negative {
    buffer[0] = 45
  }
  Ok(count + prefix)
}

// Appends the first `count` bytes of a `format_inline` buffer.
@preserves_unique(out)
pub fn append_prefix(mut out: List[u8], buffer: Inline[u8, 40], count: u64) -> () uses {} {
  core@1/list.reserve(mut out, core@1/list.len(out) + count)
  let mut i: u64 = 0
  while i < count {
    core@1/list.push(mut out, buffer[i])
    i += 1
  }
}

