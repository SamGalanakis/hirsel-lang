  0xfe2ce6e0,
  0xa3014314,
  0x4e0811a1,
  0xf7537e82,
  0xbd3af235,
  0x2ad7d2bb,
  0xeb86d391
]

const SHIFTS: Inline[u32, 16] = [
  7,
  12,
  17,
  22,
  5,
  9,
  14,
  20,
  4,
  11,
  16,
  23,
  6,
  10,
  15,
  21
]

@noalloc
pub fn new() -> State uses {} {
  State(
    words: [0x67452301u32, 0xefcdab89u32, 0x98badcfeu32, 0x10325476u32],
    block: [
      0u8,
      0u8,
      0u8,
      0u8,
