@noalloc
fn rotl(value: u32, bits: u32) -> u32 uses {} {
  value << bits | value >> 32u32 - bits
}

@noalloc
fn add(a: u32, b: u32) -> u32 uses {} {
  core@1/int.wrapping_add(a, b)
}

@noalloc
fn compress(mut state: State) -> () uses {} {
  let mut x: Inline[u32, 16] = [
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32
  ]
  let mut i: u64 = 0
  while i < 16 {
    let at = i * 4
    let b0: u32 = core@1/int.widen(state.block[at])
    let b1: u32 = core@1/int.widen(state.block[at + 1])
    let b2: u32 = core@1/int.widen(state.block[at + 2])
    let b3: u32 = core@1/int.widen(state.block[at + 3])
    x[i] = b0 | b1 << 8 | b2 << 16 | b3 << 24
    i += 1
  }
  rounds(mut state.words, take x)
}

@noalloc
fn compress_input(mut words: Inline[u32, 4], data: Bytes, offset: u64) -> () uses {} {
  let mut x: Inline[u32, 16] = [
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32
  ]
  let mut i: u64 = 0
  while i < 16 {
    let at = offset + i * 4
    let b0: u32 = core@1/int.widen(data[at])
    let b1: u32 = core@1/int.widen(data[at + 1])
    let b2: u32 = core@1/int.widen(data[at + 2])
    let b3: u32 = core@1/int.widen(data[at + 3])
    x[i] = b0 | b1 << 8 | b2 << 16 | b3 << 24
    i += 1
  }
  rounds(mut words, take x)
}

@noalloc
fn rounds(mut words: Inline[u32, 4], take initial: Inline[u32, 16]) -> () uses {} {
  let mut x = take initial
  let mut i: u64 = 0
  let mut a = words[0]
  let mut b = words[1]
  let mut c = words[2]
  let mut d = words[3]
  i = 0
  while i < 64 {
    let round = i >> 4
    let mut f: u32 = 0
    let mut g: u64 = 0
    if round == 0 {
      f = (c ^ d) & b ^ d
      g = i
    } else if round == 1 {
      f = b & d | c & ~d
      g = 5 * i + 1 & 15
    } else if round == 2 {
      f = b ^ c ^ d
      g = 3 * i + 5 & 15
    } else {
      f = c ^ (b | ~d)
      g = 7 * i & 15
    }
    let rotated = rotl(add(f, add(add(a, x[g]), K[i])), SHIFTS[round << 2 | i & 3])
    a = d
    d = c
    c = b
    b = add(b, rotated)
    i += 1
  }
  words[0] = add(words[0], a)
  words[1] = add(words[1], b)
  words[2] = add(words[2], c)
  words[3] = add(words[3], d)
}

@noalloc
pub fn update(mut state: State, data: Bytes) -> () uses {} {
  let len = core@1/bytes.len(data)
  core@1/failure.check(len <= 2305843009213693951u64 - state.count, Arithmetic())
  state.count += len
  let mut i: u64 = 0
  // Fill a partial block left by the previous call before reading input blocks.
  if state.used != 0 {
    while i < len && state.used < 64 {
      state.block[state.used] = data[i]
      state.used += 1
      i += 1
    }
    if state.used == 64 {
      compress(mut state)
      state.used = 0
    }
  }
  // Zig std crypto update: compress full middle blocks without a staging copy.
  while len - i >= 64 {
    compress_input(mut state.words, data, i)
    i += 64
  }
  // Only the incomplete tail survives until the next update or finish.
  while i < len {
    state.block[state.used] = data[i]
    state.used += 1
    i += 1
  }
}

@noalloc
pub fn finish(take state: State) -> Inline[u8, 16] uses {} {
  let mut final_state = take state
  final_state.block[final_state.used] = 128
  final_state.used += 1
  if final_state.used > 56 {
    while final_state.used < 64 {
      final_state.block[final_state.used] = 0
      final_state.used += 1
    }
    compress(mut final_state)
    final_state.used = 0
  }
  while final_state.used < 56 {
    final_state.block[final_state.used] = 0
    final_state.used += 1
  }
  let mut bits = final_state.count * 8u64
  let mut i: u64 = 0
  while i < 8 {
    final_state.block[56 + i] = core@1/int.narrow(bits & 255u64)
    bits >>= 8
    i += 1
  }
  compress(mut final_state)
  let mut out: Inline[u8, 16] = [
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8
  ]
  i = 0
  while i < 4 {
    let value = final_state.words[i]
    out[i * 4] = core@1/int.narrow(value & 255u32)
    out[i * 4 + 1] = core@1/int.narrow(value >> 8 & 255u32)
    out[i * 4 + 2] = core@1/int.narrow(value >> 16 & 255u32)
    out[i * 4 + 3] = core@1/int.narrow(value >> 24)
    i += 1
  }
  take out
}

@noalloc
pub fn digest(data: Bytes) -> Inline[u8, 16] uses {} {
  let mut state = new()
  update(mut state, data)
  finish(take state)
}

pub fn digest_hex(data: Bytes) -> unique String uses {} {
  std@1/hex.encode(std@1/bytes.from_inline(digest(data)))
}
