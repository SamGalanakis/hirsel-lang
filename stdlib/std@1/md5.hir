// Go crypto/md5 md5block.go generic block and md5.go padding (BSD-3-Clause).
// MD5 is broken: collisions are cheap to find. Use it only as a checksum for
// formats that require it, never for authentication or integrity against an adversary.
pub opaque type State: plain + inert uses {} {
  words: Inline[u32, 4],
  block: Inline[u8, 64],
  used: u64,
  count: u64,
}

const K: Inline[u32, 64] = [
  0xd76aa478,
  0xe8c7b756,
  0x242070db,
  0xc1bdceee,
  0xf57c0faf,
  0x4787c62a,
