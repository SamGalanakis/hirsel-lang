// FIPS 202 Keccak-f[1600] sponge, from Zig std/crypto/keccak_p.zig and sha3.zig
// (MIT): one permutation shared by SHA-3 and SHAKE, absorbing and squeezing a
// byte at a time through little-endian lanes.
pub type State {
  lanes: Inline[u64, 25],
  rate: u64,
  used: u64,
  delimiter: u8,
}

const ROUND: Inline[u64, 24] = [
  0x0000000000000001,
  0x0000000000008082,
  0x800000000000808a,
  0x8000000080008000,
  0x000000000000808b,
  0x0000000080000001,
  0x8000000080008081,
  0x8000000000008009,
  0x000000000000008a,
  0x0000000000000088,
  0x0000000080008009,
  0x000000008000000a,
  0x000000008000808b,
  0x800000000000008b,
  0x8000000000008089,
  0x8000000000008003,
  0x8000000000008002,
  0x8000000000000080,
  0x000000000000800a,
  0x800000008000000a,
  0x8000000080008081,
  0x8000000000008080,
  0x0000000080000001,
  0x8000000080008008
]

// A sponge of `rate` bytes whose padding starts with `delimiter`: 0x06 for SHA-3, 0x1f for SHAKE.
@noalloc
pub fn new(rate: u64, delimiter: u8) -> State uses {} {
  State(
    lanes: [
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64
    ],
    rate: rate,
    used: 0,
    delimiter: delimiter
  )
}

// Keccak-f[1600] with the 25 lanes (lane x + 5y) in locals and each round
// unrolled: theta's column parities, rho and pi into b, then chi and iota.
@noalloc
fn permute(mut state: State) -> () uses {} {
  let mut a0 = state.lanes[0]
  let mut a1 = state.lanes[1]
  let mut a2 = state.lanes[2]
  let mut a3 = state.lanes[3]
  let mut a4 = state.lanes[4]
  let mut a5 = state.lanes[5]
  let mut a6 = state.lanes[6]
  let mut a7 = state.lanes[7]
  let mut a8 = state.lanes[8]
  let mut a9 = state.lanes[9]
  let mut a10 = state.lanes[10]
  let mut a11 = state.lanes[11]
  let mut a12 = state.lanes[12]
  let mut a13 = state.lanes[13]
  let mut a14 = state.lanes[14]
  let mut a15 = state.lanes[15]
  let mut a16 = state.lanes[16]
  let mut a17 = state.lanes[17]
  let mut a18 = state.lanes[18]
  let mut a19 = state.lanes[19]
  let mut a20 = state.lanes[20]
  let mut a21 = state.lanes[21]
  let mut a22 = state.lanes[22]
  let mut a23 = state.lanes[23]
  let mut a24 = state.lanes[24]
  let mut round: u64 = 0
  while round < 24 {
    let c0 = a0 ^ a5 ^ a10 ^ a15 ^ a20
    let c1 = a1 ^ a6 ^ a11 ^ a16 ^ a21
    let c2 = a2 ^ a7 ^ a12 ^ a17 ^ a22
    let c3 = a3 ^ a8 ^ a13 ^ a18 ^ a23
    let c4 = a4 ^ a9 ^ a14 ^ a19 ^ a24
    let d0 = c4 ^ (c1 << 1 | c1 >> 63)
    let d1 = c0 ^ (c2 << 1 | c2 >> 63)
    let d2 = c1 ^ (c3 << 1 | c3 >> 63)
    let d3 = c2 ^ (c4 << 1 | c4 >> 63)
    let d4 = c3 ^ (c0 << 1 | c0 >> 63)
    let t0 = a0 ^ d0
    let b0 = t0
    let t5 = a5 ^ d0
    let b16 = t5 << 36 | t5 >> 28
    let t10 = a10 ^ d0
    let b7 = t10 << 3 | t10 >> 61
    let t15 = a15 ^ d0
    let b23 = t15 << 41 | t15 >> 23
    let t20 = a20 ^ d0
    let b14 = t20 << 18 | t20 >> 46
    let t1 = a1 ^ d1
    let b10 = t1 << 1 | t1 >> 63
    let t6 = a6 ^ d1
    let b1 = t6 << 44 | t6 >> 20
    let t11 = a11 ^ d1
    let b17 = t11 << 10 | t11 >> 54
    let t16 = a16 ^ d1
    let b8 = t16 << 45 | t16 >> 19
    let t21 = a21 ^ d1
    let b24 = t21 << 2 | t21 >> 62
    let t2 = a2 ^ d2
    let b20 = t2 << 62 | t2 >> 2
    let t7 = a7 ^ d2
    let b11 = t7 << 6 | t7 >> 58
    let t12 = a12 ^ d2
    let b2 = t12 << 43 | t12 >> 21
    let t17 = a17 ^ d2
    let b18 = t17 << 15 | t17 >> 49
    let t22 = a22 ^ d2
    let b9 = t22 << 61 | t22 >> 3
    let t3 = a3 ^ d3
    let b5 = t3 << 28 | t3 >> 36
    let t8 = a8 ^ d3
    let b21 = t8 << 55 | t8 >> 9
    let t13 = a13 ^ d3
    let b12 = t13 << 25 | t13 >> 39
    let t18 = a18 ^ d3
    let b3 = t18 << 21 | t18 >> 43
    let t23 = a23 ^ d3
    let b19 = t23 << 56 | t23 >> 8
    let t4 = a4 ^ d4
    let b15 = t4 << 27 | t4 >> 37
    let t9 = a9 ^ d4
    let b6 = t9 << 20 | t9 >> 44
    let t14 = a14 ^ d4
    let b22 = t14 << 39 | t14 >> 25
    let t19 = a19 ^ d4
    let b13 = t19 << 8 | t19 >> 56
    let t24 = a24 ^ d4
    let b4 = t24 << 14 | t24 >> 50
    a0 = b0 ^ ~b1 & b2
    a1 = b1 ^ ~b2 & b3
    a2 = b2 ^ ~b3 & b4
    a3 = b3 ^ ~b4 & b0
    a4 = b4 ^ ~b0 & b1
    a5 = b5 ^ ~b6 & b7
    a6 = b6 ^ ~b7 & b8
    a7 = b7 ^ ~b8 & b9
    a8 = b8 ^ ~b9 & b5
    a9 = b9 ^ ~b5 & b6
    a10 = b10 ^ ~b11 & b12
    a11 = b11 ^ ~b12 & b13
    a12 = b12 ^ ~b13 & b14
    a13 = b13 ^ ~b14 & b10
    a14 = b14 ^ ~b10 & b11
    a15 = b15 ^ ~b16 & b17
    a16 = b16 ^ ~b17 & b18
    a17 = b17 ^ ~b18 & b19
    a18 = b18 ^ ~b19 & b15
    a19 = b19 ^ ~b15 & b16
    a20 = b20 ^ ~b21 & b22
    a21 = b21 ^ ~b22 & b23
    a22 = b22 ^ ~b23 & b24
    a23 = b23 ^ ~b24 & b20
    a24 = b24 ^ ~b20 & b21
    a0 = a0 ^ ROUND[round]
    round += 1
  }
  state.lanes[0] = a0
  state.lanes[1] = a1
  state.lanes[2] = a2
  state.lanes[3] = a3
  state.lanes[4] = a4
  state.lanes[5] = a5
  state.lanes[6] = a6
  state.lanes[7] = a7
  state.lanes[8] = a8
  state.lanes[9] = a9
  state.lanes[10] = a10
  state.lanes[11] = a11
  state.lanes[12] = a12
  state.lanes[13] = a13
  state.lanes[14] = a14
  state.lanes[15] = a15
  state.lanes[16] = a16
  state.lanes[17] = a17
  state.lanes[18] = a18
  state.lanes[19] = a19
  state.lanes[20] = a20
  state.lanes[21] = a21
  state.lanes[22] = a22
  state.lanes[23] = a23
  state.lanes[24] = a24
}

@noalloc
fn add_byte(mut state: State, byte: u8) -> () uses {} {
  let lane = state.used >> 3
  let wide: u64 = core@1/int.widen(byte)
  state.lanes[lane] = state.lanes[lane] ^ wide << (state.used & 7) * 8
}

@noalloc
pub fn absorb(mut state: State, data: Bytes) -> () uses {} {
  let len = core@1/bytes.len(data)
  let mut i: u64 = 0
  while i < len {
    // A whole lane at a lane boundary costs one XOR instead of eight.
    if state.used & 7 == 0 && len - i >= 8 {
      let b0: u64 = core@1/int.widen(data[i])
      let b1: u64 = core@1/int.widen(data[i + 1])
      let b2: u64 = core@1/int.widen(data[i + 2])
      let b3: u64 = core@1/int.widen(data[i + 3])
      let b4: u64 = core@1/int.widen(data[i + 4])
      let b5: u64 = core@1/int.widen(data[i + 5])
      let b6: u64 = core@1/int.widen(data[i + 6])
      let b7: u64 = core@1/int.widen(data[i + 7])
      let word = b0 | b1 << 8 | b2 << 16 | b3 << 24 | b4 << 32 | b5 << 40 | b6 << 48 | b7 << 56
      let lane = state.used >> 3
      state.lanes[lane] = state.lanes[lane] ^ word
      state.used += 8
      i += 8
    } else {
      add_byte(mut state, data[i])
      state.used += 1
      i += 1
    }
    if state.used == state.rate {
      permute(mut state)
      state.used = 0
    }
  }
}

// Pads the absorbed input and permutes, leaving the first output block at byte 0.
@noalloc
pub fn pad(mut state: State) -> () uses {} {
  let delimiter = state.delimiter
  add_byte(mut state, delimiter)
  state.used = state.rate - 1
  add_byte(mut state, 0x80)
  permute(mut state)
  state.used = 0
}

// The next output byte of a padded sponge.
@noalloc
pub fn squeeze_byte(mut state: State) -> u8 uses {} {
  if state.used == state.rate {
    permute(mut state)
    state.used = 0
  }
  let byte: u8 = core@1/int.truncate(
    state.lanes[state.used >> 3] >> (state.used & 7) * 8
  )
  state.used += 1
  byte
}
