// Go encoding/csv @ ebe2feef (BSD-3-Clause; third-party/NOTICES.md).
// reader.go:250-281 readLine, :297-453 readRecord; writer.go:160-184 fieldNeedsQuotes.
// Same strict dialect, expressed as resumable byte transitions for bounded chunks.
// Differences: UTF-8 String fields, ASCII delimiters, explicit optional width and
// record bound; errors are terminal and return no partial record. No Comment,
// LazyQuotes, TrimLeadingSpace, ReuseRecord, inferred width or UseCRLF options.
@serializable
pub type Config {
  delimiter: u8,
  fields_per_record: Option[u64],
  max_record_bytes: u64,
}

@serializable
pub type Position {
  start_line: u64,
  line: u64,
  column: u64,
}

@serializable
pub type CsvError = Syntax(Position) | UnequalFields(Position) | RecordTooLarge | InvalidUtf8 | InvalidDelimiter

@serializable
pub type ReadError[E] = Source(E) | Csv(CsvError) | InvalidRead

pub opaque type Reader: copyable + inert + noalloc_drop uses {} {
  config: Config,
  input: List[u8],
  cursor: u64,
  row: List[String],
  field: List[u8],
  mode: u8,
  record_bytes: u64,
  offset: u64,
  record_start: u64,
  line: u64,
  column: u64,
  end_line: u64,
  end_column: u64,
  quote_line: u64,
  quote_column: u64,
  pending_cr: bool,
  ended: bool,
  failed: bool,
}

pub fn default_config() -> Config uses {} {
  Config(delimiter: b',', fields_per_record: None(), max_record_bytes: 1048576)
}

@noalloc
fn delimiter_valid(delimiter: u8) -> bool uses {} {
  delimiter > 0 && delimiter < 128 && delimiter != b'"' && delimiter != b'\n' && delimiter != b'\r'
}

pub fn reader(config: Config) -> Result[Reader, CsvError] uses {} {
  if !delimiter_valid(config.delimiter) {
    return Error(InvalidDelimiter())
  }
  Ok(
    Reader(
      config: config,
      input: [],
      cursor: 0,
      row: [],
      field: [],
      mode: 0,
      record_bytes: 0,
      offset: 0,
      record_start: 1,
      line: 1,
      column: 1,
      end_line: 1,
      end_column: 1,
      quote_line: 1,
      quote_column: 1,
      pending_cr: false,
      ended: false,
      failed: false
    )
  )
}

fn finish_field(mut r: Reader) -> Result[(), CsvError] uses {} {
  let field = unique r.field
  r.field = []
  let Ok(value) = core@1/string.from_bytes(core@1/bytes.from_list(take field)) else {
    return Error(InvalidUtf8())
  }
  core@1/list.push(mut r.row, take value)
  r.mode = 0
  Ok(())
}

fn finish_row(mut r: Reader) -> Result[Option[List[String]], CsvError] uses {} {
  finish_field(mut r)?
  if let Some(width) = r.config.fields_per_record {
    if core@1/list.len(r.row) != width {
      return Error(
        UnequalFields(
          Position(start_line: r.record_start, line: r.record_start, column: 1)
        )
      )
    }
  }
  let row = unique r.row
  r.row = []
  r.record_bytes = 0
  Ok(Some(take row))
}

fn position(r: Reader) -> Position uses {} {
  Position(start_line: r.record_start, line: r.line, column: r.column)
}

// readRecord's unquoted/quoted/closing-quote branches after readLine normalization.
fn normalized(mut r: Reader, byte: u8, line: u64, column: u64) -> Result[
  Option[List[String]],
  CsvError
] uses {} {
  if r.record_bytes == 0 {
    r.record_start = line
  }
  r.end_line = line
  r.end_column = column + 1
  if r.mode != 2 && byte == b'\n' {
    if r.record_bytes == 0 {
      return Ok(None())
    }
    return finish_row(mut r)
  }
  if r.record_bytes == r.config.max_record_bytes {
    return Error(RecordTooLarge())
  }
  r.record_bytes += 1
  if r.mode == 2 {
    if byte == b'"' {
      r.mode = 3
      r.quote_line = line
      r.quote_column = column
    } else {
      core@1/list.push(mut r.field, byte)
    }
  } else if r.mode == 3 {
    if byte == b'"' {
      core@1/list.push(mut r.field, byte)
      r.mode = 2
    } else if byte == r.config.delimiter {
      finish_field(mut r)?
    } else {
      return Error(
        Syntax(
          Position(
            start_line: r.record_start,
            line: r.quote_line,
            column: r.quote_column
          )
        )
      )
    }
  } else if byte == r.config.delimiter {
    finish_field(mut r)?
  } else if byte == b'"' {
    if r.mode != 0 {
      return Error(
        Syntax(Position(start_line: r.record_start, line: line, column: column))
      )
    }
    r.mode = 2
  } else {
    core@1/list.push(mut r.field, byte)
    r.mode = 1
  }
  Ok(None())
}

// Delay CR by one byte: readLine removes CR before LF or EOF, in all modes.
fn csv_step(mut r: Reader, byte: u8) -> Result[Option[List[String]], CsvError] uses {} {
  core@1/failure.check(r.offset < 18446744073709551615u64, TextInvariant())
  r.offset += 1
  let line = r.line
  let column = r.column
  let had_cr = r.pending_cr
  if r.pending_cr {
    r.pending_cr = false
    if byte != b'\n' {
      let ignored = normalized(mut r, b'\r', line, column - 1)?
    }
  }
  if byte == b'\n' {
    r.line += 1
    r.column = 1
  } else {
    r.column += 1
  }
  if byte == b'\r' {
    r.pending_cr = true
    return Ok(None())
  }
  let normalized_column = if byte == b'\n' && had_cr {
    column - 1
  } else {
    column
  }
  normalized(mut r, byte, line, normalized_column)
}

fn end(mut r: Reader) -> Result[Option[List[String]], CsvError] uses {} {
  r.ended = true
  r.pending_cr = false
  if r.mode == 2 {
    return Error(
      Syntax(
        Position(start_line: r.record_start, line: r.end_line, column: r.end_column)
      )
    )
  }
  if r.record_bytes != 0 {
    return finish_row(mut r)
  }
  Ok(None())
}

pub fn feed(mut r: Reader, chunk: Bytes, eof: bool) -> Result[
  List[List[String]],
  CsvError
] uses {} {
  let len = core@1/bytes.len(chunk)
  if r.failed || r.cursor != core@1/list.len(r.input) || r.ended && len != 0 {
    r.failed = true
    return Error(Syntax(position(r)))
  }
  let mut rows: List[List[String]] = []
  let mut i: u64 = 0
  while i < len {
    match csv_step(mut r, chunk[i]) {
      Ok(Some(row)) => core@1/list.push(mut rows, take row),
      Ok(None()) => (),
      Error(error) => {
        r.failed = true
        return Error(error)
      },
    }
    i += 1
  }
  if eof && !r.ended {
    match end(mut r) {
      Ok(Some(row)) => core@1/list.push(mut rows, take row),
      Ok(None()) => (),
      Error(error) => {
        r.failed = true
        return Error(error)
      },
    }
  }
  Ok(take rows)
}

pub fn parse(take text: String, config: Config) -> Result[List[List[String]], CsvError] uses {} {
  let mut r = reader(config)?
  feed(mut r, core@1/string.as_bytes(text), true)
}

pub fn read_record[S, E](
  mut r: Reader,
  mut source: S,
  refill: fn(mut S, mut List[u8], u64) -> Result[u64, E]
) -> Result[Option[List[String]], ReadError[E]] {
  if r.failed {
    return Error(Csv(Syntax(position(r))))
  }
  if r.ended {
    return Ok(None())
  }
  while true {
    if r.cursor == core@1/list.len(r.input) {
      r.input = []
      r.cursor = 0
      let remaining = r.config.max_record_bytes - r.record_bytes
      let capacity: u64 = if remaining >= 4095 {
        4096
      } else {
        remaining + 1
      }
      let count = match refill(mut source, mut r.input, capacity) {
        Ok(count) => count,
        Error(error) => {
          r.failed = true
          return Error(Source(take error))
        },
      }
      if count > capacity || core@1/list.len(r.input) != count {
        r.failed = true
        return Error(InvalidRead())
      }
      if count == 0 {
        match end(mut r) {
          Ok(row) => return Ok(take row),
          Error(error) => {
            r.failed = true
            return Error(Csv(error))
          },
        }
      }
    }
    let byte = r.input[r.cursor]
    r.cursor += 1
    let outcome = csv_step(mut r, byte)
    match take outcome {
      Ok(Some(row)) => return Ok(Some(take row)),
      Ok(None()) => (),
      Error(error) => {
        r.failed = true
        return Error(Csv(error))
      },
    }
  }
  Ok(None())
}

pub fn write_record(fields: List[String], delimiter: u8, mut out: List[u8]) -> Result[
  (),
  CsvError
] uses {} {
  if !delimiter_valid(delimiter) {
    return Error(InvalidDelimiter())
  }
  let mut field_index: u64 = 0
  while field_index < core@1/list.len(fields) {
    if field_index != 0 {
      core@1/list.push(mut out, delimiter)
    }
    let data = core@1/string.as_bytes(fields[field_index])
    let quoted = field_needs_quotes(fields[field_index], delimiter)
    let mut i: u64 = 0
    if quoted {
      core@1/list.push(mut out, b'"')
    }
    i = 0
    while i < core@1/bytes.len(data) {
      if data[i] == b'"' {
        core@1/list.push(mut out, b'"')
      }
      core@1/list.push(mut out, data[i])
      i += 1
    }
    if quoted {
      core@1/list.push(mut out, b'"')
    }
    field_index += 1
  }
  core@1/list.push(mut out, b'\n')
  Ok(())
}

// writer.go:160-184: empty fields stay bare; PostgreSQL's \. is quoted.
fn field_needs_quotes(field: String, delimiter: u8) -> bool uses {} {
  let data = core@1/string.as_bytes(field)
  if core@1/bytes.len(data) == 0 {
    return false
  }
  if field == "\\." {
    return true
  }
  for byte in data {
    if byte == delimiter || byte == b'"' || byte == b'\n' || byte == b'\r' {
      return true
    }
  }
  for c in core@1/string.scalars(field) {
    return std@1/unicode.is_whitespace(c)
  }
  false
}

/// Limits for an owning scoped fold. Zero raw/input budgets forbid further work;
/// zero output budget succeeds without pulling. Refill and record sizes are positive.
pub type StreamConfig {
  csv: Config,
  refill_bytes: u64,
  max_input_bytes: u64,
  max_records: u64,
  max_outputs: u64,
}

pub type DriverError[E] = Source(E) | Callback(E) | Csv(CsvError) | Canceled(
  CancelCause
) | Limit | InvalidRead | InvalidConfig

// Reuse the Go-derived step/end transitions above. Like Go Reader.Read
// (go ebe2fee src/encoding/csv/reader.go:197-205), advance one row only.
// Tokio ce685ee tokio/src/task/coop/mod.rs:8-31 motivates checking even when
// every row is ready and rejected. Hirsel uses explicit deterministic checks,
// rather than Tokio's hidden task budget.
/// Consume an owned source with bounded parsing and explicit cooperative checks.
pub fn fold_scoped[S, A, E](
  scope: Scope,
  take source: S,
  config: StreamConfig,
  take initial: A,
  refill: fn(mut S, mut List[u8], u64) -> Result[u64, E],
  accept: fn(List[String]) -> Result[bool, E],
  step: fn(take A, take List[String]) -> Result[A, E]
) -> Result[A, DriverError[E]] uses {scope, source, initial, refill, accept, step} {
  // Configuration validation precedes every check and any source/callback work.
  if config.refill_bytes == 0 || config.refill_bytes > 65536 || config.csv.max_record_bytes == 0 {
    return Error(InvalidConfig())
  }
  let mut r = reader(config.csv) ? Csv
  let mut input = take source
  let mut accumulator = take initial
  let mut remaining = config.max_input_bytes
  let mut records: u64 = 0
  let mut outputs: u64 = 0
  while outputs < config.max_outputs {
    // Stop at N before any further check, row, or refill. Otherwise cancellation
    // wins over an exhausted raw/input budget at the next documented boundary.
    match core@1/task.check_canceled(scope) {
      Ok(()) => (),
      Error(Canceled(cause)) => return Error(Canceled(cause)),
    }
    if records == config.max_records {
      return Error(Limit())
    }
    let mut row: Option[List[String]] = None()
    let mut complete = false
    while !complete {
      if r.cursor == core@1/list.len(r.input) {
        // EOF finalized the last unterminated row; no extra refill is needed.
        if r.ended {
          return Ok(take accumulator)
        }
        match core@1/task.check_canceled(scope) {
          Ok(()) => (),
          Error(Canceled(cause)) => return Error(Canceled(cause)),
        }
        if remaining == 0 {
          return Error(Limit())
        }
        r.input = []
        r.cursor = 0
        let carry = r.config.max_record_bytes - r.record_bytes
        let mut capacity = config.refill_bytes
        // The extra byte permits a terminator at exactly the record ceiling.
        if carry < capacity {
          capacity = carry + 1
        }
        if remaining < capacity {
          capacity = remaining
        }
        let count = refill(mut input, mut r.input, capacity) ? Source
        if count > capacity || core@1/list.len(r.input) != count {
          return Error(InvalidRead())
        }
        remaining -= count
        if count == 0 {
          row = end(mut r) ? Csv
          complete = true
        }
      }
      if !complete {
        let byte = r.input[r.cursor]
        r.cursor += 1
        row = csv_step(mut r, byte) ? Csv
        if let Some(_) = row {
          complete = true
        }
      }
    }
    match take row {
      None() => return Ok(take accumulator),
      Some(value) => {
        records += 1
        if accept(value) ? Callback {
          accumulator = step(take accumulator, take value) ? Callback
          outputs += 1
        }
      },
    }
  }
  Ok(take accumulator)
}
