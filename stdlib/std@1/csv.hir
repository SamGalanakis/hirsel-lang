// Go encoding/csv @ ebe2feef (BSD-3-Clause; third-party/NOTICES.md).
// reader.go:250-281 readLine, :297-453 readRecord; writer.go:160-184 fieldNeedsQuotes.
// Same strict dialect, expressed as resumable byte transitions for bounded chunks.
// Differences: UTF-8 String fields, ASCII delimiters, explicit optional width and
// record bound; errors are terminal and return no partial record. No Comment,
// LazyQuotes, TrimLeadingSpace, ReuseRecord, inferred width or UseCRLF options.
@serializable
pub type Config {
  delimiter: u8,
  fields_per_record: Option[u64],
  max_record_bytes: u64,
}

/// Writer policy; zero fields still produce a blank line.
@serializable
pub type WriteConfig {
  delimiter: u8,
  preserve_single_empty: bool,
}

@serializable
pub type Position {
  start_line: u64,
  line: u64,
  column: u64,
}

@serializable
pub type CsvError = Syntax(Position) | UnequalFields(Position) | RecordTooLarge | InvalidUtf8 | InvalidDelimiter

@serializable
pub type ReadError[E] = Source(E) | Csv(CsvError) | InvalidRead

pub opaque type Reader: copyable + inert + noalloc_drop uses {} {
  config: Config,
  input: bufio.Reader,
  row: List[String],
  field: List[u8],
  mode: u8,
  record_bytes: u64,
  offset: u64,
  record_start: u64,
  line: u64,
  column: u64,
  end_line: u64,
  end_column: u64,
  quote_line: u64,
  quote_column: u64,
  pending_cr: bool,
  ended: bool,
  failed: bool,
}

pub fn default_config() -> Config uses {} {
  Config(delimiter: b',', fields_per_record: None(), max_record_bytes: 1048576)
}

/// Comma delimiter and the legacy Go-compatible empty-field representation.
pub fn default_write_config() -> WriteConfig uses {} {
  WriteConfig(delimiter: b',', preserve_single_empty: false)
}

@noalloc
fn delimiter_valid(delimiter: u8) -> bool uses {} {
  delimiter > 0 && delimiter < 128 && delimiter != b'"' && delimiter != b'\n' && delimiter != b'\r'
}

pub fn reader(config: Config) -> Result[Reader, CsvError] uses {} {
  if !delimiter_valid(config.delimiter) {
    return Error(InvalidDelimiter())
  }
  Ok(
    Reader(
      config: config,
      input: bufio.new(65536),
      row: [],
      field: [],
      mode: 0,
      record_bytes: 0,
      offset: 0,
      record_start: 1,
      line: 1,
      column: 1,
      end_line: 1,
      end_column: 1,
      quote_line: 1,
      quote_column: 1,
      pending_cr: false,
      ended: false,
      failed: false
    )
  )
}

fn finish_field(mut r: Reader) -> Result[(), CsvError] uses {} {
  let field = unique r.field
  r.field = []
  let Ok(value) = core@1/string.from_bytes(core@1/bytes.from_list(take field)) else {
    return Error(InvalidUtf8())
  }
  core@1/list.push(mut r.row, take value)
  r.mode = 0
  Ok(())
}

fn finish_row(mut r: Reader) -> Result[Option[List[String]], CsvError] uses {} {
  finish_field(mut r)?
  if let Some(width) = r.config.fields_per_record {
    if core@1/list.len(r.row) != width {
      return Error(
        UnequalFields(
          Position(start_line: r.record_start, line: r.record_start, column: 1)
        )
      )
    }
  }
  let row = unique r.row
  r.row = []
  r.record_bytes = 0
  Ok(Some(take row))
}

fn position(r: Reader) -> Position uses {} {
  Position(start_line: r.record_start, line: r.line, column: r.column)
}

// readRecord's unquoted/quoted/closing-quote branches after readLine normalization.
fn normalized(mut r: Reader, byte: u8, line: u64, column: u64) -> Result[
  Option[List[String]],
  CsvError
] uses {} {
  if r.record_bytes == 0 {
    r.record_start = line
  }
  r.end_line = line
  r.end_column = column + 1
  if r.mode != 2 && byte == b'\n' {
    if r.record_bytes == 0 {
      return Ok(None())
    }
    return finish_row(mut r)
  }
  if r.record_bytes == r.config.max_record_bytes {
    return Error(RecordTooLarge())
  }
  r.record_bytes += 1
  if r.mode == 2 {
    if byte == b'"' {
      r.mode = 3
      r.quote_line = line
      r.quote_column = column
    } else {
      core@1/list.push(mut r.field, byte)
    }
  } else if r.mode == 3 {
    if byte == b'"' {
      core@1/list.push(mut r.field, byte)
      r.mode = 2
    } else if byte == r.config.delimiter {
      finish_field(mut r)?
    } else {
      return Error(
        Syntax(
          Position(
            start_line: r.record_start,
            line: r.quote_line,
            column: r.quote_column
          )
        )
      )
    }
  } else if byte == r.config.delimiter {
    finish_field(mut r)?
  } else if byte == b'"' {
    if r.mode != 0 {
      return Error(
        Syntax(Position(start_line: r.record_start, line: line, column: column))
      )
    }
    r.mode = 2
  } else {
    core@1/list.push(mut r.field, byte)
    r.mode = 1
  }
  Ok(None())
}

// Delay CR by one byte: readLine removes CR before LF or EOF, in all modes.
fn csv_step(mut r: Reader, byte: u8) -> Result[Option[List[String]], CsvError] uses {} {
  core@1/failure.check(r.offset < 18446744073709551615u64, TextInvariant())
  r.offset += 1
  let line = r.line
  let column = r.column
  let had_cr = r.pending_cr
  if r.pending_cr {
    r.pending_cr = false
    if byte != b'\n' {
      let ignored = normalized(mut r, b'\r', line, column - 1)?
    }
  }
  if byte == b'\n' {
    r.line += 1
    r.column = 1
  } else {
    r.column += 1
  }
  if byte == b'\r' {
    r.pending_cr = true
    return Ok(None())
  }
  let normalized_column = if byte == b'\n' && had_cr {
    column - 1
  } else {
    column
  }
  normalized(mut r, byte, line, normalized_column)
}

fn end(mut r: Reader) -> Result[Option[List[String]], CsvError] uses {} {
  r.ended = true
  r.pending_cr = false
  if r.mode == 2 {
    return Error(
      Syntax(
        Position(start_line: r.record_start, line: r.end_line, column: r.end_column)
      )
    )
  }
  if r.record_bytes != 0 {
    return finish_row(mut r)
  }
  Ok(None())
}

pub fn feed(mut r: Reader, chunk: Bytes, eof: bool) -> Result[
  List[List[String]],
  CsvError
] uses {} {
  let len = core@1/bytes.len(chunk)
  if r.failed || bufio.buffered(r.input) != 0 || r.ended && len != 0 {
    r.failed = true
    return Error(Syntax(position(r)))
  }
  let mut rows: List[List[String]] = []
  let mut i: u64 = 0
  while i < len {
    match csv_step(mut r, chunk[i]) {
      Ok(Some(row)) => core@1/list.push(mut rows, take row),
      Ok(None()) => (),
      Error(error) => {
        r.failed = true
        return Error(error)
      },
    }
    i += 1
  }
  if eof && !r.ended {
    match end(mut r) {
      Ok(Some(row)) => core@1/list.push(mut rows, take row),
      Ok(None()) => (),
      Error(error) => {
        r.failed = true
        return Error(error)
      },
    }
  }
  Ok(take rows)
}

pub fn parse(take text: String, config: Config) -> Result[List[List[String]], CsvError] uses {} {
  let mut r = reader(config)?
  feed(mut r, core@1/string.as_bytes(text), true)
}

// Go reader.go:439-459 assembles fields after parsing a record. Unlike Go's
// shared record String, each field here owns its bytes. Reuse SliceReader's
// strict transitions/positions; materialize final fields before reusing views.
fn owned_field(data: Bytes) -> String uses {} {
  let mut out: List[u8] = []
  core@1/bytes.append(mut out, data)
  text.finish_valid(take out)
}

fn owned_row(r: SliceReader) -> List[String] uses {} {
  let mut row: List[String] = []
  for i in 0u64..field_count(r) {
    let Some(data) = get_field_bytes(r, i) else {
      core@1/failure.check(false, TextInvariant())
      return []
    }
    core@1/list.push(mut row, owned_field(data))
  }
  take row
}

/// Construct a deeply owned table, independent of the consumed input. Borrow
/// for validation, then shared.freeze(take rows) without cloning the table.
pub fn parse_owned(take text: String, config: Config) -> Result[
  unique List[List[String]],
  CsvError
] uses {} {
  let mut r = slice_reader(text, config)?
  let mut rows: List[List[String]] = []
  while next_record(mut r)? {
    core@1/list.push(mut rows, owned_row(r))
  }
  Ok(take rows)
}

pub fn read_record[S, E](
  mut r: Reader,
  mut source: S,
  refill: fn(mut S, mut List[u8], u64) -> Result[u64, E]
) -> Result[Option[List[String]], ReadError[E]] {
  if r.failed {
    return Error(Csv(Syntax(position(r))))
  }
  if r.ended {
    return Ok(None())
  }
  while true {
    if bufio.buffered(r.input) == 0 {
      let remaining = r.config.max_record_bytes - r.record_bytes
      let capacity: u64 = if remaining >= 4095 {
        4096
      } else {
        remaining + 1
      }
      let count = match bufio.read_more(mut r.input, mut source, refill, capacity) {
        Ok(count) => count,
        Error(Source(error)) => {
          r.failed = true
          return Error(Source(take error))
        },
        Error(_) => {
          r.failed = true
          return Error(InvalidRead())
        },
      }
      if count == 0 {
        match end(mut r) {
          Ok(row) => return Ok(take row),
          Error(error) => {
            r.failed = true
            return Error(Csv(error))
          },
        }
      }
    }
    let byte = bufio.peek(r.input, 1)[0]
    bufio.consume(mut r.input, 1)
    let outcome = csv_step(mut r, byte)
    match take outcome {
      Ok(Some(row)) => return Ok(Some(take row)),
      Ok(None()) => (),
      Error(error) => {
        r.failed = true
        return Error(Csv(error))
      },
    }
  }
  Ok(None())
}

// rust-csv 05612e87 src/writer.rs:945-982,1263-1295 and
// csv-core/src/writer.rs:366-401 (MIT; third-party/NOTICES.md).
// Adapt the empty-record terminator decision to an opt-in, one-field policy.
// A complete borrowed row and growable output need no streaming writer state.
/// Append a record; optionally quote a sole empty field. Zero fields stay LF.
pub fn write_record_with(fields: List[String], config: WriteConfig, mut out: List[u8]) -> Result[
  (),
  CsvError
] uses {} {
  // Validate even the special case before appending any bytes.
  if !delimiter_valid(config.delimiter) {
    return Error(InvalidDelimiter())
  }
  if config.preserve_single_empty && core@1/list.len(fields) == 1 && fields[0] == "" {
    core@1/list.push(mut out, b'"')
    core@1/list.push(mut out, b'"')
    core@1/list.push(mut out, b'\n')
    return Ok(())
  }
  write_record(fields, config.delimiter, mut out)
}

pub fn write_record(fields: List[String], delimiter: u8, mut out: List[u8]) -> Result[
  (),
  CsvError
] uses {} {
  if !delimiter_valid(delimiter) {
    return Error(InvalidDelimiter())
  }
  let mut field_index: u64 = 0
  while field_index < core@1/list.len(fields) {
    if field_index != 0 {
      core@1/list.push(mut out, delimiter)
    }
    let data = core@1/string.as_bytes(fields[field_index])
    let quoted = field_needs_quotes(fields[field_index], delimiter)
    let mut i: u64 = 0
    if quoted {
      core@1/list.push(mut out, b'"')
    }
    i = 0
    while i < core@1/bytes.len(data) {
      if data[i] == b'"' {
        core@1/list.push(mut out, b'"')
      }
      core@1/list.push(mut out, data[i])
      i += 1
    }
    if quoted {
      core@1/list.push(mut out, b'"')
    }
    field_index += 1
  }
  core@1/list.push(mut out, b'\n')
  Ok(())
}

// writer.go:160-184: empty fields stay bare; PostgreSQL's \. is quoted.
fn field_needs_quotes(field: String, delimiter: u8) -> bool uses {} {
  let data = core@1/string.as_bytes(field)
  if core@1/bytes.len(data) == 0 {
    return false
  }
  if field == "\\." {
    return true
  }
  for byte in data {
    if byte == delimiter || byte == b'"' || byte == b'\n' || byte == b'\r' {
      return true
    }
  }
  for c in core@1/string.scalars(field) {
    return std@1/unicode.is_whitespace(c)
  }
  false
}

/// Limits for an owning scoped fold. Zero raw/input budgets forbid further work;
/// zero output budget succeeds without pulling. Refill and record sizes are positive.
pub type StreamConfig {
  csv: Config,
  refill_bytes: u64,
  max_input_bytes: u64,
  max_records: u64,
  max_outputs: u64,
}

pub type DriverError[E] = Source(E) | Callback(E) | Csv(CsvError) | Canceled(
  CancelCause
) | Limit | InvalidRead | InvalidConfig

// Reuse the Go-derived step/end transitions above. Like Go Reader.Read
// (go ebe2fee src/encoding/csv/reader.go:197-205), advance one row only.
// Tokio ce685ee tokio/src/task/coop/mod.rs:8-31 motivates checking even when
// every row is ready and rejected. Hirsel uses explicit deterministic checks,
// rather than Tokio's hidden task budget.
/// Consume an owned source with bounded parsing and explicit cooperative checks.
pub fn fold_scoped[S, A, E](
  scope: Scope,
  take source: S,
  config: StreamConfig,
  take initial: A,
  refill: fn(mut S, mut List[u8], u64) -> Result[u64, E],
  accept: fn(List[String]) -> Result[bool, E],
  step: fn(take A, take List[String]) -> Result[A, E]
) -> Result[A, DriverError[E]] uses {scope, source, initial, refill, accept, step} {
  // Configuration validation precedes every check and any source/callback work.
  if config.refill_bytes == 0 || config.refill_bytes > 65536 || config.csv.max_record_bytes == 0 {
    return Error(InvalidConfig())
  }
  let mut r = reader(config.csv) ? Csv
  let mut input = take source
  let mut accumulator = take initial
  let mut remaining = config.max_input_bytes
  let mut records: u64 = 0
  let mut outputs: u64 = 0
  while outputs < config.max_outputs {
    // Stop at N before any further check, row, or refill. Otherwise cancellation
    // wins over an exhausted raw/input budget at the next documented boundary.
    match core@1/task.check_canceled(scope) {
      Ok(()) => (),
      Error(Canceled(cause)) => return Error(Canceled(cause)),
    }
    if records == config.max_records {
      return Error(Limit())
    }
    let mut row: Option[List[String]] = None()
    let mut complete = false
    while !complete {
      if bufio.buffered(r.input) == 0 {
        // EOF finalized the last unterminated row; no extra refill is needed.
        if r.ended {
          return Ok(take accumulator)
        }
        match core@1/task.check_canceled(scope) {
          Ok(()) => (),
          Error(Canceled(cause)) => return Error(Canceled(cause)),
        }
        if remaining == 0 {
          return Error(Limit())
        }
        let carry = r.config.max_record_bytes - r.record_bytes
        let mut capacity = config.refill_bytes
        // The extra byte permits a terminator at exactly the record ceiling.
        if carry < capacity {
          capacity = carry + 1
        }
        if remaining < capacity {
          capacity = remaining
        }
        let count = match bufio.read_more(mut r.input, mut input, refill, capacity) {
          Ok(count) => count,
          Error(Source(error)) => return Error(Source(error)),
          Error(_) => return Error(InvalidRead()),
        }
        remaining -= count
        if count == 0 {
          row = end(mut r) ? Csv
          complete = true
        }
      }
      if !complete {
        let byte = bufio.peek(r.input, 1)[0]
        bufio.consume(mut r.input, 1)
        row = csv_step(mut r, byte) ? Csv
        if let Some(_) = row {
          complete = true
        }
      }
    }
    match take row {
      None() => return Ok(take accumulator),
      Some(value) => {
        records += 1
        if accept(value) ? Callback {
          accumulator = step(take accumulator, take value) ? Callback
          outputs += 1
        }
      },
    }
  }
  Ok(take accumulator)
}

// csv-core 0.1.13 src/reader.rs:622-700 (read_record_dfa), :980-1068
// (transition_nfa), :1254-1272 (scan_and_copy), MIT/Unlicense.
// Borrow unchanged fields; decode doubled quotes/CRLF into one record buffer.
// The four reachable states are StartField, InField, InQuotedField and
// InDoubleEscapedQuote. Keep Go's strict quotes, CRLF normalization, positions
// and record limits. Unlike csv-core, UTF-8 input is already validated and the
// growable output/field buffers are owned here rather than supplied by callers.
type SliceField {
  start: u64,
  end: u64,
  decoded: bool,
}

/// A borrowed input cursor with reusable field spans and one escape buffer per record.
pub opaque type SliceReader: copyable + inert + noalloc_drop uses {} {
  text: String,
  config: Config,
  pos: u64,
  line: u64,
  column: u64,
  record_start: u64,
  failed: bool,
  fields: List[SliceField],
  count: u64,
  decoded: String,
}

/// Borrow UTF-8 input. Each next_record replaces the current record's views.
pub fn slice_reader(text: String, config: Config) -> Result[SliceReader, CsvError] in text uses {} {
  if !delimiter_valid(config.delimiter) {
    return Error(InvalidDelimiter())
  }
  Ok(
    SliceReader(
      text: text,
      config: config,
      pos: 0,
      line: 1,
      column: 1,
      record_start: 1,
      failed: false,
      fields: [],
      count: 0,
      decoded: ""
    )
  )
}

fn slice_field(
  mut spans: List[SliceField],
  mut count: u64,
  start: u64,
  stop: u64,
  decoded: bool
) -> () uses {} {
  let field = SliceField(start: start, end: stop, decoded: decoded)
  if count < core@1/list.len(spans) {
    spans[count] = field
  } else {
    core@1/list.push(mut spans, field)
  }
  count += 1
}

fn slice_width(r: SliceReader) -> Result[bool, CsvError] uses {} {
  if let Some(width) = r.config.fields_per_record {
    if r.count != width {
      return Error(
        UnequalFields(
          Position(start_line: r.record_start, line: r.record_start, column: 1)
        )
      )
    }
  }
  Ok(true)
}

fn slice_position(r: SliceReader) -> Position uses {} {
  Position(start_line: r.record_start, line: r.line, column: r.column)
}

// One pass over input, with csv-core's ordinary-byte scan fast path. Only
// fields containing an escaped quote or normalized CR require output copies.
fn slice_record(mut r: SliceReader) -> Result[bool, CsvError] uses {} {
  let data = core@1/string.as_bytes(r.text)
  let length = core@1/bytes.len(data)
  let delimiter = r.config.delimiter
  let mut mode: u8 = 0
  let mut record_bytes: u64 = 0
  let mut start = r.pos
  let mut segment = start
  let mut close = start
  let mut output: List[u8] = []
  let mut decoded_start: u64 = 0
  let mut end_line = r.line
  let mut end_column = r.column
  let mut decoded = false
  let mut quote_line = r.line
  let mut quote_column = r.column
  r.record_start = r.line
  while r.pos < length {
    let at = r.pos
    let byte = data[at]
    let line = r.line
    let column = r.column
    // readLine discards CR before LF/EOF in every state. Count only normalized
    // record bytes, and retain the last normalized byte's EOF error position.
    if byte == b'\r' && (at + 1 == length || data[at + 1] == b'\n') {
      if mode != 3 {
        core@1/bytes.append(mut output, core@1/bytes.slice(data, segment, at))
        decoded = true
        segment = at + 1
      }
      r.pos += 1
      r.column += 1
      continue
    }
    if byte == b'\n' && mode != 2 {
      r.pos += 1
      r.line += 1
      r.column = 1
      if record_bytes == 0 {
        start = r.pos
        segment = start
        r.record_start = r.line
        decoded = false
        continue
      }
      let stop = if mode == 3 {
        close
      } else {
        at
      }
      if decoded {
        core@1/bytes.append(mut output, core@1/bytes.slice(data, segment, stop))
        slice_field(
          mut r.fields,
          mut r.count,
          decoded_start,
          core@1/list.len(output),
          true
        )
      } else {
        slice_field(mut r.fields, mut r.count, start, stop, false)
      }
      r.decoded = text.finish_valid(take output)
      return slice_width(r)
    }
    // csv-core's class scan: ordinary bytes cannot change the state. Account
    // for a whole run before returning to the delimiter/quote/CR/LF DFA.
    if byte != delimiter && byte != b'"' && byte != b'\r' && byte != b'\n' && mode != 3 {
      let mut stop = at + 1
      while stop < length && data[stop] != delimiter && data[stop] != b'"' && data[stop] != b'\r' && data[stop] != b'\n' {
        stop += 1
      }
      let count = stop - at
      if count > r.config.max_record_bytes - record_bytes {
        return Error(RecordTooLarge())
      }
      record_bytes += count
      r.pos = stop
      r.column += count
      end_line = r.line
      end_column = r.column
      if mode == 0 {
        mode = 1
      }
      continue
    }
    if record_bytes == r.config.max_record_bytes {
      return Error(RecordTooLarge())
    }
    end_line = line
    end_column = if byte == b'\n' && at > 0 && data[at - 1] == b'\r' {
      column
    } else {
      column + 1
    }
    record_bytes += 1
    r.pos += 1
    if byte == b'\n' {
      r.line += 1
      r.column = 1
    } else {
      r.column += 1
    }
    if mode == 2 {
      if byte == b'"' {
        mode = 3
        close = at
        quote_line = line
        quote_column = column
      }
    } else if mode == 3 && byte == b'"' {
      // Copy through the first quote; discard its doubled partner.
      core@1/bytes.append(mut output, core@1/bytes.slice(data, segment, at))
      segment = at + 1
      decoded = true
      mode = 2
    } else if byte == delimiter {
      let stop = if mode == 3 {
        close
      } else {
        at
      }
      if decoded {
        core@1/bytes.append(mut output, core@1/bytes.slice(data, segment, stop))
        slice_field(
          mut r.fields,
          mut r.count,
          decoded_start,
          core@1/list.len(output),
          true
        )
      } else {
        slice_field(mut r.fields, mut r.count, start, stop, false)
      }
      mode = 0
      start = r.pos
      segment = start
      decoded_start = core@1/list.len(output)
      decoded = false
    } else if mode == 3 {
      return Error(
        Syntax(
          Position(start_line: r.record_start, line: quote_line, column: quote_column)
        )
      )
    } else if byte == b'"' {
      if mode != 0 {
        return Error(
          Syntax(Position(start_line: r.record_start, line: line, column: column))
        )
      }
      mode = 2
      start = r.pos
      segment = start
    } else {
      mode = 1
    }
  }
  if mode == 2 {
    // An EOF CR is discarded, including from the syntax position, as in end.
    return Error(
      Syntax(Position(start_line: r.record_start, line: end_line, column: end_column))
    )
  }
  if record_bytes == 0 {
    return Ok(false)
  }
  let stop = if mode == 3 {
    close
  } else {
    length
  }
  if decoded {
    core@1/bytes.append(mut output, core@1/bytes.slice(data, segment, stop))
    slice_field(mut r.fields, mut r.count, decoded_start, core@1/list.len(output), true)
  } else {
    slice_field(mut r.fields, mut r.count, start, stop, false)
  }
  r.decoded = text.finish_valid(take output)
  slice_width(r)
}

/// Advance one record; false means EOF. Errors are terminal. Release field
/// views before advancing again; the field-span storage is reused.
pub fn next_record(mut r: SliceReader) -> Result[bool, CsvError] uses {} {
  if r.failed {
    return Error(Syntax(slice_position(r)))
  }
  r.count = 0
  r.failed = true
  let record = slice_record(mut r)?
  r.failed = false
  Ok(record)
}

pub fn field_count(r: SliceReader) -> u64 uses {} {
  if r.failed {
    0
  } else {
    r.count
  }
}

/// Borrow a decoded UTF-8 field from the current record.
pub fn get_field(r: SliceReader, index: u64) -> Option[String] in r uses {} {
  if r.failed || index >= r.count {
    return None()
  }
  let span = r.fields[index]
  if span.decoded {
    slice_text(r.decoded, span.start, span.end)
  } else {
    slice_text(r.text, span.start, span.end)
  }
}

@noalloc
fn slice_text(source: String, start: u64, stop: u64) -> Option[String] in source uses {} {
  let Some(first) = core@1/string.position(source, start) else {
    return None()
  }
  let Some(last) = core@1/string.position(source, stop) else {
    return None()
  }
  Some(core@1/string.slice(source, first, last))
}

/// Borrow decoded field bytes without constructing String boundary positions.
@noalloc
pub fn get_field_bytes(r: SliceReader, index: u64) -> Option[Bytes] in r uses {} {
  if r.failed || index >= r.count {
    return None()
  }
  let span = r.fields[index]
  if span.decoded {
    let data = core@1/string.as_bytes(r.decoded)
    Some(core@1/bytes.slice(data, span.start, span.end))
  } else {
    let data = core@1/string.as_bytes(r.text)
    Some(core@1/bytes.slice(data, span.start, span.end))
  }
}
