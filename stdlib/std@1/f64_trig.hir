// sin, cos, tan, asin, acos, atan and atan2 for binary64.
// Ported from the Rust libm crate (rust-lang/compiler-builtins libm, MIT),
// itself from musl and FreeBSD msun (Sun Microsystems permission notice);
// third-party/NOTICES.md. Each function is the crate's algorithm operation
// for operation, so every engine computes the crate's bits.

const PIO2_1: f64 = 1.57079632673412561417e+00
const PIO2_1T: f64 = 6.07710050650619224932e-11
const PIO2_HI: f64 = 1.57079632679489655800e+00
const PIO2_LO: f64 = 6.12323399573676603587e-17
const TRIG_PI: f64 = 3.1415926535897931160e+00

// sin on [-pi/4, pi/4] of x + y, y the reduction's tail (iy == 0: y is 0).
@noalloc
fn sin_kernel(x: f64, y: f64, iy: i32) -> f64 uses {} {
  let z = x * x
  let w = z * z
  let r: f64 = 8.33333333332248946124e-03 + z * (
    -1.98412698298579493134e-04 + z * 2.75573137070700676789e-06
  ) + z * w * (-2.50507602534068634195e-08 + z * 1.58969099521155010221e-10)
  let v = z * x
  if iy == 0 {
    x + v * (-1.66666666666666324348e-01 + z * r)
  } else {
    x - ((z * (0.5 * y - v * r) - y) - v * -1.66666666666666324348e-01)
  }
}

@noalloc
fn cos_kernel(x: f64, y: f64) -> f64 uses {} {
  let z = x * x
  let w = z * z
  let r = z * (
    4.16666666666666019037e-02 + z * (
      -1.38888888888741095749e-03 + z * 2.48015872894767294178e-05
    )
  ) + w * w * (
    -2.75573143513906633035e-07 + z * (
      2.08757232129817482790e-09 + z * -1.13596475577881948265e-11
    )
  )
  let hz: f64 = 0.5 * z
  let one_minus: f64 = 1.0 - hz
  one_minus + (((1.0 - one_minus) - hz) + (z * r - x * y))
}

const TAN_T: Array[f64] = [
  3.33333333333334091986e-01,
  1.33333333333201242699e-01,
  5.39682539762260521377e-02,
  2.18694882948595424599e-02,
  8.86323982359930005737e-03,
  3.59207910759131235356e-03,
  1.45620945432529025516e-03,
  5.88041240820264096874e-04,
  2.46463134818469906812e-04,
  7.81794442939557092300e-05,
  7.14072491382608190305e-05,
  -1.85586374855275456654e-05,
  2.59073051863633712884e-05
]

// tan (odd == 0) or -1/tan (odd == 1) on [-pi/4, pi/4] of x + y.
@noalloc
fn tan_kernel(x_in: f64, y_in: f64, odd: i32) -> f64 uses {} {
  let mut x = x_in
  let mut y = y_in
  let hx: u32 = high_word(x)
  let big = hx & 0x7fffffff >= 0x3fe59428
  if big {
    if hx >> 31 != 0 {
      x = -x
      y = -y
    }
    x = (7.85398163397448278999e-01 - x) + (3.06161699786838301793e-17 - y)
    y = 0.0
  }
  let z = x * x
  let w = z * z
  let r = TAN_T[1] + w * (
    TAN_T[3] + w * (TAN_T[5] + w * (TAN_T[7] + w * (TAN_T[9] + w * TAN_T[11])))
  )
  let v = z * (
    TAN_T[2] + w * (TAN_T[4] + w * (TAN_T[6] + w * (TAN_T[8] + w * (TAN_T[10] + w * TAN_T[12]))))
  )
  let s = z * x
  let rr = y + z * (s * (r + v) + y) + s * TAN_T[0]
  let ww = x + rr
  if big {
    let sign: f64 = 1.0 - 2.0 * of_i32(odd)
    let vv = sign - 2.0 * (x + (rr - ww * ww / (ww + sign)))
    return if hx >> 31 != 0 { -vv } else { vv }
  }
  if odd == 0 { return ww }
  let w0 = core@1/f64.from_bits(core@1/f64.bits(ww) & 0xffffffff00000000)
  let v0 = rr - (w0 - x)
  let a: f64 = -1.0 / ww
  let a0 = core@1/f64.from_bits(core@1/f64.bits(a) & 0xffffffff00000000)
  a0 + a * (1.0 + a0 * w0 + a0 * v0)
}

// x - n pi/2 for |x| < 2^20 pi/2, by round-to-integer and a three-part pi/2.
@noalloc
fn reduce_medium(x: f64, ix: u32) -> (i32, f64, f64) uses {} {
  let to_int: f64 = 6755399441055744.0
  let tmp = x * 6.36619772367581382433e-01 + to_int
  let f_n = tmp - to_int
  let n = saturated_i32(f_n)
  let mut r = x - f_n * PIO2_1
  let mut w = f_n * PIO2_1T
  let mut y0 = r - w
  let ex: i32 = core@1/int.narrow(ix >> 20)
  let ey: i32 = core@1/int.narrow((core@1/f64.bits(y0) >> 52) & 0x7ff)
  if ex - ey > 16 {
    let t = r
    w = f_n * 6.07710050630396597660e-11
    r = t - w
    w = f_n * 2.02226624879595063154e-21 - ((t - r) - w)
    y0 = r - w
    let ey2: i32 = core@1/int.narrow((core@1/f64.bits(y0) >> 52) & 0x7ff)
    if ex - ey2 > 49 {
      let t2 = r
      w = f_n * 2.02226624871116645580e-21
      r = t2 - w
      w = f_n * 8.47842766036889956997e-32 - ((t2 - r) - w)
      y0 = r - w
    }
  }
  (n, y0, (r - y0) - w)
}

// FreeBSD e_rem_pio2.c: x - n pi/2 as y0 + y1 with |y0| <= pi/4.
@noalloc
fn reduce_pio2(x: f64) -> (i32, f64, f64) uses {} {
  let negative = core@1/f64.bits(x) >> 63 != 0
  let ix: u32 = high_word(x) & 0x7fffffff
  if ix <= 0x400f6a7a {
    if ix & 0xfffff == 0x921fb { return reduce_medium(x, ix) }
    if ix <= 0x4002d97c {
      if !negative {
        let z = x - PIO2_1
        let y0 = z - PIO2_1T
        return (1, y0, (z - y0) - PIO2_1T)
      }
      let z = x + PIO2_1
      let y0 = z + PIO2_1T
      return (-1, y0, (z - y0) + PIO2_1T)
    }
    if !negative {
      let z = x - 2.0 * PIO2_1
      let y0 = z - 2.0 * PIO2_1T
      return (2, y0, (z - y0) - 2.0 * PIO2_1T)
    }
    let z = x + 2.0 * PIO2_1
    let y0 = z + 2.0 * PIO2_1T
    return (-2, y0, (z - y0) + 2.0 * PIO2_1T)
  }
  if ix <= 0x401c463b {
    if ix <= 0x4015fdbc {
      if ix == 0x4012d97c { return reduce_medium(x, ix) }
      if !negative {
        let z = x - 3.0 * PIO2_1
        let y0 = z - 3.0 * PIO2_1T
        return (3, y0, (z - y0) - 3.0 * PIO2_1T)
      }
      let z = x + 3.0 * PIO2_1
      let y0 = z + 3.0 * PIO2_1T
      return (-3, y0, (z - y0) + 3.0 * PIO2_1T)
    }
    if ix == 0x401921fb { return reduce_medium(x, ix) }
    if !negative {
      let z = x - 4.0 * PIO2_1
      let y0 = z - 4.0 * PIO2_1T
      return (4, y0, (z - y0) - 4.0 * PIO2_1T)
    }
    let z = x + 4.0 * PIO2_1
    let y0 = z + 4.0 * PIO2_1T
    return (-4, y0, (z - y0) + 4.0 * PIO2_1T)
  }
  if ix < 0x413921fb { return reduce_medium(x, ix) }
  if ix >= 0x7ff00000 {
    let nan = x - x
    return (0, nan, nan)
  }
  // Split |x| scaled to [2^23, 2^24) into three 24-bit chunks.
  let ui = (core@1/f64.bits(x) & 0xfffffffffffff) | ((0x3ffu64 + 23) << 52)
  let mut z = core@1/f64.from_bits(ui)
  let mut tx: Inline[f64, 3] = [0.0, 0.0, 0.0]
  let mut i: u64 = 0
  while i < 2 {
    tx[i] = of_i32(saturated_i32(z))
    z = (z - tx[i]) * 16777216.0
    i += 1
  }
  tx[2] = z
  let mut last: u64 = 2
  while last != 0 && tx[last] == 0.0 { last -= 1 }
  let exponent: i32 = core@1/int.narrow(ix >> 20)
  let (n, y0, y1) = internal.libm.rem_pio2_large(tx, last + 1, exponent - (0x3ff + 23), 1)
  if negative { (-n, -y0, -y1) } else { (n, y0, y1) }
}

// < 1 ulp.
@noalloc
pub fn sin(value: f64) -> f64 uses {} {
  let x = value
  let ix: u32 = high_word(x) & 0x7fffffff
  if ix <= 0x3fe921fb {
    if ix < 0x3e500000 { return x }
    return sin_kernel(x, 0.0, 0)
  }
  if ix >= 0x7ff00000 { return x - x }
  let (n, y0, y1) = reduce_pio2(x)
  let quadrant = n & 3
  if quadrant == 0 { return sin_kernel(y0, y1, 1) }
  if quadrant == 1 { return cos_kernel(y0, y1) }
  if quadrant == 2 { return -sin_kernel(y0, y1, 1) }
  -cos_kernel(y0, y1)
}

// < 1 ulp.
@noalloc
pub fn cos(value: f64) -> f64 uses {} {
  let x = value
  let ix: u32 = high_word(x) & 0x7fffffff
  if ix <= 0x3fe921fb {
    if ix < 0x3e46a09e { return 1.0 }
    return cos_kernel(x, 0.0)
  }
  if ix >= 0x7ff00000 { return x - x }
  let (n, y0, y1) = reduce_pio2(x)
  let quadrant = n & 3
  if quadrant == 0 { return cos_kernel(y0, y1) }
  if quadrant == 1 { return -sin_kernel(y0, y1, 1) }
  if quadrant == 2 { return -cos_kernel(y0, y1) }
  sin_kernel(y0, y1, 1)
}

// < 1 ulp.
@noalloc
pub fn tan(value: f64) -> f64 uses {} {
  let x = value
  let ix: u32 = high_word(x) & 0x7fffffff
  if ix <= 0x3fe921fb {
    if ix < 0x3e400000 { return x }
    return tan_kernel(x, 0.0, 0)
  }
  if ix >= 0x7ff00000 { return x - x }
  let (n, y0, y1) = reduce_pio2(x)
  tan_kernel(y0, y1, n & 1)
}

// The rational approximation of (asin(x) - x) / x^3 shared by asin and acos.
@noalloc
fn asin_ratio(z: f64) -> f64 uses {} {
  let p = z * (
    1.66666666666666657415e-01 + z * (
      -3.25565818622400915405e-01 + z * (
        2.01212532134862925881e-01 + z * (
          -4.00555345006794114027e-02 + z * (
            7.91534994289814532176e-04 + z * 3.47933107596021167570e-05
          )
        )
      )
    )
  )
  let q: f64 = 1.0 + z * (
    -2.40339491173441421878e+00 + z * (
      2.02094576023350569471e+00 + z * (
        -6.88283971605453293030e-01 + z * 7.70381505559019352791e-02
      )
    )
  )
  p / q
}

// FreeBSD e_asin.c; < 1 ulp. NaN outside [-1, 1].
@noalloc
pub fn asin(value: f64) -> f64 uses {} {
  let mut x = value
  let hx: u32 = high_word(x)
  let ix = hx & 0x7fffffff
  if ix >= 0x3ff00000 {
    if (ix - 0x3ff00000) | low_word(x) == 0 {
      return x * PIO2_HI + core@1/f64.from_bits(0x3870000000000000)
    }
    return 0.0 / (x - x)
  }
  if ix < 0x3fe00000 {
    if ix >= 0x00100000 && ix < 0x3e500000 { return x }
    return x + x * asin_ratio(x * x)
  }
  let z: f64 = (1.0 - abs(x)) * 0.5
  let s = sqrt(z)
  let r = asin_ratio(z)
  if ix >= 0x3fef3333 {
    x = PIO2_HI - (2.0 * (s + s * r) - PIO2_LO)
  } else {
    let f = core@1/f64.from_bits(core@1/f64.bits(s) & 0xffffffff00000000)
    let c = (z - f * f) / (s + f)
    x = 0.5 * PIO2_HI - (2.0 * s * r - (PIO2_LO - 2.0 * c) - (0.5 * PIO2_HI - 2.0 * f))
  }
  if hx >> 31 != 0 { -x } else { x }
}

// FreeBSD e_acos.c; < 1 ulp. NaN outside [-1, 1].
@noalloc
pub fn acos(value: f64) -> f64 uses {} {
  let x = value
  let tiny = core@1/f64.from_bits(0x3870000000000000)
  let hx: u32 = high_word(x)
  let ix = hx & 0x7fffffff
  if ix >= 0x3ff00000 {
    if (ix - 0x3ff00000) | low_word(x) == 0 {
      if hx >> 31 != 0 { return 2.0 * PIO2_HI + tiny }
      return 0.0
    }
    return 0.0 / (x - x)
  }
  if ix < 0x3fe00000 {
    if ix <= 0x3c600000 { return PIO2_HI + tiny }
    return PIO2_HI - (x - (PIO2_LO - x * asin_ratio(x * x)))
  }
  if hx >> 31 != 0 {
    let z: f64 = (1.0 + x) * 0.5
    let s = sqrt(z)
    let w = asin_ratio(z) * s - PIO2_LO
    return 2.0 * (PIO2_HI - (s + w))
  }
  let z: f64 = (1.0 - x) * 0.5
  let s = sqrt(z)
  let df = core@1/f64.from_bits(core@1/f64.bits(s) & 0xffffffff00000000)
  let c = (z - df * df) / (s + df)
  let w = asin_ratio(z) * s + c
  2.0 * (df + w)
}

const ATAN_HI: Array[f64] = [
  4.63647609000806093515e-01,
  7.85398163397448278999e-01,
  9.82793723247329054082e-01,
  1.57079632679489655800e+00
]
const ATAN_LO: Array[f64] = [
  2.26987774529616870924e-17,
  3.06161699786838301793e-17,
  1.39033110312309984516e-17,
  6.12323399573676603587e-17
]
const ATAN_T: Array[f64] = [
  3.33333333333329318027e-01,
  -1.99999999998764832476e-01,
  1.42857142725034663711e-01,
  -1.11111104054623557880e-01,
  9.09088713343650656196e-02,
  -7.69187620504482999495e-02,
  6.66107313738753120669e-02,
  -5.83357013379057348645e-02,
  4.97687799461593236017e-02,
  -3.65315727442169155270e-02,
  1.62858201153657823623e-02
]

// FreeBSD s_atan.c; < 1 ulp.
@noalloc
pub fn atan(value: f64) -> f64 uses {} {
  let mut x = value
  let hx: u32 = high_word(x)
  let sign = hx >> 31
  let ix = hx & 0x7fffffff
  if ix >= 0x44100000 {
    if x != x { return x }
    let z = ATAN_HI[3] + core@1/f64.from_bits(0x03800000)
    return if sign != 0 { -z } else { z }
  }
  let mut id: u64 = 4
  if ix < 0x3fdc0000 {
    if ix < 0x3e400000 { return x }
  } else {
    x = abs(x)
    if ix < 0x3ff30000 {
      if ix < 0x3fe60000 {
        x = (2.0 * x - 1.0) / (2.0 + x)
        id = 0
      } else {
        x = (x - 1.0) / (x + 1.0)
        id = 1
      }
    } else if ix < 0x40038000 {
      x = (x - 1.5) / (1.0 + 1.5 * x)
      id = 2
    } else {
      x = -1.0 / x
      id = 3
    }
  }
  let z = x * x
  let w = z * z
  let s1 = z * (
    ATAN_T[0] + w * (ATAN_T[2] + w * (ATAN_T[4] + w * (ATAN_T[6] + w * (ATAN_T[8] + w * ATAN_T[10]))))
  )
  let s2 = w * (ATAN_T[1] + w * (ATAN_T[3] + w * (ATAN_T[5] + w * (ATAN_T[7] + w * ATAN_T[9]))))
  if id == 4 { return x - x * (s1 + s2) }
  let r = ATAN_HI[id] - (x * (s1 + s2) - ATAN_LO[id] - x)
  if sign != 0 { -r } else { r }
}

// FreeBSD e_atan2.c: the angle of (x, y), in [-pi, pi]; < 2 ulp.
@noalloc
pub fn atan2(y: f64, x: f64) -> f64 uses {} {
  if x != x || y != y { return x + y }
  let mut ix: u32 = high_word(x)
  let lx = low_word(x)
  let mut iy: u32 = high_word(y)
  let ly = low_word(y)
  if u32.wrapping_sub(ix, 0x3ff00000) | lx == 0 { return atan(y) }
  let m = ((iy >> 31) & 1) | ((ix >> 30) & 2)
  ix &= 0x7fffffff
  iy &= 0x7fffffff
  if iy | ly == 0 {
    if m <= 1 { return y }
    return if m == 2 { TRIG_PI } else { -TRIG_PI }
  }
  if ix | lx == 0 { return if m & 1 != 0 { -TRIG_PI / 2.0 } else { TRIG_PI / 2.0 } }
  if ix == 0x7ff00000 {
    if iy == 0x7ff00000 {
      if m == 0 { return TRIG_PI / 4.0 }
      if m == 1 { return -TRIG_PI / 4.0 }
      if m == 2 { return 3.0 * TRIG_PI / 4.0 }
      return -3.0 * TRIG_PI / 4.0
    }
    if m == 0 { return 0.0 }
    if m == 1 { return -0.0 }
    if m == 2 { return TRIG_PI }
    return -TRIG_PI
  }
  if core@1/int.wrapping_add(ix, 64u32 << 20) < iy || iy == 0x7ff00000 {
    return if m & 1 != 0 { -TRIG_PI / 2.0 } else { TRIG_PI / 2.0 }
  }
  let z: f64 = if m & 2 != 0 && core@1/int.wrapping_add(iy, 64u32 << 20) < ix {
    0.0
  } else {
    atan(abs(y / x))
  }
  if m == 0 { return z }
  if m == 1 { return -z }
  if m == 2 { return TRIG_PI - (z - 1.2246467991473531772e-16) }
  (z - 1.2246467991473531772e-16) - TRIG_PI
}
