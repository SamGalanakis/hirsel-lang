// Line diffs, unified output and patch application.
// Myers and Histogram are ported from imara-diff (pascalkuthe/imara-diff
// f02e46a737c43c0d9c65a42e5e08046bd10fd739, Apache-2.0, third-party/NOTICES.md):
// src/myers.rs and src/myers/ for Myers' linear-space O(ND) search (E. W.
// Myers, "An O(ND) Difference Algorithm and Its Variations", Algorithmica 1,
// 1986) with its preprocessing and cost cutoff, src/histogram.rs and
// src/histogram/ for histogram diff, src/lib.rs for the common head and tail,
// and src/postprocess.rs without a slider heuristic for the final sliding.
// Patience follows Bram Cohen's description of patience diff, with Myers
// between anchors where none are found. The output is checked against
// imara-diff and against git diff --no-indent-heuristic.
/// `Myers()` uses heuristic pruning and search cutoffs, as git does;
/// `MyersMinimal()` always finds a minimal script.
pub type Algorithm = Myers | MyersMinimal | Histogram | Patience

/// One run of an edit script: `Keep(old, new, count)` keeps `count` lines from
/// `old[old]` and `new[new]`; `Delete(old, new, count)` drops `old[old..old +
/// count]` before `new[new]`; `Insert(old, new, count)` adds `new[new..new +
/// count]` before `old[old]`. Runs cover both sequences in order, and a
/// replacement is a Delete followed by an Insert.
pub type Edit = Keep(u64, u64, u64) | Delete(u64, u64, u64) | Insert(u64, u64, u64)

/// `apply`'s result: the patched text, and the zero-based indexes of the hunks
/// that did not apply, in patch order.
pub type Patched {
  text: String,
  rejected: List[u64],
}

/// `Malformed` carries the one-based line number of the first patch line that
/// is not part of a well-formed unified diff.
pub type PatchError = Malformed(u64)

// --- Lines ----------------------------------------------------------------
fn piece(data: Bytes, start: u64, end: u64) -> String uses {} {
  let mut out: List[u8] = []
  core@1/bytes.append(mut out, core@1/bytes.slice(data, start, end))
  text.finish_valid(take out)
}

/// The lines of `text`, each with its LF; the last line lacks one when `text`
/// does not end in LF. Empty text has no lines.
pub fn split_lines(source: String) -> unique List[String] uses {} {
  let data = core@1/string.as_bytes(source)
  let size = core@1/bytes.len(data)
  let mut out: List[String] = []
  let mut start: u64 = 0
  while start < size {
    let stop = core@1/bytes.find_any(data, b"\n", start)
    let end = if stop < size {
      stop + 1
    } else {
      size
    }
    core@1/list.push(mut out, piece(data, start, end))
    start = end
  }
  take out
}

// Numbers each distinct line, so the algorithms compare integers; also returns
// the number of distinct lines.
fn numbered(old: List[String], new: List[String]) -> (List[u64], List[u64], u64) uses {} {
  let mut ids: Map[String, u64] = core@1/map.empty()
  let mut a: List[u64] = []
  let mut b: List[u64] = []
  for line in old {
    core@1/list.push(mut a, id(mut ids, line))
  }
  for line in new {
    core@1/list.push(mut b, id(mut ids, line))
  }
  let tokens = core@1/map.len(ids)
  (take a, take b, tokens)
}

fn id(mut ids: Map[String, u64], line: String) -> u64 uses {} {
  match core@1/map.get(ids, line) {
    Some(n) => return n,
    None() => (),
  }
  let n = core@1/map.len(ids)
  core@1/map.insert(mut ids, unique line, n)
  n
}

fn flags(count: u64) -> List[bool] uses {} {
  let mut out: List[bool] = []
  core@1/list.reserve(mut out, count)
  for _ in 0u64..count {
    core@1/list.push(mut out, false)
  }
  take out
}

@noalloc
fn wide(value: u64) -> i64 uses {} {
  core@1/int.narrow(value)
}

@noalloc
fn index(value: i64) -> u64 uses {} {
  core@1/int.narrow(value)
}

// --- Shared helpers ---------------------------------------------------------
// imara-diff src/util.rs:285-335. Token ranges are passed as a list with a
// start and an end instead of slices.
@noalloc
fn common_prefix(
  a: List[u64],
  start1: u64,
  end1: u64,
  b: List[u64],
  start2: u64,
  end2: u64
) -> u64 uses {} {
  let mut off: u64 = 0
  while start1 + off < end1 && start2 + off < end2 && a[start1 + off] == b[start2 + off] {
    off += 1
  }
  off
}

@noalloc
fn common_postfix(
  a: List[u64],
  start1: u64,
  end1: u64,
  b: List[u64],
  start2: u64,
  end2: u64
) -> u64 uses {} {
  let mut off: u64 = 0
  while end1 - off > start1 && end2 - off > start2 && a[end1 - off - 1] == b[end2 - off - 1] {
    off += 1
  }
  off
}

// util.rs:332: 2 to the power of half the bit length of `value`.
@noalloc
fn sqrt(value: u64) -> u64 uses {} {
  let mut bits: u64 = 0
  let mut n = value
  while n > 0 {
    bits += 1
    n = n >> 1
  }
  let one: u64 = 1
  one << bits / 2
}

fn mark_range(mut changed: List[bool], start: u64, end: u64) -> () uses {} {
  for i in start..end {
    changed[i] = true
  }
}

// --- Myers ------------------------------------------------------------------
// imara-diff src/myers.rs, src/myers/preprocess.rs, src/myers/slice.rs and
// src/myers/middle_snake.rs: Myers' linear-space search for the middle snake,
// after dropping the lines the other side lacks, with a cost cutoff that
// trades minimality for O(N + M) time on very different inputs.
// preprocess.rs:66-86: how often a token occurs in the other file.
type Occurrence = Absent | Present | Common

// preprocess.rs:20-62.
fn occurrences(
  a: List[u64],
  start1: u64,
  end1: u64,
  b: List[u64],
  start2: u64,
  end2: u64
) -> (List[Occurrence], List[Occurrence]) uses {} {
  let mut limit1 = sqrt(end1 - start1)
  if limit1 > 1024 {
    limit1 = 1024
  }
  let mut limit2 = sqrt(end2 - start2)
  if limit2 > 1024 {
    limit2 = 1024
  }
  let mut buckets: u64 = 0
  for i in start1..end1 {
    if a[i] + 1 > buckets {
      buckets = a[i] + 1
    }
  }
  for i in start2..end2 {
    if b[i] + 1 > buckets {
      buckets = b[i] + 1
    }
  }
  let mut count1: List[u64] = []
  let mut count2: List[u64] = []
  for _ in 0u64..buckets {
    core@1/list.push(mut count1, 0)
    core@1/list.push(mut count2, 0)
  }
  for i in start1..end1 {
    count1[a[i]] += 1
  }
  for i in start2..end2 {
    count2[b[i]] += 1
  }
  let mut out1: unique List[Occurrence] = []
  for i in start1..end1 {
    core@1/list.push(mut out1, occurrence(count2[a[i]], limit1))
  }
  let mut out2: unique List[Occurrence] = []
  for i in start2..end2 {
    core@1/list.push(mut out2, occurrence(count1[b[i]], limit2))
  }
  (take out1, take out2)
}

@noalloc
fn occurrence(count: u64, limit: u64) -> Occurrence uses {} {
  if count == 0 {
    Absent()
  } else if count >= limit {
    Common()
  } else {
    Present()
  }
}

// preprocess.rs:134-180: a common token is dropped when, within 100 tokens
// either way, it sits among tokens absent from the other file that outnumber
// the common ones more than three to one.
fn prune_common(status: List[Occurrence], pos: u64) -> bool uses {} {
  let mut unmatched_before: u64 = 0
  let mut common_before: u64 = 0
  let start = std@1/u64.saturating_sub(pos, 100)
  let mut i = pos
  while i > start {
    i -= 1
    match status[i] {
      Absent() => {
        unmatched_before += 1
      },
      Common() => {
        common_before += 1
      },
      Present() => break,
    }
  }
  if unmatched_before == 0 {
    return false
  }
  let mut end = pos + 100
  if end > core@1/list.len(status) {
    end = core@1/list.len(status)
  }
  let mut unmatched_after: u64 = 0
  let mut common_after: u64 = 0
  for j in pos..end {
    match status[j] {
      Absent() => {
        unmatched_after += 1
      },
      Common() => {
        common_after += 1
      },
      Present() => break,
    }
  }
  if unmatched_after == 0 {
    return false
  }
  unmatched_before + unmatched_after > 3 * (common_before + common_after)
}

// preprocess.rs:108-131: the tokens the search keeps and their original
// indexes; the others are marked changed.
// Unlike upstream, minimal mode keeps every shared token: Common pruning is
// heuristic, and can discard an entire LCS (imara-diff myers.rs:30 and
// preprocess.rs:120-124 apply it even when `minimal` is true).
fn prune(
  xs: List[u64],
  start: u64,
  status: List[Occurrence],
  mut changed: List[bool],
  minimal: bool
) -> (List[u64], List[u64]) uses {} {
  let mut tokens: unique List[u64] = []
  let mut indices: unique List[u64] = []
  for i in 0u64..core@1/list.len(status) {
    let pruned = match status[i] {
      Absent() => true,
      Present() => false,
      Common() => !minimal && prune_common(status, i),
    }
    if pruned {
      changed[start + i] = true
    } else {
      core@1/list.push(mut tokens, xs[start + i])
      core@1/list.push(mut indices, start + i)
    }
  }
  (take tokens, take indices)
}

// One direction of the middle snake search (middle_snake.rs:326-356): the
// diagonals `kmin..=kmax` reached so far, within `dmin..=dmax`. The furthest
// x position on diagonal k is kept in a shared vector at k + base.
type Search {
  back: bool,
  kmin: i64,
  kmax: i64,
  dmin: i64,
  dmax: i64,
}

// middle_snake.rs:316-319.
const SNAKE_CNT: i64 = 20

const K_HEUR: i64 = 4

@noalloc
fn x_at(v: List[i64], k: i64, base: i64) -> i64 uses {} {
  v[index(k + base)]
}

fn set_x(mut v: List[i64], k: i64, base: i64, x: i64) -> () uses {} {
  v[index(k + base)] = x
}

// middle_snake.rs:342-356.
fn search(back: bool, len1: i64, len2: i64, mut v: List[i64], base: i64) -> Search uses {} {
  let dmin = -len2
  let dmax = len1
  let kmid = if back {
    dmin + dmax
  } else {
    0
  }
  set_x(
    mut v,
    kmid,
    base,
    if back {
      len1
    } else {
      0
    }
  )
  Search(back: back, kmin: kmid, kmax: kmid, dmin: dmin, dmax: dmax)
}

@noalloc
fn contains(s: Search, k: i64) -> bool uses {} {
  s.kmin <= k && k <= s.kmax
}

// middle_snake.rs:390-412: widen the diagonals by one each way, turning back
// at the box edges; the diagonals just outside get a value that never wins.
fn next_d(mut s: Search, mut v: List[i64], base: i64) -> () uses {} {
  let outside: i64 = if s.back {
    2147483647
  } else {
    -2147483648
  }
  if s.kmin > s.dmin {
    s.kmin -= 1
    set_x(mut v, s.kmin - 1, base, outside)
  } else {
    s.kmin += 1
  }
  if s.kmax < s.dmax {
    s.kmax += 1
    set_x(mut v, s.kmax + 1, base, outside)
  } else {
    s.kmax -= 1
  }
}

// What a pass found (middle_snake.rs:578-588): nothing, a snake longer than
// SNAKE_CNT, or the point where the two searches meet.
type Pass = Nothing | Snake | Found(i64, i64)

// middle_snake.rs:414-478, with the meeting test of myers.rs:129-131 and
// :156-158: when `meet` is set, the pass stops where it overlaps `other`'s
// furthest reach on the same diagonal.
fn pass(
  s: Search,
  mut v: List[i64],
  h1: List[u64],
  off1: u64,
  len1: i64,
  h2: List[u64],
  off2: u64,
  len2: i64,
  base: i64,
  meet: bool,
  other: Search,
  w: List[i64]
) -> Pass uses {} {
  let mut res: Pass = Nothing()
  let mut k = s.kmax
  while k >= s.kmin {
    let mut x1 = if s.back {
      if x_at(v, k - 1, base) < x_at(v, k + 1, base) {
        x_at(v, k - 1, base)
      } else {
        x_at(v, k + 1, base) - 1
      }
    } else if x_at(v, k - 1, base) >= x_at(v, k + 1, base) {
      x_at(v, k - 1, base) + 1
    } else {
      x_at(v, k + 1, base)
    }
    let mut x2 = x1 - k
    let off = if s.back {
      if x1 > 0 && x2 > 0 {
        wide(common_postfix(h1, off1, off1 + index(x1), h2, off2, off2 + index(x2)))
      } else {
        0
      }
    } else if x1 < len1 && x2 < len2 {
      wide(
        common_prefix(
          h1,
          off1 + index(x1),
          off1 + index(len1),
          h2,
          off2 + index(x2),
          off2 + index(len2)
        )
      )
    } else {
      0
    }
    if off > SNAKE_CNT {
      res = Snake()
    }
    if s.back {
      x1 -= off
      x2 -= off
    } else {
      x1 += off
      x2 += off
    }
    set_x(mut v, k, base, x1)
    if meet && contains(other, k) {
      let y = x_at(w, k, base)
      if s.back && x1 <= y || !s.back && y <= x1 {
        return Found(x1, x2)
      }
    }
    k -= 2
  }
  res
}

// middle_snake.rs:480-511: the furthest point reached on any diagonal, as its
// distance from the search's own corner and its x position.
fn best_position(s: Search, v: List[i64], len1: i64, len2: i64, base: i64) -> (i64, i64) uses {} {
  let mut best_distance: i64 = if s.back {
    0x7fffffffffffffff
  } else {
    -1
  }
  let mut best_x1: i64 = if s.back {
    2147483647
  } else {
    -1
  }
  let mut k = s.kmax
  while k >= s.kmin {
    let mut x1 = x_at(v, k, base)
    if s.back && x1 < 0 {
      x1 = 0
    } else if !s.back && x1 > len1 {
      x1 = len1
    }
    let mut x2 = x1 - k
    if s.back && x2 < 0 {
      x1 = k
      x2 = 0
    } else if !s.back && x2 > len2 {
      x1 = len2 + k
      x2 = len2
    }
    let distance = x1 + x2
    if s.back && distance < best_distance || !s.back && distance > best_distance {
      best_distance = distance
      best_x1 = x1
    }
    k -= 2
  }
  (best_distance, best_x1)
}

// middle_snake.rs:513-573: past the cost threshold, the diagonal whose point
// scores best (its distance from the corner plus its distance from the main
// diagonal, above K_HEUR times the cost) and ends a run of SNAKE_CNT equal
// tokens.
fn good_snake(
  s: Search,
  v: List[i64],
  ec: i64,
  h1: List[u64],
  off1: u64,
  len1: i64,
  h2: List[u64],
  off2: u64,
  len2: i64,
  base: i64
) -> Option[(i64, i64)] uses {} {
  let n = SNAKE_CNT
  let mut best_score: i64 = 0
  let mut best1: i64 = 0
  let mut best2: i64 = 0
  let mut k = s.kmax
  while k >= s.kmin {
    let x1 = x_at(v, k, base)
    let x2 = x1 - k
    let inside = if s.back {
      0 <= x1 && x1 < len1 - n && 0 <= x2 && x2 < len2 - n
    } else {
      n <= x1 && x1 < len1 && n <= x2 && x2 < len2
    }
    if inside {
      let diagonal = if k < 0 {
        -k
      } else {
        k
      }
      let distance = if s.back {
        len1 - x1 + (len2 - x2)
      } else {
        x1 + x2
      }
      let score = distance + diagonal
      if score > K_HEUR * ec && score > best_score {
        let mut run = true
        let mut i: i64 = 0
        while run && i < n {
          run = if s.back {
            h1[off1 + index(x1 + i)] == h2[off2 + index(x2 + i)]
          } else {
            h1[off1 + index(x1 - 1 - i)] == h2[off2 + index(x2 - 1 - i)]
          }
          i += 1
        }
        if run {
          best1 = x1
          best2 = x2
          best_score = score
        }
      }
    }
    k -= 2
  }
  if best_score > 0 {
    Some((best1, best2))
  } else {
    None()
  }
}

// myers.rs:116-236: where to split the box [off1, off1 + len1) x [off2, off2 +
// len2), and whether each half must still be diffed minimally. Unless
// `need_min`, a search costing more than `max_cost` stops at the furthest point
// either direction reached, and one costing more than 256 stops early at a
// good snake.
fn split(
  h1: List[u64],
  off1: u64,
  len1: i64,
  h2: List[u64],
  off2: u64,
  len2: i64,
  mut forward: List[i64],
  mut backward: List[i64],
  base: i64,
  need_min: bool,
  max_cost: i64
) -> (i64, i64, bool, bool) uses {} {
  let mut f = search(false, len1, len2, mut forward, base)
  let mut b = search(true, len1, len2, mut backward, base)
  let odd = (len2 - len1) % 2 != 0
  let mut ec: i64 = 0
  while ec <= max_cost {
    let mut found_snake = false
    next_d(mut f, mut forward, base)
    match pass(f, mut forward, h1, off1, len1, h2, off2, len2, base, odd, b, backward) {
      Found(x1, x2) => return (x1, x2, true, true),
      Snake() => {
        found_snake = true
      },
      Nothing() => (),
    }
    next_d(mut b, mut backward, base)
    match pass(b, mut backward, h1, off1, len1, h2, off2, len2, base, !odd, f, forward) {
      Found(x1, x2) => return (x1, x2, true, true),
      Snake() => {
        found_snake = true
      },
      Nothing() => (),
    }
    if need_min {
      continue
    }
    if found_snake && ec > 256 {
      if let Some((x1, x2)) = good_snake(
        f,
        forward,
        ec,
        h1,
        off1,
        len1,
        h2,
        off2,
        len2,
        base
      ) {
        return (x1, x2, true, false)
      }
      if let Some((x1, x2)) = good_snake(
        b,
        backward,
        ec,
        h1,
        off1,
        len1,
        h2,
        off2,
        len2,
        base
      ) {
        return (x1, x2, false, true)
      }
    }
    ec += 1
  }
  let (distance_forward, x1_forward) = best_position(f, forward, len1, len2, base)
  let (distance_backward, x1_backward) = best_position(b, backward, len1, len2, base)
  if distance_forward > len1 + len2 - distance_backward {
    (x1_forward, distance_forward - x1_forward, true, false)
  } else {
    (x1_backward, distance_backward - x1_backward, false, true)
  }
}

// myers.rs:21-107: preprocess, then split boxes until one side is empty.
// A worklist replaces the recursion.
fn myers(
  a: List[u64],
  start1: u64,
  end1: u64,
  b: List[u64],
  start2: u64,
  end2: u64,
  mut removed: List[bool],
  mut added: List[bool],
  minimal: bool
) -> () uses {} {
  let (status1, status2) = occurrences(a, start1, end1, b, start2, end2)
  let (h1, rows1) = prune(a, start1, status1, mut removed, minimal)
  let (h2, rows2) = prune(b, start2, status2, mut added, minimal)
  let n1 = core@1/list.len(h1)
  let n2 = core@1/list.len(h2)
  let base = wide(n2) + 1
  let mut max_cost = wide(sqrt(n1 + n2 + 3))
  if max_cost < 256 {
    max_cost = 256
  }
  let mut forward: List[i64] = []
  let mut backward: List[i64] = []
  for _ in 0u64..n1 + n2 + 3 {
    core@1/list.push(mut forward, 0)
    core@1/list.push(mut backward, 0)
  }
  let mut boxes: List[(u64, u64, u64, u64, bool)] = [(0, n1, 0, n2, minimal)]
  while let Some((first1, last1, first2, last2, need_min)) = core@1/list.pop(mut boxes) {
    // slice.rs:265-271.
    let head = common_prefix(h1, first1, last1, h2, first2, last2)
    let tail = common_postfix(h1, first1 + head, last1, h2, first2 + head, last2)
    let lo1 = first1 + head
    let hi1 = last1 - tail
    let lo2 = first2 + head
    let hi2 = last2 - tail
    if lo1 == hi1 {
      for i in lo2..hi2 {
        added[rows2[i]] = true
      }
    } else if lo2 == hi2 {
      for i in lo1..hi1 {
        removed[rows1[i]] = true
      }
    } else {
      let (x1, x2, min_lo, min_hi) = split(
        h1,
        lo1,
        wide(hi1 - lo1),
        h2,
        lo2,
        wide(hi2 - lo2),
        mut forward,
        mut backward,
        base,
        need_min,
        max_cost
      )
      core@1/list.push(mut boxes, (lo1 + index(x1), hi1, lo2 + index(x2), hi2, min_hi))
      core@1/list.push(mut boxes, (lo1, lo1 + index(x1), lo2, lo2 + index(x2), min_lo))
    }
  }
}

// --- Histogram --------------------------------------------------------------
// imara-diff src/histogram.rs and src/histogram/lcs.rs: split on the longest
// common run whose rarest token occurs least often in the old side, and fall
// back to Myers when every shared token occurs more than 63 times.
// histogram.rs:9-11: occurrences tracked per token; later ones are ignored.
const MAX_CHAIN_LEN: u64 = 63

// The occurrences of each token in the old range, in order and at most
// MAX_CHAIN_LEN + 1 of them, as list_pool.rs:225-260 keeps them: `first`
// heads each token's chain, `next` links an index to the token's next one.
type Chains {
  count: List[u64],
  first: List[u64],
  last: List[u64],
  next: List[u64],
}

// histogram.rs:61-65.
fn populate(mut h: Chains, a: List[u64], start: u64, end: u64) -> () uses {} {
  for i in start..end {
    let t = a[i]
    if h.count[t] <= MAX_CHAIN_LEN {
      if h.count[t] == 0 {
        h.first[t] = i
      } else {
        h.next[h.last[t]] = i
      }
      h.last[t] = i
      h.count[t] += 1
    }
  }
}

fn clear(mut h: Chains, a: List[u64], start: u64, end: u64) -> () uses {} {
  for i in start..end {
    h.count[a[i]] = 0
  }
}

// lcs.rs:143-152.
type Lcs {
  before_start: u64,
  after_start: u64,
  len: u64,
}

// lcs.rs:125-141 and :164-261, positions absolute. None when the run found
// rests on a token occurring more than MAX_CHAIN_LEN times.
fn find_lcs(
  h: Chains,
  a: List[u64],
  start1: u64,
  end1: u64,
  b: List[u64],
  start2: u64,
  end2: u64
) -> Option[Lcs] uses {} {
  let mut lcs = Lcs(before_start: start1, after_start: start2, len: 0)
  let mut min_occurrences = MAX_CHAIN_LEN + 1
  let mut found_cs = false
  let mut pos = start2
  while pos < end2 {
    let token = b[pos]
    let seen = h.count[token]
    if seen != 0 {
      found_cs = true
      if seen <= min_occurrences {
        // lcs.rs:186-261.
        let after_pos = pos
        let mut next2 = after_pos + 1
        let mut x1 = h.first[token]
        let mut left = seen
        while true {
          let mut rarest = seen
          let mut s1 = x1
          let mut s2 = after_pos
          while s1 > start1 && s2 > start2 && a[s1 - 1] == b[s2 - 1] {
            s1 -= 1
            s2 -= 1
            let c = h.count[a[s1]]
            if c < rarest {
              rarest = c
            }
          }
          let mut e1 = x1 + 1
          let mut e2 = after_pos + 1
          while e1 < end1 && e2 < end2 && a[e1] == b[e2] {
            let c = h.count[a[e1]]
            if c < rarest {
              rarest = c
            }
            e1 += 1
            e2 += 1
          }
          if next2 < e2 {
            next2 = e2
          }
          let len = e2 - s2
          if lcs.len < len || min_occurrences > rarest {
            min_occurrences = rarest
            lcs = Lcs(before_start: s1, after_start: s2, len: len)
          }
          // lcs.rs:248-257 skips to the next occurrence past e2, measured in
          // relative positions on both sides.
          let mut more = false
          while left > 1 && !more {
            x1 = h.next[x1]
            left -= 1
            more = x1 - start1 > e2 - start2
          }
          if !more {
            break
          }
        }
        pos = next2
        continue
      }
    }
    pos += 1
  }
  if !found_cs || min_occurrences <= MAX_CHAIN_LEN {
    Some(lcs)
  } else {
    None()
  }
}

// histogram.rs:67-117, with a worklist in place of the recursion.
fn histogram(
  a: List[u64],
  start1: u64,
  end1: u64,
  b: List[u64],
  start2: u64,
  end2: u64,
  tokens: u64,
  mut removed: List[bool],
  mut added: List[bool]
) -> () uses {} {
  let mut h = Chains(count: [], first: [], last: [], next: [])
  for _ in 0u64..tokens {
    core@1/list.push(mut h.count, 0)
    core@1/list.push(mut h.first, 0)
    core@1/list.push(mut h.last, 0)
  }
  for _ in 0u64..core@1/list.len(a) {
    core@1/list.push(mut h.next, 0)
  }
  let mut ranges: List[(u64, u64, u64, u64)] = [(start1, end1, start2, end2)]
  while let Some((lo1, hi1, lo2, hi2)) = core@1/list.pop(mut ranges) {
    if lo1 == hi1 {
      mark_range(mut added, lo2, hi2)
      continue
    }
    if lo2 == hi2 {
      mark_range(mut removed, lo1, hi1)
      continue
    }
    populate(mut h, a, lo1, hi1)
    let found = find_lcs(h, a, lo1, hi1, b, lo2, hi2)
    clear(mut h, a, lo1, hi1)
    match found {
      Some(lcs) => {
        if lcs.len == 0 {
          mark_range(mut added, lo2, hi2)
          mark_range(mut removed, lo1, hi1)
        } else {
          core@1/list.push(
            mut ranges,
            (lcs.before_start + lcs.len, hi1, lcs.after_start + lcs.len, hi2)
          )
          core@1/list.push(mut ranges, (lo1, lcs.before_start, lo2, lcs.after_start))
        }
      },
      None() => myers(a, lo1, hi1, b, lo2, hi2, mut removed, mut added, false),
    }
  }
}

// --- Patience ---------------------------------------------------------------
// Bram Cohen's patience diff (https://bramcohen.livejournal.com/73318.html):
// match the common head and tail, then the lines occurring exactly once on
// each side, keeping the longest run of them in the same order on both
// (patience sorting), and repeat between each pair of matched lines; a range
// without such lines is diffed with Myers.
fn patience(
  a: List[u64],
  start1: u64,
  end1: u64,
  b: List[u64],
  start2: u64,
  end2: u64,
  mut removed: List[bool],
  mut added: List[bool]
) -> () uses {} {
  let mut ranges: List[(u64, u64, u64, u64)] = [(start1, end1, start2, end2)]
  while let Some((first1, last1, first2, last2)) = core@1/list.pop(mut ranges) {
    let head = common_prefix(a, first1, last1, b, first2, last2)
    let tail = common_postfix(a, first1 + head, last1, b, first2 + head, last2)
    let lo1 = first1 + head
    let hi1 = last1 - tail
    let lo2 = first2 + head
    let hi2 = last2 - tail
    if lo1 == hi1 || lo2 == hi2 {
      mark_range(mut removed, lo1, hi1)
      mark_range(mut added, lo2, hi2)
      continue
    }
    // Per token: occurrences on each side, and its position on each side.
    let mut seen1: Map[u64, (u64, u64)] = core@1/map.empty()
    for i in lo1..hi1 {
      let n = match core@1/map.get(seen1, a[i]) {
        Some((c, _)) => c,
        None() => 0,
      }
      core@1/map.insert(mut seen1, a[i], (n + 1, i))
    }
    let mut seen2: Map[u64, (u64, u64)] = core@1/map.empty()
    for j in lo2..hi2 {
      let n = match core@1/map.get(seen2, b[j]) {
        Some((c, _)) => c,
        None() => 0,
      }
      core@1/map.insert(mut seen2, b[j], (n + 1, j))
    }
    // The unique pairs in old order, as (old, new) positions.
    let mut pairs1: List[u64] = []
    let mut pairs2: List[u64] = []
    for i in lo1..hi1 {
      if let Some((c1, _)) = core@1/map.get(seen1, a[i]) {
        if let Some((c2, j)) = core@1/map.get(seen2, a[i]) {
          if c1 == 1 && c2 == 1 {
            core@1/list.push(mut pairs1, i)
            core@1/list.push(mut pairs2, j)
          }
        }
      }
    }
    let count = core@1/list.len(pairs1)
    if count == 0 {
      myers(a, lo1, hi1, b, lo2, hi2, mut removed, mut added, false)
      continue
    }
    // Patience sorting: piles[p] holds the pair ending the best increasing
    // run of length p + 1; back[e] is the pair before e in its run.
    let mut piles: List[u64] = []
    let mut back: List[u64] = []
    for e in 0u64..count {
      let mut low: u64 = 0
      let mut high = core@1/list.len(piles)
      while low < high {
        let mid = low + (high - low) / 2
        if pairs2[piles[mid]] < pairs2[e] {
          low = mid + 1
        } else {
          high = mid
        }
      }
      core@1/list.push(
        mut back,
        if low > 0 {
          piles[low - 1]
        } else {
          count
        }
      )
      if low == core@1/list.len(piles) {
        core@1/list.push(mut piles, e)
      } else {
        piles[low] = e
      }
    }
    // Queue the gaps between matched lines, last first.
    let mut e = piles[core@1/list.len(piles) - 1]
    let mut next1 = hi1
    let mut next2 = hi2
    while e != count {
      core@1/list.push(mut ranges, (pairs1[e] + 1, next1, pairs2[e] + 1, next2))
      next1 = pairs1[e]
      next2 = pairs2[e]
      e = back[e]
    }
    core@1/list.push(mut ranges, (lo1, next1, lo2, next2))
  }
}

// --- Postprocessing ---------------------------------------------------------
// imara-diff src/postprocess.rs with NoSliderHeuristic (slider_heuristic.rs:
// 42-46) and src/util.rs:337-391: slide each group of changed lines on one
// side up and down past equal lines, merging the groups it meets, and leave it
// at the bottom unless it can line up with a change on the other side.
// util.rs:369-374, as an offset from `pos`.
fn next_change(marks: List[bool], pos: u64) -> Option[u64] uses {} {
  let n = core@1/list.len(marks)
  let mut i = pos
  while i < n {
    if marks[i] {
      return Some(i - pos)
    }
    i += 1
  }
  None()
}

// util.rs:377-382.
@noalloc
fn hunk_end(marks: List[bool], pos: u64) -> u64 uses {} {
  let n = core@1/list.len(marks)
  let mut i = pos
  while i < n && marks[i] {
    i += 1
  }
  i
}

// util.rs:385-391.
@noalloc
fn hunk_start(marks: List[bool], pos: u64) -> u64 uses {} {
  let mut i = pos
  while i > 0 && marks[i - 1] {
    i -= 1
  }
  i
}

// lib.rs Hunk (named Slider here): the changed ranges `before` (the other side) and
// `after` (the side being slid).
type Slider {
  before_start: u64,
  before_end: u64,
  after_start: u64,
  after_end: u64,
}

// util.rs:337-366: the next group of changes on the slid side, with the
// other side's range positioned against it.
fn next_hunk(mut h: Slider, removed: List[bool], added: List[bool]) -> bool uses {} {
  let Some(off) = next_change(added, h.after_end) else {
    return false
  }
  let mut off_before: u64 = 0
  while true {
    let unchanged = match next_change(removed, h.before_end) {
      Some(u) => u,
      None() => core@1/list.len(removed) - h.before_end,
    }
    if off_before + unchanged > off {
      h.before_start = h.before_end + (off - off_before)
      h.before_end = h.before_start
      break
    }
    off_before += unchanged
    h.before_start = h.before_end + unchanged
    h.before_end = hunk_end(removed, h.before_end + unchanged)
    if off_before == off {
      break
    }
  }
  h.after_start = h.after_end + off
  h.after_end = hunk_end(added, h.after_start)
  true
}

// postprocess.rs:136-151.
fn slide_down(
  mut h: Slider,
  tokens: List[u64],
  mut added: List[bool],
  removed: List[bool]
) -> bool uses {} {
  if h.after_end >= core@1/list.len(tokens) || tokens[h.after_start] != tokens[h.after_end] {
    return false
  }
  added[h.after_start] = false
  added[h.after_end] = true
  h.after_start += 1
  h.after_end = hunk_end(added, h.after_end)
  h.before_start = h.before_end + 1
  h.before_end = hunk_end(removed, h.before_start)
  true
}

// postprocess.rs:154-171.
fn slide_up(
  mut h: Slider,
  tokens: List[u64],
  mut added: List[bool],
  removed: List[bool]
) -> bool uses {} {
  if h.after_start == 0 || tokens[h.after_start - 1] != tokens[h.after_end - 1] {
    return false
  }
  added[h.after_start - 1] = true
  added[h.after_end - 1] = false
  h.after_end -= 1
  h.after_start = hunk_start(added, h.after_start - 1)
  h.before_end = h.before_start - 1
  h.before_start = hunk_start(removed, h.before_start - 1)
  true
}

// postprocess.rs:81-133.
fn slide(tokens: List[u64], mut added: List[bool], removed: List[bool]) -> () uses {} {
  let mut h = Slider(before_start: 0, before_end: 0, after_start: 0, after_end: 0)
  while next_hunk(mut h, removed, added) {
    let mut earliest_end: u64 = 0
    let mut modification = false
    while true {
      while slide_up(mut h, tokens, mut added, removed) {}
      earliest_end = h.after_end
      modification = h.before_start != h.before_end
      let size = h.after_end - h.after_start
      while slide_down(mut h, tokens, mut added, removed) {
        modification = modification || h.before_start != h.before_end
      }
      if size == h.after_end - h.after_start {
        break
      }
    }
    if h.after_end != earliest_end && modification {
      while h.before_start == h.before_end && slide_up(
        mut h,
        tokens,
        mut added,
        removed
      ) {}
    }
  }
}

// lib.rs:265-297: strip the common head and tail, diff the rest, then
// postprocess.rs:18-46: slide the new side's groups, then the old side's.
fn changes(old: List[String], new: List[String], algorithm: Algorithm) -> (
  List[bool],
  List[bool]
) uses {} {
  let (a, b, tokens) = numbered(old, new)
  let n1 = core@1/list.len(a)
  let n2 = core@1/list.len(b)
  let mut removed = flags(n1)
  let mut added = flags(n2)
  let head = common_prefix(a, 0, n1, b, 0, n2)
  let tail = common_postfix(a, head, n1, b, head, n2)
  let end1 = n1 - tail
  let end2 = n2 - tail
  match algorithm {
    Myers() => myers(a, head, end1, b, head, end2, mut removed, mut added, false),
    MyersMinimal() => myers(a, head, end1, b, head, end2, mut removed, mut added, true),
    Histogram() => histogram(
      a,
      head,
      end1,
      b,
      head,
      end2,
      tokens,
      mut removed,
      mut added
    ),
    Patience() => patience(a, head, end1, b, head, end2, mut removed, mut added),
  }
  slide(b, mut added, removed)
  slide(a, mut removed, added)
  (take removed, take added)
}

/// The edit script turning `old` into `new`, as runs of kept, deleted and
/// inserted lines (`Edit`). Lines compare whole, terminators included; the
/// common head and tail are kept first. `MyersMinimal()` finds a minimal script
/// by Myers' algorithm after dropping only lines the other side lacks, in
/// O((N + M) D) time and O(N + M) memory for N and M lines and D changed lines.
/// `Myers()` is heuristic: it may also drop frequent shared lines surrounded
/// by absent lines, and gives up minimality to bound the search, as git does:
/// past a cost of 256 a split may stop at a run of 20 equal lines, and past the
/// square root of N + M (at least 256) it stops at the furthest point reached.
/// `Histogram()` splits on the longest
/// common run of the rarest lines, falling back to `Myers()` where every shared
/// line occurs more than 63 times. `Patience()` anchors on lines that occur
/// once on each side, falling back to `Myers()` between anchors with none.
/// Then each change is slid down past equal lines, and back up to line up with
/// a change on the other side, the new side first.
pub fn edits(old: List[String], new: List[String], algorithm: Algorithm) -> unique List[
  Edit
] uses {} {
  let (f1, f2) = changes(old, new, algorithm)
  let n1 = core@1/list.len(old)
  let n2 = core@1/list.len(new)
  let mut out: unique List[Edit] = []
  let mut i1: u64 = 0
  let mut i2: u64 = 0
  while i1 < n1 || i2 < n2 {
    let s1 = i1
    let s2 = i2
    if i1 < n1 && f1[i1] {
      while i1 < n1 && f1[i1] {
        i1 += 1
      }
      core@1/list.push(mut out, Delete(s1, s2, i1 - s1))
    } else if i2 < n2 && f2[i2] {
      while i2 < n2 && f2[i2] {
        i2 += 1
      }
      core@1/list.push(mut out, Insert(s1, s2, i2 - s2))
    } else {
      while i1 < n1 && i2 < n2 && !f1[i1] && !f2[i2] {
        i1 += 1
        i2 += 1
      }
      core@1/list.push(mut out, Keep(s1, s2, i1 - s1))
    }
  }
  take out
}

// --- Unified output ---------------------------------------------------------
// A run of changed lines: `deleted` old lines at `old` and `inserted` new
// lines at `new`.
type Change {
  old: u64,
  deleted: u64,
  new: u64,
  inserted: u64,
}

fn emit(mark: u8, line: String, mut out: List[u8]) -> () uses {} {
  core@1/list.push(mut out, mark)
  text.append(mut out, line)
  if !std@1/string.ends_with(line, "\n") {
    text.append(mut out, "\n\\ No newline at end of file\n")
  }
}

fn range_into(start: u64, count: u64, mut out: List[u8]) -> () uses {} {
  if count == 0 {
    std@1/u64.format_into(start, mut out)
  } else {
    std@1/u64.format_into(start + 1, mut out)
  }
  if count != 1 {
    core@1/list.push(mut out, b',')
    std@1/u64.format_into(count, mut out)
  }
}

/// A unified diff of `old` and `new`, as `git diff -U<context>
/// --no-indent-heuristic` prints one: `--- old_name` and `+++ new_name`
/// lines, then hunks of `@@ -start,count +start,count @@` (a count of one is
/// omitted, and an empty range names the line before it) with `context` lines
/// of context, merging changes at most 2 * context lines apart. A last line
/// without LF is followed by `\ No newline at end of file`. Equal texts give
/// the empty string. Names are written as given.
pub fn unified(
  old_name: String,
  old: String,
  new_name: String,
  new: String,
  algorithm: Algorithm,
  context: u64
) -> unique String uses {} {
  let a = split_lines(old)
  let b = split_lines(new)
  if a == b {
    return ""
  }
  let (f1, f2) = changes(a, b, algorithm)
  let n1 = core@1/list.len(a)
  let n2 = core@1/list.len(b)
  let mut found: List[Change] = []
  let mut i1: u64 = 0
  let mut i2: u64 = 0
  while i1 < n1 || i2 < n2 {
    if i1 < n1 && f1[i1] || i2 < n2 && f2[i2] {
      let s1 = i1
      let s2 = i2
      while i1 < n1 && f1[i1] {
        i1 += 1
      }
      while i2 < n2 && f2[i2] {
        i2 += 1
      }
      core@1/list.push(
        mut found,
        Change(old: s1, deleted: i1 - s1, new: s2, inserted: i2 - s2)
      )
    } else {
      i1 += 1
      i2 += 1
    }
  }
  let mut out: List[u8] = []
  text.append(mut out, "--- ")
  text.append(mut out, old_name)
  text.append(mut out, "\n+++ ")
  text.append(mut out, new_name)
  core@1/list.push(mut out, b'\n')
  let total = core@1/list.len(found)
  let mut k: u64 = 0
  while k < total {
    let mut j = k
    while j + 1 < total && found[j + 1].old - (found[j].old + found[j].deleted) <= 2 * context {
      j += 1
    }
    let s1 = std@1/u64.saturating_sub(found[k].old, context)
    let s2 = std@1/u64.saturating_sub(found[k].new, context)
    let mut e1 = found[j].old + found[j].deleted + context
    if e1 > n1 {
      e1 = n1
    }
    let mut e2 = found[j].new + found[j].inserted + context
    if e2 > n2 {
      e2 = n2
    }
    text.append(mut out, "@@ -")
    range_into(s1, e1 - s1, mut out)
    text.append(mut out, " +")
    range_into(s2, e2 - s2, mut out)
    text.append(mut out, " @@\n")
    let mut p = s1
    for m in k..j + 1 {
      let c = found[m]
      while p < c.old {
        emit(b' ', a[p], mut out)
        p += 1
      }
      for t in c.old..c.old + c.deleted {
        emit(b'-', a[t], mut out)
      }
      for t in c.new..c.new + c.inserted {
        emit(b'+', b[t], mut out)
      }
      p = c.old + c.deleted
    }
    while p < e1 {
      emit(b' ', a[p], mut out)
      p += 1
    }
    k = j + 1
  }
  text.finish_valid(take out)
}

// --- Applying patches -------------------------------------------------------
// `leading` and `trailing` count the context lines before the first change
// and after the last.
type Hunk {
  old_start: u64,
  old: List[String],
  new: List[String],
  leading: u64,
  trailing: u64,
}

fn number(data: Bytes, mut at: u64, line: u64) -> Result[u64, PatchError] uses {} {
  let size = core@1/bytes.len(data)
  let start = at
  let mut value: u64 = 0
  while at < size && std@1/ascii.is_digit(data[at]) {
    let digit: u64 = core@1/int.widen(data[at] - b'0')
    let Some(scaled) = std@1/u64.checked_mul(value, 10) else {
      return Error(Malformed(line))
    }
    let Some(sum) = std@1/u64.checked_add(scaled, digit) else {
      return Error(Malformed(line))
    }
    value = sum
    at += 1
  }
  if at == start {
    return Error(Malformed(line))
  }
  Ok(value)
}

// `-start[,count]` or `+start[,count]`; a missing count is one.
fn side(data: Bytes, from: u64, sign: u8, line: u64) -> Result[(u64, u64), PatchError] uses {} {
  let mut at = from
  if at >= core@1/bytes.len(data) || data[at] != sign {
    return Error(Malformed(line))
  }
  at += 1
  let start = number(data, mut at, line)?
  let mut count: u64 = 1
  if at < core@1/bytes.len(data) && data[at] == b',' {
    at += 1
    count = number(data, mut at, line)?
  }
  Ok((start, count))
}

// Drops the LF of a hunk's last line on one side, for `\ No newline at end of file`.
fn unterminate(mut lines: List[String]) -> () uses {} {
  let count = core@1/list.len(lines)
  if count == 0 {
    return
  }
  let data = core@1/string.as_bytes(lines[count - 1])
  let size = core@1/bytes.len(data)
  if size > 0 && data[size - 1] == b'\n' {
    let trimmed = piece(data, 0, size - 1)
    lines[count - 1] = take trimmed
  }
}

fn hunks(patch: String) -> Result[List[Hunk], PatchError] uses {} {
  let lines = split_lines(patch)
  let total = core@1/list.len(lines)
  let mut out: List[Hunk] = []
  let mut i: u64 = 0
  // Header lines before the first hunk are skipped.
  while i < total && !std@1/string.starts_with(lines[i], "@@ ") {
    i += 1
  }
  while i < total {
    let header = core@1/string.as_bytes(lines[i])
    let number_of_line = i + 1
    if !std@1/string.starts_with(lines[i], "@@ ") {
      return Error(Malformed(number_of_line))
    }
    let (old_start, old_count) = side(header, 3, b'-', number_of_line)?
    let mut at: u64 = 3
    while at < core@1/bytes.len(header) && header[at] != b' ' {
      at += 1
    }
    let (_, new_count) = side(header, at + 1, b'+', number_of_line)?
    i += 1
    let mut hunk = Hunk(old_start: old_start, old: [], new: [], leading: 0, trailing: 0)
    let mut changed = false
    let mut left = old_count
    let mut right = new_count
    // Which sides the previous line went to, for a following `\` line.
    let mut last: u8 = 0
    while i < total && (left > 0 || right > 0 || std@1/string.starts_with(
      lines[i],
      "\\"
    )) {
      let body = core@1/string.as_bytes(lines[i])
      let size = core@1/bytes.len(body)
      let mark = if size == 0 || body[0] == b'\n' {
        b' '
      } else {
        body[0]
      }
      let rest = if size == 0 || body[0] == b'\n' {
        "\n"
      } else {
        piece(body, 1, size)
      }
      if mark == b'\\' {
        if last == 0 {
          return Error(Malformed(i + 1))
        }
        if last != 2 {
          unterminate(mut hunk.old)
        }
        if last != 1 {
          unterminate(mut hunk.new)
        }
        last = 0
      } else if mark == b' ' && left > 0 && right > 0 {
        core@1/list.push(mut hunk.old, copy rest)
        core@1/list.push(mut hunk.new, take rest)
        left -= 1
        right -= 1
        last = 3
        if changed {
          hunk.trailing += 1
        } else {
          hunk.leading += 1
        }
      } else if mark == b'-' && left > 0 {
        core@1/list.push(mut hunk.old, take rest)
        left -= 1
        last = 1
        changed = true
        hunk.trailing = 0
      } else if mark == b'+' && right > 0 {
        core@1/list.push(mut hunk.new, take rest)
        right -= 1
        last = 2
        changed = true
        hunk.trailing = 0
      } else {
        return Error(Malformed(i + 1))
      }
      i += 1
    }
    if left > 0 || right > 0 {
      return Error(Malformed(i + 1))
    }
    core@1/list.push(mut out, take hunk)
  }
  Ok(take out)
}

fn fits(lines: List[String], at: u64, want: List[String]) -> bool uses {} {
  let count = core@1/list.len(want)
  if at + count > core@1/list.len(lines) {
    return false
  }
  for k in 0u64..count {
    if lines[at + k] != want[k] {
      return false
    }
  }
  true
}

/// Applies a unified diff of one file to `source`, as GNU `patch --fuzz=0
/// --forward` does: lines before the first `@@` are skipped; each hunk's old
/// lines (context and deletions) must match exactly, first where its header
/// places them shifted by the offset the previous applied hunk needed, then at
/// the nearest place not before the previous applied hunk, later before
/// earlier at each distance. A hunk with fewer context lines before its
/// changes than after them, starting at the first line, applies only at the
/// start of the file; one with fewer after than before only at its end. A hunk
/// that matches nowhere is rejected and the rest still apply.
/// `\ No newline at end of file` drops the preceding line's LF.
pub fn apply(source: String, patch: String) -> Result[Patched, PatchError] uses {} {
  let lines = split_lines(source)
  let parsed = hunks(patch)?
  let total = core@1/list.len(lines)
  let mut out: List[u8] = []
  let mut rejected: List[u64] = []
  // Lines before `done` are copied or replaced already.
  let mut done: u64 = 0
  let mut shift: i64 = 0
  let mut h: u64 = 0
  for hunk in parsed {
    let count = core@1/list.len(hunk.old)
    // An old range of zero lines starts after its line, not at it.
    let stated = if count == 0 {
      wide(hunk.old_start)
    } else {
      wide(hunk.old_start) - 1
    }
    let expected = stated + shift
    let last_start = wide(total) - wide(count)
    let mut place: Option[u64] = None()
    let mut distance: i64 = 0
    let lowest = wide(done)
    // Less context on one side than the other marks a hunk at an end of the
    // file, where it alone may apply.
    let context = if hunk.leading > hunk.trailing {
      hunk.leading
    } else {
      hunk.trailing
    }
    let mut searching = true
    if hunk.leading < context && hunk.old_start <= 1 {
      if (hunk.trailing >= context || count == total) && done == 0 && fits(
        lines,
        0,
        hunk.old
      ) {
        place = Some(0)
      }
      searching = false
    } else if hunk.trailing < context {
      if last_start >= lowest && fits(lines, index(last_start), hunk.old) {
        place = Some(index(last_start))
      }
      searching = false
    }
    while searching && place == None() && (expected - distance >= lowest || expected + distance <= last_start) {
      let later = expected + distance
      if later >= lowest && later <= last_start && fits(lines, index(later), hunk.old) {
        place = Some(index(later))
      } else {
        let earlier = expected - distance
        if distance > 0 && earlier >= lowest && earlier <= last_start && fits(
          lines,
          index(earlier),
          hunk.old
        ) {
          place = Some(index(earlier))
        }
      }
      distance += 1
    }
    match place {
      Some(at) => {
        while done < at {
          text.append(mut out, lines[done])
          done += 1
        }
        for line in hunk.new {
          text.append(mut out, line)
        }
        done = at + count
        shift = wide(at) - stated
      },
      None() => core@1/list.push(mut rejected, h),
    }
    h += 1
  }
  while done < total {
    text.append(mut out, lines[done])
    done += 1
  }
  Ok(Patched(text: text.finish_valid(take out), rejected: take rejected))
}
