// Rust dec2flt DecimalSeq (decimal_seq.rs:22): a decimal significand
// 0.d0 d1 ... * 10^decimal_point. 768 digits hold every binary64 exactly (767
// significant digits at most); truncated records a nonzero digit dropped past them.
pub type DecimalSeq {
  num_digits: u64,
  decimal_point: i32,
  truncated: bool,
  digits: Inline[u8, 768],
}

@noalloc
pub fn empty() -> DecimalSeq uses {} {
  DecimalSeq(num_digits: 0, decimal_point: 0, truncated: false, digits: [0u8; 768])
}

// decimal_seq.rs:70 try_add_digit: counts every digit, stores the first 768.
@noalloc
pub fn try_add_digit(mut d: DecimalSeq, digit: u8) -> () uses {} {
  if d.num_digits < 768 {
    d.digits[d.num_digits] = digit
  }
  d.num_digits += 1
}

// decimal_seq.rs:79
@noalloc
fn trim(mut d: DecimalSeq) -> () uses {} {
  while d.num_digits != 0 && d.digits[d.num_digits - 1] == 0 {
    d.num_digits -= 1
  }
}

// decimal_seq.rs:93: the integer part, rounded half to even (a truncated tail
// breaks the tie upward); saturates at 19 integer digits.
@noalloc
pub fn round(d: DecimalSeq) -> u64 uses {} {
  if d.num_digits == 0 || d.decimal_point < 0 {
    return 0
  }
  if d.decimal_point >= 19 {
    return 18446744073709551615
  }
  let dp: u64 = core@1/int.narrow(d.decimal_point)
  let mut n: u64 = 0
  let mut i: u64 = 0
  while i < dp {
    n *= 10
    if i < d.num_digits {
      n += core@1/int.widen(d.digits[i])
    }
    i += 1
  }
  let mut round_up = false
  if dp < d.num_digits {
    round_up = d.digits[dp] >= 5
    if d.digits[dp] == 5 && dp + 1 == d.num_digits {
      round_up = d.truncated || dp != 0 && d.digits[dp - 1] & 1 != 0
    }
  }
  if round_up {
    n += 1
  }
  n
}

// decimal_seq.rs:302 number_of_digits_decimal_left_shift: the digits a left
// shift adds, by comparing the leading digits with 5^shift.
@noalloc
fn left_shift_digits(d: DecimalSeq, shift: u64) -> u64 uses {} {
  let x_a = LEFT_SHIFT[shift & 63]
  let x_b = LEFT_SHIFT[(shift & 63) + 1]
  let num_new_digits = x_a >> 11
  let pow5_a = x_a & 2047
  let pow5_b = x_b & 2047
  let mut i: u64 = 0
  while i < pow5_b - pow5_a {
    let p5 = LEFT_SHIFT_POW5[pow5_a + i]
    if i >= d.num_digits || d.digits[i] < p5 {
      return num_new_digits - 1
    }
    if d.digits[i] > p5 {
      return num_new_digits
    }
    i += 1
  }
  num_new_digits
}

// decimal_seq.rs:126: multiply by 2^shift, shift <= 60.
@noalloc
pub fn left_shift(mut d: DecimalSeq, shift: u64) -> () uses {} {
  if d.num_digits == 0 {
    return
  }
  let num_new_digits = left_shift_digits(d, shift)
  let mut read_index: u64 = copy d.num_digits
  let mut write_index = read_index + num_new_digits
  let mut n: u64 = 0
  while read_index != 0 {
    read_index -= 1
    write_index -= 1
    let digit: u64 = core@1/int.widen(d.digits[read_index])
    n += digit << shift
    let quotient = n / 10
    let remainder = n - 10 * quotient
    if write_index < 768 {
      d.digits[write_index] = core@1/int.narrow(remainder)
    } else if remainder > 0 {
      d.truncated = true
    }
    n = quotient
  }
  while n > 0 {
    write_index -= 1
    let quotient = n / 10
    let remainder = n - 10 * quotient
    if write_index < 768 {
      d.digits[write_index] = core@1/int.narrow(remainder)
    } else if remainder > 0 {
      d.truncated = true
    }
    n = quotient
  }
  d.num_digits += num_new_digits
  if d.num_digits > 768 {
    d.num_digits = 768
  }
  let added: i32 = core@1/int.narrow(num_new_digits)
  d.decimal_point += added
  trim(mut d)
}

// decimal_seq.rs:172: divide by 2^shift, shift <= 60.
@noalloc
pub fn right_shift(mut d: DecimalSeq, shift: u64) -> () uses {} {
  let mut read_index: u64 = 0
  let mut write_index: u64 = 0
  let mut n: u64 = 0
  while n >> shift == 0 {
    if read_index < d.num_digits {
      n = 10 * n + core@1/int.widen(d.digits[read_index])
      read_index += 1
    } else if n == 0 {
      return
    } else {
      while n >> shift == 0 {
        n *= 10
        read_index += 1
      }
      break
    }
  }
  let read: i32 = core@1/int.narrow(read_index)
  d.decimal_point -= read - 1
  if d.decimal_point < -2047 {
    d.num_digits = 0
    d.decimal_point = 0
    d.truncated = false
    return
  }
  let mask = (1u64 << shift) - 1
  while read_index < d.num_digits {
    let new_digit = n >> shift
    n = 10 * (n & mask) + core@1/int.widen(d.digits[read_index])
    read_index += 1
    d.digits[write_index] = core@1/int.narrow(new_digit)
    write_index += 1
  }
  while n > 0 {
    let new_digit = n >> shift
    n = 10 * (n & mask)
    if write_index < 768 {
      d.digits[write_index] = core@1/int.narrow(new_digit)
      write_index += 1
    } else if new_digit > 0 {
      d.truncated = true
    }
  }
  d.num_digits = write_index
  trim(mut d)
}

// The exact decimal expansion of mantissa * 2^exponent, for fixed-precision
// formatting (not part of Rust's DecimalSeq). Words of nine decimal digits hold
// mantissa * 2^exponent, or mantissa * 5^-exponent with the decimal point moved
// left, multiplied by 2^63 or 5^27 a pass as Rust flt2dec dragon's mul_pow10
// multiplies its bignum by small powers (imp/flt2dec/strategy/dragon.rs:64): nine
// digits a step where right_shift moves one; 86 words hold the 767 significant
// digits of any binary64. Digits below 10^-(places + 1) are dropped, setting
// truncated when one is nonzero, so rounding at `places` fractional digits stays
// exact. An exponent of at most 60 bits is one left_shift or right_shift of the
// mantissa's digits instead, keeping every digit.
@noalloc
pub fn exact(mantissa: u64, exponent: i32, places: i64) -> DecimalSeq uses {} {
  let mut d = empty()
  if mantissa == 0 {
    return d
  }
  let mut words: Inline[u64, 90] = [0u64; 90]
  let mut used: u64 = 0
  let mut rest = mantissa
  while rest != 0 {
    words[used] = rest % 1000000000
    used += 1
    rest /= 1000000000
  }
  let negative = exponent < 0
  let magnitude: i32 = if negative {
    -exponent
  } else {
    exponent
  }
  let shifted = magnitude <= 60
  let mut remaining: u64 = if shifted {
    0
  } else {
    core@1/int.narrow(magnitude)
  }
  let base: u64 = if negative {
    5
  } else {
    2
  }
  let chunk: u64 = if negative {
    27
  } else {
    63
  }
  while remaining > 0 {
    let step = if remaining < chunk {
      remaining
    } else {
      chunk
    }
    // 5^27 and 2^63 are the largest powers below 2^64.
    let mut factor: u64 = if negative {
      7450580596923828125
    } else {
      9223372036854775808
    }
    if step < chunk {
      factor = 1
      let mut k: u64 = 0
      while k < step {
        factor *= base
        k += 1
      }
    }
    let wide_factor: u128 = core@1/int.widen(factor)
    let mut carry: u128 = 0
    let mut i: u64 = 0
    while i < used {
      let word: u128 = core@1/int.widen(words[i])
      let product = word * wide_factor + carry
      words[i] = core@1/int.narrow(product % 1000000000)
      carry = product / 1000000000
      i += 1
    }
    while carry != 0 {
      words[used] = core@1/int.narrow(carry % 1000000000)
      carry /= 1000000000
      used += 1
    }
    remaining -= step
  }
  let mut top_digits: u64 = 0
  let mut top = words[used - 1]
  while top != 0 {
    top /= 10
    top_digits += 1
  }
  let count = (used - 1) * 9 + top_digits
  let count_i: i32 = core@1/int.narrow(count)
  d.decimal_point = if negative && !shifted {
    count_i + exponent
  } else {
    count_i
  }
  let wanted: i64 = core@1/int.widen(d.decimal_point)
  let wanted_digits = wanted + places + 1
  let keep: u64 = if shifted || wanted_digits >= core@1/int.narrow(count) {
    count
  } else if wanted_digits < 0 {
    0
  } else {
    core@1/int.narrow(wanted_digits)
  }
  // Unpack from the least significant word; a word wholly below the kept digits
  // only records whether it is nonzero.
  let mut at = count
  let mut i: u64 = 0
  while i < used {
    let mut word = words[i]
    let digits: u64 = if i + 1 == used {
      top_digits
    } else {
      9
    }
    if at - digits >= keep {
      d.truncated = d.truncated || word != 0
      at -= digits
    } else {
      let mut k: u64 = 0
      while k < digits {
        at -= 1
        let digit: u8 = core@1/int.narrow(word % 10)
        if at < keep {
          d.digits[at] = digit
        } else {
          d.truncated = d.truncated || digit != 0
        }
        word /= 10
        k += 1
      }
    }
    i += 1
  }
  d.num_digits = keep
  trim(mut d)
  if shifted && negative {
    right_shift(mut d, core@1/int.narrow(magnitude))
  } else if shifted && magnitude > 0 {
    left_shift(mut d, core@1/int.narrow(magnitude))
  }
  d
}
