// Rust alloc/src/io/buffered/bufreader.rs fill_buf/consume and
// alloctests/tests/io/buffered.rs delimiter/line vectors, f6c1107f.
// Borrowed peek/consume: Go ebe2feef src/bufio/bufio.go:135-210 and
// Rust 19833af7 library/alloc/src/io/buf_read.rs:57-110.
// Unlike those APIs peek never refills; consume keeps Hirsel's clamping contract.
@serializable
pub type ReadError[E] = Source(E) | Limit | UnexpectedEof | InvalidUtf8 | InvalidRead

pub opaque type Reader: copyable + inert + noalloc_drop uses {} {
  input: Bytes,
  offset: u64,
  capacity: u64,
}

pub fn new(capacity: u64) -> Reader uses {} {
  Reader(
    input: b"",
    offset: 0,
    capacity: if capacity == 0 {
      1
    } else {
      capacity
    }
  )
}

pub fn buffered(r: Reader) -> u64 uses {} {
  core@1/bytes.len(r.input) - r.offset
}

/// Borrows at most `max` unread bytes without refilling or advancing `r`.
pub fn peek(r: Reader, max: u64) -> Bytes in r uses {} {
  let have = buffered(r)
  let count = if max < have {
    max
  } else {
    have
  }
  core@1/bytes.slice(r.input, r.offset, r.offset + count)
}

/// An independent owned snapshot; use `peek` to inspect without copying.
pub fn contents(r: Reader) -> unique Bytes uses {} {
  unique peek(r, buffered(r))
}

@preserves_captures(r)
pub fn consume(mut r: Reader, count: u64) -> () uses {} {
  let have = buffered(r)
  r.offset += if count < have {
    count
  } else {
    have
  }
}

pub fn read_more[S, E](
  mut r: Reader,
  mut source: S,
  refill: fn(mut S, mut List[u8], u64) -> Result[u64, E],
  max: u64
) -> Result[u64, ReadError[E]] uses {refill} {
  if max == 0 {
    return Ok(0)
  }
  let mut unread: List[u8] = []
  let mut i = r.offset
  while i < core@1/bytes.len(r.input) {
    core@1/list.push(mut unread, r.input[i])
    i += 1
  }
  let previous_len = core@1/list.len(unread)
  let limit = if max < r.capacity {
    max
  } else {
    r.capacity
  }
  let filled = refill(mut source, mut unread, limit)
  r.input = core@1/bytes.from_list(take unread)
  r.offset = 0
  let n = filled?
  let current_len = core@1/bytes.len(r.input)
  if current_len < previous_len || current_len - previous_len != n || n > limit {
    return Error(InvalidRead())
  }
  Ok(n)
}

fn fill[S, E](
  mut r: Reader,
  mut source: S,
  refill: fn(mut S, mut List[u8], u64) -> Result[u64, E]
) -> Result[u64, ReadError[E]] uses {refill} {
  if buffered(r) != 0 {
    return Ok(buffered(r))
  }
  let capacity = r.capacity
  read_more(mut r, mut source, refill, capacity)
}

@preserves_unique(out)
pub fn read[S, E](
  mut r: Reader,
  mut source: S,
  refill: fn(mut S, mut List[u8], u64) -> Result[u64, E],
  mut out: List[u8],
  max: u64
) -> Result[u64, ReadError[E]] uses {refill} {
  if max == 0 {
    return Ok(0)
  }
  let have = fill(mut r, mut source, refill)?
  let count = if have < max {
    have
  } else {
    max
  }
  let mut i: u64 = 0
  while i < count {
    core@1/list.push(mut out, r.input[r.offset])
    r.offset += 1
    i += 1
  }
  Ok(count)
}

@preserves_unique(out)
pub fn read_exact[S, E](
  mut r: Reader,
  mut source: S,
  refill: fn(mut S, mut List[u8], u64) -> Result[u64, E],
  mut out: List[u8],
  count: u64
) -> Result[(), ReadError[E]] uses {refill} {
  let mut remaining = count
  while remaining != 0 {
    let n = read(mut r, mut source, refill, mut out, remaining)?
    if n == 0 {
      return Error(UnexpectedEof())
    }
    remaining -= n
  }
  Ok(())
}

@preserves_unique(out)
pub fn read_until[S, E](
  mut r: Reader,
  mut source: S,
  refill: fn(mut S, mut List[u8], u64) -> Result[u64, E],
  delimiter: u8,
  mut out: List[u8],
  limit: u64
) -> Result[u64, ReadError[E]] uses {refill} {
  if limit == 0 {
    return Error(Limit())
  }
  let mut total: u64 = 0
  while true {
    if fill(mut r, mut source, refill)? == 0 {
      return Ok(total)
    }
    if total == limit {
      return Error(Limit())
    }
    let remaining = limit - total
    let have = buffered(r)
    let available = if have < remaining {
      have
    } else {
      remaining
    }
    let mut count: u64 = 0
    let mut done = false
    while count < available {
      let b = r.input[r.offset + count]
      core@1/list.push(mut out, b)
      count += 1
      if b == delimiter {
        done = true
        break
      }
    }
    r.offset += count
    total += count
    if done {
      return Ok(total)
    }
  }
  Ok(total)
}

pub fn read_line[S, E](
  mut r: Reader,
  mut source: S,
  refill: fn(mut S, mut List[u8], u64) -> Result[u64, E],
  limit: u64
) -> Result[Option[unique String], ReadError[E]] uses {refill} {
  let mut out: List[u8] = []
  if read_until(mut r, mut source, refill, 10u8, mut out, limit)? == 0 {
    return Ok(None())
  }
  match core@1/string.from_bytes(core@1/bytes.from_list(take out)) {
    Ok(text) => Ok(Some(take text)),
    Error(_) => Error(InvalidUtf8()),
  }
}

@preserves_unique(out)
pub fn stream_read_until(
  n: Net,
  mut s: Stream of n,
  mut r: Reader,
  delimiter: u8,
  mut out: List[u8],
  limit: u64
) -> Result[u64, ReadError[NetError]] {
  read_until(
    mut r,
    mut s,
    fn(mut stream: Stream of n, mut buffer: List[u8], requested: u64) -> Result[
      u64,
      NetError
    ] {
      core@1/net.read(n, mut stream, mut buffer, requested)
    },
    delimiter,
    mut out,
    limit
  )
}

@preserves_captures(s, r)
pub fn stream_read_more(n: Net, mut s: Stream of n, mut r: Reader, max: u64) -> Result[
  u64,
  ReadError[NetError]
] {
  if max == 0 {
    return Ok(0)
  }
  let mut unread: List[u8] = []
  let mut i = r.offset
  while i < core@1/bytes.len(r.input) {
    core@1/list.push(mut unread, r.input[i])
    i += 1
  }
  let limit = if max < r.capacity {
    max
  } else {
    r.capacity
  }
  let filled = core@1/net.read(n, mut s, mut unread, limit)
  r.input = core@1/bytes.from_list(take unread)
  r.offset = 0
  let count = filled ? Source
  Ok(count)
}

@preserves_unique(out)
pub fn stream_read_exact(
  n: Net,
  mut s: Stream of n,
  mut r: Reader,
  mut out: List[u8],
  count: u64
) -> Result[(), ReadError[NetError]] {
  read_exact(
    mut r,
    mut s,
    fn(mut stream: Stream of n, mut buffer: List[u8], requested: u64) -> Result[
      u64,
      NetError
    ] {
      core@1/net.read(n, mut stream, mut buffer, requested)
    },
    mut out,
    count
  )
}

pub fn stream_read_line(n: Net, mut s: Stream of n, mut r: Reader, limit: u64) -> Result[
  Option[unique String],
  ReadError[NetError]
] {
  read_line(
    mut r,
    mut s,
    fn(mut stream: Stream of n, mut buffer: List[u8], requested: u64) -> Result[
      u64,
      NetError
    ] {
      core@1/net.read(n, mut stream, mut buffer, requested)
    },
    limit
  )
}

@preserves_unique(out)
pub fn stream_read(
  n: Net,
  mut s: Stream of n,
  mut r: Reader,
  mut out: List[u8],
  max: u64
) -> Result[u64, ReadError[NetError]] {
  read(
    mut r,
    mut s,
    fn(mut stream: Stream of n, mut buffer: List[u8], requested: u64) -> Result[
      u64,
      NetError
    ] {
      core@1/net.read(n, mut stream, mut buffer, requested)
    },
    mut out,
    max
  )
}

@preserves_unique(out)
pub fn file_read_until(
  d: Dir,
  mut f: File of d,
  mut r: Reader,
  delimiter: u8,
  mut out: List[u8],
  limit: u64
) -> Result[u64, ReadError[FileError]] {
  read_until(
    mut r,
    mut f,
    fn(mut source: File of d, mut buffer: List[u8], requested: u64) -> Result[
      u64,
      FileError
    ] {
      core@1/file.read(d, mut source, mut buffer, requested)
    },
    delimiter,
    mut out,
    limit
  )
}

pub fn file_read_more(d: Dir, mut f: File of d, mut r: Reader, max: u64) -> Result[
  u64,
  ReadError[FileError]
] {
  read_more(
    mut r,
    mut f,
    fn(mut source: File of d, mut buffer: List[u8], requested: u64) -> Result[
      u64,
      FileError
    ] {
      core@1/file.read(d, mut source, mut buffer, requested)
    },
    max
  )
}

@preserves_unique(out)
pub fn file_read_exact(
  d: Dir,
  mut f: File of d,
  mut r: Reader,
  mut out: List[u8],
  count: u64
) -> Result[(), ReadError[FileError]] {
  read_exact(
    mut r,
    mut f,
    fn(mut source: File of d, mut buffer: List[u8], requested: u64) -> Result[
      u64,
      FileError
    ] {
      core@1/file.read(d, mut source, mut buffer, requested)
    },
    mut out,
    count
  )
}

pub fn file_read_line(d: Dir, mut f: File of d, mut r: Reader, limit: u64) -> Result[
  Option[unique String],
  ReadError[FileError]
] {
  read_line(
    mut r,
    mut f,
    fn(mut source: File of d, mut buffer: List[u8], requested: u64) -> Result[
      u64,
      FileError
    ] {
      core@1/file.read(d, mut source, mut buffer, requested)
    },
    limit
  )
}

@preserves_unique(out)
pub fn file_read(d: Dir, mut f: File of d, mut r: Reader, mut out: List[u8], max: u64) -> Result[
  u64,
  ReadError[FileError]
] {
  read(
    mut r,
    mut f,
    fn(mut source: File of d, mut buffer: List[u8], requested: u64) -> Result[
      u64,
      FileError
    ] {
      core@1/file.read(d, mut source, mut buffer, requested)
    },
    mut out,
    max
  )
}

// Stdin is a borrowed, copyable capability token rather than mutable source
// state, so these adapters hold a local copy as the refill's source.
@preserves_unique(out)
pub fn stdin_read_until(
  s: Stdin,
  mut r: Reader,
  delimiter: u8,
  mut out: List[u8],
  limit: u64
) -> Result[u64, ReadError[InputError]] {
  let mut source = s
  read_until(
    mut r,
    mut source,
    fn(mut input: Stdin, mut buffer: List[u8], requested: u64) -> Result[
      u64,
      InputError
    ] {
      core@1/stdin.read(input, mut buffer, requested)
    },
    delimiter,
    mut out,
    limit
  )
}

pub fn stdin_read_more(s: Stdin, mut r: Reader, max: u64) -> Result[
  u64,
  ReadError[InputError]
] {
  let mut source = s
  read_more(
    mut r,
    mut source,
    fn(mut input: Stdin, mut buffer: List[u8], requested: u64) -> Result[
      u64,
      InputError
    ] {
      core@1/stdin.read(input, mut buffer, requested)
    },
    max
  )
}

@preserves_unique(out)
pub fn stdin_read_exact(s: Stdin, mut r: Reader, mut out: List[u8], count: u64) -> Result[
  (),
  ReadError[InputError]
] {
  let mut source = s
  read_exact(
    mut r,
    mut source,
    fn(mut input: Stdin, mut buffer: List[u8], requested: u64) -> Result[
      u64,
      InputError
    ] {
      core@1/stdin.read(input, mut buffer, requested)
    },
    mut out,
    count
  )
}

pub fn stdin_read_line(s: Stdin, mut r: Reader, limit: u64) -> Result[
  Option[unique String],
  ReadError[InputError]
] {
  let mut source = s
  read_line(
    mut r,
    mut source,
    fn(mut input: Stdin, mut buffer: List[u8], requested: u64) -> Result[
      u64,
      InputError
    ] {
      core@1/stdin.read(input, mut buffer, requested)
    },
    limit
  )
}

@preserves_unique(out)
pub fn stdin_read(s: Stdin, mut r: Reader, mut out: List[u8], max: u64) -> Result[
  u64,
  ReadError[InputError]
] {
  let mut source = s
  read(
    mut r,
    mut source,
    fn(mut input: Stdin, mut buffer: List[u8], requested: u64) -> Result[
      u64,
      InputError
    ] {
      core@1/stdin.read(input, mut buffer, requested)
    },
    mut out,
    max
  )
}

// Go ebe2feefc400f813aefdc8a036e66d2619da6649 src/bufio/bufio.go:634-655:
// commit successful prefixes and retain the unwritten suffix on failure.
// Admission copies min(Available(), len(data)) as in Go Write:676-697;
// Buffered/Available:658-670. Rust f6c1107f library/alloc/src/io/buffered/
// bufwriter.rs:208-277 supplies the positive-short-write loop and WriteZero.
// Unlike Go, admission never writes and errors are retryable rather than sticky.
// Commit the cursor after each success, so no deferred cleanup is needed on
// failure; there is no destructor callback to repeat a write after unwinding.
@serializable
pub type WriteError[E] = Sink(E) | WriteZero | InvalidWrite

pub opaque type Writer: () uses {} {
  pending: unique List[u8],
  start: u64,
  end: u64,
}

/// Fixed pending-payload capacity; zero is normalized to one.
pub fn new_writer(capacity: u64) -> unique Writer uses {} {
  let size = if capacity == 0 {
    1u64
  } else {
    capacity
  }
  let mut pending: unique List[u8] = []
  core@1/list.reserve(mut pending, size)
  for i in 0u64..size {
    core@1/list.push(mut pending, 0u8)
  }
  Writer(pending: take pending, start: 0, end: 0)
}

pub fn buffered_len(w: Writer) -> u64 uses {} {
  w.end - w.start
}

/// Accept only the available prefix; never call a sink. Reclaim committed space.
pub fn write_buffered(mut w: unique Writer, data: Bytes) -> u64 uses {} {
  let have = buffered_len(w)
  let available = core@1/list.len(w.pending) - have
  let count = if core@1/bytes.len(data) < available {
    core@1/bytes.len(data)
  } else {
    available
  }
  if count == 0 {
    return 0
  }
  if w.start != 0 {
    for i in 0u64..have {
      let byte = w.pending[w.start + i]
      w.pending[i] = byte
    }
    w.start = 0
    w.end = have
  }
  for i in 0u64..count {
    w.pending[w.end + i] = data[i]
  }
  w.end += count
  count
}

/// The callback borrows initialized storage, offering only [start,end).
/// Ok(n) commits exactly that prefix; Error(e) must accept no bytes this call.
/// A successful short write is retried. No empty callback, hidden error or drop I/O.
pub fn flush[S, E](
  mut w: unique Writer,
  mut sink: S,
  write: fn(mut S, List[u8], u64, u64) -> Result[u64, E]
) -> Result[(), WriteError[E]] uses {write} {
  while w.start < w.end {
    let count = write(mut sink, w.pending, w.start, w.end) ? Sink
    if count == 0 {
      return Error(WriteZero())
    }
    if count > w.end - w.start {
      return Error(InvalidWrite())
    }
    w.start += count
  }
  w.start = 0
  w.end = 0
  Ok(())
}
