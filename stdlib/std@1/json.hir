// JSON DOM contracts: STD-OP-json.* and TYPE-ROW-Value/JsonError.
@serializable
pub type Value = Null | Bool(bool) | Number(String) | Text(String) | Array(List[Value]) | Object(
  Map[String, Value]
)

@serializable
pub type JsonError = Syntax(u64) | DuplicateKey(u64) | Nesting(u64) | InvalidNumber

// serde_json read.rs:521-566 / ESCAPE: controls, quote and backslash end a plain run.
// The shared byte scanner leaves UTF-8 bytes and every other byte untouched.
const JSON_STRING_STOP: Bytes = b"\x00\x01\x02\x03\x04\x05\x06\x07\x08\x09\x0a\x0b\x0c\x0d\x0e\x0f\x10\x11\x12\x13\x14\x15\x16\x17\x18\x19\x1a\x1b\x1c\x1d\x1e\x1f\"\\"

// Complement of serde_json de.rs:255 whitespace; bulk scan preserves byte offsets.
const JSON_NON_WHITESPACE: Bytes = b"\x00\x01\x02\x03\x04\x05\x06\x07\x08\x0b\x0c\x0e\x0f\x10\x11\x12\x13\x14\x15\x16\x17\x18\x19\x1a\x1b\x1c\x1d\x1e\x1f\x21\x22\x23\x24\x25\x26\x27\x28\x29\x2a\x2b\x2c\x2d\x2e\x2f\x30\x31\x32\x33\x34\x35\x36\x37\x38\x39\x3a\x3b\x3c\x3d\x3e\x3f\x40\x41\x42\x43\x44\x45\x46\x47\x48\x49\x4a\x4b\x4c\x4d\x4e\x4f\x50\x51\x52\x53\x54\x55\x56\x57\x58\x59\x5a\x5b\x5c\x5d\x5e\x5f\x60\x61\x62\x63\x64\x65\x66\x67\x68\x69\x6a\x6b\x6c\x6d\x6e\x6f\x70\x71\x72\x73\x74\x75\x76\x77\x78\x79\x7a\x7b\x7c\x7d\x7e\x7f\x80\x81\x82\x83\x84\x85\x86\x87\x88\x89\x8a\x8b\x8c\x8d\x8e\x8f\x90\x91\x92\x93\x94\x95\x96\x97\x98\x99\x9a\x9b\x9c\x9d\x9e\x9f\xa0\xa1\xa2\xa3\xa4\xa5\xa6\xa7\xa8\xa9\xaa\xab\xac\xad\xae\xaf\xb0\xb1\xb2\xb3\xb4\xb5\xb6\xb7\xb8\xb9\xba\xbb\xbc\xbd\xbe\xbf\xc0\xc1\xc2\xc3\xc4\xc5\xc6\xc7\xc8\xc9\xca\xcb\xcc\xcd\xce\xcf\xd0\xd1\xd2\xd3\xd4\xd5\xd6\xd7\xd8\xd9\xda\xdb\xdc\xdd\xde\xdf\xe0\xe1\xe2\xe3\xe4\xe5\xe6\xe7\xe8\xe9\xea\xeb\xec\xed\xee\xef\xf0\xf1\xf2\xf3\xf4\xf5\xf6\xf7\xf8\xf9\xfa\xfb\xfc\xfd\xfe\xff"

// Policy counts open arrays/objects; scalars do not consume a level.
pub const MAX_NESTING: u64 = 128

// Adapted serde_json src/de.rs peek_or_null,
// commit 20572a6d066958542d79cdd6cf1a7cd9f0c8e1f8: EOF is the zero sentinel.
@noalloc
fn json_peek(data: Bytes, pos: u64) -> u8 uses {} {
  if pos < core@1/bytes.len(data) {
    data[pos]
  } else {
    0
  }
}

// Adapted serde_json src/de.rs parse_whitespace,
// commit 20572a6d066958542d79cdd6cf1a7cd9f0c8e1f8.
@noalloc
fn json_whitespace(data: Bytes, mut pos: u64) -> u8 uses {} {
  let size = core@1/bytes.len(data)
  // Public Reader cursors may be outside the extent; leave them unchanged.
  if pos >= size {
    return 0
  }
  // serde_json's cached lookahead: compact JSON usually has no whitespace.
  // Avoid constructing a wide membership table at every token boundary.
  let byte = data[pos]
  if byte > 32 {
    return byte
  }
  if byte != 32 && byte != 9 && byte != 10 && byte != 13 {
    return byte
  }
  pos = core@1/bytes.find_any(data, JSON_NON_WHITESPACE, pos + 1)
  if pos < size {
    data[pos]
  } else {
    0
  }
}

// Adapted serde_json src/de.rs parse_integer/parse_decimal/parse_exponent,
// commit 20572a6d066958542d79cdd6cf1a7cd9f0c8e1f8 (MIT/Apache-2.0).
// Scan grammar only: no float conversion, overflow, or loss of number spelling.
@noalloc
fn json_number_end(data: Bytes, mut pos: u64) -> Result[(), JsonError] uses {} {
  let (end, valid) = core@1/bytes.json_number_end(data, pos)
  pos = end
  if valid == 0 {
    Error(Syntax(pos))
  } else {
    Ok(())
  }
}

// An explicitly owned decoder token has independent, exact-length storage.
fn json_owned_text(data: Bytes, start: u64, end: u64) -> String uses {} {
  let mut output: List[u8] = []
  core@1/bytes.append(mut output, core@1/bytes.slice(data, start, end))
  match text.finish(take output) {
    Ok(s) => s,
    Error(_) => {
      core@1/failure.check(false, TextInvariant())
      ""
    },
  }
}

// Tokens without escapes share the consumed input's immutable storage. Taking
// `data` makes the slice global; no borrow of the parser's stack escapes.
fn json_shared_text(take data: Bytes, start: u64, end: u64) -> String uses {} {
  let token = core@1/bytes.slice(data, start, end)
  match core@1/string.from_bytes(copy token) {
    Ok(s) => take s,
    Error(_) => {
      core@1/failure.check(false, TextInvariant())
      ""
    },
  }
}

// Adapted serde_json src/read.rs decode_hex_escape/decode_four_hex_digits,
// commit 20572a6d066958542d79cdd6cf1a7cd9f0c8e1f8: safe bytewise accumulation.
@noalloc
fn json_hex4(data: Bytes, mut pos: u64) -> Result[u64, JsonError] uses {} {
  let mut n: u64 = 0
  let mut i: u64 = 0
  while i < 4 {
    let c = json_peek(data, pos)
    let Some(digit) = std@1/ascii.digit_value_radix(c, 16) else {
      return Error(Syntax(pos))
    }
    let d: u64 = core@1/int.widen(digit)
    n = n * 16 + d
    pos += 1
    i += 1
  }
  Ok(n)
}

// The owning DOM parser can retain a plain token as a slice. Escaped text
// uses the same decoder as the borrowed pull reader.
fn json_shared_quoted(take data: Bytes, mut pos: u64) -> Result[String, JsonError] uses {} {
  let start = pos + 1
  let end = core@1/bytes.find_any(data, JSON_STRING_STOP, start)
  if end < core@1/bytes.len(data) && data[end] == 34 {
    pos = end + 1
    return Ok(json_shared_text(copy data, start, end))
  }
  Ok(json_quoted(data, mut pos)?)
}

// Shared strict escape/surrogate transitions. Adapted serde_json read.rs:925-1033,
// 8c535a260ce561eaab4111aafc29038eb9f77ff3 (MIT OR Apache-2.0).
// Keep Hirsel's existing byte offsets and cursor advancement; no WTF-8 mode.
fn json_escape(data: Bytes, mut pos: u64) -> Result[char, JsonError] uses {} {
  if pos == core@1/bytes.len(data) {
    return Error(Syntax(pos))
  }
  let e = data[pos]
  pos += 1
  if e == 34 || e == 92 || e == 47 {
    return Ok(char.from_u8(e))
  } else if e == 98 {
    return Ok(char.from_u8(8))
  } else if e == 102 {
    return Ok(char.from_u8(12))
  } else if e == 110 {
    return Ok(char.from_u8(10))
  } else if e == 114 {
    return Ok(char.from_u8(13))
  } else if e == 116 {
    return Ok(char.from_u8(9))
  } else if e == 117 {
    let mut n = json_hex4(data, mut pos)?
    if n >= 56320 && n <= 57343 {
      return Error(Syntax(pos - 4))
    }
    if n >= 55296 && n <= 56319 {
      if json_peek(data, pos) != 92 {
        return Error(Syntax(pos))
      }
      pos += 1
      if json_peek(data, pos) != 117 {
        return Error(Syntax(pos))
      }
      pos += 1
      let low = json_hex4(data, mut pos)?
      if low < 56320 || low > 57343 {
        return Error(Syntax(pos - 4))
      }
      n = 65536 + (n - 55296) * 1024 + low - 56320
    }
    // The surrogate checks above leave a scalar value.
    match core@1/char.from_u32(core@1/int.narrow(n)) {
      Some(scalar) => return Ok(scalar),
      None() => core@1/failure.check(false, TextInvariant()),
    }
  } else {
    return Error(Syntax(pos - 1))
  }
  Ok('\0')
}

// Adapted serde_json src/read.rs parse_str_bytes/parse_escape/parse_unicode_escape,
// commit 20572a6d066958542d79cdd6cf1a7cd9f0c8e1f8. Strict UTF-8 mode only.
fn json_quoted(data: Bytes, mut pos: u64) -> Result[unique String, JsonError] uses {} {
  if json_peek(data, pos) != 34 {
    return Error(Syntax(pos))
  }
  pos += 1
  let plain_start = pos
  pos = core@1/bytes.find_any(data, JSON_STRING_STOP, pos)
  if pos < core@1/bytes.len(data) && data[pos] == 34 {
    let value = json_owned_text(data, plain_start, pos)
    pos += 1
    return Ok(take value)
  }
  let mut output: List[u8] = []
  core@1/bytes.append(mut output, core@1/bytes.slice(data, plain_start, pos))
  while pos < core@1/bytes.len(data) {
    let c = data[pos]
    pos += 1
    if c == 34 {
      return match text.finish(take output) {
        Ok(s) => Ok(s),
        Error(_) => Error(Syntax(pos)),
      }
    }
    if c < 32 {
      return Error(Syntax(pos - 1))
    }
    if c != 92 {
      let start = pos - 1
      pos = core@1/bytes.find_any(data, JSON_STRING_STOP, pos)
      core@1/bytes.append(mut output, core@1/bytes.slice(data, start, pos))
    } else {
      char.format_into(json_escape(data, mut pos)?, mut output)
    }
  }
  Error(Syntax(pos))
}

@noalloc
// Adapted serde_json src/de.rs parse_ident,
// commit 20572a6d066958542d79cdd6cf1a7cd9f0c8e1f8.
fn json_keyword(data: Bytes, mut pos: u64, word: String) -> Result[(), JsonError] uses {} {
  let bytes = core@1/string.as_bytes(word)
  let mut i: u64 = 0
  while i < core@1/bytes.len(bytes) {
    if pos == core@1/bytes.len(data) || data[pos] != bytes[i] {
      return Error(Syntax(pos))
    }
    pos += 1
    i += 1
  }
  Ok(())
}

// Adapted serde_json src/de.rs deserialize_any/SeqAccess/MapAccess at
// 20572a6d066958542d79cdd6cf1a7cd9f0c8e1f8; Zig lib/std/json/dynamic.zig
// handleCompleteValue at bff490a23889750de7096d9057c0a432efc929a8 supplies
// ordered-object duplicate rejection. Ordinary owned locals clean up on every ?.
// Pass the already scanned lookahead into each child. Like serde SeqAccess,
// each token boundary consumes whitespace once, including empty containers.
fn json_node(take data: Bytes, mut pos: u64, depth: u64, c: u8) -> Result[
  Value,
  JsonError
] uses {} {
  match c {
    110 => {
      json_keyword(data, mut pos, "null")?
      return Ok(Null())
    },
    116 => {
      json_keyword(data, mut pos, "true")?
      return Ok(Bool(true))
    },
    102 => {
      json_keyword(data, mut pos, "false")?
      return Ok(Bool(false))
    },
    34 => return Ok(Text(json_shared_quoted(copy data, mut pos)?)),
    91 => (),
    123 => (),
    _ => {
      if c != 45 && (c < 48 || c > 57) {
        return Error(Syntax(pos))
      }
      let start = pos
      json_number_end(data, mut pos)?
      return Ok(Number(json_shared_text(copy data, start, pos)))
    },
  }
  if depth == MAX_NESTING {
    return Error(Nesting(pos))
  }
  pos += 1
  let mut next = json_whitespace(data, mut pos)
  if c == 91 {
    let mut items: List[Value] = []
    if next == 93 {
      pos += 1
      let array_value: Value = Array(take items)
      return Ok(take array_value)
    }
    while true {
      let child = json_node(copy data, mut pos, depth + 1, next)?
      core@1/list.push(mut items, take child)
      next = json_whitespace(data, mut pos)
      if next == 93 {
        pos += 1
        break
      }
      if next != 44 {
        return Error(Syntax(pos))
      }
      pos += 1
      next = json_whitespace(data, mut pos)
    }
    let array_value: Value = Array(take items)
    return Ok(take array_value)
  }
  let mut entries: Map[String, Value] = core@1/map.empty()
  if next == 125 {
    pos += 1
    return Ok(Object(take entries))
  }
  while true {
    if next != 34 {
      return Error(Syntax(pos))
    }
    let key_pos = pos
    let key = json_shared_quoted(copy data, mut pos)?
    if let Some(_) = core@1/map.get(entries, key) {
      return Error(DuplicateKey(key_pos))
    }
    if json_whitespace(data, mut pos) != 58 {
      return Error(Syntax(pos))
    }
    pos += 1
    let first = json_whitespace(data, mut pos)
    let child = json_node(copy data, mut pos, depth + 1, first)?
    core@1/map.insert(mut entries, take key, take child)
    next = json_whitespace(data, mut pos)
    if next == 125 {
      pos += 1
      break
    }
    if next != 44 {
      return Error(Syntax(pos))
    }
    pos += 1
    next = json_whitespace(data, mut pos)
  }
  Ok(Object(take entries))
}

// Adapted serde_json src/de.rs from_str/end,
// commit 20572a6d066958542d79cdd6cf1a7cd9f0c8e1f8.
// Hirsel takes the source, returns owned strings and lossless decimal lexemes.
pub fn parse(take text: String) -> Result[Value, JsonError] uses {} {
  let data = core@1/string.as_bytes(text)
  let mut pos: u64 = 0
  let first = json_whitespace(data, mut pos)
  let value = json_node(copy data, mut pos, 0, first)?
  json_whitespace(data, mut pos)
  if pos != core@1/bytes.len(data) {
    return Error(Syntax(pos))
  }
  Ok(take value)
}

// Adapted serde_json src/ser.rs format_escaped_str_contents at
// 20572a6d066958542d79cdd6cf1a7cd9f0c8e1f8. Compact ASCII escape spelling,
// preserving UTF-8 runs; no escaping of solidus or non-ASCII scalars.
@preserves_unique(builder)
pub fn write_text_into(text: String, mut builder: List[u8]) -> () uses {} {
  core@1/list.reserve(
    mut builder,
    core@1/list.len(builder) + core@1/string.byte_len(text) + 2
  )
  core@1/list.push(mut builder, 34)
  let data = core@1/string.as_bytes(text)
  let hex: Bytes = b"0123456789abcdef"
  let mut at: u64 = 0
  while at < core@1/bytes.len(data) {
    let c = data[at]
    at += 1
    if c == 34 || c == 92 {
      core@1/list.push(mut builder, 92)
      core@1/list.push(mut builder, c)
    } else if c < 32 {
      let short: u8 = if c == 8 {
        98
      } else if c == 9 {
        116
      } else if c == 10 {
        110
      } else if c == 12 {
        102
      } else if c == 13 {
        114
      } else {
        0
      }
      core@1/list.push(mut builder, 92)
      if short != 0 {
        core@1/list.push(mut builder, short)
      } else {
        core@1/list.push(mut builder, 117)
        core@1/list.push(mut builder, 48)
        core@1/list.push(mut builder, 48)
        core@1/list.push(mut builder, hex[core@1/int.widen(c >> 4)])
        core@1/list.push(mut builder, hex[core@1/int.widen(c & 15)])
      }
    } else {
      let start = at - 1
      at = core@1/bytes.find_any(data, JSON_STRING_STOP, at)
      core@1/bytes.append(mut builder, core@1/bytes.slice(data, start, at))
    }
  }
  core@1/list.push(mut builder, 34)
}

// Adapted serde_json src/ser.rs NumberStrEmitter/write_number_str,
// commit 20572a6d066958542d79cdd6cf1a7cd9f0c8e1f8; validate public Number strings.
fn json_write_number(text: String, mut builder: List[u8]) -> Result[(), JsonError] uses {} {
  let data = core@1/string.as_bytes(text)
  let mut pos: u64 = 0
  if let Error(_) = json_number_end(data, mut pos) {
    return Error(InvalidNumber())
  }
  if pos != core@1/bytes.len(data) {
    return Error(InvalidNumber())
  }
  text.append(mut builder, text)
  Ok(())
}

// Adapted serde_json src/ser.rs compact Serializer sequence/map dispatch,
// commit 20572a6d066958542d79cdd6cf1a7cd9f0c8e1f8.
// Matching borrows the DOM.
fn json_write_value(value: Value, mut builder: List[u8], depth: u64) -> Result[
  (),
  JsonError
] uses {} {
  match value {
    Null() => {
      text.append(mut builder, "null")
      Ok(())
    },
    Bool(b) => {
      text.append(
        mut builder,
        if b {
          "true"
        } else {
          "false"
        }
      )
      Ok(())
    },
    Number(n) => json_write_number(n, mut builder),
    Text(s) => {
      write_text_into(s, mut builder)
      Ok(())
    },
    Array(xs) => {
      if depth == MAX_NESTING {
        return Error(Nesting(depth))
      }
      core@1/list.push(mut builder, 91)
      let mut first: bool = true
      for item in xs {
        if !first {
          core@1/list.push(mut builder, 44)
        }
        first = false
        json_write_value(item, mut builder, depth + 1)?
      }
      core@1/list.push(mut builder, 93)
      Ok(())
    },
    Object(xs) => {
      if depth == MAX_NESTING {
        return Error(Nesting(depth))
      }
      core@1/list.push(mut builder, 123)
      let mut first: bool = true
      for (key, child) in xs {
        if !first {
          core@1/list.push(mut builder, 44)
        }
        first = false
        write_text_into(key, mut builder)
        core@1/list.push(mut builder, 58)
        json_write_value(child, mut builder, depth + 1)?
      }
      core@1/list.push(mut builder, 125)
      Ok(())
    },
  }
}

// Adapted serde_json src/ser.rs compact Serializer dispatch and sequence/map
// emission, commit 20572a6d066958542d79cdd6cf1a7cd9f0c8e1f8.
// Borrow input, append to the caller's counted builder, retain prefixes on error.
@preserves_unique(out)
pub fn stringify_into(value: Value, mut out: List[u8]) -> Result[(), JsonError] uses {} {
  json_write_value(value, mut out, 0)
}

// Adapted serde_json src/ser.rs to_string,
// commit 20572a6d066958542d79cdd6cf1a7cd9f0c8e1f8: one writer path.
pub fn stringify(value: Value) -> Result[unique String, JsonError] uses {} {
  let mut builder: List[u8] = []
  stringify_into(value, mut builder)?
  let built = text.finish(take builder)
  match take built {
    Ok(s) => Ok(take s),
    Error(_) => Error(InvalidNumber()),
  }
}

/// Check a writer's number of open containers, before writing its delimiter.
@noalloc
pub fn check_depth(depth: u64) -> Result[(), JsonError] uses {} {
  if depth >= MAX_NESTING {
    Error(Nesting(depth))
  } else {
    Ok(())
  }
}

// Pull decoding, ported from serde_json 8c535a260ce561eaab4111aafc29038eb9f77ff3:
// src/de.rs:255 (whitespace), 1820 (struct), 1919-2045 (Seq/MapAccess),
// src/read.rs:521-566 (SliceRead's borrowed string fast path).
// Bytes/String views retain their backing owner; Reader never takes the cursor.
pub type Reader {
  data: Bytes,
  pos: u64,
  depth: u64,
}

pub type TextView = Unescaped(Bytes) | Escaped(String)

pub type Token = NullToken | BoolToken(bool) | NumberToken(Bytes) | TextToken(TextView) | ArrayStart | ArrayEnd | ObjectStart | ObjectEnd | Colon | Comma

pub fn reader(data: Bytes) -> Reader in data uses {} {
  Reader(data: data, pos: 0, depth: 0)
}

/// The next non-whitespace byte, or zero at end of cursor.
pub fn peek(mut cursor: Reader) -> u8 uses {} {
  json_whitespace(cursor.data, mut cursor.pos)
}

/// A quoted string: a view when unescaped, independent storage otherwise.
pub fn read_text(mut cursor: Reader) -> Result[TextView, JsonError] in cursor uses {} {
  if peek(mut cursor) != 34 {
    return Error(Syntax(cursor.pos))
  }
  let end = core@1/bytes.find_any(cursor.data, JSON_STRING_STOP, cursor.pos + 1)
  if end < core@1/bytes.len(cursor.data) && cursor.data[end] == 34 {
    let value = core@1/bytes.slice(cursor.data, cursor.pos + 1, end)
    cursor.pos = end + 1
    return Ok(Unescaped(value))
  }
  // Keep the DOM parser's exact escape, surrogate and control-byte errors.
  Ok(Escaped(json_quoted(cursor.data, mut cursor.pos)?))
}

/// A lossless number spelling as a view of the cursor.
pub fn read_number(mut cursor: Reader) -> Result[Bytes, JsonError] in cursor uses {} {
  let _ = peek(mut cursor)
  let start = cursor.pos
  json_number_end(cursor.data, mut cursor.pos)?
  Ok(core@1/bytes.slice(cursor.data, start, cursor.pos))
}

fn reader_open(mut cursor: Reader, delimiter: u8) -> Result[(), JsonError] uses {} {
  if peek(mut cursor) != delimiter {
    return Error(Syntax(cursor.pos))
  }
  if let Error(_) = check_depth(cursor.depth) {
    // The writer counts levels; readers report the delimiter's byte position.
    return Error(Nesting(cursor.pos))
  }
  cursor.pos += 1
  cursor.depth += 1
  Ok(())
}

/// Read one lexical token. Container consumers enforce delimiter grammar.
pub fn next_token(mut cursor: Reader) -> Result[Token, JsonError] in cursor uses {} {
  let c = peek(mut cursor)
  if c == 34 {
    return Ok(TextToken(read_text(mut cursor)?))
  }
  if c == 45 || c >= 48 && c <= 57 {
    return Ok(NumberToken(read_number(mut cursor)?))
  }
  if c == 110 {
    json_keyword(cursor.data, mut cursor.pos, "null")?
    return Ok(NullToken)
  }
  if c == 116 {
    json_keyword(cursor.data, mut cursor.pos, "true")?
    return Ok(BoolToken(true))
  }
  if c == 102 {
    json_keyword(cursor.data, mut cursor.pos, "false")?
    return Ok(BoolToken(false))
  }
  if c == 91 {
    reader_open(mut cursor, 91)?
    return Ok(ArrayStart)
  }
  if c == 123 {
    reader_open(mut cursor, 123)?
    return Ok(ObjectStart)
  }
  if c == 93 || c == 125 {
    if cursor.depth == 0 {
      return Error(Syntax(cursor.pos))
    }
    cursor.depth -= 1
    cursor.pos += 1
    return Ok(
      if c == 93 {
        ArrayEnd
      } else {
        ObjectEnd
      }
    )
  }
  cursor.pos += 1
  if c == 58 {
    return Ok(Colon)
  }
  if c == 44 {
    return Ok(Comma)
  }
  Error(Syntax(cursor.pos - 1))
}

pub fn begin_array(mut cursor: Reader) -> Result[(), JsonError] uses {} {
  reader_open(mut cursor, 91)
}

pub fn begin_object(mut cursor: Reader) -> Result[(), JsonError] uses {} {
  reader_open(mut cursor, 123)
}

// serde_json SeqAccess/MapAccess: the first item has no comma. After a comma
// a value/key is mandatory, so trailing commas fail at the closing delimiter.
fn reader_more(mut cursor: Reader, mut first: bool, end: u8) -> Result[bool, JsonError] uses {} {
  let c = peek(mut cursor)
  if c == end {
    if cursor.depth == 0 {
      return Error(Syntax(cursor.pos))
    }
    cursor.pos += 1
    cursor.depth -= 1
    return Ok(false)
  }
  if !first {
    if c != 44 {
      return Error(Syntax(cursor.pos))
    }
    cursor.pos += 1
  }
  first = false
  Ok(true)
}

pub fn array_next(mut cursor: Reader, mut first: bool) -> Result[bool, JsonError] uses {} {
  reader_more(mut cursor, mut first, 93)
}

/// Next object key without allocating a key set. Generated records check their
/// declared field slots and keep a set only for unknown fields.
pub fn object_key(mut cursor: Reader, mut first: bool) -> Result[
  Option[TextView],
  JsonError
] in cursor uses {} {
  if !reader_more(mut cursor, mut first, 125)? {
    return Ok(None)
  }
  Ok(Some(read_text(mut cursor)?))
}

pub fn colon(mut cursor: Reader) -> Result[(), JsonError] uses {} {
  if peek(mut cursor) != 58 {
    return Error(Syntax(cursor.pos))
  }
  cursor.pos += 1
  Ok(())
}

// Shared lexical member boundary. Preserve the key-start offset after comma
// whitespace without changing reader_more's delimiter and depth behavior.
fn owned_member_start(mut cursor: Reader, mut first: bool) -> Result[
  Option[u64],
  JsonError
] uses {} {
  let _ = peek(mut cursor)
  let mut start = cursor.pos
  if !first && json_peek(cursor.data, start) == 44 {
    start += 1
    let _ = json_whitespace(cursor.data, mut start)
  }
  if !reader_more(mut cursor, mut first, 125)? {
    return Ok(None)
  }
  Ok(Some(start))
}

/// Next object key, rejecting decoded duplicates before reading its value.
/// The caller owns the key set for this object, including ignored members.
pub fn object_next(mut cursor: Reader, mut first: bool, mut keys: Set[String]) -> Result[
  Option[String],
  JsonError
] uses {} {
  let Some(start) = owned_member_start(mut cursor, mut first)? else {
    return Ok(None)
  }
  let key = read_owned_text(mut cursor)?
  if core@1/set.contains(keys, key) {
    return Error(DuplicateKey(start))
  }
  core@1/set.insert(mut keys, copy key)
  colon(mut cursor)?
  Ok(Some(key))
}

// SmallVec 4999262d672a92b1b6a4aab7bef43b3d788f3d83 (MIT/Apache-2.0),
// src/lib.rs:586-615,674-703: bounded inline ownership before heap spill.
// Like the derived reader, keep both inline keys after spilling. Only later
// keys enter the existing hashed Set, so wide objects stay bounded per lookup.
fn remember_skipped_key(
  mut first: Option[String],
  mut second: Option[String],
  mut spill: Option[Set[String]],
  take key: String
) -> bool uses {} {
  match first {
    None => {
      first = Some(take key)
      return true
    },
    Some(previous) => {
      if previous == key {
        return false
      }
    },
  }
  match second {
    None => {
      second = Some(take key)
      return true
    },
    Some(previous) => {
      if previous == key {
        return false
      }
    },
  }
  let mut seen = match std@1/option.remove(mut spill) {
    Some(previous) => take previous,
    None => core@1/set.empty(),
  }
  let duplicate = core@1/set.contains(seen, key)
  if !duplicate {
    core@1/set.insert(mut seen, take key)
  }
  spill = Some(take seen)
  !duplicate
}

/// Validate and skip one value, retaining only object key sets, never a DOM.
pub fn skip(mut cursor: Reader) -> Result[(), JsonError] uses {} {
  let c = peek(mut cursor)
  if c == 91 {
    begin_array(mut cursor)?
    let mut first = true
    while array_next(mut cursor, mut first)? {
      skip(mut cursor)?
    }
  } else if c == 123 {
    begin_object(mut cursor)?
    let mut first = true
    let mut first_key: Option[String] = None
    let mut second_key: Option[String] = None
    let mut spill: Option[Set[String]] = None
    while let Some(start) = owned_member_start(mut cursor, mut first)? {
      let key = read_owned_text(mut cursor)?
      if !remember_skipped_key(mut first_key, mut second_key, mut spill, take key) {
        return Error(DuplicateKey(start))
      }
      colon(mut cursor)?
      skip(mut cursor)?
    }
  } else {
    match next_token(mut cursor)? {
      NullToken => (),
      BoolToken(_) => (),
      NumberToken(_) => (),
      TextToken(_) => (),
      _ => return Error(Syntax(cursor.pos - 1)),
    }
  }
  Ok(())
}

/// Require only whitespace after the decoded root.
pub fn finish_reader(mut cursor: Reader) -> Result[(), JsonError] uses {} {
  let _ = peek(mut cursor)
  if cursor.pos != core@1/bytes.len(cursor.data) {
    return Error(Syntax(cursor.pos))
  }
  Ok(())
}

/// An independently owned decoded string for an owned typed field. The reader's
/// view path remains available for keys and transient consumers.
pub fn read_owned_text(mut cursor: Reader) -> Result[unique String, JsonError] uses {} {
  if peek(mut cursor) != 34 {
    return Error(Syntax(cursor.pos))
  }
  let stop = core@1/bytes.find_any(cursor.data, JSON_STRING_STOP, cursor.pos + 1)
  if stop < core@1/bytes.len(cursor.data) && cursor.data[stop] == 34 {
    let mut out: List[u8] = []
    core@1/bytes.append(mut out, core@1/bytes.slice(cursor.data, cursor.pos + 1, stop))
    cursor.pos = stop + 1
    return match text.finish(take out) {
      Ok(s) => Ok(take s),
      Error(_) => Error(Syntax(stop)),
    }
  }
  json_quoted(cursor.data, mut cursor.pos)
}

/// JSON syntax/UTF-8 failures retain their old cause; Limit has no partial text.
pub type ReadTextBoundedError = Json(JsonError) | Limit

// serde_json read.rs:521-568 (8c535a2, MIT OR Apache-2.0): scan plain spans,
// then share strict escape transitions. Unlike serde's scratch, admission comes
// BEFORE every append. Overflow validates the same token with no more output.
// Only scalar-sized integer/char locals are scratch; no temporary decoded List.
/// Decode at most max_decoded_bytes UTF-8 bytes, excluding the quotes. Syntax
/// wins over Limit; success and Limit stop immediately after the closing quote.
/// Logical retained length is bounded, not the allocator's capacity/RSS slack.
pub fn read_owned_text_bounded(mut cursor: Reader, max_decoded_bytes: u64) -> Result[
  unique String,
  ReadTextBoundedError
] uses {} {
  if peek(mut cursor) != 34 {
    return Error(Json(Syntax(cursor.pos)))
  }
  cursor.pos += 1
  let mut output: List[u8] = []
  let mut limited = false
  let mut invalid = false
  let mut escaped = false
  while cursor.pos < core@1/bytes.len(cursor.data) {
    let start = cursor.pos
    cursor.pos = core@1/bytes.find_any(cursor.data, JSON_STRING_STOP, cursor.pos)
    let span = core@1/bytes.slice(cursor.data, start, cursor.pos)
    // Check even discarded spans. Delay UTF-8 errors until token finish, as
    // text.finish did; a later bad escape/control/EOF still takes precedence.
    if !valid_utf8(span) {
      invalid = true
    }
    if !limited {
      if core@1/bytes.len(span) > max_decoded_bytes - core@1/list.len(output) {
        limited = true
      } else {
        core@1/bytes.append(mut output, span)
      }
    }
    if cursor.pos == core@1/bytes.len(cursor.data) {
      break
    }
    let c = cursor.data[cursor.pos]
    cursor.pos += 1
    if c == 34 {
      if invalid {
        return Error(
          Json(
            Syntax(
              if escaped {
                cursor.pos
              } else {
                cursor.pos - 1
              }
            )
          )
        )
      }
      if limited {
        return Error(Limit)
      }
      return match text.finish(take output) {
        Ok(value) => Ok(take value),
        Error(_) => Error(Json(Syntax(cursor.pos))),
      }
    }
    if c < 32 {
      return Error(Json(Syntax(cursor.pos - 1)))
    }
    escaped = true
    let scalar = json_escape(cursor.data, mut cursor.pos) ? Json
    let code = core@1/char.to_u32(scalar)
    let width: u64 = if code < 0x80u32 {
      1
    } else if code < 0x800u32 {
      2
    } else if code < 0x10000u32 {
      3
    } else {
      4
    }
    if !limited {
      if width > max_decoded_bytes - core@1/list.len(output) {
        limited = true
      } else {
        char.format_into(scalar, mut output)
      }
    }
  }
  Error(Json(Syntax(cursor.pos)))
}

/// Compare a borrowed key against a field name quoted at compile time.
pub fn text_is(value: TextView, expected: String) -> bool uses {} {
  match value {
    Unescaped(raw) => {
      // Reject different lengths before materializing a view of the field name.
      // Keep both operands borrowed for the decoded-key comparison.
      if core@1/bytes.len(raw) != core@1/string.byte_len(expected) {
        return false
      }
      let field = core@1/string.as_bytes(expected)
      raw == field
    },
    Escaped(decoded) => decoded == expected,
  }
}

/// Copy only a token's bytes when an owned String is required by scalar.parse.
/// The pull reader itself exposes the original spelling without allocation.
pub fn number_text(raw: Bytes) -> unique String uses {} {
  json_owned_text(raw, 0, core@1/bytes.len(raw))
}

pub fn text_owned(value: TextView) -> unique String uses {} {
  match value {
    Unescaped(raw) => json_owned_text(raw, 0, core@1/bytes.len(raw)),
    Escaped(decoded) => json_owned_text(
      core@1/string.as_bytes(decoded),
      0,
      core@1/string.byte_len(decoded)
    ),
  }
}

// Same strict scalar validation as std@1/utf8.decode_lossy's accepted runs.
// serde_json SliceRead delegates this check to Rust str::from_utf8. Keep it a
// borrowed-byte scan here because core string.from_bytes consumes owned bytes.
pub fn valid_utf8(data: Bytes) -> bool uses {} {
  let mut at: u64 = 0
  let size = core@1/bytes.len(data)
  while at < size {
    let first = data[at]
    if first < 128 {
      at += 1
      continue
    }
    let width: u64 = if first >= 194 && first <= 223 {
      2
    } else if first >= 224 && first <= 239 {
      3
    } else if first >= 240 && first <= 244 {
      4
    } else {
      return false
    }
    if width > size - at {
      return false
    }
    let mut part: u64 = 1
    while part < width {
      let c = data[at + part]
      let low: u8 = if part == 1 && first == 224 {
        160
      } else if part == 1 && first == 240 {
        144
      } else {
        128
      }
      let high: u8 = if part == 1 && first == 237 {
        159
      } else if part == 1 && first == 244 {
        143
      } else {
        191
      }
      if c < low || c > high {
        return false
      }
      part += 1
    }
    at += width
  }
  true
}
