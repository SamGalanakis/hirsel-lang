    0u64,
    0u64,
    0u64,
    0u64,
    0u64,
    0u64,
    0u64,
    0u64,
    0u64,
    0u64,
    0u64,
    0u64,
    0u64,
    0u64,
    0u64,
    0u64,
    0u64,
    0u64,
    0u64,
    0u64,
    0u64,
    0u64,
    0u64,
    0u64,
    0u64,
    0u64,
    0u64,
    0u64,
    0u64,
    0u64,
    0u64,
    0u64,
    0u64,
    0u64,
    0u64,
    0u64,
    0u64,
    0u64,
    0u64,
    0u64,
    0u64,
    0u64,
    0u64,
    0u64,
    0u64,
    0u64,
    0u64
  ]
  let mut i: u64 = 0
  while i < 16 {
    let at = i * 8
    let mut word: u64 = 0
    let mut j: u64 = 0
    while j < 8 {
      let byte: u64 = core@1/int.widen(state.block[at + j])
      word = word << 8 | byte
      j += 1
    }
    schedule[i] = word
    i += 1
  }
  rounds(mut state.words, take schedule)
}

@noalloc
fn compress_input(mut words: Inline[u64, 8], data: Bytes, offset: u64) -> () uses {} {
  let mut schedule: Inline[u64, 80] = [
    0u64,
    0u64,
    0u64,
    0u64,
    0u64,
    0u64,
    0u64,
