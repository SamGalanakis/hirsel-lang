@noalloc
fn rotate(value: u64, bits: u64) -> u64 uses {} {
  value >> bits | value << 64u64 - bits
}

@noalloc
fn add(a: u64, b: u64) -> u64 uses {} {
  core@1/int.wrapping_add(a, b)
}

@noalloc
fn compress(mut state: State) -> () uses {} {
  let mut schedule: Inline[u64, 80] = [
    0u64,
    0u64,
    0u64,
    0u64,
    0u64,
    0u64,
    0u64,
    0u64,
    0u64,
