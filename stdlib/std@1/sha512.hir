    0u64,
    0u64,
    0u64,
    0u64,
    0u64,
    0u64,
    0u64,
    0u64,
    0u64,
    0u64,
    0u64,
    0u64,
    0u64,
    0u64,
    0u64,
    0u64,
    0u64,
    0u64,
    0u64,
    0u64,
    0u64,
    0u64,
    0u64,
    0u64,
    0u64,
    0u64,
    0u64,
    0u64,
    0u64,
    0u64,
    0u64,
    0u64,
    0u64,
    0u64,
    0u64,
    0u64,
    0u64,
    0u64,
    0u64,
    0u64,
    0u64,
    0u64,
    0u64,
    0u64,
    0u64,
    0u64,
    0u64
  ]
  let mut i: u64 = 0
  while i < 16 {
    let at = offset + i * 8
    let mut word: u64 = 0
    let mut j: u64 = 0
    while j < 8 {
      let byte: u64 = core@1/int.widen(data[at + j])
      word = word << 8 | byte
      j += 1
    }
    schedule[i] = word
    i += 1
  }
  rounds(mut words, take schedule)
}

@noalloc
fn rounds(mut words: Inline[u64, 8], take initial: Inline[u64, 80]) -> () uses {} {
  let mut schedule = take initial
  let mut i: u64 = 16
  while i < 80 {
    let a = schedule[i - 15]
    let b = schedule[i - 2]
    let s0 = rotate(a, 1) ^ rotate(a, 8) ^ a >> 7
    let s1 = rotate(b, 19) ^ rotate(b, 61) ^ b >> 6
    schedule[i] = add(add(schedule[i - 16], s0), add(schedule[i - 7], s1))
    i += 1
  }
  let mut a = words[0]
  let mut b = words[1]
  let mut c = words[2]
  let mut d = words[3]
  let mut e = words[4]
  let mut f = words[5]
  let mut g = words[6]
  let mut h = words[7]
  i = 0
  while i < 80 {
    let upper = rotate(e, 14) ^ rotate(e, 18) ^ rotate(e, 41)
    let choice = e & f ^ ~e & g
    let t1 = add(add(add(h, upper), choice), add(K[i], schedule[i]))
    let lower = rotate(a, 28) ^ rotate(a, 34) ^ rotate(a, 39)
    let majority = a & b ^ a & c ^ b & c
    let t2 = add(lower, majority)
    h = g
    g = f
    f = e
    e = add(d, t1)
    d = c
    c = b
    b = a
    a = add(t1, t2)
    i += 1
  }
  words[0] = add(words[0], a)
  words[1] = add(words[1], b)
  words[2] = add(words[2], c)
  words[3] = add(words[3], d)
  words[4] = add(words[4], e)
  words[5] = add(words[5], f)
  words[6] = add(words[6], g)
  words[7] = add(words[7], h)
}

@noalloc
pub fn update(mut state: State, data: Bytes) -> () uses {} {
  let len = core@1/bytes.len(data)
  core@1/failure.check(len <= 18446744073709551615u64 - state.count, Arithmetic())
  state.count += len
  let mut i: u64 = 0
  // Fill a partial block left by the previous call before reading input blocks.
  if state.used != 0 {
    while i < len && state.used < 128 {
      state.block[state.used] = data[i]
      state.used += 1
      i += 1
    }
    if state.used == 128 {
      compress(mut state)
      state.used = 0
    }
  }
  // Zig std crypto update: compress full middle blocks without a staging copy.
  while len - i >= 128 {
    compress_input(mut state.words, data, i)
    i += 128
  }
  // Only the incomplete tail survives until the next update or finish.
  while i < len {
    state.block[state.used] = data[i]
    state.used += 1
    i += 1
  }
}

@noalloc
pub fn finish(take state: State) -> Inline[u8, 64] uses {} {
  let mut final_state = take state
  final_state.block[final_state.used] = 128
  final_state.used += 1
  if final_state.used > 112 {
    while final_state.used < 128 {
      final_state.block[final_state.used] = 0
      final_state.used += 1
    }
    compress(mut final_state)
    final_state.used = 0
  }
  while final_state.used < 128 {
    final_state.block[final_state.used] = 0
    final_state.used += 1
  }
  // The 128-bit big-endian bit length: the byte count's top three bits end the high word.
  final_state.block[119] = core@1/int.narrow(final_state.count >> 61)
  let mut bits = final_state.count << 3
  let mut i: u64 = 0
  while i < 8 {
    final_state.block[127 - i] = core@1/int.truncate(bits)
    bits >>= 8
    i += 1
  }
  compress(mut final_state)
  let mut out: Inline[u8, 64] = [
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8
  ]
  i = 0
  while i < 64 {
    let value = final_state.words[i >> 3]
    out[i] = core@1/int.truncate(value >> 56 - (i & 7) * 8)
    i += 1
  }
  take out
}

@noalloc
pub fn digest(data: Bytes) -> Inline[u8, 64] uses {} {
  let mut state = new()
  update(mut state, data)
  finish(take state)
}

pub fn digest_hex(data: Bytes) -> unique String uses {} {
  std@1/hex.encode(std@1/bytes.from_inline(digest(data)))
}

// The dictionary that keys HMAC, HKDF and PBKDF2 with this hash.
pub fn hash() -> std@1/digest.Hash[State, 64] uses {} {
  std@1/digest.Hash(new: new, update: update, finish: finish, block_size: 128)
}
