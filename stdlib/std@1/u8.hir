// Decimal conversion is ordinary source; no numeric schema or hidden allocator.
@noalloc
pub fn format[n: size](value: u8, mut buffer: Inline[u8, n]) -> Result[
  u64,
  scalar.FormatError
] uses {} {
  let magnitude: u128 = core@1/int.widen(value)
  internal.decimal.write_unsigned(magnitude, false, mut buffer)
}

// Appends the decimal text of `value` to `out`; to_string is that text,
// built from the same digits in a list reserved to its exact length.
@preserves_unique(out)
pub fn format_into(value: u8, mut out: List[u8]) -> () uses {} {
  internal.decimal.append(mut out, core@1/int.widen(value), false)
}

pub fn to_string(value: u8) -> String uses {} {
  let mut out: List[u8] = []
  u8.format_into(value, mut out)
  internal.decimal.finish(take out)
}

@noalloc
pub fn parse(text: String) -> Result[u8, scalar.ParseError] uses {} {
  parse_radix(text, 10)
}
