// Unicode 16.0.0 normalization (UAX #15). Input is valid UTF-8.
// Tables are ordinary immutable source constants, not runtime kernels.
@noalloc
fn scalar_at(table: Bytes, offset: u64) -> u32 uses {} {
  let a: u32 = core@1/int.widen(table[offset])
  let b: u32 = core@1/int.widen(table[offset + 1])
  let c: u32 = core@1/int.widen(table[offset + 2])
  a << 16 | b << 8 | c
}

@noalloc
fn combining_class(cp: u32) -> u8 uses {} {
  if cp < scalar_at(NFC_CCC, 0) || cp > scalar_at(
    NFC_CCC,
    core@1/bytes.len(NFC_CCC) - 4
  ) {
    return 0
  }
  let mut lo: u64 = 0
  let mut hi = core@1/bytes.len(NFC_CCC) / 4
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if scalar_at(NFC_CCC, mid * 4) < cp {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  if lo < core@1/bytes.len(NFC_CCC) / 4 && scalar_at(NFC_CCC, lo * 4) == cp {
    NFC_CCC[lo * 4 + 3]
  } else {
    0
  }
}

@noalloc
fn canonical_pair(cp: u32) -> (u32, u32) uses {} {
  if cp < scalar_at(NFC_DECOMPOSITION, 0) || cp > scalar_at(
    NFC_DECOMPOSITION,
    core@1/bytes.len(NFC_DECOMPOSITION) - 9
  ) {
    return (cp, 0)
  }
  let mut lo: u64 = 0
  let mut hi = core@1/bytes.len(NFC_DECOMPOSITION) / 9
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if scalar_at(NFC_DECOMPOSITION, mid * 9) < cp {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  if lo < core@1/bytes.len(NFC_DECOMPOSITION) / 9 && scalar_at(
    NFC_DECOMPOSITION,
    lo * 9
  ) == cp {
    (scalar_at(NFC_DECOMPOSITION, lo * 9 + 3), scalar_at(NFC_DECOMPOSITION, lo * 9 + 6))
  } else {
    (cp, 0)
  }
}

@noalloc
fn composite(a: u32, b: u32) -> u32 uses {} {
  // Algorithmic Hangul L + V and LV + T, including zero-class Jamo.
  if a >= 0x1100 && a < 0x1113 && b >= 0x1161 && b < 0x1176 {
    return 0xac00 + ((a - 0x1100) * 21 + b - 0x1161) * 28
  }
  if a >= 0xac00 && a < 0xd7a4 && (a - 0xac00) % 28 == 0 && b > 0x11a7 && b < 0x11c3 {
    return a + b - 0x11a7
  }
  let mut lo: u64 = 0
  let mut hi = core@1/bytes.len(NFC_COMPOSITION) / 9
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    let first = scalar_at(NFC_COMPOSITION, mid * 9)
    let second = scalar_at(NFC_COMPOSITION, mid * 9 + 3)
    if first < a || first == a && second < b {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  if lo < core@1/bytes.len(NFC_COMPOSITION) / 9 && scalar_at(NFC_COMPOSITION, lo * 9) == a && scalar_at(
    NFC_COMPOSITION,
    lo * 9 + 3
  ) == b {
    scalar_at(NFC_COMPOSITION, lo * 9 + 6)
  } else {
    0
  }
}

// Stable insertion within the final combining sequence; starters are barriers.
fn ordered(mut points: List[u32], cp: u32) -> () uses {} {
  let cc = combining_class(cp)
  core@1/list.push(mut points, cp)
  let mut i = core@1/list.len(points) - 1
  while cc != 0 && i > 0 && combining_class(points[i - 1]) > cc {
    points[i] = points[i - 1]
    i -= 1
  }
  points[i] = cp
}

fn decompose(mut points: List[u32], cp: u32, compatibility: bool) -> () uses {} {
  if compatibility {
    let mut lo: u64 = 0
    let mut hi = core@1/bytes.len(COMPATIBILITY) / 7
    while lo < hi {
      let mid = lo + (hi - lo) / 2
      if scalar_at(COMPATIBILITY, mid * 7) < cp {
        lo = mid + 1
      } else {
        hi = mid
      }
    }
    if lo < core@1/bytes.len(COMPATIBILITY) / 7 && scalar_at(COMPATIBILITY, lo * 7) == cp {
      let offset: u64 = core@1/int.widen(scalar_at(COMPATIBILITY, lo * 7 + 3))
      let count: u64 = core@1/int.widen(COMPATIBILITY[lo * 7 + 6])
      let mut i: u64 = 0
      while i < count {
        decompose(mut points, scalar_at(COMPATIBILITY_DATA, offset + i * 3), true)
        i += 1
      }
      return
    }
  }
  if cp >= 0xac00 && cp < 0xd7a4 {
    let syllable = cp - 0xac00
    ordered(mut points, 0x1100 + syllable / 588)
    ordered(mut points, 0x1161 + syllable % 588 / 28)
    if syllable % 28 != 0 {
      ordered(mut points, 0x11a7 + syllable % 28)
    }
  } else {
    let (a, b) = canonical_pair(cp)
    if a == cp {
      ordered(mut points, cp)
    } else {
      decompose(mut points, a, compatibility)
      if b != 0 {
        decompose(mut points, b, compatibility)
      }
    }
  }
}

fn normalize(s: String, compatibility: bool, compose: bool) -> String uses {} {
  // Every ASCII scalar is a starter and has no decomposition or composition.
  if string.is_ascii(s) {
    return unique s
  }
  let mut points: List[u32] = []
  for c in core@1/string.scalars(s) {
    decompose(mut points, core@1/char.to_u32(c), compatibility)
  }
  let mut composed: List[u32] = []
  let mut starter: u64 = 0
  let mut last_class: u8 = 0
  for cp in points {
    let cc = combining_class(cp)
    let mut joined: u32 = 0
    if compose && core@1/list.len(composed) > 0 && (last_class == 0 || last_class < cc) {
      joined = composite(composed[starter], cp)
    }
    if joined != 0 {
      composed[starter] = joined
    } else {
      if cc == 0 {
        starter = core@1/list.len(composed)
      }
      core@1/list.push(mut composed, cp)
      last_class = cc
    }
  }
  let mut bytes: List[u8] = []
  for cp in composed {
    // Composition and decomposition map scalar values to scalar values.
    match core@1/char.from_u32(cp) {
      Some(c) => char.format_into(c, mut bytes),
      None() => core@1/failure.check(false, TextInvariant()),
    }
  }
  text.finish_valid(take bytes)
}

/// Unicode 16.0.0 canonical composition; returns independently owned text.
pub fn normalize_nfc(s: String) -> unique String uses {} {
  normalize(s, false, true)
}

/// Unicode 16.0.0 canonical decomposition; returns independently owned text.
pub fn normalize_nfd(s: String) -> unique String uses {} {
  normalize(s, false, false)
}

/// Unicode 16.0.0 compatibility decomposition followed by canonical composition; returns independently owned text.
pub fn normalize_nfkc(s: String) -> unique String uses {} {
  normalize(s, true, true)
}

/// Unicode 16.0.0 compatibility decomposition; returns independently owned text.
pub fn normalize_nfkd(s: String) -> unique String uses {} {
  normalize(s, true, false)
}
