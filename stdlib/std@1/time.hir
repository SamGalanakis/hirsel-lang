// Widen ticks before subtracting so every u64 interval fits exactly.
@serializable
pub type Duration {
  nanoseconds: i128,
}

@noalloc
pub fn between(clock: MonotonicClock, start: Instant of clock, end: Instant of clock) -> Duration {
  let first: i128 = core@1/int.widen(core@1/instant.ticks(start))
  let last: i128 = core@1/int.widen(core@1/instant.ticks(end))
  Duration(nanoseconds: last - first)
}

@noalloc
pub fn elapsed(clock: MonotonicClock, start: Instant of clock) -> Result[
  Duration,
  ClockError
] {
  let end = core@1/clock.monotonic(clock)?
  Ok(between(clock, start, end))
}

@noalloc
pub fn compare(clock: MonotonicClock, a: Instant of clock, b: Instant of clock) -> i32 {
  let first = core@1/instant.ticks(a)
  let second = core@1/instant.ticks(b)
  if first < second {
    -1
  } else if first > second {
    1
  } else {
    0
  }
}

@serializable
pub type Timestamp {
  unix_nanoseconds: i128,
}

pub type TimeError = OutOfRange()

// Adapted from Zig lib/std/time/epoch.zig isLeapYear/getDaysInMonth.
// Reference commit bff490a23889750de7096d9057c0a432efc929a8; copyright Zig contributors (third-party/NOTICES.md).
@noalloc
fn leap_year(year: i128) -> bool uses {} {
  year % 4 == 0 && (year % 100 != 0 || year % 400 == 0)
}

@noalloc
fn month_days(year: i128, month: i128) -> i128 uses {} {
  if month == 2 {
    if leap_year(year) {
      29
    } else {
      28
    }
  } else if month == 4 || month == 6 || month == 9 || month == 11 {
    30
  } else {
    31
  }
}

@noalloc
fn read_digits(bytes: Bytes, begin: u64, count: u64) -> Result[i128, scalar.ParseError] uses {} {
  let mut value: i128 = 0
  let mut i: u64 = 0
  while i < count {
    let byte = bytes[begin + i]
    if byte < 48 || byte > 57 {
      return Error(Invalid())
    }
    let digit: i128 = core@1/int.widen(byte - 48)
    value = value * 10 + digit
    i += 1
  }
  Ok(value)
}

// Inverse of Zig epoch.zig's year/month subtraction: count completed years,
// then completed months. Year zero is the base; whole 400-year cycles are exact.
@noalloc
fn civil_days(year: i128, month: i128, day: i128) -> i128 uses {} {
  let leaps = (year + 3) / 4 - (year + 99) / 100 + (year + 399) / 400
  let mut days = year * 365 + leaps + day - 1
  let mut m: i128 = 1
  while m < month {
    days += month_days(year, m)
    m += 1
  }
  days - 719528
}

// Contract-specific RFC3339 scanner; neither Zig epoch nor Rust std exposes one.
// Date validation adapts Zig lib/std/time/epoch.zig at bff490a23889750de7096d9057c0a432efc929a8.
@noalloc
pub fn parse(text: String) -> Result[Timestamp, scalar.ParseError] uses {} {
  let bytes = core@1/string.as_bytes(text)
  let len = core@1/bytes.len(bytes)
  if len < 20 {
    return Error(Invalid())
  }
  if bytes[4] != 45 || bytes[7] != 45 || bytes[10] != 84 && bytes[10] != 116 || bytes[13] != 58 || bytes[16] != 58 {
    return Error(Invalid())
  }
  let year = read_digits(bytes, 0, 4)?
  let month = read_digits(bytes, 5, 2)?
  let day = read_digits(bytes, 8, 2)?
  let hour = read_digits(bytes, 11, 2)?
  let minute = read_digits(bytes, 14, 2)?
  let second = read_digits(bytes, 17, 2)?
  if month < 1 || month > 12 || day < 1 || day > month_days(year, month) || hour > 23 || minute > 59 || second > 59 {
    return Error(Invalid())
  }
  let mut i: u64 = 19
  let mut fraction: i128 = 0
  let mut digits: u64 = 0
  if bytes[i] == 46 {
    i += 1
    while i < len && bytes[i] >= 48 && bytes[i] <= 57 {
      if digits == 9 {
        return Error(Invalid())
      }
      let digit: i128 = core@1/int.widen(bytes[i] - 48)
      fraction = fraction * 10 + digit
      digits += 1
      i += 1
    }
    if digits == 0 {
      return Error(Invalid())
    }
  }
  while digits < 9 {
    fraction *= 10
    digits += 1
  }
  if i >= len {
    return Error(Invalid())
  }
  let mut offset: i128 = 0
  if bytes[i] == 90 || bytes[i] == 122 {
    if i + 1 != len {
      return Error(Invalid())
    }
  } else if bytes[i] == 43 || bytes[i] == 45 {
    if len - i != 6 || bytes[i + 3] != 58 {
      return Error(Invalid())
    }
    let oh = read_digits(bytes, i + 1, 2)?
    let om = read_digits(bytes, i + 4, 2)?
    if oh > 23 || om > 59 {
      return Error(Invalid())
    }
    offset = (oh * 60 + om) * 60
    if bytes[i] == 45 {
      offset = -offset
    }
  } else {
    return Error(Invalid())
  }
  let seconds = civil_days(year, month, day) * 86400 + hour * 3600 + minute * 60 + second - offset
  Ok(Timestamp(unix_nanoseconds: seconds * 1000000000 + fraction))
}

@preserves_unique(builder)
fn write_digits(mut builder: List[u8], value: i128, width: u64) -> () uses {} {
  let mut divisor: i128 = 1
  let mut i: u64 = 1
  while i < width {
    divisor *= 10
    i += 1
  }
  let mut left = value
  while divisor != 0 {
    let digit: u8 = core@1/int.narrow(left / divisor)
    core@1/list.push(mut builder, digit + 48)
    left %= divisor
    divisor /= 10
  }
}

// Adapted from Zig lib/std/time/epoch.zig EpochDay.calculateYearDay,
// YearAndDay.calculateMonthDay and DaySeconds, commit bff490a23889750de7096d9057c0a432efc929a8.
// Offset from year zero and skip whole Gregorian cycles for signed bounded UTC.
pub fn format(value: Timestamp) -> Result[String, TimeError] uses {} {
  // Range before division keeps all arithmetic bounded even at i128 MIN/MAX.
  if value.unix_nanoseconds < -62167219200000000000i128 || value.unix_nanoseconds > 253402300799999999999i128 {
    return Error(OutOfRange())
  }
  let seconds = core@1/int.div_floor(value.unix_nanoseconds, 1000000000)
  let mut fraction = core@1/int.mod(value.unix_nanoseconds, 1000000000)
  let days = core@1/int.div_floor(seconds, 86400)
  let daytime = core@1/int.mod(seconds, 86400)
  let absolute_days = days + 719528
  let cycles = absolute_days / 146097
  let mut year = cycles * 400
  let mut remaining = absolute_days % 146097
  let mut year_size: i128 = if leap_year(year) {
    366
  } else {
    365
  }
  while remaining >= year_size {
    remaining -= year_size
    year += 1
    year_size = if leap_year(year) {
      366
    } else {
      365
    }
  }
  let mut month: i128 = 1
  while remaining >= month_days(year, month) {
    remaining -= month_days(year, month)
    month += 1
  }
  let day = remaining + 1
  let mut builder: List[u8] = []
  write_digits(mut builder, year, 4)
  core@1/list.push(mut builder, 45)
  write_digits(mut builder, month, 2)
  core@1/list.push(mut builder, 45)
  write_digits(mut builder, day, 2)
  core@1/list.push(mut builder, 84)
  write_digits(mut builder, daytime / 3600, 2)
  core@1/list.push(mut builder, 58)
  write_digits(mut builder, daytime / 60 % 60, 2)
  core@1/list.push(mut builder, 58)
  write_digits(mut builder, daytime % 60, 2)
  if fraction != 0 {
    core@1/list.push(mut builder, 46)
    let mut divisor: i128 = 100000000
    while fraction != 0 {
      let digit: u8 = core@1/int.narrow(fraction / divisor)
      core@1/list.push(mut builder, digit + 48)
      fraction %= divisor
      divisor /= 10
    }
  }
  core@1/list.push(mut builder, 90)
  match text.finish(take builder) {
    Ok(text) => Ok(take text),
    Error(_) => {
      core@1/failure.check(false, TextInvariant())
      Error(OutOfRange())
    },
  }
}

pub type SleepError = NegativeDuration | OutOfRange | Wait(WaitError)

// Relative-to-absolute conversion adapted from Zig lib/std/Io.zig Timeout.toDeadline,
// Clock.Timestamp.fromNow and Timeout.sleep, commit bff490a23889750de7096d9057c0a432efc929a8; copyright Zig
// contributors (third-party/NOTICES.md). Ticks are nanoseconds (clock.monotonic.ns@1).
@noalloc
pub fn deadline(clock: MonotonicClock, interval: Duration) -> Result[
  Instant of clock,
  SleepError
] {
  if interval.nanoseconds < 0 {
    return Error(NegativeDuration())
  }
  let narrowed: Option[u64] = core@1/int.try_narrow(interval.nanoseconds)
  let nanoseconds = match narrowed {
    Some(n) => n,
    None() => return Error(OutOfRange()),
  }
  let now = match core@1/clock.monotonic(clock) {
    Ok(now) => now,
    Error(e) => return Error(Wait(Clock(e))),
  }
  match core@1/instant.checked_add(clock, now, nanoseconds) {
    Some(until) => Ok(until),
    None() => Error(OutOfRange()),
  }
}

@noalloc
pub fn sleep(clock: MonotonicClock, interval: Duration) -> Result[(), SleepError] {
  let until = deadline(clock, interval)?
  match core@1/clock.sleep_until(clock, until) {
    Ok(()) => Ok(()),
    Error(e) => Error(Wait(e)),
  }
}
