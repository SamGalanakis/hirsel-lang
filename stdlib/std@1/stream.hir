// Sequential fallible adapters also follow futures-rs 706e29b:
// futures-util/src/stream/try_stream/{try_filter.rs,and_then.rs},
// stream/stream/{try_fold.rs,try_for_each.rs}; vectors are in
// conformance/CLO/CLO-4-std-stream-futures-vectors-run.hir with file:line citations.
// Flow terminates after errors, predicates may fail, and polling is synchronous.
// Pull composition follows Effect 4cddd3c Channel.pipeTo; terminal state is
// explicit, like Rust Fuse. Unlike raw Result iterators, errors also end a Flow.
/// An owned fallible cursor. Its source and callbacks stay owned until destruction.
@captures(inner)
pub opaque type Flow[T, E]: () uses {} {
  inner: Iter[Result[T, E]],
}

type SourceState[S, T, E] {
  state: S,
  step: @preserves_captures(cursor) fn(mut cursor: S) -> Result[Option[T], E],
  ended: bool,
}

type Results[T, E] {
  inner: Iter[Result[T, E]],
  ended: bool,
}

type Mapped[T, U, E] {
  inner: Iter[Result[T, E]],
  f: fn(take T) -> Result[U, E],
  ended: bool,
}

type Filtered[T, E] {
  inner: Iter[Result[T, E]],
  predicate: fn(T) -> Result[bool, E],
  ended: bool,
}

/// A source failure before the item budget, or an extra result after it.
pub type BoundError[E] = Source(E) | Limit

type Bounded[T, E] {
  inner: Iter[Result[T, E]],
  remaining: u64,
  ended: bool,
}

/// Own state and its preserving callback without pulling. Error or EOF ends it.
@captures(state, step)
pub fn from[S, T, E](
  take state: S,
  take step: @preserves_captures(cursor) fn(mut cursor: S) -> Result[Option[T], E]
) -> Flow[T, E] uses {state, step} {
  Flow(
    inner: core@1/iter.from(
      take SourceState(state: take state, step: take step, ended: false),
      fn(mut s: SourceState[S, T, E]) -> Option[Result[T, E]] {
        if s.ended {
          return None
        }
        match s.step(mut s.state) {
          Ok(item) => match take item {
            Some(value) => Some(Ok(take value)),
            None => {
              s.ended = true
              None
            },
          },
          Error(error) => {
            s.ended = true
            Some(Error(take error))
          },
        }
      }
    )
  )
}

/// Normalize a raw result iterator, ending at its first error or EOF.
@captures(input)
pub fn from_results[T, E](take input: Iter[Result[T, E]]) -> Flow[T, E] uses {input} {
  Flow(
    inner: core@1/iter.from(
      take Results(inner: take input, ended: false),
      fn(mut s: Results[T, E]) -> Option[Result[T, E]] {
        if s.ended {
          return None
        }
        match core@1/iter.next(mut s.inner) {
          Some(item) => match take item {
            Ok(value) => Some(Ok(take value)),
            Error(error) => {
              s.ended = true
              Some(Error(take error))
            },
          },
          None => {
            s.ended = true
            None
          },
        }
      }
    )
  )
}

/// Transform successful items in order; source and callback errors end the flow.
@captures(input, f)
pub fn try_map[T, U, E](take input: Flow[T, E], take f: fn(take T) -> Result[U, E]) -> Flow[
  U,
  E
] uses {input, f} {
  let Flow(inner: inner) = take input
  Flow(
    inner: core@1/iter.from(
      take Mapped(inner: take inner, f: take f, ended: false),
      fn(mut s: Mapped[T, U, E]) -> Option[Result[U, E]] {
        if s.ended {
          return None
        }
        match core@1/iter.next(mut s.inner) {
          Some(item) => match take item {
            Ok(value) => match s.f(take value) {
              Ok(mapped) => Some(Ok(take mapped)),
              Error(error) => {
                s.ended = true
                Some(Error(take error))
              },
            },
            Error(error) => {
              s.ended = true
              Some(Error(take error))
            },
          },
          None => {
            s.ended = true
            None
          },
        }
      }
    )
  )
}

/// Test successful items in order, dropping rejections; errors end the flow.
@captures(input, predicate)
pub fn try_filter[T, E](
  take input: Flow[T, E],
  take predicate: fn(T) -> Result[bool, E]
) -> Flow[T, E] uses {input, predicate} {
  let Flow(inner: inner) = take input
  Flow(
    inner: core@1/iter.from(
      take Filtered(inner: take inner, predicate: take predicate, ended: false),
      fn(mut s: Filtered[T, E]) -> Option[Result[T, E]] {
        while !s.ended {
          match core@1/iter.next(mut s.inner) {
            Some(item) => match take item {
              Ok(value) => match s.predicate(value) {
                Ok(accepted) => if accepted {
                  return Some(Ok(take value))
                },
                Error(error) => {
                  s.ended = true
                  return Some(Error(take error))
                },
              },
              Error(error) => {
                s.ended = true
                return Some(Error(take error))
              },
            },
            None => {
              s.ended = true
            },
          }
        }
        None
      }
    )
  )
}

/// Consume through the first error or clean end, releasing the owned pipeline.
pub fn try_fold[T, A, E](
  take input: Flow[T, E],
  take initial: A,
  take step: fn(take A, take T) -> Result[A, E]
) -> Result[A, E] uses {input, initial, step} {
  let Flow(inner: inner) = take input
  let mut accumulator = take initial
  for item in take inner {
    match take item {
      Ok(value) => {
        accumulator = step(take accumulator, take value)?
      },
      Error(error) => return Error(take error),
    }
  }
  Ok(take accumulator)
}

/// Visit successful items in order and release the pipeline before returning.
pub fn try_for_each[T, E](
  take input: Flow[T, E],
  take visit: fn(take T) -> Result[(), E]
) -> Result[(), E] uses {input, visit} {
  let Flow(inner: inner) = take input
  for item in take inner {
    match take item {
      Ok(value) => {
        visit(take value)?
      },
      Error(error) => return Error(take error),
    }
  }
  Ok(())
}

/// Advance once. An error is reported once; later calls return None.
@advance_only(flow)
pub fn next[T, E](mut flow: Flow[T, E]) -> Option[Result[T, E]] uses {flow} {
  core@1/iter.next(mut flow.inner)
}

/// Leave the error-aware namespace explicitly, retaining terminal pull behavior.
@captures(input)
pub fn to_iter[T, E](take input: Flow[T, E]) -> Iter[Result[T, E]] uses {input} {
  let Flow(inner: inner) = take input
  take inner
}

/// Own at most count upstream pulls; zero performs no work.
@captures(input)
pub fn take_n[T, E](take input: Flow[T, E], count: u64) -> Flow[T, E] uses {input} {
  let Flow(inner: inner) = take input
  Flow(inner: iter.take_n(take inner, count))
}

// Remaining-count structure: Rust core iter/adapters/take.rs:15-43,
// f6c1107f8be13e48465e12c0fd26e6a39fe18e4f (MIT; repository LICENSE).
// Unlike Take, probe once at the boundary and report overflow; source errors
// and EOF fuse the cursor. Keep the source owned until ordinary destruction.
/// Validate whole-stream cardinality when drained, with one-result lookahead.
/// Construction and early destruction do not pull. Zero probes on first demand.
/// Any extra result, including an error, is dropped and reported as Limit.
/// Pull/drop language failures propagate normally, even during the probe.
@captures(input)
pub fn bound[T, E](take input: Flow[T, E], max_items: u64) -> Flow[T, BoundError[E]] uses {input} {
  let Flow(inner: inner) = take input
  Flow(
    inner: core@1/iter.from(
      take Bounded(inner: take inner, remaining: max_items, ended: false),
      fn(mut s: Bounded[T, E]) -> Option[Result[T, BoundError[E]]] {
        if s.ended {
          return None
        }
        if s.remaining == 0 {
          s.ended = true
          return match core@1/iter.next(mut s.inner) {
            None => None,
            Some(extra) => {
              let _ = take extra
              Some(Error(Limit()))
            },
          }
        }
        match core@1/iter.next(mut s.inner) {
          Some(item) => match take item {
            Ok(value) => {
              s.remaining -= 1
              Some(Ok(take value))
            },
            Error(error) => {
              s.ended = true
              Some(Error(Source(take error)))
            },
          },
          None => {
            s.ended = true
            None
          },
        }
      }
    )
  )
}

/// Own and consume a CSV source; checks include rejected rows and every refill.
/// Callbacks are scoped and never stored in the returned value or an iterator.
pub fn csv_fold_scoped[S, A, E](
  scope: Scope,
  take source: S,
  config: csv.StreamConfig,
  take initial: A,
  refill: fn(mut S, mut List[u8], u64) -> Result[u64, E],
  accept: fn(List[String]) -> Result[bool, E],
  step: fn(take A, take List[String]) -> Result[A, E]
) -> Result[A, csv.DriverError[E]] uses {scope, source, initial, refill, accept, step} {
  csv.fold_scoped(scope, take source, config, take initial, refill, accept, step)
}
