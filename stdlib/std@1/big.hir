// Internal fixed decimal integer: 128 base-10^9 limbs, 1152 decimal digits.
// The largest parser denominator is 10^1125; no heap bigint or input limit.
pub type Big {
  limbs: Inline[u64, 128],
  used: u64,
  first: u64,
}

@noalloc
pub fn big_from_word(value: u64) -> Big uses {} {
  let mut a = Big(
    limbs: [
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64
    ],
    used: 0,
    first: 0
  )
  let mut x = value
  while x != 0 {
    a.limbs[a.used] = x % 1000000000
    a.used += 1
    x /= 1000000000
  }
  a
}

@noalloc
pub fn big_digit(a: Big, i: u64) -> u64 uses {} {
  if i < a.used {
    a.limbs[a.first + i]
  } else {
    0
  }
}

@noalloc
pub fn big_trim(mut a: Big) -> () uses {} {
  while a.used > 0 && a.limbs[a.first + a.used - 1] == 0 {
    a.used -= 1
  }
}

@noalloc
pub fn big_mul(mut a: Big, factor: u64) -> () uses {} {
  let mut carry: u64 = 0
  let mut i: u64 = 0
  while i < a.used {
    let x = a.limbs[a.first + i] * factor + carry
    a.limbs[a.first + i] = x % 1000000000
    carry = x / 1000000000
    i += 1
  }
  if carry != 0 {
    a.limbs[a.first + a.used] = carry
    a.used += 1
  }
}

@noalloc
pub fn big_add_small(mut a: Big, value: u64) -> () uses {} {
  let mut carry = value
  let mut i: u64 = 0
  while carry != 0 {
    if i == a.used {
      a.limbs[a.first + i] = 0
      a.used += 1
    }
    let x = a.limbs[a.first + i] + carry
    a.limbs[a.first + i] = x % 1000000000
    carry = x / 1000000000
    i += 1
  }
}

@noalloc
pub fn big_power(mut a: Big, base: u64, exponent: u64) -> () uses {} {
  // 5^12, 2^29 and 10^8 fit below 10^9; every limb product fits u64.
  let chunk: u64 = if base == 5 {
    12
  } else if base == 2 {
    29
  } else {
    8
  }
  let multiplier: u64 = if base == 5 {
    244140625
  } else if base == 2 {
    536870912
  } else {
    100000000
  }
  let mut e = exponent
  while e >= chunk {
    big_mul(mut a, multiplier)
    e -= chunk
  }
  let mut tail: u64 = 1
  while e > 0 {
    tail *= base
    e -= 1
  }
  big_mul(mut a, tail)
}

// Compare a + bump with b without constructing another 1 KiB value.
@noalloc
pub fn big_compare(a: Big, b: Big, bump: bool) -> i32 uses {} {
  if !bump {
    if a.used != b.used {
      return if a.used < b.used {
        -1
      } else {
        1
      }
    }
    let mut i: u64 = a.used
    while i > 0 {
      i -= 1
      let x = a.limbs[a.first + i]
      let y = b.limbs[b.first + i]
      if x != y {
        return if x < y {
          -1
        } else {
          1
        }
      }
    }
    return 0
  }
  let mut successor = a
  big_add_small(mut successor, 1)
  big_compare(successor, b, false)
}

@noalloc
pub fn big_subtract(mut a: Big, b: Big) -> () uses {} {
  let mut borrow: u64 = 0
  let mut i: u64 = 0
  while i < a.used {
    let x = a.limbs[a.first + i]
    let y = big_digit(b, i) + borrow
    if x < y {
      a.limbs[a.first + i] = x + 1000000000 - y
      borrow = 1
    } else {
      a.limbs[a.first + i] = x - y
      borrow = 0
    }
    i += 1
  }
  big_trim(mut a)
}

@noalloc
pub fn big_divide(mut a: Big, places: u64) -> u64 uses {} {
  if places == 9 {
    let remainder = big_digit(a, 0)
    if a.used > 0 {
      a.first += 1
      a.used -= 1
    }
    remainder
  } else {
    let mut carry: u64 = 0
    let mut i: u64 = copy a.used
    while i > 0 {
      i -= 1
      let x = carry * 1000000000 + a.limbs[a.first + i]
      a.limbs[a.first + i] = x / 10
      carry = x % 10
    }
    big_trim(mut a)
    carry
  }
}

@noalloc
pub fn big_word(a: Big) -> u64 uses {} {
  big_digit(a, 0) + big_digit(a, 1) * 1000000000
}

@noalloc
pub fn big_mul_word(mut a: Big, factor: u64) -> () uses {} {
  let factor_wide: u128 = core@1/int.widen(factor)
  let mut carry: u128 = 0
  let mut i: u64 = 0
  while i < a.used {
    let limb: u128 = core@1/int.widen(a.limbs[a.first + i])
    let x = limb * factor_wide + carry
    a.limbs[a.first + i] = core@1/int.narrow(x % 1000000000)
    carry = x / 1000000000
    i += 1
  }
  while carry != 0 {
    a.limbs[a.first + a.used] = core@1/int.narrow(carry % 1000000000)
    a.used += 1
    carry /= 1000000000
  }
}
