// Internal fixed decimal integer: 128 base-10^9 limbs, 1152 decimal digits.
// The largest parser denominator is 10^1125; no heap bigint or input limit.
pub type Big {
  limbs: Inline[u64, 128],
  used: u64,
  first: u64,
}

@noalloc
pub fn big_from_word(value: u64) -> Big uses {} {
  let mut a = Big(
    limbs: [
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64,
      0u64
    ],
    used: 0,
    first: 0
  )
  let mut x = value
  while x != 0 {
    a.limbs[a.used] = x % 1000000000
    a.used += 1
    x /= 1000000000
  }
  a
}

@noalloc
pub fn big_digit(a: Big, i: u64) -> u64 uses {} {
  if i < a.used {
    a.limbs[a.first + i]
  } else {
    0
  }
}

@noalloc
pub fn big_trim(mut a: Big) -> () uses {} {
  while a.used > 0 && a.limbs[a.first + a.used - 1] == 0 {
    a.used -= 1
  }
}

@noalloc
pub fn big_mul(mut a: Big, factor: u64) -> () uses {} {
  let mut carry: u64 = 0
  let mut i: u64 = 0
  while i < a.used {
    let x = a.limbs[a.first + i] * factor + carry
    a.limbs[a.first + i] = x % 1000000000
    carry = x / 1000000000
    i += 1
  }
  if carry != 0 {
    a.limbs[a.first + a.used] = carry
    a.used += 1
  }
}

@noalloc
pub fn big_add_small(mut a: Big, value: u64) -> () uses {} {
  let mut carry = value
  let mut i: u64 = 0
  while carry != 0 {
    if i == a.used {
      a.limbs[a.first + i] = 0
      a.used += 1
    }
    let x = a.limbs[a.first + i] + carry
    a.limbs[a.first + i] = x % 1000000000
    carry = x / 1000000000
    i += 1
  }
}

@noalloc
pub fn big_power(mut a: Big, base: u64, exponent: u64) -> () uses {} {
  let mut e = exponent
  if base == 10 {
    // Each 10^9 factor is one limb: shift whole limbs, then multiply the rest.
    let shift = e / 9
    e %= 9
    if a.used > 0 && shift > 0 {
      let mut i: u64 = copy a.used
      while i > 0 {
        i -= 1
        a.limbs[a.first + i + shift] = a.limbs[a.first + i]
      }
      i = 0
      while i < shift {
        a.limbs[a.first + i] = 0
        i += 1
      }
      a.used += shift
    }
  }
  // 5^27 and 2^63 are the largest powers below 2^64, and a limb times one fits
  // u128. Base 10 has e < 9 here and multiplies only its tail.
  let chunk: u64 = if base == 5 {
    27
  } else {
    63
  }
  let multiplier: u64 = if base == 5 {
    7450580596923828125
  } else {
    9223372036854775808
  }
  while e >= chunk {
    big_mul_word(mut a, multiplier)
    e -= chunk
  }
  let mut tail: u64 = 1
  while e > 0 {
    tail *= base
    e -= 1
  }
  if tail > 1 {
    big_mul_word(mut a, tail)
  }
}

// Compare a + bump with b without constructing another 1 KiB value.
@noalloc
pub fn big_compare(a: Big, b: Big, bump: bool) -> i32 uses {} {
  if !bump {
    if a.used != b.used {
      return if a.used < b.used {
        -1
      } else {
        1
      }
    }
    let mut i: u64 = a.used
    while i > 0 {
      i -= 1
      let x = a.limbs[a.first + i]
      let y = b.limbs[b.first + i]
      if x != y {
        return if x < y {
          -1
        } else {
          1
        }
      }
    }
    return 0
  }
  let mut successor = a
  big_add_small(mut successor, 1)
  big_compare(successor, b, false)
}

@noalloc
pub fn big_subtract(mut a: Big, b: Big) -> () uses {} {
  let mut borrow: u64 = 0
  let mut i: u64 = 0
  while i < a.used {
    let x = a.limbs[a.first + i]
    let y = borrow + if i < b.used {
      b.limbs[b.first + i]
    } else {
      0
    }
    if x < y {
      a.limbs[a.first + i] = x + 1000000000 - y
      borrow = 1
    } else {
      a.limbs[a.first + i] = x - y
      borrow = 0
    }
    i += 1
  }
  big_trim(mut a)
}

// Shift `remainder` left by `bits` (at most 26) and divide it by `divisor`,
// keeping the remainder: one quotient word instead of `bits` doubling steps.
// Needs remainder < divisor, so the quotient is below 2^bits. The estimate
// from the divisor's top two limbs is never low and at most one too high.
@noalloc
pub fn big_quotient(mut remainder: Big, divisor: Big, bits: u64) -> u64 uses {} {
  big_mul_word(mut remainder, 1u64 << bits)
  let low: u64 = if divisor.used > 2 {
    divisor.used - 2
  } else {
    0
  }
  let mut top: u128 = 0
  let mut i: u64 = copy divisor.used
  while i > low {
    i -= 1
    top = top * 1000000000 + core@1/int.widen(divisor.limbs[divisor.first + i])
  }
  let mut high: u128 = 0
  i = copy remainder.used
  while i > low {
    i -= 1
    high = high * 1000000000 + core@1/int.widen(remainder.limbs[remainder.first + i])
  }
  let mut quotient: u64 = core@1/int.narrow(high / top)
  if quotient == 0 {
    return 0
  }
  let mut product = divisor
  big_mul_word(mut product, quotient)
  while big_compare(product, remainder, false) > 0 {
    big_subtract(mut product, divisor)
    quotient -= 1
  }
  big_subtract(mut remainder, product)
  quotient
}

@noalloc
pub fn big_divide(mut a: Big, places: u64) -> u64 uses {} {
  if places == 9 {
    let remainder = big_digit(a, 0)
    if a.used > 0 {
      a.first += 1
      a.used -= 1
    }
    remainder
  } else {
    let mut carry: u64 = 0
    let mut i: u64 = copy a.used
    while i > 0 {
      i -= 1
      let x = carry * 1000000000 + a.limbs[a.first + i]
      a.limbs[a.first + i] = x / 10
      carry = x % 10
    }
    big_trim(mut a)
    carry
  }
}

@noalloc
pub fn big_word(a: Big) -> u64 uses {} {
  big_digit(a, 0) + big_digit(a, 1) * 1000000000
}

@noalloc
pub fn big_mul_word(mut a: Big, factor: u64) -> () uses {} {
  let factor_wide: u128 = core@1/int.widen(factor)
  let mut carry: u128 = 0
  let mut i: u64 = 0
  while i < a.used {
    let limb: u128 = core@1/int.widen(a.limbs[a.first + i])
    let x = limb * factor_wide + carry
    a.limbs[a.first + i] = core@1/int.narrow(x % 1000000000)
    carry = x / 1000000000
    i += 1
  }
  while carry != 0 {
    a.limbs[a.first + a.used] = core@1/int.narrow(carry % 1000000000)
    a.used += 1
    carry /= 1000000000
  }
}
