// Sign/prefix placement follows Rust core::fmt::Formatter. Padding uses cells.
// Each side emits whole fills, then a space when a wide fill cannot fit.
@preserves_unique(out)
pub fn repeat(mut out: List[u8], fill: char, count: u64) -> () uses {} {
  if count == 0 {
    return
  }
  if core@1/char.to_u32(fill) < 128 {
    let mut at: u64 = 0
    while at < count {
      char.format_into(fill, mut out)
      at += 1
    }
    return
  }
  let rendered = char.to_string(fill)
  let cells = text.display_width(rendered)
  let mut remaining = count
  while remaining >= cells {
    text.append(mut out, rendered)
    remaining -= cells
  }
  if remaining != 0 {
    char.format_into(' ', mut out)
  }
}

@noalloc
pub fn padding(width: u64, length: u64, align: u64, numeric: bool) -> (u64, u64) uses {} {
  let count = if width > length {
    width - length
  } else {
    0u64
  }
  let left = if align == 1 || align == 0 && !numeric {
    0u64
  } else if align == 3 {
    count / 2
  } else {
    count
  }
  (left, count - left)
}

// Pads the text appended since byte `start` to `width` display cells. Right padding
// is appended; left padding is appended, then rotated in front of the text.
@preserves_unique(out)
pub fn pad_from(
  start: u64,
  fill: char,
  align: u64,
  width: u64,
  numeric: bool,
  mut out: List[u8]
) -> () uses {} {
  if width == 0 {
    return
  }
  let end = core@1/list.len(out)
  // ASCII singleton clusters need no temporary String. CR/LF is one cluster.
  let mut count: u64 = 0
  let mut ascii = true
  let mut at = start
  while at < end {
    if out[at] >= 128u8 {
      ascii = false
      break
    }
    count += 1
    if out[at] == 13u8 && at + 1 < end && out[at + 1] == 10u8 {
      at += 1
    }
    at += 1
  }
  if !ascii {
    let mut suffix: List[u8] = []
    at = start
    while at < end {
      core@1/list.push(mut suffix, out[at])
      at += 1
    }
    count = text.display_width(text.finish_valid(take suffix))
  }
  let (left, right) = padding(width, count, align, numeric)
  if left > 0 {
    repeat(mut out, fill, left)
    let total = core@1/list.len(out)
    reverse(mut out, start, end)
    reverse(mut out, end, total)
    reverse(mut out, start, total)
  }
  repeat(mut out, fill, right)
}

fn reverse(mut out: List[u8], from: u64, to: u64) -> () uses {} {
  let mut low = from
  let mut high = to
  while high > low + 1 {
    high -= 1
    let byte = out[low]
    out[low] = out[high]
    out[high] = byte
    low += 1
  }
}

// Emits left padding, then the sign and radix prefix. Returns right padding.
@preserves_unique(out)
pub fn begin(
  length: u64,
  negative: bool,
  prefix: String,
  fill: char,
  align: u64,
  width: u64,
  flags: u64,
  mut out: List[u8]
) -> u64 uses {} {
  let sign = negative || flags & 1 != 0
  let total = length + core@1/string.byte_len(prefix) + if sign {
    1u64
  } else {
    0u64
  }
  let (left, right) = padding(width, total, align, true)
  let zero = flags & 4 != 0
  if !zero {
    repeat(mut out, fill, left)
  }
  if negative {
    core@1/list.push(mut out, 45u8)
  } else if sign {
    core@1/list.push(mut out, 43u8)
  }
  text.append(mut out, prefix)
  if zero {
    repeat(mut out, '0', left + right)
    0
  } else {
    right
  }
}

@preserves_unique(out)
pub fn integer(
  value: u128,
  negative: bool,
  fill: char,
  align: u64,
  width: u64,
  precision: u64,
  flags: u64,
  kind: u64,
  mut out: List[u8]
) -> () uses {} {
  let radix: u128 = if kind == 120 || kind == 88 {
    16
  } else if kind == 98 {
    2
  } else if kind == 111 {
    8
  } else {
    10
  }
  let prefix = if flags & 2 == 0 || kind == 0 {
    ""
  } else if kind == 98 {
    "0b"
  } else if kind == 111 {
    "0o"
  } else {
    "0x"
  }
  let mut digits: Inline[u8, 128] = [
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8
  ]
  let mut remaining = value
  let mut count: u64 = 0
  while true {
    let digit: u8 = core@1/int.narrow(remaining % radix)
    digits[count] = if digit < 10 {
      48 + digit
    } else if kind == 88 {
      65 + digit - 10
    } else {
      97 + digit - 10
    }
    count += 1
    remaining /= radix
    if remaining == 0 {
      break
    }
  }
  let right = begin(count, negative, prefix, fill, align, width, flags, mut out)
  while count > 0 {
    count -= 1
    core@1/list.push(mut out, digits[count])
  }
  repeat(mut out, fill, right)
}

// Rust core flt2dec/strategy/dragon.rs:296-409 at f6c1107f (MIT).
// Bounded Dragon integer scaling: m * 2^e * 10^p = (m * 5^p) * 2^(e+p).
// For e<0,p<=18,u64 m, the numerator has at most 106 bits and the result
// at most 124 bits. Remainder versus half, then quotient parity, rounds exactly
// as flt2dec dragon's final digit rule, without generating discarded digits.
const FIXED_POW5: Array[u64] = [
  1,
  5,
  25,
  125,
  625,
  3125,
  15625,
  78125,
  390625,
  1953125,
  9765625,
  48828125,
  244140625,
  1220703125,
  6103515625,
  30517578125,
  152587890625,
  762939453125,
  3814697265625
]

@noalloc
fn fixed_scaled(mantissa: u64, exponent: i32, precision: u64) -> Option[u128] uses {} {
  if precision > 18 || exponent >= 0 {
    return None()
  }
  let places: i32 = core@1/int.narrow(precision)
  let shift = exponent + places
  let factor: u128 = core@1/int.widen(FIXED_POW5[precision])
  let numerator: u128 = core@1/int.widen(mantissa) * factor
  let mut rounded: u128 = 0
  if shift >= 0 {
    let left: u128 = core@1/int.narrow(shift)
    rounded = numerator << left
  } else if shift > -128 {
    let right: u128 = core@1/int.narrow(-shift)
    rounded = numerator >> right
    let mask = (1u128 << right) - 1
    let remainder = numerator & mask
    let halfway = 1u128 << right - 1
    if remainder > halfway || remainder == halfway && rounded % 2 != 0 {
      rounded += 1
    }
  }
  // shift<=-128 is below half a unit: numerator is strictly below 2^106.
  Some(rounded)
}

// itoa's four-digit count loop. Both parts below fit u64: for e<0 the whole
// part is at most 2^63, and the fraction is below 10^18.
@noalloc
fn fixed_word_digits(value: u64) -> u64 uses {} {
  let mut remaining = value
  let mut count: u64 = 1
  while remaining >= 10000 {
    remaining /= 10000
    count += 4
  }
  count + if remaining >= 1000 {
    3u64
  } else if remaining >= 100 {
    2u64
  } else if remaining >= 10 {
    1u64
  } else {
    0u64
  }
}

fn fixed_scaled_into(
  scaled: u128,
  negative: bool,
  fill: char,
  align: u64,
  width: u64,
  precision: u64,
  flags: u64,
  mut out: List[u8]
) -> () uses {} {
  let places: u128 = core@1/int.widen(precision)
  let scale: u128 = core@1/int.widen(FIXED_POW5[precision]) * (1u128 << places)
  let whole_value: u64 = core@1/int.narrow(scaled / scale)
  let fraction: u64 = core@1/int.narrow(scaled % scale)
  let whole = fixed_word_digits(whole_value)
  let length = whole + if precision > 0 {
    precision + 1
  } else {
    0u64
  }
  let right = begin(length, negative, "", fill, align, width, flags, mut out)
  internal.decimal.append_u64(mut out, whole_value, false)
  if precision > 0 {
    core@1/list.push(mut out, 46u8)
    let fraction_width = if fraction == 0 {
      0u64
    } else {
      fixed_word_digits(fraction)
    }
    let zeros: Bytes = b"000000000000000000"
    core@1/bytes.append(
      mut out,
      core@1/bytes.slice(zeros, 0, precision - fraction_width)
    )
    if fraction != 0 {
      internal.decimal.append_u64(mut out, fraction, false)
    }
  }
  repeat(mut out, fill, right)
}

// The exact decimal expansion (the parser's DecimalSeq, every digit kept) rounded
// half to even at `precision` fractional digits (format_round.hir).
@preserves_unique(out)
pub fn fixed(
  mantissa: u64,
  exponent: i32,
  negative: bool,
  fill: char,
  align: u64,
  width: u64,
  precision: u64,
  flags: u64,
  kind: u64,
  mut out: List[u8]
) -> () uses {} {
  let places: i64 = core@1/int.narrow(precision)
  if let Some(scaled) = fixed_scaled(mantissa, exponent, precision) {
    fixed_scaled_into(scaled, negative, fill, align, width, precision, flags, mut out)
    return
  }
  let mut d = internal.decimal_seq.exact(mantissa, exponent, places)
  let point: i64 = core@1/int.widen(d.decimal_point)
  round_decimal(mut d, point + places)
  let whole: u64 = if d.decimal_point > 0 {
    core@1/int.narrow(d.decimal_point)
  } else {
    1
  }
  let right = begin(
    whole + if precision > 0 {
      precision + 1
    } else {
      0u64
    },
    negative,
    "",
    fill,
    align,
    width,
    flags,
    mut out
  )
  // Digit k of the integer and fraction places is d.digits[k] for the integer
  // places, offset by the decimal point; places past the kept digits are zeros.
  let first_place: i64 = if d.decimal_point > 0 {
    0
  } else {
    core@1/int.widen(d.decimal_point) - 1
  }
  let mut at: u64 = 0
  while at < whole + precision {
    if at == whole && precision > 0 {
      core@1/list.push(mut out, 46u8)
    }
    let place_offset: i64 = core@1/int.narrow(at)
    let index = first_place + place_offset
    let mut digit: u8 = 0
    if index >= 0 && index < core@1/int.narrow(d.num_digits) {
      let position: u64 = core@1/int.narrow(index)
      digit = d.digits[position]
    }
    core@1/list.push(mut out, 48u8 + digit)
    at += 1
  }
  repeat(mut out, fill, right)
}
