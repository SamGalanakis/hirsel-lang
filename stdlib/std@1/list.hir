// Rust alloc/src/vec/mod.rs:1801-1825 and spec_from_elem.rs:12-17,
// f6c1107f8be13e48465e12c0fd26e6a39fe18e4f (MIT).
// Source ownership primitives replace Rust's raw tail slice and clone loop.

/// Reserves once, then copies the value into each initialized element.
pub fn filled[T: copyable](n: u64, take value: T) -> List[T] uses {value} {
  let mut out: List[T] = []
  // Keep both constructors and truncation on the same native storage surface.
  // This no-op invokes the existing slot-addressable readiness requirement.
  core@1/list.truncate(mut out, 0)
  if n != 0 {
    core@1/list.reserve(mut out, n)
    for i in 0u64..n {
      core@1/list.push(mut out, copy value)
    }
  }
  take out
}

// Collection algorithms use ordinary source calls and ownership.
@noalloc
pub fn reverse[T](mut xs: unique List[T]) -> () {
  let mut lo: u64 = 0
  let mut hi = core@1/list.len(xs)
  while lo < hi {
    hi -= 1
    if lo < hi {
      core@1/list.swap(mut xs, lo, hi)
    }
    lo += 1
  }
}

@noalloc
fn reverse_range[T](mut xs: unique List[T], begin: u64, end: u64) -> () {
  let mut lo = begin
  let mut hi = end
  while lo < hi {
    hi -= 1
    if lo < hi {
      core@1/list.swap(mut xs, lo, hi)
    }
    lo += 1
  }
}

// Left rotation uses three reversals, each preserving element ownership.
@noalloc
pub fn rotate[T](mut xs: unique List[T], amount: u64) -> () {
  let len = core@1/list.len(xs)
  if len == 0 {
    return
  }
  let pivot = amount % len
  reverse_range(mut xs, 0, pivot)
  reverse_range(mut xs, pivot, len)
  reverse(mut xs)
}

// Pattern-defeating quicksort adapted from Zig's pdqContext (Rust pdqsort).
// Recurse on the smaller side; bad splits consume a logarithmic heap budget.
/// Sorts in place without allocation. Equal elements may change order.
@noalloc
pub fn sort[T](mut xs: unique List[T], by: @noalloc fn(T, T) -> i32 uses {}) -> () uses {} {
  let len = core@1/list.len(xs)
  let mut budget: u64 = 0
  let mut size = len
  while size > 1 {
    budget += 1
    size /= 2
  }
  quicksort(mut xs, 0, len, budget, by)
}

@noalloc
fn insertion[T](
  mut xs: unique List[T],
  begin: u64,
  end: u64,
  by: @noalloc fn(T, T) -> i32 uses {}
) -> () uses {} {
  let mut i = begin
  while i < end {
    let mut j = i
    while j > begin && by(xs[j], xs[j - 1]) < 0 {
      core@1/list.swap(mut xs, j, j - 1)
      j -= 1
    }
    i += 1
  }
}

// The pivot hint is only a hint: verify ordering and repair at most five
// inversions. The bounded number of scans/shifts keeps this linear.
@noalloc
fn partial_insertion[T](
  mut xs: unique List[T],
  begin: u64,
  end: u64,
  by: @noalloc fn(T, T) -> i32 uses {}
) -> bool uses {} {
  let mut i = begin + 1
  for _ in 0u64..5u64 {
    while i < end && by(xs[i - 1], xs[i]) <= 0 {
      i += 1
    }
    if i == end {
      return true
    }
    if end - begin < 50 {
      return false
    }
    core@1/list.swap(mut xs, i, i - 1)
    let mut left = i - 1
    while left > begin && by(xs[left], xs[left - 1]) < 0 {
      core@1/list.swap(mut xs, left, left - 1)
      left -= 1
    }
    let mut right = i + 1
    while right < end && by(xs[right], xs[right - 1]) < 0 {
      core@1/list.swap(mut xs, right, right - 1)
      right += 1
    }
  }
  false
}

@noalloc
fn sort_three[T](
  mut xs: unique List[T],
  a: u64,
  b: u64,
  c: u64,
  by: @noalloc fn(T, T) -> i32 uses {}
) -> u64 uses {} {
  let mut swaps: u64 = 0
  if by(xs[b], xs[a]) < 0 {
    core@1/list.swap(mut xs, a, b)
    swaps += 1
  }
  if by(xs[c], xs[b]) < 0 {
    core@1/list.swap(mut xs, b, c)
    swaps += 1
  }
  if by(xs[b], xs[a]) < 0 {
    core@1/list.swap(mut xs, a, b)
    swaps += 1
  }
  swaps
}

@noalloc
fn sift_range[T](
  mut xs: unique List[T],
  base: u64,
  begin: u64,
  end: u64,
  by: @noalloc fn(T, T) -> i32 uses {}
) -> () uses {} {
  let mut root = begin
  while root < end / 2 {
    let mut child = root * 2 + 1
    if child + 1 < end && by(xs[base + child], xs[base + child + 1]) < 0 {
      child += 1
    }
    if by(xs[base + root], xs[base + child]) >= 0 {
      return
    }
    core@1/list.swap(mut xs, base + root, base + child)
    root = child
  }
}

@noalloc
fn heapsort_range[T](
  mut xs: unique List[T],
  begin: u64,
  end: u64,
  by: @noalloc fn(T, T) -> i32 uses {}
) -> () uses {} {
  let len = end - begin
  let mut start = len / 2
  while start > 0 {
    start -= 1
    sift_range(mut xs, begin, start, len, by)
  }
  let mut remaining = len
  while remaining > 1 {
    remaining -= 1
    core@1/list.swap(mut xs, begin, begin + remaining)
    sift_range(mut xs, begin, 0, remaining, by)
  }
}

@noalloc
fn minimum(a: u64, b: u64) -> u64 uses {} {
  if a < b {
    a
  } else {
    b
  }
}

// Classify two cache-sized blocks before swapping, so unpredictable key
// comparisons become bitmap writes rather than branches on every element.
@noalloc
fn partition_range[T](
  mut xs: unique List[T],
  begin: u64,
  end: u64,
  by: @noalloc fn(T, T) -> i32 uses {}
) -> u64 uses {} {
  let mut left = begin + 1
  let mut right = end
  while left < right && by(xs[left], xs[begin]) < 0 {
    left += 1
  }
  while left < right && by(xs[right - 1], xs[begin]) >= 0 {
    right -= 1
  }
  // libc++ sort.h __populate_{left,right}_bitset / __swap_bitmap_pos.
  // Each bit is one misplaced position, consumed low-to-high for paired
  // swaps and high-to-low for the tail, exactly like the former offset lists.
  let mut offsets_left: u64 = 0
  let mut offsets_right: u64 = 0
  let mut base_left = left
  let mut base_right = right
  while left < right {
    // At most 64 positions per block, so every bitmap shift is below 64.
    let unknown = right - left
    let take_left = if offsets_left == 0 {
      if offsets_right == 0 {
        minimum(64, unknown / 2)
      } else {
        minimum(64, unknown)
      }
    } else {
      0u64
    }
    let take_right = if offsets_right == 0 {
      minimum(64, unknown - take_left)
    } else {
      0u64
    }
    // The unique list and pivot are only borrowed during classification.
    // End the pivot loan before any swap; callbacks remain ordinary fallible
    // calls in left-then-right order. Empty blocks perform no pivot read.
    if take_left != 0 {
      let pivot_value = xs[begin]
      for k in 0u64..take_left {
        let misplaced = if by(xs[left + k], pivot_value) >= 0 {
          1u64
        } else {
          0u64
        }
        offsets_left = offsets_left | misplaced << k
      }
    }
    left += take_left
    if take_right != 0 {
      let pivot_value = xs[begin]
      for k in 0u64..take_right {
        let misplaced = if by(xs[right - 1 - k], pivot_value) < 0 {
          1u64
        } else {
          0u64
        }
        offsets_right = offsets_right | misplaced << k
      }
    }
    right -= take_right
    while offsets_left != 0 && offsets_right != 0 {
      let offset_left = core@1/int.trailing_zeros(offsets_left)
      let offset_right = core@1/int.trailing_zeros(offsets_right)
      core@1/list.swap(mut xs, base_left + offset_left, base_right - 1 - offset_right)
      offsets_left = offsets_left & offsets_left - 1
      offsets_right = offsets_right & offsets_right - 1
    }
    if offsets_left == 0 {
      base_left = left
    }
    if offsets_right == 0 {
      base_right = right
    }
  }
  while offsets_left != 0 {
    let offset = 63u64 - core@1/int.leading_zeros(offsets_left)
    offsets_left = offsets_left ^ 1u64 << offset
    right -= 1
    core@1/list.swap(mut xs, base_left + offset, right)
    left = right
  }
  while offsets_right != 0 {
    let offset = 63u64 - core@1/int.leading_zeros(offsets_right)
    offsets_right = offsets_right ^ 1u64 << offset
    core@1/list.swap(mut xs, base_right - 1 - offset, left)
    left += 1
  }
  let pivot = left - 1
  core@1/list.swap(mut xs, begin, pivot)
  pivot
}

@noalloc
fn quicksort[T](
  mut xs: unique List[T],
  begin: u64,
  end: u64,
  limit: u64,
  by: @noalloc fn(T, T) -> i32 uses {}
) -> () uses {} {
  let mut lo = begin
  let mut hi = end
  let mut budget = limit
  let mut balanced = true
  while hi - lo > 24 {
    let len = hi - lo
    if budget == 0 {
      heapsort_range(mut xs, lo, hi, by)
      return
    }
    if !balanced {
      // Deterministic xorshift shuffling breaks adversarial pivot patterns.
      let mut state = len
      for offset in 0u64..3u64 {
        state = state ^ state << 13u64
        state = state ^ state >> 7u64
        state = state ^ state << 17u64
        core@1/list.swap(mut xs, lo + len / 2 - 1 + offset, lo + state % len)
      }
      budget -= 1
    }
    let a = lo + len / 4
    let mut pivot = lo + len / 2
    let c = lo + len / 4 * 3
    let mut swaps: u64 = 0
    if len >= 50 {
      swaps += sort_three(mut xs, a - 1, a, a + 1, by)
      swaps += sort_three(mut xs, pivot - 1, pivot, pivot + 1, by)
      swaps += sort_three(mut xs, c - 1, c, c + 1, by)
    }
    swaps += sort_three(mut xs, a, pivot, c, by)
    if swaps == 12 {
      reverse_range(mut xs, lo, hi)
      pivot = hi - 1 - (pivot - lo)
      swaps = 0
    }
    if swaps == 0 && balanced && partial_insertion(mut xs, lo, hi, by) {
      return
    }
    core@1/list.swap(mut xs, lo, pivot)
    // The preceding pivot is a lower bound for every element in this range.
    // Skip an entire equal partition rather than repeatedly splitting it.
    if lo > 0 && by(xs[lo - 1], xs[lo]) >= 0 {
      let mut left = lo + 1
      let mut right = hi
      while left < right {
        while left < right && by(xs[lo], xs[left]) >= 0 {
          left += 1
        }
        while left < right && by(xs[lo], xs[right - 1]) < 0 {
          right -= 1
        }
        if left < right {
          right -= 1
          core@1/list.swap(mut xs, left, right)
          left += 1
        }
      }
      lo = left
    } else {
      let mid = partition_range(mut xs, lo, hi, by)
      let left_len = mid - lo
      let right_len = hi - mid - 1
      balanced = left_len >= len / 8 && right_len >= len / 8
      if left_len < right_len {
        quicksort(mut xs, lo, mid, budget, by)
        lo = mid + 1
      } else {
        quicksort(mut xs, mid + 1, hi, budget, by)
        hi = mid
      }
    }
  }
  insertion(mut xs, lo, hi, by)
}

// First equal element; callers provide input sorted by the same comparator.
@noalloc
pub fn binary_search[T](xs: List[T], value: T, by: @noalloc fn(T, T) -> i32 uses {}) -> Option[
  u64
] uses {} {
  let mut lo: u64 = 0
  let mut hi = core@1/list.len(xs)
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if by(xs[mid], value) < 0 {
      lo = mid + 1
    } else {
      hi = mid
    }
  }
  if lo < core@1/list.len(xs) && by(xs[lo], value) == 0 {
    Some(lo)
  } else {
    None()
  }
}

@noalloc
pub fn find[T](xs: List[T], predicate: @noalloc fn(T) -> bool) -> Option[u64] uses {xs, predicate} {
  let mut i: u64 = 0
  for item in xs {
    if predicate(item) {
      return Some(i)
    }
    i += 1
  }
  None()
}

pub fn map[T, U](xs: List[T], f: fn(T) -> U) -> List[U] uses {xs, f} {
  let mut out: List[U] = []
  for item in xs {
    core@1/list.push(mut out, f(item))
  }
  take out
}

pub fn filter[T](take xs: List[T], predicate: fn(T) -> bool) -> List[T] uses {xs, predicate} {
  let mut out: List[T] = []
  for item in take xs {
    if predicate(item) {
      core@1/list.push(mut out, take item)
    }
  }
  take out
}

pub fn fold[T, A](xs: List[T], take initial: A, f: fn(take A, T) -> A) -> A uses {xs, initial, f} {
  let mut accumulator = take initial
  for item in xs {
    accumulator = f(take accumulator, item)
  }
  take accumulator
}

@noalloc
pub fn all[T](xs: List[T], predicate: @noalloc fn(T) -> bool) -> bool uses {xs, predicate} {
  for item in xs {
    if !predicate(item) {
      return false
    }
  }
  true
}

@noalloc
pub fn any[T](xs: List[T], predicate: @noalloc fn(T) -> bool) -> bool uses {xs, predicate} {
  for item in xs {
    if predicate(item) {
      return true
    }
  }
  false
}

pub fn partition[T](take xs: List[T], predicate: fn(T) -> bool) -> (List[T], List[T]) uses {xs, predicate} {
  let mut yes: List[T] = []
  let mut no: List[T] = []
  for item in take xs {
    if predicate(item) {
      core@1/list.push(mut yes, take item)
    } else {
      core@1/list.push(mut no, take item)
    }
  }
  (take yes, take no)
}

pub fn concat[T](take a: List[T], take b: List[T]) -> List[T] uses {a, b} {
  let mut out = take a
  for item in take b {
    core@1/list.push(mut out, take item)
  }
  take out
}

pub fn dedup[T: data](take xs: List[T]) -> List[T] uses {xs} {
  let mut out: List[T] = []
  for item in take xs {
    let len = core@1/list.len(out)
    if len == 0 || out[len - 1] != item {
      core@1/list.push(mut out, take item)
    }
  }
  take out
}
