// Port of Go src/compress/flate/inflate.go (decompressor.nextBlock, readHuffman,
// huffmanBlock, dataBlock and the huffmanDecoder.init completeness rule),
// src/compress/gzip/gunzip.go and src/compress/zlib/reader.go, golang/go
// ebe2feefc400f813aefdc8a036e66d2619da6649 (BSD-3-Clause; third-party/NOTICES.md).
// Whole-buffer decoding with an output bound replaces the streaming readers.
// Codes longer than Go's chunk table use a canonical count/symbol walk (RFC 1951
// section 3.2.2) instead of link tables. Unlike Go, bytes after the stream are
// an error.
pub type FlateError = Truncated | Corrupt(u64) | Header | Checksum | TooLarge | TrailingData(
  u64
)

// Input bit cursor: `pos` is the next unread byte and `buf` holds `count`
// unread bits, least significant first (RFC 1951 section 3.1.1).
type Bits {
  pos: u64,
  buf: u64,
  count: u64,
}

// Codes of each length 1..15 (`count[0]` counts unused symbols), the symbols in
// canonical code order, and the longest code length (0 for an empty code).
type Huffman {
  count: List[u64],
  symbol: List[u64],
  max: u64,
}

// The fixed code (RFC 1951 section 3.2.6) is decoded without tables.
type Codes = Fixed | Dynamic(Huffman, Huffman)

// The order of the code length code lengths (RFC 1951 section 3.2.7).
const ORDER: Inline[u64, 19] = [
  16,
  17,
  18,
  0,
  8,
  7,
  9,
  6,
  10,
  5,
  11,
  4,
  12,
  3,
  13,
  2,
  14,
  1,
  15
]

// CRC-32 (IEEE, RFC 1952 section 8) four bits at a time: CRC[n] is the
// remainder of nibble n under the reflected polynomial 0xEDB88320.
const CRC: Inline[u32, 16] = [
  0x00000000,
  0x1DB71064,
  0x3B6E20C8,
  0x26D930AC,
  0x76DC4190,
  0x6B6B51F4,
  0x4DB26158,
  0x5005713C,
  0xEDB88320,
  0xF00F9344,
  0xD6D6A3E8,
  0xCB61B38C,
  0x9B64C2B0,
  0x86D3D2D4,
  0xA00AE278,
  0xBDBDF21C
]

fn zeros(n: u64) -> unique List[u64] uses {} {
  let mut out: List[u64] = []
  let mut i: u64 = 0
  while i < n {
    core@1/list.push(mut out, 0)
    i += 1
  }
  take out
}

// Input bytes holding consumed bits: Go's roffset, less whole buffered bytes.
@noalloc
fn consumed(s: Bits) -> u64 uses {} {
  s.pos - s.count / 8
}

// Go moreBits: input is read one byte at a time, only as bits are needed.
fn bits(data: Bytes, mut s: Bits, n: u64) -> Result[u64, FlateError] uses {} {
  if n == 0 {
    return Ok(0)
  }
  while s.count < n {
    if s.pos >= core@1/bytes.len(data) {
      return Error(Truncated())
    }
    let byte: u64 = core@1/int.widen(data[s.pos])
    s.buf = s.buf | byte << s.count
    s.pos += 1
    s.count += 8
  }
  let value = s.buf & (1u64 << n) - 1
  s.buf = s.buf >> n
  s.count -= n
  Ok(value)
}

// Go huffmanDecoder.init: a code must be complete, except for the degenerate
// single one-bit code zlib accepts; an empty code is accepted and fails on use.
fn huffman(lengths: List[u64], start: u64, n: u64) -> Option[Huffman] uses {} {
  let mut count = zeros(16)
  let mut max: u64 = 0
  let mut i: u64 = 0
  while i < n {
    let length = lengths[start + i]
    count[length] += 1
    if length > max {
      max = length
    }
    i += 1
  }
  if max > 0 {
    let mut left: u64 = 1
    let mut length: u64 = 1
    while length <= 15 {
      left = left * 2
      if count[length] > left {
        return None()
      }
      left -= count[length]
      length += 1
    }
    if left > 0 && !(max == 1 && count[1] == 1) {
      return None()
    }
  }
  // RFC 1951 section 3.2.2: symbols ordered by code length, then by value.
  let mut offsets = zeros(16)
  let mut length: u64 = 1
  while length < 15 {
    offsets[length + 1] = offsets[length] + count[length]
    length += 1
  }
  let mut symbol = zeros(n)
  i = 0
  while i < n {
    let code_length = lengths[start + i]
    if code_length != 0 {
      symbol[offsets[code_length]] = i
      offsets[code_length] += 1
    }
    i += 1
  }
  Some(Huffman(count: take count, symbol: take symbol, max: max))
}

// Loads whole input bytes while fewer than `n` bits are buffered.
@noalloc
fn fill(data: Bytes, mut s: Bits, n: u64) -> () uses {} {
  let size = core@1/bytes.len(data)
  while s.count < n && s.pos < size {
    let byte: u64 = core@1/int.widen(data[s.pos])
    s.buf = s.buf | byte << s.count
    s.pos += 1
    s.count += 8
  }
}

// The low eight bits of `b` reversed (Bit Twiddling Hacks, 64-bit multiply).
@noalloc
fn reverse8(b: u64) -> u64 uses {} {
  (b * 0x0202020202 & 0x010884422010) % 1023
}

// Go's chunk table without links: entry `symbol << 4 | length` for every code
// of at most FAST bits, indexed by the code's bits in stream order; 0 sends a
// longer code, or a bit sequence matching none, to the canonical walk.
const FAST: u64 = 9

fn fast_table(h: Huffman) -> unique List[u64] uses {} {
  let width = if h.max < FAST {
    h.max
  } else {
    FAST
  }
  let size = 1u64 << width
  let mut table = zeros(size)
  let mut code: u64 = 0
  let mut index: u64 = 0
  let mut length: u64 = 1
  while length <= width {
    let mut left = h.count[length]
    while left > 0 {
      let first = if length < 9 {
        reverse8(code << 8 - length)
      } else {
        reverse8(code & 255) << 1 | code >> 8
      }
      let entry = h.symbol[index] << 4 | length
      let mut k = first
      while k < size {
        table[k] = entry
        k += 1u64 << length
      }
      code += 1
      index += 1
      left -= 1
    }
    code = code * 2
    length += 1
  }
  take table
}

// Go huffSym: a bit sequence matching no code of at most `max` bits is corrupt.
// `table` is empty until fast_table builds it.
fn decode(data: Bytes, mut s: Bits, h: Huffman, table: List[u64]) -> Result[
  u64,
  FlateError
] uses {} {
  fill(data, mut s, h.max)
  let buf = s.buf
  let available = s.count
  let size = core@1/list.len(table)
  if size > 0 {
    let entry = table[buf & size - 1]
    let length = entry & 15
    if entry != 0 && length <= available {
      s.buf = buf >> length
      s.count = available - length
      return Ok(entry >> 4)
    }
  }
  let mut code: u64 = 0
  let mut first: u64 = 0
  let mut index: u64 = 0
  let mut length: u64 = 1
  while length <= h.max {
    if length > available {
      return Error(Truncated())
    }
    code = code | buf >> length - 1 & 1
    let count = h.count[length]
    let next = first + count
    if code < next {
      s.buf = buf >> length
      s.count = available - length
      return Ok(h.symbol[index + code - first])
    }
    index += count
    first = next * 2
    code = code * 2
    length += 1
  }
  Error(Corrupt(consumed(s)))
}

// RFC 1951 section 3.2.6, read most significant bit first: 7-bit codes 0..23
// are 256..279, 8-bit codes 48..191 are 0..143 and 192..199 are 280..287, and
// 9-bit codes 400..511 are 144..255.
fn fixed_literal(data: Bytes, mut s: Bits) -> Result[u64, FlateError] uses {} {
  fill(data, mut s, 9)
  let code = reverse8(s.buf & 255)
  let (symbol, length) = if code >> 1 < 24 {
    ((code >> 1) + 256, 7u64)
  } else if code < 192 {
    (code - 48, 8u64)
  } else if code < 200 {
    (code + 88, 8u64)
  } else {
    ((code * 2 | s.buf >> 8 & 1) - 256, 9u64)
  }
  if length > s.count {
    return Error(Truncated())
  }
  s.buf = s.buf >> length
  s.count -= length
  Ok(symbol)
}

// A dynamic block decodes its first symbols by the canonical walk and builds
// lookup tables only once it is long enough to repay them.
const WALKED: u64 = 64

// Go huffmanBlock. A distance may reach back only within this stream's output,
// which starts at `base`.
@preserves_unique(out)
fn codes_block(
  data: Bytes,
  mut s: Bits,
  codes: Codes,
  base: u64,
  limit: u64,
  mut out: List[u8]
) -> Result[(), FlateError] uses {} {
  let mut literal_table: List[u64] = []
  let mut distance_table: List[u64] = []
  let mut decoded: u64 = 0
  while true {
    decoded += 1
    let symbol = match codes {
      Fixed() => fixed_literal(data, mut s)?,
      Dynamic(literal_code, distance_code) => {
        if decoded == WALKED {
          literal_table = fast_table(literal_code)
          if distance_code.max > 0 {
            distance_table = fast_table(distance_code)
          }
        }
        decode(data, mut s, literal_code, literal_table)?
      },
    }
    if symbol < 256 {
      if core@1/list.len(out) >= limit {
        return Error(TooLarge())
      }
      core@1/list.push(mut out, core@1/int.truncate(symbol))
    } else if symbol == 256 {
      return Ok(())
    } else {
      let (start, extra) = if symbol < 265 {
        (symbol - 254, 0u64)
      } else if symbol < 269 {
        (symbol * 2 - 519, 1u64)
      } else if symbol < 273 {
        (symbol * 4 - 1057, 2u64)
      } else if symbol < 277 {
        (symbol * 8 - 2149, 3u64)
      } else if symbol < 281 {
        (symbol * 16 - 4365, 4u64)
      } else if symbol < 285 {
        (symbol * 32 - 8861, 5u64)
      } else if symbol == 285 {
        (258u64, 0u64)
      } else {
        return Error(Corrupt(consumed(s)))
      }
      let length = start + bits(data, mut s, extra)?
      // The fixed distance code is 32 five-bit codes; Go rejects 30 and 31.
      let code = match codes {
        Fixed() => reverse8(bits(data, mut s, 5)? << 3),
        Dynamic(_, distance_code) => decode(data, mut s, distance_code, distance_table)?,
      }
      let back = if code < 4 {
        code + 1
      } else if code < 30 {
        let more = code - 2 >> 1
        let low = (code & 1) << more | bits(data, mut s, more)?
        (1u64 << more + 1) + 1 + low
      } else {
        return Error(Corrupt(consumed(s)))
      }
      let end = core@1/list.len(out)
      if back > end - base {
        return Error(Corrupt(consumed(s)))
      }
      if length > limit - end {
        return Error(TooLarge())
      }
      let mut i: u64 = 0
      while i < length {
        let byte = out[end - back + i]
        core@1/list.push(mut out, byte)
        i += 1
      }
    }
  }
  Ok(())
}

// Go readHuffman.
fn dynamic_codes(data: Bytes, mut s: Bits) -> Result[Codes, FlateError] uses {} {
  let header = bits(data, mut s, 14)?
  let nlit = (header & 31) + 257
  let ndist = (header >> 5 & 31) + 1
  let nclen = (header >> 10) + 4
  if nlit > 286 || ndist > 30 {
    return Error(Corrupt(consumed(s)))
  }
  let mut code_lengths = zeros(19)
  let mut i: u64 = 0
  while i < nclen {
    code_lengths[ORDER[i]] = bits(data, mut s, 3)?
    i += 1
  }
  let lengths_code = match huffman(code_lengths, 0, 19) {
    Some(code) => take code,
    None() => return Error(Corrupt(consumed(s))),
  }
  let n = nlit + ndist
  let mut lengths: List[u64] = []
  while core@1/list.len(lengths) < n {
    let symbol = decode(data, mut s, lengths_code, [])?
    if symbol < 16 {
      core@1/list.push(mut lengths, symbol)
    } else {
      let previous = core@1/list.len(lengths)
      let (repeat, value) = if symbol == 16 {
        if previous == 0 {
          return Error(Corrupt(consumed(s)))
        }
        (bits(data, mut s, 2)? + 3, lengths[previous - 1])
      } else if symbol == 17 {
        (bits(data, mut s, 3)? + 3, 0u64)
      } else {
        (bits(data, mut s, 7)? + 11, 0u64)
      }
      if previous + repeat > n {
        return Error(Corrupt(consumed(s)))
      }
      let mut j: u64 = 0
      while j < repeat {
        core@1/list.push(mut lengths, value)
        j += 1
      }
    }
  }
  match (huffman(lengths, 0, nlit), huffman(lengths, nlit, ndist)) {
    (Some(literal_code), Some(distance_code)) => Ok(
      Dynamic(take literal_code, take distance_code)
    ),
    _ => Error(Corrupt(consumed(s))),
  }
}

@noalloc
fn little_endian(data: Bytes, at: u64, n: u64) -> u64 uses {} {
  let mut value: u64 = 0
  let mut i: u64 = 0
  while i < n {
    let byte: u64 = core@1/int.widen(data[at + i])
    value = value | byte << 8 * i
    i += 1
  }
  value
}

// Go dataBlock: stored blocks start at a byte boundary.
@preserves_unique(out)
fn stored_block(data: Bytes, mut s: Bits, limit: u64, mut out: List[u8]) -> Result[
  (),
  FlateError
] uses {} {
  s.pos = consumed(s)
  s.buf = 0
  s.count = 0
  let size = core@1/bytes.len(data)
  if size - s.pos < 4 {
    s.pos = size
    return Error(Truncated())
  }
  let length = little_endian(data, s.pos, 2)
  let check = little_endian(data, s.pos + 2, 2)
  s.pos += 4
  if length ^ check != 65535 {
    return Error(Corrupt(s.pos))
  }
  if length > limit - core@1/list.len(out) {
    return Error(TooLarge())
  }
  if size - s.pos < length {
    return Error(Truncated())
  }
  let mut i: u64 = 0
  while i < length {
    core@1/list.push(mut out, data[s.pos + i])
    i += 1
  }
  s.pos += length
  Ok(())
}

// Decodes one DEFLATE stream starting at byte `start`, appending to `out`, and
// returns the offset after its final block.
@preserves_unique(out)
fn stream(data: Bytes, start: u64, limit: u64, mut out: List[u8]) -> Result[
  u64,
  FlateError
] uses {} {
  let mut s = Bits(pos: start, buf: 0, count: 0)
  let base = core@1/list.len(out)
  let mut last = false
  while !last {
    last = bits(data, mut s, 1)? == 1
    let kind = bits(data, mut s, 2)?
    if kind == 0 {
      stored_block(data, mut s, limit, mut out)?
    } else if kind == 1 {
      codes_block(data, mut s, Fixed(), base, limit, mut out)?
    } else if kind == 2 {
      let codes = dynamic_codes(data, mut s)?
      codes_block(data, mut s, codes, base, limit, mut out)?
    } else {
      return Error(Corrupt(consumed(s)))
    }
  }
  Ok(consumed(s))
}

/// Decodes a raw DEFLATE stream (RFC 1951) that ends exactly at the end of
/// `data`, producing at most `limit` bytes.
pub fn inflate(data: Bytes, limit: u64) -> Result[unique Bytes, FlateError] uses {} {
  let mut out: List[u8] = []
  let end = stream(data, 0, limit, mut out)?
  if end < core@1/bytes.len(data) {
    return Error(TrailingData(end))
  }
  Ok(core@1/bytes.from_list(take out))
}

@noalloc
fn crc_byte(crc: u32, byte: u8) -> u32 uses {} {
  let value: u32 = core@1/int.widen(byte)
  let c = crc ^ value
  let low: u64 = core@1/int.widen(c & 15)
  let next = c >> 4 ^ CRC[low]
  let high: u64 = core@1/int.widen(next & 15)
  next >> 4 ^ CRC[high]
}

@noalloc
fn crc_bytes(data: Bytes, start: u64, end: u64) -> u32 uses {} {
  let mut c = ~0u32
  let mut i = start
  while i < end {
    c = crc_byte(c, data[i])
    i += 1
  }
  ~c
}

@noalloc
fn crc_list(data: List[u8], start: u64) -> u32 uses {} {
  let mut c = ~0u32
  let mut i = start
  while i < core@1/list.len(data) {
    c = crc_byte(c, data[i])
    i += 1
  }
  ~c
}

// The offset after the zero byte ending a field that starts at `at`.
fn zero_terminated(data: Bytes, at: u64) -> Result[u64, FlateError] uses {} {
  let mut i = at
  while i < core@1/bytes.len(data) {
    if data[i] == 0 {
      return Ok(i + 1)
    }
    i += 1
  }
  Error(Truncated())
}

// Go Reader.readHeader and Read for one member; returns the offset after it.
@preserves_unique(out)
fn gzip_member(data: Bytes, start: u64, limit: u64, mut out: List[u8]) -> Result[
  u64,
  FlateError
] uses {} {
  let size = core@1/bytes.len(data)
  if size - start < 10 {
    return Error(Truncated())
  }
  if data[start] != 0x1F || data[start + 1] != 0x8B || data[start + 2] != 8 {
    return Error(Header())
  }
  let flags = data[start + 3]
  // RFC 1952 section 2.3.1.2: reserved flag bits must be zero (Go ignores them).
  if flags & 0xE0 != 0 {
    return Error(Header())
  }
  let mut at = start + 10
  if flags & 4 != 0 {
    if size - at < 2 {
      return Error(Truncated())
    }
    let extra = little_endian(data, at, 2)
    if size - at - 2 < extra {
      return Error(Truncated())
    }
    at += 2 + extra
  }
  if flags & 8 != 0 {
    at = zero_terminated(data, at)?
  }
  if flags & 16 != 0 {
    at = zero_terminated(data, at)?
  }
  if flags & 2 != 0 {
    if size - at < 2 {
      return Error(Truncated())
    }
    let expected: u64 = core@1/int.widen(crc_bytes(data, start, at) & 0xFFFF)
    if little_endian(data, at, 2) != expected {
      return Error(Header())
    }
    at += 2
  }
  let base = core@1/list.len(out)
  let end = stream(data, at, limit, mut out)?
  if size - end < 8 {
    return Error(Truncated())
  }
  let crc: u64 = core@1/int.widen(crc_list(out, base))
  let length = core@1/list.len(out) - base
  if little_endian(data, end, 4) != crc || little_endian(data, end + 4, 4) != length & 0xFFFFFFFF {
    return Error(Checksum())
  }
  Ok(end + 8)
}

/// Decodes gzip data (RFC 1952): one or more members, concatenated, producing
/// at most `limit` bytes in total. Bytes after a member must begin another.
pub fn gzip_decode(data: Bytes, limit: u64) -> Result[unique Bytes, FlateError] uses {} {
  let mut out: List[u8] = []
  let mut at = gzip_member(data, 0, limit, mut out)?
  while at < core@1/bytes.len(data) {
    at = gzip_member(data, at, limit, mut out)?
  }
  Ok(core@1/bytes.from_list(take out))
}

/// Decodes zlib data (RFC 1950) without a preset dictionary, producing at most
/// `limit` bytes. The stream must end exactly at the end of `data`.
pub fn zlib_decode(data: Bytes, limit: u64) -> Result[unique Bytes, FlateError] uses {} {
  let size = core@1/bytes.len(data)
  if size < 2 {
    return Error(Truncated())
  }
  let method = data[0]
  let flags = data[1]
  let check = little_endian(data, 1, 1) + 256 * little_endian(data, 0, 1)
  if method & 15 != 8 || method >> 4 > 7 || check % 31 != 0 || flags & 0x20 != 0 {
    return Error(Header())
  }
  let mut out: List[u8] = []
  let end = stream(data, 2, limit, mut out)?
  if size - end < 4 {
    return Error(Truncated())
  }
  // Adler-32 (RFC 1950 section 8.2), stored most significant byte first.
  let mut a: u64 = 1
  let mut b: u64 = 0
  for byte in out {
    let value: u64 = core@1/int.widen(byte)
    a = (a + value) % 65521
    b = (b + a) % 65521
  }
  let mut stored: u64 = 0
  let mut i: u64 = 0
  while i < 4 {
    stored = stored << 8 | little_endian(data, end + i, 1)
    i += 1
  }
  if stored != b << 16 | a {
    return Error(Checksum())
  }
  if end + 4 < size {
    return Error(TrailingData(end + 4))
  }
  Ok(core@1/bytes.from_list(take out))
}
