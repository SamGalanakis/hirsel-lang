// Thompson compiler and ordered Pike queues adapted from Go regexp/syntax
// {parse,compile,prog}.go and regexp/exec.go. No backtracking optimization.
// Go ebe2feef: syntax/parse.go:1137 (flags/names), syntax/compile.go:178
// (capture instructions), exec.go:314 (ordered capture threads), regexp.go:596
// (replacement), :1184 (Expand), unicode/letter.go:354 (SimpleFold).
// Copyright 2010-2011 The Go Authors. BSD-3-Clause; third-party/NOTICES.md.
@serializable
pub type CompileError = Syntax(u64) | ProgramTooLarge

@serializable
pub type MatchError = WorkLimit | InvalidCaptures

// Submatch zero is the whole match; None distinguishes an unmatched group
// from an empty match. All spans are UTF-8 byte offsets in the original text.
pub type Captures {
  spans: List[Option[Span]],
}

pub type Flags {
  fold_case: bool,
  multiline: bool,
  dot_newline: bool,
  ungreedy: bool,
}

pub fn default_flags() -> Flags uses {} {
  Flags(fold_case: false, multiline: false, dot_newline: false, ungreedy: false)
}

@serializable
pub type Span {
  start: u64,
  end: u64,
}

// Primitive kinds: 0 jump, 1 scalar class, 2 dot, 3 begin, 4 end,
// 5 word boundary, 6 non-boundary. Tree-only: 7 concat, 8 alternate, 9 repeat,
// 17 capture. VM: 10 split, 11 match, 12 capture, 13 folded class, 14 dot-all,
// 15 begin-line, 16 end-line.
type Node {
  kind: u8,
  ranges: List[(u32, u32)],
  negated: bool,
  left: u64,
  right: u64,
  min: u64,
  max: u64,
  unbounded: bool,
  lazy: bool,
  size: u64,
  nullable: bool,
}

// x is the preferred branch; capture instructions store the slot number in y.
type Inst {
  kind: u8,
  x: u64,
  y: u64,
  ranges: List[(u32, u32)],
  negated: bool,
}

pub opaque type Regex: copyable + inert + noalloc_drop uses {} {
  code: List[Inst],
  entry: u64,
  names: List[String],
  prefilter: PrefixPlan,
  fixed_captures: List[u64],
}

// The hot ordered VM sees only its original compiled fields. Optional search
// metadata belongs to the meta layer and is never copied with every thread.
type VmProgram {
  code: List[Inst],
  entry: u64,
  names: List[String],
}

fn vm_program(re: Regex) -> VmProgram in re uses {} {
  VmProgram(code: copy re.code, entry: re.entry, names: copy re.names)
}

type Input {
  scalars: List[char],
  offsets: List[u64],
  at: u64,
}

type Context {
  alternatives: Option[u64],
  sequence: Option[u64],
  atom: Option[u64],
  repeated: bool,
  flags: Flags,
  capture: u64,
}

type Tree {
  nodes: List[Node],
  limit: u64,
  names: List[String],
}

fn scalar_width(c: char) -> u64 uses {} {
  let cp = core@1/char.to_u32(c)
  if cp < 128 {
    1
  } else if cp < 2048 {
    2
  } else if cp < 65536 {
    3
  } else {
    4
  }
}

fn empty_node(kind: u8) -> Node uses {} {
  Node(
    kind: kind,
    ranges: [],
    negated: false,
    left: 0,
    right: 0,
    min: 0,
    max: 0,
    unbounded: false,
    lazy: false,
    size: 1,
    nullable: kind != 1 && kind != 2
  )
}

fn context(flags: Flags, capture: u64) -> Context uses {} {
  Context(
    alternatives: None(),
    sequence: None(),
    atom: None(),
    repeated: false,
    flags: flags,
    capture: capture
  )
}

// The next pattern scalar; None past the end.
fn peek(cursor: Input) -> Option[char] uses {} {
  if cursor.at < core@1/list.len(cursor.scalars) {
    Some(cursor.scalars[cursor.at])
  } else {
    None()
  }
}

// The scalar after the next one; None past the end.
fn peek_second(cursor: Input) -> Option[char] uses {} {
  if cursor.at + 1 < core@1/list.len(cursor.scalars) {
    Some(cursor.scalars[cursor.at + 1])
  } else {
    None()
  }
}

// The byte of an ASCII scalar; None for any other.
fn ascii_byte(c: char) -> Option[u8] uses {} {
  let cp = core@1/char.to_u32(c)
  if cp < 0x80u32 {
    Some(core@1/int.narrow(cp))
  } else {
    None()
  }
}

// Whether `c` is an ASCII letter or digit.
fn ascii_alnum(c: char) -> bool uses {} {
  match ascii_byte(c) {
    Some(b) => ascii.is_alnum(b),
    None() => false,
  }
}

// A one-scalar range of a class.
fn single(c: char) -> (u32, u32) uses {} {
  let cp = core@1/char.to_u32(c)
  (cp, cp)
}

fn syntax(cursor: Input) -> CompileError uses {} {
  Syntax(cursor.offsets[cursor.at])
}

fn sum(a: u64, b: u64, limit: u64) -> Result[u64, CompileError] uses {} {
  if a > limit || b > limit - a {
    Error(ProgramTooLarge())
  } else {
    Ok(a + b)
  }
}

fn product(a: u64, b: u64, limit: u64) -> Result[u64, CompileError] uses {} {
  if a != 0 && b > limit / a {
    Error(ProgramTooLarge())
  } else {
    Ok(a * b)
  }
}

fn add_node(mut tree: Tree, take node: Node) -> Result[u64, CompileError] uses {} {
  if node.size > tree.limit || core@1/list.len(node.ranges) > tree.limit {
    return Error(ProgramTooLarge())
  }
  let index = core@1/list.len(tree.nodes)
  core@1/list.push(mut tree.nodes, take node)
  Ok(index)
}

fn binary(mut tree: Tree, kind: u8, left: u64, right: u64) -> Result[u64, CompileError] uses {} {
  let mut node = empty_node(kind)
  node.left = left
  node.right = right
  node.size = sum(tree.nodes[left].size, tree.nodes[right].size, tree.limit)?
  node.nullable = if kind == 8 {
    tree.nodes[left].nullable || tree.nodes[right].nullable
  } else {
    tree.nodes[left].nullable && tree.nodes[right].nullable
  }
  if kind == 8 {
    node.size = sum(node.size, 1, tree.limit)?
  }
  add_node(mut tree, take node)
}

fn flush(mut tree: Tree, mut ctx: Context) -> Result[(), CompileError] uses {} {
  if let Some(atom) = ctx.atom {
    ctx.sequence = Some(
      match ctx.sequence {
        Some(left) => binary(mut tree, 7, left, atom)?,
        None() => atom,
      }
    )
    ctx.atom = None()
  }
  Ok(())
}

fn finish_sequence(mut tree: Tree, mut ctx: Context) -> Result[u64, CompileError] uses {} {
  flush(mut tree, mut ctx)?
  let sequence = match ctx.sequence {
    Some(n) => n,
    None() => add_node(mut tree, empty_node(0))?,
  }
  ctx.sequence = None()
  Ok(sequence)
}

fn finish_context(mut tree: Tree, mut ctx: Context) -> Result[u64, CompileError] uses {} {
  let right = finish_sequence(mut tree, mut ctx)?
  match ctx.alternatives {
    Some(left) => binary(mut tree, 8, left, right),
    None() => Ok(right),
  }
}

fn class_ranges(c: char) -> List[(u32, u32)] uses {} {
  if c == 'd' || c == 'D' {
    [(48, 57)]
  } else if c == 's' || c == 'S' {
    [(9, 10), (12, 13), (32, 32)]
  } else {
    [(48, 57), (65, 90), (95, 95), (97, 122)]
  }
}

fn escaped(mut cursor: Input, in_class: bool) -> Result[Node, CompileError] uses {} {
  let Some(c) = peek(cursor) else {
    return Error(syntax(cursor))
  }
  cursor.at += 1
  let mut node = empty_node(1)
  if c == 'd' || c == 'D' || c == 's' || c == 'S' || c == 'w' || c == 'W' {
    node.ranges = class_ranges(c)
    node.size = core@1/list.len(node.ranges)
    node.negated = c == 'D' || c == 'S' || c == 'W'
    return Ok(take node)
  }
  if !in_class && (c == 'A' || c == 'z' || c == 'b' || c == 'B') {
    node.kind = if c == 'A' {
      3
    } else if c == 'z' {
      4
    } else if c == 'b' {
      5
    } else {
      6
    }
    node.nullable = true
    return Ok(take node)
  }
  let scalar = if c == 'n' {
    '\n'
  } else if c == 'r' {
    '\r'
  } else if c == 't' {
    '\t'
  } else if c == 'f' {
    '\u{c}'
  } else if c == 'a' {
    '\u{7}'
  } else if c == 'v' {
    '\u{b}'
  } else if ascii_alnum(c) {
    return Error(Syntax(cursor.offsets[cursor.at - 1]))
  } else {
    c
  }
  core@1/list.push(mut node.ranges, single(scalar))
  Ok(take node)
}

fn class_item(mut cursor: Input) -> Result[Node, CompileError] uses {} {
  if peek(cursor) == Some('[') && peek_second(cursor) == Some(':') {
    return Error(syntax(cursor))
  }
  let Some(c) = peek(cursor) else {
    return Error(syntax(cursor))
  }
  cursor.at += 1
  if c == '\\' {
    return escaped(mut cursor, true)
  }
  let mut node = empty_node(1)
  core@1/list.push(mut node.ranges, single(c))
  Ok(take node)
}

// Complement predefined ASCII classes before unioning them into a bracket class.
// Ranges are scalar-value intervals: a complement spans the surrogate gap.
fn append_ranges(mut out: List[(u32, u32)], node: Node) -> () uses {} {
  let mut begin: u32 = 0
  for (lo, hi) in node.ranges {
    if node.negated {
      if begin < lo {
        core@1/list.push(mut out, (begin, lo - 1))
      }
      begin = hi + 1
    } else {
      core@1/list.push(mut out, (lo, hi))
    }
  }
  if node.negated && begin <= 1114111 {
    core@1/list.push(mut out, (begin, 1114111))
  }
}

fn bracket(mut cursor: Input, folded: bool) -> Result[Node, CompileError] uses {} {
  let mut node = empty_node(1)
  if peek(cursor) == Some('^') {
    node.negated = true
    cursor.at += 1
  }
  let mut first = true
  while peek(cursor) != Some(']') || first {
    let mut item = class_item(mut cursor)?
    // Fold the positive shorthand before complementing it for bracket union.
    if folded && core@1/list.len(item.ranges) == 4 {
      core@1/list.push(mut item.ranges, (383, 383))
      core@1/list.push(mut item.ranges, (8490, 8490))
    }
    first = false
    if peek(cursor) == Some('-') && peek_second(cursor) != None() && peek_second(cursor) != Some(
      ']'
    ) {
      cursor.at += 1
      let end_offset = cursor.offsets[cursor.at]
      let end = class_item(mut cursor)?
      if item.negated || end.negated || core@1/list.len(item.ranges) != 1 || core@1/list.len(
        end.ranges
      ) != 1 {
        return Error(Syntax(end_offset))
      }
      let (lo, _) = item.ranges[0]
      let (_, hi) = end.ranges[0]
      let (_, lo_end) = item.ranges[0]
      let (hi_start, _) = end.ranges[0]
      if lo != lo_end || hi_start != hi || lo > hi {
        return Error(Syntax(end_offset))
      }
      core@1/list.push(mut node.ranges, (lo, hi))
    } else {
      append_ranges(mut node.ranges, item)
    }
  }
  cursor.at += 1
  node.size = core@1/list.len(node.ranges)
  Ok(take node)
}

// The decimal digit value of the next pattern scalar, if it is one.
fn peek_digit(cursor: Input) -> Option[u8] uses {} {
  match peek(cursor) {
    Some(c) => match ascii_byte(c) {
      Some(b) => ascii.digit_value(b),
      None() => None(),
    },
    None() => None(),
  }
}

fn decimal(mut cursor: Input) -> Result[u64, CompileError] uses {} {
  if peek_digit(cursor) == None() {
    return Error(syntax(cursor))
  }
  let mut value: u64 = 0
  while let Some(d) = peek_digit(cursor) {
    let digit: u64 = core@1/int.widen(d)
    if value > (18446744073709551615u64 - digit) / 10 {
      return Error(ProgramTooLarge())
    }
    value = value * 10 + digit
    cursor.at += 1
  }
  Ok(value)
}

// Go syntax/parse.go:1099-1141,1272-1303 (ebe2feef): first recognize the
// complete repeat, without converting counts. A malformed form (including
// leading zeroes) leaves the opening brace literal; a complete oversized
// count still reaches decimal's checked conversion and the instruction limit.
fn repeat_form(cursor: Input) -> bool uses {} {
  let mut look = Input(scalars: cursor.scalars, offsets: [], at: cursor.at)
  let mut field: u8 = 0
  while field < 2 {
    let start = look.at
    let first = peek_digit(look)
    while peek_digit(look) != None() {
      look.at += 1
    }
    if first == None() || first == Some(0) && look.at - start > 1 {
      return false
    }
    if peek(look) == Some('}') {
      return true
    }
    if field != 0 || peek(look) != Some(',') {
      return false
    }
    look.at += 1
    if peek(look) == Some('}') {
      return true
    }
    field += 1
  }
  false
}

fn repetition(mut tree: Tree, mut cursor: Input, atom: u64, c: char, ungreedy: bool) -> Result[
  u64,
  CompileError
] uses {} {
  let mut node = empty_node(9)
  node.left = atom
  if c == '*' {
    node.unbounded = true
  } else if c == '+' {
    node.min = 1
    node.unbounded = true
  } else if c == '?' {
    node.max = 1
  } else {
    node.min = decimal(mut cursor)?
    node.max = node.min
    if peek(cursor) == Some(',') {
      cursor.at += 1
      if peek(cursor) == Some('}') {
        node.unbounded = true
      } else {
        node.max = decimal(mut cursor)?
      }
    }
    if peek(cursor) != Some('}') {
      return Error(syntax(cursor))
    }
    cursor.at += 1
    if !node.unbounded && node.max < node.min {
      return Error(syntax(cursor))
    }
  }
  node.lazy = ungreedy
  if peek(cursor) == Some('?') {
    node.lazy = !node.lazy
    cursor.at += 1
  }
  let child_size = tree.nodes[atom].size
  node.nullable = node.min == 0 || tree.nodes[atom].nullable
  if node.unbounded {
    let copies: u64 = if node.min == 0 {
      1
    } else {
      node.min
    }
    node.size = sum(product(child_size, copies, tree.limit)?, 1, tree.limit)?
    if node.min == 0 && tree.nodes[atom].nullable {
      node.size = sum(node.size, 1, tree.limit)?
    }
  } else {
    node.size = sum(
      product(child_size, node.max, tree.limit)?,
      node.max - node.min,
      tree.limit
    )?
    if node.max == 0 {
      node.size = 1
    }
  }
  add_node(mut tree, take node)
}

fn parse(pattern: String, limit: u64, initial_flags: Flags) -> Result[
  (Tree, u64),
  CompileError
] uses {} {
  let mut cursor = Input(scalars: [], offsets: [], at: 0)
  let mut byte: u64 = 0
  for c in core@1/string.scalars(pattern) {
    core@1/list.push(mut cursor.scalars, c)
    core@1/list.push(mut cursor.offsets, byte)
    byte += scalar_width(c)
  }
  core@1/list.push(mut cursor.offsets, byte)
  let mut tree = Tree(nodes: [], limit: limit, names: [""])
  let mut contexts: List[Context] = [context(initial_flags, 0)]
  let mut depth: u64 = 0
  while cursor.at < core@1/list.len(cursor.scalars) {
    let c = cursor.scalars[cursor.at]
    let at = cursor.offsets[cursor.at]
    cursor.at += 1
    if c == '(' {
      flush(mut tree, mut contexts[depth])?
      let mut flags = copy contexts[depth].flags
      let mut capture = core@1/list.len(tree.names)
      let mut name = ""
      if peek(cursor) == Some('?') {
        cursor.at += 1
        capture = 0
        if peek(cursor) == Some('P') || peek(cursor) == Some('<') {
          if peek(cursor) == Some('P') {
            cursor.at += 1
          }
          if peek(cursor) != Some('<') {
            return Error(syntax(cursor))
          }
          cursor.at += 1
          let mut builder: List[u8] = []
          while let Some(n) = peek(cursor) {
            if n == '>' {
              break
            }
            if !ascii_alnum(n) && n != '_' {
              return Error(syntax(cursor))
            }
            core@1/list.push(
              mut builder,
              match ascii_byte(n) {
                Some(b) => b,
                None() => 0,
              }
            )
            cursor.at += 1
          }
          if core@1/list.len(builder) == 0 || peek(cursor) != Some('>') {
            return Error(syntax(cursor))
          }
          cursor.at += 1
          name = text.finish_valid(take builder)
          capture = core@1/list.len(tree.names)
        } else {
          let mut enabled = true
          let mut any = false
          let mut after_minus = false
          while let Some(flag) = peek(cursor) {
            if flag == ':' || flag == ')' {
              break
            }
            cursor.at += 1
            if flag == '-' && enabled {
              enabled = false
            } else if flag == 'i' || flag == 'm' || flag == 's' || flag == 'U' {
              any = true
              if !enabled {
                after_minus = true
              }
              if flag == 'i' {
                flags.fold_case = enabled
              }
              if flag == 'm' {
                flags.multiline = enabled
              }
              if flag == 's' {
                flags.dot_newline = enabled
              }
              if flag == 'U' {
                flags.ungreedy = enabled
              }
            } else {
              return Error(Syntax(cursor.offsets[cursor.at - 1]))
            }
          }
          if !enabled && !after_minus {
            return Error(syntax(cursor))
          }
          if peek(cursor) == Some(')') && any {
            cursor.at += 1
            contexts[depth].flags = take flags
            continue
          }
          if peek(cursor) != Some(':') {
            return Error(syntax(cursor))
          }
          cursor.at += 1
        }
      }
      if capture != 0 {
        core@1/list.push(mut tree.names, take name)
      }
      depth += 1
      if depth < core@1/list.len(contexts) {
        contexts[depth] = context(flags, capture)
      } else {
        core@1/list.push(mut contexts, context(flags, capture))
      }
    } else if c == ')' {
      if depth == 0 {
        return Error(Syntax(at))
      }
      let mut group = finish_context(mut tree, mut contexts[depth])?
      let capture = contexts[depth].capture
      if capture != 0 {
        let mut node = empty_node(17)
        node.left = group
        node.right = capture
        node.nullable = tree.nodes[group].nullable
        node.size = sum(tree.nodes[group].size, 2, tree.limit)?
        group = add_node(mut tree, take node)?
      }
      depth -= 1
      contexts[depth].atom = Some(group)
      contexts[depth].repeated = false
    } else if c == '|' {
      let right = finish_sequence(mut tree, mut contexts[depth])?
      contexts[depth].alternatives = Some(
        match contexts[depth].alternatives {
          Some(left) => binary(mut tree, 8, left, right)?,
          None() => right,
        }
      )
    } else if c == '*' || c == '+' || c == '?' || c == '{' && repeat_form(cursor) {
      if contexts[depth].repeated {
        return Error(Syntax(at))
      }
      let Some(atom) = contexts[depth].atom else {
        return Error(Syntax(at))
      }
      let repeated = repetition(
        mut tree,
        mut cursor,
        atom,
        c,
        contexts[depth].flags.ungreedy
      )?
      contexts[depth].atom = Some(repeated)
      contexts[depth].repeated = true
    } else {
      flush(mut tree, mut contexts[depth])?
      let mut node = if c == '[' {
        bracket(mut cursor, contexts[depth].flags.fold_case)?
      } else if c == '\\' {
        escaped(mut cursor, false)?
      } else {
        let mut node = empty_node(
          if c == '.' {
            2
          } else if c == '^' {
            3
          } else if c == '$' {
            4
          } else {
            1
          }
        )
        if node.kind == 1 {
          core@1/list.push(mut node.ranges, single(c))
        }
        take node
      }
      let flags = contexts[depth].flags
      if node.kind == 1 && flags.fold_case {
        node.kind = 13
      }
      if node.kind == 2 && flags.dot_newline {
        node.kind = 14
      }
      if c == '^' && flags.multiline {
        node.kind = 15
      }
      if c == '$' && flags.multiline {
        node.kind = 16
      }
      let atom = add_node(mut tree, take node)?
      contexts[depth].atom = Some(atom)
      contexts[depth].repeated = false
    }
  }
  if depth != 0 {
    return Error(syntax(cursor))
  }
  let root = finish_context(mut tree, mut contexts[0])?
  sum(tree.nodes[root].size, 1, limit)?
  Ok((take tree, root))
}

// Explicit compiler frames keep deeply nested user patterns off the call stack.
type Frame {
  node: u64,
  target: u64,
  phase: u8,
  saved: u64,
  remaining: u64,
  loop_pc: u64,
}

fn frame(node: u64, target: u64) -> Frame uses {} {
  Frame(node: node, target: target, phase: 0, saved: 0, remaining: 0, loop_pc: 0)
}

fn emit(
  mut code: List[Inst],
  kind: u8,
  x: u64,
  y: u64,
  take ranges: List[(u32, u32)],
  negated: bool
) -> u64 uses {} {
  let pc = core@1/list.len(code)
  core@1/list.push(
    mut code,
    Inst(kind: kind, x: x, y: y, ranges: take ranges, negated: negated)
  )
  pc
}

fn split(mut code: List[Inst], preferred: u64, other: u64, lazy: bool) -> u64 uses {} {
  emit(
    mut code,
    10,
    if lazy {
      other
    } else {
      preferred
    },
    if lazy {
      preferred
    } else {
      other
    },
    [],
    false
  )
}

pub fn compile(pattern: String, max_instructions: u64) -> Result[Regex, CompileError] uses {} {
  compile_flags(pattern, default_flags(), max_instructions)
}

pub fn compile_flags(pattern: String, flags: Flags, max_instructions: u64) -> Result[
  Regex,
  CompileError
] uses {} {
  if max_instructions == 0 {
    return Error(ProgramTooLarge())
  }
  let (tree, root) = parse(pattern, max_instructions, flags)?
  let mut code: List[Inst] = []
  emit(mut code, 11, 0, 0, [], false)
  let mut stack: List[Frame] = [frame(root, 0)]
  let mut depth: u64 = 1
  let mut entry: u64 = 0
  while depth != 0 {
    let top = depth - 1
    let current = copy stack[top]
    let node = tree.nodes[current.node]
    let mut child: Option[Frame] = None()
    if node.kind < 7 || node.kind >= 13 && node.kind <= 16 {
      entry = emit(
        mut code,
        node.kind,
        current.target,
        0,
        copy node.ranges,
        node.negated
      )
      depth -= 1
    } else if node.kind == 17 {
      if current.phase == 0 {
        stack[top].phase = 1
        let end = emit(mut code, 12, current.target, node.right * 2 + 1, [], false)
        child = Some(frame(node.left, end))
      } else {
        entry = emit(mut code, 12, entry, node.right * 2, [], false)
        depth -= 1
      }
    } else if node.kind == 7 || node.kind == 8 {
      if current.phase == 0 {
        stack[top].phase = 1
        child = Some(frame(node.right, current.target))
      } else if current.phase == 1 {
        stack[top].phase = 2
        stack[top].saved = entry
        child = Some(
          frame(
            node.left,
            if node.kind == 7 {
              entry
            } else {
              current.target
            }
          )
        )
      } else {
        if node.kind == 8 {
          entry = split(mut code, entry, current.saved, false)
        }
        depth -= 1
      }
    } else {
      if current.phase == 0 {
        stack[top].saved = current.target
        stack[top].remaining = if node.unbounded {
          if node.min == 0 {
            0
          } else {
            node.min - 1
          }
        } else {
          node.max
        }
        if node.unbounded {
          let loop_pc = emit(mut code, 10, 0, 0, [], false)
          stack[top].loop_pc = loop_pc
          stack[top].phase = 1
          child = Some(frame(node.left, loop_pc))
        } else {
          stack[top].phase = 2
        }
      } else if current.phase == 1 {
        let loop_pc = current.loop_pc
        code[loop_pc].x = if node.lazy {
          current.target
        } else {
          entry
        }
        code[loop_pc].y = if node.lazy {
          entry
        } else {
          current.target
        }
        // A nullable star is (child+)? so its empty alternative retains priority.
        stack[top].saved = if node.min != 0 {
          entry
        } else if tree.nodes[node.left].nullable {
          split(mut code, entry, current.target, node.lazy)
        } else {
          loop_pc
        }
        stack[top].phase = 2
      } else if current.phase == 2 {
        if current.remaining == 0 {
          entry = if !node.unbounded && node.max == 0 {
            emit(mut code, 0, current.target, 0, [], false)
          } else {
            current.saved
          }
          depth -= 1
        } else {
          stack[top].phase = 3
          child = Some(frame(node.left, current.saved))
        }
      } else {
        stack[top].saved = if !node.unbounded && current.remaining > node.min {
          split(mut code, entry, current.saved, node.lazy)
        } else {
          entry
        }
        stack[top].remaining -= 1
        stack[top].phase = 2
      }
    }
    if let Some(next) = child {
      if depth < core@1/list.len(stack) {
        stack[depth] = take next
      } else {
        core@1/list.push(mut stack, take next)
      }
      depth += 1
    }
  }
  // Keep cold graph preparation off tiny searches with many nested captures.
  let prefilter = if core@1/list.len(tree.names) > 8 {
    no_prefix()
  } else {
    prefix_plan(code, entry)
  }
  Ok(
    Regex(
      code: take code,
      entry: entry,
      names: copy tree.names,
      prefilter: take prefilter,
      fixed_captures: fixed_capture_plan(tree, root)
    )
  )
}

fn spend(mut left: u64) -> Result[(), MatchError] uses {} {
  if left == 0 {
    return Error(WorkLimit())
  }
  left -= 1
  Ok(())
}

// Whether a text boundary's scalar is an ASCII word scalar; None is a text edge.
fn word(scalar: Option[char]) -> bool uses {} {
  match scalar {
    Some(c) => ascii_alnum(c) || c == '_',
    None() => false,
  }
}

type Thread {
  pc: u64,
  start: u64,
  slots: List[Option[u64]],
}

// Ordered epsilon closure, deduplicated by instruction for each scalar boundary.
// An explicit DFS stack replaces Go's recursive add; first arrival wins.
fn add(
  re: VmProgram,
  seed: Thread,
  at: u64,
  previous: Option[char],
  next: Option[char],
  mut seen: List[u64],
  mut ready: List[Thread],
  mut work: u64
) -> Result[bool, MatchError] uses {} {
  charge_slots(seed.slots, mut work)?
  let mut stack: List[Thread] = [unique seed]
  let mut depth: u64 = 1
  while depth != 0 {
    spend(mut work)?
    depth -= 1
    let thread = copy stack[depth]
    charge_slots(thread.slots, mut work)?
    if seen[thread.pc] != at + 1 {
      seen[thread.pc] = at + 1
      let inst = re.code[thread.pc]
      if inst.kind == 1 || inst.kind == 2 || inst.kind == 11 || inst.kind == 13 || inst.kind == 14 {
        core@1/list.push(mut ready, copy thread)
        if inst.kind == 11 {
          return Ok(true)
        }
      } else {
        charge_slots(thread.slots, mut work)?
        let mut slots = copy thread.slots
        if inst.kind == 12 && core@1/list.len(slots) != 0 {
          slots[inst.y] = Some(at)
        }
        let allowed = inst.kind == 12 || inst.kind == 15 && (at == 0 || previous == Some(
          '\n'
        )) || inst.kind == 16 && (next == None() || next == Some('\n')) || inst.kind == 0 || inst.kind == 10 || inst.kind == 3 && at == 0 || inst.kind == 4 && next == None() || inst.kind == 5 && word(
          previous
        ) != word(next) || inst.kind == 6 && word(previous) == word(next)
        if allowed {
          if inst.kind == 10 {
            charge_slots(slots, mut work)?
            let other = Thread(pc: inst.y, start: thread.start, slots: copy slots)
            if depth < core@1/list.len(stack) {
              stack[depth] = take other
            } else {
              core@1/list.push(mut stack, take other)
            }
            depth += 1
          }
          let first = Thread(pc: inst.x, start: thread.start, slots: take slots)
          if depth < core@1/list.len(stack) {
            stack[depth] = take first
          } else {
            core@1/list.push(mut stack, take first)
          }
          depth += 1
        }
      }
    }
  }
  Ok(false)
}

fn accepts(inst: Inst, c: char, mut work: u64) -> Result[bool, MatchError] uses {} {
  if inst.kind == 2 || inst.kind == 14 {
    return Ok(inst.kind == 14 || c != '\n')
  }
  let initial = core@1/char.to_u32(c)
  let mut cp = initial
  let mut found = false
  while true {
    for (lo, hi) in inst.ranges {
      spend(mut work)?
      if lo <= cp && cp <= hi {
        found = true
      }
    }
    if found || inst.kind != 13 {
      break
    }
    cp = simple_fold(cp, mut work)?
    if cp == initial {
      break
    }
  }
  Ok(found != inst.negated)
}

type Machine {
  seen: List[u64],
  seeds: List[Thread],
  matched: Option[Span],
  captures: Captures,
  capture: bool,
  at: u64,
  previous: Option[char],
  work: u64,
}

// One scalar boundary, including the final end of text (None). The scalar view is lazy.
fn step(re: VmProgram, next_scalar: Option[char], mut machine: Machine) -> Result[
  bool,
  MatchError
] uses {} {
  spend(mut machine.work)?
  let at = machine.at
  let mut ready: List[Thread] = []
  let mut queued_match = false
  for seed in machine.seeds {
    if add(
      re,
      seed,
      at,
      machine.previous,
      next_scalar,
      mut machine.seen,
      mut ready,
      mut machine.work
    )? {
      queued_match = true
      break
    }
  }
  if !queued_match && machine.matched == None() {
    add(
      re,
      Thread(
        pc: re.entry,
        start: at,
        slots: empty_slots(re, machine.capture, mut machine.work)?
      ),
      at,
      machine.previous,
      next_scalar,
      mut machine.seen,
      mut ready,
      mut machine.work
    )?;
  }
  let mut next: List[Thread] = []
  for thread in ready {
    spend(mut machine.work)?
    let inst = re.code[thread.pc]
    if inst.kind == 11 {
      machine.matched = Some(Span(start: thread.start, end: at))
      if machine.capture {
        machine.captures = captured(thread, at, mut machine.work)?
      }
      break
    }
    let accepted = match next_scalar {
      Some(c) => accepts(inst, c, mut machine.work)?,
      None() => false,
    }
    if accepted {
      charge_slots(thread.slots, mut machine.work)?
      core@1/list.push(
        mut next,
        Thread(pc: inst.x, start: thread.start, slots: copy thread.slots)
      )
    }
  }
  let Some(c) = next_scalar else {
    return Ok(true)
  }
  if core@1/list.len(next) == 0 && machine.matched != None() {
    return Ok(true)
  }
  machine.seeds = take next
  machine.previous = next_scalar
  machine.at += scalar_width(c)
  Ok(false)
}

pub fn find(re: Regex, text: String, work_limit: u64) -> Result[
  Option[Span],
  MatchError
] uses {} {
  if prefix_admitted(re, text, false, work_limit) {
    let mut work = work_limit
    let subject = make_subject(text, mut work)?
    let mut cache = dfa_cache(re, true, 65024)
    let (matched, _) = find_from(
      re,
      subject,
      0,
      true,
      core@1/string.as_bytes(text),
      mut cache,
      mut work
    )?
    return Ok(take matched)
  }
  let program = vm_program(re)
  let mut machine = Machine(
    seen: [],
    seeds: [],
    matched: None(),
    captures: Captures(spans: []),
    capture: false,
    at: 0,
    previous: None(),
    work: work_limit
  )
  let mut i: u64 = 0
  while i < core@1/list.len(re.code) {
    spend(mut machine.work)?
    core@1/list.push(mut machine.seen, 0)
    i += 1
  }
  for c in core@1/string.scalars(text) {
    if step(program, Some(c), mut machine)? {
      return Ok(copy machine.matched)
    }
  }
  step(program, None(), mut machine)?
  Ok(copy machine.matched)
}

pub fn is_match(re: Regex, text: String, work_limit: u64) -> Result[bool, MatchError] uses {} {
  match find(re, text, work_limit)? {
    Some(_) => Ok(true),
    None() => Ok(false),
  }
}

// Restart the existing ordered VM at an original-source_input scalar boundary.
// Queue initialization and every VM step draw from the caller's single budget.
fn pike_find_from(re: Regex, subject: Subject, start: u64, capture: bool, mut work: u64) -> Result[
  (Option[Span], Captures),
  MatchError
] uses {} {
  let program = vm_program(re)
  let mut machine = Machine(
    seen: [],
    seeds: [],
    matched: None(),
    captures: Captures(spans: []),
    capture: capture,
    at: start,
    previous: if start == 0 {
      None()
    } else {
      Some(subject_scalar(subject, subject_before(subject, start)))
    },
    work: work
  )
  let mut i: u64 = 0
  while i < core@1/list.len(re.code) {
    spend(mut machine.work)?
    core@1/list.push(mut machine.seen, 0)
    i += 1
  }
  let mut cursor = start
  while cursor <= subject_len(subject) {
    let next: Option[char] = if cursor < subject_len(subject) {
      Some(subject_scalar(subject, cursor))
    } else {
      None()
    }
    if step(program, next, mut machine)? {
      work = machine.work
      return Ok((copy machine.matched, copy machine.captures))
    }
    cursor = subject_next(subject, cursor)
  }
  work = machine.work
  Ok((copy machine.matched, copy machine.captures))
}

fn find_from_prefilter(
  re: Regex,
  subject: Subject,
  start: u64,
  capture: bool,
  accelerated: bool,
  haystack: Bytes,
  mut work: u64
) -> Result[(Option[Span], Captures), MatchError] uses {} {
  if !accelerated || !re.prefilter.enabled {
    return pike_find_from(re, subject, start, capture, mut work)
  }
  let program = vm_program(re)
  let mut machine = Machine(
    seen: [],
    seeds: [],
    matched: None(),
    captures: Captures(spans: []),
    capture: capture,
    at: start,
    previous: if start == 0 {
      None()
    } else {
      Some(subject_scalar(subject, subject_before(subject, start)))
    },
    work: work
  )
  let mut i: u64 = 0
  while i < core@1/list.len(re.code) {
    spend(mut machine.work)?
    core@1/list.push(mut machine.seen, 0)
    i += 1
  }
  let mut cursor = start
  while cursor <= subject_len(subject) {
    if core@1/list.len(machine.seeds) == 0 && machine.matched == None() {
      let Some(candidate) = next_candidate(re.prefilter, haystack, subject, cursor) else {
        work = machine.work
        return Ok((None(), Captures(spans: [])))
      }
      cursor = candidate.scalar
      machine.at = candidate.byte
      machine.previous = candidate.previous
    }
    let next: Option[char] = if cursor < subject_len(subject) {
      Some(subject_scalar(subject, cursor))
    } else {
      None()
    }
    if step(program, next, mut machine)? {
      work = machine.work
      return Ok((copy machine.matched, copy machine.captures))
    }
    cursor = subject_next(subject, cursor)
  }
  work = machine.work
  Ok((copy machine.matched, copy machine.captures))
}

// Go ebe2feef regexp/regexp.go:746-802 (matches, formerly allMatches),
// :948-958 (allIndex), :1098-1107 (FindAllIndex/FindAllStringIndex).
// Preserve pos/prevMatchEnd/accept progression on the original source_input.
pub fn find_all(re: Regex, text: String, max_matches: u64, work_limit: u64) -> Result[
  List[Span],
  MatchError
] uses {} {
  let mut matches: List[Span] = []
  if max_matches == 0 {
    return Ok(take matches)
  }
  let accelerated = prefix_admitted(re, text, false, work_limit)
  let haystack = core@1/string.as_bytes(text)
  let mut work = work_limit
  let subject = make_subject(text, mut work)?
  let mut cache = dfa_cache(re, accelerated, 65024)
  let mut pos: u64 = 0
  let mut previous_end: Option[u64] = None()
  while pos <= subject_len(subject) {
    let (matched, _) = find_from(
      re,
      subject,
      pos,
      accelerated,
      haystack,
      mut cache,
      mut work
    )?
    let Some(span) = matched else {
      return Ok(take matches)
    }
    let mut accept = true
    if span.end == pos {
      if previous_end == Some(span.start) {
        accept = false
      }
      // Advance one scalar boundary, including EOF+1.
      spend(mut work)?
      pos = if subject.ascii {
        pos + 1
      } else {
        subject_next(subject, pos)
      }
    } else if subject.ascii {
      // One historical spend per crossed scalar, with the same exhaustion
      // result. ASCII byte and scalar distances coincide.
      let count = span.end - pos
      if count > work {
        work = 0
        return Error(WorkLimit())
      }
      work -= count
      pos = span.end
    } else {
      while pos < span.end {
        spend(mut work)?
        pos = subject_next(subject, pos)
      }
    }
    previous_end = Some(span.end)
    if accept {
      core@1/list.push(mut matches, copy span)
      if core@1/list.len(matches) == max_matches {
        return Ok(take matches)
      }
    }
  }
  Ok(take matches)
}

pub fn num_subexp(re: Regex) -> u64 uses {} {
  core@1/list.len(re.names) - 1
}

pub fn subexp_names(re: Regex) -> List[String] uses {} {
  unique re.names
}

fn empty_slots(re: VmProgram, capture: bool, mut work: u64) -> Result[
  List[Option[u64]],
  MatchError
] uses {} {
  let mut slots: List[Option[u64]] = []
  if capture {
    let mut i = 0u64
    while i < core@1/list.len(re.names) * 2 {
      spend(mut work)?
      core@1/list.push(mut slots, None())
      i += 1
    }
  }
  Ok(take slots)
}

fn captured(thread: Thread, at: u64, mut work: u64) -> Result[Captures, MatchError] uses {} {
  let mut spans: List[Option[Span]] = [Some(Span(start: thread.start, end: at))]
  let mut i = 2u64
  while i < core@1/list.len(thread.slots) {
    spend(mut work)?
    core@1/list.push(
      mut spans,
      match (thread.slots[i], thread.slots[i + 1]) {
        (Some(a), Some(b)) => Some(Span(start: a, end: b)),
        _ => None(),
      }
    )
    i += 2
  }
  Ok(Captures(spans: take spans))
}

// Borrowed input and byte cursors: regex-automata 80b9d14e,
// util/search.rs:102-130, hybrid/search.rs:50-110. String proves UTF-8 validity.
// Copyright 2014 The Rust Project Developers. MIT; third-party/NOTICES.md.
type Subject {
  bytes: Bytes,
  ascii: bool,
}

fn subject_len(subject: Subject) -> u64 uses {} {
  core@1/bytes.len(subject.bytes)
}

// util/utf8.rs:56-71,79-96: decode only at the current forward/reverse
// position. Unlike arbitrary upstream byte input, String is already valid.
fn subject_next(subject: Subject, at: u64) -> u64 uses {} {
  if at == subject_len(subject) || subject.ascii {
    return at + 1
  }
  let first = subject.bytes[at]
  at + if first < 128 {
    1u64
  } else if first < 224 {
    2u64
  } else if first < 240 {
    3u64
  } else {
    4u64
  }
}

fn subject_before(subject: Subject, at: u64) -> u64 uses {} {
  let mut pos = at - 1
  if !subject.ascii {
    while subject.bytes[pos] >= 128 && subject.bytes[pos] < 192 {
      pos -= 1
    }
  }
  pos
}

fn subject_scalar(subject: Subject, at: u64) -> char uses {} {
  let first: u32 = core@1/int.widen(subject.bytes[at])
  let mut cp = first
  if !subject.ascii && first >= 128 {
    let second: u32 = core@1/int.widen(subject.bytes[at + 1])
    if first < 224 {
      cp = (first & 31) << 6 | second & 63
    } else {
      let third: u32 = core@1/int.widen(subject.bytes[at + 2])
      if first < 240 {
        cp = (first & 15) << 12 | (second & 63) << 6 | third & 63
      } else {
        let fourth: u32 = core@1/int.widen(subject.bytes[at + 3])
        cp = (first & 7) << 18 | (second & 63) << 12 | (third & 63) << 6 | fourth & 63
      }
    }
  }
  match core@1/char.from_u32(cp) {
    Some(c) => c,
    None() => {
      core@1/failure.check(false, Bounds())
      '\0'
    },
  }
}

fn subject_previous(subject: Subject, at: u64) -> Option[char] uses {} {
  if at == 0 {
    None()
  } else {
    Some(subject_scalar(subject, subject_before(subject, at)))
  }
}

fn make_subject(text: String, mut work: u64) -> Result[Subject, MatchError] in text uses {} {
  // Even the empty subject needs its EOF debit; no bytes need inspecting.
  if work == 0 {
    return Error(WorkLimit())
  }
  let bytes = core@1/string.as_bytes(text)
  let size = core@1/bytes.len(bytes)
  let mut ascii = true
  // util/utf8.rs:115-135: scalar count = byte count - continuation bytes.
  // Start with the ASCII debit, so ASCII bytes need no per-byte count update.
  let mut count = size + 1
  let mut i = 0u64
  while i < size {
    let byte = bytes[i]
    if byte >= 128 {
      ascii = false
      if byte < 192 {
        count -= 1
      }
    }
    i += 1
  }
  if count > work {
    work = 0
    return Error(WorkLimit())
  }
  work -= count
  Ok(Subject(bytes: bytes, ascii: ascii))
}

pub fn find_captures(re: Regex, text: String, work_limit: u64) -> Result[
  Option[Captures],
  MatchError
] uses {} {
  let accelerated = prefix_admitted(re, text, true, work_limit)
  let haystack = core@1/string.as_bytes(text)
  let mut work = work_limit
  let source_input = make_subject(text, mut work)?
  let mut cache = dfa_cache(re, accelerated, 65024)
  let mut replay = capture_scratch()
  let (matched, captures) = capture_find_from(
    re,
    source_input,
    0,
    accelerated,
    haystack,
    mut cache,
    mut replay,
    mut work
  )?
  match matched {
    Some(_) => Ok(Some(take captures)),
    None() => Ok(None()),
  }
}

// Go regexp.go:746-802: same original-source_input empty-match progression as find_all.
pub fn find_all_captures(re: Regex, text: String, max_matches: u64, work_limit: u64) -> Result[
  List[Captures],
  MatchError
] uses {} {
  let mut matches: List[Captures] = []
  if max_matches == 0 {
    return Ok(take matches)
  }
  let accelerated = prefix_admitted(re, text, true, work_limit)
  let haystack = core@1/string.as_bytes(text)
  let mut work = work_limit
  let source_input = make_subject(text, mut work)?
  let mut pos = 0u64
  let mut previous_end: Option[u64] = None()
  let mut cache = dfa_cache(re, accelerated, 65024)
  let mut replay = capture_scratch()
  while pos <= subject_len(source_input) {
    let (matched, captures) = capture_find_from(
      re,
      source_input,
      pos,
      accelerated,
      haystack,
      mut cache,
      mut replay,
      mut work
    )?
    let Some(span) = matched else {
      return Ok(take matches)
    }
    let mut accept = true
    if span.end == pos {
      if previous_end == Some(span.start) {
        accept = false
      }
      spend(mut work)?
      pos = subject_next(source_input, pos)
    } else {
      while pos < span.end {
        spend(mut work)?
        pos = subject_next(source_input, pos)
      }
    }
    previous_end = Some(span.end)
    if accept {
      core@1/list.push(mut matches, take captures)
      if core@1/list.len(matches) == max_matches {
        return Ok(take matches)
      }
    }
  }
  Ok(take matches)
}

fn append_bytes(mut dst: List[u8], src: Bytes, start: u64, end: u64, mut work: u64) -> Result[
  (),
  MatchError
] uses {} {
  let mut i = start
  while i < end {
    spend(mut work)?
    core@1/list.push(mut dst, src[i])
    i += 1
  }
  Ok(())
}

fn boundary(src: Bytes, at: u64) -> bool uses {} {
  at == core@1/bytes.len(src) || at < core@1/bytes.len(src) && (src[at] < 128 || src[at] >= 192)
}

fn append_capture(
  mut dst: List[u8],
  src: Bytes,
  captures: Captures,
  index: u64,
  mut work: u64
) -> Result[(), MatchError] uses {} {
  if index < core@1/list.len(captures.spans) {
    if let Some(span) = captures.spans[index] {
      if span.start > span.end || !boundary(src, span.start) || !boundary(src, span.end) {
        return Error(InvalidCaptures())
      }
      append_bytes(mut dst, src, span.start, span.end, mut work)?
    }
  }
  Ok(())
}

// Go regexp.go:1184-1270: maximal names, leading-zero handling, malformed
// dollar syntax left verbatim, and the first participating duplicate name.
fn expand_into(
  re: Regex,
  mut dst: List[u8],
  template: String,
  src: String,
  captures: Captures,
  mut work: u64
) -> Result[(), MatchError] uses {} {
  let source_input = make_subject(template, mut work)?
  let data = core@1/string.as_bytes(template)
  let source = core@1/string.as_bytes(src)
  let mut at = 0u64
  while at < subject_len(source_input) {
    spend(mut work)?
    if subject_scalar(source_input, at) != '$' {
      append_bytes(mut dst, data, at, subject_next(source_input, at), mut work)?
      at = subject_next(source_input, at)
      continue
    }
    at = subject_next(source_input, at)
    if at < subject_len(source_input) && subject_scalar(source_input, at) == '$' {
      core@1/list.push(mut dst, b'$')
      at = subject_next(source_input, at)
      continue
    }
    let saved = at
    let brace = at < subject_len(source_input) && subject_scalar(source_input, at) == '{'
    if brace {
      at = subject_next(source_input, at)
    }
    let begin = at
    let mut number: Option[u64] = Some(0u64)
    while at < subject_len(source_input) {
      spend(mut work)?
      let c = subject_scalar(source_input, at)
      if !expansion_name(c, mut work)? {
        break
      }
      number = match (number, ascii_byte(c)) {
        (Some(n), Some(b)) => match ascii.digit_value(b) {
          Some(d) => if n < 100000000 {
            Some(n * 10 + core@1/int.widen(d))
          } else {
            None()
          },
          None() => None(),
        },
        _ => None(),
      }
      at = subject_next(source_input, at)
    }
    let end = at
    if begin == end || brace && (at == subject_len(source_input) || subject_scalar(
      source_input,
      at
    ) != '}') {
      core@1/list.push(mut dst, b'$')
      at = saved
      continue
    }
    if brace {
      at = subject_next(source_input, at)
    }
    if end - begin > 1 && subject_scalar(source_input, begin) == '0' {
      number = None()
    }
    if let Some(index) = number {
      append_capture(mut dst, source, captures, index, mut work)?
    } else {
      let mut i = 0u64
      while i < core@1/list.len(re.names) {
        spend(mut work)?
        let name = core@1/string.as_bytes(re.names[i])
        let size = end - begin
        let mut equal = core@1/bytes.len(name) == size
        let mut j = 0u64
        while equal && j < size {
          spend(mut work)?
          equal = name[j] == data[begin + j]
          j += 1
        }
        if equal && i < core@1/list.len(captures.spans) && captures.spans[i] != None() {
          append_capture(mut dst, source, captures, i, mut work)?
          break
        }
        i += 1
      }
    }
  }
  Ok(())
}

// Appends to dst, like Go Expand. A WorkLimit may leave an appended prefix.
pub fn expand(
  re: Regex,
  mut dst: List[u8],
  template: String,
  src: String,
  captures: Captures,
  work_limit: u64
) -> Result[(), MatchError] uses {} {
  let mut work = work_limit
  expand_into(re, mut dst, template, src, captures, mut work)
}

fn replace_pike[T](
  re: Regex,
  src: String,
  replacement: String,
  mode: u8,
  state: T,
  callback: fn(T, String, Captures) -> String uses {},
  work_limit: u64
) -> Result[String, MatchError] uses {} {
  let mut work = work_limit
  let source_input = make_subject(src, mut work)?
  let data = core@1/string.as_bytes(src)
  let mut dst: List[u8] = []
  let mut pos = 0u64
  let mut last_end = 0u64
  while pos <= subject_len(source_input) {
    let (matched, captures) = pike_find_from(re, source_input, pos, mode != 1, mut work)?
    let Some(span) = matched else {
      break
    }
    append_bytes(mut dst, data, last_end, span.start, mut work)?
    if span.end > last_end || span.start == 0 {
      if mode == 2 {
        let value = callback(state, src, captures)
        let bytes = core@1/string.as_bytes(value)
        append_bytes(mut dst, bytes, 0, core@1/bytes.len(bytes), mut work)?
      } else if mode == 1 {
        let bytes = core@1/string.as_bytes(replacement)
        append_bytes(mut dst, bytes, 0, core@1/bytes.len(bytes), mut work)?
      } else {
        expand_into(re, mut dst, replacement, src, captures, mut work)?
      }
    }
    last_end = span.end
    // Go replaceAll advances at least one scalar from the search position.
    spend(mut work)?
    if pos < subject_len(source_input) && subject_next(source_input, pos) > span.end {
      pos = subject_next(source_input, pos)
    } else if span.end == pos {
      pos = subject_next(source_input, pos)
    } else {
      while pos < span.end {
        spend(mut work)?
        pos = subject_next(source_input, pos)
      }
    }
  }
  append_bytes(mut dst, data, last_end, core@1/bytes.len(data), mut work)?
  Ok(text.finish_valid(take dst))
}

pub fn replace_all(re: Regex, src: String, replacement: String, work_limit: u64) -> Result[
  String,
  MatchError
] uses {} {
  replace(re, src, replacement, 0, (), unused_replacement, work_limit)
}

pub fn replace_all_literal(re: Regex, src: String, replacement: String, work_limit: u64) -> Result[
  String,
  MatchError
] uses {} {
  replace(re, src, replacement, 1, (), unused_replacement, work_limit)
}

fn charge_slots(slots: List[Option[u64]], mut work: u64) -> Result[(), MatchError] uses {} {
  let size = core@1/list.len(slots)
  if size > work {
    return Error(WorkLimit())
  }
  work -= size
  Ok(())
}

fn unused_replacement(state: (), src: String, captures: Captures) -> String uses {} {
  ""
}

// Callback work is the caller's responsibility; matching and copied output
// share work_limit. Callback output is literal, as with Go ReplaceAllFunc.
pub fn replace_all_func[T](
  re: Regex,
  src: String,
  state: T,
  callback: fn(T, String, Captures) -> String uses {},
  work_limit: u64
) -> Result[String, MatchError] uses {} {
  replace(re, src, "", 2, state, callback, work_limit)
}
