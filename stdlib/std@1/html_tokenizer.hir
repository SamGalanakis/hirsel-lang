// Port of golang.org/x/net/html/{token,escape,entity}.go at
// 7e562009b3884a0845019b5f886f0242a7c0b970. Copyright 2010 The Go Authors.
// BSD-3-Clause: tests/fixtures/html-tokenizer-15/GO-LICENSE.txt and
// third-party/NOTICES.md. See docs/spec/std-library.md for adaptations.

pub type Kind = Text | StartTag | EndTag | SelfClosingTag | Comment | Doctype

pub type Span {
  start: u64,
  end: u64,
}

pub type Attribute {
  key: String,
  value: String,
}

pub type Token {
  kind: Kind,
  span: Span,
  data: String,
  attributes: List[Attribute],
}

pub type Limits {
  bytes: u64,
  tokens: u64,
  attributes: u64,
  work: u64,
}

pub type Limit = InputBytes | Tokens | Attributes | Work

pub type TokenizeError = LimitExceeded(Limit, u64)

type AttrSpan {
  key: Span,
  value: Span,
}

/// Owns the bounded whole UTF-8 input. No I/O or caller-owned views.
pub opaque type Tokenizer: copyable + inert + noalloc_drop uses {} {
  source: String,
  limits: Limits,
  pos: u64,
  start: u64,
  data_start: u64,
  data_end: u64,
  attrs: List[AttrSpan],
  raw_tag: String,
  raw_text: bool,
  convert_nul: bool,
  status: u64,
  error_offset: u64,
  work: u64,
  tokens: u64,
  attributes: u64,
}

/// All caps are inclusive; zero permits zero, never unlimited.
pub fn tokenizer(take source: String, limits: Limits) -> Result[
  Tokenizer,
  TokenizeError
] uses {} {
  if string.byte_len(source) > limits.bytes {
    return Error(LimitExceeded(InputBytes(), limits.bytes))
  }
  Ok(
    Tokenizer(
      source: take source,
      limits: limits,
      pos: 0,
      start: 0,
      data_start: 0,
      data_end: 0,
      attrs: [],
      raw_tag: "",
      raw_text: false,
      convert_nul: false,
      status: 0,
      error_offset: 0,
      work: 0,
      tokens: 0,
      attributes: 0
    )
  )
}

fn charge(mut z: Tokenizer, at: u64) -> bool uses {} {
  if z.status >= 2 {
    return false
  }
  if z.work == z.limits.work {
    z.status = 2
    z.error_offset = at
    return false
  }
  z.work += 1
  true
}

// token.go readByte, without Reader/buffer compaction. EOF does not advance.
fn read_byte(mut z: Tokenizer) -> u8 uses {} {
  if z.status != 0 {
    return 0
  }
  let at = z.pos
  if !charge(mut z, at) {
    return 0
  }
  let source = string.as_bytes(z.source)
  if z.pos == bytes.len(source) {
    z.status = 1
    return 0
  }
  let c = source[z.pos]
  z.pos += 1
  c
}

fn white(c: u8) -> bool uses {} {
  c == 32 || c == 10 || c == 13 || c == 9 || c == 12
}

fn alpha(c: u8) -> bool uses {} {
  c >= 65 && c <= 90 || c >= 97 && c <= 122
}

fn alnum(c: u8) -> bool uses {} {
  alpha(c) || c >= 48 && c <= 57
}

fn lower(c: u8) -> u8 uses {} {
  if c >= 65 && c <= 90 {
    c + 32u8
  } else {
    c
  }
}

fn delimiter(c: u8) -> bool uses {} {
  white(c) || c == 47 || c == 62
}

fn skip_white(mut z: Tokenizer) -> () uses {} {
  while z.status == 0 {
    let c = read_byte(mut z)
    if z.status != 0 {
      return
    }
    if !white(c) {
      z.pos -= 1
      return
    }
  }
}

fn raw_end_tag(mut z: Tokenizer) -> bool uses {} {
  let name_len = string.byte_len(z.raw_tag)
  let mut i: u64 = 0
  while i < name_len {
    let expected = string.as_bytes(z.raw_tag)[i]
    let c = read_byte(mut z)
    if z.status != 0 {
      return false
    }
    if lower(c) != expected {
      z.pos -= 1
      return false
    }
    i += 1
  }
  let c = read_byte(mut z)
  if z.status != 0 {
    return false
  }
  if delimiter(c) {
    z.pos -= 3 + name_len
    return true
  }
  z.pos -= 1
  false
}

// readScript's named states become a bounded iterative dispatch, with exactly
// the same reconsumption and double-escape transitions (token.go:404-603).
fn script_word(mut z: Tokenizer) -> bool uses {} {
  let word = b"script"
  let mut i: u64 = 0
  while i < 6 {
    let c = read_byte(mut z)
    if z.status != 0 {
      return false
    }
    if lower(c) != word[i] {
      z.pos -= 1
      return false
    }
    i += 1
  }
  let c = read_byte(mut z)
  if z.status != 0 {
    return false
  }
  if delimiter(c) {
    return true
  }
  z.pos -= 1
  false
}

fn read_script(mut z: Tokenizer) -> () uses {} {
  let mut state: u64 = 0
  while z.status == 0 {
    // End-tag-open and double-escape states have their own byte readers.
    if state == 2 || state == 9 {
      if raw_end_tag(mut z) || z.status != 0 {
        break
      }
      state = if state == 2 {
        0u64
      } else {
        5u64
      }
      continue
    }
    if state == 10 {
      let matched = script_word(mut z)
      state = if matched {
        11u64
      } else {
        5u64
      }
      continue
    }
    if state == 15 {
      if raw_end_tag(mut z) {
        z.pos += 9
        state = 5
      } else {
        state = 11
      }
      continue
    }
    let c = read_byte(mut z)
    if z.status != 0 {
      break
    }
    match state {
      0 => { // scriptData
        if c == 60 {
          state = 1
        }
      },
      1 => { // scriptDataLessThanSign
        if c == 47 {
          state = 2
        } else if c == 33 {
          state = 3
        } else {
          z.pos -= 1
          state = 0
        }
      },
      3 => { // scriptDataEscapeStart
        if c == 45 {
          state = 4
        } else {
          z.pos -= 1
          state = 0
        }
      },
      4 => { // scriptDataEscapeStartDash
        if c == 45 {
          state = 7
        } else {
          z.pos -= 1
          state = 0
        }
      },
      5 => { // scriptDataEscaped
        if c == 45 {
          state = 6
        } else if c == 60 {
          state = 8
        }
      },
      6 => { // scriptDataEscapedDash
        state = if c == 45 {
          7u64
        } else if c == 60 {
          8u64
        } else {
          5u64
        }
      },
      7 => { // scriptDataEscapedDashDash
        state = if c == 45 {
          7u64
        } else if c == 60 {
          8u64
        } else if c == 62 {
          0u64
        } else {
          5u64
        }
      },
      8 => { // scriptDataEscapedLessThanSign
        if c == 47 {
          state = 9
        } else if alpha(c) {
          z.pos -= 1
          state = 10
        } else {
          z.pos -= 1
          state = 0
        }
      },
      11 => { // scriptDataDoubleEscaped
        if c == 45 {
          state = 12
        } else if c == 60 {
          state = 14
        }
      },
      12 => { // scriptDataDoubleEscapedDash
        state = if c == 45 {
          13u64
        } else if c == 60 {
          14u64
        } else {
          11u64
        }
      },
      13 => { // scriptDataDoubleEscapedDashDash
        state = if c == 45 {
          13u64
        } else if c == 60 {
          14u64
        } else if c == 62 {
          0u64
        } else {
          11u64
        }
      },
      14 => { // scriptDataDoubleEscapedLessThanSign
        if c == 47 {
          state = 15
        } else {
          z.pos -= 1
          state = 11
        }
      },
      _ => (),
    }
  }
  z.data_end = z.pos
}

fn raw_or_rcdata(mut z: Tokenizer) -> () uses {} {
  if z.raw_tag == "script" {
    read_script(mut z)
    z.raw_text = true
    z.raw_tag = ""
    return
  }
  while z.status == 0 {
    let c = read_byte(mut z)
    if z.status != 0 {
      break
    }
    if c != 60 {
      continue
    }
    let following = read_byte(mut z)
    if z.status != 0 {
      break
    }
    if following != 47 {
      z.pos -= 1
      continue
    }
    if raw_end_tag(mut z) || z.status != 0 {
      break
    }
  }
  z.data_end = z.pos
  z.raw_text = z.raw_tag != "textarea" && z.raw_tag != "title"
  z.raw_tag = ""
}

fn suffix(z: Tokenizer, value: Bytes) -> bool uses {} {
  if z.pos - z.start < 4 + bytes.len(value) {
    return false
  }
  let source = string.as_bytes(z.source)
  let mut i: u64 = 0
  while i < bytes.len(value) {
    if source[z.pos - bytes.len(value) + i] != value[i] {
      return false
    }
    i += 1
  }
  true
}

fn abrupt_comment_end(z: Tokenizer) -> u64 uses {} {
  if suffix(z, b"--!") {
    z.pos - 3
  } else if suffix(z, b"--") {
    z.pos - 2
  } else if suffix(z, b"-") {
    z.pos - 1
  } else {
    z.pos
  }
}

fn read_comment(mut z: Tokenizer) -> () uses {} {
  z.data_start = z.pos
  let mut dashes: u64 = 0
  let mut beginning = true
  while z.status == 0 {
    let c = read_byte(mut z)
    if z.status != 0 {
      z.data_end = abrupt_comment_end(z)
      break
    }
    if c == 45 {
      dashes += 1
      continue
    }
    if c == 62 && (dashes >= 2 || beginning) {
      z.data_end = if z.pos >= z.data_start + 3 {
        z.pos - 3
      } else {
        z.data_start
      }
      break
    }
    if c == 33 && dashes >= 2 {
      let following = read_byte(mut z)
      if z.status != 0 {
        z.data_end = abrupt_comment_end(z)
        break
      }
      if following == 62 {
        z.data_end = z.pos - 4
        break
      }
      if following == 45 {
        dashes = 1
        beginning = false
        continue
      }
    }
    dashes = 0
    beginning = false
  }
  if z.data_end < z.data_start {
    z.data_end = z.data_start
  }
}

fn until_close_angle(mut z: Tokenizer) -> () uses {} {
  z.data_start = z.pos
  while z.status == 0 {
    let c = read_byte(mut z)
    if z.status != 0 {
      z.data_end = z.pos
      return
    }
    if c == 62 {
      z.data_end = z.pos - 1
      return
    }
  }
}

fn declaration_word(mut z: Tokenizer, word: Bytes, fold: bool) -> bool uses {} {
  let mut i: u64 = 0
  while i < bytes.len(word) {
    let c = read_byte(mut z)
    if z.status != 0 {
      if z.status == 1 {
        z.pos = z.data_start
        z.status = 0
      } else {
        z.data_end = z.pos
      }
      return false
    }
    if if fold {
      lower(c) != lower(word[i])
    } else {
      c != word[i]
    } {
      z.pos = z.data_start
      return false
    }
    i += 1
  }
  true
}

fn markup_declaration(mut z: Tokenizer, allow_cdata: bool) -> Kind uses {} {
  z.data_start = z.pos
  let c0 = read_byte(mut z)
  if z.status != 0 {
    z.data_end = z.pos
    return Comment()
  }
  let c1 = read_byte(mut z)
  if z.status != 0 {
    z.data_end = if c0 == 62 {
      z.pos - 1
    } else {
      z.pos
    }
    return Comment()
  }
  if c0 == 45 && c1 == 45 {
    read_comment(mut z)
    return Comment()
  }
  z.pos -= 2
  if declaration_word(mut z, b"DOCTYPE", true) {
    skip_white(mut z)
    if z.status != 0 {
      z.data_start = z.pos
      z.data_end = z.pos
    } else {
      until_close_angle(mut z)
    }
    return Doctype()
  }
  if allow_cdata && declaration_word(mut z, b"[CDATA[", false) {
    z.data_start = z.pos
    let mut brackets: u64 = 0
    while z.status == 0 {
      let c = read_byte(mut z)
      if z.status != 0 {
        z.data_end = z.pos
        break
      }
      if c == 93 {
        brackets += 1
      } else if c == 62 && brackets >= 2 {
        z.data_end = z.pos - 3
        break
      } else {
        brackets = 0
      }
    }
    z.convert_nul = true
    return Text()
  }
  until_close_angle(mut z)
  Comment()
}

fn tag_name(mut z: Tokenizer) -> () uses {} {
  z.data_start = z.pos - 1
  while z.status == 0 {
    let c = read_byte(mut z)
    if z.status != 0 {
      z.data_end = z.pos
      return
    }
    if white(c) {
      z.data_end = z.pos - 1
      return
    }
    if c == 47 || c == 62 {
      z.pos -= 1
      z.data_end = z.pos
      return
    }
  }
}

fn attr_key(mut z: Tokenizer) -> Span uses {} {
  let start = z.pos
  while z.status == 0 {
    let c = read_byte(mut z)
    if z.status != 0 {
      break
    }
    if c == 61 && z.pos == start + 1 {
      continue
    }
    if c == 61 || delimiter(c) {
      z.pos -= 1
      break
    }
  }
  Span(start: start, end: z.pos)
}

fn attr_value(mut z: Tokenizer) -> Span uses {} {
  let empty = Span(start: z.pos, end: z.pos)
  skip_white(mut z)
  if z.status != 0 {
    return empty
  }
  let equals = read_byte(mut z)
  if z.status != 0 || equals == 47 {
    return empty
  }
  if equals != 61 {
    z.pos -= 1
    return empty
  }
  skip_white(mut z)
  if z.status != 0 {
    return empty
  }
  let quote = read_byte(mut z)
  if z.status != 0 {
    return empty
  }
  if quote == 62 {
    z.pos -= 1
    return empty
  }
  if quote == 39 || quote == 34 {
    let start = z.pos
    while z.status == 0 {
      let c = read_byte(mut z)
      if z.status != 0 {
        break
      }
      if c == quote {
        return Span(start: start, end: z.pos - 1)
      }
    }
    return Span(start: start, end: z.pos)
  }
  let start = z.pos - 1
  while z.status == 0 {
    let c = read_byte(mut z)
    if z.status != 0 {
      break
    }
    if white(c) {
      return Span(start: start, end: z.pos - 1)
    }
    if c == 62 {
      z.pos -= 1
      break
    }
  }
  Span(start: start, end: z.pos)
}

fn read_tag(mut z: Tokenizer, save_attrs: bool) -> () uses {} {
  z.attrs = []
  let mut names: Map[String, bool] = core@1/map.empty()
  tag_name(mut z)
  skip_white(mut z)
  while z.status == 0 {
    let c = read_byte(mut z)
    if z.status != 0 || c == 62 {
      break
    }
    z.pos -= 1
    let key = attr_key(mut z)
    let value = attr_value(mut z)
    if key.end > key.start {
      if z.attributes == z.limits.attributes {
        if z.status < 2 {
          z.status = 4
          z.error_offset = key.start
        }
        return
      }
      z.attributes += 1
      // Deduplicate BEFORE NUL replacement, exactly like readTag's attrNames.
      let name = decoded(mut z, key.start, key.end, false, false, true, false, false)
      if save_attrs && !core@1/map.contains(names, name) && z.status < 2 {
        map.insert(mut names, copy name, true)
        list.push(mut z.attrs, AttrSpan(key: key, value: value))
      }
    }
    skip_white(mut z)
  }
}

fn start_tag(mut z: Tokenizer) -> Kind uses {} {
  read_tag(mut z, true)
  if z.status != 0 {
    return StartTag()
  }
  let begin = z.data_start
  let end = z.data_end
  let name = decoded(mut z, begin, end, false, false, true, false, false)
  if name == "iframe" || name == "noembed" || name == "noframes" || name == "noscript" || name == "plaintext" || name == "script" || name == "style" || name == "textarea" || name == "title" || name == "xmp" {
    z.raw_tag = take name
  }
  let source = string.as_bytes(z.source)
  let count = list.len(z.attrs)
  if source[z.pos - 2] == 47 && (count == 0 || z.pos - 1 != z.attrs[count - 1].value.end) {
    return SelfClosingTag()
  }
  StartTag()
}

// token.go Next: recognize a markup opener, return accumulated text first,
// then dispatch. EOF in a tag discards that unfinished tag, as upstream does.
fn scan(mut z: Tokenizer, allow_cdata: bool) -> Option[Kind] uses {} {
  z.start = z.pos
  z.data_start = z.pos
  z.data_end = z.pos
  if z.status != 0 {
    return None()
  }
  if z.raw_tag != "" {
    if z.raw_tag == "plaintext" {
      while z.status == 0 {
        let _ = read_byte(mut z)
      }
      z.data_end = z.pos
      z.raw_text = true
    } else {
      raw_or_rcdata(mut z)
    }
    if z.data_end > z.data_start {
      z.convert_nul = true
      return Some(Text())
    }
  }
  z.raw_text = false
  z.convert_nul = false
  while z.status == 0 {
    let opening = read_byte(mut z)
    if z.status != 0 {
      break
    }
    if opening != 60 {
      continue
    }
    let c = read_byte(mut z)
    if z.status != 0 {
      break
    }
    if !alpha(c) && c != 47 && c != 33 && c != 63 {
      z.pos -= 1
      continue
    }
    let opener = z.pos - 2
    if z.start < opener {
      z.pos = opener
      z.data_end = opener
      return Some(Text())
    }
    if alpha(c) {
      let kind = start_tag(mut z)
      if z.status != 0 {
        return None()
      }
      return Some(kind)
    }
    if c == 47 {
      let end_char = read_byte(mut z)
      if z.status != 0 {
        break
      }
      if end_char == 62 {
        return Some(Comment())
      }
      if alpha(end_char) {
        read_tag(mut z, false)
        if z.status != 0 {
          return None()
        }
        return Some(EndTag())
      }
      z.pos -= 1
      until_close_angle(mut z)
      return Some(Comment())
    }
    if c == 33 {
      return Some(markup_declaration(mut z, allow_cdata))
    }
    z.pos -= 1
    until_close_angle(mut z)
    return Some(Comment())
  }
  if z.start < z.pos {
    z.data_end = z.pos
    return Some(Text())
  }
  None()
}

/// Override the next rawtext/RCDATA transition (e.g. an SVG title).
pub fn next_is_not_raw_text(mut z: Tokenizer) -> () uses {} {
  z.raw_tag = ""
}

fn failure(z: Tokenizer) -> TokenizeError uses {} {
  let kind = if z.status == 3 {
    Tokens()
  } else if z.status == 4 {
    Attributes()
  } else {
    Work()
  }
  LimitExceeded(kind, z.error_offset)
}

/// None is stable EOF; errors poison the tokenizer and repeat unchanged.
/// Caller selects CDATA for this token's foreign-content context.
pub fn next(mut z: Tokenizer, allow_cdata: bool) -> Result[Option[Token], TokenizeError] uses {} {
  if z.status >= 2 {
    return Error(failure(z))
  }
  let scanned = scan(mut z, allow_cdata)
  if z.status >= 2 {
    return Error(failure(z))
  }
  let Some(kind) = scanned else {
    return Ok(None())
  }
  if z.tokens == z.limits.tokens {
    z.status = 3
    z.error_offset = z.start
    return Error(failure(z))
  }
  z.tokens += 1
  let tag = kind == StartTag() || kind == EndTag() || kind == SelfClosingTag()
  let begin = z.data_start
  let end = z.data_end
  let entities = !tag && !z.raw_text
  let nul = z.convert_nul || kind == Comment() || tag
  let data = decoded(mut z, begin, end, entities, nul, tag, !tag, false)
  let mut attributes: List[Attribute] = []
  if tag && kind != EndTag() {
    let mut i: u64 = 0
    while i < list.len(z.attrs) && z.status < 2 {
      let attr = z.attrs[i]
      let key = decoded(
        mut z,
        attr.key.start,
        attr.key.end,
        false,
        true,
        true,
        false,
        false
      )
      let value = decoded(
        mut z,
        attr.value.start,
        attr.value.end,
        true,
        true,
        false,
        true,
        true
      )
      list.push(mut attributes, Attribute(key: take key, value: take value))
      i += 1
    }
  }
  if z.status >= 2 {
    return Error(failure(z))
  }
  Ok(
    Some(
      Token(
        kind: kind,
        span: Span(start: z.start, end: z.pos),
        data: take data,
        attributes: take attributes
      )
    )
  )
}

/// Collect using a fixed CDATA policy. Use tokenizer/next to vary the context.
pub fn tokenize(take source: String, limits: Limits, allow_cdata: bool) -> Result[
  List[Token],
  TokenizeError
] uses {} {
  let mut z = tokenizer(take source, limits)?
  let mut tokens: List[Token] = []
  while true {
    match next(mut z, allow_cdata)? {
      Some(token) => list.push(mut tokens, take token),
      None() => break,
    }
  }
  Ok(take tokens)
}

// Output-byte charging bounds retained decoded data, even for expanding NULs.
fn emit(mut z: Tokenizer, mut out: List[u8], c: u8, at: u64) -> () uses {} {
  if charge(mut z, at) {
    list.push(mut out, c)
  }
}

fn emit_scalar(mut z: Tokenizer, mut out: List[u8], scalar: u32, at: u64) -> () uses {} {
  let c: u64 = core@1/int.widen(scalar)
  if c < 128 {
    emit(mut z, mut out, core@1/int.truncate(c), at)
  } else if c < 2048 {
    emit(mut z, mut out, core@1/int.truncate(192u64 | c >> 6), at)
    emit(mut z, mut out, core@1/int.truncate(128u64 | c & 63), at)
  } else if c < 65536 {
    emit(mut z, mut out, core@1/int.truncate(224u64 | c >> 12), at)
    emit(mut z, mut out, core@1/int.truncate(128u64 | c >> 6 & 63), at)
    emit(mut z, mut out, core@1/int.truncate(128u64 | c & 63), at)
  } else {
    emit(mut z, mut out, core@1/int.truncate(240u64 | c >> 18), at)
    emit(mut z, mut out, core@1/int.truncate(128u64 | c >> 12 & 63), at)
    emit(mut z, mut out, core@1/int.truncate(128u64 | c >> 6 & 63), at)
    emit(mut z, mut out, core@1/int.truncate(128u64 | c & 63), at)
  }
}

fn input_byte(z: Tokenizer, at: u64) -> u8 uses {} {
  string.as_bytes(z.source)[at]
}

fn table_u32(at: u64) -> u32 uses {} {
  let a: u32 = core@1/int.widen(ENTITY_INDEX[at])
  let b: u32 = core@1/int.widen(ENTITY_INDEX[at + 1])
  let c: u32 = core@1/int.widen(ENTITY_INDEX[at + 2])
  let d: u32 = core@1/int.widen(ENTITY_INDEX[at + 3])
  a | b << 8 | c << 16 | d << 24
}

// Sorted pinned entity data; comparisons are charged, no input-sized key copy.
fn entity_lookup(mut z: Tokenizer, start: u64, end: u64) -> (u32, u32) uses {} {
  let mut low: u64 = 0
  let mut high = bytes.len(ENTITY_INDEX) / 16
  while low < high && z.status < 2 {
    let mid = low + (high - low) / 2
    let offset: u64 = core@1/int.widen(table_u32(mid * 16))
    let len: u64 = core@1/int.widen(table_u32(mid * 16 + 4))
    let mut i: u64 = 0
    let mut cmp: u64 = 0
    while i < end - start && i < len {
      if !charge(mut z, start + i) {
        return (0, 0)
      }
      let a = input_byte(z, start + i)
      let b = ENTITY_NAMES[offset + i]
      if a != b {
        cmp = if a < b {
          1u64
        } else {
          2u64
        }
        break
      }
      i += 1
    }
    if cmp == 0 {
      if end - start < len {
        cmp = 1
      } else if end - start > len {
        cmp = 2
      }
    }
    if cmp == 0 {
      return (table_u32(mid * 16 + 8), table_u32(mid * 16 + 12))
    }
    if cmp == 1 {
      high = mid
    } else {
      low = mid + 1
    }
  }
  (0, 0)
}

fn reference(mut z: Tokenizer, start: u64, end: u64, attribute: bool) -> (u32, u32, u64) uses {} {
  let mut pos = start + 1
  if pos == end {
    return (38, 0, 1)
  }
  if input_byte(z, pos) == 35 {
    pos += 1
    if pos == end {
      return (38, 0, 1)
    }
    let hex = input_byte(z, pos) == 120 || input_byte(z, pos) == 88
    if hex {
      pos += 1
    }
    let first = pos
    let mut scalar: u32 = 0
    while pos < end {
      if !charge(mut z, pos) {
        return (38, 0, 1)
      }
      let c = input_byte(z, pos)
      let digit: u32 = if c >= 48 && c <= 57 {
        core@1/int.widen(c - 48)
      } else if hex && lower(c) >= 97 && lower(c) <= 102 {
        core@1/int.widen(lower(c) - 87)
      } else {
        break
      }
      if scalar <= 1114111 {
        scalar = scalar * if hex {
          16u32
        } else {
          10u32
        } + digit
      }
      pos += 1
    }
    if pos == first {
      return (38, 0, 1)
    }
    if pos < end && input_byte(z, pos) == 59 {
      pos += 1
    }
    if scalar >= 128 && scalar <= 159 {
      scalar = WINDOWS_1252[core@1/int.widen(scalar - 128)]
    } else if scalar == 0 || scalar >= 55296 && scalar <= 57343 || scalar > 1114111 {
      scalar = 65533
    }
    return (scalar, 0, pos - start)
  }
  while pos < end {
    if !charge(mut z, pos) {
      return (38, 0, 1)
    }
    let c = input_byte(z, pos)
    pos += 1
    if alnum(c) {
      continue
    }
    if c != 59 {
      pos -= 1
    }
    break
  }
  if pos == start + 1 {
    return (38, 0, 1)
  }
  if attribute && input_byte(z, pos - 1) != 59 && pos < end && input_byte(z, pos) == 61 {
    return (38, 0, 1)
  }
  let (a, b) = entity_lookup(mut z, start + 1, pos)
  if a != 0 {
    return (a, b, pos - start)
  }
  if !attribute {
    let mut len = pos - start - 2
    if len > 6 {
      len = 6
    }
    while len > 1 {
      let (first, second) = entity_lookup(mut z, start + 1, start + 1 + len)
      if first != 0 {
        return (first, second, len + 1)
      }
      len -= 1
    }
  }
  (38, 0, 1)
}

fn decoded(
  mut z: Tokenizer,
  start: u64,
  end: u64,
  entities: bool,
  nul: bool,
  fold: bool,
  newlines: bool,
  attribute: bool
) -> String uses {} {
  let mut out: List[u8] = []
  let mut pos = start
  while pos < end && z.status < 2 {
    if !charge(mut z, pos) {
      break
    }
    let c = input_byte(z, pos)
    if entities && c == 38 {
      let (a, b, width) = reference(mut z, pos, end, attribute)
      emit_scalar(mut z, mut out, a, pos)
      if b != 0 {
        emit_scalar(mut z, mut out, b, pos)
      }
      pos += width
    } else if c == 0 && nul {
      emit_scalar(mut z, mut out, 65533, pos)
      pos += 1
    } else if c == 13 && newlines {
      emit(mut z, mut out, 10, pos)
      pos += 1
      if pos < end && input_byte(z, pos) == 10 {
        pos += 1
      }
    } else {
      emit(
        mut z,
        mut out,
        if fold {
          lower(c)
        } else {
          c
        },
        pos
      )
      pos += 1
    }
  }
  // A limit can interrupt a UTF-8 scalar; discard the partial builder.
  if z.status >= 2 {
    return ""
  }
  text.finish_valid(take out)
}

