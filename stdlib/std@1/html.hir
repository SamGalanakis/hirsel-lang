// Go src/html/escape.go:166-181 htmlEscaper/EscapeString,
// ebe2feefc400f813aefdc8a036e66d2619da6649 (BSD-3-Clause; third-party/NOTICES.md).

/// Text to escape when formatted.
@format(escaped_format)
pub type Escaped {
  text: String,
}

/// Wrap text so an f-string hole escapes it as HTML.
@noalloc
pub fn esc(value: String) -> Escaped in value uses {} {
  // A formatting wrapper may share immutable text; it does not mutate it.
  Escaped(text: value)
}

fn escaped_format(value: Escaped, mut out: List[u8]) -> () uses {} {
  escape_into(mut out, value.text)
}

/// Append HTML text/quoted-attribute escaping, retaining existing output bytes.
@preserves_unique(out)
pub fn escape_into(mut out: List[u8], value: String) -> () uses {} {
  // Go strings/replace.go:550-579, byteStringReplacer.WriteString at
  // ebe2feefc400f813aefdc8a036e66d2619da6649: flush unchanged spans, then
  // replacements, rather than growing/checking the builder for every byte.
  let data = string.as_bytes(value)
  let mut start: u64 = 0
  let mut at: u64 = 0
  while at < bytes.len(data) {
    let b = data[at]
    let replacement = if b == b'&' {
      "&amp;"
    } else if b == b'<' {
      "&lt;"
    } else if b == b'>' {
      "&gt;"
    } else if b == b'"' {
      "&#34;"
    } else if b == b'\'' {
      "&#39;"
    } else {
      at += 1
      continue
    }
    if start < at {
      core@1/bytes.append(mut out, core@1/bytes.slice(data, start, at))
    }
    text.append(mut out, replacement)
    at += 1
    start = at
  }
  if start < at {
    core@1/bytes.append(mut out, core@1/bytes.slice(data, start, at))
  }
}

/// Escape &, <, >, double quote and apostrophe as HTML character references.
pub fn escape(value: String) -> unique String uses {} {
  let mut out: List[u8] = []
  escape_into(mut out, value)
  text.finish_valid(take out)
}
