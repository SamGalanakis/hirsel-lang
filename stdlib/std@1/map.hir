// Equality ignores insertion order and borrows all entries, including opaque data.
@noalloc
pub fn same_entries[K: key, V: data](a: Map[K, V], b: Map[K, V]) -> bool {
  let mut a_count: u64 = 0
  let mut b_count: u64 = 0
  for _ in a {
    a_count += 1
  }
  for _ in b {
    b_count += 1
  }
  if a_count != b_count {
    return false
  }
  // map.get returns an owned V, whose opaque destruction contract need not
  // promise noalloc_drop. Borrowed scans retain the original data-only bound.
  for entry in a {
    let mut found: bool = false
    for other in b {
      if entry == other {
        found = true
        break
      }
    }
    if !found {
      return false
    }
  }
  true
}

// One probe. Initialization runs only for an absent key; updates borrow the
// stored value, so a hit copies neither the key nor the value.
@preserves_unique(m)
pub fn upsert[K: key, V](
  mut m: unique Map[K, V],
  k: K,
  initial: fn() -> unique V uses {},
  change: fn(mut value: unique V) -> () uses {}
) -> () uses {} {
  core@1/map.upsert_with(mut m, k, initial, change)
}

@preserves_unique(m)
pub fn update[K: key, V](
  mut m: unique Map[K, V],
  k: K,
  change: fn(mut value: unique V) -> () uses {}
) -> bool uses {} {
  core@1/map.update_with(mut m, k, change)
}

// Change only a present value, with ordinary copy-on-write access. Keys and
// insertion order stay unchanged. A miss calls nothing and copies nothing.
// A saved copy of m keeps its contents; callback failure keeps prior writes.
pub fn update_value[K: key, V: copyable](
  mut m: Map[K, V],
  k: K,
  change: fn(mut value: V) -> () uses {}
) -> bool uses {} {
  core@1/map.update_value_with(mut m, k, change)
}
