        let email = email_address(content)
        if email || uri_scheme(content) {
          let value = unescape(content, false)
          let id = new_child(mut budget, mut p, parent, 16)?
          p.nodes[id].info = normalize_uri(
            if email {
              string.concat("mailto:", value)
            } else {
              value
            }
          )
          if budget.mode == 2 {
            admit(mut budget, 1)?
            p.sources[id].row.primary = mapped_origin(ip.runs, start, end + 1)
            p.sources[id].row.destination = mapped_origin(ip.runs, start + 1, end)
          }
          let text_id_10 = text_node(mut budget, mut p, id, value, 9)?
          if budget.mode == 2 {
            inline_source(mut budget, mut p, text_id_10, ip.runs, start + 1, end, true)?
          }
          ip.at = end + 1
          continue
        }
      }
      let html_end = html_tag_end(ip.source, start)
      if html_end > start {
        let text_id_11 = text_node(
          mut budget,
          mut p,
          parent,
          piece(ip.source, start, html_end),
          13
        )?
        if budget.mode == 2 {
          inline_source(mut budget, mut p, text_id_11, ip.runs, start, html_end, false)?
