// CommonMark 0.31.2 block/inline passes adapted from commonmark.js.
// Copyright (c) 2014 John MacFarlane. BSD-2-Clause third-party/NOTICES.md.
// Safety: commonmark.js 8988869 lib/render/html.js:6-10, 100-131, 249-269.
// Tag filter: cmark-gfm 27d942c extensions/tagfilter.c:5-60.
/// Extensions are opt-in. Rendering omits raw HTML and unsafe destinations by default.
pub type Options {
  tables: bool,
  strikethrough: bool,
  autolinks: bool,
  task_lists: bool,
  /// cmark footnotes are an explicit extension, independent of GFM.
  footnotes: bool,
  /// Emit raw HTML and unsafe link/image destinations. Only for trusted input.
  allow_unsafe: bool,
  /// Escape disallowed GFM raw tags, including when allow_unsafe is enabled.
  tagfilter: bool,
}

/// Block and inline payloads. Table alignment: 0 none, 1 left, 2 center, 3 right.
pub type Kind = Document | Paragraph | Heading(u64) | BlockQuote | ListBlock(
  bool,
  u64,
  bool
) | Item(Option[bool]) | CodeBlock(String, String) | HtmlBlock(String) | ThematicBreak | Text(
  String
) | SoftBreak | HardBreak | Code(String) | HtmlInline(String) | Emphasis | Strong | Link(
  String,
  String
) | Image(String, String) | Strikethrough | Table | TableRow(bool) | TableCell(u8) | FootnoteDefinition(
  String
) | FootnoteReference(String, u64, u64) | FootnoteBackrefs(String, u64, u64)

/// An owned, editable tree. HTML rendering depends only on this AST.
pub type Node {
  kind: Kind,
  children: List[Node],
}

/// Independent original-source, cumulative parser-record and nesting bounds.
pub type ParseBudget {
  source_bytes: u64,
  work_items: u64,
  nesting: u64,
}

/// Operational refusal; Markdown grammar itself remains total.
pub type ParseLimit = SourceBytes | WorkItems | Nesting

type ParseState {
  // 0: unrestricted; 1: bounded; 2: bounded with source metadata.
  mode: u8,
  work: u64,
  nesting: u64,
}

fn admit(mut budget: ParseState, count: u64) -> Result[(), ParseLimit] uses {} {
  if budget.mode != 0 {
    if count > budget.work {
      return Error(WorkItems())
    }
    budget.work -= count
  }
  Ok(())
}

fn admit_nesting(budget: ParseState, count: u64) -> Result[(), ParseLimit] uses {} {
  if budget.mode != 0 && count > budget.nesting {
    return Error(Nesting())
  }
  Ok(())
}

// Parent chains are iterative: no host recursion precedes admission.
fn child_depth(budget: ParseState, nodes: List[Entry], parent: u64) -> Result[
  (),
  ParseLimit
] uses {} {
  let mut remaining = budget.nesting
  if budget.mode == 0 {
    return Ok(())
  }
  if remaining == 0 {
    return Error(Nesting())
  }
  remaining -= 1
  let mut id = parent
  while true {
    if remaining == 0 {
      return Error(Nesting())
    }
    remaining -= 1
    if id == 0 {
      return Ok(())
    }
    id = nodes[id].parent
  }
  Ok(())
}

pub fn default_options() -> Options uses {} {
  Options(
    tables: false,
    strikethrough: false,
    autolinks: false,
    task_lists: false,
    footnotes: false,
    allow_unsafe: false,
    tagfilter: false
  )
}

pub fn gfm_options() -> Options uses {} {
  Options(
    tables: true,
    strikethrough: true,
    autolinks: true,
    task_lists: true,
    footnotes: false,
    allow_unsafe: false,
    tagfilter: true
  )
}

// Arena links use zero as null. The document itself is slot zero.
type Entry {
  kind: u8,
  value: String,
  info: String,
  title: String,
  number: u64,
  flag: bool,
  tight: bool,
  checked: Option[bool],
  parent: u64,
  first: u64,
  last: u64,
  next: u64,
  prev: u64,
  open: bool,
  indent: u64,
  padding: u64,
  marker: u8,
  fence: u64,
  html: u8,
  start_line: u64,
  end_line: u64,
}

type Reference {
  destination_origin: SourceSpan,
  title_origin: SourceSpan,
  destination: String,
  title: String,
}

type Parser {
  sources: List[EntrySource],
  maps: List[LineMap],
  nodes: List[Entry],
  tip: u64,
  line: String,
  offset: u64,
  column: u64,
  nonspace: u64,
  nonspace_column: u64,
  indent: u64,
  blank: bool,
  partial: bool,
  matched: u64,
  oldtip: u64,
  closed: bool,
  line_number: u64,
  refs: Map[String, Reference],
  options: Options,
}

fn entry(tag: u8) -> Entry uses {} {
  Entry(
    kind: tag,
    value: "",
    info: "",
    title: "",
    number: 0,
    flag: false,
    tight: true,
    checked: None(),
    parent: 0,
    first: 0,
    last: 0,
    next: 0,
    prev: 0,
    open: true,
    indent: 0,
    padding: 0,
    marker: 0,
    fence: 0,
    html: 0,
    start_line: 0,
    end_line: 0
  )
}

@noalloc
fn byte(s: String, at: u64) -> u8 uses {} {
  let data = core@1/string.as_bytes(s)
  if at < core@1/bytes.len(data) {
    data[at]
  } else {
    0
  }
}

@noalloc
fn size(s: String) -> u64 uses {} {
  core@1/string.byte_len(s)
}

fn piece(s: String, a: u64, b: u64) -> String uses {} {
  let Some(start) = core@1/string.position(s, a) else {
    return ""
  }
  let Some(end) = core@1/string.position(s, b) else {
    return ""
  }
  unique core@1/string.slice(s, start, end)
}

@noalloc
fn space(c: u8) -> bool uses {} {
  c == 32 || c == 9
}

@noalloc
fn whitespace(c: u8) -> bool uses {} {
  c == 32 || c >= 9 && c <= 13
}

@noalloc
fn member(set: String, value: u8) -> bool uses {} {
  let mut i: u64 = 0
  while i < size(set) {
    if byte(set, i) == value {
      return true
    }
    i += 1
  }
  false
}

@noalloc
fn punctuation(c: u8) -> bool uses {} {
  c >= 33 && c <= 126 && !ascii.is_alnum(c)
}

fn trim(s: String) -> String uses {} {
  let mut a: u64 = 0
  let mut b = size(s)
  while a < b && (space(byte(s, a)) || byte(s, a) == 10 || byte(s, a) == 13) {
    a += 1
  }
  while b > a && (space(byte(s, b - 1)) || byte(s, b - 1) == 10 || byte(s, b - 1) == 13) {
    b -= 1
  }
  piece(s, a, b)
}

fn starts(s: String, at: u64, prefix: String) -> bool uses {} {
  at <= size(s) && size(prefix) <= size(s) - at && piece(s, at, at + size(prefix)) == prefix
}

@noalloc
fn run(s: String, at: u64, c: u8) -> u64 uses {} {
  let mut end = at
  while end < size(s) && byte(s, end) == c {
    end += 1
  }
  end - at
}

fn new_child(mut budget: ParseState, mut p: Parser, parent: u64, tag: u8) -> Result[
  u64,
  ParseLimit
] uses {} {
  if budget.mode != 0 {
    child_depth(budget, p.nodes, parent)?
    admit(mut budget, 1)?
  }
  let id = core@1/list.len(p.nodes)
  let mut node = entry(tag)
  if budget.mode == 2 {
    // Parallel source row and run-list descriptor; absent for plain parse.
    admit(mut budget, 2)?
    core@1/list.push(mut p.sources, empty_source())
  }
  node.parent = parent
  node.prev = p.nodes[parent].last
  core@1/list.push(mut p.nodes, take node)
  let last = p.nodes[parent].last
  if last != 0 {
    p.nodes[last].next = id
  } else {
    p.nodes[parent].first = id
  }
  p.nodes[parent].last = id
  Ok(id)
}

fn unlink(mut p: Parser, id: u64) -> () uses {} {
  let parent = p.nodes[id].parent
  let prev = p.nodes[id].prev
  let next = p.nodes[id].next
  if prev != 0 {
    p.nodes[prev].next = next
  } else {
    p.nodes[parent].first = next
  }
  if next != 0 {
    p.nodes[next].prev = prev
  } else {
    p.nodes[parent].last = prev
  }
  p.nodes[id].prev = 0
  p.nodes[id].next = 0
}

fn move_child(mut p: Parser, id: u64, parent: u64) -> () uses {} {
  unlink(mut p, id)
  let last = p.nodes[parent].last
  p.nodes[id].parent = parent
  p.nodes[id].prev = last
  if last != 0 {
    p.nodes[last].next = id
  } else {
    p.nodes[parent].first = id
  }
  p.nodes[parent].last = id
}

fn find_nonspace(mut p: Parser) -> () uses {} {
  let mut at = p.offset
  let mut col = p.column
  while at < size(p.line) && space(byte(p.line, at)) {
    col += if byte(p.line, at) == 9 {
      4 - col % 4
    } else {
      1
    }
    at += 1
  }
  p.nonspace = at
  p.nonspace_column = col
  p.indent = col - p.column
  p.blank = at == size(p.line)
}

fn advance(mut p: Parser, count: u64, columns: bool) -> () uses {} {
  let mut left = count
  while left > 0 && p.offset < size(p.line) {
    if byte(p.line, p.offset) == 9 {
      let width: u64 = 4 - p.column % 4
      let used = if columns && width > left {
        left
      } else {
        width
      }
      p.partial = columns && width > left
      p.column += used
      if !p.partial {
        p.offset += 1
      }
      left -= if columns {
        used
      } else {
        1
      }
    } else {
      p.partial = false
      p.offset += 1
      p.column += 1
      left -= 1
    }
  }
}

fn advance_nonspace(mut p: Parser) -> () uses {} {
  p.offset = p.nonspace
  p.column = p.nonspace_column
  p.partial = false
}

fn add_line(mut budget: ParseState, mut p: Parser) -> Result[(), ParseLimit] uses {} {
  let mut out: List[u8] = []
  text.append(mut out, p.nodes[p.tip].value)
  let mut mapped_offset = if budget.mode == 2 {
    size(p.nodes[p.tip].value)
  } else {
    0
  }
  if p.partial {
    let mut n: u64 = 4 - p.column % 4
    while n > 0 {
      core@1/list.push(mut out, 32u8)
      n -= 1
    }
    if budget.mode == 2 {
      let range = mapped_origin(p.maps[p.line_number - 1].runs, p.offset, p.offset + 1)
      if range.tag != 0 {
        return Error(WorkItems())
      }
      append_run(
        mut budget,
        mut p.sources[p.tip].runs,
        OriginRun(
          start: mapped_offset,
          end: mapped_offset + 4 - p.column % 4,
          original: range,
          affine: false
        )
      )?
      mapped_offset += 4 - p.column % 4
    }
    p.offset += 1
  }
  let target = p.tip
  let content_start = p.offset
  let content_end = size(p.line)
  if budget.mode == 2 {
    append_content(mut budget, mut p, target, content_start, content_end, mapped_offset)?
  }
  if budget.mode == 2 {
    let range = p.maps[p.line_number - 1].terminator
    if range.tag == 0 {
      let at = mapped_offset + size(p.line) - p.offset
      append_run(
        mut budget,
        mut p.sources[target].runs,
        OriginRun(
          start: at,
          end: at + 1,
          original: range,
          affine: range.end - range.start == 1
        )
      )?
    }
  }
  text.append(mut out, piece(p.line, p.offset, size(p.line)))
  core@1/list.push(mut out, 10u8)
  let value = text.finish_valid(take out)
  p.nodes[p.tip].value = value
  if budget.mode == 2 {
    extend_blocks(mut p, target)
  }
  Ok(())
}

fn can_contain(tag: u8, child: u8) -> bool uses {} {
  if tag == 4 {
    child == 5
  } else {
    (tag == 0 || tag == 3 || tag == 5 || tag == 22) && child != 5
  }
}

fn finish_at(mut budget: ParseState, id: u64, line: u64, mut p: Parser) -> Result[
  (),
  ParseLimit
] uses {} {
  if p.nodes[id].kind == 1 {
    // Keep definition-only paragraphs until lists have measured blank gaps,
    // as commonmark.js lib/blocks.js:277-299 does before document finalization.
    let _ = remove_references(mut budget, mut p, id)?
  }
  p.nodes[id].open = false
  p.nodes[id].end_line = line
  if p.nodes[id].kind == 6 {
    if p.nodes[id].fence != 0 {
      if let Some((info, rest)) = string.split_once(p.nodes[id].value, "\n") {
        let info_origin = if budget.mode == 2 {
          let (a, b) = trim_bounds(info)
          if a == b {
            absent_span(2)
          } else {
            mapped_origin(p.sources[id].runs, a, b)
          }
        } else {
          absent_span(1)
        }
        let decoded = unescape(trim(info), true)
        let literal = unique rest
        if budget.mode == 2 {
          admit(mut budget, 1)?
          p.sources[id].row.info = info_origin
        }
        p.nodes[id].info = decoded
        p.nodes[id].value = literal
      }
    } else {
      let value = unique p.nodes[id].value
      let mut end = size(value)
      let mut blank_lines: u64 = 0
      while end > 0 {
        let mut start = end - 1
        while start > 0 && byte(value, start - 1) != 10 {
          start -= 1
        }
        if size(trim(piece(value, start, end))) != 0 {
          break
        }
        end = start
        blank_lines += 1
      }
      let literal = piece(value, 0, end)
      if budget.mode == 2 {
        let end_content = if end > 0 && byte(value, end - 1) == 10 {
          end - 1
        } else {
          end
        }
        p.sources[id].row.primary = mapped_origin(p.sources[id].runs, 0, end_content)
      }
      p.nodes[id].value = literal
      p.nodes[id].end_line -= blank_lines
    }
  }
  if p.nodes[id].kind == 4 {
    let mut item = p.nodes[id].first
    let mut tight = true
    while item != 0 {
      let next = p.nodes[item].next
      if next != 0 && p.nodes[item].end_line + 1 < p.nodes[next].start_line {
        tight = false
      }
      let mut child = p.nodes[item].first
      while child != 0 {
        let following = p.nodes[child].next
        if following != 0 && p.nodes[child].end_line + 1 < p.nodes[following].start_line {
          tight = false
        }
        child = following
      }
      item = next
    }
    p.nodes[id].tight = tight
    let last = p.nodes[id].last
    if last != 0 {
      p.nodes[id].end_line = p.nodes[last].end_line
    }
  }
  if p.nodes[id].kind == 5 {
    let last = p.nodes[id].last
    p.nodes[id].end_line = if last == 0 {
      p.nodes[id].start_line
    } else {
      p.nodes[last].end_line
    }
  }
  p.tip = p.nodes[id].parent
  Ok(())
}

fn close_unmatched(mut budget: ParseState, mut p: Parser) -> Result[(), ParseLimit] uses {} {
  if !p.closed {
    while p.oldtip != p.matched {
      let parent = p.nodes[p.oldtip].parent
      let close_id = p.oldtip
      let close_line = p.line_number - 1
      finish_at(mut budget, close_id, close_line, mut p)?
      p.oldtip = parent
    }
    p.closed = true
  }
  Ok(())
}

fn add_block(mut budget: ParseState, mut p: Parser, tag: u8) -> Result[u64, ParseLimit] uses {} {
  while !can_contain(p.nodes[p.tip].kind, tag) {
    let close_id = p.tip
    let close_line = p.line_number - 1
    finish_at(mut budget, close_id, close_line, mut p)?
  }
  let tip = p.tip
  let id = new_child(mut budget, mut p, tip, tag)?
  p.nodes[id].start_line = p.line_number
  if budget.mode == 2 {
    let (_, end) = trim_bounds(p.line)
    p.sources[id].row.primary = mapped_origin(
      p.maps[p.line_number - 1].runs,
      p.nonspace,
      end
    )
  }
  p.tip = id
  Ok(id)
}

// HTML tag scanner implements commonmark.js common.js tag/attribute grammar.
fn html_tag_end(s: String, at: u64) -> u64 uses {} {
  if byte(s, at) != 60 {
    return at
  }
  let mut i = at + 1
  if starts(s, at, "<!-->") {
    return at + 5
  }
  if starts(s, at, "<!--->") {
    return at + 6
  }
  let close = if starts(s, at, "<!--") {
    "-->"
  } else if starts(s, at, "<?") {
    "?>"
  } else if starts(s, at, "<![CDATA[") {
    "]]>"
  } else {
    ""
  }
  if close != "" {
    let suffix = piece(s, i, size(s))
    if let Some(pos) = string.find(suffix, close) {
      return i + core@1/string.byte_offset(suffix, pos) + size(close)
    }
    return at
  }
  if byte(s, i) == 33 && ascii.is_alpha(byte(s, i + 1)) {
    while i < size(s) && byte(s, i) != 62 {
      i += 1
    }
    return if i < size(s) {
      i + 1
    } else {
      at
    }
  }
  let closing = byte(s, i) == 47
  if closing {
    i += 1
  }
  if !ascii.is_alpha(byte(s, i)) {
    return at
  }
  i += 1
  while ascii.is_alnum(byte(s, i)) || byte(s, i) == 45 {
    i += 1
  }
  while i < size(s) {
    let prior_offset = i
    while whitespace(byte(s, i)) {
      i += 1
    }
    if byte(s, i) == 62 {
      return i + 1
    }
    if !closing && starts(s, i, "/>") {
      return i + 2
    }
    if closing || prior_offset == i {
      return at
    }
    let c = byte(s, i)
    if !ascii.is_alpha(c) && c != 95 && c != 58 {
      return at
    }
    i += 1
    while ascii.is_alnum(byte(s, i)) || member("_:.-", byte(s, i)) && i < size(s) {
      i += 1
    }
    let after_name = i
    while whitespace(byte(s, i)) {
      i += 1
    }
    if byte(s, i) == 61 {
      i += 1
      while whitespace(byte(s, i)) {
        i += 1
      }
      let quote = byte(s, i)
      if quote == 34 || quote == 39 {
        i += 1
        while i < size(s) && byte(s, i) != quote {
          i += 1
        }
        if i == size(s) {
          return at
        }
        i += 1
      } else {
        let start = i
        while i < size(s) && !whitespace(byte(s, i)) && !member("\"'=<>`", byte(s, i)) {
          i += 1
        }
        if i == start {
          return at
        }
      }
    } else {
      i = after_name
    }
  }
  at
}

fn html_block_type(s: String, paragraph: bool) -> u8 uses {} {
  if byte(s, 0) != 60 {
    return 0
  }
  let lower = string.ascii_lower(s)
  let mut end: u64 = if byte(s, 1) == 47 {
    2
  } else {
    1
  }
  let begin = end
  while ascii.is_alnum(byte(s, end)) {
    end += 1
  }
  let tag = piece(lower, begin, end)
  let delim = byte(s, end)
  if begin == 1 && (delim == 0 || delim == 62 || whitespace(delim)) && (tag == "script" || tag == "pre" || tag == "style" || tag == "textarea") {
    return 1
  }
  if starts(s, 0, "<!--") {
    return 2
  }
  if starts(s, 0, "<?") {
    return 3
  }
  if starts(s, 0, "<!") && ascii.is_alpha(byte(s, 2)) {
    return 4
  }
  if starts(s, 0, "<![CDATA[") {
    return 5
  }
  if (delim == 0 || delim == 62 || whitespace(delim) || starts(s, end, "/>")) && tag != "" && string.contains(
    "|address|article|aside|base|basefont|blockquote|body|caption|center|col|colgroup|dd|details|dialog|dir|div|dl|dt|fieldset|figcaption|figure|footer|form|frame|frameset|h1|h2|h3|h4|h5|h6|head|header|hr|html|iframe|legend|li|link|main|menu|menuitem|nav|noframes|ol|optgroup|option|p|param|section|search|summary|table|tbody|td|tfoot|th|thead|title|tr|track|ul|",
    string.concat(string.concat("|", tag), "|")
  ) {
    return 6
  }
  if !paragraph {
    let n = html_tag_end(s, 0)
    if n > 0 && size(trim(piece(s, n, size(s)))) == 0 {
      return 7
    }
  }
  0
}

fn html_closed(s: String, tag: u8) -> bool uses {} {
  if tag == 1 {
    let lower = string.ascii_lower(s)
    string.contains(lower, "</script>") || string.contains(lower, "</pre>") || string.contains(
      lower,
      "</style>"
    ) || string.contains(lower, "</textarea>")
  } else if tag == 2 {
    string.contains(s, "-->")
  } else if tag == 3 {
    string.contains(s, "?>")
  } else if tag == 4 {
    string.contains(s, ">")
  } else if tag == 5 {
    string.contains(s, "]]>")
  } else {
    false
  }
}

fn thematic(s: String) -> bool uses {} {
  let c = byte(s, 0)
  if c != 42 && c != 95 && c != 45 {
    return false
  }
  let mut count: u64 = 0
  let mut i: u64 = 0
  while i < size(s) {
    let b = byte(s, i)
    if b == c {
      count += 1
    } else if !space(b) {
      return false
    }
    i += 1
  }
  count >= 3
}

// Returns (marker length, marker byte, start, ordered).
fn list_marker(s: String, paragraph: bool) -> Option[(u64, u8, u64, bool)] uses {} {
  let c = byte(s, 0)
  let mut n: u64 = 1
  let mut start: u64 = 0
  let mut ordered = false
  if c != 42 && c != 43 && c != 45 {
    n = 0
    while n < 9 && ascii.is_digit(byte(s, n)) {
      start = start * 10 + core@1/int.widen(byte(s, n) - 48u8)
      n += 1
    }
    if n == 0 || byte(s, n) != 46 && byte(s, n) != 41 || paragraph && start != 1 {
      return None()
    }
    n += 1
    ordered = true
  }
  if byte(s, n) != 0 && !space(byte(s, n)) {
    return None()
  }
  if paragraph && size(trim(piece(s, n, size(s)))) == 0 {
    return None()
  }
  Some((n, byte(s, n - 1), start, ordered))
}

fn continue_block(mut budget: ParseState, mut p: Parser, id: u64) -> Result[
  u8,
  ParseLimit
] uses {} {
  let tag = p.nodes[id].kind
  if tag == 0 || tag == 4 {
    return Ok(0)
  }
  if tag == 3 {
    if p.indent < 4 && byte(p.line, p.nonspace) == 62 {
      advance_nonspace(mut p)
      advance(mut p, 1, false)
      if space(byte(p.line, p.offset)) {
        advance(mut p, 1, true)
      }
      return Ok(0)
    }
    return Ok(1)
  }
  if tag == 22 {
    if p.indent >= 4 {
      advance(mut p, 4, true)
    } else if p.blank {
      advance_nonspace(mut p)
    } else {
      return Ok(1)
    }
    return Ok(0)
  }
  if tag == 5 {
    let padding = p.nodes[id].indent + p.nodes[id].padding
    if p.indent >= padding {
      advance(mut p, padding, true)
    } else if p.blank && p.nodes[id].first != 0 {
      advance_nonspace(mut p)
    } else {
      return Ok(1)
    }
    return Ok(0)
  }
  if tag == 19 {
    let s = piece(p.line, p.nonspace, size(p.line))
    if p.blank || p.indent < 4 && (thematic(s) || byte(s, 0) == 62 || byte(s, 0) == 35 || byte(
      s,
      0
    ) == 96 || byte(s, 0) == 126 || html_block_type(s, true) != 0 || list_marker(
      s,
      true
    ) != None()) {
      return Ok(1)
    }
    return Ok(0)
  }
  if tag == 2 || tag == 8 {
    return Ok(1)
  }
  if tag == 6 {
    if p.nodes[id].fence != 0 {
      let n = run(p.line, p.nonspace, p.nodes[id].marker)
      if p.indent <= 3 && n >= p.nodes[id].fence && size(
        trim(piece(p.line, p.nonspace + n, size(p.line)))
      ) == 0 {
        if budget.mode == 2 {
          let endpoint = mapped_origin(
            p.maps[p.line_number - 1].runs,
            p.nonspace + n,
            p.nonspace + n
          )
          let mut current = id
          while current != 0 {
            p.sources[current].row.primary = hull(
              p.sources[current].row.primary,
              endpoint
            )
            current = p.nodes[current].parent
          }
        }
        let close_id = id
        let close_line = p.line_number
        finish_at(mut budget, close_id, close_line, mut p)?
        return Ok(2)
      }
      let mut remaining = p.nodes[id].indent
      while remaining > 0 && space(byte(p.line, p.offset)) {
        advance(mut p, 1, true)
        remaining -= 1
      }
    } else if p.indent >= 4 {
      advance(mut p, 4, true)
    } else if p.blank {
      advance_nonspace(mut p)
    } else {
      return Ok(1)
    }
    return Ok(0)
  }
  if tag == 7 {
    return Ok(
      if p.blank && p.nodes[id].html >= 6 {
        1
      } else {
        0
      }
    )
  }
  if tag == 1 {
    return Ok(
      if p.blank {
        1
      } else {
        0
      }
    )
  }
  Ok(1)
}

fn start_block(mut budget: ParseState, mut p: Parser, container: u64) -> Result[
  u8,
  ParseLimit
] uses {} {
  let s = piece(p.line, p.nonspace, size(p.line))
  let c = byte(s, 0)
  if p.indent < 4 {
    if c == 62 {
      advance_nonspace(mut p)
      advance(mut p, 1, false)
      if space(byte(p.line, p.offset)) {
        advance(mut p, 1, true)
      }
      close_unmatched(mut budget, mut p)?
      add_block(mut budget, mut p, 3)?
      return Ok(1)
    }
    let hashes = run(s, 0, 35)
    if hashes >= 1 && hashes <= 6 && (byte(s, hashes) == 0 || space(byte(s, hashes))) {
      advance_nonspace(mut p)
      advance(mut p, hashes, false)
      close_unmatched(mut budget, mut p)?
      let id = add_block(mut budget, mut p, 2)?
      p.nodes[id].number = hashes
      let raw = trim(piece(p.line, p.offset, size(p.line)))
      let mut end = size(raw)
      while end > 0 && byte(raw, end - 1) == 35 {
        end -= 1
      }
      let value = if end == 0 || end < size(raw) && space(byte(raw, end - 1)) {
        copy trim(piece(raw, 0, end))
      } else {
        copy raw
      }
      if budget.mode == 2 {
        let (left, _) = trim_bounds(piece(p.line, p.offset, size(p.line)))
        let begin = p.offset + left
        append_content(mut budget, mut p, id, begin, begin + size(value), 0)?
      }
      p.nodes[id].value = unique value
      p.offset = size(p.line)
      return Ok(2)
    }
    if c == 96 || c == 126 {
      let n = run(s, 0, c)
      if n >= 3 && (c != 96 || !string.contains(piece(s, n, size(s)), "`")) {
        close_unmatched(mut budget, mut p)?
        let id = add_block(mut budget, mut p, 6)?
        p.nodes[id].fence = n
        p.nodes[id].marker = c
        p.nodes[id].indent = p.indent
        advance_nonspace(mut p)
        advance(mut p, n, false)
        return Ok(2)
      }
    }
    let ht = html_block_type(
      s,
      p.nodes[container].kind == 1 || !p.closed && !p.blank && p.nodes[p.tip].kind == 1
    )
    if ht != 0 {
      close_unmatched(mut budget, mut p)?
      let id = add_block(mut budget, mut p, 7)?
      p.nodes[id].html = ht
      return Ok(2)
    }
    if start_table(mut budget, mut p, container)? {
      return Ok(2)
    }
    if p.nodes[container].kind == 1 && (c == 61 || c == 45) {
      let n = run(s, 0, c)
      if n != 0 && size(trim(piece(s, n, size(s)))) == 0 {
        // Definitions at the start do not become heading content.
        let remaining = remove_references(mut budget, mut p, container)?
        if remaining {
          close_unmatched(mut budget, mut p)?
          p.nodes[container].kind = 2
          if budget.mode == 2 {
            extend_blocks(mut p, container)
          }
          p.nodes[container].number = if c == 61 {
            1
          } else {
            2
          }
          p.offset = size(p.line)
          return Ok(2)
        }
      }
    }
    if thematic(s) {
      close_unmatched(mut budget, mut p)?
      add_block(mut budget, mut p, 8)?
      p.offset = size(p.line)
      return Ok(2)
    }
    // cmark-gfm src/blocks.c:1218-1235: definitions are containers.
    if p.options.footnotes && starts(s, 0, "[^") {
      let end = label_end(s, 0)
      if end > 3 && byte(s, end) == 58 {
        let label = piece(s, 2, end - 1)
        close_unmatched(mut budget, mut p)?
        let id = add_block(mut budget, mut p, 22)?
        p.nodes[id].value = label
        advance_nonspace(mut p)
        advance(mut p, end + 1, false)
        return Ok(1)
      }
    }
    if let Some((length, marker, start, ordered)) = list_marker(
      s,
      p.nodes[container].kind == 1
    ) {
      let indent = p.indent
      advance_nonspace(mut p)
      advance(mut p, length, true)
      let column = p.column
      let offset = p.offset
      while space(byte(p.line, p.offset)) && p.column - column < 5 {
        advance(mut p, 1, true)
      }
      let spaces = p.column - column
      let padding = if spaces < 1 || spaces >= 5 || p.offset == size(p.line) {
        length + 1
      } else {
        length + spaces
      }
      if padding == length + 1 {
        p.column = column
        p.offset = offset
        p.partial = false
        if space(byte(p.line, p.offset)) {
          advance(mut p, 1, true)
        }
      }
      close_unmatched(mut budget, mut p)?
      let mut list = p.tip
      if p.nodes[list].kind != 4 || p.nodes[list].marker != marker || p.nodes[list].flag != ordered {
        list = add_block(mut budget, mut p, 4)?
        p.nodes[list].marker = marker
        p.nodes[list].flag = ordered
        p.nodes[list].number = start
      }
      let id = add_block(mut budget, mut p, 5)?
      p.nodes[id].indent = indent
      p.nodes[id].padding = padding
      return Ok(1)
    }
  }
  if p.indent >= 4 && p.nodes[p.tip].kind != 1 && !p.blank {
    advance(mut p, 4, true)
    close_unmatched(mut budget, mut p)?
    add_block(mut budget, mut p, 6)?
    return Ok(2)
  }
  Ok(0)
}

fn incorporate(mut budget: ParseState, mut p: Parser, take line: String) -> Result[
  (),
  ParseLimit
] uses {} {
  p.line = line
  p.line_number += 1
  p.oldtip = p.tip
  p.offset = 0
  p.column = 0
  p.partial = false
  let mut container: u64 = 0
  while p.nodes[container].last != 0 && p.nodes[p.nodes[container].last].open {
    let child = p.nodes[container].last
    find_nonspace(mut p)
    let status = continue_block(mut budget, mut p, child)?
    if status == 2 {
      return Ok(())
    }
    if status == 1 {
      break
    }
    container = child
  }
  p.closed = container == p.oldtip
  p.matched = container
  let mut leaf = p.nodes[container].kind == 6 || p.nodes[container].kind == 7 || p.nodes[container].kind == 19
  while !leaf {
    find_nonspace(mut p)
    let res = start_block(mut budget, mut p, container)?
    if res == 0 {
      advance_nonspace(mut p)
      break
    }
    container = p.tip
    leaf = res == 2
  }
  if !p.closed && !p.blank && p.nodes[p.tip].kind == 1 {
    add_line(mut budget, mut p)?
  } else {
    close_unmatched(mut budget, mut p)?
    let tag = p.nodes[container].kind
    if tag == 19 {
      if p.offset < size(p.line) {
        let row_source = piece(p.line, p.offset, size(p.line))
        let mapping = if budget.mode == 2 {
          slice_runs(
            mut budget,
            p.maps[p.line_number - 1].runs,
            p.offset,
            size(p.line),
            0
          )?
        } else {
          []
        }
        add_table_row(mut budget, container, row_source, false, mapping, mut p)?
      }
    } else if tag == 1 || tag == 6 || tag == 7 {
      add_line(mut budget, mut p)?
      if tag == 7 && html_closed(
        piece(p.line, p.offset, size(p.line)),
        p.nodes[container].html
      ) {
        let close_id = container
        let close_line = p.line_number
        finish_at(mut budget, close_id, close_line, mut p)?
      }
    } else if p.offset < size(p.line) && !p.blank {
      add_block(mut budget, mut p, 1)?
      advance_nonspace(mut p)
      add_line(mut budget, mut p)?
    }
  }
  if budget.mode == 2 && p.nodes[p.tip].kind == 19 {
    let table_id = p.tip
    extend_blocks(mut p, table_id)
  }
  Ok(())
}

@noalloc
fn packed3(data: Bytes, at: u64) -> u32 uses {} {
  let a: u32 = core@1/int.widen(data[at])
  let b: u32 = core@1/int.widen(data[at + 1])
  let c: u32 = core@1/int.widen(data[at + 2])
  a | b << 8 | c << 16
}

fn entity_lookup(name: String) -> Option[String] uses {} {
  let mut low: u64 = 0
  let mut high = core@1/bytes.len(ENTITY_INDEX) / 3
  while low < high {
    let middle = low + (high - low) / 2
    let at: u64 = core@1/int.widen(packed3(ENTITY_INDEX, middle * 3))
    let mut end = at
    while byte(ENTITY_DATA, end) != 0 {
      end += 1
    }
    let key = piece(ENTITY_DATA, at, end)
    if name < key {
      high = middle
    } else if name > key {
      low = middle + 1
    } else {
      let start = end + 1
      end = start
      while byte(ENTITY_DATA, end) != 0 {
        end += 1
      }
      return Some(piece(ENTITY_DATA, start, end))
    }
  }
  None()
}

fn unicode_punctuation(c: char) -> bool uses {} {
  let cp = core@1/char.to_u32(c)
  let mut low: u64 = 0
  let mut high = core@1/bytes.len(PUNCTUATION) / 6
  while low < high {
    let middle = low + (high - low) / 2
    if cp < packed3(PUNCTUATION, middle * 6) {
      high = middle
    } else if cp > packed3(PUNCTUATION, middle * 6 + 3) {
      low = middle + 1
    } else {
      return true
    }
  }
  false
}

fn entity(s: String, at: u64) -> Option[(String, u64)] uses {} {
  if byte(s, at) != 38 {
    return None()
  }
  let mut end = at + 1
  if byte(s, end) == 35 {
    end += 1
    let hex = byte(s, end) == 120 || byte(s, end) == 88
    if hex {
      end += 1
    }
    let begin = end
    let mut value: u32 = 0
    let base: u32 = if hex {
      16
    } else {
      10
    }
    let max: u64 = if hex {
      6
    } else {
      7
    }
    while end - begin < max {
      let Some(digit) = ascii.digit_value_radix(byte(s, end), core@1/int.narrow(base)) else {
        break
      }
      value = value * base + core@1/int.widen(digit)
      end += 1
    }
    if end == begin || byte(s, end) != 59 {
      return None()
    }
    // CommonMark numeric references replace invalid scalars with U+FFFD.
    let c = if value == 0 || value > 1114111 || value >= 55296 && value <= 57343 {
      '\u{fffd}'
    } else {
      match core@1/char.from_u32(value) {
        Some(c) => c,
        None() => '\u{fffd}',
      }
    }
    let mut out: List[u8] = []
    char.format_into(c, mut out)
    return Some((text.finish_valid(take out), end + 1))
  }
  while end - at <= 32 && ascii.is_alnum(byte(s, end)) {
    end += 1
  }
  if end - at < 3 || byte(s, end) != 59 {
    return None()
  }
  match entity_lookup(piece(s, at + 1, end)) {
    Some(value) => Some((value, end + 1)),
    None() => None(),
  }
}

fn unescape(s: String, escapes: bool) -> String uses {} {
  let mut out: List[u8] = []
  let mut i: u64 = 0
  while i < size(s) {
    if escapes && byte(s, i) == 92 && punctuation(byte(s, i + 1)) {
      core@1/list.push(mut out, byte(s, i + 1))
      i += 2
    } else if let Some((value, end)) = entity(s, i) {
      text.append(mut out, value)
      i = end
    } else {
      core@1/list.push(mut out, byte(s, i))
      i += 1
    }
  }
  text.finish_valid(take out)
}

fn normalize_uri(s: String) -> String uses {} {
  let mut out: List[u8] = []
  let hex = "0123456789ABCDEF"
  let mut i: u64 = 0
  while i < size(s) {
    let b = byte(s, i)
    if ascii.is_alnum(b) || member(";/?:@&=+$,-_.!~*'()#", byte(s, i)) || b == 37 && i + 2 < size(
      s
    ) && ascii.digit_value_radix(byte(s, i + 1), 16) != None() && ascii.digit_value_radix(
      byte(s, i + 2),
      16
    ) != None() {
      core@1/list.push(mut out, b)
      if b == 37 {
        core@1/list.push(mut out, byte(s, i + 1))
        core@1/list.push(mut out, byte(s, i + 2))
        i += 2
      }
    } else {
      core@1/list.push(mut out, 37u8)
      core@1/list.push(mut out, byte(hex, core@1/int.widen(b / 16u8)))
      core@1/list.push(mut out, byte(hex, core@1/int.widen(b % 16u8)))
    }
    i += 1
  }
  text.finish_valid(take out)
}

fn skip_space(s: String, at: u64) -> u64 uses {} {
  let mut i = at
  while space(byte(s, i)) {
    i += 1
  }
  if byte(s, i) == 10 {
    i += 1
    while space(byte(s, i)) {
      i += 1
    }
  }
  i
}

fn destination(s: String, at: u64) -> Option[(String, u64)] uses {} {
  let angle = byte(s, at) == 60
  let begin = if angle {
    at + 1
  } else {
    at
  }
  let mut i = begin
  let mut depth: u64 = 0
  while i < size(s) {
    let c = byte(s, i)
    if c == 92 && punctuation(byte(s, i + 1)) {
      i += 2
      continue
    }
    if angle {
      if c == 62 {
        return Some((normalize_uri(unescape(piece(s, begin, i), true)), i + 1))
      }
      if c == 60 || c == 10 {
        return None()
      }
    } else {
      if c <= 32 {
        break
      }
      if c == 40 {
        depth += 1
      }
      if c == 41 {
        if depth == 0 {
          break
        }
        depth -= 1
      }
    }
    i += 1
  }
  if angle || depth != 0 || i == begin && byte(s, i) != 41 {
    return None()
  }
  Some((normalize_uri(unescape(piece(s, begin, i), true)), i))
}

fn link_title(s: String, at: u64) -> Option[(String, u64)] uses {} {
  let c = byte(s, at)
  if c != 34 && c != 39 && c != 40 {
    return None()
  }
  let close: u8 = if c == 40 {
    41
  } else {
    c
  }
  let mut i = at + 1
  while i < size(s) {
    if byte(s, i) == close {
      return Some((unescape(piece(s, at + 1, i), true), i + 1))
    }
    if c == 40 && byte(s, i) == 40 {
      return None()
    }
    if byte(s, i) == 92 && punctuation(byte(s, i + 1)) {
      i += 1
    }
    i += 1
  }
  None()
}

fn label_end(s: String, at: u64) -> u64 uses {} {
  if byte(s, at) != 91 {
    return at
  }
  let mut i = at + 1
  let mut count: u64 = 0
  while i < size(s) && count <= 999 {
    if byte(s, i) == 93 {
      return i + 1
    }
    if byte(s, i) == 91 {
      return at
    }
    if byte(s, i) == 92 && i + 1 < size(s) {
      i += 1
    }
    i += 1
    count += 1
  }
  at
}

fn normalize_label(s: String) -> String uses {} {
  let folded = string.casefold(s)
  let mut out: List[u8] = []
  let mut pending = false
  let mut any = false
  for c in core@1/string.scalars(folded) {
    if unicode.is_whitespace(c) {
      pending = any
    } else {
      if pending {
        core@1/list.push(mut out, 32u8)
      }
      char.format_into(c, mut out)
      pending = false
      any = true
    }
  }
  text.finish_valid(take out)
}

fn line_end(s: String, at: u64) -> Option[u64] uses {} {
  let mut i = at
  while space(byte(s, i)) {
    i += 1
  }
  if i == size(s) {
    Some(i)
  } else if byte(s, i) == 10 {
    Some(i + 1)
  } else {
    None()
  }
}

fn reference(
  mut budget: ParseState,
  s: String,
  runs: List[OriginRun],
  base: u64,
  mut refs: Map[String, Reference]
) -> Result[u64, ParseLimit] uses {} {
  let n = label_end(s, 0)
  if n == 0 || byte(s, n) != 58 {
    return Ok(0)
  }
  let label = normalize_label(piece(s, 1, n - 1))
  if label == "" {
    return Ok(0)
  }
  let dest_start = skip_space(s, n + 1)
  let Some((dest, end)) = destination(s, dest_start) else {
    return Ok(0)
  }
  let after_space = skip_space(s, end)
  let mut title = ""
  let mut title_origin = absent_span(2)
  let mut consumed = line_end(s, end)
  if after_space > end {
    if let Some((value, after)) = link_title(s, after_space) {
      if let Some(final) = line_end(s, after) {
        consumed = Some(final)
        title = value
        if budget.mode == 2 {
          title_origin = mapped_origin(runs, base + after_space + 1, base + after - 1)
        }
      }
    }
  }
  let Some(final) = consumed else {
    return Ok(0)
  }
  if core@1/map.get(refs, label) == None() {
    admit(mut budget, 1)?
    let mut destination_origin = absent_span(2)
    if budget.mode == 2 {
      admit(mut budget, 1)?
      let angle = byte(s, dest_start) == 60
      destination_origin = mapped_origin(
        runs,
        base + dest_start + if angle {
          1
        } else {
          0
        },
        base + end - if angle {
          1
        } else {
          0
        }
      )
    }
    core@1/map.insert(
      mut refs,
      take label,
      Reference(
        destination_origin: destination_origin,
        title_origin: title_origin,
        destination: dest,
        title: title
      )
    )
  }
  Ok(final)
}

fn remove_references(mut budget: ParseState, mut p: Parser, id: u64) -> Result[
  bool,
  ParseLimit
] uses {} {
  let mut value = unique p.nodes[id].value
  let mut removed = 0u64
  while byte(value, 0) == 91 {
    let n = reference(
      mut budget,
      value,
      if budget.mode == 2 {
        p.sources[id].runs
      } else {
        []
      },
      removed,
      mut p.refs
    )?
    if n == 0 {
      break
    }
    removed += n
    value = piece(value, n, size(value))
  }
  content_slice(mut budget, mut p, id, removed, removed + size(value))?
  let remains = size(trim(value)) != 0
  if budget.mode == 2 && removed > 0 {
    let (a, b) = trim_bounds(value)
    p.sources[id].row.primary = mapped_origin(p.sources[id].runs, a, b)
  }
  p.nodes[id].value = unique value
  Ok(remains)
}

type Delimiter {
  node: u64,
  marker: u8,
  count: u64,
  original: u64,
  opens: bool,
  closes: bool,
  prev: u64,
  next: u64,
}

type Bracket {
  node: u64,
  index: u64,
  image: bool,
  active: bool,
  bracket_after: bool,
  delimiter: u64,
}

type InlineParser {
  runs: List[OriginRun],
  source: String,
  at: u64,
  delimiters: List[Delimiter],
  top: u64,
  brackets: unique List[Bracket],
}

fn text_node(mut budget: ParseState, mut p: Parser, parent: u64, value: String, tag: u8) -> Result[
  u64,
  ParseLimit
] uses {} {
  let id = new_child(mut budget, mut p, parent, tag)?
  p.nodes[id].value = unique value
  Ok(id)
}

fn remove_delimiter(mut ip: unique InlineParser, id: u64) -> () uses {} {
  let prev = ip.delimiters[id].prev
  let next = ip.delimiters[id].next
  if prev != 0 {
    ip.delimiters[prev].next = next
  }
  if next != 0 {
    ip.delimiters[next].prev = prev
  } else {
    ip.top = prev
  }
}

fn process_emphasis(
  mut budget: ParseState,
  mut p: Parser,
  mut ip: unique InlineParser,
  bottom: u64
) -> Result[(), ParseLimit] uses {} {
  if ip.top == 0 {
    return Ok(())
  }
  let mut closer = ip.top
  while closer != 0 && ip.delimiters[closer].prev != bottom {
    closer = ip.delimiters[closer].prev
  }
  // One lower bound per marker, flanking class and length modulo three.
  let mut bounds: List[u64] = []
  let mut k: u64 = 0
  while k < 18 {
    if budget.mode != 0 {
      admit(mut budget, 1)?
    }
    core@1/list.push(mut bounds, bottom)
    k += 1
  }
  while closer != 0 {
    if !ip.delimiters[closer].closes {
      closer = ip.delimiters[closer].next
      continue
    }
    let marker = ip.delimiters[closer].marker
    let marker_base: u64 = if marker == 42 {
      0
    } else if marker == 95 {
      6
    } else {
      12
    }
    let flanking_class: u64 = if ip.delimiters[closer].opens {
      3
    } else {
      0
    }
    let index = marker_base + flanking_class + ip.delimiters[closer].original % 3
    let mut opener = ip.delimiters[closer].prev
    while opener != 0 && opener != bottom && opener != bounds[index] {
      let odd = marker != 126 && (ip.delimiters[closer].opens || ip.delimiters[opener].closes) && ip.delimiters[closer].original % 3 != 0 && (ip.delimiters[closer].original + ip.delimiters[opener].original) % 3 == 0
      if ip.delimiters[opener].marker == marker && ip.delimiters[opener].opens && !odd && (marker != 126 || ip.delimiters[opener].count == ip.delimiters[closer].count) {
        break
      }
      opener = ip.delimiters[opener].prev
    }
    if opener == 0 || opener == bottom || opener == bounds[index] {
      bounds[index] = ip.delimiters[closer].prev
      let old = closer
      closer = ip.delimiters[closer].next
      if !ip.delimiters[old].opens {
        remove_delimiter(mut ip, old)
      }
      continue
    }
    let used: u64 = if ip.delimiters[opener].count >= 2 && ip.delimiters[closer].count >= 2 {
      2
    } else {
      1
    }
    let left = ip.delimiters[opener].node
    let right = ip.delimiters[closer].node
    let left_size = size(p.nodes[left].value)
    let right_size = size(p.nodes[right].value)
    let extent = if budget.mode == 2 {
      hull(
        mapped_origin(p.sources[left].runs, left_size - used, left_size),
        mapped_origin(p.sources[right].runs, 0, used)
      )
    } else {
      absent_span(1)
    }
    ip.delimiters[opener].count -= used
    ip.delimiters[closer].count -= used
    let left_text = copy piece(p.nodes[left].value, 0, left_size - used)
    let right_text = copy piece(
      p.nodes[right].value,
      0,
      size(p.nodes[right].value) - used
    )
    p.nodes[left].value = left_text
    p.nodes[right].value = right_text
    let parent = p.nodes[left].parent
    let emph = new_child(
      mut budget,
      mut p,
      parent,
      if marker == 126 {
        18
      } else if used == 1 {
        14
      } else {
        15
      }
    )?
    if budget.mode == 2 {
      p.sources[emph].row.primary = extent
      p.sources[left].row.primary = mapped_origin(
        p.sources[left].runs,
        0,
        left_size - used
      )
      p.sources[right].row.primary = mapped_origin(
        p.sources[right].runs,
        used,
        right_size
      )
      content_slice(mut budget, mut p, left, 0, left_size - used)?
      content_slice(mut budget, mut p, right, used, right_size)?
    }
    let mut current = p.nodes[left].next
    while current != right && current != 0 && current != emph {
      let next = p.nodes[current].next
      move_child(mut p, current, emph)
      current = next
    }
    // Insert the new emphasis immediately after the opener.
    unlink(mut p, emph)
    let next = p.nodes[left].next
    p.nodes[emph].prev = left
    p.nodes[emph].next = next
    p.nodes[left].next = emph
    if next != 0 {
      p.nodes[next].prev = emph
    } else {
      p.nodes[parent].last = emph
    }
    ip.delimiters[opener].next = closer
    ip.delimiters[closer].prev = opener
    if ip.delimiters[opener].count == 0 {
      unlink(mut p, left)
      remove_delimiter(mut ip, opener)
    }
    if ip.delimiters[closer].count == 0 {
      unlink(mut p, right)
      let next_closer = ip.delimiters[closer].next
      remove_delimiter(mut ip, closer)
      closer = next_closer
    }
  }
  while ip.top != bottom && ip.top != 0 {
    let top = ip.top
    remove_delimiter(mut ip, top)
  }
  Ok(())
}

fn adjacent_class(s: String, at: u64, previous: bool) -> (bool, bool) uses {} {
  if previous && at == 0 || !previous && at == size(s) {
    return (true, false)
  }
  let mut pos = if previous {
    at - 1
  } else {
    at
  }
  if previous {
    while pos > 0 && byte(s, pos) >= 128 && byte(s, pos) < 192 {
      pos -= 1
    }
  }
  let mut end = pos + 1
  while end < size(s) && byte(s, end) >= 128 && byte(s, end) < 192 {
    end += 1
  }
  for c in core@1/string.scalars(piece(s, pos, end)) {
    return (
      unicode.is_whitespace(c),
      unicode_punctuation(c) || punctuation(byte(s, pos))
    )
  }
  (false, false)
}

fn handle_delimiter(
  mut budget: ParseState,
  mut p: Parser,
  parent: u64,
  mut ip: unique InlineParser
) -> Result[(), ParseLimit] uses {} {
  let c = byte(ip.source, ip.at)
  let n = run(ip.source, ip.at, c)
  let (before_ws, before_punct) = adjacent_class(ip.source, ip.at, true)
  let (after_ws, after_punct) = adjacent_class(ip.source, ip.at + n, false)
  let left = !after_ws && (!after_punct || before_ws || before_punct)
  let right = !before_ws && (!before_punct || after_ws || after_punct)
  let opens = left && (c != 95 || !right || before_punct)
  let closes = right && (c != 95 || !left || after_punct)
  let id = text_node(mut budget, mut p, parent, piece(ip.source, ip.at, ip.at + n), 9)?
  inline_source(mut budget, mut p, id, ip.runs, ip.at, ip.at + n, false)?
  if (opens || closes) && (c != 126 || n <= 2) {
    let d = core@1/list.len(ip.delimiters)
    if ip.top != 0 {
      ip.delimiters[ip.top].next = d
    }
    admit(mut budget, 1)?
    core@1/list.push(
      mut ip.delimiters,
      Delimiter(
        node: id,
        marker: c,
        count: n,
        original: n,
        opens: opens,
        closes: closes,
        prev: ip.top,
        next: 0
      )
    )
    ip.top = d
  }
  ip.at += n
  Ok(())
}

fn email_address(s: String) -> bool uses {} {
  let mut i: u64 = 0
  while i < size(s) && (ascii.is_alnum(byte(s, i)) || member(
    ".!#$%&'*+/=?^_`{|}~-",
    byte(s, i)
  )) {
    i += 1
  }
  if i == 0 || byte(s, i) != 64 {
    return false
  }
  i += 1
  while i < size(s) {
    let start = i
    if !ascii.is_alnum(byte(s, i)) {
      return false
    }
    while i < size(s) && (ascii.is_alnum(byte(s, i)) || byte(s, i) == 45) {
      i += 1
    }
    if i - start > 63 || !ascii.is_alnum(byte(s, i - 1)) {
      return false
    }
    if i == size(s) {
      return true
    }
    if byte(s, i) != 46 {
      return false
    }
    i += 1
  }
  false
}

fn uri_scheme(s: String) -> bool uses {} {
  if !ascii.is_alpha(byte(s, 0)) {
    return false
  }
  let mut i: u64 = 1
  while i < 32 && (ascii.is_alnum(byte(s, i)) || byte(s, i) == 43 || byte(s, i) == 46 || byte(
    s,
    i
  ) == 45) {
    i += 1
  }
  if i < 2 || byte(s, i) != 58 {
    return false
  }
  while i < size(s) {
    if byte(s, i) <= 32 || byte(s, i) == 60 || byte(s, i) == 62 {
      return false
    }
    i += 1
  }
  true
}

fn close_bracket(
  mut budget: ParseState,
  mut p: Parser,
  parent: u64,
  mut ip: unique InlineParser
) -> Result[(), ParseLimit] uses {} {
  ip.at += 1
  let after = ip.at
  let Some(bracket) = core@1/list.pop(mut ip.brackets) else {
    let text_id_0 = text_node(mut budget, mut p, parent, "]", 9)?
    if budget.mode == 2 {
      inline_source(mut budget, mut p, text_id_0, ip.runs, after - 1, after, false)?
    }
    return Ok(())
  }
  if !bracket.active {
    let text_id_1 = text_node(mut budget, mut p, parent, "]", 9)?
    if budget.mode == 2 {
      inline_source(mut budget, mut p, text_id_1, ip.runs, after - 1, after, false)?
    }
    return Ok(())
  }
  let mut dest = ""
  let mut title = ""
  let mut matched = false
  let mut dest_origin = absent_span(2)
  let mut title_extent = absent_span(2)
  if byte(ip.source, after) == 40 {
    let begin = skip_space(ip.source, after + 1)
    if let Some((value, end)) = destination(ip.source, begin) {
      if budget.mode == 2 {
        let angle = byte(ip.source, begin) == 60
        dest_origin = mapped_origin(
          ip.runs,
          begin + if angle {
            1
          } else {
            0
          },
          end - if angle {
            1
          } else {
            0
          }
        )
      }
      let mut next = skip_space(ip.source, end)
      if next > end {
        if let Some((title_value, end_title)) = link_title(ip.source, next) {
          if budget.mode == 2 {
            title_extent = mapped_origin(ip.runs, next + 1, end_title - 1)
          }
          title = title_value
          next = skip_space(ip.source, end_title)
        }
      }
      if byte(ip.source, next) == 41 {
        matched = true
        dest = value
        ip.at = next + 1
      }
    }
  }
  if !matched {
    let end = label_end(ip.source, after)
    let mut label = ""
    if end > after + 2 {
      label = normalize_label(piece(ip.source, after + 1, end - 1))
    } else if !bracket.bracket_after {
      label = normalize_label(piece(ip.source, bracket.index + 1, after - 1))
    }
    if label != "" {
      if let Some(ref) = core@1/map.get(p.refs, label) {
        dest = unique ref.destination
        title = unique ref.title
        dest_origin = ref.destination_origin
        title_extent = ref.title_origin
        matched = true
        ip.at = if end > after {
          end
        } else {
          after
        }
      }
    }
  }
  if !matched {
    ip.at = after
    // cmark-gfm src/inlines.c:1238-1307: only after ordinary link matching
    // fails, restore the raw label and remove parsed emphasis/link children.
    if p.options.footnotes && !bracket.image && byte(ip.source, bracket.index + 1) == 94 && after > bracket.index + 3 {
      let label = piece(ip.source, bracket.index + 2, after - 1)
      while ip.top != bracket.delimiter && ip.top != 0 {
        let top = ip.top
        remove_delimiter(mut ip, top)
      }
      let mut child = p.nodes[bracket.node].next
      while child != 0 {
        let next = p.nodes[child].next
        unlink(mut p, child)
        child = next
      }
      if budget.mode == 2 {
        p.sources[bracket.node].row.primary = mapped_origin(
          ip.runs,
          bracket.index,
          after
        )
      }
      p.nodes[bracket.node].kind = 23
      p.nodes[bracket.node].value = label
      return Ok(())
    }
    let text_id_2 = text_node(mut budget, mut p, parent, "]", 9)?
    if budget.mode == 2 {
      inline_source(mut budget, mut p, text_id_2, ip.runs, after - 1, after, false)?
    }
    return Ok(())
  }
  let id = new_child(
    mut budget,
    mut p,
    parent,
    if bracket.image {
      17
    } else {
      16
    }
  )?
  if budget.mode == 2 {
    admit(mut budget, 1)?
    p.sources[id].row.primary = hull(
      p.sources[bracket.node].row.primary,
      mapped_origin(ip.runs, after - 1, ip.at)
    )
    p.sources[id].row.destination = dest_origin
    p.sources[id].row.title = title_extent
  }
  p.nodes[id].info = dest
  p.nodes[id].title = title
  let mut current = p.nodes[bracket.node].next
  while current != 0 && current != id {
    let next = p.nodes[current].next
    move_child(mut p, current, id)
    current = next
  }
  process_emphasis(mut budget, mut p, mut ip, bracket.delimiter)?
  unlink(mut p, bracket.node)
  if !bracket.image {
    let mut i: u64 = 0
    while i < core@1/list.len(ip.brackets) {
      if !ip.brackets[i].image {
        ip.brackets[i].active = false
      }
      i += 1
    }
  }
  Ok(())
}

fn parse_inlines(mut budget: ParseState, mut p: Parser, parent: u64) -> Result[
  (),
  ParseLimit
] uses {} {
  let source = trim(p.nodes[parent].value)
  let runs = if budget.mode == 2 {
    let (source_start, source_end) = trim_bounds(p.nodes[parent].value)
    slice_runs(mut budget, p.sources[parent].runs, source_start, source_end, 0)?
  } else {
    []
  }
  if budget.mode == 2 && (p.nodes[parent].kind == 1 || p.nodes[parent].kind == 21 && size(
    source
  ) != 0) {
    p.sources[parent].row.primary = mapped_origin(runs, 0, size(source))
  }
  let markers = if p.options.strikethrough {
    b"\n`\\*_[]!<&~"
  } else {
    b"\n`\\*_[]!<&"
  }
  // A literal run needs neither a delimiter stack nor bracket bookkeeping.
  if !p.options.autolinks && core@1/bytes.find_any(
    core@1/string.as_bytes(source),
    markers,
    0
  ) == size(source) {
    if size(source) != 0 {
      let literal = unique source
      let text_id_3 = text_node(mut budget, mut p, parent, literal, 9)?
      if budget.mode == 2 {
        inline_source(mut budget, mut p, text_id_3, runs, 0, size(source), false)?
      }
    }
    if budget.mode == 2 {
      p.sources[parent].runs = []
    }
    p.nodes[parent].value = ""
    return Ok(())
  }
  if budget.mode != 0 {
    admit(mut budget, 1)?
  }
  let sentinel = Delimiter(
    node: 0,
    marker: 0,
    count: 0,
    original: 0,
    opens: false,
    closes: false,
    prev: 0,
    next: 0
  )
  let mut ip: unique InlineParser = unique InlineParser(
    runs: runs,
    source: source,
    at: 0,
    delimiters: [sentinel],
    top: 0,
    brackets: []
  )
  while ip.at < size(ip.source) {
    let start = ip.at
    let c = byte(ip.source, start)
    if p.options.autolinks && core@1/list.len(ip.brackets) == 0 {
      if let Some((dest, end)) = extended_autolink(ip.source, start) {
        let link = new_child(mut budget, mut p, parent, 16)?
        p.nodes[link].info = dest
        if budget.mode == 2 {
          admit(mut budget, 1)?
          p.sources[link].row.primary = mapped_origin(ip.runs, start, end)
          p.sources[link].row.destination = mapped_origin(ip.runs, start, end)
        }
        let text_id_4 = text_node(
          mut budget,
          mut p,
          link,
          unescape(piece(ip.source, start, end), false),
          9
        )?
        if budget.mode == 2 {
          inline_source(mut budget, mut p, text_id_4, ip.runs, start, end, true)?
        }
        ip.at = end
        continue
      }
    }
    if c == 96 {
      let n = run(ip.source, start, c)
      ip.at += n
      let mut end = ip.at
      let mut found = false
      while end < size(ip.source) {
        if byte(ip.source, end) == 96 {
          let m = run(ip.source, end, 96)
          if m == n {
            found = true
            break
          }
          end += m
        } else {
          end += 1
        }
      }
      if found {
        let mut value = string.replace(piece(ip.source, ip.at, end), "\n", " ")
        if size(value) >= 2 && byte(value, 0) == 32 && byte(value, size(value) - 1) == 32 && run(
          value,
          0,
          32
        ) < size(value) {
          value = piece(value, 1, size(value) - 1)
        }
        let text_id_5 = text_node(mut budget, mut p, parent, value, 12)?
        if budget.mode == 2 {
          inline_source(mut budget, mut p, text_id_5, ip.runs, start, end + n, true)?
        }
        ip.at = end + n
      } else {
        let text_id_6 = text_node(
          mut budget,
          mut p,
          parent,
          piece(ip.source, start, ip.at),
          9
        )?
        if budget.mode == 2 {
