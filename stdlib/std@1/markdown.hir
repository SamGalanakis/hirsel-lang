    if budget.mode == 2 {
      inline_source(mut budget, mut p, text_id_13, ip.runs, start, end, false)?
    }
    ip.at = end
  }
  process_emphasis(mut budget, mut p, mut ip, 0)?
  if budget.mode == 2 {
    p.sources[parent].runs = []
  }
  p.nodes[parent].value = ""
  Ok(())
}

type BuildFrame {
  id: u64,
  next: u64,
  children: List[Node],
}

fn build_node(nodes: List[Entry], mut budget: ParseState) -> Result[
  unique Node,
  ParseLimit
] uses {} {
  if budget.mode != 0 {
    admit_nesting(budget, 1)?
    admit(mut budget, 1)?
  }
  let mut stack: unique List[BuildFrame] = [
    BuildFrame(id: 0, next: nodes[0].first, children: [])
  ]
  while true {
    let len = core@1/list.len(stack)
    let child = stack[len - 1].next
    if child != 0 {
      if budget.mode != 0 && len >= budget.nesting {
        return Error(Nesting())
      }
      if budget.mode != 0 {
        admit(mut budget, 1)?
      }
      stack[len - 1].next = nodes[child].next
      core@1/list.push(
        mut stack,
        BuildFrame(id: child, next: nodes[child].first, children: [])
      )
    } else {
      if budget.mode != 0 {
        admit(mut budget, 1)?
      }
      let Some(frame) = core@1/list.pop(mut stack) else {
        return Error(WorkItems())
      }
      let BuildFrame(id: id, next: _, children: children) = take frame
      let n = nodes[id]
      let payload_kind: Kind = match n.kind {
        0 => Document(),
        1 => Paragraph(),
        2 => Heading(n.number),
        3 => BlockQuote(),
        4 => ListBlock(n.flag, n.number, n.tight),
        5 => Item(n.checked),
        6 => CodeBlock(n.value, n.info),
        7 => HtmlBlock(n.value),
        8 => ThematicBreak(),
        9 => Text(n.value),
        10 => SoftBreak(),
        11 => HardBreak(),
        12 => Code(n.value),
        13 => HtmlInline(n.value),
        14 => Emphasis(),
        15 => Strong(),
        16 => Link(n.info, n.title),
        17 => Image(n.info, n.title),
        18 => Strikethrough(),
        19 => Table(),
        22 => FootnoteDefinition(n.value),
        23 => FootnoteReference(n.value, n.number, n.fence),
        24 => FootnoteBackrefs(n.value, n.number, n.fence),
        20 => TableRow(n.flag),
        _ => TableCell(n.html),
      }
      let owned_kind = unique payload_kind
      let node: unique Node = Node(kind: take owned_kind, children: take children)
      if len == 1 {
        return Ok(take node)
      }
      core@1/list.push(mut stack[len - 2].children, take node)
    }
  }
  Error(WorkItems())
}

// CommonMark preprocessing and line splitting share one byte scan. Delimiters
// are ASCII, so every emitted slice starts and ends at a UTF-8 boundary.
fn normalized_line(source: String, begin: u64, end: u64, take prefix: unique List[u8]) -> String uses {} {
  if core@1/list.len(prefix) == 0 {
    piece(source, begin, end)
  } else {
    let mut out = take prefix
    text.append(mut out, piece(source, begin, end))
    text.finish_valid(take out)
  }
}

fn normalized_lines(mut budget: ParseState, source: String) -> Result[
  List[String],
  ParseLimit
] uses {} {
  let data = core@1/string.as_bytes(source)
  let len = core@1/bytes.len(data)
  let mut lines: List[String] = []
  // LF-only input needs no replacement buffer or CRLF state.
  if core@1/bytes.find_any(data, b"\x00\r", 0) == len {
    let mut begin = 0u64
    while begin < len {
      let end = core@1/bytes.find_any(data, b"\n", begin)
      if budget.mode != 0 {
        admit(mut budget, 1)?
      }
      core@1/list.push(mut lines, piece(source, begin, end))
      if end == len {
        return Ok(take lines)
      }
      begin = end + 1
    }
    return Ok(take lines)
  }
  let mut prefix: List[u8] = []
  let mut begin = 0u64
  let mut at = 0u64
  while at < len {
    let end = core@1/bytes.find_any(data, b"\x00\r\n", at)
    if end == len {
      break
    }
    let c = data[end]
    if c == 0 {
      if budget.mode != 0 {
        admit(mut budget, 2)?
      }
      text.append(mut prefix, piece(source, begin, end))
      text.append(mut prefix, "\u{fffd}")
      begin = end + 1
    } else {
      if budget.mode != 0 {
        admit(mut budget, 1)?
      }
      core@1/list.push(mut lines, normalized_line(source, begin, end, take prefix))
      prefix = []
      begin = end + 1
      if c == 13 && begin < len && data[begin] == 10 {
        begin += 1
      }
    }
    at = begin
  }
  if begin < len || core@1/list.len(prefix) != 0 {
    if budget.mode != 0 {
      admit(mut budget, 1)?
    }
    core@1/list.push(mut lines, normalized_line(source, begin, len, take prefix))
  }
  Ok(take lines)
}

// Select before construction, including the old late indentation fallback.
fn literal_eligible(source: String, options: Options) -> bool uses {} {
  let data = core@1/string.as_bytes(source)
  if options.autolinks || core@1/bytes.find_any(data, b"\\`*_[]!<&#>+~=:|0123456789", 0) != size(
    source
  ) {
    return false
  }
  let mut begin = 0u64
  while begin < size(source) {
    let end = core@1/bytes.find_any(data, b"\r\n", begin)
    if end > begin {
      let first = byte(source, begin)
      let last = byte(source, end - 1)
      if first == 32 || first == 9 || last == 32 || last == 9 {
        return false
      }
      if first == 45 && !(end - begin == 3 && byte(source, begin + 1) == 45 && byte(
        source,
        begin + 2
      ) == 45) {
        return false
      }
    }
    if end == size(source) {
      break
    }
    begin = end + 1
  }
  true
}

// Literal paragraphs and exact thematic/setext separators need no arena links.
// All other syntax uses the general CommonMark passes below. The conservative
// byte preflight also excludes reference definitions and every inline opener.
fn literal_document(mut budget: ParseState, source: String) -> Result[
  unique Node,
  ParseLimit
] uses {} {
  let lines = normalized_lines(mut budget, source)?
  let mut nodes: unique List[Node] = []
  let mut paragraph: unique List[Node] = []
  for line in take lines {
    let len = size(line)
    if len == 0 || line == "---" {
      if core@1/list.len(paragraph) != 0 {
        if budget.mode != 0 {
          admit_nesting(budget, 2)?
        }
        if budget.mode != 0 {
          admit(mut budget, 2)?
        }
        core@1/list.push(
          mut nodes,
          Node(
            kind: if len == 0 {
              Paragraph()
            } else {
              Heading(2)
            },
            children: take paragraph
          )
        )
        paragraph = []
      } else if len != 0 {
        if budget.mode != 0 {
          admit_nesting(budget, 2)?
        }
        if budget.mode != 0 {
          admit(mut budget, 2)?
        }
        core@1/list.push(mut nodes, Node(kind: ThematicBreak(), children: []))
      }
    } else {
      if core@1/list.len(paragraph) != 0 {
        if budget.mode != 0 {
          admit_nesting(budget, 3)?
        }
        if budget.mode != 0 {
          admit(mut budget, 2)?
        }
        core@1/list.push(mut paragraph, Node(kind: SoftBreak(), children: []))
      }
      if budget.mode != 0 {
        admit_nesting(budget, 3)?
      }
      if budget.mode != 0 {
        admit(mut budget, 2)?
      }
      core@1/list.push(mut paragraph, Node(kind: Text(unique line), children: []))
    }
  }
  if core@1/list.len(paragraph) != 0 {
    if budget.mode != 0 {
      admit_nesting(budget, 2)?
    }
    if budget.mode != 0 {
      admit(mut budget, 2)?
    }
    core@1/list.push(mut nodes, Node(kind: Paragraph(), children: take paragraph))
  }
  Ok(Node(kind: Document(), children: take nodes))
}

/// Parse every String, including incomplete Markdown. NUL becomes U+FFFD;
/// CRLF and bare CR become LF, as required by CommonMark preprocessing.
pub fn parse(take source: String, options: Options) -> Node uses {} {
  parse_owned(take source, options)
}

/// Construct a deeply unique tree, independent of the consumed source and
/// temporary parser records. Payload construction still allocates and copies.
/// Borrow for validation, then move or freeze the completed tree without copying.
pub fn parse_owned(take source: String, options: Options) -> unique Node uses {} {
  let mut budget = ParseState(mode: 0, work: 0, nesting: 0)
  let parsed = parse_shared(take source, options, mut budget)
  match take parsed {
    Ok(node) => take node,
    Error(_) => {
      // Resource refusal is impossible with the unrestricted state.
      core@1/failure.check(false, TextInvariant())
      Node(kind: Document(), children: [])
    },
  }
}

/// Refuse before exhausting an original-byte, work-record or nesting allowance.
pub fn parse_bounded(take source: String, options: Options, budget: ParseBudget) -> Result[
  Node,
  ParseLimit
] uses {} {
  match parse_bounded_owned(take source, options, budget) {
    Ok(tree) => Ok(take tree),
    Error(limit) => Error(limit),
  }
}

/// The same admission points and refusals as parse_bounded, with a deeply unique
/// successful tree. This removes a consumer's completed-tree ownership copy.
pub fn parse_bounded_owned(take source: String, options: Options, budget: ParseBudget) -> Result[
  unique Node,
  ParseLimit
] uses {} {
  if size(source) > budget.source_bytes {
    return Error(SourceBytes())
  }
  let mut state = ParseState(mode: 1, work: budget.work_items, nesting: budget.nesting)
  parse_shared(take source, options, mut state)
}

fn parse_shared(take source: String, options: Options, mut budget: ParseState) -> Result[
  unique Node,
  ParseLimit
] uses {} {
  if budget.mode != 0 {
    admit_nesting(budget, 1)?
  }
  // Root construction frame + output Node on the literal path.
  if literal_eligible(source, options) {
    if budget.mode != 0 {
      admit(mut budget, 2)?
    }
    return literal_document(mut budget, source)
  }
  let p = parse_arena(take source, options, [], mut budget)?
  build_node(p.nodes, mut budget)
}

fn parse_arena(
  take source: String,
  options: Options,
  take maps: List[LineMap],
  mut budget: ParseState
) -> Result[Parser, ParseLimit] uses {} {
  if budget.mode != 0 {
    admit(mut budget, 1)?
  }
  let mut sources: List[EntrySource] = []
  if budget.mode == 2 {
    admit(mut budget, 2)?
    core@1/list.push(mut sources, empty_source())
  }
  let mut p = Parser(
    sources: take sources,
    maps: take maps,
    nodes: [entry(0)],
    tip: 0,
    line: "",
    offset: 0,
    column: 0,
    nonspace: 0,
    nonspace_column: 0,
    indent: 0,
    blank: false,
    partial: false,
    matched: 0,
    oldtip: 0,
    closed: true,
    line_number: 0,
    refs: core@1/map.empty(),
    options: options
  )
  for line in normalized_lines(mut budget, source)? {
    incorporate(mut budget, mut p, unique line)?
  }
  while p.tip != 0 {
    let close_id = p.tip
    let close_line = p.line_number
    finish_at(mut budget, close_id, close_line, mut p)?
  }
  let count = core@1/list.len(p.nodes)
  let mut empty_id: u64 = 1
  while empty_id < count {
    if p.nodes[empty_id].kind == 1 && p.nodes[empty_id].value == "" {
      unlink(mut p, empty_id)
    }
    empty_id += 1
  }
  let mut id: u64 = 1
  while id < count {
    if p.nodes[id].kind == 1 || p.nodes[id].kind == 2 || p.nodes[id].kind == 21 {
      if options.task_lists && p.nodes[id].kind == 1 {
        let parent = p.nodes[id].parent
        let value = unique p.nodes[id].value
        if p.nodes[parent].kind == 5 && p.nodes[parent].first == id && byte(value, 0) == 91 && (space(
          byte(value, 1)
        ) || byte(value, 1) == 120 || byte(value, 1) == 88) && byte(value, 2) == 93 && whitespace(
          byte(value, 3)
        ) {
          if budget.mode == 2 {
            admit(mut budget, 1)?
            p.sources[parent].row.task = mapped_origin(p.sources[id].runs, 0, 3)
            let (a, b) = trim_bounds(piece(value, 3, size(value)))
            content_slice(mut budget, mut p, id, a + 3, b + 3)?
          }
          let checked = byte(value, 1) == 120 || byte(value, 1) == 88
          let rest = copy trim(piece(value, 3, size(value)))
          p.nodes[parent].checked = Some(checked)
          p.nodes[id].value = rest
        }
      }
      parse_inlines(mut budget, mut p, id)?
    }
    id += 1
  }
  if options.autolinks {
    autolink_emails(mut budget, mut p)?
  }
  if options.footnotes {
    process_footnotes(mut budget, mut p)?
  }
  Ok(take p)
}

fn table_cells(mut budget: ParseState, s: String) -> Result[List[String], ParseLimit] uses {} {
  let source = trim(s)
  let mut out: List[String] = []
  // cmark-gfm extensions/table.c:213-219: a lone leading pipe has no cell.
  if source == "|" {
    return Ok(take out)
  }
  admit(mut budget, 1)?
  let mut cell: List[u8] = []
  let mut i: u64 = if byte(source, 0) == 124 {
    1
  } else {
    0
  }
  while i < size(source) {
    if byte(source, i) == 92 && byte(source, i + 1) == 124 {
      core@1/list.push(mut cell, 124u8)
      i += 2
    } else if byte(source, i) == 124 {
      core@1/list.push(mut out, trim(text.finish_valid(take cell)))
      i += 1
      if i == size(source) {
        return Ok(take out)
      }
      admit(mut budget, 1)?
      cell = []
    } else {
      core@1/list.push(mut cell, byte(source, i))
      i += 1
    }
  }
  core@1/list.push(mut out, trim(text.finish_valid(take cell)))
  Ok(take out)
}

fn table_alignments(mut budget: ParseState, s: String) -> Result[
  Option[String],
  ParseLimit
] uses {} {
  let cells = table_cells(mut budget, s)?
  if core@1/list.len(cells) == 0 {
    return Ok(None())
  }
  let mut out: List[u8] = []
  for cell in cells {
    // cmark-gfm extensions/ext_scanners.re:30-35: delimiter spaces
    // include vertical tab/form feed, while ordinary cell trimming does not.
    let mut i: u64 = 0
    while whitespace(byte(cell, i)) {
      i += 1
    }
    let left = byte(cell, 0) == 58
    let right = size(cell) > 1 && byte(cell, size(cell) - 1) == 58
    if byte(cell, i) == 58 {
      i += 1
    }
    let begin = i
    while byte(cell, i) == 45 {
      i += 1
    }
    if i == begin {
      return Ok(None())
    }
    if byte(cell, i) == 58 {
      i += 1
    }
    while whitespace(byte(cell, i)) {
      i += 1
    }
    if i != size(cell) {
      return Ok(None())
    }
    admit(mut budget, 1)?
    core@1/list.push(
      mut out,
      if left && right {
        50u8
      } else if left {
        49u8
      } else if right {
        51u8
      } else {
        48u8
      }
    )
  }
  Ok(Some(text.finish_valid(take out)))
}

fn add_table_row(
  mut budget: ParseState,
  table: u64,
  source: String,
  header: bool,
  runs: List[OriginRun],
  mut p: Parser
) -> Result[(), ParseLimit] uses {} {
  let cells = table_cells(mut budget, source)?
  let locations = if budget.mode == 2 {
    cell_sources(mut budget, source, runs)?
  } else {
    []
  }
  let (a, b) = trim_bounds(source)
  let extent = if budget.mode == 2 {
    mapped_origin(runs, a, b)
  } else {
    absent_span(1)
  }
  let row = new_child(mut budget, mut p, table, 20)?
  p.nodes[row].flag = header
  if budget.mode == 2 {
    p.sources[row].row.primary = extent
  }
  let columns = size(p.nodes[table].info)
  let mut i: u64 = 0
  while i < columns {
    let id = new_child(mut budget, mut p, row, 21)?
    if budget.mode == 2 {
      if i < core@1/list.len(locations) {
        p.sources[id].row.primary = locations[i].extent
        admit(mut budget, core@1/list.len(locations[i].runs))?
        p.sources[id].runs = unique locations[i].runs
      } else {
        p.sources[id].row.primary = synthetic_span(5, extent)
      }
    }
    p.nodes[id].html = byte(p.nodes[table].info, i) - 48u8
    p.nodes[id].value = if i < core@1/list.len(cells) {
      unique cells[i]
    } else {
      ""
    }
    i += 1
  }
  Ok(())
}

fn start_table(mut budget: ParseState, mut p: Parser, container: u64) -> Result[
  bool,
  ParseLimit
] uses {} {
  if !p.options.tables || p.nodes[container].kind != 1 || p.indent >= 4 {
    return Ok(false)
  }
  let delimiter = piece(p.line, p.nonspace, size(p.line))
  let Some(align) = table_alignments(mut budget, delimiter)? else {
    return Ok(false)
  }
  let lines = normalized_lines(mut budget, p.nodes[container].value)?
  let len = core@1/list.len(lines)
  if len == 0 {
    return Ok(false)
  }
  let header = unique lines[len - 1]
  let header_start = size(p.nodes[container].value) - size(header) - 1
  let header_runs = if budget.mode == 2 {
    slice_runs(
      mut budget,
      p.sources[container].runs,
      header_start,
      header_start + size(header),
      0
    )?
  } else {
    []
  }
  // Setext headings precede tables; a single aligned column needs no pipe.
  // cmark-gfm extensions/ext_scanners.re:40-49 and src/blocks.c setext pass.
  let hyphens = run(delimiter, 0, 45)
  if hyphens > 0 && size(trim(piece(delimiter, hyphens, size(delimiter)))) == 0 {
    return Ok(false)
  }
  if core@1/list.len(table_cells(mut budget, header)?) != size(align) {
    return Ok(false)
  }
  close_unmatched(mut budget, mut p)?
  let mut table = container
  if len > 1 {
    let mut previous: List[u8] = []
    let mut i: u64 = 0
    while i + 1 < len {
      text.append(mut previous, lines[i])
      core@1/list.push(mut previous, 10u8)
      i += 1
    }
    content_slice(mut budget, mut p, container, 0, header_start)?
    p.nodes[container].value = text.finish_valid(take previous)
    let close_id = container
    let close_line = p.line_number - 2
    finish_at(mut budget, close_id, close_line, mut p)?
    table = add_block(mut budget, mut p, 19)?
  } else {
    p.nodes[container].kind = 19
    p.nodes[container].value = ""
  }
  if budget.mode == 2 {
    let (a, b) = trim_bounds(header)
    let (_, delimiter_end) = trim_bounds(p.line)
    p.sources[table].row.primary = hull(
      mapped_origin(header_runs, a, b),
      mapped_origin(p.maps[p.line_number - 1].runs, p.nonspace, delimiter_end)
    )
    p.sources[table].runs = []
  }
  p.nodes[table].info = align
  add_table_row(mut budget, table, header, true, header_runs, mut p)?
  p.offset = size(p.line)
  Ok(true)
}

// cmark-gfm extensions/autolink.c: domain check and trailing delimiter trim.
fn extended_autolink(s: String, at: u64) -> Option[(String, u64)] uses {} {
  let boundary = at == 0 || whitespace(byte(s, at - 1)) || byte(s, at - 1) == 42 || byte(
    s,
    at - 1
  ) == 95 || byte(s, at - 1) == 126 || byte(s, at - 1) == 40
  let www = starts(s, at, "www.")
  let scheme: u64 = if starts(s, at, "https://") {
    8
  } else if starts(s, at, "http://") {
    7
  } else if starts(s, at, "ftp://") {
    6
  } else {
    0
  }
  if boundary && (www || scheme != 0) {
    let mut host_end = at + scheme
    let mut dots: u64 = 0
    let mut last_dot = host_end
    let mut previous_dot = host_end
    let mut underscore: u64 = 0
    while host_end < size(s) {
      let c = byte(s, host_end)
      if !ascii.is_alnum(c) && c != 45 && c != 95 && c != 46 {
        break
      }
      if c == 46 {
        dots += 1
        previous_dot = last_dot
        last_dot = host_end
      }
      if c == 95 {
        underscore = host_end
      }
      host_end += 1
    }
    if host_end > at + scheme && dots > 0 && (underscore == 0 || underscore < previous_dot) {
      let mut end = host_end
      while end < size(s) && !whitespace(byte(s, end)) && byte(s, end) != 60 {
        end += 1
      }
      let mut opens: u64 = 0
      let mut closes: u64 = 0
      let mut i = at
      while i < end {
        if byte(s, i) == 40 {
          opens += 1
        }
        if byte(s, i) == 41 {
          closes += 1
        }
        i += 1
      }
      while end > at {
        let c = byte(s, end - 1)
        if member("?!.,:*_~", byte(s, end - 1)) {
          end -= 1
        } else if c == 41 && closes > opens {
          end -= 1
          closes -= 1
        } else if c == 59 {
          let mut amp = end - 1
          while amp > at && ascii.is_alnum(byte(s, amp - 1)) {
            amp -= 1
          }
          if amp > at && byte(s, amp - 1) == 38 {
            end = amp - 1
          } else {
            break
          }
        } else {
          break
        }
      }
      if end > at {
        let value = unescape(piece(s, at, end), false)
        return Some(
          (
            normalize_uri(
              if www {
                string.concat("http://", value)
              } else {
                value
              }
            ),
            end
          )
        )
      }
    }
  }
  None()
}

// Emails are recognized in consolidated text after brackets and emphasis resolve.
fn extended_email(s: String, at: u64) -> Option[(String, u64)] uses {} {
  // Email locals and domains have different permitted alphabets.
  if at > 0 && (ascii.is_alnum(byte(s, at - 1)) || byte(s, at - 1) == 46 || byte(
    s,
    at - 1
  ) == 95 || byte(s, at - 1) == 45 || byte(s, at - 1) == 43) {
    return None()
  }
  let mut i = at
  while i < size(s) && (ascii.is_alnum(byte(s, i)) || byte(s, i) == 46 || byte(s, i) == 95 || byte(
    s,
    i
  ) == 45 || byte(s, i) == 43) {
    i += 1
  }
  if i == at || byte(s, i) != 64 {
    return None()
  }
  i += 1
  let domain = i
  let mut dots: u64 = 0
  while i < size(s) && (ascii.is_alnum(byte(s, i)) || byte(s, i) == 46 || byte(s, i) == 95 || byte(
    s,
    i
  ) == 45) {
    if byte(s, i) == 46 {
      dots += 1
    }
    i += 1
  }
  while i > domain && byte(s, i - 1) == 46 {
    i -= 1
  }
  if i == domain || dots == 0 || byte(s, i - 1) == 95 || byte(s, i - 1) == 45 {
    return None()
  }
  Some((normalize_uri(string.concat("mailto:", piece(s, at, i))), i))
}

// cmark-gfm's autolink postprocess: consolidate text, then skip link subtrees.
fn sibling_after(mut budget: ParseState, mut p: Parser, previous: u64, tag: u8) -> Result[
  u64,
  ParseLimit
] uses {} {
  let parent = p.nodes[previous].parent
  let next = p.nodes[previous].next
  let id = new_child(mut budget, mut p, parent, tag)?
  unlink(mut p, id)
  p.nodes[id].prev = previous
  p.nodes[id].next = next
  p.nodes[previous].next = id
  if next != 0 {
    p.nodes[next].prev = id
  } else {
    p.nodes[parent].last = id
  }
  Ok(id)
}

fn autolink_emails(mut budget: ParseState, mut p: Parser) -> Result[(), ParseLimit] uses {} {
  let count = core@1/list.len(p.nodes)
  let mut id: u64 = 1
  while id < count {
    if p.nodes[id].kind != 9 || p.nodes[id].value == "" {
      id += 1
      continue
    }
    let mut ancestor = p.nodes[id].parent
    let mut in_link = false
    while ancestor != 0 {
      if p.nodes[ancestor].kind == 16 {
        in_link = true
        break
      }
      ancestor = p.nodes[ancestor].parent
    }
    if in_link {
      id += 1
      continue
    }
    let mut value = unique p.nodes[id].value
    let mut next = p.nodes[id].next
    while next != 0 && p.nodes[next].kind == 9 {
      if budget.mode == 2 {
        let copied = slice_runs(
          mut budget,
          p.sources[next].runs,
          0,
          size(p.nodes[next].value),
          size(value)
        )?
        for segment in take copied {
          core@1/list.push(mut p.sources[id].runs, take segment)
        }
        p.sources[id].row.primary = hull(
          p.sources[id].row.primary,
          p.sources[next].row.primary
        )
        p.sources[next].runs = []
      }
      value = string.concat(value, p.nodes[next].value)
      let following = p.nodes[next].next
      p.nodes[next].value = ""
      unlink(mut p, next)
      next = following
    }
    p.nodes[id].value = piece(value, 0, size(value))
    let mapping = if budget.mode == 2 {
      admit(mut budget, core@1/list.len(p.sources[id].runs))?
      unique p.sources[id].runs
    } else {
      []
    }
    let mut current = id
    let mut begin: u64 = 0
    let mut at: u64 = 0
    while at < size(value) {
      if let Some((dest, end)) = extended_email(value, at) {
        let prefix = piece(value, begin, at)
        p.nodes[current].value = prefix
        let link = sibling_after(mut budget, mut p, current, 16)?
        p.nodes[link].info = dest
        let label = text_node(mut budget, mut p, link, piece(value, at, end), 9)?
        if budget.mode == 2 {
          inline_source(mut budget, mut p, label, mapping, at, end, false)?
        }
        if budget.mode == 2 {
          admit(mut budget, 1)?
          let extent = mapped_origin(mapping, at, end)
          p.sources[link].row.primary = extent
          p.sources[link].row.destination = extent
          p.sources[current].runs = []
          inline_source(mut budget, mut p, current, mapping, begin, at, false)?
          if at == begin {
            p.sources[current].row.primary = synthetic_span(8, extent)
          }
        }
        let _ = label
        let post = sibling_after(mut budget, mut p, link, 9)?
        p.nodes[post].value = piece(value, end, size(value))
        inline_source(mut budget, mut p, post, mapping, end, size(value), false)?
        if budget.mode == 2 && end == size(value) {
          p.sources[post].row.primary = synthetic_span(8, p.sources[link].row.primary)
        }
        current = post
        begin = end
        at = end
      } else {
        at += 1
      }
    }
    id += 1
  }
  Ok(())
}
