// Decimal conversion is ordinary source; no numeric schema or hidden allocator.
@noalloc
pub fn format[n: size](value: i8, mut buffer: Inline[u8, n]) -> Result[
  u64,
  scalar.FormatError
] uses {} {
  let wide: i128 = core@1/int.widen(value)
  let raw: u128 = core@1/int.truncate(wide)
  let magnitude = if value < 0 {
    core@1/int.wrapping_add(~raw, 1)
  } else {
    raw
  }
  internal.decimal.write_unsigned(magnitude, value < 0, mut buffer)
}

// Appends the decimal text of `value` to `out`; to_string is that text,
// built from the same digits in a list reserved to its exact length.
pub fn format_into(value: i8, mut out: List[u8]) -> () uses {} {
  let wide: i128 = core@1/int.widen(value)
  let raw: u128 = core@1/int.truncate(wide)
  let magnitude = if value < 0 {
    core@1/int.wrapping_add(~raw, 1)
  } else {
    raw
  }
  internal.decimal.append(mut out, magnitude, value < 0)
}

pub fn to_string(value: i8) -> String uses {} {
  let mut out: List[u8] = []
  i8.format_into(value, mut out)
  internal.decimal.finish(take out)
}

@noalloc
pub fn parse(text: String) -> Result[i8, scalar.ParseError] uses {} {
  parse_radix(text, 10)
}
