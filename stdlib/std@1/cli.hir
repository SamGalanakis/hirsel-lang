// Go flag.FlagSet.parseOne token handling, with immutable explicit specs.
@serializable
pub type Kind = Switch | Value

@serializable
pub type Flag {
  name: String,
  short: Option[u8],
  kind: Kind,
  help: String,
}

@serializable
pub type Parsed {
  flags: Map[String, List[String]],
  positional: List[String],
}

@serializable
pub type ParseError = UnknownFlag(u64) | MissingValue(u64) | UnexpectedValue(u64) | InvalidSpec

@noalloc
fn valid_name(name: String) -> bool uses {} {
  let data = core@1/string.as_bytes(name)
  if core@1/bytes.len(data) == 0 || data[0] == b'-' {
    return false
  }
  let mut i: u64 = 0
  while i < core@1/bytes.len(data) {
    if data[i] <= b' ' || data[i] == b'=' || data[i] == 127 {
      return false
    }
    i += 1
  }
  true
}

@noalloc
fn valid_specs(specs: List[Flag]) -> bool uses {} {
  let mut i: u64 = 0
  while i < core@1/list.len(specs) {
    if !valid_name(specs[i].name) {
      return false
    }
    if let Some(short) = specs[i].short {
      if short <= b' ' || short >= 127 || short == b'-' || short == b'=' {
        return false
      }
    }
    let mut j: u64 = 0
    while j < i {
      if specs[i].name == specs[j].name {
        return false
      }
      if let Some(short) = specs[i].short {
        if specs[j].short == Some(short) {
          return false
        }
      }
      j += 1
    }
    i += 1
  }
  true
}

pub fn parse(take args: List[String], specs: List[Flag]) -> Result[Parsed, ParseError] uses {} {
  if !valid_specs(specs) {
    return Error(InvalidSpec())
  }
  let mut flags: Map[String, List[String]] = core@1/map.empty()
  let mut positional: List[String] = []
  let mut index: u64 = 0
  let mut options = true
  while index < core@1/list.len(args) {
    let token = args[index]
    let data = core@1/string.as_bytes(token)
    let len = core@1/bytes.len(data)
    if options && token == "--" {
      options = false
    } else if options && len > 1 && data[0] == b'-' {
      let long = data[1] == b'-'
      let start: u64 = if long {
        2
      } else {
        1
      }
      let mut end = start
      while end < len && data[end] != b'=' {
        end += 1
      }
      let mut selected: Option[u64] = None()
      let mut j: u64 = 0
      while j < core@1/list.len(specs) {
        let matches = if long {
          let name_bytes = core@1/string.as_bytes(specs[j].name)
          let mut same = core@1/bytes.len(name_bytes) == end - start
          let mut k: u64 = 0
          while same && k < end - start {
            if data[start + k] != name_bytes[k] {
              same = false
            }
            k += 1
          }
          same
        } else {
          end - start == 1 && specs[j].short == Some(data[start])
        }
        if matches {
          selected = Some(j)
        }
        j += 1
      }
      let Some(which) = selected else {
        return Error(UnknownFlag(index))
      }
      let spec = specs[which]
      let mut value = ""
      if spec.kind == Switch() {
        if end != len {
          return Error(UnexpectedValue(index))
        }
      } else if end != len {
        let mut builder: List[u8] = []
        let mut k = end + 1
        while k < len {
          core@1/list.push(mut builder, data[k])
          k += 1
        }
        value = match text.finish(take builder) {
          Ok(s) => take s,
          Error(_) => {
            core@1/failure.check(false, TextInvariant())
            ""
          },
        }
      } else {
        if index + 1 == core@1/list.len(args) {
          return Error(MissingValue(index))
        }
        index += 1
        value = copy args[index]
      }
      std@1/map.upsert(
        mut flags,
        spec.name,
        fn() -> unique List[String] uses {} {
          let mut first: List[String] = []
          core@1/list.push(mut first, unique value)
          take first
        },
        fn(mut occurrences: unique List[String]) -> () uses {} {
          core@1/list.push(mut occurrences, unique value)
        }
      )
    } else {
      core@1/list.push(mut positional, copy token)
    }
    index += 1
  }
  Ok(Parsed(flags: take flags, positional: take positional))
}

pub fn usage(program: String, specs: List[Flag]) -> String uses {} {
  core@1/failure.check(valid_specs(specs), TextInvariant())
  let mut out: List[u8] = []
  text.append(mut out, "Usage: ")
  text.append(mut out, program)
  text.append(mut out, " [options] [--] [arguments]\n")
  let mut i: u64 = 0
  while i < core@1/list.len(specs) {
    text.append(mut out, "  ")
    if let Some(short) = specs[i].short {
      text.append(mut out, "-")
      core@1/list.push(mut out, short)
      text.append(mut out, ", ")
    }
    text.append(mut out, "--")
    text.append(mut out, specs[i].name)
    if specs[i].kind == Value() {
      text.append(mut out, " <value>")
    }
    text.append(mut out, "\t")
    text.append(mut out, specs[i].help)
    text.append(mut out, "\n")
    i += 1
  }
  match text.finish(take out) {
    Ok(s) => take s,
    Error(_) => {
      core@1/failure.check(false, TextInvariant())
      ""
    },
  }
}
