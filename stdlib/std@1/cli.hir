// Go src/flag/flag.go:1096-1187 FlagSet.parseOne, ebe2feef (BSD-3-Clause).
// Both dash spellings name a flag; parse stops at the first positional or --.
// parse_interspersed keeps scanning positionals until a standalone --.
// Immutable specs, short-name aliases and ordered text values replace mutable
// typed flag storage; scalar conversion is the caller's job.
// See docs/prior-art-web-small.md for every adaptation and imported vector.
@serializable
pub type Kind = Switch | Value

@serializable
pub type Flag {
  name: String,
  short: Option[u8],
  kind: Kind,
  help: String,
}

@serializable
pub type Parsed {
  flags: Map[String, List[String]],
  positional: List[String],
}

@serializable
pub type ParseError = UnknownFlag(u64) | MissingValue(u64) | UnexpectedValue(u64) | InvalidSpec

@noalloc
fn valid_name(name: String) -> bool uses {} {
  let data = core@1/string.as_bytes(name)
  if core@1/bytes.len(data) == 0 || data[0] == b'-' {
    return false
  }
  let mut i: u64 = 0
  while i < core@1/bytes.len(data) {
    if data[i] <= b' ' || data[i] == b'=' || data[i] == 127 {
      return false
    }
    i += 1
  }
  true
}

@noalloc
fn valid_specs(specs: List[Flag]) -> bool uses {} {
  let mut i: u64 = 0
  while i < core@1/list.len(specs) {
    if !valid_name(specs[i].name) {
      return false
    }
    if let Some(short) = specs[i].short {
      if short <= b' ' || short >= 127 || short == b'-' || short == b'=' {
        return false
      }
    }
    let mut j: u64 = 0
    while j < i {
      let i_name = core@1/string.as_bytes(specs[i].name)
      let j_name = core@1/string.as_bytes(specs[j].name)
      if core@1/bytes.len(i_name) == 1 && specs[j].short == Some(i_name[0]) || core@1/bytes.len(
        j_name
      ) == 1 && specs[i].short == Some(j_name[0]) {
        return false
      }
      if specs[i].name == specs[j].name {
        return false
      }
      if let Some(short) = specs[i].short {
        if specs[j].short == Some(short) {
          return false
        }
      }
      j += 1
    }
    i += 1
  }
  true
}

/// Parse flags until the first positional argument or standalone --.
pub fn parse(take args: List[String], specs: List[Flag]) -> Result[Parsed, ParseError] uses {} {
  parse_with_policy(take args, specs, true)
}

/// Parse flags before and after positionals until a standalone --.
pub fn parse_interspersed(take args: List[String], specs: List[Flag]) -> Result[
  Parsed,
  ParseError
] uses {} {
  parse_with_policy(take args, specs, false)
}

// Clap ccc89b83, clap_builder/src/parser/parser.rs:78-170 (MIT): explicit
// trailing-values state. Keep the original argv walk and Hirsel flag grammar;
// only the positional-stop policy differs. See docs/prior-art-web-small.md.
fn parse_with_policy(
  take args: List[String],
  specs: List[Flag],
  stop_at_positional: bool
) -> Result[Parsed, ParseError] uses {} {
  if !valid_specs(specs) {
    return Error(InvalidSpec())
  }
  let mut flags: Map[String, List[String]] = core@1/map.empty()
  let mut positional: List[String] = []
  let mut index: u64 = 0
  let mut options = true
  while index < core@1/list.len(args) {
    let token = args[index]
    let data = core@1/string.as_bytes(token)
    let len = core@1/bytes.len(data)
    if options && token == "--" {
      options = false
    } else if options && len > 1 && data[0] == b'-' {
      let long = data[1] == b'-'
      let start: u64 = if long {
        2
      } else {
        1
      }
      let mut end = start
      while end < len && data[end] != b'=' {
        end += 1
      }
      let mut selected: Option[u64] = None()
      let mut j: u64 = 0
      while j < core@1/list.len(specs) {
        let name_bytes = core@1/string.as_bytes(specs[j].name)
        let mut same = core@1/bytes.len(name_bytes) == end - start
        let mut k: u64 = 0
        while same && k < end - start {
          if data[start + k] != name_bytes[k] {
            same = false
          }
          k += 1
        }
        let matches = same || end - start == 1 && specs[j].short == Some(data[start])
        if matches {
          selected = Some(j)
        }
        j += 1
      }
      let Some(which) = selected else {
        return Error(UnknownFlag(index))
      }
      let spec = specs[which]
      let mut value = ""
      if end != len {
        let mut builder: List[u8] = []
        let mut k = end + 1
        while k < len {
          core@1/list.push(mut builder, data[k])
          k += 1
        }
        value = match text.finish(take builder) {
          Ok(s) => take s,
          Error(_) => {
            core@1/failure.check(false, TextInvariant())
            ""
          },
        }
      } else if spec.kind == Switch() {
        value = "true"
      } else {
        if index + 1 == core@1/list.len(args) {
          return Error(MissingValue(index))
        }
        index += 1
        value = copy args[index]
      }
      if spec.kind == Switch() && !(value == "true" || value == "false" || value == "1" || value == "0" || value == "t" || value == "f" || value == "T" || value == "F" || value == "TRUE" || value == "FALSE" || value == "True" || value == "False") {
        return Error(UnexpectedValue(index))
      }
      std@1/map.upsert(
        mut flags,
        spec.name,
        fn() -> unique List[String] uses {} {
          let mut first: List[String] = []
          core@1/list.push(mut first, unique value)
          take first
        },
        fn(mut occurrences: unique List[String]) -> () uses {} {
          core@1/list.push(mut occurrences, unique value)
        }
      )
    } else {
      if stop_at_positional {
        options = false
      }
      core@1/list.push(mut positional, copy token)
    }
    index += 1
  }
  Ok(Parsed(flags: take flags, positional: take positional))
}

pub fn usage(program: String, specs: List[Flag]) -> String uses {} {
  core@1/failure.check(valid_specs(specs), TextInvariant())
  let mut out: List[u8] = []
  text.append(mut out, "Usage: ")
  text.append(mut out, program)
  text.append(mut out, " [options] [--] [arguments]\n")
  let mut i: u64 = 0
  while i < core@1/list.len(specs) {
    text.append(mut out, "  ")
    if let Some(short) = specs[i].short {
      text.append(mut out, "-")
      core@1/list.push(mut out, short)
      text.append(mut out, ", ")
    }
    text.append(mut out, "--")
    text.append(mut out, specs[i].name)
    if specs[i].kind == Value() {
      text.append(mut out, " <value>")
    }
    text.append(mut out, "\t")
    text.append(mut out, specs[i].help)
    text.append(mut out, "\n")
    i += 1
  }
  match text.finish(take out) {
    Ok(s) => take s,
    Error(_) => {
      core@1/failure.check(false, TextInvariant())
      ""
    },
  }
}

// Go ebe2feef, src/flag/flag.go:1136-1160: unknown / missing / invalid
// value diagnostics. Explicit input and typed errors replace FlagSet state.
// Byte quoting additionally makes arbitrary argument text safe for terminals.
fn quote_argument(token: String, mut out: List[u8]) -> () uses {} {
  let data = core@1/string.as_bytes(token)
  let digits = core@1/string.as_bytes("0123456789abcdef")
  text.append(mut out, "\"")
  let mut i: u64 = 0
  while i < core@1/bytes.len(data) {
    let byte = data[i]
    if byte == b'"' || byte == b'\\' {
      core@1/list.push(mut out, b'\\')
      core@1/list.push(mut out, byte)
    } else if byte < 32 || byte >= 127 {
      text.append(mut out, "\\x")
      core@1/list.push(mut out, digits[core@1/int.widen(byte / 16u8)])
      core@1/list.push(mut out, digits[core@1/int.widen(byte % 16u8)])
    } else {
      core@1/list.push(mut out, byte)
    }
    i += 1
  }
  text.append(mut out, "\"")
}

// Only called after parse has confirmed this exact error for these inputs.
fn error_flag(token: String, specs: List[Flag]) -> Option[u64] uses {} {
  let data = core@1/string.as_bytes(token)
  let len = core@1/bytes.len(data)
  if len < 2 || data[0] != b'-' {
    return None()
  }
  let start: u64 = if data[1] == b'-' {
    2
  } else {
    1
  }
  let mut end = start
  while end < len && data[end] != b'=' {
    end += 1
  }
  let mut j: u64 = 0
  while j < core@1/list.len(specs) {
    let name = core@1/string.as_bytes(specs[j].name)
    let mut same = core@1/bytes.len(name) == end - start
    let mut k: u64 = 0
    while same && k < end - start {
      if data[start + k] != name[k] {
        same = false
      }
      k += 1
    }
    if same || end - start == 1 && specs[j].short == Some(data[start]) {
      return Some(j)
    }
    j += 1
  }
  None()
}

// clap ccc89b83: error/kind.rs:4-35; context.rs:8-15;
// error/mod.rs:434-480,720-747; error/format.rs:207-233,351-365.
// Keep kind separate from InvalidArg, InvalidValue and ValidValue context.
// MissingValue maps to InvalidValue without a supplied value. UnexpectedValue
// carries Some("") for an explicit empty switch value, retaining its typed kind.
// See docs/cli-errors.md for adaptations, source pins and exact vector mapping.
// The existing ParseError is the kind; no second public error taxonomy is needed.
type ErrorContext {
  invalid_arg: String,
  invalid_value: Option[String],
  valid_value: List[String],
}

fn error_context(args: List[String], specs: List[Flag], error: ParseError, index: u64) -> Option[
  ErrorContext
] uses {} {
  // Revalidate positional stopping, consumed values, earlier errors and specs.
  // A borrowed caller-local snapshot needs a deep global copy for parse's take.
  let current = match parse(unique args, specs) {
    Error(actual) => actual == error,
    Ok(_) => false,
  }
  if !current {
    return None()
  }
  if error == UnknownFlag(index) {
    return Some(
      ErrorContext(
        invalid_arg: unique args[index],
        invalid_value: None(),
        valid_value: []
      )
    )
  }
  let Some(which) = error_flag(args[index], specs) else {
    return None()
  }
  let mut name: List[u8] = []
  text.append(mut name, "--")
  text.append(mut name, specs[which].name)
  if error == MissingValue(index) {
    text.append(mut name, " <value>")
    return Some(
      ErrorContext(
        invalid_arg: text.finish_valid(take name),
        invalid_value: None(),
        valid_value: []
      )
    )
  }
  let data = core@1/string.as_bytes(args[index])
  let mut at: u64 = 0
  while at < core@1/bytes.len(data) && data[at] != b'=' {
    at += 1
  }
  let mut value: List[u8] = []
  if at < core@1/bytes.len(data) {
    at += 1
    while at < core@1/bytes.len(data) {
      core@1/list.push(mut value, data[at])
      at += 1
    }
  }
  Some(
    ErrorContext(
      invalid_arg: text.finish_valid(take name),
      invalid_value: Some(text.finish_valid(take value)),
      valid_value: [
        "true",
        "false",
        "1",
        "0",
        "t",
        "f",
        "T",
        "F",
        "TRUE",
        "FALSE",
        "True",
        "False"
      ]
    )
  )
}

fn render_context(error: ParseError, context: ErrorContext, mut out: List[u8]) -> () uses {} {
  match error {
    UnknownFlag(_) => {
      text.append(mut out, "unexpected argument ")
      quote_argument(context.invalid_arg, mut out)
      text.append(mut out, " found")
    },
    _ => {
      if let Some(value) = context.invalid_value {
        text.append(mut out, "invalid value ")
        quote_argument(value, mut out)
        text.append(mut out, " for ")
        quote_argument(context.invalid_arg, mut out)
      } else {
        text.append(mut out, "a value is required for ")
        quote_argument(context.invalid_arg, mut out)
        text.append(mut out, " but none was supplied")
      }
      if core@1/list.len(context.valid_value) > 0 {
        text.append(mut out, " [possible values: ")
        let mut i: u64 = 0
        while i < core@1/list.len(context.valid_value) {
          if i > 0 {
            text.append(mut out, ", ")
          }
          text.append(mut out, context.valid_value[i])
          i += 1
        }
        text.append(mut out, "]")
      }
    },
  }
}

/// Render an error against the original argument snapshot, without I/O or LF.
/// Stale or forged errors get bounded fallback text instead of invented context.
pub fn error_message(args: List[String], specs: List[Flag], error: ParseError) -> unique String uses {} {
  let index = match error {
    UnknownFlag(i) => i,
    MissingValue(i) => i,
    UnexpectedValue(i) => i,
    InvalidSpec() => {
      return "invalid flag specification (names and aliases must be valid and unique)"
    },
  }
  // KindFormatter-style fallback when no rich context can be trusted.
  let reason = match error {
    UnknownFlag(_) => "unexpected argument found",
    MissingValue(_) => "a value is required",
    UnexpectedValue(_) => "invalid value for an argument",
    InvalidSpec() => "invalid flag specification",
  }
  let mut out: List[u8] = []
  text.append(mut out, "argument ")
  std@1/u64.format_into(index, mut out)
  if index >= core@1/list.len(args) {
    text.append(mut out, ": parse error context unavailable (")
    text.append(mut out, reason)
    text.append(mut out, "; index out of range)")
    return text.finish_valid(take out)
  }
  if let Some(context) = error_context(args, specs, error, index) {
    // UnknownArgument already contains the exact token in its rich message.
    if error != UnknownFlag(index) {
      text.append(mut out, " ")
      quote_argument(args[index], mut out)
    }
    text.append(mut out, ": ")
    render_context(error, context, mut out)
  } else {
    text.append(mut out, " ")
    quote_argument(args[index], mut out)
    text.append(mut out, ": parse error context unavailable (")
    text.append(mut out, reason)
    text.append(mut out, ")")
  }
  text.finish_valid(take out)
}
