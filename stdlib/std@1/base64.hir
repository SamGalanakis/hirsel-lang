// Go encoding/base64 @ ebe2feef, base64.go:328-408 decodeQuantum (BSD-3-Clause).
// Quantum scan/padding/error precedence and byte offsets follow Go Strict().
// Deviations: CR/LF rejected (strict RFC4648), typed error kinds, no partial output.
// Complete-buffer success uses the pinned runtime SIMD kernel. Rejected input
// retains this Go parser; streaming retains its source failure-state machine.
pub type Alphabet = core@1/Base64Alphabet

pub type Padding = core@1/Base64Padding

@serializable
pub type DecodeError = InvalidByte(u64) | InvalidLength(u64) | InvalidPadding(u64) | NonCanonical(
  u64
)

fn alphabet_bytes(alphabet: Alphabet) -> Bytes uses {} {
  core@1/string.as_bytes(
    match alphabet {
      Standard() => "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/",
      UrlSafe() => "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_",
    }
  )
}

// Rust base64 5b98ee18 general_purpose/mod.rs:151-268 (MIT), scalar only.
// Reserve and initialize once. Hirsel requires initialized List elements before
// indexed writes; the history primitive fills the reservation with memset.
fn output_buffer(length: u64) -> List[u8] uses {} {
  let mut out: List[u8] = []
  if length != 0 {
    core@1/list.reserve(mut out, length)
    core@1/list.push(mut out, 0u8)
    core@1/bytes.append_from_history(mut out, 1, length - 1)
  }
  take out
}

// aklomp/base64 e4cc438b lib/arch/generic/32/dec_loop.c:4-20:
// shifted sextets and an error bit share each lookup. OR validates a block.
// Unlike the C kernel, store exactly three output bytes (no overstore).
fn decode_words(alphabet: Alphabet) -> List[u32] uses {} {
  let bytes = alphabet_bytes(alphabet)
  let mut table: List[u32] = []
  core@1/list.reserve(mut table, 1024)
  for _ in 0u64..1024 {
    core@1/list.push(mut table, 0x80000000u32)
  }
  let mut i = 0u64
  while i < 64 {
    let byte: u64 = core@1/int.widen(bytes[i])
    let value: u32 = core@1/int.truncate(i)
    table[byte] = value << 18
    table[256 + byte] = value << 12
    table[512 + byte] = value << 6
    table[768 + byte] = value
    i += 1
  }
  take table
}

const DECODE_STANDARD: List[u32] = comptime decode_words(Standard())

const DECODE_URL: List[u32] = comptime decode_words(UrlSafe())

pub fn encode(data: Bytes, alphabet: Alphabet, padding: Padding) -> unique String uses {} {
  let len = core@1/bytes.len(data)
  let remainder = len % 3
  let tail: u64 = if remainder == 0 {
    0
  } else if padding == Required() {
    4
  } else {
    remainder + 1
  }
  core@1/failure.check(len / 3 <= (18446744073709551615u64 - tail) / 4, TextInvariant())
  let encoded = core@1/bytes.base64_encode(data, alphabet, padding)
  match core@1/string.from_bytes(take encoded) {
    Ok(s) => take s,
    Error(_) => {
      core@1/failure.check(false, TextInvariant())
      ""
    },
  }
}

@noalloc
fn sextet(byte: u8, alphabet: Alphabet) -> u32 uses {} {
  let value: u8 = if std@1/ascii.is_upper(byte) {
    byte - b'A'
  } else if std@1/ascii.is_lower(byte) {
    byte - b'a' + 26
  } else if std@1/ascii.is_digit(byte) {
    byte - b'0' + 52
  } else if alphabet == Standard() && byte == b'+' || alphabet == UrlSafe() && byte == b'-' {
    62
  } else if alphabet == Standard() && byte == b'/' || alphabet == UrlSafe() && byte == b'_' {
    63
  } else {
    64
  }
  core@1/int.widen(value)
}

// aklomp/base64 generic shifted lookup blocks, sixteen input bytes to twelve.
// Invalid or padded blocks fall back to Go's existing quantum parser from the
// same input position, retaining its first-error and canonical-bit precedence.
@noalloc
fn decode_into(
  text: String,
  alphabet: Alphabet,
  padding: Padding,
  mut out: unique List[u8]
) -> Result[u64, DecodeError] uses {} {
  let data = core@1/string.as_bytes(text)
  let len = core@1/bytes.len(data)
  let table = match alphabet {
    Standard() => b"\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\x3e\xff\xff\xff\x3f\x34\x35\x36\x37\x38\x39\x3a\x3b\x3c\x3d\xff\xff\xff\xff\xff\xff\xff\x00\x01\x02\x03\x04\x05\x06\x07\x08\x09\x0a\x0b\x0c\x0d\x0e\x0f\x10\x11\x12\x13\x14\x15\x16\x17\x18\x19\xff\xff\xff\xff\xff\xff\x1a\x1b\x1c\x1d\x1e\x1f\x20\x21\x22\x23\x24\x25\x26\x27\x28\x29\x2a\x2b\x2c\x2d\x2e\x2f\x30\x31\x32\x33\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff",
    UrlSafe() => b"\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\x3e\xff\xff\x34\x35\x36\x37\x38\x39\x3a\x3b\x3c\x3d\xff\xff\xff\xff\xff\xff\xff\x00\x01\x02\x03\x04\x05\x06\x07\x08\x09\x0a\x0b\x0c\x0d\x0e\x0f\x10\x11\x12\x13\x14\x15\x16\x17\x18\x19\xff\xff\xff\xff\x3f\xff\x1a\x1b\x1c\x1d\x1e\x1f\x20\x21\x22\x23\x24\x25\x26\x27\x28\x29\x2a\x2b\x2c\x2d\x2e\x2f\x30\x31\x32\x33\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff",
  }
  let mut at: u64 = 0
  let mut i: u64 = 0
  let words = match alphabet {
    Standard() => DECODE_STANDARD,
    UrlSafe() => DECODE_URL,
  }
  // Four quanta share one error test. Retry the untouched block through the
  // existing quantum parser on any padding or invalid byte, preserving offsets.
  while len - i >= 16 {
    let d3_3: u64 = core@1/int.widen(data[i + 15])
    let d3_2: u64 = core@1/int.widen(data[i + 14])
    let d3_1: u64 = core@1/int.widen(data[i + 13])
    let d3_0: u64 = core@1/int.widen(data[i + 12])
    let v3 = words[d3_0] | words[256 + d3_1] | words[512 + d3_2] | words[768 + d3_3]
    let d2_3: u64 = core@1/int.widen(data[i + 11])
    let d2_2: u64 = core@1/int.widen(data[i + 10])
    let d2_1: u64 = core@1/int.widen(data[i + 9])
    let d2_0: u64 = core@1/int.widen(data[i + 8])
    let v2 = words[d2_0] | words[256 + d2_1] | words[512 + d2_2] | words[768 + d2_3]
    let d1_3: u64 = core@1/int.widen(data[i + 7])
    let d1_2: u64 = core@1/int.widen(data[i + 6])
    let d1_1: u64 = core@1/int.widen(data[i + 5])
    let d1_0: u64 = core@1/int.widen(data[i + 4])
    let v1 = words[d1_0] | words[256 + d1_1] | words[512 + d1_2] | words[768 + d1_3]
    let d0_3: u64 = core@1/int.widen(data[i + 3])
    let d0_2: u64 = core@1/int.widen(data[i + 2])
    let d0_1: u64 = core@1/int.widen(data[i + 1])
    let d0_0: u64 = core@1/int.widen(data[i + 0])
    let v0 = words[d0_0] | words[256 + d0_1] | words[512 + d0_2] | words[768 + d0_3]
    if (v0 | v1 | v2 | v3) & 0x80000000u32 != 0 {
      break
    }
    out[at + 11] = core@1/int.truncate(v3 >> 0)
    out[at + 10] = core@1/int.truncate(v3 >> 8)
    out[at + 9] = core@1/int.truncate(v3 >> 16)
    out[at + 8] = core@1/int.truncate(v2 >> 0)
    out[at + 7] = core@1/int.truncate(v2 >> 8)
    out[at + 6] = core@1/int.truncate(v2 >> 16)
    out[at + 5] = core@1/int.truncate(v1 >> 0)
    out[at + 4] = core@1/int.truncate(v1 >> 8)
    out[at + 3] = core@1/int.truncate(v1 >> 16)
    out[at + 2] = core@1/int.truncate(v0 >> 0)
    out[at + 1] = core@1/int.truncate(v0 >> 8)
    out[at + 0] = core@1/int.truncate(v0 >> 16)
    i += 16
    at += 12
  }
  while i < len {
    let start = i
    let mut count: u64 = 0
    let mut value: u32 = 0
    let mut padded = false
    let mut trailing: Option[u64] = None()
    while count < 4 {
      if i == len {
        if count == 1 || padding == Required() {
          return Error(InvalidLength(start))
        }
        break
      }
      let byte = data[i]
      i += 1
      let digit: u32 = core@1/int.widen(table[core@1/int.widen(byte)])
      if digit != 255 {
        value = value * 64u32 + digit
        count += 1
        continue
      }
      if byte != b'=' {
        return Error(InvalidByte(i - 1))
      }
      if padding == Omitted() || count < 2 {
        return Error(InvalidPadding(i - 1))
      }
      if count == 2 {
        if i == len {
          return Error(InvalidPadding(len))
        }
        if data[i] != b'=' {
          return Error(InvalidPadding(i - 1))
        }
        i += 1
      }
      padded = true
      if i < len {
        trailing = Some(i)
      }
      break
    }
    if count == 2 && value % 16u32 != 0 {
      return Error(NonCanonical(i - 2))
    }
    if count == 3 && value % 4u32 != 0 {
      return Error(NonCanonical(i - 1))
    }
    if let Some(trailing_at) = trailing {
      return Error(InvalidPadding(trailing_at))
    }
    let packed = if count == 2 {
      value * 4096u32
    } else if count == 3 {
      value * 64u32
    } else {
      value
    }
    out[at] = core@1/int.narrow(packed / 65536u32)
    at += 1
    if count >= 3 {
      out[at] = core@1/int.narrow(packed / 256u32 % 256u32)
      at += 1
    }
    if count == 4 {
      out[at] = core@1/int.narrow(packed % 256u32)
      at += 1
    }
    if padded {
      break
    }
  }
  Ok(at)
}

pub fn decode(text: String, alphabet: Alphabet, padding: Padding) -> Result[
  unique Bytes,
  DecodeError
] uses {} {
  // Only a complete strict success takes the accelerated path. On rejection,
  // rerun the existing parser from offset zero for its exact error precedence.
  if let Some(decoded) = core@1/bytes.base64_decode(
    core@1/string.as_bytes(text),
    alphabet,
    padding
  ) {
    return Ok(take decoded)
  }
  let len = core@1/string.byte_len(text)
  let capacity = len / 4 * 3 + if len % 4 > 1 {
    len % 4 - 1
  } else {
    0
  }
  let mut out: unique List[u8] = output_buffer(capacity)
  let at = decode_into(text, alphabet, padding, mut out)?
  while core@1/list.len(out) > at {
    let _ = core@1/list.pop(mut out)
  }
  Ok(core@1/bytes.from_list(take out))
}

// Go @ ebe2feef base64.go:217-286 encoder.Write/Close/NewEncoder,
// :467-540 decoder.Read and :677-680 NewDecoder. Fixed carry and explicit EOF;
// no io.Reader/Writer, whitespace skipping, or output from a failing call.
// Zig bff490a lib/std/base64.zig:261-280 scalar sextet accumulator/unused-bit
// check, widened to hold a full quantum until Hirsel can commit its output.
@serializable
pub type StreamError = Closed | Decode(DecodeError)

pub opaque type Encoder: copyable + inert + noalloc_drop uses {} {
  alphabet: Alphabet,
  padding: Padding,
  value: u32,
  used: u64,
  ended: bool,
}

pub opaque type Decoder: copyable + inert + noalloc_drop uses {} {
  alphabet: Alphabet,
  padding: Padding,
  value: u32,
  used: u64,
  offset: u64,
  second_pad: bool,
  padded: bool,
  ended: bool,
  failed: Option[DecodeError],
}

@noalloc
pub fn encoder(alphabet: Alphabet, padding: Padding) -> Encoder uses {} {
  Encoder(alphabet: alphabet, padding: padding, value: 0, used: 0, ended: false)
}

@noalloc
pub fn decoder(alphabet: Alphabet, padding: Padding) -> Decoder uses {} {
  Decoder(
    alphabet: alphabet,
    padding: padding,
    value: 0,
    used: 0,
    offset: 0,
    second_pad: false,
    padded: false,
    ended: false,
    failed: None()
  )
}

// Go encoder.Write's leading fringe, interior full quanta, trailing fringe.
pub fn encode_feed(mut state: Encoder, data: Bytes) -> Result[
  unique String,
  StreamError
] uses {} {
  if state.ended {
    return Error(Closed())
  }
  let len = core@1/bytes.len(data)
  let groups = len / 3 + if len % 3 + state.used >= 3 {
    1
  } else {
    0
  }
  core@1/failure.check(groups <= 18446744073709551615u64 / 4, TextInvariant())
  let mut out: List[u8] = []
  let mut i: u64 = 0
  // Leading fringe: finish the quantum carried by the previous feed.
  if state.used != 0 {
    while i < len && state.used < 3 {
      let byte: u32 = core@1/int.widen(data[i])
      state.value = state.value * 256u32 + byte
      state.used += 1
      i += 1
    }
    if state.used == 3 {
      let raw = core@1/bytes.from_list(
        [
          core@1/int.narrow(state.value / 65536u32),
          core@1/int.narrow(state.value / 256u32 % 256u32),
          core@1/int.narrow(state.value % 256u32)
        ]
      )
      text.append(mut out, encode(raw, state.alphabet, Omitted()))
      state.value = 0
      state.used = 0
    }
  }
  // Interior: reuse the established whole-buffer 24-bit packing kernel.
  let end = i + (len - i) / 3 * 3
  if end != i {
    text.append(
      mut out,
      encode(core@1/bytes.slice(data, i, end), state.alphabet, Omitted())
    )
    i = end
  }
  // Trailing fringe: retain only the remaining zero, one or two raw bytes.
  while i < len {
    let byte: u32 = core@1/int.widen(data[i])
    state.value = state.value * 256u32 + byte
    state.used += 1
    i += 1
  }
  Ok(text.finish_valid(take out))
}

pub fn encode_finish(mut state: Encoder) -> Result[unique String, StreamError] uses {} {
  if state.ended {
    return Error(Closed())
  }
  state.ended = true
  let mut tail: List[u8] = []
  if state.used == 2 {
    core@1/list.push(mut tail, core@1/int.narrow(state.value / 256u32))
  }
  if state.used != 0 {
    core@1/list.push(mut tail, core@1/int.narrow(state.value % 256u32))
  }
  state.value = 0
  state.used = 0
  Ok(encode(core@1/bytes.from_list(take tail), state.alphabet, state.padding))
}

@noalloc
fn stream_tail(state: Decoder) -> Result[(), DecodeError] uses {} {
  if state.used == 2 && state.value % 16u32 != 0 {
    return Error(NonCanonical(state.offset - 2))
  }
  if state.used == 3 && state.value % 4u32 != 0 {
    return Error(NonCanonical(state.offset - 1))
  }
  Ok(())
}

fn stream_emit(state: Decoder, mut out: List[u8]) -> () uses {} {
  let packed = if state.used == 2 {
    state.value * 4096u32
  } else if state.used == 3 {
    state.value * 64u32
  } else {
    state.value
  }
  core@1/list.push(mut out, core@1/int.narrow(packed / 65536u32))
  if state.used >= 3 {
    core@1/list.push(mut out, core@1/int.narrow(packed / 256u32 % 256u32))
  }
  if state.used == 4 {
    core@1/list.push(mut out, core@1/int.narrow(packed % 256u32))
  }
}

fn stream_feed(mut state: Decoder, data: Bytes) -> Result[Bytes, DecodeError] uses {} {
  let mut out: List[u8] = []
  let mut i: u64 = 0
  while i < core@1/bytes.len(data) {
    // Keep a terminal padded quantum until EOF, including its original offset.
    if state.padded {
      stream_tail(state)?
      return Error(InvalidPadding(state.offset))
    }
    let byte = data[i]
    if state.second_pad {
      if byte != b'=' {
        return Error(InvalidPadding(state.offset - 1))
      }
      state.offset += 1
      state.second_pad = false
      state.padded = true
    } else {
      let at = state.offset
      state.offset += 1
      let digit = sextet(byte, state.alphabet)
      if digit != 64 {
        state.value = state.value * 64u32 + digit
        state.used += 1
        if state.used == 4 {
          stream_emit(state, mut out)
          state.value = 0
          state.used = 0
        }
      } else if byte != b'=' {
        return Error(InvalidByte(at))
      } else if state.padding == Omitted() || state.used < 2 {
        return Error(InvalidPadding(at))
      } else if state.used == 2 {
        state.second_pad = true
      } else {
        state.padded = true
      }
    }
    i += 1
  }
  Ok(core@1/bytes.from_list(take out))
}

pub fn decode_feed(mut state: Decoder, data: Bytes) -> Result[unique Bytes, StreamError] uses {} {
  if let Some(error) = state.failed {
    return Error(Decode(error))
  }
  if state.ended {
    return Error(Closed())
  }
  core@1/failure.check(
    core@1/bytes.len(data) <= 18446744073709551615u64 - state.offset,
    TextInvariant()
  )
  match stream_feed(mut state, data) {
    Ok(chunk) => Ok(take chunk),
    Error(error) => {
      state.failed = Some(error)
      state.value = 0
      state.used = 0
      Error(Decode(error))
    },
  }
}

fn stream_finish(mut state: Decoder) -> Result[Bytes, DecodeError] uses {} {
  if state.second_pad {
    return Error(InvalidPadding(state.offset))
  }
  if !state.padded && state.used != 0 && (state.used == 1 || state.padding == Required()) {
    return Error(InvalidLength(state.offset - state.used))
  }
  stream_tail(state)?
  let mut out: List[u8] = []
  if state.used != 0 {
    stream_emit(state, mut out)
  }
  state.value = 0
  state.used = 0
  Ok(core@1/bytes.from_list(take out))
}

pub fn decode_finish(mut state: Decoder) -> Result[unique Bytes, StreamError] uses {} {
  if let Some(error) = state.failed {
    return Error(Decode(error))
  }
  if state.ended {
    return Error(Closed())
  }
  state.ended = true
  match stream_finish(mut state) {
    Ok(chunk) => Ok(take chunk),
    Error(error) => {
      state.failed = Some(error)
      state.value = 0
      state.used = 0
      Error(Decode(error))
    },
  }
}
