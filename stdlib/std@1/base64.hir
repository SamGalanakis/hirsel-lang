// Go encoding/base64 @ ebe2feef, base64.go:328-408 decodeQuantum (BSD-3-Clause).
// Quantum scan/padding/error precedence and byte offsets follow Go Strict().
// Deviations: CR/LF rejected (strict RFC4648), typed error kinds, no partial output.
// Encoder uses the same 24-bit packing; no streaming/assembly fast paths.
@serializable
pub type Alphabet = Standard | UrlSafe

@serializable
pub type Padding = Required | Omitted

@serializable
pub type DecodeError = InvalidByte(u64) | InvalidLength(u64) | InvalidPadding(u64) | NonCanonical(
  u64
)

fn alphabet_bytes(alphabet: Alphabet) -> Bytes uses {} {
  core@1/string.as_bytes(
    match alphabet {
      Standard() => "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/",
      UrlSafe() => "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_",
    }
  )
}

pub fn encode(data: Bytes, alphabet: Alphabet, padding: Padding) -> unique String uses {} {
  let table = alphabet_bytes(alphabet)
  let len = core@1/bytes.len(data)
  let remainder = len % 3
  let tail: u64 = if remainder == 0 {
    0
  } else if padding == Required() {
    4
  } else {
    remainder + 1
  }
  core@1/failure.check(len / 3 <= (18446744073709551615u64 - tail) / 4, TextInvariant())
  let mut out: List[u8] = []
  let mut i: u64 = 0
  while i < len {
    let remaining = len - i
    let a: u32 = core@1/int.widen(data[i])
    let b: u32 = if remaining > 1 {
      core@1/int.widen(data[i + 1])
    } else {
      0
    }
    let c: u32 = if remaining > 2 {
      core@1/int.widen(data[i + 2])
    } else {
      0
    }
    let value = a * 65536u32 + b * 256u32 + c
    let first: u64 = core@1/int.widen(value / 262144u32)
    let second: u64 = core@1/int.widen(value / 4096u32 % 64u32)
    core@1/list.push(mut out, table[first])
    core@1/list.push(mut out, table[second])
    if remaining > 1 {
      let third: u64 = core@1/int.widen(value / 64u32 % 64u32)
      core@1/list.push(mut out, table[third])
    } else if padding == Required() {
      core@1/list.push(mut out, b'=')
    }
    if remaining > 2 {
      let fourth: u64 = core@1/int.widen(value % 64u32)
      core@1/list.push(mut out, table[fourth])
    } else if padding == Required() {
      core@1/list.push(mut out, b'=')
    }
    i += if remaining > 2 {
      3
    } else {
      remaining
    }
  }
  match text.finish(take out) {
    Ok(s) => take s,
    Error(_) => {
      core@1/failure.check(false, TextInvariant())
      ""
    },
  }
}

@noalloc
fn sextet(byte: u8, alphabet: Alphabet) -> u32 uses {} {
  let value: u8 = if std@1/ascii.is_upper(byte) {
    byte - b'A'
  } else if std@1/ascii.is_lower(byte) {
    byte - b'a' + 26
  } else if std@1/ascii.is_digit(byte) {
    byte - b'0' + 52
  } else if alphabet == Standard() && byte == b'+' || alphabet == UrlSafe() && byte == b'-' {
    62
  } else if alphabet == Standard() && byte == b'/' || alphabet == UrlSafe() && byte == b'_' {
    63
  } else {
    64
  }
  core@1/int.widen(value)
}

pub fn decode(text: String, alphabet: Alphabet, padding: Padding) -> Result[
  unique Bytes,
  DecodeError
] uses {} {
  let data = core@1/string.as_bytes(text)
  let len = core@1/bytes.len(data)
  let mut out: List[u8] = []
  let mut i: u64 = 0
  while i < len {
    let start = i
    let mut count: u64 = 0
    let mut value: u32 = 0
    let mut padded = false
    let mut trailing: Option[u64] = None()
    while count < 4 {
      if i == len {
        if count == 1 || padding == Required() {
          return Error(InvalidLength(start))
        }
        break
      }
      let byte = data[i]
      i += 1
      let digit = sextet(byte, alphabet)
      if digit != 64 {
        value = value * 64u32 + digit
        count += 1
        continue
      }
      if byte != b'=' {
        return Error(InvalidByte(i - 1))
      }
      if padding == Omitted() || count < 2 {
        return Error(InvalidPadding(i - 1))
      }
      if count == 2 {
        if i == len {
          return Error(InvalidPadding(len))
        }
        if data[i] != b'=' {
          return Error(InvalidPadding(i - 1))
        }
        i += 1
      }
      padded = true
      if i < len {
        trailing = Some(i)
      }
      break
    }
    if count == 2 && value % 16u32 != 0 {
      return Error(NonCanonical(i - 2))
    }
    if count == 3 && value % 4u32 != 0 {
      return Error(NonCanonical(i - 1))
    }
    if let Some(at) = trailing {
      return Error(InvalidPadding(at))
    }
    let packed = if count == 2 {
      value * 4096u32
    } else if count == 3 {
      value * 64u32
    } else {
      value
    }
    core@1/list.push(mut out, core@1/int.narrow(packed / 65536u32))
    if count >= 3 {
      core@1/list.push(mut out, core@1/int.narrow(packed / 256u32 % 256u32))
    }
    if count == 4 {
      core@1/list.push(mut out, core@1/int.narrow(packed % 256u32))
    }
    if padded {
      break
    }
  }
  Ok(core@1/bytes.from_list(take out))
}
