// Go unicode range search/simple scalar conversion over pinned Unicode16 data.
@noalloc
fn property_contains(table: Bytes, cp: u32) -> bool uses {} {
  let mut low: u64 = 0
  let mut high = core@1/bytes.len(table) / 6
  while low < high {
    let middle = low + (high - low) / 2
    let start = scalar_at(table, middle * 6)
    let end = scalar_at(table, middle * 6 + 3)
    if cp < start {
      high = middle
    } else if cp > end {
      low = middle + 1
    } else {
      return true
    }
  }
  false
}

@noalloc
fn simple_case(table: Bytes, c: char) -> char uses {} {
  let cp = core@1/char.to_u32(c)
  let mut low: u64 = 0
  let mut high = core@1/bytes.len(table) / 6
  while low < high {
    let middle = low + (high - low) / 2
    let value = scalar_at(table, middle * 6)
    if cp < value {
      high = middle
    } else if cp > value {
      low = middle + 1
    } else {
      // The pinned tables map scalar values to scalar values.
      return match core@1/char.from_u32(scalar_at(table, middle * 6 + 3)) {
        Some(mapped) => mapped,
        None() => c,
      }
    }
  }
  c
}

@noalloc
pub fn is_whitespace(c: char) -> bool uses {} {
  property_contains(WHITE_SPACE, core@1/char.to_u32(c))
}

@noalloc
pub fn is_letter(c: char) -> bool uses {} {
  property_contains(LETTERS, core@1/char.to_u32(c))
}

@noalloc
pub fn is_digit(c: char) -> bool uses {} {
  property_contains(DIGITS, core@1/char.to_u32(c))
}

@noalloc
pub fn simple_lower(c: char) -> char uses {} {
  simple_case(SIMPLE_LOWER, c)
}

@noalloc
pub fn simple_upper(c: char) -> char uses {} {
  simple_case(SIMPLE_UPPER, c)
}
