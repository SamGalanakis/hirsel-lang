// Port of Zig lib/std/Uri.zig, bff490a23889750de7096d9057c0a432efc929a8
// (MIT; third-party/NOTICES.md): parse[AfterScheme], resolveInPlace,
// remove_dot_segments, Component.percentEncode/formatRaw and writeToStream.
// Owned components replace borrowed Zig slices; builders replace mutable slices.
// Numeric tokens follow RFC 3986 §§2.1/3.2.3 rather than Zig fmt.parseInt.
// Vector inventory and deviations: docs/uri-prior-art.md.
@serializable
pub type Component = Raw(String) | Encoded(String)

@serializable
pub type Uri {
  scheme: String,
  user: Option[Component],
  password: Option[Component],
  host: Option[Component],
  port: Option[u16],
  path: Component,
  query: Option[Component],
  fragment: Option[Component],
}

@serializable
pub type UriError = UnexpectedCharacter | InvalidFormat | InvalidPort | InvalidHostName

@serializable
pub type Part = Unreserved | User | Password | Host | Path | Query | Fragment

fn piece(text: String, begin: u64, end: u64) -> String uses {} {
  let data = core@1/string.as_bytes(text)
  let mut out: List[u8] = []
  let mut i = begin
  while i < end {
    core@1/list.push(mut out, data[i])
    i += 1
  }
  std@1/text.finish_valid(take out)
}

// RFC 3986 §2.1: pct-encoded = "%" HEXDIG HEXDIG. Unlike Zig
// Uri.zig:71, do not delegate protocol digits to permissive fmt.parseInt.
@noalloc
fn hex_pair(a: u8, b: u8) -> u16 uses {} {
  let first = std@1/ascii.digit_value_radix(a, 16)
  let second = std@1/ascii.digit_value_radix(b, 16)
  match (first, second) {
    (Some(high), Some(low)) => core@1/int.widen(high * 16 + low),
    _ => 256,
  }
}

// RFC 3986 §3.2.3: port = *DIGIT; retain the existing nonempty u16 API.
// Zig Uri.zig:230,236 uses fmt.parseInt, which also accepts signs/underscores.
@noalloc
fn parse_port(data: Bytes, start: u64, end: u64) -> Result[u16, UriError] uses {} {
  if start == end {
    return Error(InvalidPort())
  }
  let mut i = start
  let mut value: u64 = 0
  while i < end {
    let Some(digit) = std@1/ascii.digit_value(data[i]) else {
      return Error(InvalidPort())
    }
    let next: u64 = core@1/int.widen(digit)
    if value > (65535u64 - next) / 10 {
      return Error(InvalidPort())
    }
    value = value * 10 + next
    i += 1
  }
  Ok(core@1/int.narrow(value))
}

// Zig formatRaw: invalid or incomplete escapes stay literal; '+' stays '+'.
pub fn percent_decode(text: String) -> unique Bytes uses {} {
  let data = core@1/string.as_bytes(text)
  let end = core@1/bytes.len(data)
  let mut out: List[u8] = []
  let mut i: u64 = 0
  while i < end {
    if data[i] == 37 && end - i >= 3 && hex_pair(data[i + 1], data[i + 2]) < 256 {
      core@1/list.push(mut out, core@1/int.narrow(hex_pair(data[i + 1], data[i + 2])))
      i += 3
    } else {
      core@1/list.push(mut out, data[i])
      i += 1
    }
  }
  core@1/bytes.from_list(take out)
}

@noalloc
fn unreserved(byte: u8) -> bool uses {} {
  std@1/ascii.is_alnum(byte) || byte == 45 || byte == 46 || byte == 95 || byte == 126
}

@noalloc
fn sub_delim(byte: u8) -> bool uses {} {
  byte == 33 || byte == 36 || byte == 38 || byte == 39 || byte == 40 || byte == 41 || byte == 42 || byte == 43 || byte == 44 || byte == 59 || byte == 61
}

@noalloc
fn valid_char(byte: u8, part: Part) -> bool uses {} {
  if unreserved(byte) {
    return true
  }
  match part {
    Unreserved() => false,
    User() => sub_delim(byte),
    Password() => sub_delim(byte) || byte == 58,
    Host() => sub_delim(byte) || byte == 58 || byte == 91 || byte == 93,
    Path() => sub_delim(byte) || byte == 47 || byte == 58 || byte == 64,
    Query() => sub_delim(byte) || byte == 47 || byte == 58 || byte == 64 || byte == 63,
    Fragment() => sub_delim(byte) || byte == 47 || byte == 58 || byte == 64 || byte == 63,
  }
}

fn encode(data: Bytes, part: Part) -> String uses {} {
  let digits: Bytes = b"0123456789ABCDEF"
  let mut out: List[u8] = []
  let mut i: u64 = 0
  while i < core@1/bytes.len(data) {
    let byte = data[i]
    if valid_char(byte, part) {
      core@1/list.push(mut out, byte)
    } else {
      core@1/list.push(mut out, 37)
      core@1/list.push(mut out, digits[core@1/int.widen(byte / 16)])
      core@1/list.push(mut out, digits[core@1/int.widen(byte % 16)])
    }
    i += 1
  }
  text.finish_valid(take out)
}

pub fn percent_encode(data: Bytes) -> unique String uses {} {
  encode(data, Unreserved())
}

pub fn component_raw(component: Component) -> unique Bytes uses {} {
  match component {
    Encoded(text) => percent_decode(text),
    Raw(text) => {
      let data = core@1/string.as_bytes(text)
      let mut out: List[u8] = []
      let mut i: u64 = 0
      while i < core@1/bytes.len(data) {
        core@1/list.push(mut out, data[i])
        i += 1
      }
      core@1/bytes.from_list(take out)
    },
  }
}

pub fn component_text(component: Component) -> Result[unique String, unique Bytes] uses {} {
  match core@1/string.from_bytes(component_raw(component)) {
    Ok(text) => Ok(take text),
    Error(bytes) => Error(take bytes),
  }
}

pub fn component_encoded(component: Component, part: Part) -> unique String uses {} {
  match component {
    Encoded(text) => unique text,
    Raw(text) => encode(core@1/string.as_bytes(text), part),
  }
}

@noalloc
fn valid_scheme(data: Bytes, end: u64) -> bool uses {} {
  if end == 0 || !std@1/ascii.is_alpha(data[0]) {
    return false
  }
  let mut i: u64 = 1
  while i < end {
    let byte = data[i]
    if !std@1/ascii.is_alnum(byte) && byte != 43 && byte != 45 && byte != 46 {
      return false
    }
    i += 1
  }
  true
}

@preserves_unique(scheme, text)
fn parse_after_scheme(take scheme: String, take text: String) -> Result[Uri, UriError] uses {} {
  let data = core@1/string.as_bytes(text)
  let end = core@1/bytes.len(data)
  let mut parsed_uri = Uri(
    scheme: take scheme,
    user: None(),
    password: None(),
    host: None(),
    port: None(),
    path: Encoded(""),
    query: None(),
    fragment: None()
  )
  let mut i: u64 = 0
  if end >= 2 && data[0] == 47 && data[1] == 47 {
    i = 2
    while i < end && data[i] != 47 && data[i] != 63 && data[i] != 35 {
      i += 1
    }
    if i == 2 {
      if i == end || data[i] != 47 {
        return Error(InvalidFormat())
      }
    } else {
      let mut start: u64 = 2
      let mut at: u64 = 2
      let mut j: u64 = 2
      while j < i {
        if data[j] == 64 {
          at = j + 1
        }
        j += 1
      }
      if at > 2 {
        start = at
        let mut colon: u64 = 2
        while colon < at - 1 && data[colon] != 58 {
          colon += 1
        }
        parsed_uri.user = Some(Encoded(piece(text, 2, colon)))
        if colon + 1 < at - 1 {
          parsed_uri.password = Some(Encoded(piece(text, colon + 1, at - 1)))
        }
      }
      if start < i {
        if data[start] == 93 {
          return Error(InvalidFormat())
        }
        let mut host_end = i
        let mut port_start = i
        if data[start] == 91 {
          let mut closing = start
          j = start + 1
          while j < i {
            if data[j] == 93 {
              closing = j
            }
            j += 1
          }
          if closing == start {
            return Error(InvalidFormat())
          }
          host_end = closing + 1
          j = host_end
          while j < i {
            if data[j] == 58 {
              port_start = j + 1
            }
            j += 1
          }
        } else {
          j = start
          while j < i {
            if data[j] == 58 {
              host_end = j
              port_start = j + 1
            }
            j += 1
          }
        }
        if port_start < i || i > start && data[i - 1] == 58 {
          let Ok(p) = parse_port(data, port_start, i) else {
            return Error(InvalidPort())
          }
          parsed_uri.port = Some(p)
        }
        if start >= host_end {
          return Error(InvalidFormat())
        }
        let host = piece(text, start, host_end)
        if core@1/string.byte_len(host) > 254 {
          return Error(InvalidHostName())
        }
        // The only URI host-grammar tightening: guard numeric hosts after decoding,
        // using the same WHATWG checker as grants and net.validate_host.
        if data[start] != 91 {
          let Ok(decoded) = core@1/string.from_bytes(percent_decode(host)) else {
            return Error(InvalidHostName())
          }
          if net.ends_in_number(decoded) {
            if let Error(_) = net.parse_ipv4(decoded) {
              return Error(InvalidHostName())
            }
          }
        }
        parsed_uri.host = Some(Encoded(take host))
      }
    }
  }
  let path_start = i
  while i < end && data[i] != 63 && data[i] != 35 {
    i += 1
  }
  parsed_uri.path = Encoded(piece(text, path_start, i))
  if i < end && data[i] == 63 {
    let query_start = i + 1
    i += 1
    while i < end && data[i] != 35 {
      i += 1
    }
    parsed_uri.query = Some(Encoded(piece(text, query_start, i)))
  }
  if i < end && data[i] == 35 {
    parsed_uri.fragment = Some(Encoded(piece(text, i + 1, end)))
  }
  Ok(take parsed_uri)
}

pub fn parse(text: String) -> Result[Uri, UriError] uses {} {
  let data = core@1/string.as_bytes(text)
  let end = core@1/bytes.len(data)
  let mut colon: u64 = 0
  while colon < end && data[colon] != 58 {
    colon += 1
  }
  if colon == end {
    return Error(InvalidFormat())
  }
  if !valid_scheme(data, colon) {
    return Error(UnexpectedCharacter())
  }
  let scheme = piece(text, 0, colon)
  let remainder = piece(text, colon + 1, end)
  parse_after_scheme(take scheme, take remainder)
}

// Zig writeToStream(.all): an empty path is rendered as '/'.
pub fn to_string(parsed_uri: Uri) -> unique String uses {} {
  let mut out: List[u8] = []
  text.append(mut out, parsed_uri.scheme)
  core@1/list.push(mut out, 58)
  if let Some(host) = parsed_uri.host {
    text.append(mut out, "//")
    if let Some(user) = parsed_uri.user {
      text.append(mut out, component_encoded(user, User()))
      if let Some(password) = parsed_uri.password {
        core@1/list.push(mut out, 58)
        text.append(mut out, component_encoded(password, Password()))
      }
      core@1/list.push(mut out, 64)
    }
    text.append(mut out, component_encoded(host, Host()))
    if let Some(port) = parsed_uri.port {
      core@1/list.push(mut out, 58)
      u16.format_into(port, mut out)
    }
  }
  let path = component_encoded(parsed_uri.path, Path())
  text.append(
    mut out,
    if path == "" {
      "/"
    } else {
      path
    }
  )
  if let Some(query) = parsed_uri.query {
    core@1/list.push(mut out, 63)
    text.append(mut out, component_encoded(query, Query()))
  }
  if let Some(fragment) = parsed_uri.fragment {
    core@1/list.push(mut out, 35)
    text.append(mut out, component_encoded(fragment, Fragment()))
  }
  text.finish_valid(take out)
}

// Zig remove_dot_segments, RFC3986 §5.2.4. Active output length replaces a
// mutable byte slice; unused list suffixes are discarded when building the result.
pub fn remove_dot_segments(path: String) -> unique String uses {} {
  let data = core@1/string.as_bytes(path)
  let end = core@1/bytes.len(data)
  let mut input: u64 = 0
  let mut length: u64 = 0
  let mut out: List[u8] = []
  while input < end {
    if end - input >= 2 && data[input] == 46 && data[input + 1] == 47 {
      input += 2
    } else if end - input >= 3 && data[input] == 46 && data[input + 1] == 46 && data[input + 2] == 47 {
      input += 3
    } else if end - input >= 3 && data[input] == 47 && data[input + 1] == 46 && data[input + 2] == 47 {
      input += 2
    } else if end - input >= 3 && data[input] == 47 && data[input + 1] == 46 && data[input + 2] == 46 && (end - input == 3 || data[input + 3] == 47) {
      input += 3
      while length > 0 {
        length -= 1
        if out[length] == 47 {
          break
        }
      }
      if input == end {
        if length < core@1/list.len(out) {
          out[length] = 47
        } else {
          core@1/list.push(mut out, 47)
        }
        length += 1
      }
    } else if end - input == 2 && data[input] == 47 && data[input + 1] == 46 {
      input += 2
      if length < core@1/list.len(out) {
        out[length] = 47
      } else {
        core@1/list.push(mut out, 47)
      }
      length += 1
    } else if data[input] == 46 && (end - input == 1 || end - input == 2 && data[input + 1] == 46) {
      input = end
    } else {
      let mut first: bool = true
      while input < end && (first || data[input] != 47) {
        if length < core@1/list.len(out) {
          out[length] = data[input]
        } else {
          core@1/list.push(mut out, data[input])
        }
        input += 1
        length += 1
        first = false
      }
    }
  }
  let mut result_bytes: List[u8] = []
  let mut i: u64 = 0
  while i < length {
    core@1/list.push(mut result_bytes, out[i])
    i += 1
  }
  text.finish_valid(take result_bytes)
}

// Zig resolveInPlace and merge_paths; the result owns its copied base components.
pub fn resolve(base: Uri, reference: String) -> Result[Uri, UriError] uses {} {
  let mut next = match parse(reference) {
    Ok(parsed_uri) => take parsed_uri,
    Error(original) => {
      // Keep failures of absolute references: a numeric-host refusal must not
      // turn into a successful relative path (owner T5 addendum).
      let data = core@1/string.as_bytes(reference)
      let end = core@1/bytes.len(data)
      let mut colon: u64 = 0
      while colon < end && data[colon] != 58 {
        colon += 1
      }
      if colon < end && valid_scheme(data, colon) {
        return Error(original)
      }
      let remainder = piece(reference, 0, end)
      let Ok(parsed_uri) = parse_after_scheme("", take remainder) else {
        return Error(original)
      }
      take parsed_uri
    },
  }
  let path = component_encoded(next.path, Path())
  if next.scheme != "" {
    next.path = Encoded(remove_dot_segments(path))
    return Ok(take next)
  }
  // Borrowed component blocks stay caller-local; copy the base into owned storage.
  let owned_base = unique base
  next.scheme = copy owned_base.scheme
  if let Some(_) = next.host {
    next.path = Encoded(remove_dot_segments(path))
    return Ok(take next)
  }
  next.user = copy owned_base.user
  next.password = copy owned_base.password
  next.host = copy owned_base.host
  next.port = owned_base.port
  if path == "" {
    next.path = copy owned_base.path
    if let None() = next.query {
      next.query = copy owned_base.query
    }
  } else if string.starts_with(path, "/") {
    next.path = Encoded(remove_dot_segments(path))
  } else {
    let base_path = component_encoded(owned_base.path, Path())
    let data = core@1/string.as_bytes(base_path)
    let mut cut = core@1/bytes.len(data)
    while cut > 0 && data[cut - 1] != 47 {
      cut -= 1
    }
    let merged = if cut > 0 {
      string.concat(piece(base_path, 0, cut), path)
    } else if base_path == "" {
      string.concat("/", path)
    } else {
      path
    }
    next.path = Encoded(remove_dot_segments(merged))
  }
  Ok(take next)
}

// Go net/url parseQuery and QueryUnescape, adapted to ordered, owned pairs.
// Errors are atomic (no partial map) and offsets refer to the original query.
@serializable
pub type QueryError = InvalidEscape(u64) | InvalidSeparator(u64) | InvalidUtf8(u64)

fn query_piece(data: Bytes, start: u64, end: u64) -> Result[String, QueryError] uses {} {
  let mut out: List[u8] = []
  let mut i = start
  while i < end {
    let byte = data[i]
    if byte == 37 {
      if end - i < 3 {
        return Error(InvalidEscape(i))
      }
      let high = std@1/ascii.digit_value_radix(data[i + 1], 16)
      let low = std@1/ascii.digit_value_radix(data[i + 2], 16)
      let (Some(a), Some(b)) = (high, low) else {
        return Error(InvalidEscape(i))
      }
      core@1/list.push(mut out, a * 16 + b)
      i += 3
    } else {
      core@1/list.push(
        mut out,
        if byte == 43 {
          32u8
        } else {
          byte
        }
      )
      i += 1
    }
  }
  match text.finish(take out) {
    Ok(value) => Ok(take value),
    Error(_) => Error(InvalidUtf8(start)),
  }
}

// The input is the query without '?', or an application/x-www-form-urlencoded body.
// Like Go ParseQuery: empty fields are ignored, a missing '=' means an empty value,
// and a literal semicolon is an error. Unlike Go, malformed input returns no pairs.
pub fn query_pairs(query: String) -> Result[
  unique List[(unique String, unique String)],
  QueryError
] uses {} {
  let data = core@1/string.as_bytes(query)
  let end = core@1/bytes.len(data)
  let mut pairs: List[(unique String, unique String)] = []
  let mut start: u64 = 0
  while start < end {
    let mut stop = start
    let mut equal = end
    while stop < end && data[stop] != 38 {
      if data[stop] == 59 {
        return Error(InvalidSeparator(stop))
      }
      if data[stop] == 61 && equal == end {
        equal = stop
      }
      stop += 1
    }
    if stop > start {
      let key_end = if equal < stop {
        equal
      } else {
        stop
      }
      let value_start = if equal < stop {
        equal + 1
      } else {
        stop
      }
      let key = query_piece(data, start, key_end)?
      let value = query_piece(data, value_start, stop)?
      core@1/list.push(mut pairs, (take key, take value))
    }
    start = stop + 1
  }
  Ok(take pairs)
}

fn query_encode_piece(mut out: List[u8], value: String) -> () uses {} {
  let digits: Bytes = b"0123456789ABCDEF"
  let data = core@1/string.as_bytes(value)
  let mut i: u64 = 0
  while i < core@1/bytes.len(data) {
    let byte = data[i]
    i += 1
    if unreserved(byte) {
      core@1/list.push(mut out, byte)
    } else if byte == 32 {
      core@1/list.push(mut out, 43u8)
    } else {
      core@1/list.push(mut out, 37u8)
      core@1/list.push(mut out, digits[core@1/int.widen(byte / 16)])
      core@1/list.push(mut out, digits[core@1/int.widen(byte % 16)])
    }
  }
}

// Go QueryEscape's alphabet; pair order and repeated keys are preserved.
pub fn encode_query(pairs: List[(String, String)]) -> unique String uses {} {
  let mut out: List[u8] = []
  let mut first = true
  for (key, value) in pairs {
    if !first {
      core@1/list.push(mut out, 38u8)
    }
    first = false
    query_encode_piece(mut out, key)
    core@1/list.push(mut out, 61u8)
    query_encode_piece(mut out, value)
  }
  text.finish_valid(take out)
}
