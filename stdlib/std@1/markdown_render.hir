// See docs/prior-art/markdown.md for exact reference locations and deviations.

fn escape_html(mut out: List[u8], s: String) -> () uses {} {
  let mut i: u64 = 0
  while i < size(s) {
    let b = byte(s, i)
    if b == 38 {
      text.append(mut out, "&amp;")
    } else if b == 60 {
      text.append(mut out, "&lt;")
    } else if b == 62 {
      text.append(mut out, "&gt;")
    } else if b == 34 {
      text.append(mut out, "&quot;")
    } else {
      core@1/list.push(mut out, b)
    }
    i += 1
  }
}

fn newline(mut out: List[u8]) -> () uses {} {
  let len = core@1/list.len(out)
  if len > 0 && out[len - 1] != 10 {
    core@1/list.push(mut out, 10u8)
  }
}

fn image_alt(node: Node, mut out: List[u8]) -> () uses {} {
  match node.kind {
    Text(s) => escape_html(mut out, s),
    Code(s) => escape_html(mut out, s),
    HtmlInline(_) => (),
    SoftBreak() => core@1/list.push(mut out, 10u8),
    HardBreak() => core@1/list.push(mut out, 10u8),
    _ => {
      for descendant in node.children {
        image_alt(descendant, mut out)
      }
    },
  }
}

// Match anchored, case-insensitive protocols after the parser normalizes entities.
fn potentially_unsafe(url: String) -> bool uses {} {
  let lower = string.ascii_lower(url)
  let unsafe_scheme = string.starts_with(lower, "javascript:") || string.starts_with(
    lower,
    "vbscript:"
  ) || string.starts_with(lower, "file:") || string.starts_with(lower, "data:")
  let safe_data = string.starts_with(lower, "data:image/png") || string.starts_with(
    lower,
    "data:image/gif"
  ) || string.starts_with(lower, "data:image/jpeg") || string.starts_with(
    lower,
    "data:image/webp"
  )
  unsafe_scheme && !safe_data
}

fn filtered_tag(s: String, start: u64) -> bool uses {} {
  let mut i = start + 1
  if byte(s, i) == 47 {
    i += 1
  }
  let name_start = i
  while ascii.is_alpha(byte(s, i)) {
    i += 1
  }
  let name = string.ascii_lower(piece(s, name_start, i))
  let disallowed = name == "title" || name == "textarea" || name == "style" || name == "xmp" || name == "iframe" || name == "noembed" || name == "noframes" || name == "script" || name == "plaintext"
  disallowed && (whitespace(byte(s, i)) || byte(s, i) == 62 || byte(s, i) == 47 && byte(
    s,
    i + 1
  ) == 62)
}

fn raw_html(s: String, mut out: List[u8], options: Options) -> () uses {} {
  if !options.allow_unsafe {
    text.append(mut out, "<!-- raw HTML omitted -->")
    return
  }
  let mut i: u64 = 0
  while i < size(s) {
    if options.tagfilter && byte(s, i) == 60 && filtered_tag(s, i) {
      text.append(mut out, "&lt;")
    } else {
      core@1/list.push(mut out, byte(s, i))
    }
    i += 1
  }
}

// Keep extension rendering separate from the CommonMark walker so validation
// memory follows each small body rather than one growing exhaustive match.
fn render_footnote(node: Node, mut out: List[u8], options: Options) -> () uses {} {
  match node.kind {
    FootnoteDefinition(label) => {
      text.append(mut out, "<li id=\"fn-")
      escape_html(mut out, normalize_uri(label))
      text.append(mut out, "\">\n")
      for descendant in node.children {
        render_node(descendant, mut out, false, false, options)
      }
      newline(mut out)
      text.append(mut out, "</li>\n")
    },
    FootnoteReference(label, index, occurrence) => {
      text.append(mut out, "<sup class=\"footnote-ref\"><a href=\"#fn-")
      escape_html(mut out, normalize_uri(label))
      text.append(mut out, "\" id=\"fnref-")
      escape_html(mut out, normalize_uri(label))
      if occurrence > 1 {
        text.append(mut out, f"-{occurrence}")
      }
      text.append(mut out, f"\" data-footnote-ref>{index}</a></sup>")
    },
    FootnoteBackrefs(label, index, count) => {
      let mut occurrence: u64 = 1
      while occurrence <= count {
        if occurrence > 1 {
          core@1/list.push(mut out, 32u8)
        }
        let suffix = if occurrence == 1 {
          ""
        } else {
          f"-{occurrence}"
        }
        text.append(mut out, "<a href=\"#fnref-")
        escape_html(mut out, normalize_uri(label))
        text.append(
          mut out,
          f"{suffix}\" class=\"footnote-backref\" data-footnote-backref data-footnote-backref-idx=\"{index}{suffix}\" aria-label=\"Back to reference {index}{suffix}\">↩"
        )
        if occurrence > 1 {
          text.append(mut out, f"<sup class=\"footnote-ref\">{occurrence}</sup>")
        }
        text.append(mut out, "</a>")
        occurrence += 1
      }
    },
    _ => (),
  }
}

fn render_node(
  node: Node,
  mut out: List[u8],
  tight: bool,
  cell_header: bool,
  options: Options
) -> () uses {} {
  match node.kind {
    Document() => {
      let mut footnotes = false
      for descendant in node.children {
        if let FootnoteDefinition(_) = descendant.kind {
          if !footnotes {
            text.append(mut out, "<section class=\"footnotes\" data-footnotes>\n<ol>\n")
            footnotes = true
          }
        }
        render_node(descendant, mut out, false, false, options)
      }
      if footnotes {
        text.append(mut out, "</ol>\n</section>\n")
      }
    },
    FootnoteDefinition(_) => render_footnote(node, mut out, options),
    FootnoteReference(_, _, _) => render_footnote(node, mut out, options),
    FootnoteBackrefs(_, _, _) => render_footnote(node, mut out, options),
    Text(s) => escape_html(mut out, s),
    SoftBreak() => core@1/list.push(mut out, 10u8),
    HardBreak() => text.append(mut out, "<br />\n"),
    Code(s) => {
      text.append(mut out, "<code>")
      escape_html(mut out, s)
      text.append(mut out, "</code>")
    },
    HtmlInline(s) => raw_html(s, mut out, options),
    HtmlBlock(s) => {
      newline(mut out)
      raw_html(s, mut out, options)
      newline(mut out)
    },
    CodeBlock(s, info) => {
      newline(mut out)
      text.append(mut out, "<pre><code")
      let words = string.split_ascii_whitespace(unique info)
      if core@1/list.len(words) != 0 {
        text.append(mut out, " class=\"language-")
        escape_html(mut out, words[0])
        core@1/list.push(mut out, 34u8)
      }
      core@1/list.push(mut out, 62u8)
      escape_html(mut out, s)
      text.append(mut out, "</code></pre>\n")
    },
    ThematicBreak() => {
      newline(mut out)
      text.append(mut out, "<hr />\n")
    },
    Paragraph() => {
      if !tight {
        newline(mut out)
        text.append(mut out, "<p>")
      }
      for descendant in node.children {
        render_node(descendant, mut out, false, false, options)
      }
      if !tight {
        text.append(mut out, "</p>\n")
      }
    },
    Heading(level) => {
      newline(mut out)
      text.append(mut out, f"<h{level}>")
      for descendant in node.children {
        render_node(descendant, mut out, false, false, options)
      }
      text.append(mut out, f"</h{level}>\n")
    },
    BlockQuote() => {
      newline(mut out)
      text.append(mut out, "<blockquote>\n")
      for descendant in node.children {
        render_node(descendant, mut out, false, false, options)
      }
      newline(mut out)
      text.append(mut out, "</blockquote>\n")
    },
    ListBlock(ordered, start, list_tight) => {
      newline(mut out)
      if ordered {
        text.append(
          mut out,
          if start == 1 {
            "<ol>\n"
          } else {
            f"<ol start=\"{start}\">\n"
          }
        )
      } else {
        text.append(mut out, "<ul>\n")
      }
      for descendant in node.children {
        render_node(descendant, mut out, list_tight, false, options)
      }
      newline(mut out)
      text.append(
        mut out,
        if ordered {
          "</ol>\n"
        } else {
          "</ul>\n"
        }
      )
    },
    Item(checked) => {
      text.append(mut out, "<li>")
      if let Some(value) = checked {
        text.append(
          mut out,
          if value {
            "<input checked=\"\" disabled=\"\" type=\"checkbox\"> "
          } else {
            "<input disabled=\"\" type=\"checkbox\"> "
          }
        )
      }
      for descendant in node.children {
        render_node(descendant, mut out, tight, false, options)
      }
      text.append(mut out, "</li>\n")
    },
    Link(dest, title) => {
      text.append(mut out, "<a")
      if options.allow_unsafe || !potentially_unsafe(dest) {
        text.append(mut out, " href=\"")
        escape_html(mut out, dest)
        core@1/list.push(mut out, 34u8)
      }
      if title != "" {
        text.append(mut out, " title=\"")
        escape_html(mut out, title)
        core@1/list.push(mut out, 34u8)
      }
      core@1/list.push(mut out, 62u8)
      for descendant in node.children {
        render_node(descendant, mut out, false, false, options)
      }
      text.append(mut out, "</a>")
    },
    Image(dest, title) => {
      text.append(mut out, "<img src=\"")
      if options.allow_unsafe || !potentially_unsafe(dest) {
        escape_html(mut out, dest)
      }
      text.append(mut out, "\" alt=\"")
      for descendant in node.children {
        image_alt(descendant, mut out)
      }
      core@1/list.push(mut out, 34u8)
      if title != "" {
        text.append(mut out, " title=\"")
        escape_html(mut out, title)
        core@1/list.push(mut out, 34u8)
      }
      text.append(mut out, " />")
    },
    Emphasis() => {
      text.append(mut out, "<em>")
      for descendant in node.children {
        render_node(descendant, mut out, false, false, options)
      }
      text.append(mut out, "</em>")
    },
    Strong() => {
      text.append(mut out, "<strong>")
      for descendant in node.children {
        render_node(descendant, mut out, false, false, options)
      }
      text.append(mut out, "</strong>")
    },
    Strikethrough() => {
      text.append(mut out, "<del>")
      for descendant in node.children {
        render_node(descendant, mut out, false, false, options)
      }
      text.append(mut out, "</del>")
    },
    Table() => {
      newline(mut out)
      text.append(mut out, "<table>\n")
      let mut first = true
      let mut body = false
      for row in node.children {
        if first {
          text.append(mut out, "<thead>\n")
          render_node(row, mut out, false, true, options)
          text.append(mut out, "</thead>\n")
          first = false
        } else {
          if !body {
            text.append(mut out, "<tbody>\n")
            body = true
          }
          render_node(row, mut out, false, false, options)
        }
      }
      if body {
        text.append(mut out, "</tbody>\n")
      }
      text.append(mut out, "</table>\n")
    },
    TableRow(header) => {
      text.append(mut out, "<tr>\n")
      for cell in node.children {
        render_node(cell, mut out, false, header, options)
      }
      text.append(mut out, "</tr>\n")
    },
    TableCell(align) => {
      text.append(
        mut out,
        if cell_header {
          "<th"
        } else {
          "<td"
        }
      )
      if align != 0 {
        text.append(
          mut out,
          if align == 1 {
            " align=\"left\""
          } else if align == 2 {
            " align=\"center\""
          } else {
            " align=\"right\""
          }
        )
      }
      core@1/list.push(mut out, 62u8)
      for descendant in node.children {
        render_node(descendant, mut out, false, false, options)
      }
      text.append(
        mut out,
        if cell_header {
          "</th>\n"
        } else {
          "</td>\n"
        }
      )
    },
  }
}

/// Render an editable AST safely with CommonMark defaults.
pub fn render_html(document: Node) -> String uses {} {
  render_html_with_options(document, default_options())
}

/// Render an AST with explicit safety and GFM tag filter options.
pub fn render_html_with_options(document: Node, options: Options) -> String uses {} {
  let mut out: List[u8] = []
  render_node(document, mut out, false, false, options)
  text.finish_valid(take out)
}

pub fn to_html(take source: String, options: Options) -> String uses {} {
  render_html_with_options(parse(take source, options), options)
}
