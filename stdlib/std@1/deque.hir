// Endpoint semantics and owned-item vectors from Rust VecDeque and Zig deque.
pub opaque type Deque[T]: () uses {T} {
  front: unique List[unique T],
  back: unique List[unique T],
}

pub fn empty[T]() -> unique Deque[T] uses {} {
  Deque(front: [], back: [])
}

@noalloc
pub fn len[T](q: Deque[T]) -> u64 uses {} {
  core@1/list.len(q.front) + core@1/list.len(q.back)
}

pub fn push_front[T](mut q: unique Deque[T], take value: unique T) -> () uses {q, value} {
  core@1/list.push(mut q.front, take value)
}

pub fn push_back[T](mut q: unique Deque[T], take value: unique T) -> () uses {q, value} {
  core@1/list.push(mut q.back, take value)
}

// Moving half to the empty side avoids repeatedly reversing the whole queue
// when callers alternate endpoint removals. Every element remains owned.
fn balance[T](mut target: unique List[unique T], mut source: unique List[unique T]) -> () uses {target, source} {
  let count = core@1/list.len(source)
  let transfer = count - count / 2
  list.reverse(mut source)
  let mut moved: u64 = 0
  while moved < transfer {
    match take core@1/list.pop(mut source) {
      Some(item) => core@1/list.push(mut target, take item),
      None => {},
    }
    moved += 1
  }
  list.reverse(mut target)
  list.reverse(mut source)
}

pub fn pop_front[T](mut q: unique Deque[T]) -> unique Option[T] uses {q} {
  if core@1/list.len(q.front) == 0 {
    balance(mut q.front, mut q.back)
  }
  let item = core@1/list.pop(mut q.front)
  match take item {
    Some(value) => Some(take value),
    None => None(),
  }
}

pub fn pop_back[T](mut q: unique Deque[T]) -> unique Option[T] uses {q} {
  if core@1/list.len(q.back) == 0 {
    balance(mut q.back, mut q.front)
  }
  let item = core@1/list.pop(mut q.back)
  match take item {
    Some(value) => Some(take value),
    None => None(),
  }
}
