// RFC 5869 HKDF over any digest.Digest, from Go crypto/internal/fips140/hkdf
// hkdf.go (BSD-3-Clause).
// The pseudorandom key: HMAC keyed by `salt` over the input keying material. An
// empty salt is the RFC's default of `H.bytes` zero bytes, which HMAC pads identically.
pub fn extract[H: implementation std@1/digest.Digest](salt: Bytes, secret: Bytes) -> Inline[
  u8,
  H.bytes
] uses {} {
  std@1/hmac.mac with (H = H)(salt, secret)
}

// `length` output bytes, T(1) | T(2) | .. where T(i) = HMAC(prk, T(i-1) | info | i).
// `length` is at most 255 * H.bytes, otherwise SEM-3.
pub fn expand[H: implementation std@1/digest.Digest](
  prk: Bytes,
  info: Bytes,
  length: u64
) -> unique Bytes uses {} {
  core@1/failure.check(length <= 255 * H.bytes, TextInvariant())
  let keyed = std@1/hmac.new with (H = H)(prk)
  let mut out: List[u8] = []
  core@1/list.reserve(mut out, length)
  let mut previous: List[u8] = []
  let mut counter: u8 = 1
  while core@1/list.len(out) < length {
    let mut state = keyed
    std@1/hmac.update with (H = H)(mut state, core@1/bytes.from_list(take previous))
    std@1/hmac.update with (H = H)(mut state, info)
    std@1/hmac.update with (H = H)(mut state, core@1/bytes.from_list([counter]))
    let block = std@1/hmac.finish with (H = H)(take state)
    previous = []
    let mut i: u64 = 0
    while i < H.bytes {
      core@1/list.push(mut previous, block[i])
      if core@1/list.len(out) < length {
        core@1/list.push(mut out, block[i])
      }
      i += 1
    }
    counter = core@1/int.wrapping_add(counter, 1)
  }
  core@1/bytes.from_list(take out)
}

// extract then expand.
pub fn derive[H: implementation std@1/digest.Digest](
  salt: Bytes,
  secret: Bytes,
  info: Bytes,
  length: u64
) -> unique Bytes uses {} {
  expand with (H = H)(
    std@1/bytes.from_inline(extract with (H = H)(salt, secret)),
    info,
    length
  )
}
