// a * b + c modulo L for 32-byte little-endian a, b and c.
@noalloc
pub fn scalar_mul_add(a: Inline[u8, 32], b: Inline[u8, 32], c: Inline[u8, 32]) -> Inline[
  u8,
  32
] uses {} {
  let mut x: Inline[i64, 64] = [
    0i64,
    0i64,
    0i64,
    0i64,
    0i64,
    0i64,
    0i64,
    0i64,
    0i64,
    0i64,
    0i64,
    0i64,
    0i64,
    0i64,
    0i64,
