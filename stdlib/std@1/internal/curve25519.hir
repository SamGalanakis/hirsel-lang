    0i64,
    0i64,
    0i64,
    0i64,
    0i64,
    0i64,
    0i64,
    0i64,
    0i64,
    0i64,
    0i64,
    0i64,
    0i64,
    0i64,
    0i64,
    0i64,
    0i64,
    0i64,
    0i64,
    0i64,
    0i64,
    0i64,
    0i64,
    0i64,
    0i64,
    0i64,
    0i64,
    0i64,
    0i64,
    0i64,
    0i64,
    0i64,
    0i64,
    0i64,
    0i64,
    0i64,
    0i64,
    0i64,
    0i64,
    0i64,
    0i64
  ]
  let mut i: u64 = 0
  while i < 32 {
    x[i] = core@1/int.widen(c[i])
    i += 1
  }
  i = 0
  while i < 32 {
    let ai: i64 = core@1/int.widen(a[i])
    let mut j: u64 = 0
    while j < 32 {
      let bj: i64 = core@1/int.widen(b[j])
      x[i + j] += ai * bj
      j += 1
    }
    i += 1
  }
  mod_l(mut x)
}

// Whether the 32 bytes at `at` are a little-endian scalar below L.
pub fn scalar_canonical_public(data: Bytes, at: u64) -> bool uses {} {
  let mut i: u64 = 32
  while i > 0 {
    i -= 1
    let byte: i64 = core@1/int.widen(data[at + i])
    if byte != L[i] {
      return byte < L[i]
    }
  }
  false
}
