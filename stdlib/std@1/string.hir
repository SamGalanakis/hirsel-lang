@noalloc
fn piece(s: String, start: u64, end: u64) -> String in s uses {} {
  match core@1/string.position(s, start) {
    Some(a) => match core@1/string.position(s, end) {
      Some(b) => core@1/string.slice(s, a, b),
      None() => {
        core@1/failure.check(false, TextInvariant())
        s
      },
    },
    None() => {
      core@1/failure.check(false, TextInvariant())
      s
    },
  }
}

// Nonoverlapping substring delimiter; preserve leading, trailing and empty fields.
pub fn split(take s: String, separator: String) -> List[String] uses {} {
  let source = core@1/string.as_bytes(s)
  let delimiter = core@1/string.as_bytes(separator)
  let len = core@1/bytes.len(source)
  let width = core@1/bytes.len(delimiter)
  core@1/failure.check(width != 0, TextInvariant())
  let mut parts: List[String] = []
  let mut begin: u64 = 0
  let plan = internal.substring.prepare(delimiter)
  let mut searching = true
  while searching {
    match internal.substring.find_from(source, delimiter, plan, begin) {
      Some(at) => {
        core@1/list.push(mut parts, piece(s, begin, at))
        begin = at + width
      },
      None() => {
        searching = false
      },
    }
  }
  core@1/list.push(mut parts, piece(s, begin, len))
  take parts
}

// Rust str::split_ascii_whitespace: split on ASCII whitespace, omit empty
// fields. ASCII delimiters cannot split a UTF-8 scalar. Vertical tab is not
// ASCII whitespace under this API (unlike this module's trim policy).
@noalloc
fn ascii_whitespace(byte: u8) -> bool uses {} {
  std@1/ascii.is_space(byte) && byte != 11
}

pub fn split_ascii_whitespace(take s: String) -> List[String] uses {} {
  let source = core@1/string.as_bytes(s)
  let len = core@1/bytes.len(source)
  let mut parts: List[String] = []
  let mut i: u64 = 0
  while i < len {
    while i < len && ascii_whitespace(source[i]) {
      i += 1
    }
    let begin = i
    while i < len && !ascii_whitespace(source[i]) {
      i += 1
    }
    if begin < i {
      core@1/list.push(mut parts, piece(s, begin, i))
    }
  }
  take parts
}

// Byte matching is safe for UTF-8: a nonempty valid pattern cannot start at
// a continuation byte. Offsets and positions remain relative to this slice.
@noalloc
fn matches_at(source: Bytes, pattern: Bytes, offset: u64) -> bool uses {} {
  let len = core@1/bytes.len(source)
  let width = core@1/bytes.len(pattern)
  if offset > len || width > len - offset {
    return false
  }
  let mut i: u64 = 0
  while i < width {
    if source[offset + i] != pattern[i] {
      return false
    }
    i += 1
  }
  true
}

@noalloc
pub fn find(s: String, pattern: String) -> Option[StrPos of s] uses {} {
  let source = core@1/string.as_bytes(s)
  let needle = core@1/string.as_bytes(pattern)
  let plan = internal.substring.prepare(needle)
  match internal.substring.find_from(source, needle, plan, 0) {
    Some(at) => core@1/string.position(s, at),
    None() => None(),
  }
}

// Rust str::split_once: the text before and after the first separator match.
// An empty separator matches at the start, as in Rust and `find`.
@noalloc
pub fn split_once(s: String, separator: String) -> Option[(String, String)] in s uses {} {
  match find(s, separator) {
    Some(at) => {
      let start = core@1/string.byte_offset(s, at)
      let end = start + core@1/string.byte_len(separator)
      Some((piece(s, 0, start), piece(s, end, core@1/string.byte_len(s))))
    },
    None() => None(),
  }
}

@noalloc
pub fn starts_with(s: String, pattern: String) -> bool uses {} {
  matches_at(core@1/string.as_bytes(s), core@1/string.as_bytes(pattern), 0)
}

@noalloc
pub fn ends_with(s: String, pattern: String) -> bool uses {} {
  let len = core@1/string.byte_len(s)
  let width = core@1/string.byte_len(pattern)
  width <= len && matches_at(
    core@1/string.as_bytes(s),
    core@1/string.as_bytes(pattern),
    len - width
  )
}

@noalloc
pub fn trim(s: String) -> String in s uses {} {
  let source = core@1/string.as_bytes(s)
  let mut begin: u64 = 0
  let mut end = core@1/bytes.len(source)
  while begin < end && std@1/ascii.is_space(source[begin]) {
    begin += 1
  }
  while begin < end && std@1/ascii.is_space(source[end - 1]) {
    end -= 1
  }
  piece(s, begin, end)
}

// Builders below only append valid UTF-8 or change one ASCII byte to another.
fn ascii_case(s: String, lower: bool) -> String uses {} {
  let source = core@1/string.as_bytes(s)
  let mut builder: List[u8] = []
  core@1/list.reserve(mut builder, core@1/bytes.len(source))
  let mut i: u64 = 0
  while i < core@1/bytes.len(source) {
    let byte = source[i]
    let converted = if lower {
      std@1/ascii.to_lower(byte)
    } else {
      std@1/ascii.to_upper(byte)
    }
    core@1/list.push(mut builder, core@1/int.narrow(converted))
    i += 1
  }
  text.finish_valid(take builder)
}

pub fn ascii_lower(s: String) -> unique String uses {} {
  ascii_case(s, true)
}

pub fn ascii_upper(s: String) -> unique String uses {} {
  ascii_case(s, false)
}

// Rust str Ord: byte-lexicographic, a proper prefix first, as `<` orders
// String. Returns -1, 0 or 1, the comparator shape list.sort takes.
@noalloc
pub fn compare(a: String, b: String) -> i32 uses {} {
  if a < b {
    -1
  } else if b < a {
    1
  } else {
    0
  }
}

pub fn concat(a: String, b: String) -> unique String uses {} {
  let mut builder: List[u8] = []
  text.append(mut builder, a)
  text.append(mut builder, b)
  text.finish_valid(take builder)
}

pub fn join(parts: List[String], separator: String) -> unique String uses {} {
  let mut builder: List[u8] = []
  let mut i: u64 = 0
  while i < core@1/list.len(parts) {
    if i != 0 {
      text.append(mut builder, separator)
    }
    text.append(mut builder, parts[i])
    i += 1
  }
  text.finish_valid(take builder)
}

@noalloc
pub fn contains(s: String, pattern: String) -> bool uses {} {
  // Rust Pattern for &str::is_contained_in, pattern.rs:989-1017 at
  // a7c37f9f0ee5e93396106e9de20f4a86b4154e63: resolve empty, equal and
  // longer needles before constructing a Two-Way searcher.
  if core@1/string.byte_len(pattern) == 0 {
    return true
  }
  if core@1/string.byte_len(pattern) >= core@1/string.byte_len(s) {
    return s == pattern
  }
  match find(s, pattern) {
    Some(_) => true,
    None() => false,
  }
}

// Rust str::lines: only LF and CRLF terminate lines; omit a final empty line.
pub fn lines(take s: String) -> List[String] uses {} {
  let data = core@1/string.as_bytes(s)
  let len = core@1/bytes.len(data)
  let mut out: List[String] = []
  let mut begin: u64 = 0
  let mut i: u64 = 0
  while i < len {
    if data[i] == 10 {
      let end = if i > begin && data[i - 1] == 13 {
        i - 1
      } else {
        i
      }
      core@1/list.push(mut out, piece(s, begin, end))
      begin = i + 1
    }
    i += 1
  }
  if begin < len {
    core@1/list.push(mut out, piece(s, begin, len))
  }
  take out
}

pub fn replace(s: String, old: String, new: String) -> unique String uses {} {
  let source = core@1/string.as_bytes(s)
  let needle = core@1/string.as_bytes(old)
  let width = core@1/bytes.len(needle)
  let len = core@1/bytes.len(source)
  let mut out: List[u8] = []
  let mut i: u64 = 0
  if width == 0 {
    text.append(mut out, new)
    while i < len {
      core@1/list.push(mut out, source[i])
      i += 1
      if i == len || source[i] < 128 || source[i] >= 192 {
        text.append(mut out, new)
      }
    }
  } else {
    let plan = internal.substring.prepare(needle)
    let mut searching = true
    while searching {
      match internal.substring.find_from(source, needle, plan, i) {
        Some(at) => {
          text.append(mut out, piece(s, i, at))
          text.append(mut out, new)
          i = at + width
        },
        None() => {
          text.append(mut out, piece(s, i, len))
          searching = false
        },
      }
    }
  }
  text.finish_valid(take out)
}

// Rust str::rfind, pattern.rs:1635-1718. Mirroring bytes retains UTF-8 match
// boundaries, since only complete valid string patterns are accepted here.
@noalloc
pub fn rfind(s: String, pattern: String) -> Option[StrPos of s] uses {} {
  let source = core@1/string.as_bytes(s)
  let needle = core@1/string.as_bytes(pattern)
  let plan = internal.substring.prepare_reverse(needle)
  match internal.substring.find_from(source, needle, plan, 0) {
    Some(at) => core@1/string.position(
      s,
      core@1/bytes.len(source) - at - core@1/bytes.len(needle)
    ),
    None() => None(),
  }
}

// Rust str::rsplitn, alloctests/tests/str.rs:1498-1510. As with split,
// Hirsel requires a nonempty delimiter. A zero limit yields no fields.
// Rust core/src/str/iter.rs:937-967 uses the same remaining-count state.
pub fn rsplitn(take s: String, separator: String, limit: u64) -> List[String] uses {} {
  let source = core@1/string.as_bytes(s)
  let needle = core@1/string.as_bytes(separator)
  let len = core@1/bytes.len(source)
  let width = core@1/bytes.len(needle)
  core@1/failure.check(width != 0, TextInvariant())
  let mut parts: List[String] = []
  if limit != 0 {
    let plan = internal.substring.prepare_reverse(needle)
    let mut begin: u64 = 0
    let mut remaining = limit
    while remaining > 1 {
      match internal.substring.find_from(source, needle, plan, begin) {
        Some(at) => {
          core@1/list.push(mut parts, piece(s, len - at, len - begin))
          begin = at + width
          remaining -= 1
        },
        None() => break,
      }
    }
    core@1/list.push(mut parts, piece(s, 0, len - begin))
  }
  take parts
}

pub fn rsplit(take s: String, separator: String) -> List[String] uses {} {
  rsplitn(take s, separator, 18446744073709551615u64)
}

@noalloc
pub fn rsplit_once(s: String, separator: String) -> Option[(String, String)] in s uses {} {
  match rfind(s, separator) {
    Some(at) => {
      let start = core@1/string.byte_offset(s, at)
      Some(
        (
          piece(s, 0, start),
          piece(s, start + core@1/string.byte_len(separator), core@1/string.byte_len(s))
        )
      )
    },
    None() => None(),
  }
}

// Rust str::split_whitespace, alloctests/tests/str.rs:1536-1540.
// Unicode White_Space is tested per scalar; returned slices borrow the source.
pub fn split_whitespace(take s: String) -> List[String] uses {} {
  let mut parts: List[String] = []
  let mut begin: u64 = 0
  let mut offset: u64 = 0
  for c in core@1/string.scalars(s) {
    let cp = core@1/char.to_u32(c)
    let width: u64 = if cp < 128 {
      1
    } else if cp < 2048 {
      2
    } else if cp < 65536 {
      3
    } else {
      4
    }
    if unicode.is_whitespace(c) {
      if begin < offset {
        core@1/list.push(mut parts, piece(s, begin, offset))
      }
      begin = offset + width
    }
    offset += width
  }
  if begin < offset {
    core@1/list.push(mut parts, piece(s, begin, offset))
  }
  take parts
}

// Rust a7c37f9f0ee5e93396106e9de20f4a86b4154e63,
// library/core/src/str/iter.rs:937-951 (MIT): SplitN remaining-count state.
// As with split and rsplitn, validate the separator even for a zero limit.
pub fn splitn(take s: String, separator: String, limit: u64) -> List[String] uses {} {
  let source = core@1/string.as_bytes(s)
  let delimiter = core@1/string.as_bytes(separator)
  let len = core@1/bytes.len(source)
  let width = core@1/bytes.len(delimiter)
  core@1/failure.check(width != 0, TextInvariant())
  let mut parts: List[String] = []
  if limit != 0 {
    let plan = internal.substring.prepare(delimiter)
    let mut begin: u64 = 0
    let mut remaining = limit
    while remaining > 1 {
      match internal.substring.find_from(source, delimiter, plan, begin) {
        Some(at) => {
          core@1/list.push(mut parts, piece(s, begin, at))
          begin = at + width
          remaining -= 1
        },
        None() => break,
      }
    }
    core@1/list.push(mut parts, piece(s, begin, len))
  }
  take parts
}
