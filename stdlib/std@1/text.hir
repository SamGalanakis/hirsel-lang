// An ordinary List[u8] is the UTF-8 builder.
@preserves_unique(builder)
pub fn append(mut builder: List[u8], text: String) -> () uses {} {
  let data = core@1/string.as_bytes(text)
  let mut i: u64 = 0
  while i < core@1/bytes.len(data) {
    core@1/list.push(mut builder, data[i])
    i += 1
  }
}

@preserves_unique(builder)
pub fn finish(take builder: List[u8]) -> Result[String, Bytes] uses {} {
  core@1/string.from_bytes(core@1/bytes.from_list(take builder))
}

// The text that appends through the formatting protocol left in an empty
// builder: `format_into` and `append` only add valid UTF-8, so every
// `to_string` and every f-string finishes here; invalid bytes fail TextInvariant.
@preserves_unique(builder)
@track_caller
pub fn finish_valid(take builder: List[u8]) -> String uses {} {
  match finish(take builder) {
    Ok(text) => take text,
    Error(_) => {
      core@1/failure.check(false, TextInvariant())
      ""
    },
  }
}

// Pads the text appended to `out` since byte `start` to `width` display cells,
// left-aligned by default: an f-string hole of String, bool or a type with
// @format whose only options are fill, alignment and width.
@preserves_unique(out)
pub fn pad_from(start: u64, fill: char, align: u64, width: u64, mut out: List[u8]) -> () uses {} {
  internal.format.pad_from(start, fill, align, width, false, mut out)
}

// The same, right-aligned by default: an integer or float hole.
@preserves_unique(out)
pub fn pad_number_from(
  start: u64,
  fill: char,
  align: u64,
  width: u64,
  mut out: List[u8]
) -> () uses {} {
  internal.format.pad_from(start, fill, align, width, true, mut out)
}

// Precision retains the longest prefix of whole clusters that fits in cells.
@preserves_unique(out)
pub fn format_into_spec(
  value: String,
  fill: char,
  align: u64,
  width: u64,
  precision: u64,
  flags: u64,
  kind: u64,
  mut out: List[u8]
) -> () uses {} {
  let mut count: u64 = 0
  for cluster in unicode.graphemes(value) {
    let cells = cluster_width(cluster)
    if flags & 8 != 0 && cells > precision - count {
      break
    }
    count += cells
  }
  let (left, right) = internal.format.padding(width, count, align, false)
  internal.format.repeat(mut out, fill, left)
  let mut at: u64 = 0
  for cluster in unicode.graphemes(value) {
    if at == count {
      break
    }
    append(mut out, cluster)
    at += cluster_width(cluster)
  }
  internal.format.repeat(mut out, fill, right)
}
