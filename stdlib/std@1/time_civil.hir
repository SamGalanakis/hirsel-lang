// Civil (zone-free) calendar types and the day-count algorithms they share.
// Day counts adapt Howard Hinnant's days_from_civil and civil_from_days
// ("chrono-Compatible Low-Level Date Algorithms", public domain), as jiff's
// civil::Date does (third-party/NOTICES.md). Years span -9999..=9999, jiff's range.
// A proleptic Gregorian date. date.new validates every field, and so does decoding.
@format(date.format_into)
@serializable(check = decoded_date)
pub opaque type Date: plain + key + sendable + inert + noalloc_drop uses {} {
  year: i32,
  month: u8,
  day: u8,
}

// A wall-clock time of day with nanosecond precision and no leap second.
@format(time_of_day.format_into)
@serializable(check = decoded_time)
pub opaque type TimeOfDay: plain + key + sendable + inert + noalloc_drop uses {} {
  hour: u8,
  minute: u8,
  second: u8,
  nanosecond: u32,
}

// A date and a time of day with no time zone or offset.
@format(date_time.format_into)
@serializable
pub type DateTime {
  date: Date,
  time: TimeOfDay,
}

@serializable
pub type Weekday = Monday | Tuesday | Wednesday | Thursday | Friday | Saturday | Sunday

// The ISO 8601 week-numbering year and its week, 1 through 52 or 53.
@serializable
pub type IsoWeek {
  year: i32,
  week: u8,
}

// What month and year arithmetic does with a day past the target month's end.
@serializable
pub type Overflow = Clamp | Reject

@serializable
pub type CalendarError = OutOfRange | NoSuchDay

const MIN_YEAR: i32 = -9999

const MAX_YEAR: i32 = 9999

// days_from_civil(-9999, 1, 1) and days_from_civil(9999, 12, 31).
const MIN_EPOCH_DAY: i64 = -4371587

const MAX_EPOCH_DAY: i64 = 2932896

const NANOS_PER_SECOND: i128 = 1000000000

const NANOS_PER_DAY: i128 = 86400000000000

// One more than jiff's largest offset, 25:59:59.
const OFFSET_LIMIT: i32 = 93600

@noalloc
fn is_leap(year: i32) -> bool uses {} {
  year % 4 == 0 && (year % 100 != 0 || year % 400 == 0)
}

@noalloc
fn days_in_month(year: i32, month: u8) -> u8 uses {} {
  if month == 2 {
    if is_leap(year) {
      29
    } else {
      28
    }
  } else if month == 4 || month == 6 || month == 9 || month == 11 {
    30
  } else {
    31
  }
}

@noalloc
fn days_in_year(year: i32) -> u16 uses {} {
  if is_leap(year) {
    366
  } else {
    365
  }
}

@noalloc
fn valid_date(year: i32, month: u8, day: u8) -> bool uses {} {
  year >= MIN_YEAR && year <= MAX_YEAR && month >= 1 && month <= 12 && day >= 1 && day <= days_in_month(
    year,
    month
  )
}

// A decoded Date's fields are those date.new admits.
@noalloc
fn decoded_date(value: Date) -> bool uses {} {
  valid_date(value.year, value.month, value.day)
}

// A decoded TimeOfDay's fields are those time_of_day.new admits.
@noalloc
fn decoded_time(value: TimeOfDay) -> bool uses {} {
  value.hour <= 23 && value.minute <= 59 && value.second <= 59 && value.nanosecond <= 999999999
}

// Hinnant days_from_civil: days since 1970-01-01 of a valid date.
@noalloc
fn days_from_civil(year: i32, month: u8, day: u8) -> i64 uses {} {
  let wide_month: i64 = core@1/int.widen(month)
  let wide_day: i64 = core@1/int.widen(day)
  let mut y: i64 = core@1/int.widen(year)
  if month <= 2 {
    y -= 1
  }
  let era = core@1/int.div_floor(y, 400)
  let yoe = y - era * 400
  let shifted = if month > 2 {
    wide_month - 3
  } else {
    wide_month + 9
  }
  let doy = (153 * shifted + 2) / 5 + wide_day - 1
  let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy
  era * 146097 + doe - 719468
}

// Hinnant civil_from_days for any day in MIN_EPOCH_DAY..=MAX_EPOCH_DAY.
@noalloc
fn civil_from_days(days: i64) -> Date uses {} {
  let z = days + 719468
  let era = core@1/int.div_floor(z, 146097)
  let doe = z - era * 146097
  let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
  let doy = doe - (365 * yoe + yoe / 4 - yoe / 100)
  let mp = (5 * doy + 2) / 153
  let day = doy - (153 * mp + 2) / 5 + 1
  let month = if mp < 10 {
    mp + 3
  } else {
    mp - 9
  }
  let mut year = yoe + era * 400
  if month <= 2 {
    year += 1
  }
  Date(
    year: core@1/int.narrow(year),
    month: core@1/int.narrow(month),
    day: core@1/int.narrow(day)
  )
}

@noalloc
fn date_from_days(days: i64) -> Option[Date] uses {} {
  if days < MIN_EPOCH_DAY || days > MAX_EPOCH_DAY {
    None()
  } else {
    Some(civil_from_days(days))
  }
}

@noalloc
fn epoch_day(value: Date) -> i64 uses {} {
  days_from_civil(value.year, value.month, value.day)
}

// ISO weekday number, Monday 1 through Sunday 7; 1970-01-01 was a Thursday.
@noalloc
fn iso_weekday(days: i64) -> i64 uses {} {
  core@1/int.mod(days + 3, 7) + 1
}

@noalloc
fn weekday_of(number: i64) -> Weekday uses {} {
  match number {
    1 => Monday(),
    2 => Tuesday(),
    3 => Wednesday(),
    4 => Thursday(),
    5 => Friday(),
    6 => Saturday(),
    _ => Sunday(),
  }
}

@noalloc
fn weekday_number(value: Weekday) -> i64 uses {} {
  match value {
    Monday => 1,
    Tuesday => 2,
    Wednesday => 3,
    Thursday => 4,
    Friday => 5,
    Saturday => 6,
    Sunday => 7,
  }
}

@noalloc
fn ordinal_of(value: Date) -> u16 uses {} {
  let first = days_from_civil(value.year, 1, 1)
  let ordinal: u16 = core@1/int.narrow(epoch_day(value) - first + 1)
  ordinal
}

// ISO 8601 years have 53 weeks when they begin on a Thursday, or on a
// Wednesday in a leap year (jiff civil::ISOWeekDate).
@noalloc
fn iso_weeks_in_year(year: i32) -> u8 uses {} {
  let first = iso_weekday(days_from_civil(year, 1, 1))
  if first == 4 || first == 3 && is_leap(year) {
    53
  } else {
    52
  }
}

@noalloc
fn seconds_of_day(value: TimeOfDay) -> i64 uses {} {
  let hour: i64 = core@1/int.widen(value.hour)
  let minute: i64 = core@1/int.widen(value.minute)
  let second: i64 = core@1/int.widen(value.second)
  hour * 3600 + minute * 60 + second
}

@noalloc
fn time_from_nanos(nanos: i128) -> TimeOfDay uses {} {
  let seconds = nanos / NANOS_PER_SECOND
  TimeOfDay(
    hour: core@1/int.narrow(seconds / 3600),
    minute: core@1/int.narrow(seconds / 60 % 60),
    second: core@1/int.narrow(seconds % 60),
    nanosecond: core@1/int.narrow(nanos % NANOS_PER_SECOND)
  )
}

// Nanoseconds since 1970-01-01T00:00:00 of the same civil frame.
@noalloc
fn local_nanos(value: DateTime) -> i128 uses {} {
  let days: i128 = core@1/int.widen(epoch_day(value.date))
  let seconds: i128 = core@1/int.widen(seconds_of_day(value.time))
  let fraction: i128 = core@1/int.widen(value.time.nanosecond)
  days * NANOS_PER_DAY + seconds * NANOS_PER_SECOND + fraction
}

@noalloc
fn datetime_from_local_nanos(nanos: i128) -> Result[DateTime, TimeError] uses {} {
  let days = core@1/int.div_floor(nanos, NANOS_PER_DAY)
  let narrowed: Option[i64] = core@1/int.try_narrow(days)
  let Some(day) = narrowed else {
    return Error(OutOfRange())
  }
  let Some(date) = date_from_days(day) else {
    return Error(OutOfRange())
  }
  Ok(DateTime(date: date, time: time_from_nanos(core@1/int.mod(nanos, NANOS_PER_DAY))))
}

@noalloc
fn valid_offset(offset: i32) -> bool uses {} {
  offset > -OFFSET_LIMIT && offset < OFFSET_LIMIT
}

@noalloc
fn offset_nanos(offset: i32) -> i128 uses {} {
  let wide: i128 = core@1/int.widen(offset)
  wide * NANOS_PER_SECOND
}

// ISO 8601 extended calendar date at `start`: YYYY-MM-DD, or a sign and six
// year digits; returns the date and the index after it.
@noalloc
fn scan_date(bytes: Bytes, start: u64) -> Result[(Date, u64), scalar.ParseError] uses {} {
  let len = core@1/bytes.len(bytes)
  let mut i = start
  let mut negative = false
  let mut width: u64 = 4
  if i < len && (bytes[i] == b'+' || bytes[i] == b'-') {
    negative = bytes[i] == b'-'
    width = 6
    i += 1
  }
  if len - i < width + 6 || bytes[i + width] != b'-' || bytes[i + width + 3] != b'-' {
    return Error(Invalid())
  }
  let magnitude = read_digits(bytes, i, width)?
  if negative && magnitude == 0 {
    return Error(Invalid())
  }
  let month = read_digits(bytes, i + width + 1, 2)?
  let day = read_digits(bytes, i + width + 4, 2)?
  if magnitude > 9999 {
    return Error(OutOfRange())
  }
  let wide_year = if negative {
    -magnitude
  } else {
    magnitude
  }
  let year: i32 = core@1/int.narrow(wide_year)
  if month < 1 || month > 12 || day < 1 || day > 31 {
    return Error(Invalid())
  }
  let small_month: u8 = core@1/int.narrow(month)
  let small_day: u8 = core@1/int.narrow(day)
  if !valid_date(year, small_month, small_day) {
    return Error(Invalid())
  }
  Ok((Date(year: year, month: small_month, day: small_day), i + width + 6))
}

// HH:MM or HH:MM:SS with an optional dot and one to nine fraction digits.
@noalloc
fn scan_time(bytes: Bytes, start: u64) -> Result[(TimeOfDay, u64), scalar.ParseError] uses {} {
  let len = core@1/bytes.len(bytes)
  if len - start < 5 || bytes[start + 2] != b':' {
    return Error(Invalid())
  }
  let hour = read_digits(bytes, start, 2)?
  let minute = read_digits(bytes, start + 3, 2)?
  let mut second: i128 = 0
  let mut fraction: i128 = 0
  let mut i = start + 5
  if i < len && bytes[i] == b':' {
    if len - i < 3 {
      return Error(Invalid())
    }
    second = read_digits(bytes, i + 1, 2)?
    i += 3
    if i < len && bytes[i] == b'.' {
      i += 1
      let mut digits: u64 = 0
      while i < len && bytes[i] >= b'0' && bytes[i] <= b'9' {
        if digits == 9 {
          return Error(Invalid())
        }
        let digit: i128 = core@1/int.widen(bytes[i] - b'0')
        fraction = fraction * 10 + digit
        digits += 1
        i += 1
      }
      if digits == 0 {
        return Error(Invalid())
      }
      while digits < 9 {
        fraction *= 10
        digits += 1
      }
    }
  }
  if hour > 23 || minute > 59 || second > 59 {
    return Error(Invalid())
  }
  Ok(
    (
      TimeOfDay(
        hour: core@1/int.narrow(hour),
        minute: core@1/int.narrow(minute),
        second: core@1/int.narrow(second),
        nanosecond: core@1/int.narrow(fraction)
      ),
      i
    )
  )
}

// A dot and the fraction of a second with its trailing zeros trimmed; nothing for zero.
@preserves_unique(out)
fn write_fraction(mut out: List[u8], nanosecond: u32) -> () uses {} {
  if nanosecond != 0 {
    core@1/list.push(mut out, b'.')
    write_fraction_digits(mut out, nanosecond)
  }
}

// The digits of a nonzero fraction of a second, trailing zeros trimmed.
fn write_fraction_digits(mut out: List[u8], nanosecond: u32) -> () uses {} {
  let mut fraction = nanosecond
  let mut divisor: u32 = 100000000
  while fraction != 0 {
    let digit: u8 = core@1/int.narrow(fraction / divisor)
    core@1/list.push(mut out, digit + b'0')
    fraction %= divisor
    divisor /= 10
  }
}

// JSON derive resolves nominal hooks in the type's declaring module.
pub fn date_to_json(value: Date) -> json.Value uses {} {
  date.to_json(value)
}

pub fn date_from_json(value: json.Value) -> Result[Date, String] uses {} {
  date.from_json(value)
}

@preserves_unique(out)
pub fn date_json_into(value: Date, mut out: List[u8], depth: u64) -> Result[
  (),
  json.JsonError
] uses {} {
  date.json_into(value, mut out, depth)
}

pub fn date_from_json_reader(mut cursor: json.Reader) -> Result[Date, String] uses {} {
  date.from_json_reader(mut cursor)
}
