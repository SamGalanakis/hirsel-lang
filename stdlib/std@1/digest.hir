// A cryptographic hash as a static implementation contract (GEN-6), like Go's
// hash.Hash constructor argument to crypto/hmac: HMAC, HKDF and PBKDF2 take an
// implementation of it and call its operations directly.
pub signature Digest {
  type State: plain + inert uses {}
  size bytes
  size block
  fn new() -> State uses {}
  fn update(mut state: State, data: Bytes) -> () uses {}
  fn finish(take state: State) -> Inline[u8, bytes] uses {}
}
