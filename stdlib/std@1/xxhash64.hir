// github.com/cespare/xxhash/v2 xxhash.go (MIT): XXH64, a fast non-cryptographic hash
// for checksums, deduplication and hash tables. It is not collision resistant
// against an adversary. Multiplications wrap at 64 bits.
pub opaque type State: plain + inert uses {} {
  lanes: Inline[u64, 4],
  total: u64,
  mem: Inline[u8, 32],
  used: u64,
}

const PRIME1: u64 = 11400714785074694791

const PRIME2: u64 = 14029467366897019727

const PRIME3: u64 = 1609587929392839161

const PRIME4: u64 = 9650029242287828579

const PRIME5: u64 = 2870177450012600261

@noalloc
pub fn new() -> State uses {} {
  new_with_seed(0)
}

@noalloc
pub fn new_with_seed(seed: u64) -> State uses {} {
  State(
    lanes: [
      core@1/int.wrapping_add(core@1/int.wrapping_add(seed, PRIME1), PRIME2),
      core@1/int.wrapping_add(seed, PRIME2),
      seed,
      std@1/u64.wrapping_sub(seed, PRIME1)
    ],
    total: 0,
    mem: [
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8
    ],
    used: 0
  )
}

@noalloc
fn rotl(value: u64, bits: u64) -> u64 uses {} {
  value << bits | value >> 64u64 - bits
}

@noalloc
fn mul(a: u64, b: u64) -> u64 uses {} {
  std@1/u64.wrapping_mul(a, b)
}

@noalloc
fn round(acc: u64, input: u64) -> u64 uses {} {
  mul(rotl(core@1/int.wrapping_add(acc, mul(input, PRIME2)), 31), PRIME1)
}

@noalloc
fn merge_round(acc: u64, value: u64) -> u64 uses {} {
  core@1/int.wrapping_add(mul(acc ^ round(0, value), PRIME1), PRIME4)
}

// The little-endian word of `count` bytes at `at`.
@noalloc
fn word(mem: Inline[u8, 32], at: u64, count: u64) -> u64 uses {} {
  let mut value: u64 = 0
  let mut j = count
  while j > 0 {
    j -= 1
    let byte: u64 = core@1/int.widen(mem[at + j])
    value = value << 8 | byte
  }
  value
}

// Shared byte absorption for byte slices and list suffixes. The caller counts
// its input length once; this helper only fills and compresses complete stripes.
@noalloc
fn absorb(mut state: State, byte: u8) -> () uses {} {
  state.mem[state.used] = byte
  state.used += 1
  if state.used == 32 {
    let mut lane: u64 = 0
    while lane < 4 {
      state.lanes[lane] = round(state.lanes[lane], word(state.mem, lane * 8, 8))
      lane += 1
    }
    state.used = 0
  }
}

@noalloc
pub fn update(mut state: State, data: Bytes) -> () uses {} {
  let len = core@1/bytes.len(data)
  state.total = core@1/int.wrapping_add(state.total, len)
  let mut i: u64 = 0
  while i < len {
    absorb(mut state, data[i])
    i += 1
  }
}

/// Absorb the byte-list suffix starting at start, without copying its storage.
/// A start at or beyond the end is an empty update, as crc32.update_list.
@noalloc
pub fn update_list(mut state: State, data: List[u8], start: u64) -> () uses {} {
  let end = core@1/list.len(data)
  if start >= end {
    return
  }
  state.total = core@1/int.wrapping_add(state.total, end - start)
  let mut i = start
  while i < end {
    absorb(mut state, data[i])
    i += 1
  }
}

@noalloc
pub fn finish(take state: State) -> u64 uses {} {
  let mut h: u64 = 0
  if state.total >= 32 {
    let v1 = state.lanes[0]
    let v2 = state.lanes[1]
    let v3 = state.lanes[2]
    let v4 = state.lanes[3]
    h = core@1/int.wrapping_add(
      core@1/int.wrapping_add(rotl(v1, 1), rotl(v2, 7)),
      core@1/int.wrapping_add(rotl(v3, 12), rotl(v4, 18))
    )
    h = merge_round(h, v1)
    h = merge_round(h, v2)
    h = merge_round(h, v3)
    h = merge_round(h, v4)
  } else {
    h = core@1/int.wrapping_add(state.lanes[2], PRIME5)
  }
  h = core@1/int.wrapping_add(h, state.total)
  let mut at: u64 = 0
  while at + 8 <= state.used {
    h = h ^ round(0, word(state.mem, at, 8))
    h = core@1/int.wrapping_add(mul(rotl(h, 27), PRIME1), PRIME4)
    at += 8
  }
  if at + 4 <= state.used {
    h = h ^ mul(word(state.mem, at, 4), PRIME1)
    h = core@1/int.wrapping_add(mul(rotl(h, 23), PRIME2), PRIME3)
    at += 4
  }
  while at < state.used {
    let byte: u64 = core@1/int.widen(state.mem[at])
    h = h ^ mul(byte, PRIME5)
    h = mul(rotl(h, 11), PRIME1)
    at += 1
  }
  h = h ^ h >> 33
  h = mul(h, PRIME2)
  h = h ^ h >> 29
  h = mul(h, PRIME3)
  h ^ h >> 32
}

@noalloc
pub fn digest(data: Bytes) -> u64 uses {} {
  let mut state = new()
  update(mut state, data)
  finish(take state)
}

pub fn digest_hex(data: Bytes) -> unique String uses {} {
  let value = digest(data)
  f"{value:016x}"
}
