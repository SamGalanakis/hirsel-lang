// Ordered lazy determinization adapted from rust-lang/regex
// 80b9d14e4be9f0b703a742d11c064abce05f210b:
// util/determinize/mod.rs:350-490, hybrid/search.rs:13-210,
// hybrid/regex.rs:442-505, hybrid/dfa.rs:2119-2171,3460-3729.
// Copyright 2014 The Rust Project Developers; MIT, third-party/NOTICES.md.
// Keys, transitions, intern buckets and DFS scratch occupy one primitive slab.
// No cache handle or partially determined match escapes to a public caller.
type DfaCache {
  data: unique List[u64],
  size: u64,
  seen: u64,
  stack: u64,
  ready: u64,
  next: u64,
  buckets: u64,
  limit: u64,
  disabled: bool,
  scalar_fallback: bool,
  misses: u64,
  fallbacks: u64,
  resume_at: u64,
  scalar_steps: u64,
  scalar_forward_steps: u64,
  used: u64,
  clears: u64,
  states: u64,
  searched: u64,
}

type DfaResult = DfaMatch(Span) | DfaMiss | DfaQuit

// Pattern-only eligibility; assertions and nullable patterns are supported.
// The public 2 MiB ceiling includes allocator metadata. This implementation
// uses <=512 KiB payload, leaving >1 MiB for size-class/header rounding and
// scalar metadata. reserve is issued once from an empty unique list; length
// never reaches the reserved capacity, so no geometric growth or detachment.
fn dfa_cache(re: Regex, enabled: bool, limit: u64) -> DfaCache uses {} {
  // Bound layout arithmetic before multiplying program length. Large programs
  // remain entirely on PikeVM, including callers that force engine selection.
  let instructions = core@1/list.len(re.code)
  let m = if instructions > 512 { 0u64 } else { instructions }
  let seen = 0u64
  let stack = m
  let ready = stack + 2 * m + 2
  let next = ready + m
  let buckets = next + m
  let initial = buckets + 1024
  let cap = if limit < 65024 { limit } else { 65024u64 }
  let data: unique List[u64] = []
  let disabled = !enabled || instructions > 512 || initial + 140 + m > cap
  DfaCache(data: take data, size: m, seen: seen, stack: stack,
    ready: ready, next: next, buckets: buckets, limit: cap,
    disabled: disabled, scalar_fallback: false, misses: 0, fallbacks: 0,
    resume_at: 0, scalar_steps: 0, scalar_forward_steps: 0, used: initial, clears: 0, states: 0, searched: 0)
}

fn dfa_category(byte: u64) -> u64 uses {} {
  if byte == 128 { 0u64 }
  else if byte == 10 { 2u64 }
  else if byte >= 48 && byte <= 57 || byte >= 65 && byte <= 90 || byte == 95 || byte >= 97 && byte <= 122 { 1u64 }
  else { 3u64 }
}

fn dfa_allowed(kind: u8, left: u64, right: u64) -> bool uses {} {
  kind == 0 || kind == 10 || kind == 12 ||
  kind == 3 && left == 0 || kind == 4 && right == 0 ||
  kind == 15 && (left == 0 || left == 2) ||
  kind == 16 && (right == 0 || right == 2) ||
  kind == 5 && (left == 1) != (right == 1) ||
  kind == 6 && (left == 1) == (right == 1)
}

fn dfa_consumes(kind: u8) -> bool uses {} {
  kind == 1 || kind == 2 || kind == 13 || kind == 14
}

// Ordered first-arrival closure. Stack/ready/seen are reused, not allocated.
fn dfa_closure(re: VmProgram, pc: u64, left: u64, right: u64,
  mut cache: DfaCache, mut count: u64) -> bool uses {} {
  let mut depth = 1u64
  cache.data[cache.stack] = pc
  while depth != 0 {
    depth -= 1
    let at = cache.data[cache.stack + depth]
    if cache.data[cache.seen + at] == 0 {
      cache.data[cache.seen + at] = 1
      let inst = re.code[at]
      if dfa_consumes(inst.kind) || inst.kind == 11 {
        cache.data[cache.ready + count] = at
        count += 1
        if inst.kind == 11 { return true }
      } else if dfa_allowed(inst.kind, left, right) {
        if inst.kind == 10 {
          cache.data[cache.stack + depth] = inst.y
          depth += 1
        }
        cache.data[cache.stack + depth] = inst.x
        depth += 1
      }
    }
  }
  false
}

// Reuse previously allocated state slots after a clear, without a list copy.
fn dfa_push(mut cache: DfaCache, value: u64) uses {} {
  if cache.used < core@1/list.len(cache.data) {
    cache.data[cache.used] = value
  } else {
    core@1/list.push(mut cache.data, value)
  }
  cache.used += 1
}

// Intern the ordered next-PC vector and the context/direction/pending flags.
// Chained hash buckets and state keys also reside in the same slab.
fn dfa_intern(mut cache: DfaCache, count: u64, flags: u64) -> u64 uses {} {
  // Finite-work replacement may resolve its debt before any DFA search.
  // Prepare the slab only when a state is actually requested; admission,
  // capacity, state layout and subsequent cache reuse stay the same.
  if core@1/list.len(cache.data) == 0 {
    core@1/list.reserve(mut cache.data, cache.limit)
    let mut cell = 0u64
    while cell < cache.used {
      core@1/list.push(mut cache.data, 0u64)
      cell += 1
    }
  }
  let mut hash = flags + count * 17
  let mut i = 0u64
  while i < count {
    hash = (hash * 33 + cache.data[cache.next + i] + 1) % 1048573
    i += 1
  }
  let bucket = cache.buckets + hash % 1024
  let mut state = cache.data[bucket]
  while state != 0 {
    if cache.data[state + 1] == flags && cache.data[state + 2] == count {
      let mut equal = true
      i = 0
      while equal && i < count {
        equal = cache.data[state + 132 + i] == cache.data[cache.next + i]
        i += 1
      }
      if equal { return state }
    }
    state = cache.data[state]
  }
  let needed = 132 + count
  if needed > cache.limit - cache.used {
    // regex-automata hybrid/dfa.rs:2360-2426,2457-2465;
    // meta/wrappers.rs:586-587: three clears, ten searched bytes per state.
    if cache.clears >= 3 && cache.searched / 10 < cache.states {
      cache.disabled = true
      return 0
    }
    let initial = cache.buckets + 1024
    if needed > cache.limit - initial {
      cache.disabled = true
      return 0
    }
    // Keep allocation and the pending key; old interned IDs become invalid.
    cache.used = initial
    i = 0
    while i < 1024 {
      cache.data[cache.buckets + i] = 0
      i += 1
    }
    cache.clears += 1
    cache.states = 0
    cache.searched = 0
  }
  let used = cache.used
  state = used
  let chain = cache.data[bucket]
  dfa_push(mut cache, chain)
  dfa_push(mut cache, flags)
  dfa_push(mut cache, count)
  i = 0
  while i < 129 {
    dfa_push(mut cache, 0u64)
    i += 1
  }
  i = 0
  while i < count {
    let pc = cache.data[cache.next + i]
    dfa_push(mut cache, pc)
    i += 1
  }
  cache.data[bucket] = state
  cache.states += 1
  state
}

// Reverse closure traverses the transposed Thompson graph. All paths matter:
// after the forward priority decision, earliest start is longest reverse span.
fn dfa_reverse_closure(re: VmProgram, seeds: u64, left: u64, right: u64,
  mut cache: DfaCache, mut count: u64) -> bool uses {} {
  let mut depth = 0u64
  let mut i = 0u64
  while i < seeds {
    cache.data[cache.stack + depth] = cache.data[cache.next + i]
    depth += 1
    i += 1
  }
  let mut matched = false
  while depth != 0 {
    depth -= 1
    let target = cache.data[cache.stack + depth]
    if cache.data[cache.seen + target] == 0 {
      cache.data[cache.seen + target] = 1
      if target == re.entry { matched = true }
      i = 0
      while i < cache.size {
        let inst = re.code[i]
        if inst.kind != 11 && (inst.x == target || inst.kind == 10 && inst.y == target) {
          if dfa_consumes(inst.kind) {
            // Distinct consuming PCs have one outgoing edge; no duplicates.
            cache.data[cache.ready + count] = i
            count += 1
          } else if dfa_allowed(inst.kind, left, right) && cache.data[cache.seen + i] == 0 {
            // Avoid duplicate queued predecessors to bound the reverse DFS
            // stack independently of the graph's fan-in.
            let mut queued = false
            let mut j = 0u64
            while j < depth {
              if cache.data[cache.stack + j] == i { queued = true }
              j += 1
            }
            if !queued {
              cache.data[cache.stack + depth] = i
              depth += 1
            }
          }
        }
        i += 1
      }
    }
  }
  matched
}

fn dfa_transition(re: VmProgram, state: u64, byte: u64, mut cache: DfaCache) -> u64 uses {} {
  let hit = cache.data[state + 3 + byte]
  if hit != 0 { return hit }
  cache.misses += 1
  let flags = cache.data[state + 1]
  let reverse = flags >= 8
  let pending = flags % 8 >= 4
  let previous_category = flags % 4
  let category = dfa_category(byte)
  let left = if reverse { category } else { previous_category }
  let right = if reverse { previous_category } else { category }
  let mut i = 0u64
  while i < cache.size {
    cache.data[cache.seen + i] = 0
    i += 1
  }
  let mut count = 0u64
  let mut matched = false
  if reverse {
    let seeds = dfa_frontier(state, mut cache)
    matched = dfa_reverse_closure(re, seeds, left, right, mut cache, mut count)
  } else {
    i = 0
    while !matched && i < cache.data[state + 2] {
      let seed = cache.data[state + 132 + i]
      matched = dfa_closure(re, seed, left, right, mut cache, mut count)
      i += 1
    }
    if !matched && !pending {
      matched = dfa_closure(re, re.entry, left, right, mut cache, mut count)
    }
  }
  let mut next_count = 0u64
  i = 0
  while i < count {
    let pc = cache.data[cache.ready + i]
    let inst = re.code[pc]
    if inst.kind == 11 { break }
    if byte != 128 {
      // ASCII classes are singleton equivalence classes initially. Folded
      // acceptance still follows the full scalar orbit on cold transitions.
      let mut unused = 1024u64
      let scalar = core@1/char.from_u32(core@1/int.narrow(byte))
      let accepted = match scalar {
        Some(c) => match accepts(inst, c, mut unused) {
          Ok(value) => value,
          Error(_) => { cache.disabled = true; cache.scalar_fallback = true; return 0 },
        },
        None() => { cache.disabled = true; cache.scalar_fallback = true; return 0 },
      }
      if accepted {
        cache.data[cache.next + next_count] = if reverse { pc } else { inst.x }
        next_count += 1
      }
    }
    i += 1
  }
  let stop = byte == 128 || next_count == 0 && (reverse || matched || pending)
  let next_flags = category + (if reverse { 8u64 } else if pending || matched { 4u64 } else { 0u64 })
  let generation = cache.clears
  let next_state = dfa_intern(mut cache, next_count, next_flags)
  if next_state == 0 { return 0 }
  let transition = next_state * 4 + (if matched { 1u64 } else { 0u64 }) + (if stop { 2u64 } else { 0u64 })
  // The source ID is invalid after clearing; only the pending key survives.
  if generation == cache.clears { cache.data[state + 3 + byte] = transition }
  transition
}

fn dfa_byte(subject: Subject, at: u64) -> u64 uses {} {
  if at == subject_len(subject) { return 128 }
  let cp: u64 = core@1/int.widen(subject.bytes[at])
  if cp >= 128 { 129u64 } else { cp }
}

// Save the ordered Thompson frontier before a runtime quit. No start offsets
// are needed until the reverse search resolves the winning match's start.
fn dfa_frontier(state: u64, mut cache: DfaCache) -> u64 uses {} {
  let count = cache.data[state + 2]
  let mut i = 0u64
  while i < count {
    cache.data[cache.next + i] = cache.data[state + 132 + i]
    i += 1
  }
  count
}

// Incremental ordered Pike step, using the same bounded PC/closure scratch as
// determinization. The current position, frontier and pending match survive a
// quit. This scalar path also handles Unicode, without rescanning the prefix.
// regex-automata hybrid/search.rs:80-110 (quit position), util/determinize/
// mod.rs:350-490 (ordered frontier); hybrid/search.rs:340-470 (reverse).
fn dfa_scalar_step(re: VmProgram, subject: Subject, cursor: u64, reverse: bool,
  pending: bool, seeds: u64, mut cache: DfaCache) -> (u64, bool, bool) uses {} {
  cache.scalar_steps += 1
  if !reverse { cache.scalar_forward_steps += 1 }
  let left = if cursor == 0 { 0u64 } else { dfa_category(dfa_byte(subject, subject_before(subject, cursor))) }
  let right = dfa_category(dfa_byte(subject, cursor))
  let mut i = 0u64
  while i < cache.size {
    cache.data[cache.seen + i] = 0
    i += 1
  }
  let mut count = 0u64
  let mut matched = false
  if reverse {
    matched = dfa_reverse_closure(re, seeds, left, right, mut cache, mut count)
  } else {
    i = 0
    while !matched && i < seeds {
      let pc = cache.data[cache.next + i]
      matched = dfa_closure(re, pc, left, right, mut cache, mut count)
      i += 1
    }
    if !matched && !pending {
      matched = dfa_closure(re, re.entry, left, right, mut cache, mut count)
    }
  }
  let eof = if reverse { cursor == 0 } else { cursor == subject_len(subject) }
  let mut next_count = 0u64
  i = 0
  while !eof && i < count {
    let pc = cache.data[cache.ready + i]
    let inst = re.code[pc]
    if inst.kind == 11 { break }
    let c = subject_scalar(subject, if reverse { subject_before(subject, cursor) } else { cursor })
    let mut work = 18446744073709551615u64
    let Ok(accepted) = accepts(inst, c, mut work) else { return (0, matched, true) }
    if accepted {
      cache.data[cache.next + next_count] = if reverse { pc } else { inst.x }
      next_count += 1
    }
    i += 1
  }
  (next_count, matched, eof || next_count == 0 && (reverse || pending || matched))
}

fn dfa_search(re: Regex, subject: Subject, start: u64, haystack: Bytes, mut cache: DfaCache) -> DfaResult uses {} {
  if cache.disabled { return DfaQuit() }
  let program = vm_program(re)
  let bytes = subject.bytes
  let size = core@1/bytes.len(bytes)
  let previous = if start == 0 { 128u64 } else if subject.ascii {
    core@1/int.widen(bytes[start - 1])
  } else { dfa_byte(subject, subject_before(subject, start)) }
  let mut state = dfa_intern(mut cache, 0, dfa_category(previous))
  if state == 0 { return DfaQuit() }
  let mut cursor = start
  let mut end: Option[u64] = None()
  let mut scalar = previous > 128
  let mut seeds = 0u64
  if scalar { cache.disabled = true; cache.scalar_fallback = true; cache.fallbacks += 1; cache.resume_at = cursor }
  while true {
    // A prefilter is optional and can skip only with no active thread/match.
    if !scalar && re.prefilter.enabled && cache.data[state + 2] == 0 && end == None() {
      let Some(candidate) = next_candidate(re.prefilter, haystack, cursor) else { return DfaMiss() }
      // hybrid/search.rs:246-266 restarts only after the prefilter advances.
      // Without progress, this empty frontier already has its look-behind.
      if candidate != cursor {
        cursor = candidate
        let preceding = if cursor == 0 { 128u64 } else if subject.ascii {
          core@1/int.widen(bytes[cursor - 1])
        } else { dfa_byte(subject, subject_before(subject, cursor)) }
        let category = dfa_category(preceding)
        if cache.data[state + 1] != category {
          state = dfa_intern(mut cache, 0, category)
        }
        if state == 0 || preceding > 128 {
          scalar = true
          cache.disabled = true
          cache.scalar_fallback = true
          cache.fallbacks += 1
          cache.resume_at = cursor
          seeds = 0
        }
      }
    }
    // hybrid/search.rs:63-70,95-110: load the byte and follow a known
    // transition in the same loop. A non-ASCII byte transfers the current
    // frontier to the existing scalar engine before advancing the cursor.
    let byte: u64 = if cursor == size { 128u64 } else {
      let value: u64 = core@1/int.widen(bytes[cursor])
      if value < 128 { value } else { 129u64 }
    }
    let transition = if scalar || byte > 128 { 0u64 } else {
      // hybrid/search.rs:63-70,95-110: keep known transitions in the loop.
      let hit = cache.data[state + 3 + byte]
      if hit != 0 { hit } else { dfa_transition(program, state, byte, mut cache) }
    }
    let mut matched = false
    let mut stop = false
    if transition == 0 {
      if !scalar {
        seeds = dfa_frontier(state, mut cache)
        scalar = true
        cache.disabled = true
        cache.scalar_fallback = true
        cache.fallbacks += 1
        cache.resume_at = cursor
      }
      let (count, hit, dead) = dfa_scalar_step(program, subject, cursor, false, end != None(), seeds, mut cache)
      seeds = count
      matched = hit
      stop = dead
    } else {
      matched = transition % 2 == 1
      stop = transition % 4 >= 2
      state = transition / 4
      cache.searched += 1
    }
    if matched { end = Some(cursor) }
    if stop { break }
    cursor = if scalar { subject_next(subject, cursor) } else { cursor + 1 }
  }
  let Some(end_at) = end else { return DfaMiss() }
  if end_at == start { return DfaMatch(Span(start: start, end: end_at)) }
  let right = dfa_byte(subject, end_at)
  cache.data[cache.next] = 0
  seeds = 1
  if !scalar {
    state = dfa_intern(mut cache, 1, 8 + dfa_category(right))
    if state == 0 || right > 128 {
      scalar = true
      cache.disabled = true
      cache.scalar_fallback = true
      cache.fallbacks += 1
      cache.resume_at = end_at
    }
  }
  cursor = end_at
  let mut found: Option[u64] = None()
  while true {
    let byte: u64 = if cursor == 0 { 128u64 } else {
      let value: u64 = core@1/int.widen(bytes[cursor - 1])
      if value < 128 { value } else { 129u64 }
    }
    let transition = if scalar || byte > 128 { 0u64 } else {
      // hybrid/search.rs:63-70,95-110: keep known transitions in the loop.
      let hit = cache.data[state + 3 + byte]
      if hit != 0 { hit } else { dfa_transition(program, state, byte, mut cache) }
    }
    let mut matched = false
    let mut stop = false
    if transition == 0 {
      if !scalar {
        seeds = dfa_frontier(state, mut cache)
        scalar = true
        cache.disabled = true
        cache.scalar_fallback = true
        cache.fallbacks += 1
        cache.resume_at = cursor
      }
      let (count, hit, dead) = dfa_scalar_step(program, subject, cursor, true, false, seeds, mut cache)
      seeds = count
      matched = hit
      stop = dead
    } else {
      matched = transition % 2 == 1
      stop = transition % 4 >= 2
      state = transition / 4
      cache.searched += 1
    }
    if matched { found = Some(cursor) }
    if cursor == start || stop { break }
    cursor = if scalar { subject_before(subject, cursor) } else { cursor - 1 }
  }
  match found {
    Some(from) => DfaMatch(Span(start: from, end: end_at)),
    None() => DfaMiss(),
  }
}

// Finite work budgets use the exact ordered VM. An accelerated search which
// quits mid-stream completes from its saved frontier inside dfa_search.
fn find_from(re: Regex, subject: Subject, start: u64, admitted: bool, haystack: Bytes,
  mut cache: DfaCache, mut work: u64) -> Result[(Option[Span], Captures), MatchError] uses {} {
  if admitted && !cache.disabled {
    match dfa_search(re, subject, start, haystack, mut cache) {
      DfaMatch(span) => return Ok((Some(span), Captures(spans: []))),
      DfaMiss() => return Ok((None(), Captures(spans: []))),
      DfaQuit() => { cache.disabled = true; cache.fallbacks += 1 },
    }
  }
  if admitted && cache.scalar_fallback && re.prefilter.enabled {
    return find_from_prefilter(re, subject, start, false, true, haystack, mut work)
  }
  pike_find_from(re, subject, start, false, mut work)
}
