      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8
    ],
    used: 0,
    count: 0
  )
}

@noalloc
fn rotate(value: u32, bits: u32) -> u32 uses {} {
  value >> bits | value << 32u32 - bits
}

@noalloc
fn add(a: u32, b: u32) -> u32 uses {} {
  core@1/int.wrapping_add(a, b)
}

@noalloc
fn compress(mut state: State) -> () uses {} {
  let mut schedule: Inline[u32, 64] = [
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32
  ]
  let mut i: u64 = 0
  while i < 16 {
    let at = i * 4
    let a: u32 = core@1/int.widen(state.block[at])
    let b: u32 = core@1/int.widen(state.block[at + 1])
    let c: u32 = core@1/int.widen(state.block[at + 2])
    let d: u32 = core@1/int.widen(state.block[at + 3])
    schedule[i] = a << 24 | b << 16 | c << 8 | d
    i += 1
  }
  while i < 64 {
    let a = schedule[i - 15]
    let b = schedule[i - 2]
    let s0 = rotate(a, 7) ^ rotate(a, 18) ^ a >> 3
    let s1 = rotate(b, 17) ^ rotate(b, 19) ^ b >> 10
    schedule[i] = add(add(schedule[i - 16], s0), add(schedule[i - 7], s1))
    i += 1
  }
  let mut a = state.words[0]
  let mut b = state.words[1]
  let mut c = state.words[2]
  let mut d = state.words[3]
  let mut e = state.words[4]
  let mut f = state.words[5]
  let mut g = state.words[6]
  let mut h = state.words[7]
  i = 0
  while i < 64 {
    let upper = rotate(e, 6) ^ rotate(e, 11) ^ rotate(e, 25)
    let choice = e & f ^ ~e & g
    let t1 = add(add(add(h, upper), choice), add(K[i], schedule[i]))
    let lower = rotate(a, 2) ^ rotate(a, 13) ^ rotate(a, 22)
    let majority = a & b ^ a & c ^ b & c
    let t2 = add(lower, majority)
    h = g
    g = f
    f = e
    e = add(d, t1)
    d = c
    c = b
    b = a
    a = add(t1, t2)
    i += 1
  }
  state.words[0] = add(state.words[0], a)
  state.words[1] = add(state.words[1], b)
  state.words[2] = add(state.words[2], c)
  state.words[3] = add(state.words[3], d)
  state.words[4] = add(state.words[4], e)
  state.words[5] = add(state.words[5], f)
  state.words[6] = add(state.words[6], g)
  state.words[7] = add(state.words[7], h)
}

@noalloc
pub fn update(mut state: State, data: Bytes) -> () uses {} {
  let len = core@1/bytes.len(data)
  core@1/failure.check(len <= 2305843009213693951u64 - state.count, Arithmetic())
  state.count += len
  let mut i: u64 = 0
  while i < len {
    state.block[state.used] = data[i]
    state.used += 1
    if state.used == 64 {
      compress(mut state)
      state.used = 0
    }
    i += 1
  }
}

@noalloc
pub fn finish(take state: State) -> Inline[u8, 32] uses {} {
  let mut final_state = take state
  final_state.block[final_state.used] = 128
  final_state.used += 1
  if final_state.used > 56 {
    while final_state.used < 64 {
      final_state.block[final_state.used] = 0
      final_state.used += 1
    }
    compress(mut final_state)
    final_state.used = 0
  }
  while final_state.used < 56 {
    final_state.block[final_state.used] = 0
    final_state.used += 1
  }
  let mut bits = final_state.count * 8u64
  let mut i: u64 = 0
  while i < 8 {
    final_state.block[63 - i] = core@1/int.narrow(bits & 255u64)
    bits >>= 8
    i += 1
  }
  compress(mut final_state)
  let mut out: Inline[u8, 32] = [
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8
  ]
  i = 0
  while i < 8 {
    let value = final_state.words[i]
    out[i * 4] = core@1/int.narrow(value >> 24)
    out[i * 4 + 1] = core@1/int.narrow(value >> 16 & 255u32)
    out[i * 4 + 2] = core@1/int.narrow(value >> 8 & 255u32)
    out[i * 4 + 3] = core@1/int.narrow(value & 255u32)
    i += 1
  }
  take out
}

@noalloc
pub fn digest(data: Bytes) -> Inline[u8, 32] uses {} {
  let mut state = new()
  update(mut state, data)
  finish(take state)
}

pub fn digest_hex(data: Bytes) -> unique String uses {} {
  std@1/hex.encode(std@1/bytes.from_inline(digest(data)))
}

// The dictionary that keys HMAC, HKDF and PBKDF2 with this hash.
pub fn hash() -> std@1/digest.Hash[State, 32] uses {} {
  std@1/digest.Hash(new: new, update: update, finish: finish, block_size: 64)
}
