// Zig crypto/sha2.zig portable SHA-256 rounds/update/final (MIT).
pub opaque type State: plain + inert uses {} {
  words: Inline[u32, 8],
  block: Inline[u8, 64],
  used: u64,
  count: u64,
}

const K: Inline[u32, 64] = [
  0x428A2F98,
  0x71374491,
  0xB5C0FBCF,
  0xE9B5DBA5,
  0x3956C25B,
