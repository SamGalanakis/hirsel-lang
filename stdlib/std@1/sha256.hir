@noalloc
fn compress(mut state: State) -> () uses {} {
  let mut schedule: Inline[u32, 64] = [
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32
  ]
  let mut i: u64 = 0
  while i < 16 {
    let at = i * 4
    let a: u32 = core@1/int.widen(state.block[at])
    let b: u32 = core@1/int.widen(state.block[at + 1])
    let c: u32 = core@1/int.widen(state.block[at + 2])
    let d: u32 = core@1/int.widen(state.block[at + 3])
    schedule[i] = a << 24 | b << 16 | c << 8 | d
    i += 1
  }
  rounds(mut state.words, take schedule)
}

@noalloc
fn compress_input(mut words: Inline[u32, 8], data: Bytes, offset: u64) -> () uses {} {
  let mut schedule: Inline[u32, 64] = [
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32,
    0u32
  ]
  let mut i: u64 = 0
  while i < 16 {
    let at = offset + i * 4
    let a: u32 = core@1/int.widen(data[at])
    let b: u32 = core@1/int.widen(data[at + 1])
    let c: u32 = core@1/int.widen(data[at + 2])
    let d: u32 = core@1/int.widen(data[at + 3])
    schedule[i] = a << 24 | b << 16 | c << 8 | d
    i += 1
  }
  rounds(mut words, take schedule)
}

@noalloc
fn rounds(mut words: Inline[u32, 8], take initial: Inline[u32, 64]) -> () uses {} {
  let mut schedule = take initial
  let mut i: u64 = 16
  while i < 64 {
    let a = schedule[i - 15]
    let b = schedule[i - 2]
    let s0 = (a >> 7u32 | a << 25u32) ^ (a >> 18u32 | a << 14u32) ^ a >> 3
    let s1 = (b >> 17u32 | b << 15u32) ^ (b >> 19u32 | b << 13u32) ^ b >> 10
    schedule[i] = core@1/int.wrapping_add(
      core@1/int.wrapping_add(schedule[i - 16], s0),
      core@1/int.wrapping_add(schedule[i - 7], s1)
    )
    i += 1
  }
  let mut a = words[0]
  let mut b = words[1]
  let mut c = words[2]
  let mut d = words[3]
  let mut e = words[4]
  let mut f = words[5]
  let mut g = words[6]
  let mut h = words[7]
  i = 0
  while i < 64 {
    let upper = (e >> 6u32 | e << 26u32) ^ (e >> 11u32 | e << 21u32) ^ (e >> 25u32 | e << 7u32)
    let choice = e & f ^ ~e & g
    let t1 = core@1/int.wrapping_add(
      core@1/int.wrapping_add(core@1/int.wrapping_add(h, upper), choice),
      core@1/int.wrapping_add(K[i], schedule[i])
    )
    let lower = (a >> 2u32 | a << 30u32) ^ (a >> 13u32 | a << 19u32) ^ (a >> 22u32 | a << 10u32)
    let majority = a & b ^ a & c ^ b & c
    let t2 = core@1/int.wrapping_add(lower, majority)
    h = g
    g = f
    f = e
    e = core@1/int.wrapping_add(d, t1)
    d = c
    c = b
    b = a
    a = core@1/int.wrapping_add(t1, t2)
    i += 1
  }
  words[0] = core@1/int.wrapping_add(words[0], a)
  words[1] = core@1/int.wrapping_add(words[1], b)
  words[2] = core@1/int.wrapping_add(words[2], c)
  words[3] = core@1/int.wrapping_add(words[3], d)
  words[4] = core@1/int.wrapping_add(words[4], e)
  words[5] = core@1/int.wrapping_add(words[5], f)
  words[6] = core@1/int.wrapping_add(words[6], g)
  words[7] = core@1/int.wrapping_add(words[7], h)
}

@noalloc
pub fn update(mut state: State, data: Bytes) -> () uses {} {
  let len = core@1/bytes.len(data)
  core@1/failure.check(len <= 2305843009213693951u64 - state.count, Arithmetic())
  state.count += len
  let mut i: u64 = 0
  // Fill a partial block left by the previous call before reading input blocks.
  if state.used != 0 {
    while i < len && state.used < 64 {
      state.block[state.used] = data[i]
      state.used += 1
      i += 1
    }
    if state.used == 64 {
      compress(mut state)
      state.used = 0
    }
  }
  // Zig std crypto update: compress full middle blocks without a staging copy.
  while len - i >= 64 {
    compress_input(mut state.words, data, i)
    i += 64
  }
  // Only the incomplete tail survives until the next update or finish.
  while i < len {
    state.block[state.used] = data[i]
    state.used += 1
    i += 1
  }
}

@noalloc
pub fn finish(take state: State) -> Inline[u8, 32] uses {} {
  let mut final_state = take state
  final_state.block[final_state.used] = 128
  final_state.used += 1
  if final_state.used > 56 {
    while final_state.used < 64 {
      final_state.block[final_state.used] = 0
      final_state.used += 1
    }
    compress(mut final_state)
    final_state.used = 0
  }
  while final_state.used < 56 {
    final_state.block[final_state.used] = 0
    final_state.used += 1
  }
  let mut bits = final_state.count * 8u64
  let mut i: u64 = 0
  while i < 8 {
    final_state.block[63 - i] = core@1/int.narrow(bits & 255u64)
    bits >>= 8
    i += 1
  }
  compress(mut final_state)
  let mut out: Inline[u8, 32] = [
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8
  ]
  i = 0
  while i < 8 {
    let value = final_state.words[i]
    out[i * 4] = core@1/int.narrow(value >> 24)
    out[i * 4 + 1] = core@1/int.narrow(value >> 16 & 255u32)
    out[i * 4 + 2] = core@1/int.narrow(value >> 8 & 255u32)
    out[i * 4 + 3] = core@1/int.narrow(value & 255u32)
    i += 1
  }
  take out
}

@noalloc
pub fn digest(data: Bytes) -> Inline[u8, 32] uses {} {
  core@1/bytes.sha256(data)
}

pub fn digest_hex(data: Bytes) -> unique String uses {} {
  std@1/hex.encode(std@1/bytes.from_inline(digest(data)))
}

// The dictionary that keys HMAC, HKDF and PBKDF2 with this hash.
pub const hash: std@1/digest.Hash[State, 32] = std@1/digest.Hash(
  new: new,
  update: update,
  finish: finish,
  block_size: 64
)
