// Port of Zig lib/std/http/Client.zig request/sendBodiless/sendBodyComplete,
// Request.receiveHead/redirect/fetch and lib/std/http.zig Reader.State and
// BodyWriter.chunkedDrain/endChunked, bff490a23889750de7096d9057c0a432efc929a8.
// MIT, third-party/NOTICES.md. Explicit Net and branded Stream replace Io and
// connection handles; owned buffers replace borrowed reader/writer slices.
// Limits/defaults follow ureq src/config.rs.
// Whole-request deadline pattern (the caller owns tasks, deadline and client):
// let owned_client = take client
// let bounded = task.scope_until(tasks, deadline,
//   fn(s: Scope) -> (http.Client, Result[http.Response, http.HttpError]) {
//     let mut current = take owned_client
//     let outcome = http.client_fetch(mut current, Get(), url, [], None())
//     (take current, take outcome)
//   })
// Finished and Expired both retain the client and outcome; match to recover them.
// A cancelled exchange drops its stream before returning the client.
@serializable
pub type Method = Get | Head | Post | Put | Delete | Patch | Options

@serializable
pub type Version = Http10 | Http11 | Http2

@serializable
pub type Header {
  name: String,
  value: String,
}

@serializable
pub type Config {
  max_redirects: u32,
  max_idle_connections: u64,
  max_idle_connections_per_host: u64,
  connect_timeout: Option[time.Duration],
  read_timeout: Option[time.Duration],
  write_timeout: Option[time.Duration],
  max_head_bytes: u64,
  max_body_bytes: u64,
  idle_timeout: Option[time.Duration],
  max_headers: u64,
  user_agent: String,
  roots: TlsRoots,
  status_as_error: bool,
  decompress: bool,
  unix_socket: Option[Path],
  http2_prior_knowledge: bool,
}

@serializable
pub type ResponseHead {
  version: Version,
  status: u16,
  reason: String,
  headers: List[Header],
  content_length: Option[u64],
  chunked: bool,
  keep_alive: bool,
  location: Option[String],
  content_type: Option[String],
}

@serializable
pub type Response {
  status: u16,
  headers: List[Header],
  body: Bytes,
  url: String,
}

@serializable
pub type HttpError = Net(NetError) | Url(uri.UriError) | Malformed(http_wire.HeadError) | Chunk | HeadTooLarge | BodyTooLarge | Truncated | TooManyRedirects | RedirectRequiresResend | RedirectLocationInvalid | UnsupportedScheme | UnsupportedTransferEncoding | Status(
  u16
) | OutOfOrder | Closed | RequestTimeout | Clock(ClockError) | Json(json.JsonError) | InvalidJsonUtf8 | Decode(
  flate.FlateError
) | UnsupportedContentEncoding

// ready=0, streaming request=1, sent=2, body=3, done=4, failed=5.
// body_kind: EOF=0, content-length=1, chunked=2. chunk_suffix tracks the
// mandatory CRLF after data separately from the following chunk size line.
pub opaque resource type Request: noalloc_drop uses {Net} {
  transport: HttpTransport,
  config: Config,
  method: Method,
  uri: uri.Uri,
  url: String,
  headers: List[Header],
  redirects: u32,
  state: u8,
  sent_body: bool,
  body_kind: u8,
  remaining: u64,
  chunk_suffix: bool,
  response_trailers: List[Header],
  persistent: bool,
  reusable: bool,
  idle_since: u64,
  stream_id: u32,
  body_end: bool,
  body_offset: u64,
  body_data: Bytes,
  body_credit: u32,
}
@noalloc drop(self) {}

pub fn default_config() -> Config uses {} {
  Config(
    max_redirects: 3,
    max_idle_connections: 16,
    max_idle_connections_per_host: 2,
    connect_timeout: None(),
    read_timeout: None(),
    write_timeout: None(),
    max_head_bytes: 65536,
    max_body_bytes: 10485760,
    idle_timeout: Some(time.Duration(nanoseconds: 30000000000)),
    max_headers: 100,
    user_agent: "hirsel-std/1",
    roots: WebPki(),
    status_as_error: true,
    decompress: false,
    unix_socket: None(),
    http2_prior_knowledge: false
  )
}

// Zig lib/std/ascii.zig toLower/eqlIgnoreCase, scalar byte path (bff490a2).
@noalloc
fn http_lower(b: u8) -> u8 uses {} {
  if b >= 65 && b <= 90 {
    b + 32
  } else {
    b
  }
}

@noalloc
fn http_same(a: String, b: String) -> bool uses {} {
  let x = core@1/string.as_bytes(a)
  let y = core@1/string.as_bytes(b)
  if core@1/bytes.len(x) != core@1/bytes.len(y) {
    return false
  }
  let mut i: u64 = 0
  while i < core@1/bytes.len(x) {
    if http_lower(x[i]) != http_lower(y[i]) {
      return false
    }
    i += 1
  }
  true
}

// Zig HeaderIterator lookup; the first case-insensitive match wins.
pub fn header(headers: List[Header], name: String) -> Option[String] uses {} {
  for h in headers {
    if http_same(h.name, name) {
      return Some(unique h.value)
    }
  }
  None()
}

fn http_text(buf: Bytes, start: u64, end: u64) -> Result[unique String, HttpError] uses {} {
  let mut out: List[u8] = []
  let mut i = start
  while i < end {
    core@1/list.push(mut out, buf[i])
    i += 1
  }
  match text.finish(take out) {
    Ok(s) => Ok(take s),
    Error(_) => Error(Malformed(HeaderValue())),
  }
}

// Whether buf[start..end] is `word`, ignoring ASCII case.
@noalloc
fn http_token_is(buf: Bytes, start: u64, end: u64, word: String) -> bool uses {} {
  let w = core@1/string.as_bytes(word)
  if end - start != core@1/bytes.len(w) {
    return false
  }
  let mut i: u64 = 0
  while i < core@1/bytes.len(w) {
    if http_lower(buf[start + i]) != w[i] {
      return false
    }
    i += 1
  }
  true
}

/// Removes the content codings named by every Content-Encoding field, last
/// applied first (RFC 9110 section 8.4): `gzip` and `x-gzip` are gzip data,
/// `deflate` is zlib data and `identity` is ignored. Each decoded stage holds
/// at most `limit` bytes (`BodyTooLarge` beyond); any other coding is
/// `UnsupportedContentEncoding`, which a server answers with 415.
pub fn decode_content(headers: List[Header], body: Bytes, limit: u64) -> Result[
  unique Bytes,
  HttpError
] uses {} {
  // 1 = gzip, 2 = deflate, in the order applied.
  let mut codings: List[u8] = []
  for h in headers {
    if http_same(h.name, "content-encoding") {
      let value = core@1/string.as_bytes(h.value)
      let size = core@1/bytes.len(value)
      let mut start: u64 = 0
      while start <= size {
        let mut stop = start
        while stop < size && value[stop] != 44 {
          stop += 1
        }
        let mut first = start
        let mut last = stop
        while first < last && (value[first] == 32 || value[first] == 9) {
          first += 1
        }
        while last > first && (value[last - 1] == 32 || value[last - 1] == 9) {
          last -= 1
        }
        if http_token_is(value, first, last, "gzip") || http_token_is(
          value,
          first,
          last,
          "x-gzip"
        ) {
          core@1/list.push(mut codings, 1)
        } else if http_token_is(value, first, last, "deflate") {
          core@1/list.push(mut codings, 2)
        } else if first < last && !http_token_is(value, first, last, "identity") {
          return Error(UnsupportedContentEncoding())
        }
        start = stop + 1
      }
    }
  }
  let mut current = unique body
  let mut i = core@1/list.len(codings)
  while i > 0 {
    i -= 1
    let decoded = if codings[i] == 1 {
      flate.gzip_decode(current, limit)
    } else {
      flate.zlib_decode(current, limit)
    }
    current = match take decoded {
      Ok(data) => take data,
      Error(TooLarge()) => return Error(BodyTooLarge()),
      Error(error) => return Error(Decode(error)),
    }
  }
  if core@1/bytes.len(current) > limit {
    return Error(BodyTooLarge())
  }
  Ok(take current)
}

// Go Transport's transparent decompression: only when the caller sent no
// Accept-Encoding does the client ask for gzip and deflate and decode them.
fn http_offer_codings(config: Config, headers: List[Header]) -> (List[Header], bool) uses {} {
  let mut sent = unique headers
  if !config.decompress || option.is_some(header(headers, "accept-encoding")) {
    return (take sent, false)
  }
  core@1/list.push(mut sent, Header(name: "accept-encoding", value: "gzip, deflate"))
  (take sent, true)
}

// A decoded response drops Content-Encoding and Content-Length, as in Go. An
// empty body (HEAD, 204, 304 or Content-Length: 0) is returned unchanged.
fn http_decoded(take response: Response, limit: u64) -> Result[Response, HttpError] uses {} {
  if core@1/bytes.len(response.body) == 0 || option.is_none(
    header(response.headers, "content-encoding")
  ) {
    return Ok(take response)
  }
  let body = decode_content(response.headers, response.body, limit)?
  let mut kept: List[Header] = []
  for h in response.headers {
    if !http_same(h.name, "content-encoding") && !http_same(h.name, "content-length") {
      core@1/list.push(mut kept, unique h)
    }
  }
  Ok(
    Response(
      status: response.status,
      headers: take kept,
      body: take body,
      url: response.url
    )
  )
}

fn http_net_error(error: NetError) -> HttpError uses {} {
  Net(unique error)
}

fn http_timeout(value: Option[time.Duration]) -> Result[NetTimeout, HttpError] uses {} {
  match value {
    None() => Ok(Unbounded()),
    Some(d) => {
      if d.nanoseconds <= 0 || d.nanoseconds > 18446744073709551615i128 {
        return Error(http_net_error(InvalidInput()))
      }
      Ok(Nanos(core@1/int.narrow(d.nanoseconds)))
    },
  }
}

// Zig HostName.fromUri: decode, remove IPv6 brackets and canonicalize for Net.
fn http_host(parsed_uri: uri.Uri) -> Result[unique String, HttpError] uses {} {
  let Some(component) = parsed_uri.host else {
    return Error(Url(InvalidHostName()))
  }
  let raw = uri.component_raw(component)
  let len = core@1/bytes.len(raw)
  if len >= 2 && raw[0] == 91 && raw[len - 1] == 93 {
    let name = http_text(raw, 1, len - 1)?
    return match net.parse_ip(name) {
      Ok(ip) => Ok(net.ip_to_string(ip)),
      Error(_) => Error(Url(InvalidHostName())),
    }
  }
  let mut out: List[u8] = []
  let end = if len > 0 && raw[len - 1] == 46 {
    len - 1
  } else {
    len
  }
  let mut i: u64 = 0
  while i < end {
    core@1/list.push(mut out, http_lower(raw[i]))
    i += 1
  }
  let Ok(name) = text.finish(take out) else {
    return Error(Url(InvalidHostName()))
  }
  match net.validate_host(name) {
    Ok(()) => Ok(take name),
    Error(_) => Error(Url(InvalidHostName())),
  }
}

/// The origin-form request target for `parsed_uri`: its encoded path (`/` when empty)
/// and `?query` when present.
pub fn request_target(parsed_uri: uri.Uri) -> unique String uses {} {
  let mut out: List[u8] = []
  let target_path = uri.component_encoded(parsed_uri.path, Path())
  text.append(
    mut out,
    if target_path == "" {
      "/"
    } else {
      target_path
    }
  )
  if let Some(q) = parsed_uri.query {
    text.append(mut out, "?")
    text.append(mut out, uri.component_encoded(q, Query()))
  }
  text.finish_valid(take out)
}

/// The `host` field value for `parsed_uri`: its canonical host, bracketed when IPv6,
/// with `:port` when the URI spells a port.
pub fn host_header(parsed_uri: uri.Uri) -> Result[unique String, HttpError] uses {} {
  let hostname = http_host(parsed_uri)?
  let mut out: List[u8] = []
  let data = core@1/string.as_bytes(hostname)
  let mut ipv6: bool = false
  let mut i: u64 = 0
  while i < core@1/bytes.len(data) {
    if data[i] == 58 {
      ipv6 = true
    }
    i += 1
  }
  if ipv6 {
    text.append(mut out, "[")
  }
  text.append(mut out, hostname)
  if ipv6 {
    text.append(mut out, "]")
  }
  if let Some(p) = parsed_uri.port {
    text.append(mut out, ":")
    u16.format_into(p, mut out)
  }
  Ok(text.finish_valid(take out))
}

@noalloc
fn http_port(parsed_uri: uri.Uri) -> u16 uses {} {
  match parsed_uri.port {
    Some(p) => p,
    None() => if http_same(parsed_uri.scheme, "https") {
      443
    } else {
      80
    },
  }
}

/// Opens the connection a request to `parsed_uri` uses: `http` or `https` (any other
/// scheme is `UnsupportedScheme()`), the config's `unix_socket` or a TCP connect under
/// its connect timeout, the read and write timeouts, then `tls.connect` for `https`.
/// Protocols that start with an HTTP/1.1 exchange, such as WebSocket, dial with it.
pub fn dial(n: Net, config: Config, parsed_uri: uri.Uri) -> Result[
  Stream of n,
  HttpError
] {
  if !http_same(parsed_uri.scheme, "http") && !http_same(parsed_uri.scheme, "https") {
    return Error(UnsupportedScheme())
  }
  let name = http_host(parsed_uri)?
  let ct = http_timeout(config.connect_timeout)?
  let rt = http_timeout(config.read_timeout)?
  let wt = http_timeout(config.write_timeout)?
  // A configured socket path carries every connection, as curl --unix-socket does; the
  // URL still names the Host header, the TLS server name and the pool origin.
  let mut plain = match config.unix_socket {
    Some(socket) => core@1/net.unix_connect(n, socket) ? http_net_error,
    None() => core@1/net.connect(n, name, http_port(parsed_uri), ct) ? http_net_error,
  }
  // ConnectTls allows options before upgrade; these also bound the handshake.
  core@1/net.set_read_timeout(n, mut plain, rt) ? http_net_error
  core@1/net.set_write_timeout(n, mut plain, wt) ? http_net_error
  let s = if http_same(parsed_uri.scheme, "https") {
    core@1/tls.connect(n, take plain, name, config.roots) ? http_net_error
  } else {
    take plain
  }
  Ok(take s)
}

/// Rejects an empty or non-token header name and a value with a control byte other
/// than tab (`Malformed(HeaderName())`, `Malformed(HeaderValue())`): the header-injection
/// boundary every writer applies before writing a head.
pub fn validate_headers(headers: List[Header]) -> Result[(), HttpError] uses {} {
  for h in headers {
    let name = core@1/string.as_bytes(h.name)
    if core@1/bytes.len(name) == 0 {
      return Error(Malformed(HeaderName()))
    }
    let mut ni: u64 = 0
    while ni < core@1/bytes.len(name) {
      let b = name[ni]
      ni += 1
      if !(b >= 65 && b <= 90 || b >= 97 && b <= 122 || b >= 48 && b <= 57 || b == 33 || b == 35 || b == 36 || b == 37 || b == 38 || b == 39 || b == 42 || b == 43 || b == 45 || b == 46 || b == 94 || b == 95 || b == 96 || b == 124 || b == 126) {
        return Error(Malformed(HeaderName()))
      }
    }
    let value = core@1/string.as_bytes(h.value)
    let mut vi: u64 = 0
    while vi < core@1/bytes.len(value) {
      let b = value[vi]
      vi += 1
      if b != 9 && (b < 32 || b == 127) {
        return Error(Malformed(HeaderValue()))
      }
    }
  }
  Ok(())
}

fn http_validate_target(target: String) -> Result[(), HttpError] uses {} {
  let wire_bytes = core@1/string.as_bytes(target)
  let mut i: u64 = 0
  while i < core@1/bytes.len(wire_bytes) {
    if wire_bytes[i] <= 32 || wire_bytes[i] == 127 {
      return Error(Url(UnexpectedCharacter()))
    }
    i += 1
  }
  Ok(())
}

pub fn request(
  n: Net,
  config: Config,
  method: Method,
  url: String,
  headers: List[Header]
) -> Result[Request, HttpError] {
  validate_headers(headers)?
  validate_headers([Header(name: "user-agent", value: config.user_agent)])?
  let parsed_uri = uri.parse(url)?
  let target = uri.component_encoded(parsed_uri.path, Path())
  http_validate_target(target)?
  if let Some(q) = parsed_uri.query {
    http_validate_target(uri.component_encoded(q, Query()))?
  }
  let s = dial(n, config, parsed_uri)?
  Ok(
    Request(
      transport: http_transport(
        n,
        take s,
        config.http2_prior_knowledge && http_same(parsed_uri.scheme, "http"),
        Client(),
        config
      ),
      config: unique config,
      method: method,
      uri: unique parsed_uri,
      url: unique url,
      headers: unique headers,
      redirects: config.max_redirects,
      state: 0,
      sent_body: false,
      body_kind: 0,
      remaining: 0,
      chunk_suffix: false,
      response_trailers: [],
      persistent: false,
      reusable: false,
      idle_since: 0,
      stream_id: 0,
      body_end: false,
      body_offset: 0,
      body_data: b"",
      body_credit: 0
    )
  )
}

fn http_method_text(method: Method) -> String uses {} {
  match method {
    Get() => "GET",
    Head() => "HEAD",
    Post() => "POST",
    Put() => "PUT",
    Delete() => "DELETE",
    Patch() => "PATCH",
    Options() => "OPTIONS",
  }
}

fn http_write(mut r: Request, data: Bytes) -> Result[(), HttpError] {
  http_transport_write(mut r.transport, data)?
  Ok(())
}

fn http_send_head(mut r: Request, framing_line: String) -> Result[(), HttpError] {
  r.state = 5
  let mut out: List[u8] = []
  text.append(mut out, http_method_text(r.method))
  text.append(mut out, " ")
  text.append(mut out, request_target(r.uri))
  text.append(mut out, " HTTP/1.1\r\nhost: ")
  text.append(mut out, host_header(r.uri)?)
  text.append(mut out, "\r\nuser-agent: ")
  text.append(mut out, r.config.user_agent)
  text.append(
    mut out,
    if r.persistent {
      "\r\nconnection: keep-alive\r\n"
    } else {
      "\r\nconnection: close\r\n"
    }
  )
  for h in r.headers {
    // Framing and connection headers belong to this state machine (Zig's
    // overridable built-in headers), never to two competing wire encodings.
    if !http_same(h.name, "host") && !http_same(h.name, "user-agent") && !http_same(
      h.name,
      "connection"
    ) && !http_same(h.name, "content-length") && !http_same(h.name, "transfer-encoding") {
      text.append(mut out, h.name)
      text.append(mut out, ": ")
      text.append(mut out, h.value)
      text.append(mut out, "\r\n")
    }
  }
  text.append(mut out, framing_line)
  text.append(mut out, "\r\n")
  let request_bytes = core@1/bytes.from_list(take out)
  http_write(mut r, request_bytes)
}

pub fn send_bodiless(mut r: Request) -> Result[(), HttpError] {
  if http_is_h2(r.transport) {
    return http_h2_send(mut r, None(), true)
  }
  if r.state != 0 {
    return Error(OutOfOrder())
  }
  http_send_head(mut r, "")?
  r.state = 2
  Ok(())
}

pub fn send_body(mut r: Request, body: Bytes) -> Result[(), HttpError] {
  if http_is_h2(r.transport) {
    return http_h2_send(mut r, Some(body), true)
  }
  if r.state != 0 {
    return Error(OutOfOrder())
  }
  let mut line: List[u8] = []
  text.append(mut line, "content-length: ")
  u64.format_into(core@1/bytes.len(body), mut line)
  text.append(mut line, "\r\n")
  let framing_line = text.finish(take line)
  let Ok(s) = framing_line else {
    return Error(Malformed(HeaderValue()))
  }
  http_send_head(mut r, s)?
  http_write(mut r, body)?
  r.sent_body = true
  r.state = 2
  Ok(())
}

fn http_begin_chunks(mut r: Request) -> Result[(), HttpError] {
  if r.state == 0 {
    http_send_head(mut r, "transfer-encoding: chunked\r\n")?
    r.state = 1
    r.sent_body = true
  }
  if r.state != 1 {
    return Error(OutOfOrder())
  }
  Ok(())
}

pub fn write_request_body(mut r: Request, data: Bytes) -> Result[(), HttpError] {
  if http_is_h2(r.transport) {
    return http_h2_request_write(mut r, data)
  }
  http_begin_chunks(mut r)?
  let len = core@1/bytes.len(data)
  if len == 0 {
    return Ok(())
  }
  let digits: Bytes = b"0123456789abcdef"
  let mut reversed: List[u8] = []
  let mut size = len
  while size > 0 {
    core@1/list.push(mut reversed, digits[size % 16])
    size /= 16
  }
  let mut out: List[u8] = []
  let mut i = core@1/list.len(reversed)
  while i > 0 {
    i -= 1
    core@1/list.push(mut out, reversed[i])
  }
  core@1/list.push(mut out, 13)
  core@1/list.push(mut out, 10)
  let prefix = core@1/bytes.from_list(take out)
  r.state = 5
  http_write(mut r, prefix)?
  http_write(mut r, data)?
  http_write(mut r, b"\r\n")?
  r.state = 1
  Ok(())
}

pub fn end_request_body(mut r: Request, request_trailers: List[Header]) -> Result[
  (),
  HttpError
] {
  if http_is_h2(r.transport) {
    return http_h2_request_end(mut r, request_trailers)
  }
  validate_headers(request_trailers)?
  for h in request_trailers {
    if http_same(h.name, "content-length") || http_same(h.name, "transfer-encoding") || http_same(
      h.name,
      "host"
    ) {
      return Error(Malformed(HeaderName()))
    }
  }
  http_begin_chunks(mut r)?
  r.state = 5
  let mut out: List[u8] = []
  text.append(mut out, "0\r\n")
  for h in request_trailers {
    text.append(mut out, h.name)
    text.append(mut out, ": ")
    text.append(mut out, h.value)
    text.append(mut out, "\r\n")
  }
  text.append(mut out, "\r\n")
  let wire_bytes = core@1/bytes.from_list(take out)
  http_write(mut r, wire_bytes)?
  r.state = 2
  Ok(())
}

// Batches use the existing noalloc parser without fixing Config.max_headers to
// an implementation capacity. Offsets always refer to the original input.
// A fixed scratch batch is not a message limit. Client, server and trailers
// collect batches under the configured count bound and merge framing across them.
type HttpHeadKind = ResponseHeaders | RequestHeaders | TrailerHeaders

type HttpHeaderFields {
  headers: List[Header],
  content_length: Option[u64],
  chunked: bool,
}

fn http_add_header_batch(
  mut fields: HttpHeaderFields,
  buf: Bytes,
  raw: Inline[http_wire.RawHeader, 16],
  count: u64,
  version: u8,
  limit: u64,
  kind: HttpHeadKind
) -> Result[(), HttpError] uses {} {
  if core@1/list.len(fields.headers) > limit || count > limit - core@1/list.len(
    fields.headers
  ) {
    return Error(Malformed(TooManyHeaders()))
  }
  let mut batch_cl: bool = false
  let mut batch_te: bool = false
  let mut hi: u64 = 0
  while hi < count {
    let name = http_text(buf, raw[hi].name_start, raw[hi].name_end)?
    if kind == TrailerHeaders() && (http_same(name, "content-length") || http_same(
      name,
      "transfer-encoding"
    ) || http_same(name, "host") || http_same(name, "connection")) {
      return Error(Malformed(HeaderName()))
    }
    if http_same(name, "content-length") {
      batch_cl = true
    }
    if version == 1 && http_same(name, "transfer-encoding") {
      batch_te = true
    }
    hi += 1
  }
  if (batch_cl || fields.content_length != None()) && (batch_te || fields.chunked) {
    return Error(Malformed(TransferEncoding()))
  }
  let frame = match http_wire.framing(buf, version, raw, count) {
    Ok(f) => f,
    Error(TransferEncoding()) => return Error(
      if kind == ResponseHeaders() {
        UnsupportedTransferEncoding()
      } else {
        Malformed(TransferEncoding())
      }
    ),
    Error(e) => return Error(Malformed(e)),
  }
  let mut i: u64 = 0
  while i < count {
    let h = raw[i]
    let name = http_text(buf, h.name_start, h.name_end)?
    let value = http_text(buf, h.value_start, h.value_end)?
    core@1/list.push(mut fields.headers, Header(name: take name, value: take value))
    i += 1
  }
  if let Some(value) = frame.content_length {
    if let Some(old) = fields.content_length {
      if old != value {
        return Error(Malformed(ContentLength()))
      }
    } else {
      fields.content_length = Some(value)
    }
  }
  if fields.chunked && frame.chunked {
    return Error(
      if kind == ResponseHeaders() {
        UnsupportedTransferEncoding()
      } else {
        Malformed(TransferEncoding())
      }
    )
  }
  fields.chunked = fields.chunked || frame.chunked
  if fields.chunked && fields.content_length != None() {
    return Error(Malformed(TransferEncoding()))
  }
  Ok(())
}

/// Parses a complete response head at the start of `buf`, returning it with the head's
/// byte length, or `None()` while it is incomplete. At most `config.max_headers` fields;
/// `head_request` says the response answers HEAD, so it has no body.
pub fn parse_response_head(buf: Bytes, config: Config, head_request: bool) -> Result[
  Option[(ResponseHead, u64)],
  HttpError
] uses {} {
  let empty = http_wire.RawHeader(
    name_start: 0,
    name_end: 0,
    value_start: 0,
    value_end: 0
  )
  let mut raw: Inline[http_wire.RawHeader, 16] = [
    empty,
    empty,
    empty,
    empty,
    empty,
    empty,
    empty,
    empty,
    empty,
    empty,
    empty,
    empty,
    empty,
    empty,
    empty,
    empty
  ]
  let mut line = http_wire.StatusLine(
    version: 0,
    code: 0,
    reason_start: 0,
    reason_end: 0
  )
  let mut count: u64 = 0
  let mut first: bool = true
  let mut start: u64 = 0
  let mut fields = HttpHeaderFields(headers: [], content_length: None(), chunked: false)
  while true {
    let parsed: Result[http_wire.ParseStatus, http_wire.HeadError] = if first {
      match http_wire.parse_response_line(buf, mut line, true) {
        Ok(Partial()) => Ok(Partial()),
        Ok(Complete(header_start)) => http_wire.parse_headers(
          buf,
          header_start,
          mut raw,
          mut count
        ),
        Error(error) => Error(error),
      }
    } else {
      http_wire.parse_headers(buf, start, mut raw, mut count)
    }
    let mut complete: bool = false
    match parsed {
      Ok(Partial()) => return Ok(None()),
      Ok(Complete(end)) => {
        start = end
        complete = true
      },
      Error(TooManyHeaders()) => {
        start = raw[count - 1].value_end
        while start < core@1/bytes.len(buf) && buf[start] != 10 {
          start += 1
        }
        start += 1
      },
      Error(e) => return Error(Malformed(e)),
    }
    http_add_header_batch(
      mut fields,
      buf,
      raw,
      count,
      line.version,
      config.max_headers,
      ResponseHeaders()
    )?
    if complete {
      let headers = copy fields.headers
      let content_length = fields.content_length
      let chunked = fields.chunked
      // Reason is informational; invalid UTF-8 is empty.
      let reason = match http_text(buf, line.reason_start, line.reason_end) {
        Ok(value) => take value,
        Error(_) => "",
      }
      let location = header(headers, "location")
      let content_type = header(headers, "content-type")
      let keep_alive = http_server_keep_alive(
        headers,
        if line.version == 1 {
          Http11()
        } else {
          Http10()
        }
      ) && !(line.version == 0 && header(headers, "transfer-encoding") != None()) && (head_request || chunked || content_length != None() || line.code < 200 || line.code == 204 || line.code == 304)
      return Ok(
        Some(
          (
            ResponseHead(
              version: if line.version == 0 {
                Http10()
              } else {
                Http11()
              },
              status: line.code,
              reason: take reason,
              headers: take headers,
              content_length: content_length,
              chunked: chunked,
              keep_alive: keep_alive,
              location: take location,
              content_type: take content_type
            ),
            start
          )
        )
      )
    }
    first = false
  }
  Ok(None())
}

fn http_buffer_error(error: bufio.ReadError[NetError]) -> HttpError uses {} {
  match error {
    Source(e) => Net(e),
    Limit() => HeadTooLarge(),
    UnexpectedEof() => Truncated(),
    InvalidUtf8() => Malformed(HeaderValue()),
    InvalidRead() => Net(InvalidInput()),
  }
}

@preserves_captures(r)
fn http_read_more(mut r: Request, max: u64) -> Result[u64, HttpError] {
  http_transport_read_more(mut r.transport, max)
}

fn http_next_head(mut r: Request) -> Result[ResponseHead, HttpError] {
  while true {
    let buf = http_input_contents(r.transport.input)
    if let Some((head, end)) = parse_response_head(buf, r.config, r.method == Head())? {
      if end > r.config.max_head_bytes {
        return Error(HeadTooLarge())
      }
      http_input_consume(mut r.transport.input, end)
      return Ok(take head)
    }
    let have = http_input_buffered(r.transport.input)
    if have >= r.config.max_head_bytes {
      return Error(HeadTooLarge())
    }
    let space = r.config.max_head_bytes - have
    if http_read_more(
      mut r,
      if space > 4096 {
        4096
      } else {
        space
      }
    )? == 0 {
      return Error(Truncated())
    }
  }
  Error(Truncated())
}

fn http_redirect(mut r: Request, head: ResponseHead) -> Result[(), HttpError] {
  if r.redirects == 0 {
    return Error(TooManyRedirects())
  }
  let Some(location) = head.location else {
    return Error(RedirectLocationInvalid())
  }
  let Ok(parsed_uri) = uri.resolve(r.uri, location) else {
    return Error(RedirectLocationInvalid())
  }
  http_validate_target(uri.component_encoded(parsed_uri.path, Path()))?
  if let Some(q) = parsed_uri.query {
    http_validate_target(uri.component_encoded(q, Query()))?
  }
  let changed = !http_same(r.uri.scheme, parsed_uri.scheme) || http_host(r.uri)? != http_host(
    parsed_uri
  )? || http_port(r.uri) != http_port(parsed_uri)
  let to_get = head.status == 303 || (head.status == 301 || head.status == 302) && r.method == Post()
  if !to_get && r.sent_body {
    return Error(RedirectRequiresResend())
  }
  let mut headers: List[Header] = []
  for h in r.headers {
    if !(changed && (http_same(h.name, "authorization") || http_same(h.name, "cookie") || http_same(
      h.name,
      "proxy-authorization"
    ))) && !(to_get && (http_same(h.name, "content-type") || http_same(
      h.name,
      "content-length"
    ) || http_same(h.name, "transfer-encoding"))) {
      core@1/list.push(mut headers, unique h)
    }
  }
  // Replace the complete connection state so Net and Stream move together
  // with their sibling brand, as in Client.request's fresh redirect reader.
  let next_method: Method = if to_get {
    Get()
  } else {
    r.method
  }
  let next_url = uri.to_string(parsed_uri)
  let mut fresh = request(r.transport.net, r.config, next_method, next_url, headers)?
  fresh.persistent = r.persistent
  fresh.redirects = r.redirects - 1
  r = take fresh
  send_bodiless(mut r)
}

pub fn receive_head(mut r: Request) -> Result[ResponseHead, HttpError] {
  if http_is_h2(r.transport) {
    return http_h2_receive_head(mut r)
  }
  if r.state != 2 {
    return Error(OutOfOrder())
  }
  r.state = 5
  while true {
    let head = http_next_head(mut r)?
    if head.status == 100 {
      continue
    }
    let no_body = r.method == Head() || head.status >= 100 && head.status < 200 || head.status == 204 || head.status == 304
    if !no_body && (head.status == 301 || head.status == 302 || head.status == 303 || head.status == 307 || head.status == 308) {
      http_redirect(mut r, head)?
      r.state = 5
      continue
    }
    r.reusable = r.persistent && head.keep_alive && head.status >= 200
    if no_body {
      r.body_kind = 1
      r.state = 4
    } else {
      r.state = 3
      if head.chunked {
        r.body_kind = 2
        r.remaining = 0
      } else {
        match head.content_length {
          Some(len) => {
            r.body_kind = 1
            r.remaining = len
            if len == 0 {
              r.state = 4
            }
          },
          None() => {
            r.body_kind = 0
          },
        }
      }
    }
    return Ok(take head)
  }
  Error(Truncated())
}

// Zig Reader.State.body_remaining_chunk_len: head -> data -> suffix -> head.
@preserves_captures(r)
fn http_chunk_head(mut r: Request) -> Result[(), HttpError] {
  if r.chunk_suffix {
    while http_input_buffered(r.transport.input) < 2 {
      if http_read_more(mut r, 4096)? == 0 {
        return Error(Truncated())
      }
    }
    let suffix = http_input_contents(r.transport.input)
    if suffix[0] != 13 || suffix[1] != 10 {
      return Error(Chunk())
    }
    http_input_consume(mut r.transport.input, 2)
    r.chunk_suffix = false
  }
  while true {
    let buf = http_input_contents(r.transport.input)
    match http_wire.parse_chunk_size(buf, 0) {
      Error(_) => return Error(Chunk()),
      Ok(Complete(consumed, size)) => {
        http_input_consume(mut r.transport.input, consumed)
        r.remaining = size
        if size == 0 {
          http_read_trailers(mut r)?
          r.state = 4
        }
        return Ok(())
      },
      Ok(Partial()) => (),
    }
    let have = http_input_buffered(r.transport.input)
    if have >= r.config.max_head_bytes {
      return Error(HeadTooLarge())
    }
    let space = r.config.max_head_bytes - have
    if http_read_more(
      mut r,
      if space > 4096 {
        4096
      } else {
        space
      }
    )? == 0 {
      return Error(Truncated())
    }
  }
  Error(Truncated())
}

@preserves_captures(r)
fn http_read_trailers(mut r: Request) -> Result[(), HttpError] {
  // Prefix a synthetic status line to reuse strict batched header parsing.
  let mut collected: List[u8] = []
  text.append(mut collected, "HTTP/1.1 200 OK\r\n")
  while true {
    let count = http_input_buffered(r.transport.input)
    let unread = http_input_contents(r.transport.input)
    let mut i: u64 = 0
    while i < count {
      core@1/list.push(mut collected, unread[i])
      i += 1
    }
    http_input_consume(mut r.transport.input, count)
    let buf = core@1/bytes.from_list(copy collected)
    if let Some((head, end)) = parse_response_head(buf, r.config, true)? {
      if end - 17 > r.config.max_head_bytes {
        return Error(HeadTooLarge())
      }
      r.response_trailers = unique head.headers
      return Ok(())
    }
    let have = core@1/list.len(collected) - 17
    if have >= r.config.max_head_bytes {
      return Error(HeadTooLarge())
    }
    let space = r.config.max_head_bytes - have
    if http_read_more(
      mut r,
      if space > 4096 {
        4096
      } else {
        space
      }
    )? == 0 {
      return Error(Truncated())
    }
  }
  Error(Truncated())
}

@preserves_unique(out)
@preserves_captures(r)
pub fn read_body(mut r: Request, mut out: List[u8], max: u64) -> Result[u64, HttpError] {
  if http_is_h2(r.transport) {
    return http_h2_read_body(mut r, mut out, max)
  }
  if max == 0 {
    return Error(http_net_error(InvalidInput()))
  }
  if r.state == 4 {
    return Ok(0)
  }
  if r.state != 3 {
    return Error(OutOfOrder())
  }
  if r.body_kind == 2 && r.remaining == 0 {
    http_chunk_head(mut r)?
    if r.state == 4 {
      return Ok(0)
    }
  }
  if http_input_buffered(r.transport.input) == 0 {
    if http_read_more(
      mut r,
      if max > 4096 {
        4096
      } else {
        max
      }
    )? == 0 {
      if r.body_kind != 0 {
        return Error(Truncated())
      }
      r.state = 4
      return Ok(0)
    }
  }
  let mut count = http_input_buffered(r.transport.input)
  if count > max {
    count = max
  }
  if r.body_kind != 0 && count > r.remaining {
    count = r.remaining
  }
  let data = http_input_contents(r.transport.input)
  // The buffered range is already bounded by max and the frame remainder.
  core@1/bytes.append(mut out, core@1/bytes.slice(data, 0u64, count))
  http_input_consume(mut r.transport.input, count)
  if r.body_kind != 0 {
    r.remaining -= count
    if r.remaining == 0 {
      if r.body_kind == 1 {
        r.state = 4
      } else {
        r.chunk_suffix = true
      }
    }
  }
  Ok(count)
}

pub fn read_all(mut r: Request, limit: u64) -> Result[unique Bytes, HttpError] {
  let mut out: List[u8] = []
  while true {
    let len = core@1/list.len(out)
    // Read one byte beyond the bound, including when limit is zero. Avoid
    // overflow at u64::MAX, and do not allocate a limit-sized buffer up front.
    let space: u64 = if len == limit {
      1
    } else if limit - len > 4096 {
      4096
    } else {
      limit - len
    }
    let count = read_body(mut r, mut out, space)?
    if core@1/list.len(out) > limit {
      return Error(BodyTooLarge())
    }
    if count == 0 {
      return Ok(core@1/bytes.from_list(take out))
    }
  }
  Error(Truncated())
}

pub fn trailers(r: Request) -> unique List[Header] {
  unique r.response_trailers
}

pub fn fetch(
  n: Net,
  config: Config,
  method: Method,
  url: String,
  headers: List[Header],
  body: Option[Bytes]
) -> Result[Response, HttpError] {
  http_fetch(n, config, method, url, headers, body, 10485760, 10485760)
}

/// One-shot fetch with an explicit raw and decoded body limit. Config's
/// max_body_bytes is an additional raw-body bound; decoding uses `limit`.
/// A zero limit admits only an empty body. Status errors precede body reads.
pub fn fetch_bounded(
  n: Net,
  config: Config,
  method: Method,
  url: String,
  headers: List[Header],
  body: Option[Bytes],
  limit: u64
) -> Result[Response, HttpError] {
  let raw_limit = if config.max_body_bytes < limit {
    config.max_body_bytes
  } else {
    limit
  }
  http_fetch(n, config, method, url, headers, body, raw_limit, limit)
}

fn http_fetch(
  n: Net,
  config: Config,
  method: Method,
  url: String,
  headers: List[Header],
  body: Option[Bytes],
  raw_limit: u64,
  decoded_limit: u64
) -> Result[Response, HttpError] {
  let (sent, decoding) = http_offer_codings(config, headers)
  let mut r = request(n, config, method, url, sent)?
  match body {
    Some(data) => send_body(mut r, data)?,
    None() => send_bodiless(mut r)?,
  }
  let head = receive_head(mut r)?
  if config.status_as_error && head.status >= 400 && head.status <= 599 {
    return Error(Status(head.status))
  }
  let data = read_all(mut r, raw_limit)?
  let response = Response(
    status: head.status,
    headers: unique head.headers,
    body: take data,
    url: unique r.url
  )
  if decoding {
    return http_decoded(take response, decoded_limit)
  }
  Ok(take response)
}

/// A sequential client owns its idle connections. Only complete, framed responses
/// return a connection to the pool. Failed exchanges are never retried, including
/// writes on stale connections: callers decide whether resending is safe.
/// Supply a clock for idle_timeout, or disable idle_timeout and pass None().
pub opaque resource type Client: noalloc_drop uses {Net, MonotonicClock} {
  net: Net,
  clock: Option[MonotonicClock],
  config: Config,
  idle: List[Request],
}
@noalloc drop(self) {}

pub fn client(n: Net, clock: Option[MonotonicClock], config: Config) -> Result[
  Client,
  HttpError
] {
  http_timeout(config.idle_timeout)?
  let no_clock = match clock {
    None() => true,
    Some(_) => false,
  }
  if config.idle_timeout != None() && no_clock || config.max_idle_connections_per_host == 0 {
    return Error(http_net_error(InvalidInput()))
  }
  Ok(Client(net: n, clock: clock, config: unique config, idle: []))
}

/// Drop every idle stream. The Client remains usable.
pub fn close_idle(mut c: Client) {
  c.idle = []
}

fn http_client_now(c: Client) -> Result[u64, HttpError] {
  match c.clock {
    None() => Ok(0),
    Some(clock) => Ok(
      core@1/instant.ticks(core@1/clock.monotonic(clock) ? http_clock_error)
    ),
  }
}

fn http_same_origin(a: uri.Uri, b: uri.Uri) -> Result[bool, HttpError] uses {} {
  Ok(
    http_same(a.scheme, b.scheme) && http_host(a)? == http_host(b)? && http_port(a) == http_port(
      b
    )
  )
}

fn http_client_request(
  mut c: Client,
  method: Method,
  url: String,
  headers: List[Header]
) -> Result[Request, HttpError] {
  validate_headers(headers)?
  let parsed = uri.parse(url)?
  if !http_same(parsed.scheme, "http") && !http_same(parsed.scheme, "https") {
    return Error(UnsupportedScheme())
  }
  http_validate_target(uri.component_encoded(parsed.path, Path()))?
  if let Some(q) = parsed.query {
    http_validate_target(uri.component_encoded(q, Query()))?
  }
  let now = http_client_now(c)?
  let timeout = http_timeout(c.config.idle_timeout)?
  let pending = replace(mut c.idle, [])
  let mut selected: Option[Request] = None()
  // Move resource elements through the bounded list. No counted buffer or
  // connection is copied, and no deep-uniqueness promise is needed from I/O.
  for stored in take pending {
    let expired = match timeout {
      Unbounded() => false,
      Nanos(ns) => now - stored.idle_since >= ns,
    }
    if !expired {
      if option.is_none(selected) && http_same_origin(stored.uri, parsed)? {
        selected = Some(take stored)
      } else {
        core@1/list.push(mut c.idle, take stored)
      }
    }
  }
  let mut r = match take selected {
    Some(stored) => take stored,
    None() => request(c.net, c.config, method, url, headers)?,
  }
  r.method = method
  r.uri = unique parsed
  r.url = unique url
  r.headers = unique headers
  r.redirects = c.config.max_redirects
  r.state = 0
  r.sent_body = false
  r.body_kind = 0
  r.remaining = 0
  r.chunk_suffix = false
  r.response_trailers = []
  r.reusable = false
  r.stream_id = 0
  r.body_end = false
  r.body_offset = 0
  r.body_data = b""
  r.body_credit = 0
  r.persistent = http_server_keep_alive(headers, Http11())
  Ok(take r)
}

/// Bound the complete exchange, including connect, TLS, redirects and body reads,
/// with task.scope_until: take the Client into the body, then return it with the
/// outcome. Finished and Expired both retain that pair for the next call.
/// Expired contains the body's result; cancellation is Net(Canceled(cause)).
/// A cancelled exchange never returns its checked-out stream to the idle pool.
///
/// Fetch with connection reuse. The exclusive borrow permits one exchange at a
/// time per Client; use one Client per concurrent worker. The per-host limit
/// bounds idle connections only. max_idle_connections bounds the entire idle pool.
pub fn client_fetch(
  mut c: Client,
  method: Method,
  url: String,
  headers: List[Header],
  body: Option[Bytes]
) -> Result[Response, HttpError] {
  let (sent, decoding) = http_offer_codings(c.config, headers)
  let mut r = http_client_request(mut c, method, url, sent)?
  match body {
    Some(data) => send_body(mut r, data)?,
    None() => send_bodiless(mut r)?,
  }
  let head = receive_head(mut r)?
  let data = read_all(mut r, c.config.max_body_bytes)?
  let response = Response(
    status: head.status,
    headers: unique head.headers,
    body: take data,
    url: unique r.url
  )
  if r.reusable && r.body_kind != 0 && r.state == 4 && (http_is_h2(r.transport) || http_input_buffered(
    r.transport.input
  ) == 0) && !r.transport.draining && c.config.max_idle_connections > 0 {
    let mut same_host: u64 = 0
    for idle in c.idle {
      if http_same_origin(idle.uri, r.uri)? {
        same_host += 1
      }
    }
    if same_host < c.config.max_idle_connections_per_host {
      r.idle_since = http_client_now(c)?
      if core@1/list.len(c.idle) >= c.config.max_idle_connections {
        let pending = replace(mut c.idle, [])
        let mut first = true
        for stored in take pending {
          if !first {
            core@1/list.push(mut c.idle, take stored)
          }
          first = false
        }
      }
      core@1/list.push(mut c.idle, take r)
    }
  }
  if c.config.status_as_error && head.status >= 400 && head.status <= 599 {
    return Error(Status(head.status))
  }
  if decoding {
    return http_decoded(take response, c.config.max_body_bytes)
  }
  Ok(take response)
}

/// An encoded request body and its media type. client_send installs exactly one
/// Content-Type, replacing any Content-Type supplied in its headers argument.
@serializable
pub type Body {
  bytes: Bytes,
  content_type: String,
}

pub fn form_body(pairs: List[(String, String)]) -> Body uses {} {
  let encoded = uri.encode_query(pairs)
  Body(
    bytes: unique core@1/string.as_bytes(encoded),
    content_type: "application/x-www-form-urlencoded"
  )
}

fn http_json_error(error: json.JsonError) -> HttpError uses {} {
  Json(unique error)
}

pub fn json_body(value: json.Value) -> Result[Body, HttpError] uses {} {
  let mut out: List[u8] = []
  json.stringify_into(value, mut out) ? http_json_error
  Ok(Body(bytes: core@1/bytes.from_list(take out), content_type: "application/json"))
}

pub fn response_json(response: Response) -> Result[json.Value, HttpError] uses {} {
  let text = match core@1/string.from_bytes(unique response.body) {
    Ok(text) => take text,
    Error(_) => return Error(InvalidJsonUtf8()),
  }
  Ok(json.parse(take text) ? http_json_error)
}

pub fn client_send(
  mut c: Client,
  method: Method,
  url: String,
  headers: List[Header],
  body: Body
) -> Result[Response, HttpError] {
  let mut prepared: List[Header] = []
  for h in headers {
    if !http_same(h.name, "content-type") {
      core@1/list.push(mut prepared, unique h)
    }
  }
  core@1/list.push(
    mut prepared,
    Header(name: "Content-Type", value: unique body.content_type)
  )
  client_fetch(mut c, method, url, prepared, Some(body.bytes))
}

// A sequential server connection owns its stream and unread bytes. A response
// must finish before the next request can be received (RFC 9112 section 9).
// state: ready=0, response pending=1, closed=2, request failed=3,
// chunked response=4, close-delimited response=5, bodyless response=6.
// Server dispatch carries only the limits used by request framing and IO.
// Client roots, user-agent strings and pooling policy stay out of each stream.
type HttpServerConfig {
  max_head_bytes: u64,
  max_body_bytes: u64,
  max_headers: u64,
  read_timeout: Option[time.Duration],
  write_timeout: Option[time.Duration],
  idle_timeout: Option[time.Duration],
}

fn http_server_config(config: Config) -> HttpServerConfig uses {} {
  HttpServerConfig(
    max_head_bytes: config.max_head_bytes,
    max_body_bytes: config.max_body_bytes,
    max_headers: config.max_headers,
    read_timeout: config.read_timeout,
    write_timeout: config.write_timeout,
    idle_timeout: config.idle_timeout
  )
}

resource type HttpExchange: noalloc_drop uses {Net, Tasks} {
  tasks: Tasks,
  active: Atomic[u8],
  transport: HttpTransport,
  config: HttpServerConfig,
  state: u8,
  keep_alive: bool,
  served: bool,
  version: Version,
  head_request: bool,
  stream_id: u32,
}
@noalloc drop(self) {
  core@1/atomic.store(self.tasks, self.active, 3u8)
}

fn http_exchange(
  tasks: Tasks,
  take active: Atomic[u8],
  n: Net,
  take stream: Stream of n,
  config: Config
) -> HttpExchange {
  HttpExchange(
    tasks: tasks,
    active: active,
    transport: http_transport(
      n,
      take stream,
      config.http2_prior_knowledge,
      Server(),
      config
    ),
    config: http_server_config(config),
    state: 0,
    keep_alive: false,
    served: false,
    version: Http11(),
    head_request: false,
    stream_id: 0
  )
}

// The TLS twin of server_connection: a server handshake on an accepted stream,
// bounded by the config's read and write timeouts, then the keep-alive server.
pub fn serve_tls(
  tasks: Tasks,
  n: Net,
  take stream: Stream of n,
  server: TlsServer,
  config: Config
) -> Result[ServerConnection, HttpError] {
  let rt = http_timeout(config.read_timeout)?
  let wt = http_timeout(config.write_timeout)?
  let mut plain = take stream
  // A ListenTls stream allows options before its handshake.
  core@1/net.set_read_timeout(n, mut plain, rt) ? http_net_error
  core@1/net.set_write_timeout(n, mut plain, wt) ? http_net_error
  // rustls records ALPN during the handshake; choose the codec from that
  // result, independently of the cleartext prior-knowledge configuration.
  let secure = core@1/tls.accept(n, take plain, server) ? http_net_error
  let negotiated = core@1/tls.negotiated_protocol(n, secure) ? http_net_error
  let mut selected = copy config
  selected.http2_prior_knowledge = negotiated == Some("h2")
  Ok(server_connection(tasks, n, take secure, selected))
}

/// A server connection after an HTTP/1.1 request, with the bytes already read past that
/// request, for a protocol that takes over the connection (WebSocket, an event stream)
/// and writes its own response. The connection serves no further requests.
pub resource type Detached: noalloc_drop uses {Net} {
  net: Net,
  stream: Stream of .net,
  input: bufio.Reader,
}
@noalloc drop(self) {}

/// Hands over the connection once `next_stream` has yielded this stream and before any
/// response; otherwise `OutOfOrder()`, as for an HTTP/2 stream, whose connection other
/// streams share (`Closed()` once closed).
pub fn detach(take s: ServerStream) -> Result[Detached, HttpError] {
  let state = http_stream_state(s)
  if state == 2 {
    return Error(Closed())
  }
  if state != 1 || s.version == Http2() {
    return Error(OutOfOrder())
  }
  let mut owned = take s
  let Some(transfer) = replace(mut owned.exchange, None()) else {
    return Error(OutOfOrder())
  }
  // As http_exchange_from_transfer, without rebuilding the exchange: the stream and
  // its unread bytes leave, and the connection sees the exchange as gone.
  let HttpTransfer(tasks: tasks, active: active, net: n, stream: stream, data: data) = take transfer
  core@1/atomic.store(tasks, active, 3u8)
  let mut serial = match take data {
    Serial(current) => take current,
    Multiplexed(_) => return Error(OutOfOrder()),
  }
  let mut unread = replace(mut serial.input, HttpInput(bytes: [], offset: 0))
  let have = http_input_buffered(unread)
  let mut input = bufio.new(
    if have > 4096 {
      have
    } else {
      4096
    }
  )
  while http_input_buffered(unread) > 0 {
    let left = http_input_buffered(unread)
    match bufio.read_more(mut input, mut unread, http_input_refill, left) {
      Ok(0) | Error(_) => return Error(Closed()),
      Ok(_) => (),
    }
  }
  Ok(Detached(net: n, stream: take stream, input: input))
}

// Moves up to `max` unread bytes of `source` to `out`, for bufio.read_more.
@preserves_unique(out)
fn http_input_refill(mut source: HttpInput, mut out: List[u8], max: u64) -> Result[
  u64,
  ()
] uses {} {
  let have = http_input_buffered(source)
  let count = if max < have {
    max
  } else {
    have
  }
  let mut i: u64 = 0
  while i < count {
    core@1/list.push(mut out, source.bytes[source.offset + i])
    i += 1
  }
  source.offset += count
  Ok(count)
}

// All Connection fields contribute tokens; close wins regardless of order.
fn http_server_keep_alive(headers: List[Header], version: Version) -> bool uses {} {
  let mut keep = version == Http11()
  let mut closed = false
  for h in headers {
    if http_same(h.name, "connection") {
      let tokens = string.split(unique h.value, ",")
      for token in tokens {
        let value = string.trim(token)
        if http_same(value, "close") {
          closed = true
        }
        if http_same(value, "keep-alive") {
          keep = true
        }
      }
    }
  }
  keep && !closed
}

@serializable
pub type ServerRequest {
  method: String,
  target: String,
  version: Version,
  headers: List[Header],
  body: Bytes,
  trailers: List[Header],
  keep_alive: bool,
}

/// A parsed HTTP/1 head whose fields are byte spans over one retained buffer.
/// Accessors materialize only the fields the handler uses. The view may outlive
/// the callback: subsequent reads preserve its immutable bytes.
pub opaque type ServerRequestView: copyable + inert + noalloc_drop uses {} {
  data: Bytes,
  line: http_wire.RequestLine,
  headers: List[http_wire.RawHeader],
  version: Version,
  keep_alive: bool,
  body: Bytes,
  trailers: List[Header],
}

pub fn server_request_method(r: ServerRequestView) -> unique String uses {} {
  // Construction validated UTF-8 and the request-line syntax.
  match http_text(r.data, r.line.method_start, r.line.method_end) {
    Ok(value) => take value,
    Error(_) => "",
  }
}

pub fn server_request_target(r: ServerRequestView) -> unique String uses {} {
  match http_text(r.data, r.line.target_start, r.line.target_end) {
    Ok(value) => take value,
    Error(_) => "",
  }
}

pub fn server_request_header(r: ServerRequestView, name: String) -> Option[String] uses {} {
  for h in r.headers {
    if http_token_is(r.data, h.name_start, h.name_end, name) {
      return Some(
        match http_text(r.data, h.value_start, h.value_end) {
          Ok(value) => take value,
          Error(_) => "",
        }
      )
    }
  }
  None()
}

pub fn server_request_owned(r: ServerRequestView) -> unique ServerRequest uses {} {
  let mut headers: List[Header] = []
  for h in r.headers {
    let name = match http_text(r.data, h.name_start, h.name_end) {
      Ok(value) => take value,
      Error(_) => "",
    }
    let value = match http_text(r.data, h.value_start, h.value_end) {
      Ok(value) => take value,
      Error(_) => "",
    }
    core@1/list.push(mut headers, Header(name: take name, value: take value))
  }
  ServerRequest(
    method: server_request_method(r),
    target: server_request_target(r),
    version: r.version,
    keep_alive: r.keep_alive,
    headers: take headers,
    body: unique r.body,
    trailers: unique r.trailers
  )
}

pub fn server_request_body(r: ServerRequestView) -> Bytes in r uses {} {
  r.body
}

pub fn server_request_version(r: ServerRequestView) -> Version uses {} {
  r.version
}

// A validation view: unlike http_text, this never builds a per-field byte list.
fn http_span_text(take buf: Bytes, start: u64, end: u64) -> Result[String, HttpError] uses {} {
  match core@1/string.from_bytes(copy core@1/bytes.slice(buf, start, end)) {
    Ok(value) => Ok(take value),
    Error(_) => Error(Malformed(HeaderValue())),
  }
}

// Incremental request-body framing. The receive path consumes wire bytes as they
// are decoded; only one incomplete metadata line and the decoded body are retained.
type ServerBody {
  chunked: bool,
  state: u8,
  remaining: u64,
  output: List[u8],
  trailers: List[Header],
}

fn http_server_body(frame: http_wire.Framing, limit: u64) -> Result[
  ServerBody,
  HttpError
] uses {} {
  let length = match frame.content_length {
    Some(n) => n,
    None() => 0,
  }
  if length > limit {
    return Error(BodyTooLarge())
  }
  Ok(
    ServerBody(
      chunked: frame.chunked,
      state: if frame.chunked {
        1u8
      } else {
        2u8
      },
      remaining: length,
      output: [],
      trailers: []
    )
  )
}

fn http_server_trailers(buf: Bytes, start: u64, config: HttpServerConfig) -> Result[
  Option[(List[Header], u64)],
  HttpError
] uses {} {
  let size = core@1/bytes.len(buf) - start
  let bounded = core@1/bytes.slice(
    buf,
    start,
    start + if size > config.max_head_bytes {
      config.max_head_bytes
    } else {
      size
    }
  )
  let empty = http_wire.RawHeader(
    name_start: 0,
    name_end: 0,
    value_start: 0,
    value_end: 0
  )
  let mut raw: Inline[http_wire.RawHeader, 16] = [
    empty,
    empty,
    empty,
    empty,
    empty,
    empty,
    empty,
    empty,
    empty,
    empty,
    empty,
    empty,
    empty,
    empty,
    empty,
    empty
  ]
  let mut count: u64 = 0
  let mut pos: u64 = 0
  let mut fields = HttpHeaderFields(headers: [], content_length: None(), chunked: false)
  while true {
    let mut complete = false
    match http_wire.parse_headers(bounded, pos, mut raw, mut count) {
      Ok(Partial()) => {
        if size >= config.max_head_bytes {
          return Error(HeadTooLarge())
        }
        return Ok(None())
      },
      Ok(Complete(end)) => {
        pos = end
        complete = true
      },
      Error(TooManyHeaders()) => {
        pos = raw[count - 1].value_end
        while pos < core@1/bytes.len(bounded) && bounded[pos] != 10 {
          pos += 1
        }
        pos += 1
      },
      Error(error) => return Error(Malformed(error)),
    }
    http_add_header_batch(
      mut fields,
      bounded,
      raw,
      count,
      1u8,
      config.max_headers,
      TrailerHeaders()
    )?
    if complete {
      return Ok(Some((copy fields.headers, start + pos)))
    }
  }
  Ok(None())
}

// Returns exactly the consumed prefix. An incomplete size line, suffix or trailer
// stays with the caller; payload bytes already decoded need never be buffered again.
fn http_server_body_step(mut body: ServerBody, buf: Bytes, config: HttpServerConfig) -> Result[
  u64,
  HttpError
] uses {} {
  let end = core@1/bytes.len(buf)
  let mut pos: u64 = 0
  while body.state != 5 {
    if body.state == 1 {
      let (consumed, size) = match http_wire.parse_chunk_size(buf, pos) {
        Ok(Partial()) => {
          if end - pos >= config.max_head_bytes {
            return Error(HeadTooLarge())
          }
          return Ok(pos)
        },
        Ok(Complete(consumed, size)) => (consumed, size),
        Error(_) => return Error(Chunk()),
      }
      if consumed > config.max_head_bytes {
        return Error(HeadTooLarge())
      }
      if size > config.max_body_bytes - core@1/list.len(body.output) {
        return Error(BodyTooLarge())
      }
      pos += consumed
      body.remaining = size
      body.state = if size == 0 {
        4u8
      } else {
        2u8
      }
    } else if body.state == 2 {
      let count = if body.remaining < end - pos {
        body.remaining
      } else {
        end - pos
      }
      let mut i: u64 = 0
      while i < count {
        core@1/list.push(mut body.output, buf[pos + i])
        i += 1
      }
      pos += count
      body.remaining -= count
      if body.remaining != 0 {
        return Ok(pos)
      }
      body.state = if body.chunked {
        3u8
      } else {
        5u8
      }
    } else if body.state == 3 {
      if end - pos < 2 {
        return Ok(pos)
      }
      if buf[pos] != 13 || buf[pos + 1] != 10 {
        return Error(Chunk())
      }
      pos += 2
      body.state = 1
    } else {
      let Some((headers, consumed)) = http_server_trailers(buf, pos, config)? else {
        return Ok(pos)
      }
      body.trailers = copy headers
      pos = consumed
      body.state = 5
    }
  }
  Ok(pos)
}

// Parse the request head once, before incrementally consuming its body.
fn http_server_head(buf: Bytes, config: HttpServerConfig) -> Result[
  Option[(ServerRequest, http_wire.Framing, u64)],
  HttpError
] uses {} {
  let size = core@1/bytes.len(buf)
  let bounded = core@1/bytes.slice(
    buf,
    0,
    if size > config.max_head_bytes {
      config.max_head_bytes
    } else {
      size
    }
  )
  let empty = http_wire.RawHeader(
    name_start: 0,
    name_end: 0,
    value_start: 0,
    value_end: 0
  )
  let mut raw: Inline[http_wire.RawHeader, 16] = [
    empty,
    empty,
    empty,
    empty,
    empty,
    empty,
    empty,
    empty,
    empty,
    empty,
    empty,
    empty,
    empty,
    empty,
    empty,
    empty
  ]
  let mut line = http_wire.RequestLine(
    method_start: 0,
    method_end: 0,
    target_start: 0,
    target_end: 0,
    version: 0
  )
  let mut count: u64 = 0
  let mut first = true
  let mut start: u64 = 0
  let mut fields = HttpHeaderFields(headers: [], content_length: None(), chunked: false)
  while true {
    let parsed = if first {
      http_wire.parse_request(bounded, mut line, mut raw, mut count)
    } else {
      http_wire.parse_headers(bounded, start, mut raw, mut count)
    }
    let mut complete = false
    match parsed {
      Ok(Partial()) => {
        if size >= config.max_head_bytes {
          return Error(HeadTooLarge())
        }
        return Ok(None())
      },
      Ok(Complete(end)) => {
        start = end
        complete = true
      },
      Error(TooManyHeaders()) => {
        start = raw[count - 1].value_end
        while start < core@1/bytes.len(bounded) && bounded[start] != 10 {
          start += 1
        }
        start += 1
      },
      Error(error) => return Error(Malformed(error)),
    }
    http_add_header_batch(
      mut fields,
      bounded,
      raw,
      count,
      line.version,
      config.max_headers,
      RequestHeaders()
    )?
    if complete {
      let end = start
      let headers = copy fields.headers
      let frame = http_wire.Framing(
        content_length: fields.content_length,
        chunked: fields.chunked,
        keep_alive: false
      )
      return Ok(
        Some(
          (
            internal.http1_parse.http_server_incoming(buf, line, take headers)?,
            frame,
            end
          )
        )
      )
    }
    first = false
  }
  Ok(None())
}

// Complete includes decoded body and trailers; subsequent bytes belong to the next request.
pub fn parse_server_request(buf: Bytes, config: Config) -> Result[
  Option[(ServerRequest, u64)],
  HttpError
] uses {} {
  let limits = http_server_config(config)
  let mut Some((incoming, frame, end)) = http_server_head(buf, limits)? else {
    return Ok(None())
  }
  let mut body = http_server_body(frame, config.max_body_bytes)?
  let consumed = http_server_body_step(
    mut body,
    core@1/bytes.slice(buf, end, core@1/bytes.len(buf)),
    limits
  )?
  if body.state != 5 {
    return Ok(None())
  }
  incoming.body = core@1/bytes.from_list(copy body.output)
  incoming.trailers = copy body.trailers
  Ok(Some((take incoming, end + consumed)))
}

fn http_clock_error(error: ClockError) -> HttpError uses {} {
  Clock(error)
}

// A request keeps one absolute budget, sampled from the explicitly supplied clock.
fn http_server_deadline(clock: Option[MonotonicClock], timeout: Option[time.Duration]) -> Result[
  Option[u64],
  HttpError
] {
  let Nanos(interval) = http_timeout(timeout)? else {
    return Ok(None())
  }
  let Some(c) = clock else {
    return Error(http_net_error(InvalidInput()))
  }
  let now = core@1/clock.monotonic(c) ? http_clock_error
  match core@1/instant.checked_add(c, now, interval) {
    Some(end) => Ok(Some(core@1/instant.ticks(end))),
    None() => Error(http_clock_error(OutOfRange())),
  }
}

fn http_server_remaining(clock: Option[MonotonicClock], deadline: Option[u64]) -> Result[
  NetTimeout,
  HttpError
] {
  let Some(end) = deadline else {
    return Ok(Unbounded())
  }
  let Some(c) = clock else {
    return Error(http_net_error(InvalidInput()))
  }
  let now = core@1/instant.ticks(core@1/clock.monotonic(c) ? http_clock_error)
  if now >= end {
    return Error(RequestTimeout())
  }
  Ok(Nanos(end - now))
}

fn http_server_expired(mut c: HttpExchange) -> Result[u64, HttpError] {
  http_respond(mut c, 408u16, [], b"Request Timeout", true)?
  Error(RequestTimeout())
}

fn http_server_read_more(
  mut c: HttpExchange,
  idle: bool,
  clock: Option[MonotonicClock],
  deadline: Option[u64]
) -> Result[u64, HttpError] {
  let timeout = if idle {
    http_timeout(c.config.idle_timeout)?
  } else {
    match http_server_remaining(clock, deadline) {
      Ok(timeout) => timeout,
      Error(RequestTimeout()) => return http_server_expired(mut c),
      Error(error) => return Error(error),
    }
  }
  http_transport_read_timeout(mut c.transport, timeout)?
  let count = match http_transport_read_more(mut c.transport, 4096) {
    Ok(count) => count,
    Error(Net(TimedOut())) => {
      if idle {
        c.state = 2
        return Error(Closed())
      }
      return http_server_expired(mut c)
    },
    Error(error) => return Error(error),
  }
  // A completion after the deadline cannot deliver a request to the handler.
  if !idle {
    match http_server_remaining(clock, deadline) {
      Error(RequestTimeout()) => return http_server_expired(mut c),
      Error(error) => return Error(error),
      Ok(_) => (),
    }
  }
  Ok(count)
}

// Clean EOF and the keep-alive idle limit return Closed. An incomplete request
// is Truncated. A failed read may receive one final error response, then closes.
fn http_receive_request(mut c: HttpExchange, clock: Option[MonotonicClock]) -> Result[
  ServerRequest,
  HttpError
] {
  if http_is_h2(c.transport) {
    return http_h2_receive_request(mut c, clock)
  }
  let incoming_view = http_receive_view(mut c, clock)?
  Ok(server_request_owned(incoming_view))
}

fn http_receive_view(mut c: HttpExchange, clock: Option[MonotonicClock]) -> Result[
  ServerRequestView,
  HttpError
] {
  if http_is_h2(c.transport) {
    return Error(OutOfOrder())
  }
  if c.state == 2 {
    return Error(Closed())
  }
  if c.state != 0 {
    return Error(OutOfOrder())
  }
  c.state = 3
  // Until the next head is validated, no peer version or HEAD semantics
  // may carry over from the preceding request. HTTP/1.0 is the safe fallback.
  c.version = Http10()
  c.head_request = false
  let mut idle = c.served && http_input_buffered(c.transport.input) == 0
  // Validate the configuration and clock even when the connection starts idle.
  let initial_deadline = http_server_deadline(clock, c.config.read_timeout)?
  let mut deadline: Option[u64] = if idle {
    None()
  } else {
    initial_deadline
  }
  while true {
    let input = replace(mut c.transport.input, HttpInput(bytes: [], offset: 0))
    let (returned_input, buf) = http_input_view(take input)
    c.transport.input = take returned_input
    if let Some((parsed, frame, end)) = internal.http1_parse.http_server_view(
      take buf,
      c.config
    )? {
      let mut incoming = take parsed
      c.version = incoming.version
      c.head_request = core@1/bytes.slice(
        incoming.data,
        incoming.line.method_start,
        incoming.line.method_end
      ) == b"HEAD"
      http_input_consume(mut c.transport.input, end)
      let mut body = http_server_body(frame, c.config.max_body_bytes)?
      while body.state != 5 {
        let unread = http_input_contents(c.transport.input)
        let consumed = http_server_body_step(mut body, unread, c.config)?
        http_input_consume(mut c.transport.input, consumed)
        if body.state != 5 && http_server_read_more(mut c, false, clock, deadline)? == 0 {
          return Error(Truncated())
        }
      }
      let ServerBody(output: output, trailers: body_trailers, ..) = take body
      incoming.body = core@1/bytes.from_list(take output)
      incoming.trailers = take body_trailers
      c.keep_alive = incoming.keep_alive
      c.state = 1
      return Ok(take incoming)
    }
    let count = http_server_read_more(mut c, idle, clock, deadline)?
    if count == 0 {
      if http_input_buffered(c.transport.input) == 0 {
        c.state = 2
        return Error(Closed())
      }
      return Error(Truncated())
    }
    if idle {
      deadline = http_server_deadline(clock, c.config.read_timeout)?
    }
    idle = false
  }
  Error(Truncated())
}

// HEAD retains representation metadata; these statuses prohibit a body entirely.
fn http_server_bodyless(head_request: bool, status: u16) -> bool uses {} {
  head_request || status == 204 || status == 304
}

// The writer owns framing: callers cannot inject a second length or encoding.
fn http_respond(
  mut c: HttpExchange,
  status: u16,
  headers: List[Header],
  body: Bytes,
  close: bool
) -> Result[(), HttpError] {
  if http_is_h2(c.transport) {
    return http_h2_respond(mut c, status, headers, body, close)
  }
  if c.state != 1 && c.state != 3 {
    return Error(OutOfOrder())
  }
  let keep = c.state == 1 && c.keep_alive && !close
  c.state = 2
  http_transport_write_timeout(mut c.transport, http_timeout(c.config.write_timeout)?)?
  if status < 200 || status > 599 {
    return Error(Malformed(Status()))
  }
  let mut out = http_server_response_head(Http11(), status, headers)?
  if !http_server_bodyless(false, status) {
    text.append(mut out, "Content-Length: ")
    u64.format_into(core@1/bytes.len(body), mut out)
    text.append(mut out, "\r\n")
  }
  text.append(
    mut out,
    if keep {
      "Connection: keep-alive\r\n\r\n"
    } else {
      "Connection: close\r\n\r\n"
    }
  )
  // One write carries the head and a small body, so they leave in one segment; a large
  // body follows the head in its own write rather than being copied.
  let size: u64 = if http_server_bodyless(c.head_request, status) {
    0
  } else {
    core@1/bytes.len(body)
  }
  if size <= 65536 {
    core@1/list.reserve(mut out, core@1/list.len(out) + size)
    let mut i: u64 = 0
    while i < size {
      core@1/list.push(mut out, body[i])
      i += 1
    }
    http_transport_write(mut c.transport, core@1/bytes.from_list(take out))?
  } else {
    http_transport_write(mut c.transport, core@1/bytes.from_list(take out))?
    http_transport_write(mut c.transport, body)?
  }
  c.served = true
  if keep {
    c.state = 0
  }
  Ok(())
}

// Shared validation and head serialization for complete and streaming replies.
fn http_server_response_head(version: Version, status: u16, headers: List[Header]) -> Result[
  List[u8],
  HttpError
] uses {} {
  validate_headers(headers)?
  let mut out: List[u8] = []
  text.append(
    mut out,
    if version == Http10() {
      "HTTP/1.0 "
    } else {
      "HTTP/1.1 "
    }
  )
  u16.format_into(status, mut out)
  text.append(mut out, " \r\n")
  for h in headers {
    if http_same(h.name, "content-length") || http_same(h.name, "transfer-encoding") || http_same(
      h.name,
      "connection"
    ) {
      return Error(Malformed(ContentLength()))
    }
    text.append(mut out, h.name)
    text.append(mut out, ": ")
    text.append(mut out, h.value)
    text.append(mut out, "\r\n")
  }
  Ok(take out)
}

/// Sends and flushes a response head without a known body length. HTTP/1.1
/// uses chunked framing; HTTP/1.0 bodies end by closing the connection.
/// The connection cannot receive another request until end_response_body succeeds.
fn http_respond_head(mut c: HttpExchange, status: u16, headers: List[Header]) -> Result[
  (),
  HttpError
] {
  if http_is_h2(c.transport) {
    return http_h2_respond_head(mut c, status, headers)
  }
  if c.state != 1 && c.state != 3 {
    return Error(OutOfOrder())
  }
  let keep = c.state == 1 && c.keep_alive
  c.state = 2
  if status < 200 || status > 599 {
    return Error(Malformed(Status()))
  }
  let bodyless = http_server_bodyless(c.head_request, status)
  let chunked = !bodyless && c.version == Http11()
  c.keep_alive = keep && (chunked || bodyless)
  let mut out = http_server_response_head(c.version, status, headers)?
  if chunked {
    text.append(mut out, "Transfer-Encoding: chunked\r\n")
  }
  text.append(
    mut out,
    if c.keep_alive {
      "Connection: keep-alive\r\n\r\n"
    } else {
      "Connection: close\r\n\r\n"
    }
  )
  http_transport_write_timeout(mut c.transport, http_timeout(c.config.write_timeout)?)?
  http_transport_write(mut c.transport, core@1/bytes.from_list(take out))?
  c.state = if bodyless {
    6
  } else if chunked {
    4
  } else {
    5
  }
  Ok(())
}

/// Writes and flushes one body fragment. An empty fragment never terminates
/// the body. HEAD, 204 and 304 responses elide body bytes.
// Go net/http/internal/chunked.go chunkedWriter.Write; no buffered writer
// sits between write_all and the stream, so each call is already flushed.
fn http_write_response_body(mut c: HttpExchange, bytes: Bytes) -> Result[(), HttpError] {
  if http_is_h2(c.transport) {
    return http_h2_response_write(mut c, bytes)
  }
  if c.state != 4 && c.state != 5 && c.state != 6 {
    return Error(OutOfOrder())
  }
  if core@1/bytes.len(bytes) == 0 || c.state == 6 {
    return Ok(())
  }
  let state = c.state
  c.state = 2
  if state == 4 {
    let mut head: List[u8] = []
    text.append(mut head, f"{core@1/bytes.len(bytes):x}\r\n")
    http_transport_write(mut c.transport, core@1/bytes.from_list(take head))?
  }
  http_transport_write(mut c.transport, bytes)?
  if state == 4 {
    http_transport_write(mut c.transport, b"\r\n")?
  }
  c.state = state
  Ok(())
}

/// Finishes a streaming response. Chunked bodies emit the zero chunk and
/// empty trailers; close-delimited bodies shut down the stream. Only a fully
/// finished, persistent response permits another receive_request.
fn http_end_response_body(mut c: HttpExchange) -> Result[(), HttpError] {
  if http_is_h2(c.transport) {
    return http_h2_response_end(mut c)
  }
  if c.state != 4 && c.state != 5 && c.state != 6 {
    return Error(OutOfOrder())
  }
  let state = c.state
  c.state = 2
  if state == 4 {
    http_transport_write(mut c.transport, b"0\r\n\r\n")?
  }
  c.served = true
  if c.keep_alive {
    c.state = 0
  } else {
    http_transport_shutdown(mut c.transport)?
  }
  Ok(())
}

@serializable
pub type SseError = EventLineBreak | IdLineBreak | IdNul

/// Frames one WHATWG EventSource block as UTF-8. Optional fields are omitted
/// for None and emitted even for Some(""). Retry is in milliseconds. Data
/// items are lines; embedded CRLF, CR and LF each start another data field.
/// Invalid event/id fields fail instead of allowing field injection.
pub fn sse_event(
  event: Option[String],
  data: List[String],
  id: Option[String],
  retry: Option[u64]
) -> Result[unique Bytes, SseError] uses {} {
  let mut out: List[u8] = []
  if let Some(value) = event {
    if string.contains(value, "\r") || string.contains(value, "\n") {
      return Error(EventLineBreak())
    }
    text.append(mut out, "event: ")
    text.append(mut out, value)
    text.append(mut out, "\n")
  }
  for item in data {
    let normalized = string.replace(string.replace(item, "\r\n", "\n"), "\r", "\n")
    for line in string.split(take normalized, "\n") {
      text.append(mut out, "data: ")
      text.append(mut out, line)
      text.append(mut out, "\n")
    }
  }
  if let Some(value) = id {
    if string.contains(value, "\r") || string.contains(value, "\n") {
      return Error(IdLineBreak())
    }
    if string.contains(value, "\u{0}") {
      return Error(IdNul())
    }
    text.append(mut out, "id: ")
    text.append(mut out, value)
    text.append(mut out, "\n")
  }
  if let Some(value) = retry {
    text.append(mut out, "retry: ")
    u64.format_into(value, mut out)
    text.append(mut out, "\n")
  }
  text.append(mut out, "\n")
  Ok(core@1/bytes.from_list(take out))
}
