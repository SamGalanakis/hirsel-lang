@noalloc
pub fn new() -> State uses {} {
  start(0)
}

// A keyed BLAKE2B MAC. The key is at most 64 bytes, otherwise SEM-3; an empty key
// is the unkeyed hash.
@noalloc
pub fn new_keyed(key: Bytes) -> State uses {} {
  let len = core@1/bytes.len(key)
  core@1/failure.check(len <= 64, TextInvariant())
  let mut state = start(len)
  if len > 0 {
    let mut i: u64 = 0
    while i < len {
      state.block[i] = key[i]
      i += 1
    }
    state.used = 128
  }
  state
}

// The parameter block: digest length 64, the key length, fanout and depth 1.
@noalloc
fn start(key_len: u64) -> State uses {} {
  let mut words = IV
  let param: u64 = core@1/int.narrow(0x01010000u64 | key_len << 8 | 64)
  words[0] = words[0] ^ param
  State(
    words: words,
    block: [
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
      0u8,
