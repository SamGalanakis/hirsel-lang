// RFC 7693 BLAKE2B-512, from golang.org/x/crypto/blake2b blake2b_generic.go and
// blake2b.go (BSD-3-Clause): unkeyed, or keyed with up to 64 key bytes as a MAC.
pub opaque type State: plain + inert uses {} {
  words: Inline[u64, 8],
  block: Inline[u8, 128],
  used: u64,
  count: u64,
}

const IV: Inline[u64, 8] = [
  0x6a09e667f3bcc908u64,
  0xbb67ae8584caa73bu64,
  0x3c6ef372fe94f82bu64,
  0xa54ff53a5f1d36f1u64,
  0x510e527fade682d1u64,
  0x9b05688c2b3e6c1fu64,
  0x1f83d9abfb41bd6bu64,
  0x5be0cd19137e2179u64
]

// The message schedule; rounds past the tenth reuse its rows from the start.
