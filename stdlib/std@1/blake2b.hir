@noalloc
fn rotate(value: u64, bits: u64) -> u64 uses {} {
  value >> bits | value << 64u64 - bits
}

@noalloc
fn add(a: u64, b: u64) -> u64 uses {} {
  core@1/int.wrapping_add(a, b)
}

// The G function on four state words and two message words.
@noalloc
fn mix(mut v: Inline[u64, 16], a: u64, b: u64, c: u64, d: u64, x: u64, y: u64) -> () uses {} {
  v[a] = add(add(v[a], v[b]), x)
  v[d] = rotate(v[d] ^ v[a], 32)
  v[c] = add(v[c], v[d])
  v[b] = rotate(v[b] ^ v[c], 24)
  v[a] = add(add(v[a], v[b]), y)
  v[d] = rotate(v[d] ^ v[a], 16)
  v[c] = add(v[c], v[d])
  v[b] = rotate(v[b] ^ v[c], 63)
}

// Compresses the buffered block; `state.count` already includes its bytes.
@noalloc
fn compress(mut state: State, last: bool) -> () uses {} {
  let mut m: Inline[u64, 16] = [
    0u64,
    0u64,
    0u64,
    0u64,
    0u64,
    0u64,
    0u64,
    0u64,
    0u64,
    0u64,
    0u64,
    0u64,
    0u64,
    0u64,
    0u64,
    0u64
  ]
  let mut i: u64 = 0
  while i < 16 {
    let mut word: u64 = 0
    let mut j: u64 = 8
    while j > 0 {
      j -= 1
      let byte: u64 = core@1/int.widen(state.block[i * 8 + j])
      word = word << 8 | byte
    }
    m[i] = word
    i += 1
  }
  let mut v: Inline[u64, 16] = [
    0u64,
    0u64,
    0u64,
    0u64,
    0u64,
    0u64,
    0u64,
    0u64,
    0u64,
    0u64,
    0u64,
    0u64,
    0u64,
    0u64,
    0u64,
    0u64
  ]
  i = 0
  while i < 8 {
    v[i] = state.words[i]
    v[i + 8] = IV[i]
    i += 1
  }
  v[12] = v[12] ^ state.count
  if last {
    v[14] = ~v[14]
  }
  let mut round: u64 = 0
  while round < 12 {
    let s = round % 10 * 16
    mix(mut v, 0, 4, 8, 12, m[SIGMA[s]], m[SIGMA[s + 1]])
    mix(mut v, 1, 5, 9, 13, m[SIGMA[s + 2]], m[SIGMA[s + 3]])
    mix(mut v, 2, 6, 10, 14, m[SIGMA[s + 4]], m[SIGMA[s + 5]])
    mix(mut v, 3, 7, 11, 15, m[SIGMA[s + 6]], m[SIGMA[s + 7]])
    mix(mut v, 0, 5, 10, 15, m[SIGMA[s + 8]], m[SIGMA[s + 9]])
    mix(mut v, 1, 6, 11, 12, m[SIGMA[s + 10]], m[SIGMA[s + 11]])
    mix(mut v, 2, 7, 8, 13, m[SIGMA[s + 12]], m[SIGMA[s + 13]])
    mix(mut v, 3, 4, 9, 14, m[SIGMA[s + 14]], m[SIGMA[s + 15]])
    round += 1
  }
  i = 0
  while i < 8 {
    state.words[i] = state.words[i] ^ v[i] ^ v[i + 8]
    i += 1
  }
}

// The last block is held back until more input arrives, since finish compresses
// it with the final flag.
@noalloc
pub fn update(mut state: State, data: Bytes) -> () uses {} {
  let len = core@1/bytes.len(data)
  core@1/failure.check(
    len <= 18446744073709551615u64 - state.count - state.used,
    Arithmetic()
  )
  let mut i: u64 = 0
  while i < len {
    if state.used == 128 {
      state.count += 128
      compress(mut state, false)
      state.used = 0
    }
    state.block[state.used] = data[i]
    state.used += 1
    i += 1
  }
}

@noalloc
pub fn finish(take state: State) -> Inline[u8, 64] uses {} {
  let mut final_state = take state
  final_state.count += final_state.used
  while final_state.used < 128 {
    final_state.block[final_state.used] = 0
    final_state.used += 1
  }
  compress(mut final_state, true)
  let mut out: Inline[u8, 64] = [
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8
  ]
  let mut i: u64 = 0
  while i < 64 {
    let word = final_state.words[i / 8]
    let shift: u64 = core@1/int.truncate(i % 8 * 8)
    out[i] = core@1/int.truncate(word >> shift)
    i += 1
  }
  take out
}

@noalloc
pub fn digest(data: Bytes) -> Inline[u8, 64] uses {} {
  let mut state = new()
  update(mut state, data)
  finish(take state)
}

pub fn digest_hex(data: Bytes) -> unique String uses {} {
  std@1/hex.encode(std@1/bytes.from_inline(digest(data)))
}

// The dictionary that keys HMAC, HKDF and PBKDF2 with this hash.
pub implementation hash: std@1/digest.Digest {
  type State = State
  size bytes = 64
  size block = 128
  new = new
  update = update
  finish = finish
}
