// Min-heap endpoint semantics from Zig PriorityQueue and Rust BinaryHeap.
pub opaque type Heap[T]: () uses {T} {
  items: unique List[unique T],
}

pub fn empty[T]() -> unique Heap[T] uses {} {
  Heap(items: [])
}

@noalloc
pub fn len[T](h: Heap[T]) -> u64 uses {} {
  core@1/list.len(h.items)
}

pub fn push[T](
  mut h: unique Heap[T],
  take value: unique T,
  by: @noalloc fn(T, T) -> i32 uses {}
) -> () uses {h, value} {
  core@1/list.push(mut h.items, take value)
  internal.heap_ops.sift_up(
    mut h.items,
    core@1/list.len(h.items) - 1,
    fn(a: unique T, b: unique T) -> i32 uses {} {
      by(a, b)
    }
  )
}

pub fn pop[T](mut h: unique Heap[T], by: @noalloc fn(T, T) -> i32 uses {}) -> unique Option[
  T
] uses {h} {
  let count = core@1/list.len(h.items)
  if count == 0 {
    return None()
  }
  core@1/list.swap(mut h.items, 0, count - 1)
  let item = core@1/list.pop(mut h.items)
  // list's shared sift kernel selects the larger child, so reverse `by` to
  // obtain a min-heap without negating a potentially minimum i32 result.
  internal.heap_ops.sift(
    mut h.items,
    0,
    count - 1,
    fn(a: unique T, b: unique T) -> i32 uses {} {
      by(b, a)
    }
  )
  match take item {
    Some(value) => Some(take value),
    None => None(),
  }
}
