// Decimal conversion is ordinary source; no numeric schema or hidden allocator.
@noalloc
pub fn format_inline[n: size](value: i32, mut buffer: Inline[u8, n]) -> Result[
  u64,
  scalar.FormatError
] uses {} {
  let wide: i128 = core@1/int.widen(value)
  let raw: u128 = core@1/int.truncate(wide)
  let magnitude = if value < 0 {
    core@1/int.wrapping_add(~raw, 1)
  } else {
    raw
  }
  internal.decimal.write_unsigned(magnitude, value < 0, mut buffer)
}

// Appends the decimal text of `value` to `out`; to_string is that text,
// built from the same digits in a list reserved to its exact length.
@preserves_unique(out)
pub fn format_into(value: i32, mut out: List[u8]) -> () uses {} {
  let wide: i128 = core@1/int.widen(value)
  let raw: u128 = core@1/int.truncate(wide)
  let magnitude = if value < 0 {
    core@1/int.wrapping_add(~raw, 1)
  } else {
    raw
  }
  internal.decimal.append(mut out, magnitude, value < 0)
}

pub fn to_string(value: i32) -> unique String uses {} {
  let mut out: List[u8] = []
  i32.format_into(value, mut out)
  text.finish_valid(take out)
}

@noalloc
pub fn parse(text: String) -> Result[i32, scalar.ParseError] uses {} {
  parse_radix(text, 10)
}

@preserves_unique(out)
pub fn format_into_spec(
  value: i32,
  fill: char,
  align: u64,
  width: u64,
  precision: u64,
  flags: u64,
  kind: u64,
  mut out: List[u8]
) -> () uses {} {
  let word: u32 = core@1/int.truncate(value)
  let raw: u128 = core@1/int.widen(word)
  let wide: i128 = core@1/int.widen(value)
  let signed_raw: u128 = core@1/int.truncate(wide)
  let negative = kind == 0 && value < 0
  let magnitude = if negative {
    core@1/int.wrapping_add(~signed_raw, 1)
  } else {
    raw
  }
  internal.format.integer(
    magnitude,
    negative,
    fill,
    align,
    width,
    precision,
    flags,
    kind,
    mut out
  )
}
