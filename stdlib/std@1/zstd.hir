// Adapted from Zig lib/std/compress/zstd{.zig,/Decompress.zig}, ziglang/zig
// bff490a23889750de7096d9057c0a432efc929a8 (MIT; third-party/NOTICES.md).
// FSE table construction ports facebook/zstd 49cf51799ea051457f57243527aa2058f999f005
// lib/common/fse_decompress.c:59-160 FSE_buildDTable_internal (BSD-3-Clause).
// Whole-buffer RFC 8878 decoder. Unlike Zig's streaming adapter, every access
// is checked against its containing section, checksums are always verified,
// and raw-content and formatted dictionaries are supported.
/// Malformed data and caller-selected resource bounds are ordinary errors.
pub type ZstdError = Truncated | BadMagic | ReservedBit | Corrupt | BlockOversize | Checksum | ContentSize | WindowTooLarge(
  u64
) | OutputTooLarge | DictionaryRequired(u64) | DictionaryMismatch | InvalidDictionary

// FSE entry: eight-bit symbol, four-bit consumed width, nine-bit baseline.
// Every table state fits one word instead of a three-word record.
type Fse {
  log: u64,
  entries: List[u64],
}

// Packed Huffman lookup entries: symbol << 4 | code length. The table is at
// most 2048 entries; a zero-length table means no previous tree.
type Huffman {
  log: u64,
  entries: List[u64],
}

type Tables {
  literals: Fse,
  offsets: Fse,
  matches: Fse,
  huffman: Huffman,
  repeats: Inline[u64, 3],
}

/// A validated RFC 8878 dictionary or raw-content prefix. Reusable across frames;
/// decoding borrows it and resets its entropy tables and offsets at each frame.
pub opaque type Dictionary: copyable + inert + noalloc_drop uses {} {
  id: u64,
  content: Bytes,
  tables: Tables,
}

// Byte cursor for headers; forward and reverse bit cursors below are local to
// their containing byte slice. A truncated subsection cannot consume its twin.
type Cursor {
  pos: u64,
}

type Bits {
  pos: u64,
  loaded: u64,
  buffer: u64,
  valid: u64,
}

type Reverse {
  left: u64,
  pos: u64,
  buffer: u64,
  valid: u64,
}

fn empty_tables() -> Tables uses {} {
  Tables(
    literals: Fse(log: 0, entries: []),
    offsets: Fse(log: 0, entries: []),
    matches: Fse(log: 0, entries: []),
    huffman: Huffman(log: 0, entries: []),
    repeats: [1, 4, 8]
  )
}

fn zeros(n: u64) -> List[u64] uses {} {
  let mut out: List[u64] = []
  core@1/list.reserve(mut out, n)
  let mut i: u64 = 0
  while i < n {
    core@1/list.push(mut out, 0)
    i += 1
  }
  take out
}

@noalloc
fn log2(value: u64) -> u64 uses {} {
  let mut v = value
  let mut n: u64 = 0
  while v > 1 {
    v = v >> 1
    n += 1
  }
  n
}

fn word(data: Bytes, mut c: Cursor, n: u64) -> Result[u64, ZstdError] uses {} {
  if n > core@1/bytes.len(data) - c.pos {
    return Error(Truncated())
  }
  let mut value: u64 = 0
  let mut i: u64 = 0
  while i < n {
    let byte: u64 = core@1/int.widen(data[c.pos + i])
    value = value | byte << 8 * i
    i += 1
  }
  c.pos += n
  Ok(value)
}

fn section(data: Bytes, mut c: Cursor, n: u64) -> Option[Bytes] in data uses {} {
  if n > core@1/bytes.len(data) - c.pos {
    return None()
  }
  let start = c.pos
  c.pos += n
  Some(core@1/bytes.slice(data, start, c.pos))
}

// Forward normalized-count headers use a low-aligned 64-bit reservoir.
fn forward(data: Bytes, mut b: Bits, n: u64) -> Result[u64, ZstdError] uses {} {
  if n > core@1/bytes.len(data) * 8 - b.pos {
    return Error(Truncated())
  }
  if b.valid < n {
    while b.valid <= 56 && b.loaded < core@1/bytes.len(data) {
      b.buffer = b.buffer | core@1/int.widen(data[b.loaded]) << b.valid
      b.loaded += 1
      b.valid += 8
    }
  }
  let value = b.buffer & (1u64 << n) - 1
  b.buffer = b.buffer >> n
  b.valid -= n
  b.pos += n
  Ok(value)
}

fn reverse(data: Bytes) -> Result[Reverse, ZstdError] uses {} {
  let len = core@1/bytes.len(data)
  if len == 0 {
    return Error(Corrupt())
  }
  let last: u64 = core@1/int.widen(data[len - 1])
  if last == 0 {
    return Error(Corrupt())
  }
  let valid = log2(last)
  let buffer = if valid == 0 {
    0u64
  } else {
    (last & (1u64 << valid) - 1) << 64 - valid
  }
  Ok(Reverse(left: (len - 1) * 8 + valid, pos: len - 1, buffer: buffer, valid: valid))
}

// A high-aligned 64-bit reservoir. Each input byte is loaded only once;
// the section end and stop bit are checked before any refill, including tails.
fn refill(data: Bytes, mut b: Reverse) -> () uses {} {
  while b.valid <= 56 && b.pos > 0 {
    b.pos -= 1
    b.buffer = b.buffer | core@1/int.widen(data[b.pos]) << 56 - b.valid
    b.valid += 8
  }
}

fn backward(data: Bytes, mut b: Reverse, n: u64) -> Result[u64, ZstdError] uses {} {
  if n > b.left {
    return Error(Corrupt())
  }
  if n == 0 {
    return Ok(0)
  }
  if b.valid < n {
    refill(data, mut b)
  }
  let value = b.buffer >> 64 - n
  b.buffer = b.buffer << n
  b.valid -= n
  b.left -= n
  Ok(value)
}

// libzstd FSE_buildDTable_internal: -1 counts occupy the table's high end;
// positive counts spread with the RFC step, then symbolNext builds each state.
// A single positive count filling the table is valid (all entries use 0 bits).
// `values` encodes normalized counts plus one (0 = -1, 1 = absent).
fn build_fse(values: List[u64], accuracy: u64) -> Result[Fse, ZstdError] uses {} {
  let size = 1u64 << accuracy
  let mut symbols = zeros(size)
  let mut high = size
  let mut next = zeros(core@1/list.len(values))
  let mut symbol: u64 = 0
  let mut total: u64 = 0
  while symbol < core@1/list.len(values) {
    let v = values[symbol]
    if v == 0 {
      if high == 0 {
        return Error(Corrupt())
      }
      high -= 1
      symbols[high] = symbol
      next[symbol] = 1
      total += 1
    } else if v > 1 {
      next[symbol] = v - 1
      total += v - 1
    }
    symbol += 1
  }
  if total != size {
    return Error(Corrupt())
  }
  let step = size / 2 + size / 8 + 3
  let mut position: u64 = 0
  symbol = 0
  while symbol < core@1/list.len(values) {
    let v = values[symbol]
    if v > 1 {
      let mut i: u64 = 0
      while i < v - 1 {
        symbols[position] = symbol
        position = position + step & size - 1
        while position >= high {
          position = position + step & size - 1
        }
        i += 1
      }
    }
    symbol += 1
  }
  if position != 0 {
    return Error(Corrupt())
  }
  let mut entries: List[u64] = []
  core@1/list.reserve(mut entries, size)
  let mut i: u64 = 0
  while i < size {
    let sym = symbols[i]
    let state = next[sym]
    next[sym] += 1
    let bits = accuracy - log2(state)
    core@1/list.push(mut entries, sym | bits << 8 | (state << bits) - size << 12)
    i += 1
  }
  Ok(Fse(log: accuracy, entries: take entries))
}

// Zig Table.decode: variable-width probabilities, zero runs, then byte align.
fn read_fse(data: Bytes, mut c: Cursor, max_symbols: u64, max_log: u64) -> Result[
  Fse,
  ZstdError
] uses {} {
  let bytes = core@1/bytes.slice(data, c.pos, core@1/bytes.len(data))
  let mut b = Bits(pos: 0, loaded: 0, buffer: 0, valid: 0)
  let accuracy = forward(bytes, mut b, 4)? + 5
  if accuracy > max_log {
    return Error(Corrupt())
  }
  let size = 1u64 << accuracy
  let mut total: u64 = 0
  let mut values: List[u64] = []
  while total < size {
    if core@1/list.len(values) >= max_symbols {
      return Error(Corrupt())
    }
    let remaining = size - total + 1
    let width = log2(remaining) + 1
    let small = forward(bytes, mut b, width - 1)?
    let cutoff = (1u64 << width) - 1 - remaining
    let mut value = small
    if small >= cutoff {
      value += forward(bytes, mut b, 1)? << width - 1
      if value >= 1u64 << width - 1 {
        value -= cutoff
      }
    }
    let probability = if value == 0 {
      1u64
    } else {
      value - 1
    }
    if probability > size - total {
      return Error(Corrupt())
    }
    total += probability
    core@1/list.push(mut values, value)
    if value == 1 {
      while true {
        let count = forward(bytes, mut b, 2)?
        if count > max_symbols - core@1/list.len(values) {
          return Error(Corrupt())
        }
        let mut i: u64 = 0
        while i < count {
          core@1/list.push(mut values, 1)
          i += 1
        }
        if count < 3 {
          break
        }
      }
    }
  }
  c.pos += (b.pos + 7) / 8
  build_fse(values, accuracy)
}

// Zig HuffmanTree.assignWeights: two interleaved FSE states. A state update
// that crosses the bitstream end emits the other state's final symbol too.
fn fse_weights(data: Bytes) -> Result[List[u64], ZstdError] uses {} {
  let mut c = Cursor(pos: 0)
  let decoding_table = read_fse(data, mut c, 256, 6)?
  let stream = core@1/bytes.slice(data, c.pos, core@1/bytes.len(data))
  let mut b = reverse(stream)?
  let mut state = backward(stream, mut b, decoding_table.log)?
  let mut other = backward(stream, mut b, decoding_table.log)?
  let mut weights: List[u64] = []
  while core@1/list.len(weights) < 255 {
    let entry = decoding_table.entries[state]
    if entry & 255 > 11 {
      return Error(Corrupt())
    }
    core@1/list.push(mut weights, entry & 255)
    if entry >> 8 & 15 > b.left {
      let last = decoding_table.entries[other] & 255
      if last > 11 || core@1/list.len(weights) >= 255 {
        return Error(Corrupt())
      }
      core@1/list.push(mut weights, last)
      return Ok(take weights)
    }
    let next = (entry >> 12) + backward(stream, mut b, entry >> 8 & 15)?
    state = other
    other = next
  }
  Error(Corrupt())
}

// Zig HuffmanTree.build, with the RFC's exact power-of-two remainder check.
// Weight ordering puts the longest codes first; each fills 2^(weight-1)
// contiguous lookup entries. Table entries carry the consumed code length.
fn build_huffman(take initial_weights: List[u64]) -> Result[Huffman, ZstdError] uses {} {
  let mut weights = take initial_weights
  let mut total: u64 = 0
  let mut i: u64 = 0
  while i < core@1/list.len(weights) {
    let w = weights[i]
    if w > 11 {
      return Error(Corrupt())
    }
    if w > 0 {
      total += 1u64 << w - 1
    }
    i += 1
  }
  if total == 0 || total >= 2048 {
    return Error(Corrupt())
  }
  let accuracy = log2(total) + 1
  let remainder = (1u64 << accuracy) - total
  if remainder & remainder - 1 != 0 {
    return Error(Corrupt())
  }
  core@1/list.push(mut weights, log2(remainder) + 1)
  let mut count = zeros(12)
  i = 0
  while i < core@1/list.len(weights) {
    count[weights[i]] += 1
    i += 1
  }
  if count[1] < 2 || count[1] % 2 != 0 {
    return Error(Corrupt())
  }
  let mut entries = zeros(1u64 << accuracy)
  let mut at: u64 = 0
  let mut weight: u64 = 1
  while weight <= accuracy {
    i = 0
    while i < core@1/list.len(weights) {
      if weights[i] == weight {
        let n = 1u64 << weight - 1
        let mut j: u64 = 0
        while j < n {
          entries[at + j] = i << 4 | accuracy + 1 - weight
          j += 1
        }
        at += n
      }
      i += 1
    }
    weight += 1
  }
  Ok(Huffman(log: accuracy, entries: take entries))
}

fn read_huffman(data: Bytes, mut c: Cursor) -> Result[Huffman, ZstdError] uses {} {
  let header = word(data, mut c, 1)?
  if header < 128 {
    let Some(compressed) = section(data, mut c, header) else {
      return Error(Truncated())
    }
    let weights = fse_weights(compressed)?
    return build_huffman(take weights)
  }
  let n = header - 127
  let Some(bytes) = section(data, mut c, (n + 1) / 2) else {
    return Error(Truncated())
  }
  let mut weights: List[u64] = []
  let mut i: u64 = 0
  while i < n {
    let byte: u64 = core@1/int.widen(bytes[i / 2])
    let w = if i % 2 == 0 {
      byte >> 4
    } else {
      byte & 15
    }
    core@1/list.push(mut weights, w)
    i += 1
  }
  build_huffman(take weights)
}

fn huffman_stream(data: Bytes, tree: Huffman, n: u64, mut out: List[u8]) -> Result[
  (),
  ZstdError
] uses {} {
  let mut b = reverse(data)?
  let mut i: u64 = 0
  while i < n {
    if b.valid < tree.log {
      refill(data, mut b)
    }
    let prefix = b.buffer >> 64 - tree.log
    let entry = tree.entries[prefix]
    let bits = entry & 15
    if bits == 0 || bits > b.left {
      return Error(Corrupt())
    }
    b.left -= bits
    b.valid -= bits
    b.buffer = b.buffer << bits
    core@1/list.push(mut out, core@1/int.narrow(entry >> 4))
    i += 1
  }
  if b.left != 0 {
    return Error(Corrupt())
  }
  Ok(())
}

fn read_literals(
  data: Bytes,
  mut c: Cursor,
  mut tables: Tables,
  block_limit: u64,
  output_room: u64
) -> Result[List[u8], ZstdError] uses {} {
  let first = word(data, mut c, 1)?
  let kind = first & 3
  let format = first >> 2 & 3
  let mut size: u64 = 0
  let mut compressed: u64 = 0
  if kind < 2 {
    if format == 0 || format == 2 {
      size = first >> 3
    } else if format == 1 {
      size = first >> 4 | word(data, mut c, 1)? << 4
    } else {
      size = first >> 4 | word(data, mut c, 2)? << 4
    }
  } else {
    let mut header = first | word(data, mut c, 2)? << 8
    if format < 2 {
      size = header >> 4 & 1023
      compressed = header >> 14
    } else if format == 2 {
      header = header | word(data, mut c, 1)? << 24
      size = header >> 4 & 16383
      compressed = header >> 18
    } else {
      header = header | word(data, mut c, 2)? << 24
      size = header >> 4 & 262143
      compressed = header >> 22
    }
  }
  if size > block_limit {
    return Error(BlockOversize())
  }
  if size > output_room {
    return Error(OutputTooLarge())
  }
  let mut out: List[u8] = []
  core@1/list.reserve(mut out, size)
  if kind == 0 {
    let Some(bytes) = section(data, mut c, size) else {
      return Error(Truncated())
    }
    core@1/bytes.append(mut out, bytes)
  } else if kind == 1 {
    let byte: u8 = core@1/int.narrow(word(data, mut c, 1)?)
    if size > 0 {
      core@1/list.push(mut out, byte)
      core@1/bytes.append_from_history(mut out, 1, size - 1)
    }
  } else {
    let Some(bytes) = section(data, mut c, compressed) else {
      return Error(Truncated())
    }
    let mut at = Cursor(pos: 0)
    if kind == 2 {
      tables.huffman = read_huffman(bytes, mut at)?
    } else if tables.huffman.log == 0 {
      return Error(Corrupt())
    }
    if format == 0 {
      let stream = core@1/bytes.slice(bytes, at.pos, core@1/bytes.len(bytes))
      huffman_stream(stream, tables.huffman, size, mut out)?
    } else {
      if size < 6 {
        return Error(Corrupt())
      }
      let n1 = word(bytes, mut at, 2)?
      let n2 = word(bytes, mut at, 2)?
      let n3 = word(bytes, mut at, 2)?
      let quarter = (size + 3) / 4
      let Some(s1) = section(bytes, mut at, n1) else {
        return Error(Truncated())
      }
      let Some(s2) = section(bytes, mut at, n2) else {
        return Error(Truncated())
      }
      let Some(s3) = section(bytes, mut at, n3) else {
        return Error(Truncated())
      }
      let s4 = core@1/bytes.slice(bytes, at.pos, core@1/bytes.len(bytes))
      huffman_stream(s1, tables.huffman, quarter, mut out)?
      huffman_stream(s2, tables.huffman, quarter, mut out)?
      huffman_stream(s3, tables.huffman, quarter, mut out)?
      huffman_stream(s4, tables.huffman, size - 3 * quarter, mut out)?
    }
  }
  Ok(take out)
}

fn predefined(which: u64) -> Result[Fse, ZstdError] uses {} {
  // RFC 8878 default distributions, in Zig's count-plus-one representation.
  let values: List[u64] = if which == 0 {
    [
      5,
      4,
      3,
      3,
      3,
      3,
      3,
      3,
      3,
      3,
      3,
      3,
      3,
      2,
      2,
      2,
      3,
      3,
      3,
      3,
      3,
      3,
      3,
      3,
      3,
      4,
      3,
      2,
      2,
      2,
      2,
      2,
      0,
      0,
      0,
      0
    ]
  } else if which == 1 {
    [
      2,
      2,
      2,
      2,
      2,
      2,
      3,
      3,
      3,
      2,
      2,
      2,
      2,
      2,
      2,
      2,
      2,
      2,
      2,
      2,
      2,
      2,
      2,
      2,
      0,
      0,
      0,
      0,
      0
    ]
  } else {
    [
      2,
      5,
      4,
      3,
      3,
      3,
      3,
      3,
      3,
      2,
      2,
      2,
      2,
      2,
      2,
      2,
      2,
      2,
      2,
      2,
      2,
      2,
      2,
      2,
      2,
      2,
      2,
      2,
      2,
      2,
      2,
      2,
      2,
      2,
      2,
      2,
      2,
      2,
      2,
      2,
      2,
      2,
      2,
      2,
      2,
      2,
      0,
      0,
      0,
      0,
      0,
      0,
      0
    ]
  }
  build_fse(
    values,
    if which == 1 {
      5u64
    } else {
      6u64
    }
  )
}

fn sequence_table(
  data: Bytes,
  mut c: Cursor,
  mode: u64,
  which: u64,
  mut decoding_table: Fse
) -> Result[(), ZstdError] uses {} {
  let max_symbol = if which == 0 {
    35u64
  } else if which == 1 {
    31u64
  } else {
    52u64
  }
  if mode == 0 {
    decoding_table = predefined(which)?
  } else if mode == 1 {
    let symbol = word(data, mut c, 1)?
    if symbol > max_symbol {
      return Error(Corrupt())
    }
    decoding_table = Fse(log: 0, entries: [symbol])
  } else if mode == 2 {
    decoding_table = read_fse(
      data,
      mut c,
      max_symbol + 1,
      if which == 1 {
        8u64
      } else {
        9u64
      }
    )?
  } else if core@1/list.len(decoding_table.entries) == 0 {
    return Error(Corrupt())
  }
  Ok(())
}

