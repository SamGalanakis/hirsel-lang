// Zig Decode.nextSequence: zero literals shift repeat codes by one; code 3
// then means repeat[0]-1. The repeats survive all blocks, including raw/RLE.
fn offset(value: u64, literal_length: u64, mut t: Tables) -> Result[u64, ZstdError] uses {} {
  let mut distance: u64 = 0
  if value > 3 {
    distance = value - 3
    t.repeats[2] = t.repeats[1]
    t.repeats[1] = t.repeats[0]
    t.repeats[0] = distance
  } else {
    let index = if literal_length == 0 {
      value
    } else {
      value - 1
    }
    if index == 3 {
      if t.repeats[0] <= 1 {
        return Error(Corrupt())
      }
      distance = t.repeats[0] - 1
      t.repeats[2] = t.repeats[1]
      t.repeats[1] = t.repeats[0]
      t.repeats[0] = distance
    } else {
      distance = t.repeats[index]
      if index == 2 {
        t.repeats[2] = t.repeats[1]
      }
      if index > 0 {
        t.repeats[1] = t.repeats[0]
      }
      t.repeats[0] = distance
    }
  }
  if distance == 0 {
    return Error(Corrupt())
  }
  Ok(distance)
}

fn compressed_block(
  data: Bytes,
  mut t: Tables,
  dict_content: Bytes,
  base: u64,
  window: u64,
  block_limit: u64,
  max_output: u64,
  mut out: List[u8]
) -> Result[(), ZstdError] uses {} {
  let start = core@1/list.len(out)
  let mut c = Cursor(pos: 0)
  let literals = core@1/bytes.from_list(
    read_literals(data, mut c, mut t, block_limit, max_output - start)?
  )
  let first = word(data, mut c, 1)?
  let count = if first < 128 {
    first
  } else if first < 255 {
    (first - 128) * 256 + word(data, mut c, 1)?
  } else {
    word(data, mut c, 2)? + 0x7f00
  }
  let mut used: u64 = 0
  if count > 0 {
    let modes = word(data, mut c, 1)?
    if modes & 3 != 0 {
      return Error(ReservedBit())
    }
    sequence_table(data, mut c, modes >> 6, 0, mut t.literals)?
    sequence_table(data, mut c, modes >> 4 & 3, 1, mut t.offsets)?
    sequence_table(data, mut c, modes >> 2 & 3, 2, mut t.matches)?
    let stream = core@1/bytes.slice(data, c.pos, core@1/bytes.len(data))
    let mut b = reverse(stream)?
    let mut ll = backward(stream, mut b, t.literals.log)?
    let mut offset_state = backward(stream, mut b, t.offsets.log)?
    let mut ml = backward(stream, mut b, t.matches.log)?
    let mut i: u64 = 0
    while i < count {
      let l = t.literals.entries[ll]
      let o = t.offsets.entries[offset_state]
      let m = t.matches.entries[ml]
      if l & 255 > 35 || o & 255 > 31 || m & 255 > 52 {
        return Error(Corrupt())
      }
      let off = (1u64 << (o & 255)) + backward(stream, mut b, o & 255)?
      let match_length = ML_BASE[m & 255] + backward(stream, mut b, ML_BITS[m & 255])?
      let literal_length = LL_BASE[l & 255] + backward(stream, mut b, LL_BITS[l & 255])?
      let distance = offset(off, literal_length, mut t)?
      let produced = core@1/list.len(out) - start
      if literal_length > core@1/bytes.len(literals) - used {
        return Error(Corrupt())
      }
      let length = literal_length + match_length
      if length > block_limit - produced {
        return Error(BlockOversize())
      }
      if length > max_output - core@1/list.len(out) {
        return Error(OutputTooLarge())
      }
      core@1/bytes.append(
        mut out,
        core@1/bytes.slice(literals, used, used + literal_length)
      )
      used += literal_length
      let frame_size = core@1/list.len(out) - base
      let dict_size = core@1/bytes.len(dict_content)
      // RFC 8878 section 6: dictionary references are permitted only while
      // output has not exceeded the window. Normal matches obey the window.
      if distance > frame_size {
        if frame_size > window || distance - frame_size > dict_size {
          return Error(Corrupt())
        }
      } else if distance > window {
        return Error(Corrupt())
      }
      let mut remaining = match_length
      if distance > frame_size {
        let missing = distance - frame_size
        let n = if remaining < missing {
          remaining
        } else {
          missing
        }
        core@1/bytes.append(
          mut out,
          core@1/bytes.slice(dict_content, dict_size - missing, dict_size - missing + n)
        )
        remaining -= n
      }
      if remaining > 0 {
        core@1/bytes.append_from_history(mut out, distance, remaining)
      }
      i += 1
      if i < count {
        ll = (l >> 12) + backward(stream, mut b, l >> 8 & 15)?
        ml = (m >> 12) + backward(stream, mut b, m >> 8 & 15)?
        offset_state = (o >> 12) + backward(stream, mut b, o >> 8 & 15)?
      }
    }
    if b.left != 0 {
      return Error(Corrupt())
    }
  } else if c.pos != core@1/bytes.len(data) {
    return Error(Corrupt())
  }
  let remaining = core@1/bytes.len(literals) - used
  if remaining > block_limit - (core@1/list.len(out) - start) {
    return Error(BlockOversize())
  }
  if remaining > max_output - core@1/list.len(out) {
    return Error(OutputTooLarge())
  }
  core@1/bytes.append(
    mut out,
    core@1/bytes.slice(literals, used, core@1/bytes.len(literals))
  )
  Ok(())
}

/// Parse a formatted dictionary (magic 0xec30a437), or use other bytes as a raw
/// content prefix. Formatted dictionary tables and repeat offsets are validated.
/// Dictionary input is borrowed; its content bytes remain shared with the input.
pub fn dictionary(data: Bytes) -> Result[Dictionary, ZstdError] in data uses {} {
  let mut c = Cursor(pos: 0)
  let mut tables = empty_tables()
  let mut id: u64 = 0
  if core@1/bytes.len(data) >= 4 && word(data, mut c, 4)? == 0xec30a437 {
    id = word(data, mut c, 4)?
    if id == 0 {
      return Error(InvalidDictionary())
    }
    tables.huffman = read_huffman(data, mut c)?
    tables.offsets = read_fse(data, mut c, 32, 8)?
    tables.matches = read_fse(data, mut c, 53, 9)?
    tables.literals = read_fse(data, mut c, 36, 9)?
    let r1 = word(data, mut c, 4)?
    let r2 = word(data, mut c, 4)?
    let r3 = word(data, mut c, 4)?
    let size = core@1/bytes.len(data) - c.pos
    if r1 == 0 || r2 == 0 || r3 == 0 || r1 > size || r2 > size || r3 > size {
      return Error(InvalidDictionary())
    }
    tables.repeats = [r1, r2, r3]
  } else {
    if core@1/bytes.len(data) < 8 {
      return Error(InvalidDictionary())
    }
    c.pos = 0
  }
  Ok(
    Dictionary(
      id: id,
      content: core@1/bytes.slice(data, c.pos, core@1/bytes.len(data)),
      tables: take tables
    )
  )
}

/// Decode concatenated Zstandard and skippable frames. Checksums are always
/// verified. max_output bounds the total returned bytes; max_window bounds each
/// frame's declared history requirement, including single-segment content size.
/// Rejects oversize headers before allocating output or entropy tables for them.
pub fn decode(data: Bytes, max_output: u64, max_window: u64) -> Result[
  unique Bytes,
  ZstdError
] uses {} {
  decode_frames(data, None(), max_output, max_window)
}

/// Decode using a dictionary, reset independently for every frame. A nonzero
/// frame dictionary ID must match; ID zero permits caller-selected raw content.
pub fn decode_with_dictionary(
  data: Bytes,
  dict: Dictionary,
  max_output: u64,
  max_window: u64
) -> Result[unique Bytes, ZstdError] uses {} {
  decode_frames(data, Some(dict), max_output, max_window)
}

fn decode_frames(
  data: Bytes,
  dict: Option[Dictionary],
  max_output: u64,
  max_window: u64
) -> Result[unique Bytes, ZstdError] uses {} {
  let mut c = Cursor(pos: 0)
  let mut out: List[u8] = []
  if core@1/bytes.len(data) == 0 {
    return Error(Truncated())
  }
  while c.pos < core@1/bytes.len(data) {
    let magic = word(data, mut c, 4)?
    if magic >= 0x184d2a50 && magic <= 0x184d2a5f {
      let size = word(data, mut c, 4)?
      let Some(_) = section(data, mut c, size) else {
        return Error(Truncated())
      }
      continue
    }
    if magic != 0xfd2fb528 {
      return Error(BadMagic())
    }
    let descriptor = word(data, mut c, 1)?
    if descriptor & 8 != 0 {
      return Error(ReservedBit())
    }
    let single = descriptor & 32 != 0
    let mut window: u64 = 0
    if !single {
      let wd = word(data, mut c, 1)?
      let power = 1u64 << 10 + (wd >> 3)
      window = power + power / 8 * (wd & 7)
    }
    let id_flag = descriptor & 3
    let id_width = if id_flag == 3 {
      4u64
    } else {
      id_flag
    }
    let id = word(data, mut c, id_width)?
    let flag = descriptor >> 6
    let width = if flag == 0 && !single {
      0u64
    } else {
      1u64 << flag
    }
    let mut content_size = word(data, mut c, width)?
    if width == 2 {
      content_size += 256
    }
    if single {
      window = content_size
    }
    if window > max_window {
      return Error(WindowTooLarge(window))
    }
    if width > 0 && content_size > max_output - core@1/list.len(out) {
      return Error(OutputTooLarge())
    }
    let (initial_tables, content) = match dict {
      None() => {
        if id != 0 {
          return Error(DictionaryRequired(id))
        }
        (empty_tables(), b"")
      },
      Some(d) => {
        if id != 0 && id != d.id {
          return Error(DictionaryMismatch())
        }
        (d.tables, d.content)
      },
    }
    let mut tables = take initial_tables
    let base = core@1/list.len(out)
    let block_limit = if window < 131072 {
      window
    } else {
      131072u64
    }
    let mut last = false
    while !last {
      let header = word(data, mut c, 3)?
      last = header & 1 != 0
      let kind = header >> 1 & 3
      let size = header >> 3
      if kind == 3 {
        return Error(Corrupt())
      }
      if size > block_limit {
        return Error(BlockOversize())
      }
      if kind == 2 {
        let Some(block) = section(data, mut c, size) else {
          return Error(Truncated())
        }
        compressed_block(
          block,
          mut tables,
          content,
          base,
          window,
          block_limit,
          max_output,
          mut out
        )?
      } else {
        if size > max_output - core@1/list.len(out) {
          return Error(OutputTooLarge())
        }
        let Some(bytes) = section(
          data,
          mut c,
          if kind == 1 {
            1u64
          } else {
            size
          }
        ) else {
          return Error(Truncated())
        }
        if kind == 0 {
          core@1/bytes.append(mut out, bytes)
        } else if size > 0 {
          core@1/list.push(mut out, bytes[0])
          core@1/bytes.append_from_history(mut out, 1, size - 1)
        }
      }
      if width > 0 && core@1/list.len(out) - base > content_size {
        return Error(ContentSize())
      }
    }
    if width > 0 && core@1/list.len(out) - base != content_size {
      return Error(ContentSize())
    }
    if descriptor & 4 != 0 {
      let expected = word(data, mut c, 4)?
      let mut hash = xxhash64.new()
      xxhash64.update_list(mut hash, out, base)
      if xxhash64.finish(take hash) & 0xffffffff != expected {
        return Error(Checksum())
      }
    }
  }
  Ok(core@1/bytes.from_list(take out))
}
