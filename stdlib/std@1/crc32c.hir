// Go hash/crc32 Castagnoli table (BSD-3-Clause): CRC-32C, the reflected polynomial
// 0x82f63b78 of iSCSI, SCTP, ext4 and Btrfs, over crc32's kernel. This is an
// error-detecting checksum, not a cryptographic digest.
pub opaque type State: plain + inert uses {} {
  crc: u32,
}

// Go crc32_generic.go:60-70 at ebe2feefc400, shared with the IEEE kernel.
const TABLE: Inline[u32, 2048] = comptime std@1/crc32.slicing_make_table(0x82f63b78)

@noalloc
pub fn new() -> State uses {} {
  State(crc: 0xffffffff)
}

@noalloc
pub fn update(mut state: State, data: Bytes) -> () uses {} {
  state.crc = std@1/crc32.extend(state.crc, TABLE, data)
}

@noalloc
pub fn finish(take state: State) -> u32 uses {} {
  ~state.crc
}

@noalloc
pub fn digest(data: Bytes) -> u32 uses {} {
  let mut state = new()
  update(mut state, data)
  finish(take state)
}

pub fn digest_hex(data: Bytes) -> unique String uses {} {
  let value = digest(data)
  f"{value:08x}"
}
