// Arbitrary-precision integers: a sign and a little-endian magnitude of u64 limbs.
// Magnitude kernels adapted from Rust num-bigint biguint/{addition,subtraction,
// multiplication,division,shift,power}.rs and the Stein gcd of its integer.rs;
// radix conversion and the two's-complement bitwise identities from Go math/big
// natconv.go and int.go.
// Copyright (c) 2014 The Rust Project Developers. MIT; Copyright 2009 The Go Authors.
// BSD-3-Clause; third-party/NOTICES.md.
/// An exact integer of any size. Its representation is canonical (no high zero
/// limbs, and zero is never negative), so `==` and hashing compare values.
@format(format_into)
pub opaque type BigInt: copyable + data + key + inert + noalloc_drop uses {} {
  negative: bool,
  magnitude: List[u64],
}

// num-bigint multiplication.rs multiplies by schoolbook at or below 32 limbs.
const KARATSUBA_THRESHOLD: u64 = 32

// Measured native crossover; see docs/notes/bigint-toom3.md.
const TOOM3_THRESHOLD: u64 = 128

const LIMB_MAX: u64 = 18446744073709551615

// Magnitudes are little-endian limb lists without high zero limbs; zero is empty.
fn make(negative: bool, take magnitude: List[u64]) -> BigInt uses {} {
  let nonzero = core@1/list.len(magnitude) != 0
  BigInt(negative: negative && nonzero, magnitude: take magnitude)
}

fn zeros(count: u64) -> List[u64] uses {} {
  let mut out: unique List[u64] = []
  core@1/list.reserve(mut out, count)
  for _ in 0u64..count {
    core@1/list.push(mut out, 0)
  }
  out
}

fn trim(mut xs: unique List[u64]) -> () uses {} {
  let mut n = core@1/list.len(xs)
  while n > 0 && xs[n - 1] == 0 {
    let _ = core@1/list.pop(mut xs)
    n -= 1
  }
}

// The limbs of `xs` from `start` to `end`, without high zero limbs.
fn slice_magnitude(xs: List[u64], start: u64, end: u64) -> List[u64] uses {} {
  let mut out: unique List[u64] = []
  core@1/list.reserve(mut out, end - start)
  for i in start..end {
    core@1/list.push(mut out, xs[i])
  }
  trim(mut out)
  out
}

fn compare_magnitudes(a: List[u64], b: List[u64]) -> i32 uses {} {
  let la = core@1/list.len(a)
  let lb = core@1/list.len(b)
  if la != lb {
    return if la < lb {
      -1
    } else {
      1
    }
  }
  let mut i = la
  while i > 0 {
    i -= 1
    if a[i] != b[i] {
      return if a[i] < b[i] {
        -1
      } else {
        1
      }
    }
  }
  0
}

fn add_magnitudes(a: List[u64], b: List[u64]) -> List[u64] uses {} {
  let la = core@1/list.len(a)
  let lb = core@1/list.len(b)
  let longest = if la < lb {
    lb
  } else {
    la
  }
  let mut out: unique List[u64] = []
  core@1/list.reserve(mut out, longest + 1)
  let mut carry: u64 = 0
  for i in 0u64..longest {
    let mut sum: u128 = core@1/int.widen(carry)
    if i < la {
      sum += core@1/int.widen(a[i])
    }
    if i < lb {
      sum += core@1/int.widen(b[i])
    }
    core@1/list.push(mut out, core@1/int.truncate(sum))
    carry = core@1/int.narrow(sum >> 64)
  }
  if carry != 0 {
    core@1/list.push(mut out, carry)
  }
  out
}

// a - b for a >= b.
fn sub_magnitudes(a: List[u64], b: List[u64]) -> List[u64] uses {} {
  let la = core@1/list.len(a)
  let lb = core@1/list.len(b)
  let mut out: unique List[u64] = []
  core@1/list.reserve(mut out, la)
  let mut borrow: u64 = 0
  for i in 0u64..la {
    let subtrahend: u128 = if i < lb {
      core@1/int.widen(b[i])
    } else {
      0
    }
    let total = subtrahend + core@1/int.widen(borrow)
    let minuend: u128 = core@1/int.widen(a[i])
    if minuend >= total {
      core@1/list.push(mut out, core@1/int.narrow(minuend - total))
      borrow = 0
    } else {
      core@1/list.push(mut out, core@1/int.narrow((minuend | 1u128 << 64) - total))
      borrow = 1
    }
  }
  core@1/failure.check(borrow == 0, Arithmetic())
  trim(mut out)
  out
}

// acc[offset..] += p, carrying through the rest of acc; acc has room for the sum.
fn add_at(mut acc: unique List[u64], offset: u64, p: List[u64]) -> () uses {} {
  let length = core@1/list.len(acc)
  let lp = core@1/list.len(p)
  let mut carry: u64 = 0
  let mut i: u64 = 0
  while i < lp || carry != 0 {
    let mut sum: u128 = core@1/int.widen(acc[offset + i]) + core@1/int.widen(carry)
    if i < lp {
      sum += core@1/int.widen(p[i])
    }
    acc[offset + i] = core@1/int.truncate(sum)
    carry = core@1/int.narrow(sum >> 64)
    i += 1
    core@1/failure.check(offset + i < length || carry == 0, Arithmetic())
  }
}

// acc[offset..] -= p, borrowing through the rest of acc; the difference is nonnegative.
fn sub_at(mut acc: unique List[u64], offset: u64, p: List[u64]) -> () uses {} {
  let length = core@1/list.len(acc)
  let lp = core@1/list.len(p)
  let mut borrow: u64 = 0
  let mut i: u64 = 0
  while i < lp || borrow != 0 {
    core@1/failure.check(offset + i < length, Arithmetic())
    let mut total: u128 = core@1/int.widen(borrow)
    if i < lp {
      total += core@1/int.widen(p[i])
    }
    let minuend: u128 = core@1/int.widen(acc[offset + i])
    if minuend >= total {
      acc[offset + i] = core@1/int.narrow(minuend - total)
      borrow = 0
    } else {
      acc[offset + i] = core@1/int.narrow((minuend | 1u128 << 64) - total)
      borrow = 1
    }
    i += 1
  }
}

fn mul_schoolbook(x: List[u64], y: List[u64]) -> List[u64] uses {} {
  let lx = core@1/list.len(x)
  let ly = core@1/list.len(y)
  let mut out = zeros(lx + ly)
  for i in 0u64..lx {
    let xi: u128 = core@1/int.widen(x[i])
    if xi != 0 {
      let mut carry: u64 = 0
      for j in 0u64..ly {
        let partial: u128 = core@1/int.widen(out[i + j]) + core@1/int.widen(carry)
        let t = xi * core@1/int.widen(y[j]) + partial
        out[i + j] = core@1/int.truncate(t)
        carry = core@1/int.narrow(t >> 64)
      }
      out[i + ly] = carry
    }
  }
  trim(mut out)
  out
}

// |a - b| and the sign of a - b.
fn difference(a: List[u64], b: List[u64]) -> (i32, List[u64]) uses {} {
  let order = compare_magnitudes(a, b)
  if order > 0 {
    (1, sub_magnitudes(a, b))
  } else if order < 0 {
    (-1, sub_magnitudes(b, a))
  } else {
    let empty: unique List[u64] = []
    (0, empty)
  }
}

// num-bigint mac3's Karatsuba step, for KARATSUBA_THRESHOLD < len(x) <= len(y) < 2 len(x):
// x*y = x1*y1*b^2 + (x1*y1 + x0*y0 - (x1 - x0)*(y1 - y0))*b + x0*y0.
fn karatsuba(x: List[u64], y: List[u64]) -> List[u64] uses {} {
  let lx = core@1/list.len(x)
  let ly = core@1/list.len(y)
  let half = lx / 2
  let x0 = slice_magnitude(x, 0, half)
  let x1 = slice_magnitude(x, half, lx)
  let y0 = slice_magnitude(y, 0, half)
  let y1 = slice_magnitude(y, half, ly)
  let mut acc = zeros(lx + ly + 1)
  let high = mul_magnitudes(x1, y1)
  add_at(mut acc, half, high)
  add_at(mut acc, half * 2, high)
  let low = mul_magnitudes(x0, y0)
  add_at(mut acc, 0, low)
  add_at(mut acc, half, low)
  let (sign_x, dx) = difference(x1, x0)
  let (sign_y, dy) = difference(y1, y0)
  let sign = sign_x * sign_y
  if sign > 0 {
    sub_at(mut acc, half, mul_magnitudes(dx, dy))
  } else if sign < 0 {
    add_at(mut acc, half, mul_magnitudes(dx, dy))
  }
  trim(mut acc)
  acc
}

// num-bigint 41f0b035 src/biguint/multiplication.rs:285-431 (MIT/Apache-2.0).
// Evaluate at 0, 1, -1, -2, infinity, then Bodrato interpolation. Signed
// temporaries matter: the evaluations at negative points need not be positive.
fn toom3(x: List[u64], y: List[u64]) -> List[u64] uses {} {
  let lx = core@1/list.len(x)
  let ly = core@1/list.len(y)
  let width = ly / 3 + 1
  let x0_end = if lx < width {
    lx
  } else {
    width
  }
  let x1_end = if lx < width * 2 {
    lx
  } else {
    width * 2
  }
  let y1_end = if ly < width * 2 {
    ly
  } else {
    width * 2
  }
  let x0 = make(false, slice_magnitude(x, 0, x0_end))
  let x1 = make(false, slice_magnitude(x, x0_end, x1_end))
  let x2 = make(false, slice_magnitude(x, x1_end, lx))
  let y0 = make(false, slice_magnitude(y, 0, width))
  let y1 = make(false, slice_magnitude(y, width, y1_end))
  let y2 = make(false, slice_magnitude(y, y1_end, ly))
  let p = add(x0, x2)
  let q = add(y0, y2)
  let p2 = sub(p, x1)
  let q2 = sub(q, y1)
  let r0 = mul(x0, y0)
  let r4 = mul(x2, y2)
  let r1 = mul(add(p, x1), add(q, y1))
  let r2 = mul(p2, q2)
  let r3 = mul(sub(shl(add(p2, x2), 1), x0), sub(shl(add(q2, y2), 1), y0))
  let mut comp3 = toom_div_exact(sub(r3, r1), 3)
  let mut comp1 = toom_div_exact(sub(r1, r2), 2)
  let mut comp2 = sub(r2, r0)
  comp3 = add(toom_div_exact(sub(comp2, comp3), 2), shl(r4, 1))
  comp2 = add(comp2, sub(comp1, r4))
  comp1 = sub(comp1, comp3)
  let mut acc = zeros(lx + ly + 1)
  // High to low, as in mac3: any negative term borrows from higher terms.
  toom_accumulate(mut acc, width * 4, r4)
  toom_accumulate(mut acc, width * 3, comp3)
  toom_accumulate(mut acc, width * 2, comp2)
  toom_accumulate(mut acc, width, comp1)
  toom_accumulate(mut acc, 0, r0)
  trim(mut acc)
  acc
}

fn toom_div_exact(value: BigInt, divisor: u64) -> BigInt uses {} {
  let (q, r) = divide_word(value.magnitude, divisor)
  core@1/failure.check(r == 0, Arithmetic())
  make(value.negative, take q)
}

fn toom_accumulate(mut acc: unique List[u64], offset: u64, value: BigInt) -> () uses {} {
  if value.negative {
    sub_at(mut acc, offset, value.magnitude)
  } else {
    add_at(mut acc, offset, value.magnitude)
  }
}

// len(x) <= len(y): schoolbook, Karatsuba, Toom-3, or len(x)-limb chunks of y.
fn mul_ordered(x: List[u64], y: List[u64]) -> List[u64] uses {} {
  let lx = core@1/list.len(x)
  let ly = core@1/list.len(y)
  if lx == 0 {
    let empty: unique List[u64] = []
    return empty
  }
  if lx <= KARATSUBA_THRESHOLD {
    return mul_schoolbook(x, y)
  }
  if lx * 2 > ly {
    if lx <= TOOM3_THRESHOLD {
      return karatsuba(x, y)
    }
    return toom3(x, y)
  }
  let mut acc = zeros(lx + ly + 1)
  let mut start: u64 = 0
  while start < ly {
    let end = if start + lx < ly {
      start + lx
    } else {
      ly
    }
    let chunk = slice_magnitude(y, start, end)
    add_at(mut acc, start, mul_magnitudes(x, chunk))
    start = end
  }
  trim(mut acc)
  acc
}

fn mul_magnitudes(a: List[u64], b: List[u64]) -> List[u64] uses {} {
  if core@1/list.len(a) <= core@1/list.len(b) {
    mul_ordered(a, b)
  } else {
    mul_ordered(b, a)
  }
}

// z = z * m + a in place, for the radix parser.
fn mul_add_word(mut z: unique List[u64], m: u64, a: u64) -> () uses {} {
  let wide_m: u128 = core@1/int.widen(m)
  let mut carry = a
  for i in 0u64..core@1/list.len(z) {
    let t: u128 = core@1/int.widen(z[i]) * wide_m + core@1/int.widen(carry)
    z[i] = core@1/int.truncate(t)
    carry = core@1/int.narrow(t >> 64)
  }
  if carry != 0 {
    core@1/list.push(mut z, carry)
  }
}

fn divide_word(a: List[u64], d: u64) -> (List[u64], u64) uses {} {
  let length = core@1/list.len(a)
  let mut q = zeros(length)
  let divisor: u128 = core@1/int.widen(d)
  let mut rem: u64 = 0
  let mut i = length
  while i > 0 {
    i -= 1
    let top: u128 = core@1/int.widen(rem) << 64 | core@1/int.widen(a[i])
    q[i] = core@1/int.narrow(top / divisor)
    rem = core@1/int.narrow(top % divisor)
  }
  trim(mut q)
  (q, rem)
}

// Trailing zero bits of a nonzero magnitude.
fn trailing_zero_bits(a: List[u64]) -> u64 uses {} {
  let mut i: u64 = 0
  while a[i] == 0 {
    i += 1
  }
  i * 64 + core@1/int.trailing_zeros(a[i])
}

fn shift_left_magnitude(a: List[u64], bits: u64) -> List[u64] uses {} {
  let length = core@1/list.len(a)
  if length == 0 {
    let empty: unique List[u64] = []
    return empty
  }
  let limbs = bits / 64
  let shift = bits % 64
  let mut out = zeros(limbs)
  core@1/list.reserve(mut out, limbs + length + 1)
  if shift == 0 {
    for x in a {
      core@1/list.push(mut out, x)
    }
    return out
  }
  let mut carry: u64 = 0
  for x in a {
    core@1/list.push(mut out, x << shift | carry)
    carry = x >> 64 - shift
  }
  if carry != 0 {
    core@1/list.push(mut out, carry)
  }
  out
}

fn shift_right_magnitude(a: List[u64], bits: u64) -> List[u64] uses {} {
  let length = core@1/list.len(a)
  let limbs = bits / 64
  let shift = bits % 64
  let mut out: unique List[u64] = []
  if limbs >= length {
    return out
  }
  core@1/list.reserve(mut out, length - limbs)
  for i in limbs..length {
    let mut word = a[i] >> shift
    if shift != 0 && i + 1 < length {
      word |= a[i + 1] << 64 - shift
    }
    core@1/list.push(mut out, word)
  }
  trim(mut out)
  out
}

// num-bigint div_rem_core: Knuth TAOCP 4.3.1 algorithm D with the exercise 19-21 estimate.
// The divisor has at least two limbs and a <= b is handled by the caller.
fn divide_long(a: List[u64], b: List[u64]) -> (List[u64], List[u64]) uses {} {
  let shift = core@1/int.leading_zeros(b[core@1/list.len(b) - 1])
  let divisor = shift_left_magnitude(b, shift)
  let mut rest = shift_left_magnitude(a, shift)
  let length = core@1/list.len(divisor)
  let b0: u128 = core@1/int.widen(divisor[length - 1])
  let b1: u128 = core@1/int.widen(divisor[length - 2])
  let quotient_length = core@1/list.len(rest) - length + 1
  let mut q = zeros(quotient_length)
  // a0 is the dividend limb above rest[top - 1]; it is zeroed by each step.
  let mut a0: u64 = 0
  let mut top = core@1/list.len(rest)
  let mut j = quotient_length
  while j > 0 {
    j -= 1
    let a1: u128 = core@1/int.widen(rest[top - 1])
    let a2: u128 = core@1/int.widen(rest[top - 2])
    let wide_a0: u128 = core@1/int.widen(a0)
    let mut q0: u64 = LIMB_MAX
    let mut r: u128 = wide_a0 + a1
    if wide_a0 < b0 {
      let head = wide_a0 << 64 | a1
      q0 = core@1/int.narrow(head / b0)
      r = head % b0
    }
    let limb_max: u128 = core@1/int.widen(LIMB_MAX)
    while r <= limb_max && r << 64 | a2 < core@1/int.widen(q0) * b1 {
      q0 -= 1
      r += b0
    }
    let mut borrow = sub_mul_word(mut rest, j, divisor, q0)
    if borrow > a0 {
      q0 -= 1
      borrow -= add_back(mut rest, j, divisor)
    }
    core@1/failure.check(borrow == a0, Arithmetic())
    q[j] = q0
    top -= 1
    a0 = rest[top]
  }
  trim(mut q)
  let remainder = slice_magnitude(rest, 0, length)
  (q, shift_right_magnitude(remainder, shift))
}

// a[offset..offset + len(b)] -= b * c; returns the borrow out of the top limb.
fn sub_mul_word(mut a: unique List[u64], offset: u64, b: List[u64], c: u64) -> u64 uses {} {
  let limb_max: u128 = core@1/int.widen(LIMB_MAX)
  let wide_c: u128 = core@1/int.widen(c)
  // The carry lies in [-LIMB_MAX, 0]; store it offset by LIMB_MAX.
  let mut offset_carry: u64 = LIMB_MAX
  for i in 0u64..core@1/list.len(b) {
    let high: u128 = limb_max << 64 | core@1/int.widen(a[offset + i])
    let sum = high - limb_max + core@1/int.widen(offset_carry) - core@1/int.widen(b[i]) * wide_c
    offset_carry = core@1/int.narrow(sum >> 64)
    a[offset + i] = core@1/int.truncate(sum)
  }
  LIMB_MAX - offset_carry
}

// a[offset..offset + len(b)] += b; returns the carry out of the top limb.
fn add_back(mut a: unique List[u64], offset: u64, b: List[u64]) -> u64 uses {} {
  let mut carry: u64 = 0
  for i in 0u64..core@1/list.len(b) {
    let partial: u128 = core@1/int.widen(a[offset + i]) + core@1/int.widen(carry)
    let sum = partial + core@1/int.widen(b[i])
    a[offset + i] = core@1/int.truncate(sum)
    carry = core@1/int.narrow(sum >> 64)
  }
  carry
}

// Quotient and remainder of magnitudes; b is nonzero.
fn divide_magnitudes(a: List[u64], b: List[u64]) -> (List[u64], List[u64]) uses {} {
  if compare_magnitudes(a, b) < 0 {
    let empty: unique List[u64] = []
    return (empty, slice_magnitude(a, 0, core@1/list.len(a)))
  }
  if core@1/list.len(b) == 1 {
    let (q, r) = divide_word(a, b[0])
    let mut rem: unique List[u64] = []
    if r != 0 {
      core@1/list.push(mut rem, r)
    }
    return (q, rem)
  }
  divide_long(a, b)
}

fn plus_one(a: List[u64]) -> List[u64] uses {} {
  add_magnitudes(a, [1u64])
}

fn minus_one(a: List[u64]) -> List[u64] uses {} {
  sub_magnitudes(a, [1u64])
}

fn and_magnitudes(a: List[u64], b: List[u64]) -> List[u64] uses {} {
  let la = core@1/list.len(a)
  let lb = core@1/list.len(b)
  let shortest = if la < lb {
    la
  } else {
    lb
  }
  let mut out: unique List[u64] = []
  for i in 0u64..shortest {
    core@1/list.push(mut out, a[i] & b[i])
  }
  trim(mut out)
  out
}

// a & !b.
fn and_not_magnitudes(a: List[u64], b: List[u64]) -> List[u64] uses {} {
  let lb = core@1/list.len(b)
  let mut out: unique List[u64] = []
  for i in 0u64..core@1/list.len(a) {
    if i < lb {
      core@1/list.push(mut out, a[i] & ~b[i])
    } else {
      core@1/list.push(mut out, a[i])
    }
  }
  trim(mut out)
  out
}

// `or` when `exclusive` is false, `xor` when it is true.
fn or_magnitudes(a: List[u64], b: List[u64], exclusive: bool) -> List[u64] uses {} {
  let la = core@1/list.len(a)
  let lb = core@1/list.len(b)
  let longest = if la < lb {
    lb
  } else {
    la
  }
  let mut out: unique List[u64] = []
  for i in 0u64..longest {
    let x = if i < la {
      a[i]
    } else {
      0
    }
    let y = if i < lb {
      b[i]
    } else {
      0
    }
    if exclusive {
      core@1/list.push(mut out, x ^ y)
    } else {
      core@1/list.push(mut out, x | y)
    }
  }
  trim(mut out)
  out
}

// The largest power of `radix` that fits a limb, and its digit count.
fn word_power(radix: u64) -> (u64, u64) uses {} {
  let mut power = radix
  let mut digits: u64 = 1
  while power <= LIMB_MAX / radix {
    power *= radix
    digits += 1
  }
  (power, digits)
}

fn digit_byte(digit: u64) -> u8 uses {} {
  let d: u8 = core@1/int.narrow(digit)
  if d < 10 {
    d + 48
  } else {
    d + 87
  }
}

// Appends `width` digits of `value`, most significant first.
fn append_chunk(mut out: List[u8], value: u64, radix: u64, width: u64) -> () uses {} {
  let mut scale: u64 = 1
  for _ in 1u64..width {
    scale *= radix
  }
  let mut rest = value
  while scale > 0 {
    core@1/list.push(mut out, digit_byte(rest / scale))
    rest %= scale
    scale /= radix
  }
}

// Go natconv utoa: divide by the largest limb power of the radix, then expand each chunk.
fn append_magnitude(mut out: List[u8], magnitude: List[u64], radix: u64) -> () uses {} {
  if core@1/list.len(magnitude) == 0 {
    core@1/list.push(mut out, 48)
    return
  }
  let (power, digits) = word_power(radix)
  let mut chunks: List[u64] = []
  let mut rest = slice_magnitude(magnitude, 0, core@1/list.len(magnitude))
  while core@1/list.len(rest) != 0 {
    let (q, r) = divide_word(rest, power)
    core@1/list.push(mut chunks, r)
    rest = q
  }
  let mut i = core@1/list.len(chunks) - 1
  let leading = chunks[i]
  let mut width: u64 = 1
  let mut probe = leading / radix
  while probe != 0 {
    width += 1
    probe /= radix
  }
  append_chunk(mut out, leading, radix, width)
  while i > 0 {
    i -= 1
    append_chunk(mut out, chunks[i], radix, digits)
  }
}

/// Zero.
pub fn zero() -> BigInt uses {} {
  make(false, [])
}

/// The value of an unsigned 128-bit integer; the narrower widths widen to it.
pub fn from_u128(value: u128) -> BigInt uses {} {
  let low: u64 = core@1/int.truncate(value)
  let high: u64 = core@1/int.narrow(value >> 64)
  let mut magnitude: unique List[u64] = [low, high]
  trim(mut magnitude)
  make(false, take magnitude)
}

/// The value of a signed 128-bit integer; the narrower widths widen to it.
pub fn from_i128(value: i128) -> BigInt uses {} {
  if value >= 0 {
    return from_u128(core@1/int.narrow(value))
  }
  let below: u128 = core@1/int.narrow(-(value + 1))
  neg(from_u128(below + 1))
}

pub fn from_u8(value: u8) -> BigInt uses {} {
  from_u128(core@1/int.widen(value))
}

pub fn from_u16(value: u16) -> BigInt uses {} {
  from_u128(core@1/int.widen(value))
}

pub fn from_u32(value: u32) -> BigInt uses {} {
  from_u128(core@1/int.widen(value))
}

pub fn from_u64(value: u64) -> BigInt uses {} {
  from_u128(core@1/int.widen(value))
}

pub fn from_i8(value: i8) -> BigInt uses {} {
  from_i128(core@1/int.widen(value))
}

pub fn from_i16(value: i16) -> BigInt uses {} {
  from_i128(core@1/int.widen(value))
}

pub fn from_i32(value: i32) -> BigInt uses {} {
  from_i128(core@1/int.widen(value))
}

pub fn from_i64(value: i64) -> BigInt uses {} {
  from_i128(core@1/int.widen(value))
}

// The magnitude as a u128, when it fits.
fn magnitude_u128(magnitude: List[u64]) -> Option[u128] uses {} {
  let length = core@1/list.len(magnitude)
  if length > 2 {
    return None()
  }
  let mut value: u128 = 0
  if length > 1 {
    value = core@1/int.widen(magnitude[1])
    value <<= 64
  }
  if length > 0 {
    value |= core@1/int.widen(magnitude[0])
  }
  Some(value)
}

/// The value as a u128, or None when it is negative or too large.
pub fn to_u128(value: BigInt) -> Option[u128] uses {} {
  if value.negative {
    return None()
  }
  magnitude_u128(value.magnitude)
}

/// The value as an i128, or None when it is out of range.
pub fn to_i128(value: BigInt) -> Option[i128] uses {} {
  let Some(m) = magnitude_u128(value.magnitude) else {
    return None()
  }
  if !value.negative {
    return core@1/int.try_narrow(m)
  }
  if m == 1u128 << 127 {
    return Some(-170141183460469231731687303715884105727i128 - 1)
  }
  let narrowed: Option[i128] = core@1/int.try_narrow(m)
  match narrowed {
    Some(v) => Some(-v),
    None() => None(),
  }
}

pub fn to_u8(value: BigInt) -> Option[u8] uses {} {
  match to_u128(value) {
    Some(v) => core@1/int.try_narrow(v),
    None() => None(),
  }
}

pub fn to_u16(value: BigInt) -> Option[u16] uses {} {
  match to_u128(value) {
    Some(v) => core@1/int.try_narrow(v),
    None() => None(),
  }
}

pub fn to_u32(value: BigInt) -> Option[u32] uses {} {
  match to_u128(value) {
    Some(v) => core@1/int.try_narrow(v),
    None() => None(),
  }
}

pub fn to_u64(value: BigInt) -> Option[u64] uses {} {
  match to_u128(value) {
    Some(v) => core@1/int.try_narrow(v),
    None() => None(),
  }
}

pub fn to_i8(value: BigInt) -> Option[i8] uses {} {
  match to_i128(value) {
    Some(v) => core@1/int.try_narrow(v),
    None() => None(),
  }
}

pub fn to_i16(value: BigInt) -> Option[i16] uses {} {
  match to_i128(value) {
    Some(v) => core@1/int.try_narrow(v),
    None() => None(),
  }
}

pub fn to_i32(value: BigInt) -> Option[i32] uses {} {
  match to_i128(value) {
    Some(v) => core@1/int.try_narrow(v),
    None() => None(),
  }
}

pub fn to_i64(value: BigInt) -> Option[i64] uses {} {
  match to_i128(value) {
    Some(v) => core@1/int.try_narrow(v),
    None() => None(),
  }
}

pub fn is_zero(value: BigInt) -> bool uses {} {
  core@1/list.len(value.magnitude) == 0
}

pub fn is_negative(value: BigInt) -> bool uses {} {
  value.negative
}

/// -1, 0 or 1 by the sign of `value`.
pub fn signum(value: BigInt) -> i32 uses {} {
  if value.negative {
    -1
  } else if core@1/list.len(value.magnitude) == 0 {
    0
  } else {
    1
  }
}

/// -1, 0 or 1 as `a` is less than, equal to or greater than `b`.
pub fn compare(a: BigInt, b: BigInt) -> i32 uses {} {
  if a.negative != b.negative {
    return if a.negative {
      -1
    } else {
      1
    }
  }
  let order = compare_magnitudes(a.magnitude, b.magnitude)
  if a.negative {
    -order
  } else {
    order
  }
}

pub fn neg(value: BigInt) -> BigInt uses {} {
  make(!value.negative, unique value.magnitude)
}

pub fn abs(value: BigInt) -> BigInt uses {} {
  make(false, unique value.magnitude)
}

// The sum of signed magnitudes.
fn combine(a_negative: bool, a: List[u64], b_negative: bool, b: List[u64]) -> BigInt uses {} {
  if a_negative == b_negative {
    return make(a_negative, add_magnitudes(a, b))
  }
  let order = compare_magnitudes(a, b)
  if order > 0 {
    make(a_negative, sub_magnitudes(a, b))
  } else if order < 0 {
    make(b_negative, sub_magnitudes(b, a))
  } else {
    zero()
  }
}

pub fn add(a: BigInt, b: BigInt) -> BigInt uses {} {
  combine(a.negative, a.magnitude, b.negative, b.magnitude)
}

pub fn sub(a: BigInt, b: BigInt) -> BigInt uses {} {
  combine(a.negative, a.magnitude, !b.negative, b.magnitude)
}

/// The product; operands longer than 32 limbs multiply by Karatsuba.
pub fn mul(a: BigInt, b: BigInt) -> BigInt uses {} {
  make(a.negative != b.negative, mul_magnitudes(a.magnitude, b.magnitude))
}

/// The quotient truncated toward zero and the remainder with the dividend's sign, as
/// integer `/` and `%`. A zero divisor fails SEM-1.
pub fn div_rem(a: BigInt, b: BigInt) -> (BigInt, BigInt) uses {} {
  core@1/failure.check(core@1/list.len(b.magnitude) != 0, Arithmetic())
  let (q, r) = divide_magnitudes(a.magnitude, b.magnitude)
  (make(a.negative != b.negative, take q), make(a.negative, take r))
}

/// The quotient rounded toward negative infinity and the remainder with the divisor's
/// sign, as `int.div_floor` and `int.mod`. A zero divisor fails SEM-1.
pub fn div_mod_floor(a: BigInt, b: BigInt) -> (BigInt, BigInt) uses {} {
  let (q, r) = div_rem(a, b)
  if r.negative != b.negative && !is_zero(r) {
    return (sub(q, from_u64(1)), add(r, b))
  }
  (q, r)
}

/// `base` raised to `exponent`, by binary exponentiation; zero to the zero is one.
pub fn pow(base: BigInt, exponent: u64) -> BigInt uses {} {
  let mut product = from_u64(1)
  let mut square = copy base
  let mut e = exponent
  while e != 0 {
    if e & 1 == 1 {
      product = mul(product, square)
    }
    e >>= 1
    if e != 0 {
      square = mul(square, square)
    }
  }
  product
}

/// The nonnegative greatest common divisor; gcd(0, 0) is 0. Stein's binary algorithm.
pub fn gcd(a: BigInt, b: BigInt) -> BigInt uses {} {
  if is_zero(a) {
    return abs(b)
  }
  if is_zero(b) {
    return abs(a)
  }
  let za = trailing_zero_bits(a.magnitude)
  let zb = trailing_zero_bits(b.magnitude)
  let common = if za < zb {
    za
  } else {
    zb
  }
  let mut m = shift_right_magnitude(a.magnitude, za)
  let mut n = shift_right_magnitude(b.magnitude, zb)
  while core@1/list.len(m) != 0 {
    m = shift_right_magnitude(m, trailing_zero_bits(m))
    if compare_magnitudes(n, m) > 0 {
      let swap = take m
      m = take n
      n = take swap
    }
    m = sub_magnitudes(m, n)
  }
  make(false, shift_left_magnitude(n, common))
}

/// The number of bits in the magnitude; zero has none.
pub fn bit_length(value: BigInt) -> u64 uses {} {
  let length = core@1/list.len(value.magnitude)
  if length == 0 {
    return 0
  }
  length * 64 - core@1/int.leading_zeros(value.magnitude[length - 1])
}

/// `value` times 2 to the `bits`.
pub fn shl(value: BigInt, bits: u64) -> BigInt uses {} {
  make(value.negative, shift_left_magnitude(value.magnitude, bits))
}

/// `value` divided by 2 to the `bits`, rounded toward negative infinity, as an
/// arithmetic shift of the two's-complement value.
pub fn shr(value: BigInt, bits: u64) -> BigInt uses {} {
  let q = shift_right_magnitude(value.magnitude, bits)
  if value.negative && trailing_zero_bits(value.magnitude) < bits {
    return make(true, plus_one(q))
  }
  make(value.negative, take q)
}

// Bitwise operations act on infinite two's-complement values, by Go math/big's identities
// -x = ^(x - 1) and ^x = -(x + 1).
/// Bitwise and.
pub fn bit_and(a: BigInt, b: BigInt) -> BigInt uses {} {
  if a.negative && b.negative {
    // ^(x-1) & ^(y-1) == ^((x-1) | (y-1))
    let ored = or_magnitudes(minus_one(a.magnitude), minus_one(b.magnitude), false)
    return make(true, plus_one(ored))
  }
  if a.negative {
    return make(false, and_not_magnitudes(b.magnitude, minus_one(a.magnitude)))
  }
  if b.negative {
    return make(false, and_not_magnitudes(a.magnitude, minus_one(b.magnitude)))
  }
  make(false, and_magnitudes(a.magnitude, b.magnitude))
}

/// Bitwise inclusive or.
pub fn bit_or(a: BigInt, b: BigInt) -> BigInt uses {} {
  if a.negative && b.negative {
    // ^(x-1) | ^(y-1) == ^((x-1) & (y-1))
    let anded = and_magnitudes(minus_one(a.magnitude), minus_one(b.magnitude))
    return make(true, plus_one(anded))
  }
  if a.negative {
    // ^(x-1) | y == ^((x-1) &^ y)
    return make(true, plus_one(and_not_magnitudes(minus_one(a.magnitude), b.magnitude)))
  }
  if b.negative {
    return make(true, plus_one(and_not_magnitudes(minus_one(b.magnitude), a.magnitude)))
  }
  make(false, or_magnitudes(a.magnitude, b.magnitude, false))
}

/// Bitwise exclusive or.
pub fn bit_xor(a: BigInt, b: BigInt) -> BigInt uses {} {
  if a.negative && b.negative {
    // ^(x-1) ^ ^(y-1) == (x-1) ^ (y-1)
    return make(
      false,
      or_magnitudes(minus_one(a.magnitude), minus_one(b.magnitude), true)
    )
  }
  if a.negative {
    // ^(x-1) ^ y == ^((x-1) ^ y)
    return make(
      true,
      plus_one(or_magnitudes(minus_one(a.magnitude), b.magnitude, true))
    )
  }
  if b.negative {
    return make(
      true,
      plus_one(or_magnitudes(minus_one(b.magnitude), a.magnitude, true))
    )
  }
  make(false, or_magnitudes(a.magnitude, b.magnitude, true))
}

/// Bitwise complement, -value - 1.
pub fn bit_not(value: BigInt) -> BigInt uses {} {
  if value.negative {
    make(false, minus_one(value.magnitude))
  } else {
    make(true, plus_one(value.magnitude))
  }
}

/// Parses `-?[0-9]+` in decimal, as `parse_radix(text, 10)`.
pub fn parse(text: String) -> Result[BigInt, scalar.ParseError] uses {} {
  parse_radix(text, 10)
}

/// Parses an optional minus and one or more digits of `radix` (2 through 36, either
/// letter case). Leading zeros are accepted; a plus, whitespace, underscores and radix
/// prefixes are `Invalid`, as is an invalid radix. No value is out of range.
pub fn parse_radix(text: String, radix: u8) -> Result[BigInt, scalar.ParseError] uses {} {
  if radix < 2 || radix > 36 {
    return Error(Invalid)
  }
  let bytes = core@1/string.as_bytes(text)
  let length = core@1/bytes.len(bytes)
  let negative = length > 0 && bytes[0] == 45
  let mut i: u64 = if negative {
    1
  } else {
    0
  }
  if i == length {
    return Error(Invalid)
  }
  let base: u64 = core@1/int.widen(radix)
  let (power, digits) = word_power(base)
  let mut magnitude: unique List[u64] = []
  let mut word: u64 = 0
  let mut count: u64 = 0
  while i < length {
    let Some(digit) = std@1/ascii.digit_value_radix(bytes[i], radix) else {
      return Error(Invalid)
    }
    word = word * base + core@1/int.widen(digit)
    count += 1
    if count == digits {
      mul_add_word(mut magnitude, power, word)
      word = 0
      count = 0
    }
    i += 1
  }
  if count > 0 {
    let mut scale: u64 = 1
    for _ in 0u64..count {
      scale *= base
    }
    mul_add_word(mut magnitude, scale, word)
  }
  Ok(make(negative, take magnitude))
}

/// Appends the decimal text `to_string` returns.
@preserves_unique(out)
pub fn format_into(value: BigInt, mut out: List[u8]) -> () uses {} {
  if value.negative {
    core@1/list.push(mut out, 45)
  }
  append_magnitude(mut out, value.magnitude, 10)
}

/// Decimal text: a minus for negative values, then digits without leading zeros.
pub fn to_string(value: BigInt) -> unique String uses {} {
  let mut out: List[u8] = []
  format_into(value, mut out)
  text.finish_valid(take out)
}

/// Text in `radix` 2 through 36 with lowercase letters, a minus for negative values and
/// no prefix; an invalid radix is `Invalid`.
pub fn format_radix(value: BigInt, radix: u8) -> Result[
  unique String,
  scalar.ParseError
] uses {} {
  if radix < 2 || radix > 36 {
    return Error(Invalid)
  }
  let mut out: List[u8] = []
  if value.negative {
    core@1/list.push(mut out, 45)
  }
  append_magnitude(mut out, value.magnitude, core@1/int.widen(radix))
  Ok(text.finish_valid(take out))
}
