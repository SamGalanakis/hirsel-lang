// Go src/internal/strconv/{atoi,itoa}.go radix loops (ebe2feef).
// The numeric-radix digit check adapts atoi.go:215-247 without its width limit.
// Decimal and arbitrary-radix parsing share grammar and overflow handling.
@noalloc
pub fn read_radix(
  text: String,
  radix: u8,
  signed: bool,
  positive_limit: u128,
  negative_limit: u128
) -> Result[(u128, bool), scalar.ParseError] uses {} {
  let data = core@1/string.as_bytes(text)
  let (high, low, status) = core@1/bytes.integer(
    data, radix, signed,
    core@1/int.narrow(positive_limit >> 64u128), core@1/int.narrow(positive_limit & 18446744073709551615u128),
    core@1/int.narrow(negative_limit >> 64u128), core@1/int.narrow(negative_limit & 18446744073709551615u128)
  )
  if status == 2 { return Error(Invalid) }
  if status == 3 { return Error(OutOfRange) }
  let magnitude: u128 = core@1/int.widen(high)
  Ok((magnitude << 64u128 | core@1/int.widen(low), status == 1))
}

pub fn format_radix(value: u128, negative: bool, radix: u8) -> Result[
  unique String,
  scalar.ParseError
] uses {} {
  if radix < 2 || radix > 36 {
    return Error(Invalid)
  }
  if radix == 10 {
    let mut decimal: List[u8] = []
    internal.decimal.append(mut decimal, value, negative)
    return Ok(text.finish_valid(take decimal))
  }
  let mut digits: Inline[u8, 129] = [
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8,
    0u8
  ]
  let base: u128 = core@1/int.widen(radix)
  let mut remaining = value
  let mut start: u64 = 129
  let mut more: bool = true
  while more {
    start -= 1
    let digit: u8 = core@1/int.narrow(remaining % base)
    digits[start] = if digit < 10 {
      digit + 48
    } else {
      digit - 10 + 97
    }
    remaining /= base
    more = remaining != 0
  }
  if negative {
    start -= 1
    digits[start] = 45
  }
  let mut out: List[u8] = []
  core@1/list.reserve(mut out, 129 - start)
  for i in start..129u64 {
    core@1/list.push(mut out, digits[i])
  }
  Ok(text.finish_valid(take out))
}
