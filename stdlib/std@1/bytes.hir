// Left-to-right nonoverlapping byte replacement, including arbitrary UTF-8 errors.
pub fn replace(src: Bytes, old: Bytes, new: Bytes) -> unique Bytes in src {
  let width = core@1/bytes.len(old)
  core@1/failure.check(width != 0, TextInvariant())
  let len = core@1/bytes.len(src)
  let mut builder: List[u8] = []
  let mut i: u64 = 0
  while i < len {
    let mut matched = width <= len - i
    let mut j: u64 = 0
    while matched && j < width {
      if src[i + j] != old[j] {
        matched = false
      }
      j += 1
    }
    if matched {
      let mut k: u64 = 0
      while k < core@1/bytes.len(new) {
        core@1/list.push(mut builder, new[k])
        k += 1
      }
      i += width
    } else {
      core@1/list.push(mut builder, src[i])
      i += 1
    }
  }
  core@1/bytes.from_list(take builder)
}

// A copy, so a fixed-size result such as a digest reaches every Bytes consumer.
pub fn from_inline[n: size](xs: Inline[u8, n]) -> unique Bytes uses {} {
  let mut out: List[u8] = []
  core@1/list.reserve(mut out, n)
  for b in xs {
    core@1/list.push(mut out, b)
  }
  core@1/bytes.from_list(take out)
}
