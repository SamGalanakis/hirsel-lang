// Left-to-right nonoverlapping byte replacement, including arbitrary UTF-8 errors.
pub fn replace(src: Bytes, old: Bytes, new: Bytes) -> unique Bytes in src {
  let width = core@1/bytes.len(old)
  core@1/failure.check(width != 0, TextInvariant())
  let replacement_len = core@1/bytes.len(new)
  let replacement_byte = if replacement_len == 1 {
    new[0]
  } else {
    0u8
  }
  let len = core@1/bytes.len(src)
  let mut builder: List[u8] = []
  let mut i: u64 = 0
  let plan = internal.substring.prepare(old)
  let mut searching = true
  while searching {
    let found = internal.substring.find_from(src, old, plan, i)
    let end = match found {
      Some(at) => at,
      None() => len,
    }
    if i < end {
      core@1/bytes.append(mut builder, core@1/bytes.slice(src, i, end))
    }
    match found {
      Some(at) => {
        if replacement_len == 1 {
          core@1/list.push(mut builder, replacement_byte)
        } else if replacement_len != 0 {
          core@1/bytes.append(mut builder, new)
        }
        i = at + width
      },
      None() => {
        searching = false
      },
    }
  }
  core@1/bytes.from_list(take builder)
}

// A copy, so a fixed-size result such as a digest reaches every Bytes consumer.
pub fn from_inline[n: size](xs: Inline[u8, n]) -> unique Bytes uses {} {
  let mut out: List[u8] = []
  core@1/list.reserve(mut out, n)
  for b in xs {
    core@1/list.push(mut out, b)
  }
  core@1/bytes.from_list(take out)
}
