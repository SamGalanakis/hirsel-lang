// Decimal conversion is ordinary source; no numeric schema or hidden allocator.
@noalloc
pub fn format[n: size](value: u128, mut buffer: Inline[u8, n]) -> Result[
  u64,
  std@1/scalar.FormatError
] uses {} {
  let magnitude = value
  std@1/internal.decimal.write_unsigned(magnitude, false, mut buffer)
}

// Appends the decimal text of `value` to `out`; to_string is that text,
// built from the same digits in a list reserved to its exact length.
pub fn format_into(value: u128, mut out: List[u8]) -> () uses {} {
  std@1/internal.decimal.append(mut out, value, false)
}

pub fn to_string(value: u128) -> String uses {} {
  std@1/internal.decimal.exact_text(value, false)
}

@noalloc
pub fn parse(text: String) -> Result[u128, std@1/scalar.ParseError] uses {} {
  match std@1/internal.decimal.read_unsigned(
    text,
    false,
    340282366920938463463374607431768211455u128,
    0u128
  ) {
    Error(error) => Error(error),
    Ok((magnitude, negative)) => {
      let value: u128 = core@1/int.narrow(magnitude)
      Ok(value)
    },
  }
}
