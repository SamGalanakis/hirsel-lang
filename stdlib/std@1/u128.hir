// Decimal conversion is ordinary source; no numeric schema or hidden allocator.
@noalloc
pub fn format[n: size](value: u128, mut buffer: Inline[u8, n]) -> Result[
  u64,
  scalar.FormatError
] uses {} {
  let magnitude = value
  internal.decimal.write_unsigned(magnitude, false, mut buffer)
}

// Appends the decimal text of `value` to `out`; to_string is that text,
// built from the same digits in a list reserved to its exact length.
@preserves_unique(out)
pub fn format_into(value: u128, mut out: List[u8]) -> () uses {} {
  internal.decimal.append(mut out, value, false)
}

pub fn to_string(value: u128) -> unique String uses {} {
  let mut out: List[u8] = []
  u128.format_into(value, mut out)
  text.finish_valid(take out)
}

@noalloc
pub fn parse(text: String) -> Result[u128, scalar.ParseError] uses {} {
  parse_radix(text, 10)
}

@preserves_unique(out)
pub fn format_into_spec(
  value: u128,
  fill: char,
  align: u64,
  width: u64,
  precision: u64,
  flags: u64,
  kind: u64,
  mut out: List[u8]
) -> () uses {} {
  internal.format.integer(
    value,
    false,
    fill,
    align,
    width,
    precision,
    flags,
    kind,
    mut out
  )
}
