// Generators for `= comptime` function bodies (CT-5). Each reads a record or
// variant type's shape and returns one function literal for the header written
// in source; a field type it has no form for is its Error, naming the type.
// Generated text spells every type and std call by its canonical versioned
// path, so it checks the same way in every module.
//
// A field of another record or variant type uses that type's own deriver,
// named from the type's declared name in snake case: `item_to_json`,
// `item_from_json`, `item_format` and `item_hash` for `Item`, resolved in the
// field type's own module, subject to ordinary visibility. A recursive type's deriver calls
// itself.
// The text of `text` from byte `start` to byte `end`, past leading spaces.
fn part(text: String, start: u64, end: u64) -> String uses {} {
  let bytes = core@1/string.as_bytes(text)
  let mut from = start
  while from < end && bytes[from] == 32 {
    from += 1
  }
  let Some(first) = core@1/string.position(text, from) else {
    return ""
  }
  let Some(last) = core@1/string.position(text, end) else {
    return ""
  }
  unique core@1/string.slice(text, first, last)
}

// The comma-separated items of `text` outside brackets and parentheses:
// `u64` and `List[(u8, u8)]` for `u64, List[(u8, u8)]`. An empty last item,
// as in `A,`, is left out.
fn top_level(text: String) -> List[String] uses {} {
  let bytes = core@1/string.as_bytes(text)
  let n = core@1/bytes.len(bytes)
  let mut items: List[String] = []
  let mut depth: u64 = 0
  let mut start: u64 = 0
  let mut i: u64 = 0
  while i <= n {
    if i == n || bytes[i] == 44 && depth == 0 {
      let item = part(text, start, i)
      if core@1/string.byte_len(item) != 0 {
        list.push(mut items, take item)
      }
      start = i + 1
    } else if bytes[i] == 91 || bytes[i] == 40 {
      depth += 1
    } else if bytes[i] == 93 || bytes[i] == 41 {
      depth -= 1
    }
    i += 1
  }
  take items
}

// The type parameters of `ty` when it is `head[..]`, such as `[String, u64]`
// for `Map[String, u64]` and head `Map`.
fn parameters(ty: String, head: String) -> Option[List[String]] uses {} {
  let open = f"{head}["
  if !string.starts_with(ty, open) || !string.ends_with(ty, "]") {
    return None
  }
  let end = core@1/string.byte_len(ty) - 1
  Some(top_level(part(ty, core@1/string.byte_len(open), end)))
}

// The one type argument of `ty` when it is `head[..]`.
fn argument(ty: String, head: String) -> Option[String] uses {} {
  let Some(items) = parameters(ty, head) else {
    return None
  }
  if list.len(items) != 1 {
    return None
  }
  Some(unique items[0])
}

// The component types of a tuple spelling `(A, B)` or `(A,)`; None for any
// other type, the unit type `()` included.
fn tuple(ty: String) -> Option[List[String]] uses {} {
  if !string.starts_with(ty, "(") || !string.ends_with(ty, ")") {
    return None
  }
  let items = top_level(part(ty, 1, core@1/string.byte_len(ty) - 1))
  if list.len(items) == 0 {
    return None
  }
  Some(take items)
}

const INTEGERS: List[String] = [
  "u8",
  "u16",
  "u32",
  "u64",
  "u128",
  "i8",
  "i16",
  "i32",
  "i64",
  "i128"
]

fn integer(ty: String) -> bool uses {} {
  for name in INTEGERS {
    if ty == name {
      return true
    }
  }
  false
}

fn float(ty: String) -> bool uses {} {
  ty == "f32" || ty == "f64"
}

// A nominal type's canonical spelling is its versioned path, `pkg@n/..`, with
// any type arguments in brackets after it.
fn nominal(ty: String) -> bool uses {} {
  let path = constructor(ty)
  string.contains(path, "@") && !string.contains(path, " ") && !string.contains(
    path,
    "("
  )
}

// A nominal type's path without type arguments: `app@1/m.Pair` for
// `app@1/m.Pair[u64]`, which names its record constructor in any module.
fn constructor(name: String) -> String uses {} {
  let Some(at) = string.find(name, "[") else {
    return unique name
  }
  let Some(start) = core@1/string.position(name, 0) else {
    return unique name
  }
  unique core@1/string.slice(name, start, at)
}

// The declared name alone: `Todo` for `app@1/todo.Todo`.
fn short_name(name: String) -> String uses {} {
  let mut last = constructor(name)
  let separators: List[String] = ["/", "."]
  for separator in separators {
    let parts = string.split(take last, separator)
    last = unique parts[list.len(parts) - 1]
  }
  take last
}

// `TodoItem` as `todo_item` and `HTTPRequest` as `http_request`: an underscore
// before each capital that ends a lowercase run or starts a word after capitals.
fn snake(name: String) -> String uses {} {
  let bytes = core@1/string.as_bytes(name)
  let n = core@1/bytes.len(bytes)
  let mut out: List[u8] = []
  let mut i: u64 = 0
  while i < n {
    let c = bytes[i]
    if ascii.is_upper(c) {
      let previous_upper = i > 0 && ascii.is_upper(bytes[i - 1])
      let next_lower = i + 1 < n && ascii.is_lower(bytes[i + 1])
      if i > 0 && bytes[i - 1] != 95 && (!previous_upper || next_lower) {
        list.push(mut out, 95u8)
      }
      list.push(mut out, ascii.to_lower(c))
    } else {
      list.push(mut out, c)
    }
    i += 1
  }
  text.finish_valid(take out)
}

// The deriver a generated body calls for a field of nominal type `ty`.
fn deriver(ty: String, suffix: String) -> String uses {} {
  let path = constructor(ty)
  let name = short_name(path)
  let prefix = part(
    path,
    0,
    core@1/string.byte_len(path) - core@1/string.byte_len(name)
  )
  f"{prefix}{snake(name)}_{suffix}"
}

// Generated text under construction, with a counter that makes each binding
// name it hands out unique in the body.
type Writer {
  out: List[u8],
  next: u64,
}

fn writer() -> Writer uses {} {
  Writer(out: [], next: 0)
}

fn put(mut w: Writer, piece: String) -> () uses {} {
  text.append(mut w.out, piece)
}

// A binding name `prefix` and a number no other name in the body has.
fn fresh(mut w: Writer, prefix: String) -> String uses {} {
  let name = f"{prefix}{w.next}"
  w.next += 1
  take name
}

fn fresh_names(mut w: Writer, prefix: String, count: u64) -> List[String] uses {} {
  let mut names: List[String] = []
  let mut i: u64 = 0
  while i < count {
    list.push(mut names, fresh(mut w, prefix))
    i += 1
  }
  take names
}

// The finished text as one function body.
fn body[F](take w: Writer) -> Body[F] uses {} {
  let Writer(out: out, next: _) = take w
  codegen.body(text.finish_valid(take out))
}

// Positional binding names `prefix0, prefix1, ..` for `count` payloads.
fn binders(prefix: String, count: u64) -> List[String] uses {} {
  let mut names: List[String] = []
  let mut i: u64 = 0
  while i < count {
    list.push(mut names, f"{prefix}{i}")
    i += 1
  }
  take names
}

// A variant pattern or construction: `Name`, `Name(a, b)` or, for labelled
// payloads, `Name(label: a, ..)`.
fn variant_form(v: VariantShape, names: List[String]) -> String uses {} {
  if list.len(v.payload) == 0 {
    return unique v.name
  }
  let mut parts: List[String] = []
  let mut i: u64 = 0
  for p in v.payload {
    match p.label {
      Some(label) => list.push(mut parts, f"{label}: {names[i]}"),
      None => list.push(mut parts, unique names[i]),
    }
    i += 1
  }
  f"{v.name}({string.join(parts, ", ")})"
}

// A tuple pattern or construction of `names`: `(a, b)` or `(a,)`.
fn tuple_form(names: List[String]) -> String uses {} {
  if list.len(names) == 1 {
    return f"({names[0]},)"
  }
  f"({string.join(names, ", ")})"
}

// The element type of a List or Set spelling.
fn element(ty: String) -> Option[String] uses {} {
  match argument(ty, "List") {
    Some(inner) => Some(take inner),
    None => argument(ty, "Set"),
  }
}

fn nested_option(ty: String, inner: String) -> Result[(), String] uses {} {
  if string.starts_with(inner, "core@1/Option[") {
    return Error(f"no JSON form for {ty}: null cannot tell its Nones apart")
  }
  Ok(())
}

// ---- JSON ----
// Writes an expression of type std@1/json.Value for `read`, of canonical type
// `ty`.
// Schema generation shares the scalar emitter; its nominal converters have
// their own context and contracts in schema_derive.hir.
fn json_of(mut w: Writer, ty: String, read: String) -> Result[(), String] uses {} {
  json_of_at(mut w, ty, read, "", "")
}

fn json_of_at(mut w: Writer, ty: String, read: String, parent: String, member: String) -> Result[
  (),
  String
] uses {} {
  if ty == "bool" {
    put(mut w, f"Bool({read})")
    return Ok(())
  }
  if ty == "String" {
    put(mut w, f"Text(unique {read})")
    return Ok(())
  }
  if integer(ty) {
    put(mut w, f"Number(std@1/{ty}.to_string({read}))")
    return Ok(())
  }
  if float(ty) {
    put(mut w, f"std@1/derive.json_float(std@1/{ty}.to_string({read}))")
    return Ok(())
  }
  if let Some(inner) = argument(ty, "core@1/Option") {
    nested_option(ty, inner)?
    let item = fresh(mut w, "item")
    put(mut w, f"match {read} {{ Some({item}) => ")
    json_of_at(mut w, inner, item, parent, member)?
    put(mut w, ", None => Null }")
    return Ok(())
  }
  if let Some(inner) = element(ty) {
    let items = fresh(mut w, "items")
    let item = fresh(mut w, "item")
    put(
      mut w,
      f"{{\n    let mut {items}: List[std@1/json.Value] = []\n    for {item} in {read} {{\n      list.push(mut {items}, "
    )
    json_of_at(mut w, inner, item, parent, member)?
    put(mut w, f")\n    }}\n    Array(take {items})\n  }}")
    return Ok(())
  }
  if let Some(pair) = parameters(ty, "Map") {
    let items = fresh(mut w, "items")
    let key = fresh(mut w, "key")
    let entry = fresh(mut w, "entry")
    if pair[0] == "String" {
      put(
        mut w,
        f"{{\n    let mut {items}: Map[String, std@1/json.Value] = map.empty()\n    for ({key}, {entry}) in {read} {{\n      map.insert(mut {items}, unique {key}, "
      )
      json_of_at(mut w, pair[1], entry, parent, member)?
      put(mut w, f")\n    }}\n    Object(take {items})\n  }}")
      return Ok(())
    }
    put(
      mut w,
      f"{{\n    let mut {items}: List[std@1/json.Value] = []\n    for ({key}, {entry}) in {read} {{\n      list.push(mut {items}, Array(["
    )
    json_of_at(mut w, pair[0], key, parent, member)?
    put(mut w, ", ")
    json_of_at(mut w, pair[1], entry, parent, member)?
    put(mut w, f"]))\n    }}\n    Array(take {items})\n  }}")
    return Ok(())
  }
  if let Some(components) = tuple(ty) {
    let names = fresh_names(mut w, "part", list.len(components))
    let items = fresh(mut w, "items")
    put(
      mut w,
      f"{{\n    let {tuple_form(names)} = {read}\n    let mut {items}: List[std@1/json.Value] = []\n"
    )
    let mut i: u64 = 0
    for component in components {
      put(mut w, f"    list.push(mut {items}, ")
      json_of_at(mut w, component, names[i], parent, member)?
      put(mut w, ")\n")
      i += 1
    }
    put(mut w, f"    Array(take {items})\n  }}")
    return Ok(())
  }
  if nominal(ty) {
    let callee = deriver(ty, "to_json")
    let converted = fresh(mut w, "converted")
    // Keep the borrowed call in place. Type its result on the converter line
    // so a wrong result is attributed there too; move it out without copying.
    // The comments explain failures; ordinary checking still owns the call.
    put(
      mut w,
      f"{{\n// schema-hook {parent}\t{member}\n// schema-contract fn {callee}(value: {ty}) -> std@1/json.Value uses {{}}\nlet {converted}: std@1/json.Value = {callee}({read})\ntake {converted}\n}}"
    )
    return Ok(())
  }
  Error(f"no JSON form for {ty}")
}

// A variant's kind in serde's terms: `unit` without payload, `struct` with
// labelled payloads, `newtype` with one positional payload and `tuple` with
// more (serde_derive/src/internals/ast.rs `Style`).
fn style(v: VariantShape) -> String uses {} {
  let count = list.len(v.payload)
  if count == 0 {
    return "unit"
  }
  if option.is_some(v.payload[0].label) {
    return "struct"
  }
  if count == 1 {
    return "newtype"
  }
  "tuple"
}

// A struct payload's label.
fn label_of(p: PayloadShape) -> String uses {} {
  match p.label {
    Some(label) => unique label,
    None => "",
  }
}

// A record's JSON form is an object with a member per field. A variant is
// externally tagged as serde writes it (serde_derive/src/ser.rs
// `serialize_externally_tagged_variant`, serde_json/src/ser.rs
// `serialize_*_variant`): a unit variant is its name as a string, and any
// other an object whose one member, its name, holds the newtype payload
// itself, the array of tuple payloads or the object of struct payloads.
pub fn json_value[T](s: TypeShape[T]) -> Result[
  Body[fn(T) -> json.Value uses {}],
  String
] uses {} {
  let info = type_shape.info(s)
  let mut w = writer()
  put(mut w, f"fn(value: {info.name}) -> std@1/json.Value uses {{}} {{\n")
  match info.body {
    Record(fields) => {
      put(mut w, "  let mut fields: Map[String, std@1/json.Value] = map.empty()\n")
      for f in fields {
        put(mut w, f"  map.insert(mut fields, \"{f.name}\", ")
        json_of_at(mut w, f.ty, f"value.{f.name}", info.name, f.name)?
        put(mut w, ")\n")
      }
      put(mut w, "  Object(take fields)\n")
    },
    Choice(variants) => {
      put(mut w, "  match value {\n")
      for v in variants {
        let kind = style(v)
        if kind == "unit" {
          put(mut w, f"    {v.name} => Text(\"{v.name}\"),\n")
          continue
        }
        let names = binders("p", list.len(v.payload))
        put(mut w, f"    {variant_form(v, names)} => {{\n")
        put(
          mut w,
          "      let mut tagged: Map[String, std@1/json.Value] = map.empty()\n"
        )
        if kind == "newtype" {
          put(mut w, f"      map.insert(mut tagged, \"{v.name}\", ")
          json_of_at(mut w, v.payload[0].ty, names[0], info.name, f"{v.name}.0")?
          put(mut w, ")\n")
        } else if kind == "struct" {
          put(
            mut w,
            "      let mut fields: Map[String, std@1/json.Value] = map.empty()\n"
          )
          let mut i: u64 = 0
          for p in v.payload {
            put(mut w, f"      map.insert(mut fields, \"{label_of(p)}\", ")
            json_of_at(mut w, p.ty, names[i], info.name, f"{v.name}.{label_of(p)}")?
            put(mut w, ")\n")
            i += 1
          }
          put(
            mut w,
            f"      map.insert(mut tagged, \"{v.name}\", Object(take fields))\n"
          )
        } else {
          put(mut w, "      let mut payload: List[std@1/json.Value] = []\n")
          let mut i: u64 = 0
          for p in v.payload {
            put(mut w, "      list.push(mut payload, ")
            json_of_at(mut w, p.ty, names[i], info.name, f"{v.name}.{i}")?
            put(mut w, ")\n")
            i += 1
          }
          put(
            mut w,
            f"      map.insert(mut tagged, \"{v.name}\", Array(take payload))\n"
          )
        }
        put(mut w, "      Object(take tagged)\n")
        put(mut w, "    },\n")
      }
      put(mut w, "  }\n")
    },
  }
  put(mut w, "}")
  Ok(body(take w))
}

// Writes an expression of canonical type `ty` decoding `read`, a
// std@1/json.Value; a mismatch returns `Error` from the generated function.
fn from_json_of(mut w: Writer, ty: String, read: String, parent: String, member: String) -> Result[
  (),
  String
] uses {} {
  if ty == "bool" {
    put(mut w, f"std@1/derive.json_bool({read})?")
    return Ok(())
  }
  if ty == "String" {
    put(mut w, f"std@1/derive.json_text({read})?")
    return Ok(())
  }
  if integer(ty) {
    put(
      mut w,
      f"std@1/derive.parsed(std@1/{ty}.parse(std@1/derive.json_number({read})?), \"{ty}\")?"
    )
    return Ok(())
  }
  if float(ty) {
    put(
      mut w,
      f"std@1/derive.parsed(std@1/{ty}.parse(std@1/derive.json_float_text({read})?), \"{ty}\")?"
    )
    return Ok(())
  }
  if let Some(inner) = argument(ty, "core@1/Option") {
    nested_option(ty, inner)?
    let item = fresh(mut w, "item")
    put(mut w, f"match {read} {{ Null => None, {item} => Some(")
    from_json_of(mut w, inner, item, parent, member)?
    put(mut w, ") }")
    return Ok(())
  }
  let array = fresh(mut w, "array")
  let expected = f"{{\n    let Array({array}) = {read} else {{\n      return Error(\"expected a JSON array\")\n    }}\n"
  if let Some(inner) = argument(ty, "List") {
    let items = fresh(mut w, "items")
    let item = fresh(mut w, "item")
    put(mut w, expected)
    put(
      mut w,
      f"    let mut {items}: List[{inner}] = []\n    for {item} in {array} {{\n      list.push(mut {items}, "
    )
    from_json_of(mut w, inner, item, parent, member)?
    put(mut w, f")\n    }}\n    take {items}\n  }}")
    return Ok(())
  }
  if let Some(inner) = argument(ty, "Set") {
    let items = fresh(mut w, "items")
    let item = fresh(mut w, "item")
    let decoded = fresh(mut w, "element")
    put(mut w, expected)
    put(
      mut w,
      f"    let mut {items}: Set[{inner}] = set.empty()\n    for {item} in {array} {{\n      let {decoded}: {inner} = "
    )
    from_json_of(mut w, inner, item, parent, member)?
    put(
      mut w,
      f"\n      if set.contains({items}, {decoded}) {{\n        return Error(\"duplicate set element\")\n      }}\n      set.insert(mut {items}, take {decoded})\n    }}\n    take {items}\n  }}"
    )
    return Ok(())
  }
  if let Some(pair) = parameters(ty, "Map") {
    let items = fresh(mut w, "items")
    let item = fresh(mut w, "item")
    let key = fresh(mut w, "key")
    let entry = fresh(mut w, "entry")
    if pair[0] == "String" {
      let members = fresh(mut w, "members")
      put(
        mut w,
        f"{{\n    let Object({members}) = {read} else {{\n      return Error(\"expected a JSON object\")\n    }}\n    let mut {items}: {ty} = map.empty()\n    for ({key}, {item}) in {members} {{\n      let {entry}: {pair[1]} = "
      )
      from_json_of(mut w, pair[1], item, parent, member)?
      put(
        mut w,
        f"\n      map.insert(mut {items}, unique {key}, take {entry})\n    }}\n    take {items}\n  }}"
      )
      return Ok(())
    }
    let couple = fresh(mut w, "pair")
    put(mut w, expected)
    put(
      mut w,
      f"    let mut {items}: {ty} = map.empty()\n    for {item} in {array} {{\n      let Array({couple}) = {item} else {{\n        return Error(\"expected a JSON [key, value] array\")\n      }}\n      if core@1/list.len({couple}) != 2 {{\n        return Error(\"expected a JSON [key, value] array\")\n      }}\n      let {key}: {pair[0]} = "
    )
    from_json_of(mut w, pair[0], f"{couple}[0]", parent, member)?
    put(mut w, f"\n      let {entry}: {pair[1]} = ")
    from_json_of(mut w, pair[1], f"{couple}[1]", parent, member)?
    put(
      mut w,
      f"\n      if map.contains({items}, {key}) {{\n        return Error(\"duplicate map key\")\n      }}\n      map.insert(mut {items}, take {key}, take {entry})\n    }}\n    take {items}\n  }}"
    )
    return Ok(())
  }
  if let Some(components) = tuple(ty) {
    let count = list.len(components)
    let names = fresh_names(mut w, "part", count)
    put(mut w, expected)
    put(
      mut w,
      f"    if core@1/list.len({array}) != {count} {{\n      return Error(\"expected {count} JSON array items\")\n    }}\n"
    )
    let mut taken: List[String] = []
    let mut i: u64 = 0
    for component in components {
      put(mut w, f"    let {names[i]}: {component} = ")
      from_json_of(mut w, component, f"{array}[{i}]", parent, member)?
      put(mut w, "\n")
      list.push(mut taken, f"take {names[i]}")
      i += 1
    }
    put(mut w, f"    {tuple_form(taken)}\n  }}")
    return Ok(())
  }
  if nominal(ty) {
    let callee = deriver(ty, "from_json")
    let converted = fresh(mut w, "converted")
    // Keep `?` in the enclosing function and preserve the hook's result evidence.
    put(
      mut w,
      f"{{\n// schema-hook {parent}\t{member}\n// schema-contract fn {callee}(value: std@1/json.Value) -> core@1/Result[{ty}, String] uses {{}}\nlet {converted}: {ty} = {callee}({read})?\ntake {converted}\n}}"
    )
    return Ok(())
  }
  Error(f"no JSON form for {ty}")
}

// Writes statements decoding the members `names`, of types `types`, from the
// Map[String, std@1/json.Value] named `members`, as serde_derive's struct
// visitor does (serde_derive/src/de/struct_.rs `deserialize_map`): an absent
// Option member is None, any other absent member is `missing field`, and an
// unknown member is ignored. Returns the labelled constructor arguments.
fn members_from(
  mut w: Writer,
  names: List[String],
  types: List[String],
  members: String,
  indent: String,
  parent: String,
  prefix: String
) -> Result[List[String], String] uses {} {
  let mut arguments: List[String] = []
  let mut i: u64 = 0
  for name in names {
    let ty = types[i]
    let member = fresh(mut w, "member")
    let decoded = fresh(mut w, "decoded")
    if string.starts_with(ty, "core@1/Option[") {
      put(
        mut w,
        f"{indent}let {decoded}: {ty} = match map.get({members}, \"{name}\") {{\n{indent}  None => None,\n{indent}  Some({member}) => "
      )
      from_json_of(mut w, ty, member, parent, f"{prefix}{name}")?
      put(mut w, f",\n{indent}}}\n")
    } else {
      put(
        mut w,
        f"{indent}let Some({member}) = map.get({members}, \"{name}\") else {{\n{indent}  return Error(\"missing field `{name}`\")\n{indent}}}\n{indent}let {decoded}: {ty} = "
      )
      from_json_of(mut w, ty, member, parent, f"{prefix}{name}")?
      put(mut w, "\n")
    }
    list.push(mut arguments, f"{name}: take {decoded}")
    i += 1
  }
  Ok(take arguments)
}

// serde's `OneOf`: `A`, `A` or `B`, or one of `A`, `B`, `C`
// (serde_core/src/de/mod.rs).
fn one_of(names: List[String]) -> String uses {} {
  let mut quoted: List[String] = []
  for name in names {
    list.push(mut quoted, f"`{name}`")
  }
  if list.len(quoted) == 1 {
    return unique quoted[0]
  }
  if list.len(quoted) == 2 {
    return f"{quoted[0]} or {quoted[1]}"
  }
  f"one of {string.join(quoted, ", ")}"
}

// Decodes the JSON form that `json_value` writes, with serde_json's rules for
// a decoded Value (serde_json/src/value/de.rs `deserialize_enum` and
// `VariantDeserializer`): a record needs an object; a variant a string naming
// a unit variant or an object with exactly one member, whose value is null for
// a unit variant, the payload for a newtype variant, an array of exactly the
// payload count for a tuple variant and an object for a struct variant.
// Errors are serde's messages without the text position.
pub fn from_json[T](s: TypeShape[T]) -> Result[
  Body[fn(json.Value) -> Result[T, String] uses {}],
  String
] uses {} {
  let info = type_shape.info(s)
  let name = short_name(info.name)
  let mut w = writer()
  put(
    mut w,
    f"fn(value: std@1/json.Value) -> core@1/Result[{info.name}, String] uses {{}} {{\n"
  )
  match info.body {
    Record(fields) => {
      put(mut w, "  let Object(fields) = value else {\n")
      put(
        mut w,
        f"    return Error(std@1/derive.json_invalid_type(value, \"struct {name}\"))\n"
      )
      put(mut w, "  }\n")
      let mut names: List[String] = []
      let mut types: List[String] = []
      for f in fields {
        list.push(mut names, unique f.name)
        list.push(mut types, unique f.ty)
      }
      let arguments = members_from(mut w, names, types, "fields", "  ", info.name, "")?
      put(mut w, f"  Ok({constructor(info.name)}({string.join(arguments, ", ")}))\n")
    },
    Choice(variants) => {
      let mut variant_names: List[String] = []
      for v in variants {
        list.push(mut variant_names, unique v.name)
      }
      let expected = one_of(variant_names)
      put(mut w, "  match value {\n")
      put(mut w, "    Text(tag) => {\n")
      for v in variants {
        let kind = style(v)
        put(mut w, f"      if tag == \"{v.name}\" {{\n")
        if kind == "unit" {
          put(mut w, f"        return Ok({v.name})\n")
        } else {
          put(
            mut w,
            f"        return Error(\"invalid type: unit variant, expected {kind} variant\")\n"
          )
        }
        put(mut w, "      }\n")
      }
      put(mut w, f"      Error(std@1/derive.unknown_variant(tag, \"{expected}\"))\n")
      put(mut w, "    },\n")
      put(mut w, "    Object(tagged) => {\n")
      put(mut w, "      if core@1/map.len(tagged) != 1 {\n")
      put(
        mut w,
        "        return Error(\"invalid value: map, expected map with a single key\")\n"
      )
      put(mut w, "      }\n")
      put(mut w, "      for (tag, payload) in tagged {\n")
      for v in variants {
        let kind = style(v)
        let count = list.len(v.payload)
        put(mut w, f"        if tag == \"{v.name}\" {{\n")
        if kind == "unit" {
          put(
            mut w,
            f"          let Null = payload else {{\n            return Error(std@1/derive.json_invalid_type(payload, \"unit\"))\n          }}\n          return Ok({v.name})\n"
          )
        } else if kind == "newtype" {
          let decoded = fresh(mut w, "decoded")
          put(mut w, f"          let {decoded}: {v.payload[0].ty} = ")
          from_json_of(mut w, v.payload[0].ty, "payload", info.name, f"{v.name}.0")?
          put(mut w, f"\n          return Ok({v.name}(take {decoded}))\n")
        } else if kind == "tuple" {
          let items = fresh(mut w, "items")
          put(
            mut w,
            f"          let Array({items}) = payload else {{\n            return Error(std@1/derive.json_invalid_type(payload, \"tuple variant\"))\n          }}\n          std@1/derive.json_length(core@1/list.len({items}), {count}, \"tuple variant {name}::{v.name}\")?\n"
          )
          let names = fresh_names(mut w, "decoded", count)
          let mut taken: List[String] = []
          let mut i: u64 = 0
          for p in v.payload {
            put(mut w, f"          let {names[i]}: {p.ty} = ")
            from_json_of(mut w, p.ty, f"{items}[{i}]", info.name, f"{v.name}.{i}")?
            put(mut w, "\n")
            list.push(mut taken, f"take {names[i]}")
            i += 1
          }
          put(mut w, f"          return Ok({v.name}({string.join(taken, ", ")}))\n")
        } else {
          let members = fresh(mut w, "members")
          put(
            mut w,
            f"          let Object({members}) = payload else {{\n            return Error(std@1/derive.json_invalid_type(payload, \"struct variant\"))\n          }}\n"
          )
          let mut labels: List[String] = []
          let mut types: List[String] = []
          for p in v.payload {
            list.push(mut labels, label_of(p))
            list.push(mut types, unique p.ty)
          }
          let arguments = members_from(
            mut w,
            labels,
            types,
            members,
            "          ",
            info.name,
            f"{v.name}."
          )?
          put(mut w, f"          return Ok({v.name}({string.join(arguments, ", ")}))\n")
        }
        put(mut w, "        }\n")
      }
      put(
        mut w,
        f"        return Error(std@1/derive.unknown_variant(tag, \"{expected}\"))\n"
      )
      put(mut w, "      }\n")
      put(
        mut w,
        "      Error(\"invalid value: map, expected map with a single key\")\n"
      )
      put(mut w, "    },\n")
      put(
        mut w,
        "    _ => Error(std@1/derive.json_invalid_type(value, \"string or map\")),\n"
      )
      put(mut w, "  }\n")
    },
  }
  put(mut w, "}")
  Ok(body(take w))
}

// serde_json's description of an unexpected JSON value (serde_json/src/error.rs
// `JsonUnexpected` over serde_core/src/de/mod.rs `Display for Unexpected`, of
// serde_json/src/value/de.rs `Value::unexpected`). A number shows its JSON
// text, and a string its JSON spelling.
pub fn json_unexpected(value: json.Value) -> unique String uses {} {
  match value {
    Null => "null",
    Bool(b) => f"boolean `{b}`",
    Number(text) => {
      if string.contains(text, ".") || string.contains(text, "e") || string.contains(
        text,
        "E"
      ) {
        f"floating point `{text}`"
      } else {
        f"integer `{text}`"
      }
    },
    Text(text) => {
      let mut quoted: List[u8] = []
      json.write_text_into(text, mut quoted)
      f"string {text.finish_valid(take quoted)}"
    },
    Array(_) => "sequence",
    Object(_) => "map",
  }
}

// serde's `invalid_type` message, for generated decoders.
pub fn json_invalid_type(value: json.Value, expected: String) -> unique String uses {} {
  f"invalid type: {json_unexpected(value)}, expected {expected}"
}

// serde's `unknown_variant` message, for generated decoders.
pub fn unknown_variant(tag: String, expected: String) -> unique String uses {} {
  f"unknown variant `{tag}`, expected {expected}"
}

// Checks a tuple variant's payload array has `count` items, with serde's
// messages: an empty array is null, a short one is an invalid length
// (serde_derive/src/de.rs `deserialize_seq`), and a long one has more
// elements than the visitor took (serde_json/src/value/de.rs `visit_array`).
pub fn json_length(length: u64, count: u64, expected: String) -> Result[(), String] uses {} {
  if length == 0 && count != 0 {
    return Error(f"invalid type: null, expected {expected}")
  }
  if length < count {
    let elements = if count == 1 {
      "element"
    } else {
      "elements"
    }
    return Error(
      f"invalid length {length}, expected {expected} with {count} {elements}"
    )
  }
  if length > count {
    return Error(f"invalid length {length}, expected fewer elements in array")
  }
  Ok(())
}

// A JSON boolean, for generated decoders.
pub fn json_bool(value: json.Value) -> Result[bool, String] uses {} {
  match value {
    Bool(b) => Ok(b),
    _ => Error("expected a JSON boolean"),
  }
}

// A JSON string, for generated decoders.
pub fn json_text(value: json.Value) -> Result[unique String, String] uses {} {
  match value {
    Text(text) => Ok(unique text),
    _ => Error("expected a JSON string"),
  }
}

// A JSON number's text, for generated decoders.
pub fn json_number(value: json.Value) -> Result[unique String, String] uses {} {
  match value {
    Number(text) => Ok(unique text),
    _ => Error("expected a JSON number"),
  }
}

fn non_finite(spelling: String) -> bool uses {} {
  spelling == "NaN" || spelling == "inf" || spelling == "-inf"
}

// A float's JSON form from its `to_string` text: a number, or the string
// `NaN`, `inf` or `-inf`, which JSON numbers cannot spell.
pub fn json_float(take spelling: String) -> json.Value uses {} {
  if non_finite(spelling) {
    Text(take spelling)
  } else {
    Number(take spelling)
  }
}

// The text of a float's JSON form, for generated decoders.
pub fn json_float_text(value: json.Value) -> Result[unique String, String] uses {} {
  match value {
    Number(spelling) => Ok(unique spelling),
    Text(spelling) if non_finite(spelling) => Ok(unique spelling),
    _ => Error("expected a JSON number"),
  }
}

// A parsed number, or an error naming the type it does not fit.
pub fn parsed[N, E](take value: Result[N, E], ty: String) -> Result[N, String] uses {value} {
  match take value {
    Ok(n) => Ok(take n),
    Error(_) => Error(f"expected a JSON number fitting {ty}"),
  }
}

// ---- Equality ----
// Equality by `==` on every field, or on the payloads of equal variants.
pub fn equal[T](s: TypeShape[T]) -> Result[Body[fn(T, T) -> bool uses {}], String] uses {} {
  let info = type_shape.info(s)
  let mut w = writer()
  put(mut w, f"fn(left: {info.name}, right: {info.name}) -> bool uses {{}} {{\n")
  match info.body {
    Record(fields) => {
      let mut terms: List[String] = []
      for f in fields {
        list.push(mut terms, f"left.{f.name} == right.{f.name}")
      }
      if list.len(terms) == 0 {
        list.push(mut terms, "true")
      }
      put(mut w, f"  {string.join(terms, " && ")}\n")
    },
    Choice(variants) => {
      put(mut w, "  match left {\n")
      for v in variants {
        let count = list.len(v.payload)
        let mut terms: List[String] = []
        let mut i: u64 = 0
        while i < count {
          list.push(mut terms, f"l{i} == r{i}")
          i += 1
        }
        if count == 0 {
          list.push(mut terms, "true")
        }
        let lefts = variant_form(v, binders("l", count))
        let rights = variant_form(v, binders("r", count))
        put(mut w, f"    {lefts} => match right {{\n")
        put(mut w, f"      {rights} => {string.join(terms, " && ")},\n")
        put(mut w, "      _ => false,\n")
        put(mut w, "    },\n")
      }
      put(mut w, "  }\n")
    },
  }
  put(mut w, "}")
  Ok(body(take w))
}

// ---- Text ----
// A statement appending the literal `piece` to the List[u8] named `out`.
fn literal(mut w: Writer, indent: String, out: String, piece: String) -> () uses {} {
  put(mut w, f"{indent}std@1/text.append(mut {out}, \"{piece}\")\n")
}

// Writes statements appending the text of `read`, of canonical type `ty`, to
// the List[u8] named `out`: Option as `Some(..)` or `None`, List as `[a, b]`,
// Set as `{a, b}`, Map as `{k: v}` and a tuple as `(a, b)` or `(a,)`.
fn write_of(mut w: Writer, ty: String, read: String, indent: String, out: String) -> Result[
  (),
  String
] uses {} {
  if ty == "String" {
    put(mut w, f"{indent}std@1/text.append(mut {out}, {read})\n")
    return Ok(())
  }
  if ty == "bool" || integer(ty) || float(ty) {
    put(mut w, f"{indent}std@1/text.append(mut {out}, std@1/{ty}.to_string({read}))\n")
    return Ok(())
  }
  let inner_indent = f"{indent}  "
  if let Some(inner) = argument(ty, "core@1/Option") {
    let item = fresh(mut w, "item")
    put(mut w, f"{indent}match {read} {{\n{indent}  Some({item}) => {{\n")
    literal(mut w, f"{indent}    ", out, "Some(")
    write_of(mut w, inner, item, f"{indent}    ", out)?
    literal(mut w, f"{indent}    ", out, ")")
    put(
      mut w,
      f"{indent}  }},\n{indent}  None => std@1/text.append(mut {out}, \"None\"),\n{indent}}}\n"
    )
    return Ok(())
  }
  let list_like = option.is_some(argument(ty, "List"))
  let map_like = option.is_some(parameters(ty, "Map"))
  if list_like || map_like || option.is_some(argument(ty, "Set")) {
    let first = fresh(mut w, "first")
    let item = fresh(mut w, "item")
    let entry = fresh(mut w, "entry")
    let (open, close) = if list_like {
      ("[", "]")
    } else {
      ("{", "}")
    }
    literal(mut w, indent, out, open)
    put(mut w, f"{indent}let mut {first} = true\n")
    if map_like {
      put(mut w, f"{indent}for ({item}, {entry}) in {read} {{\n")
    } else {
      put(mut w, f"{indent}for {item} in {read} {{\n")
    }
    put(
      mut w,
      f"{indent}  if !{first} {{\n{indent}    std@1/text.append(mut {out}, \", \")\n{indent}  }}\n{indent}  {first} = false\n"
    )
    match parameters(ty, "Map") {
      Some(pair) => {
        write_of(mut w, pair[0], item, inner_indent, out)?
        literal(mut w, inner_indent, out, ": ")
        write_of(mut w, pair[1], entry, inner_indent, out)?
      },
      None => {
        let Some(inner) = element(ty) else {
          return Error(f"no text form for {ty}")
        }
        write_of(mut w, inner, item, inner_indent, out)?
      },
    }
    put(mut w, f"{indent}}}\n")
    literal(mut w, indent, out, close)
    return Ok(())
  }
  if let Some(components) = tuple(ty) {
    let names = fresh_names(mut w, "part", list.len(components))
    put(mut w, f"{indent}let {tuple_form(names)} = {read}\n")
    literal(mut w, indent, out, "(")
    let mut i: u64 = 0
    for component in components {
      if i != 0 {
        literal(mut w, indent, out, ", ")
      }
      write_of(mut w, component, names[i], indent, out)?
      i += 1
    }
    let close = if list.len(components) == 1 {
      ",)"
    } else {
      ")"
    }
    literal(mut w, indent, out, close)
    return Ok(())
  }
  if nominal(ty) {
    put(mut w, f"{indent}{deriver(ty, "format")}({read}, mut {out})\n")
    return Ok(())
  }
  Error(f"no text form for {ty}")
}

// Writes `Name(field: value, ..)` for a record and `Variant(payload, ..)` or
// `Variant` for a variant, with the header of a `@format` function.
pub fn format[T](s: TypeShape[T]) -> Result[
  Body[fn(T, mut List[u8]) -> () uses {}],
  String
] uses {} {
  let info = type_shape.info(s)
  let mut w = writer()
  put(mut w, f"fn(value: {info.name}, mut out: List[u8]) -> () uses {{}} {{\n")
  match info.body {
    Record(fields) => {
      literal(mut w, "  ", "out", f"{short_name(info.name)}(")
      let mut i: u64 = 0
      for f in fields {
        let separator = if i == 0 {
          ""
        } else {
          ", "
        }
        literal(mut w, "  ", "out", f"{separator}{f.name}: ")
        write_of(mut w, f.ty, f"value.{f.name}", "  ", "out")?
        i += 1
      }
      literal(mut w, "  ", "out", ")")
    },
    Choice(variants) => {
      put(mut w, "  match value {\n")
      for v in variants {
        if list.len(v.payload) == 0 {
          put(mut w, f"    {v.name} => std@1/text.append(mut out, \"{v.name}\"),\n")
        } else {
          let names = binders("p", list.len(v.payload))
          put(mut w, f"    {variant_form(v, names)} => {{\n")
          literal(mut w, "      ", "out", f"{v.name}(")
          let mut i: u64 = 0
          for p in v.payload {
            if i != 0 {
              literal(mut w, "      ", "out", ", ")
            }
            write_of(mut w, p.ty, names[i], "      ", "out")?
            i += 1
          }
          literal(mut w, "      ", "out", ")")
          put(mut w, "    },\n")
        }
      }
      put(mut w, "  }\n")
    },
  }
  put(mut w, "}")
  Ok(body(take w))
}

// ---- Hashing ----
// Writes statements streaming `read`, of canonical type `ty`, into the
// std@1/siphash.State named `state` as Rust's `Hash` impls do
// (library/core/src/hash/mod.rs): integers and bool as their little-endian
// bytes, a String as its bytes and 0xFF, a List as its length then each item,
// a Map as its length then each key and value in order (alloc
// collections/btree/map.rs `Hash for BTreeMap`), an Option as the derived
// discriminant (None 0, Some 1) and payload, and a tuple as each component. A
// Set, whose equality ignores order (SEM-5), is its length then the wrapping
// sum of each element's hash under the same keys, so equal sets hash alike in
// any order. A nested record or variant streams through its own deriver.
// Floats are not `key` and have no hash form.
fn hash_of(mut w: Writer, ty: String, read: String, indent: String, state: String) -> Result[
  (),
  String
] uses {} {
  if ty == "String" {
    put(mut w, f"{indent}std@1/siphash.write_str(mut {state}, {read})\n")
    return Ok(())
  }
  if float(ty) {
    return Error(f"no hash form for {ty}: floats are not key")
  }
  if ty == "bool" || integer(ty) {
    put(mut w, f"{indent}std@1/siphash.write_{ty}(mut {state}, {read})\n")
    return Ok(())
  }
  let inner_indent = f"{indent}  "
  if let Some(inner) = argument(ty, "core@1/Option") {
    let item = fresh(mut w, "item")
    put(
      mut w,
      f"{indent}match {read} {{\n{indent}  Some({item}) => {{\n{indent}    std@1/siphash.write_u64(mut {state}, 1)\n"
    )
    hash_of(mut w, inner, item, f"{indent}    ", state)?
    put(
      mut w,
      f"{indent}  }},\n{indent}  None => std@1/siphash.write_u64(mut {state}, 0),\n{indent}}}\n"
    )
    return Ok(())
  }
  if let Some(inner) = argument(ty, "List") {
    let item = fresh(mut w, "item")
    put(
      mut w,
      f"{indent}std@1/siphash.write_u64(mut {state}, core@1/list.len({read}))\n{indent}for {item} in {read} {{\n"
    )
    hash_of(mut w, inner, item, inner_indent, state)?
    put(mut w, f"{indent}}}\n")
    return Ok(())
  }
  if let Some(inner) = argument(ty, "Set") {
    let sum = fresh(mut w, "sum")
    let item = fresh(mut w, "item")
    let piece = fresh(mut w, "piece")
    put(
      mut w,
      f"{indent}let mut {sum}: u64 = 0\n{indent}for {item} in {read} {{\n{indent}  let mut {piece} = std@1/siphash.fresh({state})\n"
    )
    hash_of(mut w, inner, item, inner_indent, piece)?
    put(
      mut w,
      f"{indent}  {sum} = core@1/int.wrapping_add({sum}, std@1/siphash.finish({piece}))\n{indent}}}\n{indent}std@1/siphash.write_u64(mut {state}, core@1/set.len({read}))\n{indent}std@1/siphash.write_u64(mut {state}, {sum})\n"
    )
    return Ok(())
  }
  if let Some(pair) = parameters(ty, "Map") {
    let key = fresh(mut w, "key")
    let entry = fresh(mut w, "entry")
    put(
      mut w,
      f"{indent}std@1/siphash.write_u64(mut {state}, core@1/map.len({read}))\n{indent}for ({key}, {entry}) in {read} {{\n"
    )
    hash_of(mut w, pair[0], key, inner_indent, state)?
    hash_of(mut w, pair[1], entry, inner_indent, state)?
    put(mut w, f"{indent}}}\n")
    return Ok(())
  }
  if let Some(components) = tuple(ty) {
    let names = fresh_names(mut w, "part", list.len(components))
    put(mut w, f"{indent}let {tuple_form(names)} = {read}\n")
    let mut i: u64 = 0
    for component in components {
      hash_of(mut w, component, names[i], indent, state)?
      i += 1
    }
    return Ok(())
  }
  if nominal(ty) {
    put(mut w, f"{indent}{deriver(ty, "hash")}({read}, mut {state})\n")
    return Ok(())
  }
  Error(f"no hash form for {ty}")
}

// Streams a value into a std@1/siphash.State as Rust's `#[derive(Hash)]` does
// (compiler/rustc_builtin_macros/src/deriving/hash.rs `hash_substructure`,
// deriving/generic/mod.rs): a record's fields in order; a variant of a type
// with more than one variant first writes its declaration index as a u64 (the
// `isize` discriminant on a 64-bit target), then its payloads. With
// `siphash.hash_one(value, item_hash, k0, k1)`, or `new`, the deriver and
// `finish`, the result is Rust's for the same shape under SipHasher13 with
// those keys, and keys 0 and 0 give `DefaultHasher::new()`'s.
pub fn hash[T](s: TypeShape[T]) -> Result[
  Body[fn(T, mut siphash.State) -> () uses {}],
  String
] uses {} {
  let info = type_shape.info(s)
  let mut w = writer()
  put(
    mut w,
    f"fn(value: {info.name}, mut state: std@1/siphash.State) -> () uses {{}} {{\n"
  )
  match info.body {
    Record(fields) => {
      for f in fields {
        hash_of(mut w, f.ty, f"value.{f.name}", "  ", "state")?
      }
    },
    Choice(variants) => {
      let tagged = list.len(variants) > 1
      put(mut w, "  match value {\n")
      let mut index: u64 = 0
      for v in variants {
        let names = binders("p", list.len(v.payload))
        put(mut w, f"    {variant_form(v, names)} => {{\n")
        if tagged {
          put(mut w, f"      std@1/siphash.write_u64(mut state, {index})\n")
        }
        let mut i: u64 = 0
        for p in v.payload {
          hash_of(mut w, p.ty, names[i], "      ", "state")?
          i += 1
        }
        put(mut w, "    },\n")
        index += 1
      }
      put(mut w, "  }\n")
    },
  }
  put(mut w, "}")
  Ok(body(take w))
}

// Emit a direct writer. Containers pass their current depth through nominal
// writers too, so the same MAX_NESTING contract applies without building a DOM.
fn json_into_of(mut w: Writer, ty: String, read: String, depth: String) -> Result[
  (),
  String
] uses {} {
  if ty == "String" {
    put(mut w, f"std@1/json.write_text_into({read}, mut out)\n")
    return Ok(())
  }
  if integer(ty) || ty == "bool" {
    put(mut w, f"std@1/{ty}.format_into({read}, mut out)\n")
    return Ok(())
  }
  if float(ty) {
    put(mut w, f"std@1/derive.write_json_{ty}({read}, mut out)\n")
    return Ok(())
  }
  if let Some(inner) = argument(ty, "core@1/Option") {
    nested_option(ty, inner)?
    let item = fresh(mut w, "item")
    put(mut w, f"match {read} {{ Some({item}) => {{\n")
    json_into_of(mut w, inner, item, depth)?
    put(mut w, "}, None => std@1/text.append(mut out, \"null\") }\n")
    return Ok(())
  }
  if let Some(inner) = element(ty) {
    let item = fresh(mut w, "item")
    let first = fresh(mut w, "first")
    put(
      mut w,
      f"std@1/json.check_depth({depth})?\nstd@1/text.append(mut out, \"[\")\nlet mut {first} = true\nfor {item} in {read} {{\nif !{first} {{ std@1/text.append(mut out, \",\") }}\n{first} = false\n"
    )
    json_into_of(mut w, inner, item, f"({depth} + 1)")?
    put(mut w, "}\nstd@1/text.append(mut out, \"]\")\n")
    return Ok(())
  }
  if let Some(pair) = parameters(ty, "Map") {
    let key = fresh(mut w, "key")
    let item = fresh(mut w, "item")
    let first = fresh(mut w, "first")
    let object = pair[0] == "String"
    put(mut w, f"std@1/json.check_depth({depth})?\n")
    literal(
      mut w,
      "",
      "out",
      if object {
        "{"
      } else {
        "["
      }
    )
    put(
      mut w,
      f"let mut {first} = true\nfor ({key}, {item}) in {read} {{\nif !{first} {{ std@1/text.append(mut out, \",\") }}\n{first} = false\n"
    )
    if object {
      put(
        mut w,
        f"std@1/json.write_text_into({key}, mut out)\nstd@1/text.append(mut out, \":\")\n"
      )
      json_into_of(mut w, pair[1], item, f"({depth} + 1)")?
    } else {
      put(mut w, f"std@1/json.check_depth({depth} + 1)?\n")
      literal(mut w, "", "out", "[")
      json_into_of(mut w, pair[0], key, f"({depth} + 2)")?
      literal(mut w, "", "out", ",")
      json_into_of(mut w, pair[1], item, f"({depth} + 2)")?
      literal(mut w, "", "out", "]")
    }
    put(mut w, "}\n")
    literal(
      mut w,
      "",
      "out",
      if object {
        "}"
      } else {
        "]"
      }
    )
    return Ok(())
  }
  if let Some(components) = tuple(ty) {
    let names = fresh_names(mut w, "part", list.len(components))
    put(mut w, f"std@1/json.check_depth({depth})?\nlet {tuple_form(names)} = {read}\n")
    literal(mut w, "", "out", "[")
    let mut i: u64 = 0
    for component in components {
      if i != 0 {
        literal(mut w, "", "out", ",")
      }
      json_into_of(mut w, component, names[i], f"({depth} + 1)")?
      i += 1
    }
    literal(mut w, "", "out", "]")
    return Ok(())
  }
  if nominal(ty) {
    put(mut w, f"{deriver(ty, "json_into")}({read}, mut out, {depth})?\n")
    return Ok(())
  }
  Error(f"no JSON form for {ty}")
}

// Go encoding/json/encode.go:1180-1183 caches quoted field names and
// :733-739 appends them in one write (ebe2feefc400f813aefdc8a036e66d2619da6649).
// Do that at comptime: encode JSON text, then encode that as a source string.
// Field/type names are identifiers; JSON quote/backslash escapes also spell
// Hirsel source literals. UTF-8 identifiers are copied unchanged.
fn json_static(mut w: Writer, value: String, suffix: String) -> () uses {} {
  let mut encoded: List[u8] = []
  json.write_text_into(value, mut encoded)
  text.append(mut encoded, suffix)
  let mut source: List[u8] = []
  json.write_text_into(text.finish_valid(take encoded), mut source)
  put(mut w, f"std@1/text.append(mut out, {text.finish_valid(take source)})\n")
}

/// Write the same compact JSON as json_value followed by stringify_into,
/// directly from a record or choice. Nested nominal types supply their own
/// `<snake_name>_json_into` writer. Pass depth 0 at the root.
pub fn json_into[T](s: TypeShape[T]) -> Result[
  Body[fn(T, mut List[u8], u64) -> Result[(), json.JsonError] uses {}],
  String
] uses {} {
  let info = type_shape.info(s)
  let mut w = writer()
  put(
    mut w,
    f"fn(value: {info.name}, mut out: List[u8], depth: u64) -> Result[(), std@1/json.JsonError] uses {{}} {{\n"
  )
  match info.body {
    Record(fields) => {
      put(mut w, "std@1/json.check_depth(depth)?\nstd@1/text.append(mut out, \"{\")\n")
      let mut first = true
      for f in fields {
        if !first {
          literal(mut w, "", "out", ",")
        }
        first = false
        json_static(mut w, f.name, ":")
        json_into_of(mut w, f.ty, f"value.{f.name}", "(depth + 1)")?
      }
      literal(mut w, "", "out", "}")
    },
    Choice(variants) => {
      put(mut w, "match value {\n")
      for v in variants {
        let kind = style(v)
        let names = binders("p", list.len(v.payload))
        put(mut w, f"{variant_form(v, names)} => {{\n")
        if kind == "unit" {
          json_static(mut w, v.name, "")
        } else {
          put(
            mut w,
            "std@1/json.check_depth(depth)?\nstd@1/text.append(mut out, \"{\")\n"
          )
          json_static(mut w, v.name, ":")
          if kind == "newtype" {
            json_into_of(mut w, v.payload[0].ty, names[0], "(depth + 1)")?
          } else {
            let struct_like = kind == "struct"
            put(mut w, "std@1/json.check_depth(depth + 1)?\n")
            literal(
              mut w,
              "",
              "out",
              if struct_like {
                "{"
              } else {
                "["
              }
            )
            let mut i: u64 = 0
            for p in v.payload {
              if i != 0 {
                literal(mut w, "", "out", ",")
              }
              if struct_like {
                json_static(mut w, label_of(p), ":")
              }
              json_into_of(mut w, p.ty, names[i], "(depth + 2)")?
              i += 1
            }
            literal(
              mut w,
              "",
              "out",
              if struct_like {
                "}"
              } else {
                "]"
              }
            )
          }
          literal(mut w, "", "out", "}")
        }
        put(mut w, "},\n")
      }
      put(mut w, "}\n")
    },
  }
  put(mut w, "Ok(())\n}")
  Ok(body(take w))
}

// ---- Direct typed JSON decoding ----
// serde_json src/de.rs:1820-1860,1919-2045 (8c535a260ce561eaab4111aafc29038eb9f77ff3):
// generated field dispatch drives one shared pull reader. Unlike serde, Hirsel
// rejects every duplicate key, including ignored keys, and keeps number text.
// Translate the parser's error domain at the existing String-error boundary.
// Reader users can retain the exact JsonError and byte position instead.
pub fn read_json[T](take value: Result[T, json.JsonError]) -> Result[T, String] uses {value} {
  match take value {
    Ok(v) => Ok(take v),
    Error(_) => Error("not JSON"),
  }
}

// The same nonfinite string policy as the Value decoder.
pub fn json_non_finite(spelling: String) -> bool uses {} {
  non_finite(spelling)
}

pub fn read_bool(mut cursor: json.Reader) -> Result[bool, String] uses {} {
  match json.next_token(mut cursor) {
    Ok(BoolToken(b)) => Ok(b),
    Error(_) => Error("not JSON"),
    _ => Error("expected a JSON boolean"),
  }
}

pub fn read_string(mut cursor: json.Reader) -> Result[unique String, String] uses {} {
  if json.peek(mut cursor) != 34 {
    return Error("expected a JSON string")
  }
  read_json(json.read_owned_text(mut cursor))
}

pub fn read_null(mut cursor: json.Reader) -> Result[(), String] uses {} {
  match json.next_token(mut cursor) {
    Ok(NullToken) => Ok(()),
    _ => Error("not JSON"),
  }
}

// serde_json src/ser.rs:169-181,1716-1723: format a finite scalar
// directly into the destination. Hirsel retains its nonfinite string policy.
@preserves_unique(out)
pub fn write_json_f64(value: f64, mut out: List[u8]) -> () uses {} {
  if core@1/f64.bits(value) & 0x7ff0000000000000 == 0x7ff0000000000000 {
    json.write_text_into(f64.to_string(value), mut out)
  } else {
    f64.format_into(value, mut out)
  }
}

// serde_json src/de.rs:462-576 converts the token without an owned String.
// Reuse Hirsel's exact decimal parser and keep its public String wrapper.
pub fn read_json_f64(mut cursor: json.Reader) -> Result[f64, String] uses {} {
  if json.peek(mut cursor) == 34 {
    let spelling = read_json(json.read_owned_text(mut cursor))?
    if !non_finite(spelling) {
      return Error("expected a JSON number")
    }
    return parsed(f64.parse(spelling), "f64")
  }
  if json.peek(mut cursor) != 45 && !ascii.is_digit(json.peek(mut cursor)) {
    return Error("expected a JSON number")
  }
  let raw = match json.read_number(mut cursor) {
    Ok(raw) => raw,
    Error(_) => return Error("not JSON"),
  }
  let bits = parsed(internal.float_decimal.parse_bytes(raw, 52, 1023), "f64")?
  let word: u64 = core@1/int.narrow(bits)
  Ok(core@1/f64.from_bits(word))
}

@preserves_unique(out)
pub fn write_json_f32(value: f32, mut out: List[u8]) -> () uses {} {
  if core@1/f32.bits(value) & 0x7f800000 == 0x7f800000 {
    json.write_text_into(f32.to_string(value), mut out)
  } else {
    f32.format_into(value, mut out)
  }
}

// serde_json src/de.rs:462-576 converts the token without an owned String.
// Reuse Hirsel's exact decimal parser and keep its public String wrapper.
pub fn read_json_f32(mut cursor: json.Reader) -> Result[f32, String] uses {} {
  if json.peek(mut cursor) == 34 {
    let spelling = read_json(json.read_owned_text(mut cursor))?
    if !non_finite(spelling) {
      return Error("expected a JSON number")
    }
    return parsed(f32.parse(spelling), "f32")
  }
  if json.peek(mut cursor) != 45 && !ascii.is_digit(json.peek(mut cursor)) {
    return Error("expected a JSON number")
  }
  let raw = match json.read_number(mut cursor) {
    Ok(raw) => raw,
    Error(_) => return Error("not JSON"),
  }
  let bits = parsed(internal.float_decimal.parse_bytes(raw, 23, 127), "f32")?
  let word: u32 = core@1/int.narrow(bits)
  Ok(core@1/f32.from_bits(word))
}

// Describe an unexpected token without materializing a json.Value.
pub fn reader_invalid_type(mut cursor: json.Reader, expected: String) -> unique String uses {} {
  let unexpected = match json.next_token(mut cursor) {
    Ok(NullToken) => "null",
    Ok(BoolToken(b)) => f"boolean `{b}`",
    Ok(NumberToken(raw)) => {
      let n = json.number_text(raw)
      if string.contains(n, ".") || string.contains(n, "e") || string.contains(n, "E") {
        f"floating point `{n}`"
      } else {
        f"integer `{n}`"
      }
    },
    Ok(TextToken(s)) => {
      let mut out: List[u8] = []
      json.write_text_into(json.text_owned(s), mut out)
      f"string {text.finish_valid(take out)}"
    },
    Ok(ArrayStart) => "sequence",
    Ok(ObjectStart) => "map",
    _ => return "not JSON",
  }
  f"invalid type: {unexpected}, expected {expected}"
}

fn from_reader_of(mut w: Writer, ty: String) -> Result[(), String] uses {} {
  if ty == "bool" {
    put(mut w, "std@1/derive.read_bool(mut cursor)?")
    return Ok(())
  }
  if ty == "String" {
    put(mut w, "std@1/derive.read_string(mut cursor)?")
    return Ok(())
  }
  if float(ty) {
    put(mut w, f"std@1/derive.read_json_{ty}(mut cursor)?")
    return Ok(())
  }
  if integer(ty) {
    let spelling = fresh(mut w, "spelling")
    put(
      mut w,
      f"{{\n if std@1/json.peek(mut cursor) != 45 && !std@1/ascii.is_digit(std@1/json.peek(mut cursor)) {{ return Error(\"expected a JSON number\") }}\n let {spelling} = match std@1/json.read_number(mut cursor) {{ Ok(n) => std@1/json.number_text(n), Error(_) => return Error(\"not JSON\") }}\n"
    )
    put(mut w, f" std@1/derive.parsed(std@1/{ty}.parse({spelling}), \"{ty}\")?\n }}")
    return Ok(())
  }
  if let Some(inner) = argument(ty, "core@1/Option") {
    nested_option(ty, inner)?
    put(
      mut w,
      "if std@1/json.peek(mut cursor) == 110 { std@1/derive.read_null(mut cursor)?\n None } else { Some("
    )
    from_reader_of(mut w, inner)?
    put(mut w, ") }")
    return Ok(())
  }
  if let Some(pair) = parameters(ty, "Map") {
    let items = fresh(mut w, "items")
    let key = fresh(mut w, "key")
    let value = fresh(mut w, "value")
    let first = fresh(mut w, "first")
    if pair[0] == "String" {
      let keys = fresh(mut w, "keys")
      put(
        mut w,
        f"{{\n if std@1/json.peek(mut cursor) != 123 {{ return Error(\"expected a JSON object\") }}\n std@1/derive.read_json(std@1/json.begin_object(mut cursor))?\n let mut {items}: {ty} = map.empty()\n let mut {keys}: Set[String] = set.empty()\n let mut {first} = true\n while let Some({key}) = std@1/derive.read_json(std@1/json.object_next(mut cursor, mut {first}, mut {keys}))? {{\n let {value}: {pair[1]} = "
      )
      from_reader_of(mut w, pair[1])?
      // Copy just the key, never unique a view of the whole cursor allocation.
      put(
        mut w,
        f"\n let mut key_bytes: List[u8] = []\n std@1/text.append(mut key_bytes, {key})\n map.insert(mut {items}, std@1/text.finish_valid(take key_bytes), take {value})\n }}\n take {items}\n }}"
      )
      return Ok(())
    }
    put(
      mut w,
      f"{{\n if std@1/json.peek(mut cursor) != 91 {{ return Error(\"expected a JSON array\") }}\n std@1/derive.read_json(std@1/json.begin_array(mut cursor))?\n let mut {items}: {ty} = map.empty()\n let mut {first} = true\n while std@1/derive.read_json(std@1/json.array_next(mut cursor, mut {first}))? {{\n if std@1/json.peek(mut cursor) != 91 {{ return Error(\"expected JSON map entries as pairs\") }}\n std@1/derive.read_json(std@1/json.begin_array(mut cursor))?\n let mut pair_first = true\n if !std@1/derive.read_json(std@1/json.array_next(mut cursor, mut pair_first))? {{ return Error(\"expected JSON map entries as pairs\") }}\n let {key}: {pair[0]} = "
    )
    from_reader_of(mut w, pair[0])?
    put(
      mut w,
      f"\n if !std@1/derive.read_json(std@1/json.array_next(mut cursor, mut pair_first))? {{ return Error(\"expected JSON map entries as pairs\") }}\n let {value}: {pair[1]} = "
    )
    from_reader_of(mut w, pair[1])?
    put(
      mut w,
      f"\n if std@1/derive.read_json(std@1/json.array_next(mut cursor, mut pair_first))? {{ return Error(\"expected JSON map entries as pairs\") }}\n if map.contains({items}, {key}) {{ return Error(\"duplicate map key\") }}\n map.insert(mut {items}, take {key}, take {value})\n }}\n take {items}\n }}"
    )
    return Ok(())
  }
  if let Some(inner) = element(ty) {
    let items = fresh(mut w, "items")
    let value = fresh(mut w, "value")
    let first = fresh(mut w, "first")
    let is_set = option.is_some(argument(ty, "Set"))
    let empty = if is_set {
      "set.empty()"
    } else {
      "[]"
    }
    put(
      mut w,
      f"{{\n if std@1/json.peek(mut cursor) != 91 {{ return Error(\"expected a JSON array\") }}\n std@1/derive.read_json(std@1/json.begin_array(mut cursor))?\n let mut {items}: {ty} = {empty}\n let mut {first} = true\n while std@1/derive.read_json(std@1/json.array_next(mut cursor, mut {first}))? {{\n let {value}: {inner} = "
    )
    from_reader_of(mut w, inner)?
    if is_set {
      put(
        mut w,
        f"\n if set.contains({items}, {value}) {{ return Error(\"duplicate set element\") }}\n set.insert(mut {items}, take {value})\n"
      )
    } else {
      put(mut w, f"\n list.push(mut {items}, take {value})\n")
    }
    put(mut w, f" }}\n take {items}\n }}")
    return Ok(())
  }
  if let Some(components) = tuple(ty) {
    let names = reader_tuple(mut w, components, "", false)?
    put(mut w, tuple_form(names))
    put(mut w, "\n }")
    return Ok(())
  }
  if nominal(ty) {
    put(mut w, f"{deriver(ty, "from_json_reader")}(mut cursor)?")
    return Ok(())
  }
  Error(f"no JSON form for {ty}")
}

// A fixed-size sequence; returns taken names and leaves its expression open.
fn reader_tuple(mut w: Writer, types: List[String], expected: String, variant: bool) -> Result[
  List[String],
  String
] uses {} {
  let first = fresh(mut w, "first")
  let count = list.len(types)
  put(mut w, "{\n if std@1/json.peek(mut cursor) != 91 { return Error(")
  if variant {
    put(mut w, "std@1/derive.reader_invalid_type(mut cursor, \"tuple variant\")")
  } else {
    put(mut w, "\"expected a JSON array\"")
  }
  put(
    mut w,
    f") }}\n std@1/derive.read_json(std@1/json.begin_array(mut cursor))?\n let mut {first} = true\n"
  )
  let mut names: List[String] = []
  let mut i: u64 = 0
  for ty in types {
    put(
      mut w,
      f" if !std@1/derive.read_json(std@1/json.array_next(mut cursor, mut {first}))? {{\n"
    )
    if variant {
      put(mut w, f" std@1/derive.json_length({i}, {count}, \"{expected}\")?\n")
    }
    put(mut w, f" return Error(\"expected {count} JSON array items\")\n }}\n")
    let name = fresh(mut w, "part")
    put(mut w, f" let {name}: {ty} = ")
    from_reader_of(mut w, ty)?
    put(mut w, "\n")
    list.push(mut names, f"take {name}")
    i += 1
  }
  put(
    mut w,
    f" if std@1/derive.read_json(std@1/json.array_next(mut cursor, mut {first}))? {{\n"
  )
  if variant {
    let length = fresh(mut w, "length")
    put(
      mut w,
      f" let mut {length}: u64 = {count}\n while true {{ std@1/derive.read_json(std@1/json.skip(mut cursor))?\n {length} += 1\n if !std@1/derive.read_json(std@1/json.array_next(mut cursor, mut {first}))? {{ break }}\n }}\n std@1/derive.json_length({length}, {count}, \"{expected}\")?\n"
    )
  }
  put(mut w, f" return Error(\"expected {count} JSON array items\")\n }}\n")
  Ok(take names)
}

// Rust HashSet::new keeps empty storage unallocated. A derived record needs
// the unknown-key tracker only after encountering its first unknown field;
// known fields already detect decoded duplicates with their Option slots.
// Keep the same hashed set for unknown fields, including wide objects.
pub fn remember_unknown_key(mut keys: Option[Set[String]], take key: String) -> bool uses {} {
  let mut seen = match option.remove(mut keys) {
    Some(previous) => take previous,
    None => set.empty(),
  }
  let duplicate = set.contains(seen, key)
  if !duplicate {
    set.insert(mut seen, take key)
  }
  keys = Some(take seen)
  !duplicate
}

// SmallVec 4999262d672a92b1b6a4aab7bef43b3d788f3d83 (MIT/Apache-2.0),
// src/lib.rs:586-615,674-703 keeps bounded inline
// storage before allocating spill storage. The reader must own retained keys:
// cursor-borrowed TextViews cannot survive the next mutable cursor operation.
// Keep two owned spellings inline and hash only subsequent unknown keys.
fn reader_members(
  mut w: Writer,
  names: List[String],
  types: List[String],
  expected: String
) -> Result[List[String], String] uses {} {
  put(
    mut w,
    f" if std@1/json.peek(mut cursor) != 123 {{ return Error(std@1/derive.reader_invalid_type(mut cursor, \"{expected}\")) }}\n std@1/derive.read_json(std@1/json.begin_object(mut cursor))?\n"
  )
  let slots = fresh_names(mut w, "slot", list.len(names))
  let mut i: u64 = 0
  for ty in types {
    put(mut w, f" let mut {slots[i]}: core@1/Option[{ty}] = None\n")
    i += 1
  }
  let keys = fresh(mut w, "keys")
  let first_unknown = fresh(mut w, "unknown")
  let second_unknown = fresh(mut w, "unknown")
  let first = fresh(mut w, "first")
  let key = fresh(mut w, "key")
  put(
    mut w,
    f" let mut {keys}: Option[Set[String]] = None\n let mut {first_unknown}: Option[String] = None\n let mut {second_unknown}: Option[String] = None\n let mut {first} = true\n while true {{\n let Some({key}) = (match std@1/json.object_key(mut cursor, mut {first}) {{ Ok(k) => k, Error(_) => return Error(\"not JSON\") }}) else {{ break }}\n"
  )
  i = 0
  for name in names {
    let mut quoted: List[u8] = []
    json.write_text_into(name, mut quoted)
    let spelling = text.finish_valid(take quoted)
    put(
      mut w,
      f" if std@1/json.text_is({key}, {spelling}) {{\n if option.is_some({slots[i]}) {{ return Error(\"not JSON\") }}\n std@1/derive.read_json(std@1/json.colon(mut cursor))?\n {slots[i]} = Some("
    )
    from_reader_of(mut w, types[i])?
    put(mut w, ")\n continue\n }\n")
    i += 1
  }
  put(
    mut w,
    f" match {first_unknown} {{\n None => {{ {first_unknown} = Some(std@1/json.text_owned({key})) }},\n Some(previous_first) => {{\n if std@1/json.text_is({key}, previous_first) {{ return Error(\"not JSON\") }}\n match {second_unknown} {{\n None => {{ {second_unknown} = Some(std@1/json.text_owned({key})) }},\n Some(previous_second) => {{\n if std@1/json.text_is({key}, previous_second) {{ return Error(\"not JSON\") }}\n let unknown_key = std@1/json.text_owned({key})\n if !std@1/derive.remember_unknown_key(mut {keys}, take unknown_key) {{ return Error(\"not JSON\") }}\n }},\n }}\n }},\n }}\n std@1/derive.read_json(std@1/json.colon(mut cursor))?\n std@1/derive.read_json(std@1/json.skip(mut cursor))?\n }}\n"
  )
  let mut arguments: List[String] = []
  i = 0
  for name in names {
    let decoded = fresh(mut w, "decoded")
    if string.starts_with(types[i], "core@1/Option[") {
      put(
        mut w,
        f" let {decoded}: {types[i]} = match take {slots[i]} {{ Some(v) => take v, None => None }}\n"
      )
    } else {
      put(
        mut w,
        f" let Some({decoded}) = take {slots[i]} else {{ return Error(\"missing field `{name}`\") }}\n"
      )
    }
    list.push(mut arguments, f"{name}: take {decoded}")
    i += 1
  }
  Ok(take arguments)
}

/// Derive `type_from_json_reader(mut json.Reader)`: consumes one typed value
/// within the caller's reader. Nested nominal types use their matching entry.
pub fn from_json_reader[T](s: TypeShape[T]) -> Result[
  Body[fn(mut json.Reader) -> Result[T, String] uses {}],
  String
] uses {} {
  let info = type_shape.info(s)
  let name = short_name(info.name)
  let mut w = writer()
  put(
    mut w,
    f"fn(mut cursor: std@1/json.Reader) -> core@1/Result[{info.name}, String] uses {{}} {{\n"
  )
  match info.body {
    Record(fields) => {
      let mut names: List[String] = []
      let mut types: List[String] = []
      for f in fields {
        list.push(mut names, unique f.name)
        list.push(mut types, unique f.ty)
      }
      let args = reader_members(mut w, names, types, f"struct {name}")?
      put(mut w, f" Ok({constructor(info.name)}({string.join(args, ", ")}))\n")
    },
    Choice(variants) => {
      let mut names: List[String] = []
      for v in variants {
        list.push(mut names, unique v.name)
      }
      let expected = one_of(names)
      put(
        mut w,
        " if std@1/json.peek(mut cursor) == 34 {\n let tag = std@1/derive.read_json(std@1/json.read_owned_text(mut cursor))?\n"
      )
      for v in variants {
        put(mut w, f" if tag == \"{v.name}\" {{\n")
        if style(v) == "unit" {
          put(mut w, f" return Ok({v.name})\n")
        } else {
          put(
            mut w,
            f" return Error(\"invalid type: unit variant, expected {style(v)} variant\")\n"
          )
        }
        put(mut w, " }\n")
      }
      put(
        mut w,
        f" return Error(std@1/derive.unknown_variant(tag, \"{expected}\"))\n }}\n if std@1/json.peek(mut cursor) != 123 {{ return Error(std@1/derive.reader_invalid_type(mut cursor, \"string or map\")) }}\n let mut probe = copy cursor\n std@1/derive.read_json(std@1/json.begin_object(mut probe))?\n let mut probe_keys: Set[String] = set.empty()\n let mut probe_first = true\n let mut members: u64 = 0\n while option.is_some(std@1/derive.read_json(std@1/json.object_next(mut probe, mut probe_first, mut probe_keys))?) {{\n std@1/derive.read_json(std@1/json.skip(mut probe))?\n members += 1\n }}\n if members != 1 {{ return Error(\"invalid value: map, expected map with a single key\") }}\n std@1/derive.read_json(std@1/json.begin_object(mut cursor))?\n let mut keys: Set[String] = set.empty()\n let mut first = true\n let Some(tag) = std@1/derive.read_json(std@1/json.object_next(mut cursor, mut first, mut keys))? else {{ return Error(\"invalid value: map, expected map with a single key\") }}\n"
      )
      for v in variants {
        let kind = style(v)
        put(mut w, f" if tag == \"{v.name}\" {{\n")
        if kind == "unit" {
          put(
            mut w,
            f" if std@1/json.peek(mut cursor) != 110 {{ return Error(std@1/derive.reader_invalid_type(mut cursor, \"unit\")) }}\n std@1/derive.read_null(mut cursor)?\n let decoded: {info.name} = {v.name}\n"
          )
        } else if kind == "newtype" {
          put(mut w, f" let payload: {v.payload[0].ty} = ")
          from_reader_of(mut w, v.payload[0].ty)?
          put(mut w, f"\n let decoded: {info.name} = {v.name}(take payload)\n")
        } else if kind == "tuple" {
          let mut types: List[String] = []
          for p in v.payload {
            list.push(mut types, unique p.ty)
          }
          put(mut w, f" let decoded: {info.name} = ")
          let args = reader_tuple(mut w, types, f"tuple variant {name}::{v.name}", true)?
          put(mut w, f" {v.name}({string.join(args, ", ")})\n }}\n")
        } else {
          let mut labels: List[String] = []
          let mut types: List[String] = []
          for p in v.payload {
            list.push(mut labels, label_of(p))
            list.push(mut types, unique p.ty)
          }
          let args = reader_members(mut w, labels, types, "struct variant")?
          put(
            mut w,
            f" let decoded: {info.name} = {v.name}({string.join(args, ", ")})\n"
          )
        }
        put(
          mut w,
          " if option.is_some(std@1/derive.read_json(std@1/json.object_next(mut cursor, mut first, mut keys))?) { return Error(\"invalid value: map, expected map with a single key\") }\n return Ok(take decoded)\n }\n"
        )
      }
      put(mut w, f" Error(std@1/derive.unknown_variant(tag, \"{expected}\"))\n")
    },
  }
  put(mut w, "}")
  Ok(body(take w))
}

/// Derive `type_from_json_bytes(Bytes)`: one complete UTF-8 document. Declare
/// type_from_json_reader as well, so recursive/nested types share the reader.
/// The reader decoder constructs owned fields; move its result without detaching
/// the completed graph. Token views remain bounded by the Reader.
pub fn from_json_bytes[T](s: TypeShape[T]) -> Result[
  Body[fn(Bytes) -> Result[T, String] uses {}],
  String
] uses {} {
  let info = type_shape.info(s)
  let mut w = writer()
  put(
    mut w,
    f"fn(data: Bytes) -> core@1/Result[{info.name}, String] uses {{}} {{\n if !std@1/json.valid_utf8(data) {{ return Error(\"not UTF-8\") }}\n let mut cursor = std@1/json.reader(data)\n let decoded = {deriver(
      info.name,
      "from_json_reader"
    )}(mut cursor)\n if results.is_error(decoded) {{\n let mut validation = std@1/json.reader(data)\n std@1/derive.read_json(std@1/json.skip(mut validation))?\n std@1/derive.read_json(std@1/json.finish_reader(mut validation))?\n }} else {{ std@1/derive.read_json(std@1/json.finish_reader(mut cursor))? }}\n take decoded\n }}"
  )
  Ok(body(take w))
}
