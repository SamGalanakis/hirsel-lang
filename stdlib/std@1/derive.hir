// Generators for `= comptime` function bodies (CT-5). Each reads a record or
// variant type's shape and returns one function literal for the header written
// in source; a field type it has no form for is its Error, naming the type.
// Generated text spells every type and std call by its canonical versioned
// path, so it checks the same way in every module.
//
// A field of another record or variant type uses that type's own deriver,
// named from the type's declared name in snake case: `item_to_json`,
// `item_from_json`, `item_format` and `item_hash` for `Item`, resolved in the
// declaring module like a call written there. A recursive type's deriver calls
// itself.
// The text of `text` from byte `start` to byte `end`, past leading spaces.
fn part(text: String, start: u64, end: u64) -> unique String uses {} {
  let bytes = core@1/string.as_bytes(text)
  let mut from = start
  while from < end && bytes[from] == 32 {
    from += 1
  }
  let Some(first) = core@1/string.position(text, from) else {
    return ""
  }
  let Some(last) = core@1/string.position(text, end) else {
    return ""
  }
  unique core@1/string.slice(text, first, last)
}

// The comma-separated items of `text` outside brackets and parentheses:
// `u64` and `List[(u8, u8)]` for `u64, List[(u8, u8)]`. An empty last item,
// as in `A,`, is left out.
fn top_level(text: String) -> List[String] uses {} {
  let bytes = core@1/string.as_bytes(text)
  let n = core@1/bytes.len(bytes)
  let mut items: List[String] = []
  let mut depth: u64 = 0
  let mut start: u64 = 0
  let mut i: u64 = 0
  while i <= n {
    if i == n || bytes[i] == 44 && depth == 0 {
      let item = part(text, start, i)
      if core@1/string.byte_len(item) != 0 {
        list.push(mut items, take item)
      }
      start = i + 1
    } else if bytes[i] == 91 || bytes[i] == 40 {
      depth += 1
    } else if bytes[i] == 93 || bytes[i] == 41 {
      depth -= 1
    }
    i += 1
  }
  take items
}

// The type parameters of `ty` when it is `head[..]`, such as `[String, u64]`
// for `Map[String, u64]` and head `Map`.
fn parameters(ty: String, head: String) -> Option[List[String]] uses {} {
  let open = f"{head}["
  if !string.starts_with(ty, open) || !string.ends_with(ty, "]") {
    return None
  }
  let end = core@1/string.byte_len(ty) - 1
  Some(top_level(part(ty, core@1/string.byte_len(open), end)))
}

// The one type argument of `ty` when it is `head[..]`.
fn argument(ty: String, head: String) -> Option[unique String] uses {} {
  let Some(items) = parameters(ty, head) else {
    return None
  }
  if list.len(items) != 1 {
    return None
  }
  Some(unique items[0])
}

// The component types of a tuple spelling `(A, B)` or `(A,)`; None for any
// other type, the unit type `()` included.
fn tuple(ty: String) -> Option[List[String]] uses {} {
  if !string.starts_with(ty, "(") || !string.ends_with(ty, ")") {
    return None
  }
  let items = top_level(part(ty, 1, core@1/string.byte_len(ty) - 1))
  if list.len(items) == 0 {
    return None
  }
  Some(take items)
}

const INTEGERS: List[String] = [
  "u8",
  "u16",
  "u32",
  "u64",
  "u128",
  "i8",
  "i16",
  "i32",
  "i64",
  "i128"
]

fn integer(ty: String) -> bool uses {} {
  for name in INTEGERS {
    if ty == name {
      return true
    }
  }
  false
}

fn float(ty: String) -> bool uses {} {
  ty == "f32" || ty == "f64"
}

// A nominal type's canonical spelling is its versioned path, `pkg@n/..`, with
// any type arguments in brackets after it.
fn nominal(ty: String) -> bool uses {} {
  let path = constructor(ty)
  string.contains(path, "@") && !string.contains(path, " ") && !string.contains(
    path,
    "("
  )
}

// A nominal type's path without type arguments: `app@1/m.Pair` for
// `app@1/m.Pair[u64]`, which names its record constructor in any module.
fn constructor(name: String) -> unique String uses {} {
  let Some(at) = string.find(name, "[") else {
    return unique name
  }
  let Some(start) = core@1/string.position(name, 0) else {
    return unique name
  }
  unique core@1/string.slice(name, start, at)
}

// The declared name alone: `Todo` for `app@1/todo.Todo`.
fn short_name(name: String) -> unique String uses {} {
  let mut last = constructor(name)
  let separators: List[String] = ["/", "."]
  for separator in separators {
    let parts = string.split(take last, separator)
    last = unique parts[list.len(parts) - 1]
  }
  take last
}

// `TodoItem` as `todo_item` and `HTTPRequest` as `http_request`: an underscore
// before each capital that ends a lowercase run or starts a word after capitals.
fn snake(name: String) -> unique String uses {} {
  let bytes = core@1/string.as_bytes(name)
  let n = core@1/bytes.len(bytes)
  let mut out: List[u8] = []
  let mut i: u64 = 0
  while i < n {
    let c = bytes[i]
    if ascii.is_upper(c) {
      let previous_upper = i > 0 && ascii.is_upper(bytes[i - 1])
      let next_lower = i + 1 < n && ascii.is_lower(bytes[i + 1])
      if i > 0 && bytes[i - 1] != 95 && (!previous_upper || next_lower) {
        list.push(mut out, 95u8)
      }
      list.push(mut out, ascii.to_lower(c))
    } else {
      list.push(mut out, c)
    }
    i += 1
  }
  text.finish_valid(take out)
}

// The deriver a generated body calls for a field of nominal type `ty`.
fn deriver(ty: String, suffix: String) -> unique String uses {} {
  f"{snake(short_name(ty))}_{suffix}"
}

// Generated text under construction, with a counter that makes each binding
// name it hands out unique in the body.
type Writer {
  out: List[u8],
  next: u64,
}

fn writer() -> unique Writer uses {} {
  Writer(out: [], next: 0)
}

fn put(mut w: Writer, piece: String) -> () uses {} {
  text.append(mut w.out, piece)
}

// A binding name `prefix` and a number no other name in the body has.
fn fresh(mut w: Writer, prefix: String) -> unique String uses {} {
  let name = f"{prefix}{w.next}"
  w.next += 1
  take name
}

fn fresh_names(mut w: Writer, prefix: String, count: u64) -> List[String] uses {} {
  let mut names: List[String] = []
  let mut i: u64 = 0
  while i < count {
    list.push(mut names, fresh(mut w, prefix))
    i += 1
  }
  take names
}

// The finished text as one function body.
fn body[F](take w: Writer) -> Body[F] uses {} {
  let Writer(out: out, next: _) = take w
  codegen.body(text.finish_valid(take out))
}

// Positional binding names `prefix0, prefix1, ..` for `count` payloads.
fn binders(prefix: String, count: u64) -> List[String] uses {} {
  let mut names: List[String] = []
  let mut i: u64 = 0
  while i < count {
    list.push(mut names, f"{prefix}{i}")
    i += 1
  }
  take names
}

// A variant pattern or construction: `Name`, `Name(a, b)` or, for labelled
// payloads, `Name(label: a, ..)`.
fn variant_form(v: VariantShape, names: List[String]) -> unique String uses {} {
  if list.len(v.payload) == 0 {
    return unique v.name
  }
  let mut parts: List[String] = []
  let mut i: u64 = 0
  for p in v.payload {
    match p.label {
      Some(label) => list.push(mut parts, f"{label}: {names[i]}"),
      None => list.push(mut parts, unique names[i]),
    }
    i += 1
  }
  f"{v.name}({string.join(parts, ", ")})"
}

// A tuple pattern or construction of `names`: `(a, b)` or `(a,)`.
fn tuple_form(names: List[String]) -> unique String uses {} {
  if list.len(names) == 1 {
    return f"({names[0]},)"
  }
  f"({string.join(names, ", ")})"
}

// The element type of a List or Set spelling.
fn element(ty: String) -> Option[unique String] uses {} {
  match argument(ty, "List") {
    Some(inner) => Some(take inner),
    None => argument(ty, "Set"),
  }
}

fn nested_option(ty: String, inner: String) -> Result[(), String] uses {} {
  if string.starts_with(inner, "core@1/Option[") {
    return Error(f"no JSON form for {ty}: null cannot tell its Nones apart")
  }
  Ok(())
}

// ---- JSON ----
// Writes an expression of type std@1/json.Value for `read`, of canonical type
// `ty`.
fn json_of(mut w: Writer, ty: String, read: String) -> Result[(), String] uses {} {
  if ty == "bool" {
    put(mut w, f"Bool({read})")
    return Ok(())
  }
  if ty == "String" {
    put(mut w, f"Text(unique {read})")
    return Ok(())
  }
  if integer(ty) {
    put(mut w, f"Number(std@1/{ty}.to_string({read}))")
    return Ok(())
  }
  if float(ty) {
    put(mut w, f"std@1/derive.json_float(std@1/{ty}.to_string({read}))")
    return Ok(())
  }
  if let Some(inner) = argument(ty, "core@1/Option") {
    nested_option(ty, inner)?
    let item = fresh(mut w, "item")
    put(mut w, f"match {read} {{ Some({item}) => ")
    json_of(mut w, inner, item)?
    put(mut w, ", None => Null }")
    return Ok(())
  }
  if let Some(inner) = element(ty) {
    let items = fresh(mut w, "items")
    let item = fresh(mut w, "item")
    put(
      mut w,
      f"{{\n    let mut {items}: List[std@1/json.Value] = []\n    for {item} in {read} {{\n      list.push(mut {items}, "
    )
    json_of(mut w, inner, item)?
    put(mut w, f")\n    }}\n    Array(take {items})\n  }}")
    return Ok(())
  }
  if let Some(pair) = parameters(ty, "Map") {
    let items = fresh(mut w, "items")
    let key = fresh(mut w, "key")
    let entry = fresh(mut w, "entry")
    if pair[0] == "String" {
      put(
        mut w,
        f"{{\n    let mut {items}: Map[String, std@1/json.Value] = map.empty()\n    for ({key}, {entry}) in {read} {{\n      map.insert(mut {items}, unique {key}, "
      )
      json_of(mut w, pair[1], entry)?
      put(mut w, f")\n    }}\n    Object(take {items})\n  }}")
      return Ok(())
    }
    put(
      mut w,
      f"{{\n    let mut {items}: List[std@1/json.Value] = []\n    for ({key}, {entry}) in {read} {{\n      list.push(mut {items}, Array(["
    )
    json_of(mut w, pair[0], key)?
    put(mut w, ", ")
    json_of(mut w, pair[1], entry)?
    put(mut w, f"]))\n    }}\n    Array(take {items})\n  }}")
    return Ok(())
  }
  if let Some(components) = tuple(ty) {
    let names = fresh_names(mut w, "part", list.len(components))
    let items = fresh(mut w, "items")
    put(
      mut w,
      f"{{\n    let {tuple_form(names)} = {read}\n    let mut {items}: List[std@1/json.Value] = []\n"
    )
    let mut i: u64 = 0
    for component in components {
      put(mut w, f"    list.push(mut {items}, ")
      json_of(mut w, component, names[i])?
      put(mut w, ")\n")
      i += 1
    }
    put(mut w, f"    Array(take {items})\n  }}")
    return Ok(())
  }
  if nominal(ty) {
    put(mut w, f"{deriver(ty, "to_json")}({read})")
    return Ok(())
  }
  Error(f"no JSON form for {ty}")
}

// A record's JSON form is an object with a member per field. A variant without
// payload is its name as a string; one with payloads is an object whose one
// member, its name, holds the array of its payloads.
pub fn json_value[T](s: TypeShape[T]) -> Result[
  Body[fn(T) -> json.Value uses {}],
  String
] uses {} {
  let info = type_shape.info(s)
  let mut w = writer()
  put(mut w, f"fn(value: {info.name}) -> std@1/json.Value uses {{}} {{\n")
  match info.body {
    Record(fields) => {
      put(mut w, "  let mut fields: Map[String, std@1/json.Value] = map.empty()\n")
      for f in fields {
        put(mut w, f"  map.insert(mut fields, \"{f.name}\", ")
        json_of(mut w, f.ty, f"value.{f.name}")?
        put(mut w, ")\n")
      }
      put(mut w, "  Object(take fields)\n")
    },
    Choice(variants) => {
      put(mut w, "  match value {\n")
      for v in variants {
        if list.len(v.payload) == 0 {
          put(mut w, f"    {v.name} => Text(\"{v.name}\"),\n")
        } else {
          let names = binders("p", list.len(v.payload))
          put(mut w, f"    {variant_form(v, names)} => {{\n")
          put(mut w, "      let mut payload: List[std@1/json.Value] = []\n")
          let mut i: u64 = 0
          for p in v.payload {
            put(mut w, "      list.push(mut payload, ")
            json_of(mut w, p.ty, names[i])?
            put(mut w, ")\n")
            i += 1
          }
          put(
            mut w,
            "      let mut tagged: Map[String, std@1/json.Value] = map.empty()\n"
          )
          put(
            mut w,
            f"      map.insert(mut tagged, \"{v.name}\", Array(take payload))\n"
          )
          put(mut w, "      Object(take tagged)\n")
          put(mut w, "    },\n")
        }
      }
      put(mut w, "  }\n")
    },
  }
  put(mut w, "}")
  Ok(body(take w))
}

// Writes an expression of canonical type `ty` decoding `read`, a
// std@1/json.Value; a mismatch returns `Error` from the generated function.
fn from_json_of(mut w: Writer, ty: String, read: String) -> Result[(), String] uses {} {
  if ty == "bool" {
    put(mut w, f"std@1/derive.json_bool({read})?")
    return Ok(())
  }
  if ty == "String" {
    put(mut w, f"std@1/derive.json_text({read})?")
    return Ok(())
  }
  if integer(ty) {
    put(
      mut w,
      f"std@1/derive.parsed(std@1/{ty}.parse(std@1/derive.json_number({read})?), \"{ty}\")?"
    )
    return Ok(())
  }
  if float(ty) {
    put(
      mut w,
      f"std@1/derive.parsed(std@1/{ty}.parse(std@1/derive.json_float_text({read})?), \"{ty}\")?"
    )
    return Ok(())
  }
  if let Some(inner) = argument(ty, "core@1/Option") {
    nested_option(ty, inner)?
    let item = fresh(mut w, "item")
    put(mut w, f"match {read} {{ Null => None, {item} => Some(")
    from_json_of(mut w, inner, item)?
    put(mut w, ") }")
    return Ok(())
  }
  let array = fresh(mut w, "array")
  let expected = f"{{\n    let Array({array}) = {read} else {{\n      return Error(\"expected a JSON array\")\n    }}\n"
  if let Some(inner) = argument(ty, "List") {
    let items = fresh(mut w, "items")
    let item = fresh(mut w, "item")
    put(mut w, expected)
    put(
      mut w,
      f"    let mut {items}: List[{inner}] = []\n    for {item} in {array} {{\n      list.push(mut {items}, "
    )
    from_json_of(mut w, inner, item)?
    put(mut w, f")\n    }}\n    take {items}\n  }}")
    return Ok(())
  }
  if let Some(inner) = argument(ty, "Set") {
    let items = fresh(mut w, "items")
    let item = fresh(mut w, "item")
    let decoded = fresh(mut w, "element")
    put(mut w, expected)
    put(
      mut w,
      f"    let mut {items}: Set[{inner}] = set.empty()\n    for {item} in {array} {{\n      let {decoded}: {inner} = "
    )
    from_json_of(mut w, inner, item)?
    put(
      mut w,
      f"\n      if set.contains({items}, {decoded}) {{\n        return Error(\"duplicate set element\")\n      }}\n      set.insert(mut {items}, take {decoded})\n    }}\n    take {items}\n  }}"
    )
    return Ok(())
  }
  if let Some(pair) = parameters(ty, "Map") {
    let items = fresh(mut w, "items")
    let item = fresh(mut w, "item")
    let key = fresh(mut w, "key")
    let entry = fresh(mut w, "entry")
    if pair[0] == "String" {
      let members = fresh(mut w, "members")
      put(
        mut w,
        f"{{\n    let Object({members}) = {read} else {{\n      return Error(\"expected a JSON object\")\n    }}\n    let mut {items}: {ty} = map.empty()\n    for ({key}, {item}) in {members} {{\n      let {entry}: {pair[1]} = "
      )
      from_json_of(mut w, pair[1], item)?
      put(
        mut w,
        f"\n      map.insert(mut {items}, unique {key}, take {entry})\n    }}\n    take {items}\n  }}"
      )
      return Ok(())
    }
    let couple = fresh(mut w, "pair")
    put(mut w, expected)
    put(
      mut w,
      f"    let mut {items}: {ty} = map.empty()\n    for {item} in {array} {{\n      let Array({couple}) = {item} else {{\n        return Error(\"expected a JSON [key, value] array\")\n      }}\n      if core@1/list.len({couple}) != 2 {{\n        return Error(\"expected a JSON [key, value] array\")\n      }}\n      let {key}: {pair[0]} = "
    )
    from_json_of(mut w, pair[0], f"{couple}[0]")?
    put(mut w, f"\n      let {entry}: {pair[1]} = ")
    from_json_of(mut w, pair[1], f"{couple}[1]")?
    put(
      mut w,
      f"\n      if map.contains({items}, {key}) {{\n        return Error(\"duplicate map key\")\n      }}\n      map.insert(mut {items}, take {key}, take {entry})\n    }}\n    take {items}\n  }}"
    )
    return Ok(())
  }
  if let Some(components) = tuple(ty) {
    let count = list.len(components)
    let names = fresh_names(mut w, "part", count)
    put(mut w, expected)
    put(
      mut w,
      f"    if core@1/list.len({array}) != {count} {{\n      return Error(\"expected {count} JSON array items\")\n    }}\n"
    )
    let mut taken: List[String] = []
    let mut i: u64 = 0
    for component in components {
      put(mut w, f"    let {names[i]}: {component} = ")
      from_json_of(mut w, component, f"{array}[{i}]")?
      put(mut w, "\n")
      list.push(mut taken, f"take {names[i]}")
      i += 1
    }
    put(mut w, f"    {tuple_form(taken)}\n  }}")
    return Ok(())
  }
  if nominal(ty) {
    put(mut w, f"{deriver(ty, "from_json")}({read})?")
    return Ok(())
  }
  Error(f"no JSON form for {ty}")
}

// Decodes the JSON form that `json_value` writes. A missing member of an Option
// field decodes as None; any other mismatch is an Error naming the type.
pub fn from_json[T](s: TypeShape[T]) -> Result[
  Body[fn(json.Value) -> Result[T, String] uses {}],
  String
] uses {} {
  let info = type_shape.info(s)
  let name = short_name(info.name)
  let mut w = writer()
  put(
    mut w,
    f"fn(value: std@1/json.Value) -> core@1/Result[{info.name}, String] uses {{}} {{\n"
  )
  match info.body {
    Record(fields) => {
      put(mut w, "  let Object(fields) = value else {\n")
      put(mut w, f"    return Error(\"{name}: expected a JSON object\")\n")
      put(mut w, "  }\n")
      let mut members: List[String] = []
      let mut i: u64 = 0
      for f in fields {
        if string.starts_with(f.ty, "core@1/Option[") {
          put(
            mut w,
            f"  let decoded{i}: {f.ty} = match map.get(fields, \"{f.name}\") {{\n"
          )
          put(mut w, "    None => None,\n")
          put(mut w, f"    Some(field{i}) => ")
          from_json_of(mut w, f.ty, f"field{i}")?
          put(mut w, ",\n  }\n")
        } else {
          put(mut w, f"  let Some(field{i}) = map.get(fields, \"{f.name}\") else {{\n")
          put(mut w, f"    return Error(\"{name}: missing member {f.name}\")\n")
          put(mut w, "  }\n")
          put(mut w, f"  let decoded{i}: {f.ty} = ")
          from_json_of(mut w, f.ty, f"field{i}")?
          put(mut w, "\n")
        }
        list.push(mut members, f"{f.name}: take decoded{i}")
        i += 1
      }
      put(mut w, f"  Ok({constructor(info.name)}({string.join(members, ", ")}))\n")
    },
    Choice(variants) => {
      put(mut w, "  match value {\n")
      put(mut w, "    Text(tag) => {\n")
      for v in variants {
        if list.len(v.payload) == 0 {
          put(mut w, f"      if tag == \"{v.name}\" {{\n")
          put(mut w, f"        return Ok({v.name})\n")
          put(mut w, "      }\n")
        }
      }
      put(
        mut w,
        f"      Error(std@1/string.concat(\"{name}: unknown variant \", tag))\n"
      )
      put(mut w, "    },\n")
      put(mut w, "    Object(tagged) => {\n")
      for v in variants {
        let count = list.len(v.payload)
        if count != 0 {
          put(
            mut w,
            f"      if let Some(Array(payload)) = map.get(tagged, \"{v.name}\") {{\n"
          )
          put(mut w, f"        if core@1/list.len(payload) != {count} {{\n")
          put(
            mut w,
            f"          return Error(\"{name}: expected {count} payloads for {v.name}\")\n"
          )
          put(mut w, "        }\n")
          let names = binders("take decoded", count)
          let mut i: u64 = 0
          for p in v.payload {
            put(mut w, f"        let decoded{i}: {p.ty} = ")
            from_json_of(mut w, p.ty, f"payload[{i}]")?
            put(mut w, "\n")
            i += 1
          }
          put(mut w, f"        return Ok({variant_form(v, names)})\n")
          put(mut w, "      }\n")
        }
      }
      put(mut w, f"      Error(\"{name}: unknown variant\")\n")
      put(mut w, "    },\n")
      put(mut w, f"    _ => Error(\"{name}: expected a JSON string or object\"),\n")
      put(mut w, "  }\n")
    },
  }
  put(mut w, "}")
  Ok(body(take w))
}

// A JSON boolean, for generated decoders.
pub fn json_bool(value: json.Value) -> Result[bool, String] uses {} {
  match value {
    Bool(b) => Ok(b),
    _ => Error("expected a JSON boolean"),
  }
}

// A JSON string, for generated decoders.
pub fn json_text(value: json.Value) -> Result[unique String, String] uses {} {
  match value {
    Text(text) => Ok(unique text),
    _ => Error("expected a JSON string"),
  }
}

// A JSON number's text, for generated decoders.
pub fn json_number(value: json.Value) -> Result[unique String, String] uses {} {
  match value {
    Number(text) => Ok(unique text),
    _ => Error("expected a JSON number"),
  }
}

fn non_finite(spelling: String) -> bool uses {} {
  spelling == "NaN" || spelling == "inf" || spelling == "-inf"
}

// A float's JSON form from its `to_string` text: a number, or the string
// `NaN`, `inf` or `-inf`, which JSON numbers cannot spell.
pub fn json_float(take spelling: String) -> json.Value uses {} {
  if non_finite(spelling) {
    Text(take spelling)
  } else {
    Number(take spelling)
  }
}

// The text of a float's JSON form, for generated decoders.
pub fn json_float_text(value: json.Value) -> Result[unique String, String] uses {} {
  match value {
    Number(spelling) => Ok(unique spelling),
    Text(spelling) if non_finite(spelling) => Ok(unique spelling),
    _ => Error("expected a JSON number"),
  }
}

// A parsed number, or an error naming the type it does not fit.
pub fn parsed[N, E](take value: Result[N, E], ty: String) -> Result[N, String] uses {value} {
  match take value {
    Ok(n) => Ok(take n),
    Error(_) => Error(f"expected a JSON number fitting {ty}"),
  }
}

// ---- Equality ----
// Equality by `==` on every field, or on the payloads of equal variants.
pub fn equal[T](s: TypeShape[T]) -> Result[Body[fn(T, T) -> bool uses {}], String] uses {} {
  let info = type_shape.info(s)
  let mut w = writer()
  put(mut w, f"fn(left: {info.name}, right: {info.name}) -> bool uses {{}} {{\n")
  match info.body {
    Record(fields) => {
      let mut terms: List[String] = []
      for f in fields {
        list.push(mut terms, f"left.{f.name} == right.{f.name}")
      }
      if list.len(terms) == 0 {
        list.push(mut terms, "true")
      }
      put(mut w, f"  {string.join(terms, " && ")}\n")
    },
    Choice(variants) => {
      put(mut w, "  match left {\n")
      for v in variants {
        let count = list.len(v.payload)
        let mut terms: List[String] = []
        let mut i: u64 = 0
        while i < count {
          list.push(mut terms, f"l{i} == r{i}")
          i += 1
        }
        if count == 0 {
          list.push(mut terms, "true")
        }
        let lefts = variant_form(v, binders("l", count))
        let rights = variant_form(v, binders("r", count))
        put(mut w, f"    {lefts} => match right {{\n")
        put(mut w, f"      {rights} => {string.join(terms, " && ")},\n")
        put(mut w, "      _ => false,\n")
        put(mut w, "    },\n")
      }
      put(mut w, "  }\n")
    },
  }
  put(mut w, "}")
  Ok(body(take w))
}

// ---- Text and hashing ----
// A statement appending the literal `piece` to the List[u8] named `out`.
fn literal(mut w: Writer, indent: String, out: String, piece: String) -> () uses {} {
  put(mut w, f"{indent}std@1/text.append(mut {out}, \"{piece}\")\n")
}

// Writes statements appending the text of `read`, of canonical type `ty`, to
// the List[u8] named `out`: Option as `Some(..)` or `None`, List as `[a, b]`,
// Set as `{a, b}`, Map as `{k: v}` and a tuple as `(a, b)` or `(a,)`. When `hashing`, a
// nested record or variant appends its deriver's hash in decimal and a Set the
// xor of its elements' hashes, so equal sets hash alike in any order; floats,
// which are not `key`, have no hash form.
fn write_of(
  mut w: Writer,
  ty: String,
  read: String,
  indent: String,
  out: String,
  hashing: bool
) -> Result[(), String] uses {} {
  if ty == "String" {
    put(mut w, f"{indent}std@1/text.append(mut {out}, {read})\n")
    return Ok(())
  }
  if float(ty) && hashing {
    return Error(f"no hash form for {ty}: floats are not key")
  }
  if ty == "bool" || integer(ty) || float(ty) {
    put(mut w, f"{indent}std@1/text.append(mut {out}, std@1/{ty}.to_string({read}))\n")
    return Ok(())
  }
  let inner_indent = f"{indent}  "
  if let Some(inner) = argument(ty, "core@1/Option") {
    let item = fresh(mut w, "item")
    put(mut w, f"{indent}match {read} {{\n{indent}  Some({item}) => {{\n")
    literal(mut w, f"{indent}    ", out, "Some(")
    write_of(mut w, inner, item, f"{indent}    ", out, hashing)?
    literal(mut w, f"{indent}    ", out, ")")
    put(
      mut w,
      f"{indent}  }},\n{indent}  None => std@1/text.append(mut {out}, \"None\"),\n{indent}}}\n"
    )
    return Ok(())
  }
  if hashing {
    if let Some(inner) = argument(ty, "Set") {
      let combined = fresh(mut w, "set")
      let item = fresh(mut w, "item")
      let bytes = fresh(mut w, "element")
      put(
        mut w,
        f"{indent}let mut {combined}: u64 = 0\n{indent}for {item} in {read} {{\n{indent}  let mut {bytes}: List[u8] = []\n"
      )
      write_of(mut w, inner, item, inner_indent, bytes, hashing)?
      put(
        mut w,
        f"{indent}  {combined} = {combined} ^ std@1/fnv.digest(core@1/bytes.from_list(take {bytes}))\n{indent}}}\n{indent}std@1/text.append(mut {out}, std@1/u64.to_string({combined}))\n"
      )
      return Ok(())
    }
  }
  let list_like = option.is_some(argument(ty, "List"))
  let map_like = option.is_some(parameters(ty, "Map"))
  if list_like || map_like || option.is_some(argument(ty, "Set")) {
    let first = fresh(mut w, "first")
    let item = fresh(mut w, "item")
    let entry = fresh(mut w, "entry")
    let (open, close) = if list_like {
      ("[", "]")
    } else {
      ("{", "}")
    }
    literal(mut w, indent, out, open)
    put(mut w, f"{indent}let mut {first} = true\n")
    if map_like {
      put(mut w, f"{indent}for ({item}, {entry}) in {read} {{\n")
    } else {
      put(mut w, f"{indent}for {item} in {read} {{\n")
    }
    put(
      mut w,
      f"{indent}  if !{first} {{\n{indent}    std@1/text.append(mut {out}, \", \")\n{indent}  }}\n{indent}  {first} = false\n"
    )
    match parameters(ty, "Map") {
      Some(pair) => {
        write_of(mut w, pair[0], item, inner_indent, out, hashing)?
        literal(mut w, inner_indent, out, ": ")
        write_of(mut w, pair[1], entry, inner_indent, out, hashing)?
      },
      None => {
        let Some(inner) = element(ty) else {
          return Error(f"no text form for {ty}")
        }
        write_of(mut w, inner, item, inner_indent, out, hashing)?
      },
    }
    put(mut w, f"{indent}}}\n")
    literal(mut w, indent, out, close)
    return Ok(())
  }
  if let Some(components) = tuple(ty) {
    let names = fresh_names(mut w, "part", list.len(components))
    put(mut w, f"{indent}let {tuple_form(names)} = {read}\n")
    literal(mut w, indent, out, "(")
    let mut i: u64 = 0
    for component in components {
      if i != 0 {
        literal(mut w, indent, out, ", ")
      }
      write_of(mut w, component, names[i], indent, out, hashing)?
      i += 1
    }
    let close = if list.len(components) == 1 {
      ",)"
    } else {
      ")"
    }
    literal(mut w, indent, out, close)
    return Ok(())
  }
  if nominal(ty) {
    if hashing {
      put(
        mut w,
        f"{indent}std@1/text.append(mut {out}, std@1/u64.to_string({deriver(ty, "hash")}({read})))\n"
      )
    } else {
      put(mut w, f"{indent}{deriver(ty, "format")}({read}, mut {out})\n")
    }
    return Ok(())
  }
  if hashing {
    return Error(f"no hash form for {ty}")
  }
  Error(f"no text form for {ty}")
}

// Writes `Name(field: value, ..)` for a record and `Variant(payload, ..)` or
// `Variant` for a variant, with the header of a `@format` function.
pub fn format[T](s: TypeShape[T]) -> Result[
  Body[fn(T, mut List[u8]) -> () uses {}],
  String
] uses {} {
  let info = type_shape.info(s)
  let mut w = writer()
  put(mut w, f"fn(value: {info.name}, mut out: List[u8]) -> () uses {{}} {{\n")
  match info.body {
    Record(fields) => {
      literal(mut w, "  ", "out", f"{short_name(info.name)}(")
      let mut i: u64 = 0
      for f in fields {
        let separator = if i == 0 {
          ""
        } else {
          ", "
        }
        literal(mut w, "  ", "out", f"{separator}{f.name}: ")
        write_of(mut w, f.ty, f"value.{f.name}", "  ", "out", false)?
        i += 1
      }
      literal(mut w, "  ", "out", ")")
    },
    Choice(variants) => {
      put(mut w, "  match value {\n")
      for v in variants {
        if list.len(v.payload) == 0 {
          put(mut w, f"    {v.name} => std@1/text.append(mut out, \"{v.name}\"),\n")
        } else {
          let names = binders("p", list.len(v.payload))
          put(mut w, f"    {variant_form(v, names)} => {{\n")
          literal(mut w, "      ", "out", f"{v.name}(")
          let mut i: u64 = 0
          for p in v.payload {
            if i != 0 {
              literal(mut w, "      ", "out", ", ")
            }
            write_of(mut w, p.ty, names[i], "      ", "out", false)?
            i += 1
          }
          literal(mut w, "      ", "out", ")")
          put(mut w, "    },\n")
        }
      }
      put(mut w, "  }\n")
    },
  }
  put(mut w, "}")
  Ok(body(take w))
}

// An FNV-1a 64 hash (std@1/fnv) of the text `format` writes for each field, or
// for the variant's name and payloads, each followed by a zero byte. A nested
// record or variant contributes its own deriver's hash.
pub fn hash[T](s: TypeShape[T]) -> Result[Body[fn(T) -> u64 uses {}], String] uses {} {
  let info = type_shape.info(s)
  let mut w = writer()
  put(
    mut w,
    f"fn(value: {info.name}) -> u64 uses {{}} {{\n  let mut out: List[u8] = []\n"
  )
  match info.body {
    Record(fields) => {
      for f in fields {
        write_of(mut w, f.ty, f"value.{f.name}", "  ", "out", true)?
        put(mut w, "  list.push(mut out, 0u8)\n")
      }
    },
    Choice(variants) => {
      put(mut w, "  match value {\n")
      for v in variants {
        let names = binders("p", list.len(v.payload))
        put(mut w, f"    {variant_form(v, names)} => {{\n")
        literal(mut w, "      ", "out", v.name)
        put(mut w, "      list.push(mut out, 0u8)\n")
        let mut i: u64 = 0
        for p in v.payload {
          write_of(mut w, p.ty, names[i], "      ", "out", true)?
          put(mut w, "      list.push(mut out, 0u8)\n")
          i += 1
        }
        put(mut w, "    },\n")
      }
      put(mut w, "  }\n")
    },
  }
  put(mut w, "  std@1/fnv.digest(core@1/bytes.from_list(take out))\n}")
  Ok(body(take w))
}
