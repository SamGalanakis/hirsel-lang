// Go hash/crc32 crc32_generic.go slicingMakeTable/slicingUpdate (BSD-3-Clause): the
// reflected IEEE 802.3 polynomial 0xedb88320 of Ethernet, gzip, zip and PNG. This is
// an error-detecting checksum, not a cryptographic digest.
pub opaque type State: plain + inert uses {} {
  crc: u32,
}

// Port of Go src/hash/crc32/crc32_generic.go:28-40,60-70 at ebe2feefc400
// (BSD-3-Clause). Construct once at compile time instead of runtime lazy init.
// Flat row offsets avoid copying nested Inline rows on each indexed read.
fn slicing_make_table(poly: u32) -> Inline[u32, 2048] uses {} {
  let mut table: Inline[u32, 2048] = [0u32; 2048]
  let mut i: u64 = 0
  while i < 256 {
    let mut crc: u32 = core@1/int.truncate(i)
    let mut bit: u64 = 0
    while bit < 8 {
      if crc & 1 == 1 {
        crc = crc >> 1 ^ poly
      } else {
        crc = crc >> 1
      }
      bit += 1
    }
    table[i] = crc
    i += 1
  }
  i = 0
  while i < 256 {
    let mut crc = table[i]
    let mut j: u64 = 1
    while j < 8 {
      let index: u64 = core@1/int.widen(crc & 255u32)
      crc = table[index] ^ crc >> 8
      table[j * 256 + i] = crc
      j += 1
    }
    i += 1
  }
  table
}

const TABLE: Inline[u32, 2048] = comptime slicing_make_table(0xedb88320)

@noalloc
pub fn new() -> State uses {} {
  State(crc: 0xffffffff)
}

// Go crc32_generic.go:75-90: 16-byte cutoff, >8 stripe loop, bytewise tail.
// Keep the lookups here: forwarding an Inline table to a stripe helper copies
// all 8 KiB on each stripe in the current native compiler.
// State already holds the complemented remainder, so no entry/exit inversions.
@noalloc
fn extend(crc: u32, table: Inline[u32, 2048], data: Bytes) -> u32 uses {} {
  let mut value = crc
  let len = core@1/bytes.len(data)
  let mut i: u64 = 0
  if len - i >= 16 {
    while len - i > 8 {
      // Read the last byte first so one bounds check covers the stripe.
      let last = i + 7
      let b7: u32 = core@1/int.widen(data[last])
      let b0: u32 = core@1/int.widen(data[last - 7])
      let b1: u32 = core@1/int.widen(data[last - 6])
      let b2: u32 = core@1/int.widen(data[last - 5])
      let b3: u32 = core@1/int.widen(data[last - 4])
      let b4: u32 = core@1/int.widen(data[last - 3])
      let b5: u32 = core@1/int.widen(data[last - 2])
      let b6: u32 = core@1/int.widen(data[last - 1])
      let word = value ^ (b0 | b1 << 8 | b2 << 16 | b3 << 24)
      let high = b4 | b5 << 8 | b6 << 16 | b7 << 24
      let a: u64 = core@1/int.widen(high >> 24)
      let b: u64 = core@1/int.widen(high >> 16 & 255u32)
      let c: u64 = core@1/int.widen(high >> 8 & 255u32)
      let d: u64 = core@1/int.widen(high & 255u32)
      let e: u64 = core@1/int.widen(word >> 24)
      let f: u64 = core@1/int.widen(word >> 16 & 255u32)
      let g: u64 = core@1/int.widen(word >> 8 & 255u32)
      let h: u64 = core@1/int.widen(word & 255u32)
      value = table[0 + a] ^ table[256 + b] ^ table[512 + c] ^ table[768 + d] ^ table[1024 + e] ^ table[1280 + f] ^ table[1536 + g] ^ table[1792 + h]
      i += 8
    }
  }
  while i < len {
    let byte: u32 = core@1/int.widen(data[i])
    let index: u64 = core@1/int.widen(value & 255u32 ^ byte)
    value = table[index] ^ value >> 8
    i += 1
  }
  value
}

@noalloc
pub fn update(mut state: State, data: Bytes) -> () uses {} {
  state.crc = extend(state.crc, TABLE, data)
}

/// Extends the checksum with the bytes of a list builder from `start` on.
// Keep Go's simpleUpdate for this surface: native slicing over an arbitrary
// List offset retains bounds checks and measured 27% more instructions.
@noalloc
pub fn update_list(mut state: State, data: List[u8], start: u64) -> () uses {} {
  let mut value = state.crc
  let mut i = start
  while i < core@1/list.len(data) {
    let byte: u32 = core@1/int.widen(data[i])
    let index: u64 = core@1/int.widen(value & 255u32 ^ byte)
    value = TABLE[index] ^ value >> 8
    i += 1
  }
  state.crc = value
}

@noalloc
pub fn finish(take state: State) -> u32 uses {} {
  ~state.crc
}

@noalloc
pub fn digest(data: Bytes) -> u32 uses {} {
  let mut state = new()
  update(mut state, data)
  finish(take state)
}

pub fn digest_hex(data: Bytes) -> unique String uses {} {
  let value = digest(data)
  f"{value:08x}"
}
