// Fixed-distance analysis adapted from re2c 8dca815eb424d8ebcb3df805d17504835e14de11,
// src/regexp/fixed_tags.cc:12-163 (public domain). Unlike lexer code units,
// distances here are UTF-8 bytes. No tag histories or POSIX disambiguation.
// Zero means unknown; positive widths are stored +1, bounded at 1 MiB.
// Captures below alternatives/repetition decline, preserving participation and
// last-write semantics. Only a complete proof is published with this Regex.
fn fixed_add(a: u64, b: u64) -> u64 uses {} {
  if a == 0 || b == 0 || a > 1048577 || b > 1048578 - a {
    0u64
  } else {
    a + b - 1
  }
}

fn fixed_width(node: Node) -> u64 uses {} {
  if node.kind == 0 || node.kind == 3 || node.kind == 4 || node.kind == 5 || node.kind == 6 || node.kind == 15 || node.kind == 16 {
    return 1
  }
  if node.kind != 1 || node.negated || core@1/list.len(node.ranges) == 0 {
    return 0
  }
  let mut width = 0u64
  for (lo, hi) in node.ranges {
    let a = if lo < 128 {
      1u64
    } else if lo < 2048 {
      2u64
    } else if lo < 65536 {
      3u64
    } else {
      4u64
    }
    let b = if hi < 128 {
      1u64
    } else if hi < 2048 {
      2u64
    } else if hi < 65536 {
      3u64
    } else {
      4u64
    }
    if a != b || width != 0 && width != a {
      return 0
    }
    width = a
  }
  width + 1
}

fn fixed_capture_plan(tree: Tree, root: u64) -> List[u64] uses {} {
  let count = core@1/list.len(tree.nodes)
  let groups = core@1/list.len(tree.names)
  if count > 512 || groups > 128 || groups <= 1 {
    return []
  }
  let slots = groups * 2
  let mut widths: List[u64] = []
  for index in 0u64..count {
    let node = tree.nodes[index]
    let mut width = fixed_width(node)
    if node.kind == 7 || node.kind == 8 || node.kind == 9 || node.kind == 17 {
      // Parser trees are postorder. Refuse malformed/cyclic dependencies.
      if node.left >= index || (node.kind == 7 || node.kind == 8) && node.right >= index {
        return []
      }
      width = widths[node.left]
      if node.kind == 7 {
        width = fixed_add(width, widths[node.right])
      } else if node.kind == 8 {
        if width != widths[node.right] {
          width = 0
        }
      } else if node.kind == 9 {
        if node.unbounded || node.min != node.max || width == 0 || node.max > 1048576 {
          width = 0
        } else if width > 1 && node.max > 1048576 / (width - 1) {
          width = 0
        } else {
          width = (width - 1) * node.max + 1
        }
      }
    }
    core@1/list.push(mut widths, width)
  }
  let mut plan: List[u64] = []
  for slot in 0u64..slots {
    core@1/list.push(mut plan, 0u64)
  }
  // from_start/from_end are independent forward/backward distances, encoded +1.
  let mut stack: List[(u64, u64, u64, bool)] = [(root, 1u64, 1u64, true)]
  while let Some((index, from_start, from_end, mandatory)) = core@1/list.pop(mut stack) {
    let node = tree.nodes[index]
    if node.kind == 7 {
      core@1/list.push(
        mut stack,
        (node.left, from_start, fixed_add(from_end, widths[node.right]), mandatory)
      )
      core@1/list.push(
        mut stack,
        (node.right, fixed_add(from_start, widths[node.left]), from_end, mandatory)
      )
    } else if node.kind == 8 || node.kind == 9 {
      // Do not infer participation or last writes from a fixed length alone.
      core@1/list.push(mut stack, (node.left, 0u64, 0u64, false))
      if node.kind == 8 {
        core@1/list.push(mut stack, (node.right, 0u64, 0u64, false))
      }
    } else if node.kind == 17 {
      if !mandatory {
        return []
      }
      let start_end = fixed_add(from_end, widths[node.left])
      let end_start = fixed_add(from_start, widths[node.left])
      // Odd = start + distance, even = end - distance; zero = unproved.
      plan[node.right * 2] = if from_start != 0 {
        from_start * 2 - 1
      } else {
        start_end * 2
      }
      plan[node.right * 2 + 1] = if from_end != 0 {
        from_end * 2
      } else if end_start != 0 {
        end_start * 2 - 1
      } else {
        0u64
      }
      core@1/list.push(mut stack, (node.left, from_start, from_end, mandatory))
    }
  }
  for slot in 2u64..slots {
    if plan[slot] == 0 {
      return []
    }
  }
  take plan
}

fn fixed_capture_offset(tag: u64, span: Span) -> u64 uses {} {
  let distance = (tag - 1) / 2
  core@1/failure.check(distance <= span.end - span.start, Bounds())
  if tag % 2 == 1 {
    span.start + distance
  } else {
    span.end - distance
  }
}

fn fixed_capture_result(re: Regex, subject: Subject, span: Span) -> Captures uses {} {
  let mut spans: List[Option[Span]] = [Some(span)]
  let mut slot = 2u64
  while slot < core@1/list.len(re.fixed_captures) {
    let a = fixed_capture_offset(re.fixed_captures[slot], span)
    let b = fixed_capture_offset(re.fixed_captures[slot + 1], span)
    core@1/failure.check(
      a <= b && boundary(subject.bytes, a) && boundary(subject.bytes, b),
      Bounds()
    )
    core@1/list.push(mut spans, Some(Span(start: a, end: b)))
    slot += 2
  }
  Captures(spans: take spans)
}

// Span-first capture recovery: rust-lang/regex 80b9d14e4be9f0b703a742d11c064abce05f210b
// regex-automata/src/meta/strategy.rs:802-864; regex-lite/src/pikevm.rs:294-435,
// :550-731, :798-900. Copyright 2014 The Rust Project Developers; MIT,
// third-party/NOTICES.md. Adaptations: original-source scalar assertions,
// bounded scan-local scratch, and separate legacy logical-work accounting.
type CaptureScratch {
  data: unique List[u64],
  plan: unique List[u64],
  prepared: bool,
  backtrack_code: unique List[u64],
}

fn capture_scratch() -> CaptureScratch uses {} {
  CaptureScratch(data: [], plan: [], prepared: false, backtrack_code: [])
}

// Two ordered banks, a current restore row, a winning row, generation marks,
// and <=2m+1 Explore/Restore frames (two cells each). Zero denotes absent;
// offsets are stored +1. Eligible source lengths are <=1M, so this cannot wrap.
// Check before multiplying; never allocate an unbounded program*groups table.
// <=32768 cells (256 KiB) plus DFA <=520192 bytes leaves >1 MiB of the combined
// 2 MiB cap for allocator rounding, headers and scalar metadata. No growth.
fn capture_layout(re: Regex) -> u64 uses {} {
  let m = core@1/list.len(re.code)
  let groups = core@1/list.len(re.names)
  if m > 512 || groups > 128 {
    return 0
  }
  let s = groups * 2
  let cells = 7 * m + 4 + (2 * m + 2) * s
  if cells >= 32768 {
    0u64
  } else {
    cells
  }
}

fn capture_row(mut scratch: CaptureScratch, dst: u64, src: u64, size: u64) -> () uses {} {
  let mut i = 0u64
  while i < size {
    scratch.data[dst + i] = scratch.data[src + i]
    i += 1
  }
}

// Restore frames mutate only the current row. A full row is copied only when
// a consuming/accept state enters the ordered ready set, never on epsilon edges.
fn capture_closure(
  re: VmProgram,
  pc: u64,
  at: u64,
  left: u64,
  right: u64,
  mut scratch: CaptureScratch,
  mut count: u64
) -> bool uses {} {
  let m = core@1/list.len(re.code)
  let s = core@1/list.len(re.names) * 2
  let stack = m
  let ready = 5 * m + 4
  let rows = 7 * m + 4
  let current = rows + 2 * m * s
  let mut depth = 1u64
  scratch.data[stack] = pc
  scratch.data[stack + 1] = 0
  while depth != 0 {
    depth -= 1
    let tag = scratch.data[stack + 2 * depth]
    if tag >= m {
      scratch.data[current + tag - m] = scratch.data[stack + 2 * depth + 1]
      continue
    }
    if scratch.data[tag] == at + 1 {
      continue
    }
    scratch.data[tag] = at + 1
    let inst = re.code[tag]
    if dfa_consumes(inst.kind) || inst.kind == 11 {
      scratch.data[ready + count] = tag
      capture_row(mut scratch, rows + count * s, current, s)
      count += 1
      if inst.kind == 11 {
        return true
      }
    } else if dfa_allowed(inst.kind, left, right) {
      if inst.kind == 12 {
        scratch.data[stack + 2 * depth] = m + inst.y
        scratch.data[stack + 2 * depth + 1] = scratch.data[current + inst.y]
        depth += 1
        scratch.data[current + inst.y] = at + 1
      }
      if inst.kind == 10 {
        scratch.data[stack + 2 * depth] = inst.y
        depth += 1
      }
      scratch.data[stack + 2 * depth] = inst.x
      depth += 1
    }
  }
  false
}

fn capture_scalar(subject: Subject, byte: u64) -> u64 uses {} {
  core@1/failure.check(boundary(subject.bytes, byte), Bounds())
  byte
}

// Anchored ordered Pike replay over the confirmed span. The end boundary still
// sees the actual following scalar; ^/$/word boundaries never see a sliced text.
// Replay is physical implementation work, not a second logical matching debit.
fn capture_pike(re: Regex, subject: Subject, span: Span, mut scratch: CaptureScratch) -> Captures uses {} {
  let cells = capture_layout(re)
  core@1/failure.check(cells != 0, Bounds())
  capture_ensure(mut scratch, cells)
  let program = vm_program(re)
  let m = core@1/list.len(re.code)
  let s = core@1/list.len(re.names) * 2
  let ready = 5 * m + 4
  let seeds = ready + m
  let rows = 7 * m + 4
  let seed_rows = rows + m * s
  let current = seed_rows + m * s
  let best = current + s
  let mut i = 0u64
  while i < m {
    scratch.data[i] = 0
    i += 1
  }
  i = 0
  while i < s {
    scratch.data[seed_rows + i] = 0
    i += 1
  }
  scratch.data[seeds] = re.entry
  let mut seed_count = 1u64
  let mut cursor = capture_scalar(subject, span.start)
  let end = capture_scalar(subject, span.end)
  let mut matched: Option[Span] = None()
  while cursor <= end {
    let at = cursor
    let left = if cursor == 0 {
      0u64
    } else {
      dfa_category(dfa_byte(subject, subject_before(subject, cursor)))
    }
    let right = dfa_category(dfa_byte(subject, cursor))
    let mut count = 0u64
    i = 0
    while i < seed_count {
      let pc = scratch.data[seeds + i]
      capture_row(mut scratch, current, seed_rows + i * s, s)
      if capture_closure(program, pc, at, left, right, mut scratch, mut count) {
        break
      }
      i += 1
    }
    seed_count = 0
    i = 0
    while i < count {
      let pc = scratch.data[ready + i]
      let inst = re.code[pc]
      if inst.kind == 11 {
        matched = Some(Span(start: span.start, end: at))
        capture_row(mut scratch, best, rows + i * s, s)
        break
      }
      if cursor < end {
        let mut unused = 18446744073709551615u64
        let accepted = match accepts(inst, subject_scalar(subject, cursor), mut unused) {
          Ok(value) => value,
          Error(_) => {
            core@1/failure.check(false, Bounds())
            false
          },
        }
        if accepted {
          scratch.data[seeds + seed_count] = inst.x
          capture_row(mut scratch, seed_rows + seed_count * s, rows + i * s, s)
          seed_count += 1
        }
      }
      i += 1
    }
    if seed_count == 0 || cursor == end {
      break
    }
    cursor = subject_next(subject, cursor)
  }
  // A disagreement is an internal invariant failure, never fabricated captures.
  core@1/failure.check(matched == Some(span), Bounds())
  let mut spans: List[Option[Span]] = [Some(span)]
  i = 2
  while i < s {
    let a = scratch.data[best + i]
    let b = scratch.data[best + i + 1]
    core@1/list.push(
      mut spans,
      if a != 0 && b != 0 {
        Some(Span(start: a - 1, end: b - 1))
      } else {
        None()
      }
    )
    i += 2
  }
  Captures(spans: take spans)
}

// Capture engine selection and transition actions follow rust-lang/regex
// 80b9d14e4be9f0b703a742d11c064abce05f210b, regex-automata/src/
// meta/strategy.rs:802-864, meta/wrappers.rs:142-184, :330-350;
// dfa/onepass.rs:581-742, :769-803, :2045-2197;
// nfa/thompson/backtrack.rs:1425-1586, :1837-1871.
// Copyright 2014 The Rust Project Developers. MIT; third-party/NOTICES.md.
// The DFA is scan-local and compiled once, only on a capture hit. Scalar
// classes with non-ASCII endpoints and Unicode folding conservatively decline
// one-pass compilation; the scalar backtracker/PikeVM retain their semantics.
// Upstream uses byte equivalence classes; we use ASCII plus one non-ASCII
// class, and pack capture/conditional epsilon actions into each transition.
fn capture_ensure(mut scratch: CaptureScratch, cells: u64) -> () uses {} {
  core@1/failure.check(cells < 32768, Bounds())
  if core@1/list.len(scratch.data) == 0 {
    core@1/list.reserve(mut scratch.data, 32768)
  }
  while core@1/list.len(scratch.data) < cells {
    core@1/list.push(mut scratch.data, 0u64)
  }
}

fn capture_plan(re: Regex) -> List[u64] uses {} {
  let m = core@1/list.len(re.code)
  let slots = core@1/list.len(re.names) * 2
  // <=133120 bytes of transitions, independent of the subject length.
  if m > 128 || slots > 32 {
    return []
  }
  for inst in re.code {
    if inst.kind == 13 {
      return []
    }
    for (_, hi) in inst.ranges {
      if hi > 127 {
        return []
      }
    }
  }
  let mut table: unique List[u64] = []
  let mut i = 0u64
  let mut roots: List[u64] = [re.entry]
  let mut built: List[bool] = []
  let mut seen: List[bool] = []
  i = 0
  while i < m {
    core@1/list.push(mut built, false)
    core@1/list.push(mut seen, false)
    i += 1
  }
  let mut pending = 0u64
  while pending < core@1/list.len(roots) {
    let root = roots[pending]
    pending += 1
    if built[root] {
      continue
    }
    built[root] = true
    i = 0
    while i < m {
      seen[i] = false
      i += 1
    }
    let mut ready: List[(u64, u64)] = []
    let mut stack: List[(u64, u64)] = [(root, 0u64)]
    while core@1/list.len(stack) != 0 {
      let Some((pc, actions)) = core@1/list.pop(mut stack) else {
        break
      }
      // Multiple epsilon paths, including cycles, are ambiguous. Reject the
      // entire plan rather than choosing a possibly different capture history.
      if seen[pc] {
        return []
      }
      seen[pc] = true
      let inst = re.code[pc]
      if dfa_consumes(inst.kind) || inst.kind == 11 {
        core@1/list.push(mut ready, (pc, actions))
      } else if inst.kind == 10 {
        core@1/list.push(mut stack, (inst.y, actions))
        core@1/list.push(mut stack, (inst.x, actions))
      } else {
        let extra = if inst.kind == 12 {
          1u64 << 10 + inst.y
        } else if inst.kind == 0 {
          0u64
        } else {
          1u64 << 42 + core@1/int.widen(inst.kind)
        }
        core@1/list.push(mut stack, (inst.x, actions | extra))
      }
    }
    // onepass.rs:630-638,903-923 rejects duplicate epsilon paths before
    // publishing transitions. Prove this closure before initializing the
    // dense table or scanning its alphabet: nullable cycles decline cheaply.
    if core@1/list.len(table) == 0 {
      i = 0
      while i < m * 130 {
        core@1/list.push(mut table, 0u64)
        i += 1
      }
    }
    for (pc, actions) in ready {
      let inst = re.code[pc]
      if dfa_consumes(inst.kind) {
        let transition = pc + 1 | actions
        let mut byte = 0u64
        while byte < 129 {
          let scalar = if byte == 128 {
            'é'
          } else {
            let Some(c) = core@1/char.from_u32(core@1/int.narrow(byte)) else {
              return []
            }
            c
          }
          let mut work = 18446744073709551615u64
          let Ok(accepted) = accepts(inst, scalar, mut work) else {
            return []
          }
          if accepted {
            let index = root * 130 + byte
            if table[index] != 0 && table[index] != transition {
              return []
            }
            table[index] = transition
          }
          byte += 1
        }
        if !built[inst.x] {
          core@1/list.push(mut roots, inst.x)
        }
      } else if inst.kind == 11 {
        if table[root * 130 + 129] != 0 {
          return []
        }
        table[root * 130 + 129] = actions | 1
      }
    }
  }
  take table
}

fn capture_actions(
  re: Regex,
  subject: Subject,
  cursor: u64,
  action: u64,
  mut scratch: CaptureScratch
) -> () uses {} {
  let left = if cursor == 0 {
    0u64
  } else {
    dfa_category(dfa_byte(subject, subject_before(subject, cursor)))
  }
  let right = dfa_category(dfa_byte(subject, cursor))
  for kind in [3u8, 4u8, 5u8, 6u8, 15u8, 16u8] {
    if action & 1u64 << 42 + core@1/int.widen(kind) != 0 {
      core@1/failure.check(dfa_allowed(kind, left, right), Bounds())
    }
  }
  let mut bits = action >> 10 & 4294967295u64
  let mut slot = 0u64
  while bits != 0 {
    if bits & 1 != 0 {
      scratch.data[slot] = cursor + 1
    }
    slot += 1
    bits >>= 1
  }
}

fn capture_result(re: Regex, span: Span, scratch: CaptureScratch) -> Captures uses {} {
  let mut spans: List[Option[Span]] = [Some(span)]
  let mut slot = 2u64
  while slot < core@1/list.len(re.names) * 2 {
    let a = scratch.data[slot]
    let b = scratch.data[slot + 1]
    core@1/list.push(
      mut spans,
      if a != 0 && b != 0 {
        Some(Span(start: a - 1, end: b - 1))
      } else {
        None()
      }
    )
    slot += 2
  }
  Captures(spans: take spans)
}

fn capture_onepass(re: Regex, subject: Subject, span: Span, mut scratch: CaptureScratch) -> Captures uses {} {
  let slots = core@1/list.len(re.names) * 2
  capture_ensure(mut scratch, slots)
  for slot in 0u64..slots {
    scratch.data[slot] = 0
  }
  let mut cursor = capture_scalar(subject, span.start)
  let end = capture_scalar(subject, span.end)
  let mut state = re.entry
  while cursor < end {
    let cp = core@1/char.to_u32(subject_scalar(subject, cursor))
    let byte: u64 = if cp < 128 {
      core@1/int.widen(cp)
    } else {
      128u64
    }
    let transition = scratch.plan[state * 130 + byte]
    core@1/failure.check(transition != 0, Bounds())
    capture_actions(re, subject, cursor, transition, mut scratch)
    state = re.code[(transition & 1023) - 1].x
    cursor = subject_next(subject, cursor)
  }
  let accept = scratch.plan[state * 130 + 129]
  core@1/failure.check(accept != 0, Bounds())
  capture_actions(re, subject, cursor, accept, mut scratch)
  capture_result(re, span, scratch)
}

// Bounded DFS uses one mutable capture row plus RestoreCapture frames. Every
// (PC, byte position) is visited once. A split/capture can push at most one
// frame per newly visited pair, so <=pairs+1 frames suffice, including empty
// matches. 8192 pairs + slots + bitset + two-cell frames fit the same 256 KiB
// scratch slab as PikeVM. Arithmetic is checked before multiplying.
fn capture_backtrack_fits(re: Regex, length: u64) -> bool uses {} {
  let m = core@1/list.len(re.code)
  m != 0 && m <= 512 && length < 8192 && m <= 8192 / (length + 1)
}

// The bounded NFA's transitions are decoded once per scan, like upstream's
// ByteRange/Sparse/Dense states (backtrack.rs:1495-1524), not copied with their
// range lists on every Step. The original states remain the Unicode fallback.
// Three numeric cells per state: kind/x/y and two exact ASCII acceptance masks.
// m <= 512 bounds both PCs and capture slot numbers to nine bits. At most
// 12288 payload bytes, separate from the existing 256 KiB capture scratch slab.
fn capture_backtrack_code(re: Regex) -> List[u64] uses {} {
  let mut code: unique List[u64] = []
  for inst in re.code {
    core@1/list.push(mut code, core@1/int.widen(inst.kind) | inst.x << 5 | inst.y << 14)
    for half in 0u64..2 {
      let mut mask = 0u64
      if inst.kind == 2 || inst.kind == 14 {
        mask = 18446744073709551615
        if inst.kind == 2 && half == 0 {
          mask ^= 1u64 << 10
        }
      } else if inst.kind == 1 {
        for (lo, hi) in inst.ranges {
          let a: u64 = core@1/int.widen(lo)
          let b: u64 = core@1/int.widen(hi)
          let base = half * 64
          if a <= base + 63 && b >= base {
            let first = if a > base {
              a - base
            } else {
              0u64
            }
            let last = if b < base + 63 {
              b - base
            } else {
              63u64
            }
            mask |= 18446744073709551615u64 >> 63 - (last - first) << first
          }
        }
        if inst.negated {
          mask ^= 18446744073709551615
        }
      } else if inst.kind == 13 {
        for bit in 0u64..64 {
          let Some(c) = core@1/char.from_u32(core@1/int.narrow(half * 64 + bit)) else {
            core@1/failure.check(false, Bounds())
            return []
          }
          let mut work = 18446744073709551615u64
          let Ok(accepted) = accepts(inst, c, mut work) else {
            core@1/failure.check(false, Bounds())
            return []
          }
          if accepted {
            mask |= 1u64 << bit
          }
        }
      }
      core@1/list.push(mut code, mask)
    }
  }
  take code
}

fn capture_backtrack(
  re: Regex,
  subject: Subject,
  span: Span,
  mut scratch: CaptureScratch
) -> Captures uses {} {
  let start = capture_scalar(subject, span.start)
  let end = capture_scalar(subject, span.end)
  let length = end - start
  core@1/failure.check(capture_backtrack_fits(re, length), Bounds())
  if core@1/list.len(scratch.backtrack_code) == 0 {
    scratch.backtrack_code = capture_backtrack_code(re)
  }
  let m = core@1/list.len(re.code)
  let slots = core@1/list.len(re.names) * 2
  let pairs = m * (length + 1)
  let words = (pairs + 63) / 64
  let stack = slots + words
  capture_ensure(mut scratch, stack + 2 * (pairs + 1))
  for cell in 0u64..stack {
    scratch.data[cell] = 0
  }
  let mut depth = 1u64
  scratch.data[stack] = re.entry
  scratch.data[stack + 1] = start
  while depth != 0 {
    depth -= 1
    let mut pc = scratch.data[stack + 2 * depth]
    let mut cursor = scratch.data[stack + 2 * depth + 1]
    if pc >= m {
      scratch.data[pc - m] = cursor
      continue
    }
    while true {
      let pair = (cursor - start) * m + pc
      let cell = slots + pair / 64
      let bit = 1u64 << pair % 64
      if scratch.data[cell] & bit != 0 {
        break
      }
      scratch.data[cell] |= bit
      let inst = scratch.backtrack_code[3 * pc]
      let kind: u8 = core@1/int.narrow(inst & 31)
      if kind == 11 {
        if cursor == end {
          return capture_result(re, span, scratch)
        }
        break
      }
      if dfa_consumes(kind) {
        if cursor == end {
          break
        }
        let scalar = subject_scalar(subject, cursor)
        let cp: u64 = core@1/int.widen(core@1/char.to_u32(scalar))
        let accepted = if cp < 128 {
          scratch.backtrack_code[3 * pc + 1 + cp / 64] & 1u64 << cp % 64 != 0
        } else {
          let mut work = 18446744073709551615u64
          let Ok(value) = accepts(re.code[pc], scalar, mut work) else {
            core@1/failure.check(false, Bounds())
            break
          }
          value
        }
        if !accepted {
          break
        }
        cursor = subject_next(subject, cursor)
      } else if kind == 10 || kind == 12 {
        if kind == 10 {
          scratch.data[stack + 2 * depth] = inst >> 14 & 511
          scratch.data[stack + 2 * depth + 1] = cursor
        } else {
          scratch.data[stack + 2 * depth] = m + (inst >> 14 & 511)
          scratch.data[stack + 2 * depth + 1] = scratch.data[inst >> 14 & 511]
          scratch.data[inst >> 14 & 511] = cursor + 1
        }
        depth += 1
      } else {
        let left = if cursor == 0 {
          0u64
        } else {
          dfa_category(dfa_byte(subject, subject_before(subject, cursor)))
        }
        let right = dfa_category(dfa_byte(subject, cursor))
        if !dfa_allowed(kind, left, right) {
          break
        }
      }
      pc = inst >> 5 & 511
    }
  }
  core@1/failure.check(false, Bounds())
  Captures(spans: [])
}

fn capture_replay(re: Regex, subject: Subject, span: Span, mut scratch: CaptureScratch) -> Captures uses {} {
  if core@1/list.len(re.fixed_captures) != 0 {
    return fixed_capture_result(re, subject, span)
  }
  if !scratch.prepared {
    scratch.plan = capture_plan(re)
    scratch.prepared = true
  }
  if core@1/list.len(scratch.plan) != 0 {
    return capture_onepass(re, subject, span, mut scratch)
  }
  // Use byte positions for the visited budget; UTF-8 continuation cells remain unused.
  let start = capture_scalar(subject, span.start)
  let end = capture_scalar(subject, span.end)
  if capture_backtrack_fits(re, end - start) {
    return capture_backtrack(re, subject, span, mut scratch)
  }
  capture_pike(re, subject, span, mut scratch)
}

fn capture_find_from(
  re: Regex,
  subject: Subject,
  start: u64,
  admitted: bool,
  haystack: Bytes,
  mut cache: DfaCache,
  mut scratch: CaptureScratch,
  mut work: u64
) -> Result[(Option[Span], Captures), MatchError] uses {} {
  if admitted && !cache.disabled && capture_layout(re) != 0 {
    match dfa_search(re, subject, start, haystack, mut cache) {
      DfaMatch(span) => return Ok(
        (Some(span), capture_replay(re, subject, span, mut scratch))
      ),
      DfaMiss() => return Ok((None(), Captures(spans: []))),
      DfaQuit() => {
        cache.disabled = true
        cache.fallbacks += 1
      },
    }
  }
  find_from_prefilter(re, subject, start, true, admitted, haystack, mut work)
}

// Deferred matching debt for replacement. While work >= bound, ALL skipped
// pure matching (including failed starts, captures and final miss) is affordable.
// work debits output and progression exactly. Before an uncertain output charge
// or callback, replay only pending original searches, without consumer effects.
// A single resolution permanently disables acceleration. Never replay callbacks.
fn replacement_resolve(
  re: Regex,
  subject: Subject,
  count: u64,
  capture: bool,
  mut work: u64
) -> Result[(), MatchError] uses {} {
  let mut pos = 0u64
  let mut i = 0u64
  while i < count {
    let (matched, _) = pike_find_from(re, subject, pos, capture, mut work)?
    let Some(span) = matched else {
      break
    }
    if pos < subject_len(subject) && subject_next(subject, pos) > span.end {
      pos = subject_next(subject, pos)
    } else if span.end == pos {
      pos = subject_next(subject, pos)
    } else {
      while pos < span.end {
        pos = subject_next(subject, pos)
      }
    }
    i += 1
  }
  Ok(())
}

fn replacement_afford(
  re: Regex,
  subject: Subject,
  capture: bool,
  charge: u64,
  pending: u64,
  mut bound: u64,
  mut work: u64
) -> Result[(), MatchError] uses {} {
  if bound != 0 && bound != 18446744073709551615 && (bound > work || charge > work - bound) {
    replacement_resolve(re, subject, pending, capture, mut work)?
    bound = 0
  }
  Ok(())
}

fn replace[T](
  re: Regex,
  src: String,
  replacement: String,
  mode: u8,
  state: T,
  callback: fn(T, String, Captures) -> String uses {},
  work_limit: u64
) -> Result[String, MatchError] uses {} {
  // Tiny/uncertain operations use the unchanged loop before cache preparation.
  if core@1/bytes.len(core@1/string.as_bytes(src)) >= 64 && re.prefilter.enabled {
    let bound = prefix_work_bound(re, src, mode != 1, work_limit)
    if bound != 0 && (mode == 1 || capture_layout(re) != 0) {
      return replace_accelerated(
        re,
        src,
        replacement,
        mode,
        state,
        callback,
        work_limit,
        bound
      )
    }
  }
  replace_pike(re, src, replacement, mode, state, callback, work_limit)
}

fn replace_accelerated[T](
  re: Regex,
  src: String,
  replacement: String,
  mode: u8,
  state: T,
  callback: fn(T, String, Captures) -> String uses {},
  work_limit: u64,
  initial_bound: u64
) -> Result[String, MatchError] uses {} {
  let mut work = work_limit
  let source_input = make_subject(src, mut work)?
  let data = core@1/string.as_bytes(src)
  let mut dst: List[u8] = []
  let mut bound = initial_bound
  let mut pending = 0u64
  let mut cache = dfa_cache(re, true, 65024)
  let mut scratch = capture_scratch()
  let mut pos = 0u64
  let mut last_end = 0u64
  while pos <= subject_len(source_input) {
    replacement_afford(re, source_input, mode != 1, 0, pending, mut bound, mut work)?
    let search_outcome = if bound != 0 && !cache.disabled {
      dfa_search(re, source_input, pos, data, mut cache)
    } else {
      DfaQuit()
    }
    let (matched, captures) = match search_outcome {
      DfaMatch(span) => {
        pending += 1
        (
          Some(span),
          if mode == 1 {
            Captures(spans: [])
          } else {
            capture_replay(re, source_input, span, mut scratch)
          }
        )
      },
      DfaMiss() => {
        pending += 1
        (None(), Captures(spans: []))
      },
      DfaQuit() => {
        if bound != 0 && bound != 18446744073709551615 {
          replacement_resolve(re, source_input, pending, mode != 1, mut work)?
        }
        bound = 0
        pike_find_from(re, source_input, pos, mode != 1, mut work)?
      },
    }
    let Some(span) = matched else {
      break
    }
    replacement_afford(
      re,
      source_input,
      mode != 1,
      span.start - last_end,
      pending,
      mut bound,
      mut work
    )?
    append_bytes(mut dst, data, last_end, span.start, mut work)?
    if span.end > last_end || span.start == 0 {
      if mode == 2 {
        let value = callback(state, src, captures)
        let bytes = core@1/string.as_bytes(value)
        replacement_afford(
          re,
          source_input,
          mode != 1,
          core@1/bytes.len(bytes),
          pending,
          mut bound,
          mut work
        )?
        append_bytes(mut dst, bytes, 0, core@1/bytes.len(bytes), mut work)?
      } else if mode == 1 {
        let bytes = core@1/string.as_bytes(replacement)
        replacement_afford(
          re,
          source_input,
          mode != 1,
          core@1/bytes.len(bytes),
          pending,
          mut bound,
          mut work
        )?
        append_bytes(mut dst, bytes, 0, core@1/bytes.len(bytes), mut work)?
      } else {
        if bound != 0 && bound != 18446744073709551615 {
          replacement_resolve(re, source_input, pending, true, mut work)?
          bound = 0
        }
        expand_into(re, mut dst, replacement, src, captures, mut work)?
      }
    }
    last_end = span.end
    // Go replaceAll advances at least one scalar from the search position.
    replacement_afford(re, source_input, mode != 1, 1, pending, mut bound, mut work)?
    spend(mut work)?
    if pos < subject_len(source_input) && subject_next(source_input, pos) > span.end {
      pos = subject_next(source_input, pos)
    } else if span.end == pos {
      pos = subject_next(source_input, pos)
    } else {
      while pos < span.end {
        replacement_afford(re, source_input, mode != 1, 1, pending, mut bound, mut work)?
        spend(mut work)?
        pos = subject_next(source_input, pos)
      }
    }
  }
  replacement_afford(
    re,
    source_input,
    mode != 1,
    core@1/bytes.len(data) - last_end,
    pending,
    mut bound,
    mut work
  )?
  append_bytes(mut dst, data, last_end, core@1/bytes.len(data), mut work)?
  Ok(text.finish_valid(take dst))
}
