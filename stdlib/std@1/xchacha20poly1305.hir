// XChaCha20-Poly1305 (draft-irtf-cfrg-xchacha-03): ChaCha20-Poly1305 under the
// HChaCha20 subkey of the key and the nonce's first 16 bytes, with a 12-byte
// nonce of four zero bytes and the last 8. A 24-byte nonce is safe to choose at random.
fn subkey(key: Bytes, nonce: Bytes) -> (Bytes, Bytes) uses {} {
  internal.chacha_poly.check_sizes(key, nonce, 24)
  let mut short: List[u8] = [0, 0, 0, 0]
  let mut i: u64 = 16
  while i < 24 {
    core@1/list.push(mut short, nonce[i])
    i += 1
  }
  (
    internal.chacha_poly.hchacha20(key, core@1/bytes.slice(nonce, 0, 16)),
    core@1/bytes.from_list(take short)
  )
}

pub fn seal(key: Bytes, nonce: Bytes, plaintext: Bytes, data: Bytes) -> unique Bytes uses {} {
  let (sub, short) = subkey(key, nonce)
  internal.chacha_poly.seal(sub, short, plaintext, data)
}

pub fn open(key: Bytes, nonce: Bytes, sealed: Bytes, data: Bytes) -> Result[
  unique Bytes,
  std@1/aead.OpenError
] uses {} {
  let (sub, short) = subkey(key, nonce)
  internal.chacha_poly.open(sub, short, sealed, data)
}
