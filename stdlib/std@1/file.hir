// Adapted from Zig Io.Dir.createDirPath and Rust fs::create_dir_all
// (MIT option; third-party/NOTICES.md). All mutations use the supplied Dir.
pub fn mkdir_all(d: Dir, p: Path) -> Result[(), FileError] {
  let Ok(normalized) = path.normalize(p) else {
    return core@1/file.mkdir(d, p)
  }
  let value = core@1/path.text(normalized)
  if string.starts_with(value, "/") {
    return core@1/file.mkdir(d, p)
  }
  let parts = path.components(normalized)
  for part in parts {
    if part == ".." {
      return core@1/file.mkdir(d, p)
    }
  }
  if value == "." {
    let _ = core@1/dir.narrow(d, normalized)?
    return Ok(())
  }
  let mut prefix = ""
  for part in parts {
    prefix = if prefix == "" {
      copy part
    } else {
      string.join([prefix, part], "/")
    }
    let current = core@1/path.of(prefix)
    match core@1/file.mkdir(d, current) {
      Ok(()) => (),
      Error(AlreadyExists()) => {
        let _ = core@1/dir.narrow(d, current)?
      },
      Error(e) => return Error(take e),
    }
  }
  Ok(())
}

// Bounded streaming copy, with replacement published only after the final read.
// Acquiring the temporary first checks write authority before reading the source.
pub fn copy_file(d: Dir, from: Path, to: Path) -> Result[(), FileError] {
  let mut destination = core@1/file.create_atomic(d, to)?
  let mut source = core@1/file.open(d, from)?
  while true {
    let mut buffer: List[u8] = []
    let count = core@1/file.read(d, mut source, mut buffer, 8192)?
    if count == 0 {
      break
    }
    let chunk = core@1/bytes.from_list(take buffer)
    core@1/file.write_all(d, mut destination, chunk)?
  }
  core@1/file.commit(d, take destination)
}

// Zig Io.Dir.Walker's explicit depth-first stack, over confined sorted lists.
// Only Directory entries are descended; symlinks remain entries in the result.
pub fn list_recursive(d: Dir, p: Path) -> Result[unique List[DirEntry], FileError] {
  let meta = core@1/file.metadata(d, p)?
  match meta.kind {
    Directory() => (),
    _ => return Error(NotDirectory()),
  }
  let mut pending: List[DirEntry] = []
  let initial = core@1/file.read_dir(d, p)?
  let mut i = core@1/list.len(initial)
  while i > 0 {
    i -= 1
    core@1/list.push(mut pending, copy initial[i])
  }
  let mut out: List[DirEntry] = []
  while core@1/list.len(pending) > 0 {
    let entry = match core@1/list.pop(mut pending) {
      Some(value) => take value,
      None() => break,
    }
    core@1/list.push(mut out, copy entry)
    match entry.kind {
      Directory() => {
        let children = core@1/file.read_dir(d, entry.path)?
        let mut j = core@1/list.len(children)
        while j > 0 {
          j -= 1
          core@1/list.push(mut pending, copy children[j])
        }
      },
      _ => (),
    }
  }
  Ok(take out)
}

// Go ebe2feef src/io/io.go:458-481 LimitedReader caps each request;
// :709-740 ReadAll accumulates until EOF (BSD-3-Clause (Go),
// third-party/NOTICES.md). Hirsel's amortized List append replaces Go's chunk
// list; errors discard data and a separate probe rejects silent truncation.
@serializable
pub type ReadBoundedError = Limit | File(FileError)

/// Reads from the current cursor, leaving the caller's file open and unseeked.
pub fn read_all_bounded(d: Dir, mut f: File of d, limit: u64) -> Result[
  unique Bytes,
  ReadBoundedError
] {
  let mut buffer: List[u8] = []
  let mut remaining = limit
  while remaining != 0 {
    let requested = if remaining < 4096 {
      remaining
    } else {
      4096
    }
    let count = core@1/file.read(d, mut f, mut buffer, requested) ? File
    if count == 0 {
      return Ok(core@1/bytes.from_list(take buffer))
    }
    remaining -= count
  }
  let mut probe: List[u8] = []
  if core@1/file.read(d, mut f, mut probe, 1) ? File != 0 {
    return Error(Limit())
  }
  Ok(core@1/bytes.from_list(take buffer))
}
