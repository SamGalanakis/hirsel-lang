// AWS SigV4 published test suite, verbatim expected canonical request and signature.
pub fn main(t: Test) -> Result[(), s3.S3Error] {
  let credentials = s3.Credentials(
    access_key: "AKIDEXAMPLE",
    secret_key: b"wJalrXUtnFEMI/K7MDENG+bPxRfiCYEXAMPLEKEY",
    session_token: None()
  )
  let signed4 = s3.sign(
    credentials,
    "us-east-1",
    "service",
    "GET",
    "/",
    "Param1=value1&Param2=value2",
    [
      http.Header(name: "Host", value: "example.amazonaws.com"),
      http.Header(name: "X-Amz-Date", value: "20150830T123600Z")
    ],
    b"",
    "20150830T123600Z"
  )?
  test.check(
    t,
    signed4.canonical == "GET\n/\nParam1=value1&Param2=value2\nhost:example.amazonaws.com\nx-amz-date:20150830T123600Z\n\nhost;x-amz-date\ne3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
  )
  test.check(
    t,
    signed4.authorization == "AWS4-HMAC-SHA256 Credential=AKIDEXAMPLE/20150830/us-east-1/service/aws4_request, SignedHeaders=host;x-amz-date, Signature=b97d918cfa904a5beff61c982a1b6f458b799221646efd99d3219ec94cdf2500"
  )
  Ok(())
}
