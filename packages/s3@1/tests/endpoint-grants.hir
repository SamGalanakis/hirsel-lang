fn make(n: Net, clock: WallClock, endpoint: String) -> Result[s3.Client, s3.S3Error] {
  s3.client(
    n,
    clock,
    s3.Config(
      endpoint: unique endpoint,
      bucket: "bucket",
      region: "us-east-1",
      prefix: "root",
      cache_bytes: 0,
      max_object_bytes: 1024
    ),
    s3.Credentials(access_key: "fixture", secret_key: b"fixture", session_token: None())
  )
}

pub fn main(io: Io) -> Result[(), s3.S3Error] {
  let Ok(n) = io.net(io) else {
    return Error(Grant())
  }
  let Ok(clock) = io.wall_clock(io) else {
    return Error(Grant())
  }
  // DNS case/trailing dot, IPv6 brackets and scheme default ports match HTTP.
  let plain = make(n, clock, "http://EXAMPLE.COM.")?
  failure.check(
    match net.narrow(
      plain.network,
      [NetRule(address: "example.com", port: 443, operation: Connect())]
    ) {
      Error(NotGranted()) => true,
      _ => false,
    },
    Arithmetic()
  )
  let secure = make(n, clock, "https://example.com")?
  failure.check(
    match net.narrow(
      secure.network,
      [NetRule(address: "example.com", port: 443, operation: Connect())]
    ) {
      Error(NotGranted()) => true,
      _ => false,
    },
    Arithmetic()
  )
  failure.check(
    match net.narrow(
      secure.network,
      [NetRule(address: "example.com", port: 80, operation: Connect())]
    ) {
      Error(NotGranted()) => true,
      _ => false,
    },
    Arithmetic()
  )
  make(n, clock, "https://example.com:8443")?
  make(n, clock, "http://[::1]:9000")?
  failure.check(
    match make(n, clock, "http://example.com:81") {
      Error(Grant()) => true,
      _ => false,
    },
    Arithmetic()
  )
  failure.check(
    match make(n, clock, "http://other.example") {
      Error(Grant()) => true,
      _ => false,
    },
    Arithmetic()
  )
  failure.check(
    match make(n, clock, "http://example.com:8443") {
      Error(Grant()) => true,
      _ => false,
    },
    Arithmetic()
  )
  Ok(())
}
