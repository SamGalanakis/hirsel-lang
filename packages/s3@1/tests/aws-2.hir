// AWS SigV4 published test suite, verbatim expected canonical request and signature.
pub fn main(t: Test) -> Result[(), s3.S3Error] {
  let credentials = s3.Credentials(
    access_key: "AKIDEXAMPLE",
    secret_key: b"wJalrXUtnFEMI/K7MDENG+bPxRfiCYEXAMPLEKEY",
    session_token: None()
  )
  let signed2 = s3.sign(
    credentials,
    "us-east-1",
    "service",
    "GET",
    "/",
    "",
    [
      http.Header(name: "Host", value: "example.amazonaws.com"),
      http.Header(name: "My-Header1", value: "value2"),
      http.Header(name: "My-Header1", value: "value2"),
      http.Header(name: "My-Header1", value: "value1"),
      http.Header(name: "X-Amz-Date", value: "20150830T123600Z")
    ],
    b"",
    "20150830T123600Z"
  )?
  test.check(
    t,
    signed2.canonical == "GET\n/\n\nhost:example.amazonaws.com\nmy-header1:value2,value2,value1\nx-amz-date:20150830T123600Z\n\nhost;my-header1;x-amz-date\ne3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
  )
  test.check(
    t,
    signed2.authorization == "AWS4-HMAC-SHA256 Credential=AKIDEXAMPLE/20150830/us-east-1/service/aws4_request, SignedHeaders=host;my-header1;x-amz-date, Signature=c9d5ea9f3f72853aea855b47ea873832890dbdd183b4468f858259531a5138ea"
  )
  Ok(())
}
