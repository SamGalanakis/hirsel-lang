// Denied operations must not read the clock or reach a network provider.
fn make(n: Net, clock: WallClock, endpoint: String) -> Result[s3.Client, s3.S3Error] {
  s3.client(
    n,
    clock,
    s3.Config(
      endpoint: unique endpoint,
      bucket: "bucket",
      region: "us-east-1",
      prefix: "root",
      cache_bytes: 0,
      max_object_bytes: 1024
    ),
    s3.Credentials(access_key: "fixture", secret_key: b"fixture", session_token: None())
  )
}

pub fn main(io: Io) -> Result[(), s3.S3Error] {
  let Ok(n) = io.net(io) else {
    return Error(Grant())
  }
  let Ok(clock) = io.wall_clock(io) else {
    return Error(Grant())
  }
  let c = make(n, clock, "http://example.com")?
  let mut ro = s3.read_only(c)
  failure.check(
    s3.put(mut ro, "safe/key", b"v", Create()) == Error(Denied()),
    Arithmetic()
  )
  failure.check(s3.delete(mut ro, "safe/key") == Error(Denied()), Arithmetic())
  let mut limited = s3.narrow_prefix(c, "safe/")
  failure.check(s3.get(mut limited, "other/key") == Error(Denied()), Arithmetic())
  failure.check(
    s3.get_range(mut limited, "safe-neighbor/key", 0, 1) == Error(Denied()),
    Arithmetic()
  )
  failure.check(
    s3.get_range(mut limited, "other/key", 0, 0) == Error(Denied()),
    Arithmetic()
  )
  failure.check(
    s3.put(mut limited, "other/key", b"v", Create()) == Error(Denied()),
    Arithmetic()
  )
  failure.check(s3.delete(mut limited, "other/key") == Error(Denied()), Arithmetic())
  failure.check(s3.list_objects(mut limited, "") == Error(Denied()), Arithmetic())
  failure.check(s3.list_objects(mut limited, "other/") == Error(Denied()), Arithmetic())
  let mut combined = s3.narrow_prefix(ro, "safe/")
  failure.check(
    s3.put(mut combined, "safe/key", b"v", Create()) == Error(Denied()),
    Arithmetic()
  )
  let mut nested = s3.narrow_prefix(s3.narrow_prefix(limited, "safe/deeper/"), "")
  failure.check(s3.get(mut nested, "safe/key") == Error(Denied()), Arithmetic())
  let mut disjoint = s3.narrow_prefix(limited, "other/")
  failure.check(s3.get(mut disjoint, "other/key") == Error(Denied()), Arithmetic())
  failure.check(s3.get(mut disjoint, "safe/key") == Error(Denied()), Arithmetic())
  Ok(())
}
