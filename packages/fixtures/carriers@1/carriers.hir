/// An owned cursor whose authority is its inner iterator's (CAP-2, CLO-4).
@captures(inner)
pub opaque type Pipe[T]: () uses {} {
  inner: Iter[T],
}

@captures(carrier)
pub fn wrap[T](take carrier: Iter[T]) -> Pipe[T] uses {carrier} {
  Pipe(inner: take carrier)
}

@captures(carrier, f)
pub fn map[T, U](take carrier: Pipe[T], take f: fn(T) -> U) -> Pipe[U] uses {carrier, f} {
  let Pipe(inner: inner) = take carrier
  Pipe(inner: iter.map(take inner, take f))
}

@advance_only(carrier)
pub fn next[T](mut carrier: Pipe[T]) -> Option[T] uses {carrier} {
  iter.next(mut carrier.inner)
}

@captures(carrier)
pub fn unwrap[T](take carrier: Pipe[T]) -> Iter[T] uses {carrier} {
  let Pipe(inner: inner) = take carrier
  inner
}

/// A key-value store as a record of callbacks; each value carries the
/// authority its callbacks capture.
@captures(get, put)
pub opaque type Store: () uses {} {
  get: fn(key: u64) -> Option[u64],
  put: fn(key: u64, value: u64) -> (),
}

@captures(read, write)
pub fn store(
  take read: fn(key: u64) -> Option[u64],
  take write: fn(key: u64, value: u64) -> ()
) -> Store uses {read, write} {
  Store(get: take read, put: take write)
}

pub fn get(s: Store, key: u64) -> Option[u64] uses {s} {
  s.get(key)
}

pub fn put(s: Store, key: u64, value: u64) -> () uses {s} {
  s.put(key, value)
}
