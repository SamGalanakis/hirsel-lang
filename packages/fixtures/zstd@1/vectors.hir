// tests/golden-decompression/block-128k.zst; SHA-256 6a226ab40e6abcfc4a36baa04bf48f7ee56f166b8a26fbe2adb8fe771dceccba
pub fn golden_block_128k() -> unique Bytes uses {} {
  let mut out: List[u8] = []
  for byte in b"(\xb5/\xfd\x008\x05\x00\x10\xcc\xff\x1f" {
    list.push(mut out, byte)
  }
  {
    let mut i: u64 = 0
    while i < 131069 {
      list.push(mut out, 0u8)
      i += 1
    }
  }
  bytes.from_list(take out)
}

