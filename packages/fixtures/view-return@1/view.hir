@loop_source(open, next)
pub opaque type View: copyable + inert + noalloc_drop uses {} {
  source: String,
}

pub opaque type Cursor: copyable + inert + noalloc_drop uses {} {
  source: String,
  position: u64,
}

@noalloc
pub fn view(s: String) -> View in s uses {} {
  View(source: copy s)
}

@noalloc
fn open(v: View) -> Cursor in v uses {} {
  Cursor(source: copy v.source, position: 0)
}

@noalloc
fn next(mut it: Cursor) -> Option[String] in it uses {} {
  if it.position == 0 {
    it.position = 1
    Some(copy it.source)
  } else {
    None
  }
}
