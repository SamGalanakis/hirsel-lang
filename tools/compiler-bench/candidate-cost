#!/usr/bin/env python3
"""Bounded ten-round library-host measurements; child protocol is test-only.
Borrow CPU lease and perf process accounting from compiler-bench/resident.
"""
import argparse, contextlib, hashlib, json, os, pathlib, random, shutil, subprocess, sys, time
import resource
P = pathlib.Path
ROOT = P(__file__).resolve().parents[2]
sys.path.insert(0, str(ROOT / 'bench/micro'))
from measure import timing_lock

def dump(path, value):
    path.write_text(json.dumps(value, indent=2) + '\n')

def copy_fixture(source, target):
    target.mkdir(parents=True, exist_ok=True)
    data = json.loads(source.read_text())
    for d in data.get('dependencies', []):
        d['manifest'] = str((source.parent / d['manifest']).resolve())
    for row in data['sources']:
        dst = target / row['path']
        dst.parent.mkdir(parents=True, exist_ok=True)
        shutil.copyfile(source.parent / row['path'], dst)
    entry = target / 'hirsel.json'
    dump(entry, data)
    return (entry, [target / s['path'] for s in data['sources']])

def prepare(work, image):
    """Independently materialize each accepted class and every cold candidate."""
    specs = []
    for fixture in ['small', 'tasks']:
        for category in ['body', 'private-view', 'generator']:
            base = work / fixture / (category + '-base')
            if fixture == 'small':
                base.mkdir(parents=True, exist_ok=True)
                entry = source = base / 'main.hir'
                source.write_text('fn helper(x:u64)->u64{x + 1}\npub fn main()->u64{helper(4)}\n')
            else:
                entry, _ = copy_fixture(ROOT / 'examples/tasks/hirsel.json', base)
                source = base / 'main.hir'
            original = source.read_text() + '\nfn candidate_cost_probe()->u64{0}\n'
            if category == 'private-view':
                original += 'pub opaque type CandidateCostSecret: data uses {} { level:u64, }\nfn candidate_cost_view(x:CandidateCostSecret)->u64{x.level}\n'
            elif category == 'generator':
                original += 'fn candidate_cost_source()->String{"fn(x: u64) -> u64 uses {} { x + 1 }"}\nfn candidate_cost_body()->Result[Body[fn(u64)->u64 uses {}],String]{Ok(codegen.body(candidate_cost_source()))}\nfn candidate_cost_generated(x:u64)->u64 uses {} = comptime candidate_cost_body()\n'
            source.write_text(original)
            for duplicate in [False, True]:
                label = category + ('-duplicates' if duplicate else '-distinct')
                directory = work / fixture / label
                directory.mkdir(parents=True, exist_ok=True)
                values = [1 if duplicate else i + 1 for i in range(8)]
                if category == 'body':
                    variants = [original.replace('candidate_cost_probe()->u64{0}', f'candidate_cost_probe()->u64{{{i}}}') for i in values]
                elif category == 'private-view':
                    variants = [original.replace('level:u64,', f'level:u64, extra{i}:u64,') for i in values]
                else:
                    variants = [original.replace('x + 1 }', f'x + {i + 1} }}') for i in values]
                trees = []
                for i, text in enumerate(variants):
                    tree = directory / f'cold-{i}'
                    if fixture == 'small':
                        tree.mkdir(exist_ok=True)
                        cold = tree / 'main.hir'
                        cold.write_text(text)
                    else:
                        cold, _ = copy_fixture(ROOT / 'examples/tasks/hirsel.json', tree)
                        (tree / 'main.hir').write_text(text)
                    trees.append(str(cold))
                spec = directory / 'spec.json'
                dump(spec, dict(entry=str(entry), source=str(source), variants=variants, trees=trees, images=[str(image)] if image else []))
                specs.append(spec)
    return specs

def cell(args):
    env = os.environ | {'HIRSEL_RESULTS': 'none@1', 'HIRSEL_OBJECTS': 'none@1', 'HIRSEL_DAEMON': 'off'}
    if args.image:
        env['HIRSEL_IMAGE'] = str(args.image)
    spec_value = json.loads(args.spec.read_text())
    spec_value['store'] = str(args.out.with_suffix('.store'))
    if args.out.name.startswith('preflight-'):
        spec_value['artifacts'] = str(args.out.with_suffix('.artifacts'))
    cell_spec = args.out.with_suffix('.spec.json')
    dump(cell_spec, spec_value)
    start = time.monotonic_ns()
    p = subprocess.Popen(['taskset', '-c', '31', str(args.exe), args.mode, str(cell_spec)], stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=open(args.out.with_suffix('.stderr'), 'wb'), env=env, text=True, bufsize=1)
    first = p.stdout.readline()
    if not first:
        raise RuntimeError(args.out.with_suffix('.stderr').read_text())
    ready = json.loads(first)
    assert ready.get('ready'), ready
    assert ready['store'] == ('dir@1' if args.mode == 'disk' else 'none@1' if args.mode == 'cold' else 'mem@1'), ready
    assert ready['retention'] == ('Resident' if args.mode == 'resident' else 'Batch'), ready
    sent = []
    for i in range(8):
        sent.append(time.monotonic_ns())
        p.stdin.write(str(i) + '\n')
        p.stdin.flush()
    p.stdin.close()
    rows = []
    for i in range(8):
        line = p.stdout.readline()
        if not line:
            raise RuntimeError(args.out.with_suffix('.stderr').read_text())
        row = json.loads(line)
        if row.get('refused'):
            dump(args.out, dict(mode=args.mode, spec=str(args.spec), ready=ready, rows=rows, refusal=row, submitted=8, completed=len(rows), refused=1, undriven=7 - i))
            raise RuntimeError(f'candidate refused: {row}')
        row['input_sha256'] = hashlib.sha256(spec_value['variants'][i].encode()).hexdigest()
        assert row['checked_source_sha256'] == row['input_sha256'], (args.mode, i, 'checked bytes mismatch')
        row['latency_ns'] = time.monotonic_ns() - sent[i]
        rows.append(row)
    counters = json.loads(p.stdout.readline())
    assert p.wait() == 0
    counters['peak_child_rss_bytes'] = resource.getrusage(resource.RUSAGE_CHILDREN).ru_maxrss * 1024
    if args.mode == 'resident':
        assert 'loads: 1' in counters['session_stats'], counters
    if args.mode == 'disk' and 'generator-' not in str(args.spec):
        assert sum((r['adoptions'] for r in rows)) > 0, counters
    if args.mode == 'frozen':
        expected = 1 if 'duplicates' in str(args.spec) else 8
        assert counters['frozen_loads'] == expected, counters
        assert counters['completed'] == expected, counters
    dump(args.out, dict(mode=args.mode, spec=str(args.spec), ready=ready, rows=rows, counters=counters, wall_ns=time.monotonic_ns() - start, submitted=8, completed=8, cancelled=0, unique=len(set(spec_value['variants']))))

def main(args):
    assert os.environ.get('HIRSEL_MEMORY_LIMIT', '4G') == '4G', 'benchmark requires declared default 4G cap'
    assert os.environ.get('HIRSEL_JOBS', '2') == '2', 'benchmark client/server scope requires declared two-CPU quota'
    args.work.mkdir(parents=True, exist_ok=True)
    specs = prepare(args.work, args.image)
    metadata = dict(seed=62417, rounds=args.rounds, compiler_sha=subprocess.check_output(['git', 'rev-parse', 'HEAD'], cwd=ROOT, text=True).strip(), exe_sha256=hashlib.sha256(args.exe.read_bytes()).hexdigest(), image_sha256=hashlib.sha256(args.image.read_bytes()).hexdigest() if args.image else None, environment={k: os.getenv(k) for k in ['HIRSEL_MEMORY_LIMIT', 'HIRSEL_JOBS']}, kernel=os.uname().release, worker_jobs=1, memory_cap_bytes=4 << 30, server_cpu=31, client_cpu=7, source_manifest={f: hashlib.sha256((ROOT / f).read_bytes()).hexdigest() for f in subprocess.check_output(['git', 'ls-files', '--modified', '--others', '--exclude-standard'], cwd=ROOT, text=True).splitlines() if (ROOT / f).is_file()})
    dump(args.work / 'environment.json', metadata)
    preflight = []
    for spec in specs:
        with contextlib.ExitStack() as locks:
            locks.enter_context(timing_lock(7))
            locks.enter_context(timing_lock(31))
            for mode in ['cold', 'disk', 'resident', 'frozen']:
                out = args.work / f'preflight-{spec.parent.parent.name}-{spec.parent.name}-{mode}.json'
                cmd = [str(ROOT / 'tools/capped'), '--timeout', '300', 'taskset', '-c', '7', sys.executable, __file__, '--cell', '--exe', str(args.exe), '--spec', str(spec), '--mode', mode, '--out', str(out)]
                if args.image:
                    cmd += ['--image', str(args.image)]
                subprocess.run(cmd, check=True, cwd=ROOT)
                value = json.loads(out.read_text())
                preflight.append(value)
            matching = [v for v in preflight if v['spec'] == str(spec)]
            baseline = next((v for v in matching if v['mode'] == 'cold'))
            for v in matching:
                assert [(r['input_sha256'], r['digest']) for r in v['rows']] == [(r['input_sha256'], r['digest']) for r in baseline['rows']], (v['mode'], str(spec), 'preflight')
    dump(args.work / 'preflight.json', preflight)
    cells = []
    rng = random.Random(metadata['seed'])
    for round in range(args.rounds):
        groups = list(specs)
        rng.shuffle(groups)
        for spec in groups:
            modes = ['cold', 'disk', 'resident', 'frozen']
            rng.shuffle(modes)
            with contextlib.ExitStack() as locks:
                locks.enter_context(timing_lock(7))
                locks.enter_context(timing_lock(31))
                for mode in modes:
                    prefix = args.work / f'r{round}-{spec.parent.parent.name}-{spec.parent.name}-{mode}'
                    output = prefix.with_suffix('.json')
                    perf = prefix.with_suffix('.perf')
                    cmd = [str(ROOT / 'tools/capped'), '--timeout', '300', 'perf', 'stat', '-x,', '-e', 'cycles,instructions', '-o', str(perf), '--', 'taskset', '-c', '7', sys.executable, __file__, '--cell', '--exe', str(args.exe), '--spec', str(spec), '--mode', mode, '--out', str(output)]
                    if args.image:
                        cmd += ['--image', str(args.image)]
                    measured = subprocess.run(cmd, cwd=ROOT, capture_output=True, text=True)
                    prefix.with_suffix('.capped.log').write_text(measured.stdout + measured.stderr)
                    assert measured.returncode == 0, measured.stderr
                    print(measured.stderr.strip().splitlines()[-1], flush=True)
                    value = json.loads(output.read_text())
                    value['capped_log'] = str(prefix.with_suffix('.capped.log'))
                    events = {}
                    for line in perf.read_text().splitlines():
                        fields = line.split(',')
                        if len(fields) > 2 and fields[2] in ['cycles', 'instructions']:
                            events[fields[2]] = int(fields[0])
                    assert set(events) == {'cycles', 'instructions'}, perf.read_text()
                    value |= dict(round=round, perf=events)
                    cells.append(value)
                    dump(args.work / 'results.json', dict(metadata=metadata, cells=cells))
            matching = [v for v in cells if v['round'] == round and v['spec'] == str(spec)]
            baseline = next((v for v in matching if v['mode'] == 'cold'))
            for v in matching:
                assert [(r['input_sha256'], r['digest']) for r in v['rows']] == [(r['input_sha256'], r['digest']) for r in baseline['rows']], (v['mode'], str(spec))
p = argparse.ArgumentParser()
p.add_argument('--cell', action='store_true')
p.add_argument('--exe', type=P, required=True)
p.add_argument('--work', type=P)
p.add_argument('--image', type=P)
p.add_argument('--rounds', type=int, default=10)
p.add_argument('--spec', type=P)
p.add_argument('--mode')
p.add_argument('--out', type=P)
args = p.parse_args()
cell(args) if args.cell else main(args)
