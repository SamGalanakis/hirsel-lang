# Generated by tools/compiler-bench/corpus.py for a compiler benchmark pair. The
# dependency set stands in for the parts of Hirsel's std the ports use (JSON with
# derive, SHA-256, base64, CSV, NFC); it is pinned by the adjacent lockfile.
[package]
name = "@NAME@"
version = "0.1.0"
edition = "2024"
publish = false

[workspace]

[dependencies]
base64 = "=0.22.1"
csv = "=1.4.0"
serde = { version = "=1.0.228", features = ["derive"] }
serde_json = "=1.0.145"
sha2 = "=0.10.9"
unicode-normalization = "=0.1.24"

[profile.dev]
debug = 2
