#!/usr/bin/env python3
"""Count the compiler corpus, cold and unchanged warm, with Rust pairs.

    tools/compiler-bench/run --toolchain DIR --output results.json [--quick]

Every measurement takes its own tools/capped slot. Default: ten seeded,
interleaved rounds of check, debug, release and native startup, including the
3k/10k/30k scale series. --quick selects hello and csvjson, one round, with a
540-second active-work budget. Toolchain preparation and capped queue time
are outside that budget. Legacy clif/llvm-o0/llvm-o2 and edit modes remain
selectable. Cold removes only this runner's program/native caches; std's
published products and Rust dependency artifacts are retained on both sides.
"""
import argparse
from contextlib import nullcontext
import hashlib
import json
import os
import platform
import re
import random
import shutil
import statistics
import subprocess
import sys
import tempfile
import time
from pathlib import Path

HERE = Path(__file__).resolve().parent
ROOT = HERE.parents[1]
sys.path.insert(0, str(HERE))
sys.path.insert(0, str(ROOT / 'bench/native'))
import corpus  # noqa: E402
sys.path.insert(0, str(ROOT / 'bench/micro'))
from measure import cpu_snapshot, siblings, busy_share, perf_counts, perf_command, timing_lock  # noqa: E402

CAPPED = ROOT / 'tools/capped'
HIRSEL_MODES = ('check', 'debug', 'release', 'native')
RUST_MODES = ('check', 'debug', 'release')
EDITS = ('edit-body', 'edit-private-sig', 'edit-public-sig')
# The Rust mode a Hirsel mode is compared with in the scoreboard.
PAIRED = {'debug': 'debug', 'release': 'release', 'native': 'release', 'check': 'check', 'clif': 'debug', 'llvm-o0': 'debug', **{e: e for e in EDITS}}
NATIVE = ('debug', 'release', 'native', 'clif', 'llvm-o0', 'llvm-o2')
HIRSEL_CACHE = 'none retained: fresh process, std product read, query cache process-local'
RUST_COLD = 'cold: dependencies built, package artifacts and incremental state removed'
RUST_WARM = 'warm: incremental cache of the unedited program retained'
# Environment that would change what a run reads or caches.
UNSET = ('HIRSEL_PRODUCTS', 'HIRSEL_RESULTS', 'CARGO_TARGET_DIR', 'CARGO_INCREMENTAL', 'HIRSEL_NATIVE_CACHE')


def say(text):
    print(text, file=sys.stderr, flush=True)


def summary(values):
    values = [v for v in values if v is not None]
    if not values:
        return None
    median = statistics.median(values)
    return {'median': median, 'mad': statistics.median(abs(v - median) for v in values), 'n': len(values)}


def file_hash(path):
    with open(path, 'rb') as source:
        return hashlib.file_digest(source, 'sha256').hexdigest()


def git_commit():
    try:
        return subprocess.run(['git', '-C', str(ROOT), 'rev-parse', 'HEAD'], capture_output=True,
                              text=True, check=True).stdout.strip()
    except (OSError, subprocess.CalledProcessError):
        return None


def measured(command, env, timeout, cpu=31):
    """One `tools/capped` run of `command`: exit status, wall and CPU seconds
    and peak RSS (MiB) from /usr/bin/time, `cap` or `timeout` from capped's
    report, and the command's own stderr (capped's lines removed)."""
    sibling_cpus = siblings(cpu)
    with tempfile.TemporaryDirectory(prefix='compiler-sample-') as scratch:
        times, counters = Path(scratch) / 'time', Path(scratch) / 'perf'
        before_path, after_path = Path(scratch) / 'before.stat', Path(scratch) / 'after.stat'
        timed = ['/usr/bin/time', '-f', '%e %U %S %M', '-o', str(times),
                 *perf_command(command, cpu, counters, before_path, after_path)]
        started = time.monotonic()
        process = subprocess.run([str(CAPPED), '--timeout', str(timeout), *timed], env=dict(env, LC_ALL='C'),
                                 stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, text=True)
        snapshots_present = before_path.exists() and after_path.exists()
        before = cpu_snapshot(sibling_cpus, before_path) if before_path.exists() else {}
        after = cpu_snapshot(sibling_cpus, after_path) if after_path.exists() else {}
        perf_text = counters.read_text() if counters.exists() else ''
        elapsed = time.monotonic() - started
        fields = times.read_text().split() if times.exists() else []
    lines = process.stderr.splitlines()
    report = next((line for line in reversed(lines) if line.startswith('capped: peak')), '')
    stderr = ''.join(line + '\n' for line in lines if not line.startswith('capped:'))
    status = ('cap' if 'memory limit' in report else 'timeout' if 'timed out' in report
              else 'ok' if process.returncode == 0 else 'failed')
    run = {'exit': process.returncode, 'wall_s': elapsed, 'status': status,
           'sibling_before': before, 'sibling_after': after, 'sibling_busy_share': busy_share(before, after) if before and after else {}}
    if status == 'ok':
        try:
            if not snapshots_present:
                raise ValueError('perf pre/post /proc/stat snapshots missing')
            counts, running = perf_counts(perf_text)
            run.update(instructions_u=counts['instructions:u'], perf=counts, running_percent=running)
        except ValueError as error:
            run['status'] = status = 'failed'
            stderr += str(error) + '\n'
    if len(fields) >= 4:
        wall, user, system, rss = fields[-4:]
        try:
            run.update(wall_s=float(wall), cpu_s=float(user) + float(system), rss_mib=int(rss) / 1024)
        except ValueError:
            pass
    run['capped_report'] = report
    peak = re.search(r'peak ([0-9.]+) MiB', report)
    if peak:
        run['scope_peak_mib'] = float(peak[1])
    if status != 'ok':
        run['stderr'] = stderr[:1500] + ('\n...\n' + stderr[-500:] if len(stderr) > 1500 else '')
    return run, stderr


def timings(stderr: str):
    """The intervals (seconds, with `(untimed)`), phase work times (seconds,
    phases entered at least once) and counts of a `--timings=json` report: the
    last stderr line, schema 1."""
    report = None
    for line in reversed(stderr.splitlines()):
        try:
            candidate = json.loads(line)
        except ValueError:
            continue
        if isinstance(candidate, dict) and candidate.get('schema') == 1 and 'phases' in candidate:
            report = candidate
            break
    if not isinstance(report, dict) or report.get('schema') != 1:
        return None
    intervals = {i['interval']: i['wall_ns'] / 1e9 for i in report['intervals']}
    intervals['(untimed)'] = report['untimed_ns'] / 1e9
    phases = {p['phase']: p['work_ns'] / 1e9 for p in report['phases'] if p['calls']}
    return {'intervals': intervals, 'phases': phases, 'counts': report.get('counts', {})}


def cell_id(name, language, mode, jobs):
    return f'{name}/{language}/{mode}' + (f'/j{jobs}' if language == 'rust' else '')


class Runner:
    def __init__(self, args, env):
        self.args = args
        self.hirsel = Path(args.toolchain).resolve() / 'hirsel'
        self.work = Path(args.work).resolve()
        self.scratch = self.work / 'out'
        self.scratch.mkdir(parents=True, exist_ok=True)
        self.base_env, self.native_env = env['base'], env['native']
        # Older toolchains lack phase reports; perf still counts every compile.
        usage = subprocess.run([str(self.hirsel), '--help'], capture_output=True, text=True,
                               env=dict(os.environ, LLVM_PROFILE_FILE=os.devnull)).stdout
        self.timings = ['--timings=json'] if '--timings' in usage else []
        self.cells = []
        self.active_s = 0.0

    def env(self, native=False, jobs=None):
        env = dict(self.native_env if native else self.base_env)
        # Preserve the existing compiler-work benchmark policy. Warm retains
        # native/runtime artifacts but does not skip the compiler via an exe hit.
        env['HIRSEL_PROGRAM_CACHE'] = 'off'
        if jobs:
            # Rust pairs share one target directory, so the dependencies build once.
            env['HIRSEL_JOBS'] = str(jobs)
            env['CARGO_TARGET_DIR'] = str(self.work / 'rust-target')
        return env

    def hirsel_command(self, path, mode):
        hirsel = str(self.hirsel)
        if mode == 'precompute':
            # Precomputation has no phase report; perf still counts it.
            return [hirsel, 'precompute', str(path), '-o', str(self.scratch / 'std.products')]
        if mode == 'native':
            return [hirsel, 'run', *self.timings, '--native', str(path)]
        if mode == 'check' or mode in EDITS:
            return [hirsel, 'check', *self.timings, str(path)]
        profile = {'clif': ['--debug', '--backend', 'cranelift'], 'llvm-o0': ['--debug'], 'llvm-o2': [], 'debug': ['--debug'], 'release': ['--release']}[mode]
        return [hirsel, 'build', *self.timings, *profile, str(path), '-o', str(self.scratch / 'program')]

    def cargo(self, project, verb, jobs):
        return ['cargo', 'check' if verb == 'check' else 'build', '--offline', '--locked', '--quiet',
                *(['--bin', 'tasks-rust'] if project == ROOT / 'bench/apps/tasks/rust' else []),
                *(['--release'] if verb == 'release' else []), '-j', str(jobs),
                '--manifest-path', str(project / 'Cargo.toml')]

    def untimed(self, command, env):
        started = time.monotonic()
        done = subprocess.run([str(CAPPED), '--timeout', str(self.args.timeout), *command], env=env,
                              stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, text=True)
        self.active_s += time.monotonic() - started
        if done.returncode:
            raise RuntimeError('dependency preparation failed: ' + done.stderr[-2000:])

    def clean_rust(self, project, env, mode=None):
        manifest = str(project / 'Cargo.toml')
        package = json.loads(subprocess.run(
            ['cargo', 'metadata', '--offline', '--no-deps', '--format-version', '1', '--manifest-path', manifest],
            capture_output=True, text=True, check=True, env=env).stdout)['packages'][0]['name']
        subprocess.run(['cargo', 'clean', '--offline', '--quiet', *(['--release'] if mode == 'release' else []), '-p', package, '--manifest-path', manifest],
                       check=True, stdout=subprocess.DEVNULL, env=env)

    def cell(self, program, mode, jobs, cache, runs, temperature=None):
        statuses = [r['status'] for r in runs]
        cell = {
            'id': cell_id(program.name, program.language, mode, jobs) + (f'/{temperature}' if temperature else ''),
            'temperature': temperature,
            'wall_ratio_valid': getattr(self.args, 'lock_scope', 'session') == 'session' and self.args.repeat >= 10 and not getattr(self.args, 'resume', None),
            'program': program.name, 'language': program.language, 'mode': mode, 'jobs': jobs,
            'lines': program.lines, 'groups': list(program.groups), 'cache': cache,
            'status': next((s for s in statuses if s != 'ok'), 'ok'),
            'runs': runs,
            'summary': {metric: summary([r.get(metric) for r in runs if r['status'] == 'ok'])
                        for metric in ('instructions_u', 'wall_s', 'cpu_s', 'rss_mib', 'total_wall_s')},
        }
        for part in ('intervals', 'phases'):
            reported = [r[part] for r in runs if r.get(part) and r['status'] == 'ok']
            if reported:
                names = sorted({name for p in reported for name in p})
                cell['summary'][part] = {name: summary([p.get(name, 0.0) for p in reported]) for name in names}
        self.cells.append(cell)
        wall = cell['summary']['wall_s']
        say(f"  {cell['id']}: {cell['status']}" + (f", wall {wall['median']:.2f} s (n {wall['n']})" if wall else ''))

    def repeated(self, program, once):
        """Up to `repeat` runs of `once()`, stopping at the first that fails."""
        runs = []
        count = 1 if program.lines >= 30000 and not self.args.repeat_large else self.args.repeat
        for _ in range(count):
            runs.append(once())
            if runs[-1]['status'] != 'ok':
                break
        return runs

    def timed_hirsel(self, path, mode):
        run, stderr = measured(self.hirsel_command(path, mode), self.env(native=mode in NATIVE), self.args.timeout, self.args.cpu)
        run.update(timings(stderr) or {})
        return run

    def hirsel_cell(self, program, mode):
        self.cell(program, mode, 1, HIRSEL_CACHE, self.repeated(program, lambda: self.timed_hirsel(program.path, mode)))

    def rust_cell(self, program, mode, jobs):
        env = self.env(jobs=jobs)
        verb = 'check' if mode == 'check' else 'build'
        self.untimed(self.cargo(program.path, verb, jobs), env)

        def once():
            self.clean_rust(program.path, env)
            return measured(self.cargo(program.path, verb, jobs), env, self.args.timeout, self.args.cpu)[0]
        self.cell(program, mode, jobs, RUST_COLD, self.repeated(program, once))

    def edit_cell(self, program, edit, jobs):
        """`check` after one edit, on a copy of the program; Rust keeps the
        incremental cache of an untimed check of the unedited copy."""
        copy = self.work / 'edit' / program.language
        shutil.rmtree(copy, ignore_errors=True)
        source = program.path.parent if program.language == 'hirsel' else program.path
        shutil.copytree(source, copy, ignore=shutil.ignore_patterns('target'))
        edited, base, variants = corpus.edits(copy, program.language)
        env = self.env(jobs=jobs)

        def once():
            edited.write_text(base)
            if program.language == 'rust':
                self.untimed(self.cargo(copy, 'check', jobs), env)
            edited.write_text(variants[edit])
            if program.language == 'hirsel':
                return self.timed_hirsel(copy / 'hirsel.json', edit)
            return measured(self.cargo(copy, 'check', jobs), env, self.args.timeout, self.args.cpu)[0]
        cache = HIRSEL_CACHE if program.language == 'hirsel' else RUST_WARM
        self.cell(program, edit, jobs, cache, self.repeated(program, once))

    def sample(self, program, mode, jobs, temperature, cache):
        if self.args.quick and self.active_s >= 540:
            return {'status': 'budget', 'exit': None}
        env = self.env(native=mode in NATIVE and program.language == 'hirsel', jobs=jobs if program.language == 'rust' else None)
        env.update(HIRSEL_NATIVE_CACHE=str(cache / 'native'), XDG_CACHE_HOME=str(cache / 'xdg'))
        if temperature == 'cold':
            shutil.rmtree(cache, ignore_errors=True)
            if program.language == 'rust':
                self.clean_rust(program.path, env, mode)
        temporary = cache / 'tmp'
        temporary.mkdir(parents=True, exist_ok=True)
        env['TMPDIR'] = str(temporary)
        command = self.cargo(program.path, mode, jobs) if program.language == 'rust' else self.hirsel_command(program.path, mode)
        if mode == 'native' and program.language == 'hirsel':
            grants, endpoint = startup_config(program, self.scratch)
            command += ['--grants', str(grants)]
            command = [sys.executable, str(HERE / 'startup.py'), '--endpoint', endpoint, '--', *command]
        timeout = min(self.args.timeout, max(1, int(540 - self.active_s))) if self.args.quick else self.args.timeout
        result, stderr = measured(command, env, timeout, self.args.cpu)
        logs = self.work / 'logs'
        logs.mkdir(exist_ok=True)
        with tempfile.NamedTemporaryFile(mode='w', dir=logs, prefix=program.name.replace('/', '-') + '-' + program.language + '-' + mode + '-' + temperature + '-', suffix='.stderr', delete=False) as log:
            log.write(stderr)
            result['stderr_path'] = log.name
        self.active_s += result.get('wall_s', 0)
        result.update(timings(stderr) or {})
        if mode == 'native':
            for line in stderr.splitlines():
                if line.startswith('compiler-startup: '):
                    startup = json.loads(line.removeprefix('compiler-startup: '))
                    result['startup'] = startup
                    result['total_wall_s'] = result.get('wall_s')
                    if startup.get('wall_s') is not None:
                        result['wall_s'] = startup['wall_s']
                    if result['status'] == 'ok' and startup['status'] not in ('ready', 'no-output'):
                        result['status'] = startup['status']
        result['command'] = command
        return result

    def go(self, programs):
        """Seed language order per round; cold is immediately followed by warm.

        Stop a failing cell after its first pair, retaining the other language.
        A capped scale cell blocks larger sizes in that language/mode only.
        """
        args = self.args
        want = set(args.groups.split(',')) if args.groups else None
        wanted = args.modes.split(',') if args.modes else list(HIRSEL_MODES)
        select = re.compile(args.select) if args.select else None
        selected = [p for p in programs if (not select or select.search(p.name))
                    and (want is None or set(p.groups) & want or 'edit' in want and p.name == corpus.EDIT_PROGRAM)]
        names = list(dict.fromkeys(p.name for p in selected))
        saved = getattr(args, 'checkpoint', None) or {}
        self.cells = list(saved.get('completed_cells', []))
        completed = {c['program'] for c in self.cells}
        blocked = {(c['language'], c['mode'], c['jobs']) for c in self.cells
                   if 'scale' in c['groups'] and c['status'] in ('cap', 'timeout')}
        prepared = set()
        rng = random.Random(args.seed)
        for name in names:
            members = [p for p in selected if p.name == name]
            tasks = [(p, mode, j) for p in members for mode in modes(p, wanted)
                     for j in ([int(j) for j in args.jobs.split(',')] if p.language == 'rust' else [1])]
            results = {((s['language'], s['mode'], s['jobs']), s['temperature']): s['runs']
                       for s in saved.get('samples', [])} if saved.get('program') == name else {}
            resume_round = max((r.get('round', 0) for runs in results.values() for r in runs), default=-1) + 1
            for key, temperature in results:
                if key[0] == 'rust':
                    prepared.add((name, key))
            for round_number in range(args.repeat):
                order = list(tasks)
                rng.shuffle(order)
                if name in completed or round_number < resume_round:
                    continue
                with timing_lock(args.cpu) if getattr(args, 'lock_scope', 'session') == 'round' else nullcontext():
                    for p, mode, j in order:
                        key = (p.language, mode, j)
                        if (round_number and any(r['status'] != 'ok' for t in ('cold', 'warm') for r in results.get((key, t), []))):
                            continue
                        if 'scale' in p.groups and (p.language, mode, j) in blocked:
                            continue
                        if args.quick and self.active_s >= 540:
                            for temperature in ('cold', 'warm'):
                                results.setdefault((key, temperature), []).append({'status': 'budget', 'exit': None})
                            continue
                        if p.language == 'rust' and (name, key) not in prepared:
                            try:
                                self.untimed(self.cargo(p.path, mode, j), self.env(jobs=j))
                            except RuntimeError as error:
                                for temperature in ('cold', 'warm'):
                                    results[(key, temperature)] = [{'status': 'failed', 'exit': None, 'stderr': str(error)}]
                                continue
                            prepared.add((name, key))
                        cache = self.scratch / 'caches' / p.language / name.replace('/', '-') / mode / str(j)
                        for temperature in ('cold', 'warm'):
                            run = self.sample(p, mode, j, temperature, cache)
                            run['round'] = round_number
                            results.setdefault((key, temperature), []).append(run)
                            say(f"  {name}/{p.language}/{mode}/j{j}/{temperature} r{round_number}: {run['status']} {run.get('wall_s', 0):.2f}s")
                # Recoverable checkpoint, including rounds of an unfinished program.
                pending = Path(args.output + '.partial.pending')
                pending.write_text(json.dumps({'program': name, 'round': round_number,
                    'identity': args.checkpoint_identity, 'completed_cells': self.cells,
                    'samples': [{'language': k[0][0], 'mode': k[0][1], 'jobs': k[0][2], 'temperature': k[1], 'runs': v}
                                for k, v in results.items()]}, indent=1) + '\n')
                pending.replace(args.output + '.partial')
            if name in completed:
                continue
            for p, mode, j in tasks:
                key = (p.language, mode, j)
                for temperature in ('cold', 'warm'):
                    runs = results.get((key, temperature))
                    if not runs and 'scale' in p.groups and key in blocked:
                        runs = [{'status': 'skipped', 'exit': None, 'stderr': 'smaller scale input reached the cap or timeout'}]
                    if runs:
                        self.cell(p, mode, j, temperature + ': program/native caches isolated; std/dependencies retained', runs, temperature)
                        if 'scale' in p.groups and any(r['status'] in ('cap', 'timeout') for r in runs):
                            blocked.add((p.language, mode, j))
            if name == corpus.EDIT_PROGRAM and want and 'edit' in want:
                for p in members:
                    for edit in EDITS:
                        if edit in wanted:
                            self.edit_cell(p, edit, 1)
        return self.cells


def startup_config(program, scratch):
    """Rebind host directories into owned scratch, never an example's data."""
    config = {'io': {'stdout': 'stdout.bytes@1', 'stderr': 'stderr.bytes@1', 'dirs': []}, 'args': []}
    endpoint = 'stdout'
    if program.name in ('logq', 'mdtoc'):
        config['args'] = ['--help']
    if program.name in ('tasks', 'hello-web', 'todo-api', 'kvstore'):
        source = 'todo-api' if program.name == 'kvstore' else program.name
        config = json.loads((ROOT / 'examples' / source / 'grants.json').read_text())
        endpoint = ('http:127.0.0.1:8080' if program.name == 'hello-web' else
                    'listening' if program.name == 'tasks' else 'stdout')
        if program.name != 'hello-web':
            config['args'] = ['--port', '0'] if program.name == 'tasks' else ['0']
            config['io']['net']['rules'][0]['service'] = '0'
            for directory in config['io']['dirs']:
                if directory['path'] == 'data':
                    data = scratch / (program.name + '-data')
                    shutil.rmtree(data, ignore_errors=True)
                    data.mkdir(parents=True)
                    directory['host'] = str(data)
                else:
                    directory['host'] = str(ROOT / 'examples/tasks/static')
    path = scratch / 'startup-grants.json'
    path.write_text(json.dumps(config))
    return path, endpoint


def quick_program(program):
    """Legacy distribution smoke inventory, retained for callers inspecting it."""
    return program.language == 'hirsel' and program.name in ('hello', *corpus.UNITS, 'syn3k')


def modes(program, wanted, quick=False):
    if program.name == 'std@1':
        own = ('precompute',)
    elif program.language == 'hirsel' and program.check_only:
        own = ('check',)
    elif program.language == 'hirsel':
        own = (*HIRSEL_MODES, 'clif', 'llvm-o0', 'llvm-o2')
    else:
        own = RUST_MODES
    return [m for m in own if wanted is None or m in wanted or (m == 'precompute' and 'check' in wanted)
            or (program.language == 'rust' and m in {PAIRED.get(h) for h in wanted})]


def environment(native):
    import suite
    base = suite.controlled_environment()
    native_env = suite.native_environment() if native else None
    for env in (base, native_env):
        for key in UNSET:
            if env:
                env.pop(key, None)
    return {'base': base, 'native': native_env}


def pairs(cells):
    """Hirsel/Rust ratios of median user instructions and peak RSS."""
    by_key = {(c['program'], c['language'], c['mode'], c['jobs'], c.get('temperature')): c for c in cells}
    found = []
    for c in cells:
        if c['language'] != 'hirsel' or c['mode'] not in PAIRED:
            continue
        for jobs in sorted({r['jobs'] for r in cells if r['language'] == 'rust'}):
            rust = by_key.get((c['program'], 'rust', PAIRED[c['mode']], jobs, c.get('temperature')))
            if not rust:
                continue
            accepted = c['status'] == rust['status'] == 'ok'
            h, r = (c['summary']['instructions_u'], rust['summary']['instructions_u']) if accepted else (None, None)
            hm, rm = (c['summary']['rss_mib'], rust['summary']['rss_mib']) if accepted else (None, None)
            found.append({
                'program': c['program'], 'mode': c['mode'], 'temperature': c.get('temperature'), 'rust_mode': rust['mode'], 'rust_jobs': jobs,
                'hirsel': c['id'], 'rust': rust['id'],
                'hirsel_instructions_u': h and h['median'], 'rust_instructions_u': r and r['median'],
                'ratio': h['median'] / r['median'] if h and r and r['median'] else None,
                'rss_ratio': hm['median'] / rm['median'] if hm and rm and rm['median'] else None,
            })
    return found


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument('--toolchain', required=True, help='directory with hirsel and hirsel-std.products')
    parser.add_argument('--output', required=True, help='result file to write')
    parser.add_argument('--work', default=None, help='corpus and scratch directory (default: a temporary one)')
    parser.add_argument('--groups', help='comma-separated: examples, pairs, conformance, tour, std, stress, scale, edit')
    parser.add_argument('--select', help='only programs whose name matches this regular expression')
    parser.add_argument('--modes', help='comma-separated modes (default: every mode of each program)')
    parser.add_argument('--cpu', type=int, default=31, help='pinned CPU (default 31; timing lock held per --lock-scope)')
    parser.add_argument('--repeat', type=int, default=10, help='seeded rounds (default 10)')
    parser.add_argument('--seed', type=int, default=20261021)
    parser.add_argument('--environment', help='prepared environment JSON, avoids rebuilding native tools')
    parser.add_argument('--resume', help='resume a matching .partial checkpoint in the same work directory')
    parser.add_argument('--lock-scope', choices=('round', 'session'), default='round',
                        help='yield CPU timing lock between rounds by default; session enables wall ratios')
    parser.add_argument('--quick', action='store_true', help='hello + csvjson, all four modes, one cold/warm round, 45s cells')
    parser.add_argument('--repeat-large', action='store_true', help='repeat programs of 30k lines or more too')
    parser.add_argument('--jobs', default='1', help='cargo job counts (default 1); Hirsel is single-threaded')
    parser.add_argument('--timeout', type=int, default=300, help='seconds per run (default 300)')
    args = parser.parse_args()
    if args.quick:
        args.groups = 'examples'
        args.select = '^(hello|csvjson)$'
        args.repeat, args.jobs, args.timeout = 1, '1', min(args.timeout, 45)
    if not (Path(args.toolchain) / 'hirsel').exists():
        parser.error(f'{args.toolchain}/hirsel does not exist')
    if args.repeat < 1 or args.cpu not in os.sched_getaffinity(0):
        parser.error('repeat must be positive and cpu must be available')
    temporary = None
    if args.work is None:
        temporary = tempfile.TemporaryDirectory(prefix='compiler-bench-')
        args.work = temporary.name
    work = Path(args.work).resolve()
    started = time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime())
    commit = git_commit()
    say(f'compiler-bench: writing the corpus to {work}')
    programs = corpus.corpus(work, scale=(3000,)) if args.quick else corpus.corpus(work)
    native = args.modes is None or any(m in NATIVE for m in args.modes.split(','))
    if native and not args.environment:
        say('compiler-bench: building the pinned native toolchains on the pool')
    prepared_environment = json.loads(Path(args.environment).read_text()) if args.environment else environment(native)
    args.checkpoint_identity = {'commit': commit, 'cpu': args.cpu, 'repeat': args.repeat, 'seed': args.seed,
                                'work': str(work), 'groups': args.groups, 'select': args.select, 'modes': args.modes,
                                'jobs': args.jobs, 'hirsel_sha256': file_hash(Path(args.toolchain) / 'hirsel')}
    args.checkpoint = json.loads(Path(args.resume).read_text()) if args.resume else None
    if args.checkpoint and args.checkpoint.get('identity') != args.checkpoint_identity:
        parser.error('checkpoint identity differs (compiler, commit, CPU, selection, seed, rounds or work directory)')
    with timing_lock(args.cpu) if args.lock_scope == 'session' else nullcontext():
        cells = Runner(args, prepared_environment).go(programs)
    rustc = subprocess.run(['rustc', '--version'], capture_output=True, text=True).stdout.strip()
    result = {
        'schema': 1, 'suite': 'compiler-bench', 'commit': commit, 'started': started,
        'cpu': args.cpu,
        'host': {'machine': platform.machine(), 'cpus': os.cpu_count(), 'load1': os.getloadavg()[0]},
        'toolchain': {'hirsel': str(Path(args.toolchain).resolve() / 'hirsel'), 'rustc': rustc,
                      'hirsel_sha256': file_hash(Path(args.toolchain) / 'hirsel'),
                      'std_products_sha256': hashlib.sha256(json.dumps({str(p.relative_to(Path(args.toolchain) / 'hirsel-std.products')): file_hash(p) for p in sorted((Path(args.toolchain) / 'hirsel-std.products').rglob('*')) if p.is_file()},sort_keys=True).encode()).hexdigest()},
        'selection': {'quick': args.quick, 'groups': args.groups, 'select': args.select, 'modes': args.modes, 'jobs': args.jobs},
        'lock_scope': args.lock_scope, 'resumed_from': args.resume,
        'wall_ratio_valid': args.lock_scope == 'session' and args.repeat >= 10 and not args.resume,
        'seed': args.seed, 'protocol': 'seeded language/mode order, adjacent cold then unchanged warm; instruction ratios are the verdict',
        'repeat': args.repeat, 'active_s': sum(r.get('total_wall_s', r.get('wall_s', 0)) or 0 for c in cells for r in c['runs']), 'cells': cells, 'pairs': pairs(cells),
    }
    Path(args.output).write_text(json.dumps(result, indent=1) + '\n')
    say(f'compiler-bench: {len(cells)} cells written to {args.output}')
    failed = [c['id'] for c in cells if c['status'] not in ('ok', 'cap', 'timeout', 'skipped', 'budget')]
    if failed:
        say('compiler-bench: failed cells: ' + ', '.join(failed))
    return 1 if failed else 0


if __name__ == '__main__':
    sys.exit(main())
