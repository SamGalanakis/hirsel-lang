#!/usr/bin/env python3
"""Run W1's real worker tests with instrumented std and TSan fiber annotations.

The regular IT binary installs hirsel-guard's allocator, which is incompatible
with TSan startup. This harness imports the same test and support sources while
using the system allocator. Nothing is copied or generated in the checkout.
Requires nightly Rust with rust-src, on Linux x86-64.
"""
import argparse
import hashlib
import json
import os
import resource
from pathlib import Path
import subprocess
import tempfile
import sys

if "HIRSEL_NATIVE_CPU_HARNESS" in os.environ:
    parser = argparse.ArgumentParser()
    parser.add_argument("--native", type=int, choices=[4, 8], required=True)
    args, libtest = parser.parse_known_args()
    root = Path.cwd()
    binary = (root / os.environ["HIRSEL_NATIVE_CPU_HARNESS"]).resolve()
    name = "native_tsan_"
    result = subprocess.run([binary, name, "--nocapture", "--test-threads=1", *libtest],
                            cwd=root / "crates/hirsel-cli", timeout=180,
                            env=os.environ | {"TSAN_OPTIONS": "symbolize=0:halt_on_error=1:exitcode=66"},
                            capture_output=True, text=True)
    print(result.stdout, end="", flush=True)
    print(result.stderr, end="", file=sys.stderr, flush=True)
    if result.returncode == 0:
        passed = set()
        for line in result.stdout.splitlines():
            if line.startswith("{"):
                event = json.loads(line)
                if event.get("type") == "test" and event.get("event") == "ok":
                    passed.add(event["name"])
        if len(passed) != 4 and "4 passed" not in result.stdout:
            raise SystemExit("native CPU TSan harness did not pass all four cells")
        lines = (result.stdout + "\n" + result.stderr).splitlines()
        missing = [f"CPU {policy} {backend} P({args.native}):"
                   for policy in ["tasks.free@1", "tasks.cooperative@1"]
                   for backend in ["llvm", "cranelift"]
                   if not any(line.startswith(f"CPU {policy} {backend} P({args.native}):")
                              for line in lines)]
        if missing:
            raise SystemExit("native CPU TSan full-width P not qualified; "
                             "exclusive CPU witnesses missing for " + ", ".join(missing))
    raise SystemExit(result.returncode)

if "HIRSEL_WORKERS_TSAN" in os.environ:
    def shadow_space():
        _, hard = resource.getrlimit(resource.RLIMIT_DATA)
        resource.setrlimit(resource.RLIMIT_DATA, (hard, hard))

    binary = os.environ["HIRSEL_WORKERS_TSAN"]
    listed = subprocess.run([binary, "pool::cpu_scoped", "--list"],
                            preexec_fn=shadow_space, timeout=10, capture_output=True, text=True)
    if listed.returncode or "tsan_positive_control_detects_conflicting_accesses: test" not in listed.stdout:
        raise SystemExit("CPU pool harness lacks TSan coverage control: " + listed.stdout + listed.stderr)
    result = subprocess.run([binary, "pool::cpu_scoped", "--nocapture", "--test-threads=1"],
                            preexec_fn=shadow_space, timeout=60,
                            env=os.environ | {"TSAN_OPTIONS": "symbolize=0:halt_on_error=1"})
    raise SystemExit(result.returncode)

root = Path(__file__).resolve().parents[1]
key = hashlib.sha256(str(root).encode()).hexdigest()[:12]
target = Path(tempfile.gettempdir()) / ("hirsel-workers-tsan-build-" + key)
parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("--target-dir", type=Path, default=target)
args = parser.parse_args()
target = args.target_dir.resolve()
with tempfile.TemporaryDirectory(prefix="hirsel-workers-tsan-") as scratch:
    crate = Path(scratch)
    (crate / "tests").mkdir()
    deps = {"hirsel-rt": {"path": str(root / "crates/hirsel-rt"),
                         "features": ["diagnostic", "tsan"]}}
    for name in ["hirsel-run-schema", "hirsel-layout", "hirsel-lir",
                 "hirsel-syntax", "hirsel-tir", "hirsel-types"]:
        deps[name] = {"path": str(root / "crates" / name)}
    deps["hirsel-types"]["features"] = ["testing"]
    deps["libc"] = "0.2"
    deps["rustls"] = {"version": "=0.23.46", "default-features": False,
                      "features": ["ring", "std", "tls12"]}
    (crate / "Cargo.toml").write_text("[package]\nname = \"hirsel-workers-tsan\"\nversion = \"0.0.0\"\nedition = \"2024\"\n[workspace]\n")
    # JSON is also valid TOML inline-table syntax after its key separators change.
    def toml(value):
        if isinstance(value, dict):
            return "{ " + ", ".join(json.dumps(k) + " = " + toml(v) for k, v in value.items()) + " }"
        return json.dumps(value)
    with (crate / "Cargo.toml").open("a") as out:
        out.write("[dependencies]\n")
        for name, value in deps.items():
            out.write(json.dumps(name) + " = " + toml(value) + "\n")
    (crate / "tests/workers.rs").write_text(
        "#![allow(dead_code, unused_imports)]\n" +
        "#[path = " + json.dumps(str(root / "crates/hirsel-rt/tests/support/mod.rs")) + "]\nmod support;\n" +
        "#[path = " + json.dumps(str(root / "crates/hirsel-rt/tests/it/workers.rs")) + "]\nmod workers;\n")
    command = ["cargo", "+nightly", "test", "--manifest-path", str(crate / "Cargo.toml"),
               "--target-dir", str(target), "--target", "x86_64-unknown-linux-gnu",
               "-Zbuild-std", "--config", 'target.x86_64-unknown-linux-gnu.rustflags=["-Zsanitizer=thread"]',
               "--test", "workers", "--no-run", "--message-format=json"]
    built = subprocess.run(command, cwd=root, capture_output=True, text=True)
    print(built.stderr, end="", flush=True)
    if built.returncode:
        print(built.stdout, end="")
        raise SystemExit(built.returncode)
    artifacts = [json.loads(line) for line in built.stdout.splitlines() if line.startswith("{")]
    binary = next(a["executable"] for a in artifacts
                  if a.get("reason") == "compiler-artifact" and a.get("executable")
                  and a.get("target", {}).get("name") == "workers")
    # The grant test spawns a fresh copy of this same binary.
    # Avoid a blocked external symbolizer hiding a report. Raw PCs can be
    # symbolized offline against the executable printed here.
    print("TSan executable:", binary, flush=True)
    result = subprocess.run([binary, "--test-threads=1"], cwd=root, timeout=60,
                            env=os.environ | {"TSAN_OPTIONS": "symbolize=0:halt_on_error=1"})
    raise SystemExit(result.returncode)
