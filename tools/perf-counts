#!/usr/bin/env python3
"""Deterministic Cachegrind instruction budgets (run by //:gate-perf-counts).

`tools/perf-counts --bless`, on the host, measures on the pool and rewrites
tools/perf-counts.tsv: the reviewed step after an intended change of counts.
`--fresh-std` builds the release compiler and checks whole-process user
instructions on this host. tools/perf-fresh-std.json is updated manually in
the commit that changes its baseline, with a one-line reason. Scheduled
tools/main-runs checks it in both tiers; it is separate from the Ir ratchet.
"""
import argparse
import difflib
import json
import os
from pathlib import Path
import re
import resource
import shlex
import subprocess
import sys
import tempfile
import time

ROOT = Path(__file__).resolve().parents[1]
BASELINE = ROOT / 'tools/perf-counts.tsv'
MARKER = 'PERF_COUNTS_RECORD '
COLUMNS = 'case\tIr\tfunction'
TOTAL = '<total>'
FRESH_BASELINE = ROOT / 'tools/perf-fresh-std.json'
FRESH_CHILD = '''import subprocess, sys
result = subprocess.run(sys.argv[2:]).returncode
with open(sys.argv[1], 'w') as status:
    status.write(str(result))
raise SystemExit(result if result >= 0 else 128 - result)
'''


def perf_instructions(text):
    counts = {}
    for line in text.splitlines():
        fields = line.split(';')
        if len(fields) > 2 and fields[2] in ('instructions:u', 'instructions'):
            if fields[2] in counts or len(fields) < 5 or float(fields[4]) != 100:
                raise ValueError('fresh std requires one unscaled whole-process count per counter')
            count = int(fields[0])
            if count <= 0:
                raise ValueError('fresh std counted no instructions')
            counts[fields[2]] = count
    if counts.keys() != {'instructions:u', 'instructions'}:
        raise ValueError('fresh std requires user and inclusive instruction counters')
    return counts


def fresh_std(hirsel=None):
    """Host perf oracle; its reviewed baseline is never automatically rewritten."""
    baseline = json.loads(FRESH_BASELINE.read_text())
    if (baseline.get('counter') != 'instructions:u' or baseline.get('jobs') != 1
            or type(baseline.get('instructions')) is not int or baseline['instructions'] <= 0
            or not isinstance(baseline.get('reason'), str) or not baseline['reason'].strip()):
        raise ValueError('invalid fresh std baseline: counter, jobs, positive count and reason required')
    if hirsel is None:
        command = [ROOT / '.buck2/bin/buck2', 'build', *shlex.split(os.environ.get('HIRSEL_BUCK2_CONFIG', '')),
                   '//:hirsel-cli-bin-hirsel', '--target-platforms', '//tools/buck2:release', '--show-output']
        output = subprocess.run([str(x) for x in command], cwd=ROOT, check=True,
                                stdout=subprocess.PIPE, text=True).stdout
        binaries = [line.split(maxsplit=1)[1] for line in output.splitlines()
                    if line.startswith('root//:hirsel-cli-bin-hirsel ')]
        if len(binaries) != 1:
            raise ValueError('fresh std release build returned no unique compiler')
        hirsel = ROOT / binaries[0]
    hirsel = Path(hirsel).resolve(strict=True)
    llvm = ROOT / 'tools/buck2/toolchains/llvm-files'
    env = {key: os.environ[key] for key in ('PATH', 'HOME', 'XDG_RUNTIME_DIR', 'DBUS_SESSION_BUS_ADDRESS')
           if key in os.environ}
    env.update(LC_ALL='C', LD_LIBRARY_PATH=str(llvm / 'lib'), LLVM_SYS_231_PREFIX=str(llvm),
               HIRSEL_DAEMON='off', HIRSEL_RESULTS='none@1', HIRSEL_JOBS='1', HIRSEL_MEMORY_LIMIT='2G')
    with tempfile.TemporaryDirectory(prefix='hirsel-fresh-std-') as directory:
        scratch = Path(directory)
        env['HIRSEL_PRODUCTS'] = str(scratch / 'absent-products')
        counters = scratch / 'perf.csv'
        compiler_status = scratch / 'compiler.status'
        command = [ROOT / 'tools/capped', '--timeout', '120', 'prlimit', '--cpu=60:60', '--',
                   'perf', 'stat', '-x', ';', '-o', counters, '-e', 'instructions:u,instructions', '--',
                   sys.executable, '-c', FRESH_CHILD, compiler_status,
                   hirsel, 'check', ROOT / 'stdlib/std@1/hirsel.json']
        subprocess.run([str(x) for x in command], cwd=ROOT, env=env, check=True)
        # perf can return success for a signalled child. Count only a compiler
        # whose actual wait status was successful, even if perf masks it.
        if not compiler_status.is_file() or compiler_status.read_text() != '0':
            raise ValueError('fresh std compiler did not complete successfully')
        counts = perf_instructions(counters.read_text())
    before, after = baseline['instructions'], counts['instructions:u']
    print(f'fresh std: {before:,} -> {after:,} instructions:u ({100 * (after - before) / before:+.3f}%); '
          f'{counts["instructions"]:,} inclusive; tolerance +3%', flush=True)
    return int(after * 100 > before * 103)

# Open compiler cases remain runnable with --record --filter check/<example>.
# The owner deferred their enforcement until all cases fit five pool-minutes.
COMPILER_CASES = {
    'check/hello-web': ('examples/hello-web/main.hir',
                      'open: checked compiler took 113s; compiler counts exceed the pool budget'),
    'check/todo-api': ('examples/todo-api/hirsel.json',
                     'open: release compiler took 232.56s / 27,528,240,687 Ir; checked exceeded 240s'),
}

# N=1000, one epoch; Rust micro pairs except bigint_mul (Python integer
# derivation and Go byte-schoolbook controls in tools/tests/bigint_oracle_10.py).
MICRO_OUTPUTS = {
    'bigint_mul': b'4901293426875656068\n',
    'strbuild': b'12335375983234794207\n',
    'sha': b'10690083119644975683\n',
    'sort': b'7836095613479867608\n',
    'map_u64': b'500500\n',
    'map_str': b'2028785\n',
    'map_remove': b'499500\n',
    'channel': b'500500\n',
    'print': ''.join(f'line {i}\n' for i in range(1000)).encode(),
    'float_math': b'4747071583000339354\n',
    'int_bits': b'10353835680576761101\n',
}


def table(rows):
    lines = ['# Cachegrind Ir; LLVM release programs, one small-input epoch; regression tolerance +1%.']
    lines.extend(f'# {name}: {reason}' for name, (_, reason) in COMPILER_CASES.items() if name not in rows)
    lines.append(COLUMNS)
    for name, row in sorted(rows.items()):
        lines.append(f'{name}\t{row["Ir"]}\t{TOTAL}')
        lines.extend(f'{name}\t{count}\t{function}' for function, count in sorted(row['functions'].items(),
                     key=lambda item: (-item[1], item[0])))
    return '\n'.join(lines) + '\n'


def read_table(path):
    rows = {}
    for line in path.read_text().splitlines():
        if not line or line.startswith('#') or line == COLUMNS:
            continue
        name, count, function = line.split('\t', 2)
        row = rows.setdefault(name, {'functions': {}})
        if int(count) <= 0 or (function == TOTAL and 'Ir' in row) or function in row['functions']:
            raise ValueError(f'invalid or duplicate budget: {name}/{function}')
        if function == TOTAL:
            row['Ir'] = int(count)
        else:
            row['functions'][function] = int(count)
    if any('Ir' not in row for row in rows.values()):
        raise ValueError('function budgets require a case total')
    return rows


def annotate(text):
    """cg_annotate --show=Ir --show-percs=no --threshold=0 function totals."""
    functions = {}
    # Pinned cg_annotate 3.22 prints both File:function and Function:file
    # summaries. Only the latter's outer rows ("> ") are function totals;
    # summing their file breakdowns again would double-count instructions.
    for line in text.splitlines():
        match = re.fullmatch(r'\s*>\s*([\d,]+)\s+(.+):[^:]*', line)
        if match:
            functions[match[2]] = int(match[1].replace(',', ''))
    if not functions:
        raise ValueError('cg_annotate returned no function instruction counts')
    return functions


def instruction_count(text):
    events = re.search(r'^events: (.+)$', text, re.M)
    summary = re.search(r'^summary: (.+)$', text, re.M)
    if not events or not summary:
        raise ValueError('incomplete Cachegrind output')
    count = int(summary[1].split()[events[1].split().index('Ir')])
    if count <= 0:
        raise ValueError('Cachegrind counted no instructions')
    return count


def compare(expected, actual):
    errors = []
    for name in sorted(expected.keys() | actual.keys()):
        if name not in expected or name not in actual:
            errors.append(f'{name}: {"missing budget; bless explicitly" if name in actual else "budget case did not run"}')
            continue
        before, after = expected[name], actual[name]
        delta = after['Ir'] - before['Ir']
        if delta * 100 <= before['Ir']:
            continue
        errors.append(f'{name}: {before["Ir"]:,} -> {after["Ir"]:,} Ir ({100 * delta / before["Ir"]:+.2f}%; regression tolerance +1%)')
        names = sorted(before['functions'].keys() | after['functions'].keys(),
                       key=lambda fn: (-abs(after['functions'].get(fn, 0) - before['functions'].get(fn, 0)), fn))[:20]
        def lines(row):
            return [f'{row["Ir"]:15,d} PROGRAM TOTALS\n'] + [
                f'{row["functions"].get(fn, 0):15,d} {fn}\n' for fn in names]
        errors.extend(line.rstrip() for line in difflib.unified_diff(lines(before), lines(after),
                      fromfile='baseline cg_annotate top functions', tofile='current cg_annotate top functions', n=20))
    return errors


def ratchet(baseline, measurements):
    """Keep the lowest measured case totals beyond 1% noise, with their profile.

    Measurements come only from passing runs of main's full suite
    (tools/main-runs). A run may have measured before another baseline
    landed: it must never raise that newer baseline. Function rows are
    diagnostic, not budgets.
    """
    rows = dict(baseline)
    for measured in measurements:
        if not isinstance(measured, dict) or measured.keys() != baseline.keys():
            raise ValueError('the measured cases differ from the baseline')
        for name, row in measured.items():
            if (not isinstance(row, dict) or type(row.get('Ir')) is not int or row['Ir'] <= 0
                    or not isinstance(row.get('functions'), dict)
                    or any(not isinstance(fn, str) or type(count) is not int or count <= 0
                           for fn, count in row['functions'].items())):
                raise ValueError(f'invalid measurement: {name}')
            if row['Ir'] < rows[name]['Ir']:
                rows[name] = row
    improvements = []
    for name, before in baseline.items():
        after = rows[name]
        if (before['Ir'] - after['Ir']) * 100 > before['Ir']:
            improvements.append(dict(count=name, old=before['Ir'], new=after['Ir']))
        else:
            rows[name] = before
    return rows, sorted(improvements, key=lambda item: item['count'])


def run(command, env, **kwargs):
    result = subprocess.run([str(x) for x in command], env=env, stdout=subprocess.PIPE,
                            stderr=subprocess.PIPE, timeout=240, **kwargs)
    if result.returncode:
        raise RuntimeError(f'{command[0]} exited {result.returncode}:\n{result.stderr.decode(errors="replace")}')
    return result.stdout


def measure(name, command, scratch, env, expected=None):
    started = time.monotonic()
    output = scratch / 'cachegrind.out'
    valgrind = Path(env['HIRSEL_VALGRIND'])
    runtime = Path(env['HIRSEL_VALGRIND_RUNTIME'])
    # Pin the loader/libc as well as Valgrind, including compiler-check startup.
    launch = [runtime / 'ld-linux-x86-64.so.2', '--library-path',
              str(runtime) + ':' + str(Path(env['LLVM_SYS_231_PREFIX']) / 'lib'), *command]
    stdout = run([valgrind, '--tool=cachegrind', '--cache-sim=no', '--branch-sim=no',
                  '--cachegrind-out-file=' + str(output), *launch], env)
    if expected is not None and stdout != expected:
        raise ValueError(f'{name}: wrong benchmark checksum: {stdout!r}, expected {expected!r}')
    functions = annotate(run([valgrind.parent / 'cg_annotate', '--show=Ir', '--show-percs=no',
                              '--auto=no', '--threshold=0', output], env).decode())
    count = instruction_count(output.read_text())
    print(f'{name}: {count:,} Ir ({time.monotonic() - started:.2f} s)', flush=True)
    return {'Ir': count, 'functions': dict(sorted(functions.items(), key=lambda item: (-item[1], item[0]))[:50])}


def build_program(hirsel, text, name, scratch, env):
    source = scratch / (name + '.hir')
    source.write_text(text)
    source.with_suffix('.hir.json').write_text(json.dumps({
        'schema': 1, 'package': {'name': 'benchmark', 'version': '1'},
        'entry': {'module': [], 'name': 'main'}, 'sources': [{'path': source.name, 'module': []}],
        'dependencies': [{'manifest': str(ROOT / 'stdlib/std@1/hirsel.json'),
                          'package': {'name': 'std', 'version': '1'}, 'expose': []}]}))
    binary = scratch / name
    run([hirsel, 'build', '--release', source, '-o', binary], env)
    return binary


def micro_cases(hirsel, scratch, env, selected=None):
    micro = ROOT / 'bench/micro'
    for source in sorted((micro / 'programs').glob('*.hir')):
        name = 'micro/' + source.stem
        if selected and selected not in name:
            continue
        if source.stem not in MICRO_OUTPUTS:
            raise ValueError(f'{name}: add an independent small-input output oracle')
        binary = build_program(hirsel, source.read_text(), 'micro-' + source.stem, scratch, env)
        arguments = ['1000'] + ([] if source.stem in ('print', 'channel') else ['1'])
        if source.stem == 'bigint_mul':
            arguments.append('0')
        command = [binary, '--hirsel-grants', micro / 'grants.json', *arguments]
        yield name, command, MICRO_OUTPUTS[source.stem]


def native_cases(hirsel, scratch, env, selected=None):
    bench = ROOT / 'bench/native'
    common = (bench / 'programs/common.hir').read_text().split('pub fn main(', 1)[0]
    cases = [case for case in json.loads((bench / 'manifest.json').read_text())['cases'] if case['size'] == 'small']
    if len(cases) != 17:
        raise ValueError(f'expected 17 native small cases, found {len(cases)}')
    grants = json.dumps({'io': {'stdout': 'stdout.bytes@1', 'dirs': [
        {'path': 'fixtures', 'host': str(bench / 'inputs'), 'access': 'read'}]}})
    for case in cases:
        if selected and selected not in 'native/' + case['id']:
            continue
        name = case['case'].replace('/', '-')
        text = (bench / 'programs' / (name + '.hir')).read_text() + '\n' + common
        text += f'''
pub fn main(rt: Io) -> Result[(), ()] {{
  let directory = io.dir(rt, path.of("fixtures")) ? error
  let input = file.read_bytes(directory, path.of("{Path(case['input']).name}")) ? error
  let output = workload(input)
  out.print(io.stdout(rt) ? error, hex(checksum(output))) ? error
  Ok(())
}}
'''
        binary = build_program(hirsel, text, name, scratch, env)
        yield 'native/' + case['id'], [binary, '--hirsel-grants', grants], case['checksum'].encode() + b'\n'


def bless():
    """Measure on the pool and rewrite the baseline from its one passing record."""
    import sys
    sys.path.insert(0, str(ROOT / 'tools/buck2'))
    import event_logs
    with tempfile.TemporaryDirectory(prefix='hirsel-perf-bless-') as directory:
        log = Path(directory) / 'events.pb.zst'
        subprocess.run([str(ROOT / '.buck2/bin/buck2'), 'test', '--event-log', str(log), '//:gate-perf-counts',
                        '--', '--test-arg=--record'], cwd=ROOT)
        result = event_logs.test_results(log).get('gate-perf-counts', {}) if log.exists() else {}
    records = [line.removeprefix(MARKER) for line in result.get('details', '').splitlines() if line.startswith(MARKER)]
    if result.get('status') != event_logs.PASS or len(records) != 1:
        print('perf-counts: no passing pool measurement; tools/perf-counts.tsv unchanged')
        return 1
    BASELINE.write_text(table(json.loads(records[0])))
    print('perf-counts: rewrote tools/perf-counts.tsv; review its diff before committing')
    return 0


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--bless', action='store_true', help='on the host: measure on the pool and rewrite the baseline')
    parser.add_argument('--record', action='store_true', help='emit measurements for --bless; writes no inputs')
    parser.add_argument('--filter', help='one case substring, for diagnosis (never a passing gate)')
    parser.add_argument('--fresh-std', action='store_true', help='host fresh std check against its manual +3% budget')
    parser.add_argument('--hirsel', type=Path, help='with --fresh-std: use an already built release compiler')
    args = parser.parse_args()
    if args.fresh_std:
        if args.bless or args.record or args.filter:
            parser.error('--fresh-std has a manual baseline; --bless, --record and --filter are not supported')
        return fresh_std(args.hirsel)
    if args.hirsel:
        parser.error('--hirsel requires --fresh-std')
    if args.bless:
        return bless()
    env = {key: value for key, value in os.environ.items() if key in (
        'PATH', 'LLVM_SYS_231_PREFIX', 'HIRSEL_RUNTIME_ARCHIVES', 'HIRSEL_PRODUCTS', 'HIRSEL_MEMORY_LIMIT',
        'HIRSEL_VALGRIND', 'VALGRIND_LIB', 'HIRSEL_VALGRIND_RUNTIME', 'HIRSEL_LINK_KIT', 'HIRSEL_GLIBC_FLOOR', 'LD_LIBRARY_PATH')}
    env.update(LC_ALL='C', HIRSEL_JOBS='1', RUST_TEST_THREADS='1')
    hirsel = ROOT / 'buck-out/tmp/cargo-bin-exe/gate-perf-counts/hirsel'
    hirsel = hirsel.resolve()
    started = time.monotonic()
    rows = {}
    with tempfile.TemporaryDirectory(prefix='hirsel-perf-counts-') as directory:
        scratch = Path(directory)
        for name, (source, reason) in COMPILER_CASES.items():
            if not args.filter:
                print(f'perf-counts: {name}: {reason}', flush=True)
            elif args.filter in name:
                rows[name] = measure(name, [hirsel, 'check', ROOT / source], scratch, env)
        if not args.filter or 'micro/' in args.filter:
            for name, command, expected in micro_cases(hirsel, scratch, env, args.filter):
                rows[name] = measure(name, command, scratch, env, expected)
        if not args.filter or 'native/' in args.filter:
            for name, command, expected in native_cases(hirsel, scratch, env, args.filter):
                if not args.filter or args.filter in name:
                    rows[name] = measure(name, command, scratch, env, expected)
    usage = resource.getrusage(resource.RUSAGE_CHILDREN)
    print(f'perf-counts: {len(rows)} cases; {time.monotonic() - started:.2f} seconds; '
          f'{usage.ru_utime + usage.ru_stime:.2f} CPU seconds; 1 pool CPU', flush=True)
    if not rows:
        raise ValueError('no performance cases ran')
    if args.record:
        print(MARKER + json.dumps(rows, sort_keys=True, separators=(',', ':')))
        return 0
    if args.filter:
        raise ValueError('--filter is diagnostic only; use --record')
    baseline = read_table(BASELINE)
    errors = compare(baseline, rows)
    if errors:
        print('\n'.join(errors))
        return 1
    _, improvements = ratchet(baseline, [rows])
    for item in improvements:
        print(f'perf-counts: improvement {item["count"]}: {item["old"]:,} -> {item["new"]:,} Ir; '
              'pass (main\'s full run, tools/main-runs, records the lower budget)', flush=True)
    print(MARKER + json.dumps(rows, sort_keys=True, separators=(',', ':')))
    return 0


if __name__ == '__main__':
    try:
        raise SystemExit(main())
    except (OSError, ValueError, RuntimeError, subprocess.SubprocessError) as error:
        raise SystemExit(f'perf-counts: {error}')
