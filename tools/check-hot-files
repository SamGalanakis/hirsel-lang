#!/usr/bin/env python3
"""Check the independent line lists that Git merges with merge=union."""

from pathlib import Path
import re
import runpy
import sys

ROOT = Path(__file__).resolve().parents[1]


def check(root=ROOT):
    errors = []
    for path in sorted(root.glob('crates/*/tests/*/modules.rs')):
        seen = set()
        for number, line in enumerate(path.read_text().splitlines(), 1):
            if not re.fullmatch(r'mod [A-Za-z_][A-Za-z_0-9]*;', line):
                errors.append(f'{path}:{number}: expected one independent mod declaration')
            if line in seen:
                errors.append(f'{path}:{number}: duplicate line {line!r}')
            seen.add(line)
        main = path.with_name('main.rs').read_text()
        if 'include!("modules.rs");' not in main:
            errors.append(f'{path}: main.rs must include this registry')
        # Ordinary sibling modules belong in the union list; #[path] helpers
        # and attributes remain together in main.rs.
        lines = main.splitlines()
        for i, line in enumerate(lines):
            match = re.fullmatch(r'mod (\w+);', line)
            attributed = i > 0 and lines[i - 1].startswith('#[')
            if match and not attributed and path.with_name(match[1] + '.rs').is_file():
                errors.append(f'{path.with_name("main.rs")}: put mod {match[1]}; in modules.rs')
    # Reuse main-runs' ledger validation: rejects duplicate IDs (including
    # identical rows), missing columns, empty fields and invalid dates.
    sys.path.insert(0, str(ROOT / 'tools/buck2'))
    import merging
    for name in merging.PATH_LISTS:
        path = root / name
        if path.is_file():
            text = path.read_text()
            try:
                merging.path_list(text, text, text)
            except merging.Conflict as error:
                errors.append(f'{path}: {error}')
    tables = runpy.run_path(str(root / 'tools/main-runs'))
    try:
        tables['table'](root / 'tools/known-failures.tsv')
    except (tables['TableError'], OSError) as error:
        errors.append(str(error))
    return errors


if __name__ == '__main__':
    errors = check()
    print('\n'.join(errors) if errors else 'hot files: independent lists have no duplicates')
    sys.exit(bool(errors))
