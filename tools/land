#!/usr/bin/env python3
"""Land the lane's committed change on main.

    tools/land

Fetch, rebase onto origin/main, then build the workspace, run Clippy, check
formatting and the build files on the rebased tree, regenerate docs/api.md
with the built CLI, and push. Index changes get their own generated-only
commit, 'Regenerate the API index.', without another gate. A rejected push
(main moved) repeats the loop. A rebase conflict stops it: resolve it, run
tools/gate on the result, and land again.

Land prints what the gate ran for the change and why (its green record), and
appends the push with that record to `hirsel-landings.jsonl` in the clone's
common git directory, so a red main maps back to the push and what it skipped.

Land never runs tests. tools/gate runs them once, on the finished change, and
records the change's identity when it passes (gating.change_identity: the
patch-id of the lane's own diff without context lines or the generated
docs/api.md, and the crates it touches). Land refuses a change with no such record, so a clean rebase onto a
newer main never reruns tests, and an edited or hand-merged change always does.
The export/drift test stays in the gate; land refreshes its generated page
after any newer declarations arrive through the rebase, so a docs/api.md
conflict is resolved by regenerating the page and needs no new gate.
"""

import json
import os
from pathlib import Path
import subprocess
import sys
import time

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / 'tools/buck2'))
sys.dont_write_bytecode = True
import gating  # noqa: E402
from gating import say  # noqa: E402

PY = sys.executable
ATTEMPTS = 20
REJECTED = ('[rejected]', 'fetch first', 'non-fast-forward', 'failed to update ref', 'cannot lock ref')
CLI = 'root//:hirsel-cli-bin-hirsel'
LANDINGS = 'hirsel-landings.jsonl'


def run(*command, **kwargs):
    return subprocess.run(command, cwd=ROOT, capture_output=True, text=True, **kwargs)


def checks():
    """Build, Clippy, formatting and the build files on this tree: True when all pass."""
    if run(PY, 'tools/buck2/prepare.py').returncode:
        say('land: tools/buck2/prepare.py failed')
        return False
    local = gating.Local()
    local.start('formatting', [PY, 'tools/buck2/fmt.py', '--check'])
    local.start('Buck2 build files match Cargo', [PY, 'tools/buck2/sync.py', '--check'])
    build = gating.uquery(gating.BUILD_SET)
    clippy = gating.uquery(gating.CLIPPY_SET)
    started = time.monotonic()
    result = gating.buck2('build', '--materializations', 'none', *build, *[t + '[clippy.txt]' for t in clippy],
                          capture_output=True, text=True)
    ok = result.returncode == 0
    say(f'land: {"pass" if ok else "FAIL"}  workspace build and Clippy: {len(build)} targets, '
        f'{len(clippy)} Clippy twins ({time.monotonic() - started:.0f} s)')
    if not ok:
        say(gating.last_lines(result.stderr, 40))
    else:
        clean, text = gating.clippy_report(clippy)
        if not clean:
            say('land: FAIL  Clippy\n' + gating.last_lines(text, 40))
            ok = False
    for name, _, status, output, seconds in local.finish():
        say(f'land: {"pass" if status == 0 else "FAIL"}  {name} ({seconds:.0f} s)')
        if status:
            say(gating.last_lines(output, 20))
            ok = False
    return ok


def regenerate_index(checked_head):
    """Render with the checked CLI; return (success, generated commit's parent and id)."""
    built = gating.buck2('build', '--show-json-output', CLI, capture_output=True, text=True)
    if built.returncode:
        say('land: cannot build the index generator\n' + gating.last_lines(built.stderr, 20))
        return False, None
    try:
        executable = ROOT / json.loads(built.stdout)[CLI]
    except (ValueError, KeyError, TypeError):
        say('land: CLI build did not report its executable')
        return False, None
    try:
        rendered = subprocess.run([str(executable), 'doc', 'stdlib/std@1/hirsel.json'], cwd=ROOT, capture_output=True)
    except OSError as error:
        say(f'land: cannot run the index generator: {error}')
        return False, None
    if rendered.returncode:
        say('land: index generation failed\n' + gating.last_lines(rendered.stderr.decode(errors='replace'), 20))
        return False, None
    if (run('git', 'rev-parse', 'HEAD').stdout.strip() != checked_head
            or run('git', 'status', '--porcelain').stdout.strip()):
        say('land: the worktree changed during the checks; refusing to push')
        return False, None
    page = ROOT / 'docs/api.md'
    if page.exists() and page.read_bytes() == rendered.stdout:
        say('land: API index is current')
        return True, None
    page.write_bytes(rendered.stdout)
    added = run('git', 'add', '--', 'docs/api.md')
    committed = (run('git', 'commit', '-m', 'Regenerate the API index.', '--only', '--', 'docs/api.md')
                 if added.returncode == 0 else added)
    if committed.returncode:
        say('land: cannot commit the regenerated index\n' + committed.stderr)
        return False, None
    generated = run('git', 'rev-parse', 'HEAD').stdout.strip()
    say(f'land: regenerated docs/api.md in {generated[:12]} (generated docs only; no new gate)')
    return True, (checked_head, generated)


def undo_index_commit(generated):
    """A failed push retries from the gated change, without its generated-only commit."""
    if generated is None:
        return True
    parent, head = generated
    if (run('git', 'rev-parse', 'HEAD').stdout.strip() != head
            or run('git', 'status', '--porcelain').stdout.strip()):
        say('land: the worktree changed during the push; leaving the generated commit for review')
        return False
    # Only the commit made above is undone. Keep the gated source commits and
    # re-render the page after the next rebase; never transfer a green record.
    reset = run('git', 'reset', '--soft', parent)
    restored = (run('git', 'restore', '--staged', '--worktree', '--', 'docs/api.md')
                if reset.returncode == 0 else reset)
    if restored.returncode:
        say('land: cannot restore the index after the rejected push\n' + restored.stderr)
        return False
    return True


def describe(record):
    """What the gate ran for a change and why, as tools/gate recorded it."""
    lines = [f'gated {record.get("at", "?")}: why: {record.get("why") or "(not recorded)"}']
    if record.get('extends'):
        lines.append(f'  extends change {record["extends"][:12]}')
    lines += ['  floor: ' + part for part in record.get('floor', [])]
    lines += ['  ran: ' + part for part in record.get('selection', []) if part not in record.get('floor', [])]
    return lines


def log_landing(pushed, base, identity, record):
    """Append the push and its gate record to the landings log every worktree
    of this clone shares (`<git common dir>/hirsel-landings.jsonl`), so a red
    main maps back to the push and to what its gate chose to skip."""
    common = Path(run('git', 'rev-parse', '--path-format=absolute', '--git-common-dir').stdout.strip())
    entry = dict(pushed=pushed, base=base, identity=identity, branch=run('git', 'branch', '--show-current').stdout.strip(),
                 at=time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime()),
                 gated=record.get('at'),
                 **{key: record.get(key) for key in ('why', 'tokens', 'floor', 'selection', 'extends')})
    with open(common / LANDINGS, 'a') as log:
        log.write(json.dumps(entry, sort_keys=True) + '\n')


def main():
    if len(sys.argv) > 1:
        print(__doc__, file=sys.stderr)
        return 2
    os.chdir(ROOT)
    for name, value in (('CARGO_BUILD_JOBS', '4'), ('HIRSEL_JOBS', '4'), ('RUST_TEST_THREADS', '4')):
        os.environ.setdefault(name, value)
    if run('git', 'status', '--porcelain').stdout.strip():
        say('land: the worktree has uncommitted changes; commit them (and gate the result) first')
        return 1
    for attempt in range(1, ATTEMPTS + 1):
        if (fetch := run('git', 'fetch', 'origin')).returncode:
            say('land: git fetch failed\n' + fetch.stderr)
            return 1
        rebase = run('git', 'rebase', 'origin/main')
        if rebase.returncode:
            conflicts = run('git', 'diff', '--name-only', '--diff-filter=U').stdout.split()
            run('git', 'rebase', '--abort')
            say('land: the rebase onto origin/main conflicts in: ' + (', '.join(conflicts) or rebase.stderr.strip()))
            say('land: rebase by hand, resolve, run tools/gate on the result, then tools/land')
            return 1
        base = gating.merge_base('origin/main')
        identity = gating.change_identity(base)
        if not identity:
            say('land: nothing to land; HEAD is on origin/main')
            return 0
        crates = gating.Selection(base).crates
        if not gating.is_green(identity, crates):
            say(f'land: tools/gate has not passed this change (identity {identity[:12]}); '
                'run tools/gate, then tools/land')
            return 1
        say(f'land: attempt {attempt}: {run("git", "rev-list", "--count", f"{base}..HEAD").stdout.strip()} '
            f'commits on {base[:12]}, change {identity[:12]} passed tools/gate')
        record = gating.green_records()[identity]
        for line in describe(record):
            say('land: ' + line)
        checked_head = run('git', 'rev-parse', 'HEAD').stdout.strip()
        if not checks():
            say('land: refusing to push a red tree')
            return 1
        ok, generated = regenerate_index(checked_head)
        if not ok:
            return 1
        push = run('git', 'push', 'origin', 'HEAD:main')
        if push.returncode == 0:
            pushed = run('git', 'rev-parse', 'HEAD').stdout.strip()
            say(f'land: pushed {pushed[:12]} to main')
            log_landing(pushed, base, identity, record)
            return 0
        if not undo_index_commit(generated):
            return 1
        if not any(marker in push.stderr for marker in REJECTED):
            say('land: git push failed\n' + push.stderr)
            return 1
        say('land: main moved during the checks; rebasing again')
    say(f'land: main moved under {ATTEMPTS} attempts in a row; try again')
    return 1


if __name__ == '__main__':
    sys.exit(main())
