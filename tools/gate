# ---------------------------------------------------------------- documentation

LINK = re.compile(r'\]\(<?([^)\s>]+)>?(?:\s+"[^"]*")?\)')


def link_target(document, link):
    """The repository path a relative Markdown link names, or None for a URL or an anchor."""
    if re.match(r'^[a-z][a-z0-9+.-]*:', link) or link.startswith('#'):
        return None
    link = link.split('#')[0]
    base = ROOT if link.startswith('/') else (ROOT / document).parent
    return (base / link.lstrip('/')).resolve()


def docs_check(base, documents, paths):
    """Links added to the changed documents resolve, links anywhere into a deleted
    path are gone, and the documents add no whitespace errors."""
    errors = []
    for document in documents:
        path = ROOT / document
        if not path.is_file() or not document.endswith('.md'):
            continue
        tracked = gating.run(['git', 'cat-file', '-e', f'{base}:{document}'], cwd=ROOT,
                                 capture_output=True).returncode == 0
        added = (gating.git('diff', '-U0', base, '--', document) if tracked else path.read_text())
        lines = [line[1:] for line in added.splitlines() if line.startswith('+') and not line.startswith('+++')] \
            if tracked else added.splitlines()
        for line in lines:
            for link in LINK.findall(line):
                target = link_target(document, link)
                if target is not None and not target.exists():
                    errors.append(f'{document}: link {link} names nothing')
    deleted = {(ROOT / p).resolve() for p in paths if not (ROOT / p).exists()}
    if deleted:
        for document in gating.git('ls-files', '*.md').split():
            text = (ROOT / document).read_text(errors='replace') if (ROOT / document).is_file() else ''
            for link in LINK.findall(text):
                target = link_target(document, link)
                if target in deleted:
                    errors.append(f'{document}: link {link} names a deleted path')
    whitespace = gating.run(['git', 'diff', '--check', base, '--', *documents], cwd=ROOT,
                                capture_output=True, text=True)
    if whitespace.returncode:
        errors.append(whitespace.stdout.strip())
    return (1 if errors else 0), '\n'.join(errors)


# ---------------------------------------------------------------- targeted tests

class Report:
    def __init__(self, known=None):
        self.rows = []      # (passed, label, detail lines)
        self.known = known or {}    # gating.known_failures()
        self.excluded = []          # (target, KnownFailure) a failure matched

    def add(self, passed, label, details=()):
        self.rows.append((passed, label, [d for d in details if d]))

    def known_failure(self, target, result):
        """Whether a failed target failed only in known failures: then it
        passes, with each exclusion named in its row."""
        found = gating.known_only(target, result['details'], self.known) if result else None
        if found:
            self.excluded += [(target, failure) for failure in found]
            self.add(True, f'{target} ({gating.STATUS.get(result["status"], result["status"])}, known failures only)',
                     [failure.describe() for failure in found])
        return bool(found)

    @property
    def passed(self):
        return all(passed for passed, _, _ in self.rows)

    def print(self, seconds):
        if self.excluded:
            say('gate: known failures excluded (tools/known-failures.tsv on origin/main):')
            for target, failure in self.excluded:
                say(f'  {target}: {failure.describe()}')
        say(f'gate: summary ({seconds:.0f} s)')
        for passed, label, details in self.rows:
            say(f'  {"pass" if passed else "FAIL"}  {label}')
            for detail in details:
                say('        ' + detail.replace('\n', '\n        '))
        failed = sum(not passed for passed, _, _ in self.rows)
        say(f'gate: {"passed" if not failed else f"failed: {failed} of {len(self.rows)}"} ({seconds:.0f} s)')


def local_rows(report, results):
    for name, command, status, output, seconds in results:
        details = [] if status == 0 else [gating.last_lines(output, 20), 'rerun: ' + ' '.join(
            str(part).replace(str(ROOT) + '/', '') for part in command)]
        report.add(status == 0, f'{name} ({seconds:.0f} s)', details)


def campaign_row(report, name, results, targets, summarize):
    shards = [results.get(gating.short(t)) for t in targets]
    seconds = max((r['seconds'] for r in shards if r), default=0)
    failed = [(gating.short(t), r) for t, r in zip(targets, shards) if not r or r['status'] != gating.PASS]
    if failed:
        for target, result in failed:
            if report.known_failure(target, result):
                continue
            if result is None:
                report.add(False, f'{target}: no result (see the build failures and the log)')
            else:
                report.add(False, f'{target} ({gating.STATUS.get(result["status"], result["status"])}, '
                           f'{result["seconds"]:.0f} s)', gating.rerun(target, result['details']))
        return
    try:
        summary = summarize({gating.short(t): results[gating.short(t)]['details'] for t in targets})
    except (ValueError, KeyError, TypeError) as error:
        report.add(False, f'{name}: {error}')
        return
    report.add(True, f'{name}: {len(targets)} target{"s" * (len(targets) > 1)} (slowest {seconds:.0f} s)', summary)


def conformance_summary(outputs):
    return conformance.summarize(outputs, len(outputs))


def chosen_agreement_summary(outputs):
    total = agree.summarize_within(outputs)
    return [f'{total["checked"]} variants checked, {total["skipped"]} skipped, 0 flagged']


def smoke_summary(outputs):
    return []


def test_rows(report, results, tests):
    for target in tests:
        name = gating.short(target)
        result = results.get(name)
        if result is None:
            report.add(False, f'{name}: no result (see the build failures and the log)')
        elif result['status'] in (gating.PASS, gating.SKIP, gating.OMITTED):
            report.add(True, f'{name} ({result["seconds"]:.0f} s)')
        elif not report.known_failure(name, result):
            report.add(False, f'{name} ({gating.STATUS.get(result["status"], result["status"])}, '
                       f'{result["seconds"]:.0f} s)', gating.rerun(name, result['details']))


def prepare(report):
    started = time.monotonic()
    result = gating.run([PY, str(ROOT / 'tools/buck2/prepare.py')], cwd=ROOT, capture_output=True, text=True)
    if result.returncode:
        report.add(False, 'Buck2 toolchains and pool configuration', [gating.last_lines(result.stdout + result.stderr)])
        return False
    say(f'gate: Buck2 prepared ({time.monotonic() - started:.0f} s)')
    return True


def show_plan(plan, indent='  '):
    """A plan's parts, one line each."""
    lines = []
    if plan.tests:
        names = sorted({re.sub(r'-shard-\d+$', '', gating.short(t)) for t in plan.tests})
        lines.append(f'{len(plan.tests)} test targets: ' + ' '.join(names))
    for name, campaign in gating.WHOLE.items():
        if campaign in plan.campaigns:
            lines.append(f'{name}: the whole campaign')
    if plan.smoke:
        lines.append(f'{gating.SMOKE}: the corpus smoke slice, {len(plan.smoke_cases)} cases (one per rule and '
                     f'expectation kind) and the agreement variants of {len(plan.smoke_agreement)}')
    for label, cases in (('conformance', plan.conformance - plan.smoke_cases),
                         ('agreement', plan.agreement - plan.smoke_agreement)):
        if cases:
            shown = sorted(cases)
            lines.append(f'{label}: {len(shown)} corpus cases: ' + ' '.join(shown[:8])
                         + (f' and {len(shown) - 8} more' if len(shown) > 8 else ''))
    if plan.native:
        lines.append(f'native: {len(plan.native)} programs on both backends: ' + ' '.join(sorted(plan.native)[:8]))
    for line in lines or ['nothing']:
        say(indent + line)


def suggest(base_ref):
    """Print what the change can affect; run nothing."""
    base = gating.merge_base(base_ref)
    selection = gating.Selection(base)
    if not selection.paths:
        say(f'gate: the worktree does not differ from {base[:12]}; nothing to run')
        return 0
    # Static: the changed paths, the root BUCK (graph.py) and the import
    # graphs, with no Buck2, so a suggestion never waits on a daemon.
    say(f'gate: {len(selection.paths)} changed paths from {base[:12]}')
    plan = selection.suggest()
    plan.settle()
    say('gate: the targeted set (tools/buck2/impact.py):')
    show_plan(plan)
    for token, why in plan.reasons:
        say(f'    {token}: {why}')
    for name, _ in local_checks(selection):
        say(f'  on this host: {name}')
    say('gate: run it with tools/gate, or name the parts you need with tools/gate --tests ...')
    return 0


def local_checks(selection):
    """The targeted set's checks on this host, which need no Buck2: the gate
    tooling's tests when it changed, the models' checks."""
    c = selection.classified
    checks = []
    if c.tools or c.everything:
        checks += gating.tool_tests()
    elif c.owned:
        # A crate edit can add an ignored test that no run selects.
        checks.append(('tools/tests/ignored_tests.py', [PY, str(ROOT / 'tools/tests/ignored_tests.py')]))
    return checks + impact.proof_checks(selection.paths)


def run_plan(report, plan, log):
    """The plan's Buck2 tests in one invocation, each row added to `report`."""
    tests = sorted(plan.tests)
    campaigns = plan.campaign_targets()
    targets = tests + campaigns
    results = {}
    say(f'gate: one Buck2 invocation: {len(targets)} targets')
    say(f'gate: Buck2 output: {log}')
    with tempfile.TemporaryDirectory() as scratch, gating.event_logs.recorded('gate') as event_log:
        build_report = Path(scratch) / 'build.json'
        with open(log, 'w') as out:
            started = time.monotonic()
            status = gating.buck2('test', '--event-log', str(event_log), '--build-report', str(build_report),
                                  *targets, '--', '--timeout', str(gating.TIMEOUT),
                                  stdout=out, stderr=subprocess.STDOUT).returncode
        results.update(gating.test_results(event_log) if event_log.exists() else {})
        failures = gating.build_failures(build_report)
    say(f'gate: tests finished ({time.monotonic() - started:.0f} s)')
    for target, error in sorted(failures.items()):
        report.add(False, f'build of {target} failed', [gating.last_lines(error, 30),
                                                         f'.buck2/bin/buck2 build //:{target}'])
    if impact.NATIVE_SMOKE in plan.campaigns:
        campaign_row(report, 'native smoke', results, gating.CAMPAIGN_TARGETS[impact.NATIVE_SMOKE], smoke_summary)
    conformance, agreement = plan.corpus()
    for kind, name, summarize in (('conformance', f'conformance of {len(conformance)} corpus cases', conformance_summary),
                                  ('agree', f'agreement: the seed-1 sample\'s variants of {len(agreement)} corpus cases',
                                   chosen_agreement_summary)):
        selected = [t for t in campaigns if gating.short(t).startswith(f'gate-{kind}-selected-')]
        if selected:
            campaign_row(report, name, results, selected, summarize)
    if plan.native:
        campaign_row(report, f'LLVM smoke matrix and Cranelift parity of {len(plan.native)} programs', results,
                     gating.NATIVE_TARGETS, smoke_summary)
    test_rows(report, results, tests)
    if status and report.passed and not report.excluded:
        report.add(False, f'buck2 test exited {status}', [gating.last_lines(Path(log).read_text(errors='replace'), 30)])


def gate(base_ref, tokens):
    started = time.monotonic()
    base = gating.merge_base(base_ref)
    if refused := gating.generated.refusal(gating.changed_paths(base, deleted=False)):
        for line in refused:
            say('gate: ' + line)
        return 1
    selection = gating.Selection(base)
    say(f'gate: {len(selection.paths)} changed paths from {base[:12]}')
    report = Report(known=gating.known_failures())
    for error in gating.policy_errors():
        report.add(False, error)
    c = selection.classified
    if c.docs and not tokens:
        status, output = docs_check(base, c.docs, selection.paths)
        report.add(status == 0, f'documentation: links and whitespace in {len(c.docs)} files', [output])
    local = gating.Local()
    for name, command in ([] if tokens else local_checks(selection)):
        local.start(name, command)
    plan = selection.choose(tokens or [gating.SUGGESTED])
    plan.settle()
    show_plan(plan)
    if plan.tests or plan.campaign_targets():
        if prepare(report):
            gating.SESSION_CONFIG[:] = plan.config()
            git_dir = Path(gating.git('rev-parse', '--absolute-git-dir').strip())
            run_plan(report, plan, git_dir / 'hirsel-gate.log')
    local_rows(report, local.finish())
    report.print(time.monotonic() - started)
    return 0 if report.passed else 1


# ---------------------------------------------------------------- full

# The full gate's record for tools/main-runs: each stage's Buck2 event logs in
# its own directory under $HIRSEL_FULL_LOGS, and one row per stage in
# stages.jsonl there.
FULL_LOGS = 'HIRSEL_FULL_LOGS'
# A stage's probe reruns some of its failed Buck2 targets alone (main-runs' bisect).
TARGETS = '{targets}'
# Stages the full gate skips until their owner fixes what stops them, one row
# each: stage (as the gate names it), reason, owner lane, date. Removing the
# row runs the stage again.
SKIPPED_STAGES = 'tools/main-runs-skip.tsv'
SKIP_COLUMNS = ('stage', 'reason', 'owner', 'date')


def skipped_stages(root=ROOT):
    """The skip list's rows by stage."""
    path = root / SKIPPED_STAGES
    rows = {}
    for number, line in enumerate(path.read_text().splitlines() if path.is_file() else [], 1):
        if not line.strip() or line.startswith('#'):
            continue
        fields = [field.strip() for field in line.split('\t')]
        if len(fields) != len(SKIP_COLUMNS) or not all(fields):
            raise SystemExit(f'gate: {SKIPPED_STAGES}:{number}: a row is {", ".join(SKIP_COLUMNS)}, separated by tabs')
        rows[fields[0]] = dict(zip(SKIP_COLUMNS, fields))
    return rows


class Stages:
    """Run every stage, report each, and fail after the last if any failed."""

    def __init__(self):
        self.failed = []
        self.first_status = 0
        self.started = time.monotonic()
        self.logs = Path(os.environ[FULL_LOGS]) if os.environ.get(FULL_LOGS) else None
        self.count = 0
        self.skip = skipped_stages()
        self.seen = set()

    def run(self, stage, command, *, probe=None, tag='', **kwargs):
        """Run one stage. `probe` is the command with TARGETS in place of
        its test targets (none: the stage reruns whole); `tag` tells its
        targets from the same names in other stages (`release`, `full`)."""
        started = time.monotonic()
        self.seen.add(stage)
        if row := self.skip.get(stage):
            say(f'gate: {stage} skipped: {row["reason"]} (owner {row["owner"]}, since {row["date"]}; {SKIPPED_STAGES})')
            if self.logs is not None:
                with open(self.logs / 'stages.jsonl', 'a') as out:
                    out.write(json.dumps(dict(stage=stage, status='skipped', skip=row)) + '\n')
            return 0
        say(f'gate: {stage}')
        self.count += 1
        record = None
        if self.logs is not None:
            slug = re.sub(r'[^a-z0-9]+', '-', stage.lower()).strip('-')
            record = dict(index=self.count, stage=stage, logs=f'{self.count:02d}-{slug}', tag=tag,
                          command=[str(part) for part in command],
                          probe=[str(part) for part in probe] if probe else None)
            (self.logs / record['logs']).mkdir(parents=True, exist_ok=True)
            kwargs['env'] = os.environ | {'HIRSEL_BUCK2_LOG_DIR': str(self.logs / record['logs'])}
        try:
            status = gating.run(command, cwd=ROOT, **kwargs).returncode
        except OSError as error:
            print(f'gate: {stage}: {error}', file=sys.stderr, flush=True)
            status = 127
        seconds = time.monotonic() - started
        if record is not None:
            with open(self.logs / 'stages.jsonl', 'a') as out:
                out.write(json.dumps(record | dict(status=status, seconds=round(seconds, 1))) + '\n')
        if status:
            print(f'gate: {stage} failed (exit {status}, {seconds:.0f} s)', file=sys.stderr, flush=True)
            self.failed.append(stage)
            self.first_status = self.first_status or status
        else:
            say(f'gate: {stage} passed ({seconds:.0f} s)')
        return status

    def finish(self):
        seconds = time.monotonic() - self.started
        if unknown := sorted(set(self.skip) - self.seen):
            print(f'gate: {SKIPPED_STAGES} names no stage of the full gate: {"; ".join(unknown)}', file=sys.stderr, flush=True)
            self.failed.append(SKIPPED_STAGES)
            self.first_status = self.first_status or 1
        if self.failed:
            print(f'gate: {len(self.failed)} failing stages: {";".join(self.failed)}', file=sys.stderr, flush=True)
            print(f'gate: failed ({seconds:.0f} s)', file=sys.stderr, flush=True)
            return self.first_status
        say(f'gate: passed ({seconds:.0f} s)')
        return 0


def full_gate():
    # A fresh seed for the randomly seeded tests (TEST_SEED in tools/buck2/defs.bzl),
    # so the full gate never reuses a cached pass under the per-push seed.
    seed = os.environ.get('HIRSEL_TEST_SEED') or str(int.from_bytes(os.urandom(4), 'little'))
    say(f'gate: randomly seeded tests run with PROPTEST_RNG_SEED={seed}')
    # The campaign stages are targets only under hirsel.full (tools/buck2/defs.bzl).
    config = ['-c', 'hirsel.full=true', '-c', f'hirsel.test_seed={seed}']
    # tools/main-runs queues below the lane gates' 50 (platforms.bzl).
    if priority := os.environ.get('HIRSEL_PRIORITY'):
        config += ['-c', f'hirsel.priority={priority}']
    os.environ['HIRSEL_BUCK2_CONFIG'] = ' '.join(config)
    buck2 = [PY, str(ROOT / 'tools/buck2/event_logs.py')]
    release = ['--target-platforms', '//tools/buck2:release']
    # Buck2's test runner allows a test ten minutes; the campaigns take hours.
    timeout, long = ['--timeout', '1800'], ['--timeout', '14400']

    def query(expression):
        return gating.run([*buck2, 'uquery', *config, expression], cwd=ROOT, capture_output=True,
                              text=True).stdout.split()

    def full_crate_tests(*arguments):
        # Each profile must cover the compiled full-gate inventory once.
        return [PY, 'tools/buck2/full_gate_counts.py', '--run', *buck2, 'test', *config, *arguments,
                '--', *long, '--test-arg=full_gate_', '--test-arg=--ignored']

    def probe(*arguments, after=long):
        return [*buck2, 'test', *config, *arguments, TARGETS, '--', *after]
    full_probe = [*long, '--test-arg=full_gate_', '--test-arg=--ignored']

    stages = Stages()
    for name, command in gating.tool_tests():
        stages.run(f'tool tests: {name}', command)
    stages.run('Buck2 toolchains and pool configuration', [PY, 'tools/buck2/prepare.py'])
    stages.run(BUILD_FILES, [PY, 'tools/buck2/sync.py', '--check'])
    # Only the verdict matters here: the outputs stay on the pool.
    stages.run('workspace build', [*buck2, 'build', *config, '//:', '--materializations', 'none'])
    stages.run('workspace clippy', [PY, 'tools/buck2/clippy.py'])
    stages.run('formatting', [PY, 'tools/buck2/fmt.py', '--check'])
    tests = query(gating.ALL_TESTS)
    libtests = query('kind("_rust_test", //...) - attrfilter(labels, gate, //...)')
    stages.run('workspace tests', [*buck2, 'test', *config, *tests, '--', *timeout], probe=probe(after=timeout))
    stages.run('full gate crate tests', full_crate_tests(*libtests), probe=probe(after=full_probe), tag='full')
    # Sixteen shards of the corpus by path hash; the script prints their summed counts.
    stages.run('conformance validation and ratchet', [PY, 'tools/buck2/conformance.py'], probe=probe())
    # The whole seed-1 catalogue in shards, each under its own timeout (AGREE_FULL_TIMEOUT).
    stages.run('source and IR checker agreement (unrestricted)', [PY, 'tools/buck2/agree.py', '--full'],
               probe=probe())
    stages.run('instruction count budgets', [*buck2, 'test', *config, '//:gate-perf-counts', '--', *timeout],
               probe=probe(after=timeout))
    stages.run('native smoke: heap, x86-64 and real Io replay', [*buck2, 'test', *config, '//:gate-native-smoke', '--', *timeout],
               probe=probe(after=timeout))
    stages.run('release tests', [*buck2, 'test', *config, *release, *tests, '--', *timeout],
               probe=probe(*release, after=timeout), tag='release')
    stages.run('full gate crate tests in release', full_crate_tests(*release, *libtests),
               probe=probe(*release, after=full_probe), tag='release full')
    stages.run('native and Lean checks', ['tools/check-native.sh'])
    from sync import NATIVE_FULL_SHARDS
    native_shards = [f'//:gate-native-full-shard-{i}' for i in range(1, NATIVE_FULL_SHARDS + 1)]
    stages.run('native matrix: both targets and named exclusions', [*buck2, 'test', *config, *native_shards, '--', *long],
               probe=probe())
    # The same catalogue on heap and native code in shards, merged against
    # agree-known.txt (AGREE_NATIVE_FULL_TIMEOUT each).
    stages.run('agreement campaign on heap and native code (unrestricted)',
               [PY, 'tools/buck2/agree.py', '--native-full'], probe=probe())
    stages.run('interpreter passing corpus with independent second hash seed',
               [*buck2, 'test', *config, '//:gate-conformance-hash-seed', '--', *long], probe=probe())
    stages.run('native passing corpus with independent second hash seed',
               [*buck2, 'test', *config, '//:gate-native-hash-sweep', '--', *long], probe=probe())
    return stages.finish()


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument('--bless-perf-counts', action='store_true', help='measure instruction budgets on the pool and rewrite tools/perf-counts.tsv')
    parser.add_argument('--full', action='store_true', help='every stage: the hourly main run, or a brief\'s explicit opt-in')
    parser.add_argument('--base', default='origin/main', help='the change from this commit\'s merge base')
    parser.add_argument('--suggest', action='store_true', help='print the targeted set; run nothing')
    parser.add_argument('--tests', nargs='+', default=[], metavar='TEST', help='run exactly these (forms above)')
    args = parser.parse_args()
    if sum((args.bless_perf_counts, args.full, args.suggest)) > 1:
        parser.error('--suggest, --full and --bless-perf-counts exclude each other')
    if (args.bless_perf_counts or args.full) and (args.tests or args.base != 'origin/main'):
        parser.error('--full and --bless-perf-counts take no other option')
    if args.suggest and args.tests:
        parser.error('--suggest runs nothing; it takes only --base')
    os.chdir(ROOT)
    if args.suggest:
        return suggest(args.base)
    # Only what runs Buck2 owns the worktree's daemon: --suggest must never
    # stop the daemon of a run in this worktree.
    with gating.daemon_lifetime():
        if args.bless_perf_counts:
            return bless_perf_counts()
        if args.full:
            return full_gate()
        return gate(args.base, args.tests)


def bless_perf_counts():
    """Measure on the pool; only this host writes the reviewed baseline diff."""
    import runpy
    counts = runpy.run_path(str(ROOT / 'tools/perf-counts'))
    os.chdir(ROOT)
    result = gating.run([PY, str(ROOT / 'tools/buck2/prepare.py')], cwd=ROOT)
    if result.returncode:
        return result.returncode
    with tempfile.TemporaryDirectory(prefix='hirsel-perf-bless-') as directory:
        event_log = Path(directory) / 'events.pb.zst'
        result = gating.buck2('test', '--event-log', str(event_log), '//:gate-perf-counts',
                              '--', '--test-arg=--record')
        if result.returncode:
            return result.returncode
        measured = gating.test_results(event_log).get('gate-perf-counts')
        if not measured or measured['status'] != gating.PASS:
            say('perf-counts: no passing pool result; baseline unchanged')
            return 1
        records = [line.removeprefix(counts['MARKER']) for line in measured['details'].splitlines()
                   if line.startswith(counts['MARKER'])]
        if len(records) != 1:
            say('perf-counts: no unique measurement record; baseline unchanged')
            return 1
        baseline = ROOT / 'tools/perf-counts.tsv'
        baseline.write_text(counts['table'](json.loads(records[0])))
        subprocess.run(['git', 'diff', '--stat', '--', str(baseline)], cwd=ROOT, check=True)
        say('perf-counts: regenerated tools/perf-counts.tsv; review its diff before committing')
    return 0


if __name__ == '__main__':
    sys.exit(main())
