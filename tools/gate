# ---------------------------------------------------------------- documentation

LINK = re.compile(r'\]\(<?([^)\s>]+)>?(?:\s+"[^"]*")?\)')


def link_target(document, link):
    """The repository path a relative Markdown link names, or None for a URL or an anchor."""
    if re.match(r'^[a-z][a-z0-9+.-]*:', link) or link.startswith('#'):
        return None
    link = link.split('#')[0]
    base = ROOT if link.startswith('/') else (ROOT / document).parent
    return (base / link.lstrip('/')).resolve()


def docs_check(base, documents, paths):
    """Links added to the changed documents resolve, links anywhere into a deleted
    path are gone, and the documents add no whitespace errors."""
    errors = []
    for document in documents:
        path = ROOT / document
        if not path.is_file() or not document.endswith('.md'):
            continue
        tracked = gating.run(['git', 'cat-file', '-e', f'{base}:{document}'], cwd=ROOT,
                                 capture_output=True).returncode == 0
        added = (gating.git('diff', '-U0', base, '--', document) if tracked else path.read_text())
        lines = [line[1:] for line in added.splitlines() if line.startswith('+') and not line.startswith('+++')] \
            if tracked else added.splitlines()
        for line in lines:
            for link in LINK.findall(line):
                target = link_target(document, link)
                if target is not None and not target.exists():
                    errors.append(f'{document}: link {link} names nothing')
    deleted = {(ROOT / p).resolve() for p in paths if not (ROOT / p).exists()}
    if deleted:
        for document in gating.git('ls-files', '*.md').split():
            text = (ROOT / document).read_text(errors='replace') if (ROOT / document).is_file() else ''
            for link in LINK.findall(text):
                target = link_target(document, link)
                if target in deleted:
                    errors.append(f'{document}: link {link} names a deleted path')
    whitespace = gating.run(['git', 'diff', '--check', base, '--', *documents], cwd=ROOT,
                                capture_output=True, text=True)
    if whitespace.returncode:
        errors.append(whitespace.stdout.strip())
    return (1 if errors else 0), '\n'.join(errors)


# ---------------------------------------------------------------- per push

class Report:
    def __init__(self, known=None):
        self.rows = []      # (passed, label, detail lines)
        self.started = time.monotonic()
        self.first_failure = None   # seconds from the start to the first failed row
        self.known = known or {}    # gating.known_failures()
        self.excluded = []          # (target, KnownFailure) a failure matched
        self.skipped = set()        # targets the gate stopped before

    def add(self, passed, label, details=()):
        if not passed and self.first_failure is None:
            self.first_failure = time.monotonic() - self.started
        self.rows.append((passed, label, [d for d in details if d]))

    def known_failure(self, target, result):
        """Whether a failed target failed only in known failures: then it
        passes, with each exclusion named in its row."""
        found = gating.known_only(target, result['details'], self.known) if result else None
        if found:
            self.excluded += [(target, failure) for failure in found]
            self.add(True, f'{target} ({gating.STATUS.get(result["status"], result["status"])}, known failures only)',
                     [failure.describe() for failure in found])
        return bool(found)

    @property
    def passed(self):
        return all(passed for passed, _, _ in self.rows)

    def print(self, seconds):
        say(f'gate: summary ({seconds:.0f} s)')
        for passed, label, details in self.rows:
            say(f'  {"pass" if passed else "FAIL"}  {label}')
            for detail in details:
                say('        ' + detail.replace('\n', '\n        '))
        failed = sum(not passed for passed, _, _ in self.rows)
        say(f'gate: {"passed" if not failed else f"failed: {failed} of {len(self.rows)}"} ({seconds:.0f} s)')


def local_rows(report, results):
    for name, command, status, output, seconds in results:
        details = [] if status == 0 else [gating.last_lines(output, 20), 'rerun: ' + ' '.join(
            str(part).replace(str(ROOT) + '/', '') for part in command)]
        report.add(status == 0, f'{name} ({seconds:.0f} s)', details)


def campaign_row(report, name, results, targets, summarize):
    shards = [results.get(gating.short(t)) for t in targets]
    seconds = max((r['seconds'] for r in shards if r), default=0)
    if any(gating.short(t) in report.skipped for t in targets):
        return
    failed = [(gating.short(t), r) for t, r in zip(targets, shards) if not r or r['status'] != gating.PASS]
    if failed:
        for target, result in failed:
            if report.known_failure(target, result):
                continue
            if result is None:
                report.add(False, f'{target}: no result (see the build failures and the log)')
            else:
                report.add(False, f'{target} ({gating.STATUS.get(result["status"], result["status"])}, '
                           f'{result["seconds"]:.0f} s)', gating.rerun(target, result['details']))
        return
    try:
        summary = summarize({gating.short(t): results[gating.short(t)]['details'] for t in targets})
    except (ValueError, KeyError, TypeError) as error:
        report.add(False, f'{name}: {error}')
        return
    report.add(True, f'{name}: {len(targets)} target{"s" * (len(targets) > 1)} (slowest {seconds:.0f} s)', summary)


def conformance_summary(outputs):
    return conformance.summarize(outputs, len(outputs))


def agreement_summary(outputs):
    total = agree.summarize(outputs)
    return [f'{total["checked"]} variants checked, {total["skipped"]} skipped, 0 flagged']


def chosen_agreement_summary(outputs):
    total = agree.summarize_within(outputs)
    return [f'{total["checked"]} variants checked, {total["skipped"]} skipped, 0 flagged']


def smoke_summary(outputs):
    return []


def test_rows(report, results, tests):
    for target in tests:
        name = gating.short(target)
        result = results.get(name)
        if name in report.skipped:
            continue
        if result is None:
            report.add(False, f'{name}: no result (see the build failures and the log)')
        elif result['status'] in (gating.PASS, gating.SKIP, gating.OMITTED):
            report.add(True, f'{name} ({result["seconds"]:.0f} s)')
        elif not report.known_failure(name, result):
            report.add(False, f'{name} ({gating.STATUS.get(result["status"], result["status"])}, '
                       f'{result["seconds"]:.0f} s)', gating.rerun(name, result['details']))


def prepare(report):
    started = time.monotonic()
    result = gating.run([PY, str(ROOT / 'tools/buck2/prepare.py')], cwd=ROOT, capture_output=True, text=True)
    if result.returncode:
        report.add(False, 'Buck2 toolchains and pool configuration', [gating.last_lines(result.stdout + result.stderr)])
        return False
    say(f'gate: Buck2 prepared ({time.monotonic() - started:.0f} s)')
    return True


def build_only(report, log):
    """The build and formatting check of a change that already passed."""
    local = gating.Local()
    local.start('formatting', [PY, str(ROOT / 'tools/buck2/fmt.py'), '--check'])
    targets = gating.uquery(gating.BUILD_SET)
    started = time.monotonic()
    with open(log, 'w') as out:
        status = gating.buck2('build', '--materializations', 'none', *targets, stdout=out, stderr=subprocess.STDOUT).returncode
    report.add(status == 0, f'workspace build: {len(targets)} targets ({time.monotonic() - started:.0f} s)',
               [] if status == 0 else [gating.last_lines(Path(log).read_text(errors='replace'), 30)])
    local_rows(report, local.finish())


def show_plan(plan, indent='  '):
    """A plan's parts, one line each."""
    lines = []
    if plan.tests:
        names = sorted({re.sub(r'-shard-\d+$', '', gating.short(t)) for t in plan.tests})
        lines.append(f'{len(plan.tests)} test targets: ' + ' '.join(names))
    for name, campaign in gating.WHOLE.items():
        if campaign in plan.campaigns:
            lines.append(f'{name}: the whole campaign')
    for label, cases in (('conformance', plan.conformance), ('agreement', plan.agreement)):
        if cases:
            shown = sorted(cases)
            lines.append(f'{label}: {len(shown)} corpus cases: ' + ' '.join(shown[:8])
                         + (f' and {len(shown) - 8} more' if len(shown) > 8 else ''))
    if plan.native:
        lines.append(f'native: {len(plan.native)} programs on both backends: ' + ' '.join(sorted(plan.native)[:8]))
    for line in lines or ['nothing']:
        say(indent + line)


def suggest(base_ref):
    """Print the floor and what the change can affect; run nothing."""
    base = gating.merge_base(base_ref)
    identity = gating.change_identity(base)
    if not identity:
        say(f'gate: the worktree does not differ from {base[:12]}; nothing to check')
        return 0
    # Static: the changed paths, the root BUCK (graph.py) and the import
    # graphs, with no Buck2, so a suggestion never waits on a daemon.
    selection = gating.Selection(base)
    say(f'gate: {len(selection.paths)} changed paths from {base[:12]} (change {identity[:12]})')
    floor = selection.floor()
    floor.settle()
    say('gate: the floor (every gate runs it, after formatting, Clippy and the workspace build):')
    show_plan(floor)
    plan = selection.suggest()
    plan.settle()
    say('gate: suggested (tools/buck2/impact.py), beyond the floor:')
    show_plan(plan)
    for token, why in plan.reasons:
        say(f'    {token}: {why}')
    say('gate: run it all with: tools/gate --tests suggested --why "<one line>"; or name the parts you need')
    return 0


def local_checks(report, local, base, selection):
    """The floor's checks on this host that need no Buck2."""
    c = selection.classified
    if c.docs:
        status, output = docs_check(base, c.docs, selection.paths)
        report.add(status == 0, f'documentation: links and whitespace in {len(c.docs)} files', [output])
    if c.tools or c.everything:
        for name, command in gating.tool_tests():
            local.start(name, command)
    elif c.owned:
        # A crate edit can add an ignored test that no gate runs.
        local.start('tools/tests/ignored_tests.py', [PY, str(ROOT / 'tools/tests/ignored_tests.py')])
    for name, command in impact.proof_checks(selection.paths):
        local.start(name, command)


def build_first(report, log):
    """Formatting, Clippy and the workspace build: False stops the gate before any test."""
    local = gating.Local()
    local.start('formatting', [PY, str(ROOT / 'tools/buck2/fmt.py'), '--check'])
    build = gating.uquery(gating.BUILD_SET)
    clippy = gating.uquery(gating.CLIPPY_SET)
    started = time.monotonic()
    with tempfile.TemporaryDirectory() as scratch:
        build_report = Path(scratch) / 'build.json'
        with open(log, 'w') as out:
            status = gating.buck2('build', '--materializations', 'none', '--build-report', str(build_report),
                                  *build, *[t + '[clippy.txt]' for t in clippy],
                                  stdout=out, stderr=subprocess.STDOUT).returncode
        failures = gating.build_failures(build_report)
    for target, error in sorted(failures.items()):
        report.add(False, f'build of {target} failed', [gating.last_lines(error, 30),
                                                         f'.buck2/bin/buck2 build //:{target}'])
    report.add(status == 0, f'workspace build and Clippy: {len(build)} targets and {len(clippy)} Clippy twins '
               f'({time.monotonic() - started:.0f} s)',
               [] if status == 0 or failures else [gating.last_lines(Path(log).read_text(errors='replace'), 30)])
    if status == 0:
        ok, text = gating.clippy_report(clippy)
        report.add(ok, 'Clippy', [] if ok else [gating.last_lines(text, 40)])
    local_rows(report, local.finish())
    return report.passed


def run_plan(report, plan, log, previous=None):
    """The floor's tests and the chosen ones, as one Buck2 invocation."""
    tests = sorted(plan.tests)
    campaigns = plan.campaign_targets()
    targets = tests + campaigns
    names = {gating.short(t) for t in targets}
    # The caller supplies results only for the same change identity and settings.
    # Campaign output stays available for the aggregate count/agreement checks.
    results = {name: result for name, result in (previous or {}).items()
               if result['status'] == gating.PASS and name in names}
    pending = [t for t in targets if gating.short(t) not in results]
    if results:
        say(f'gate: reusing {len(results)} passed targets for this change')
    # The chosen corpus cases first: they are quick, and a failure among them
    # stops the gate before the long targets.
    first = [t for t in pending if gating.short(t).startswith('gate-conformance-selected-')]
    stages = [first, [t for t in pending if t not in first]] if first else [pending]
    status = 0
    for number, stage in enumerate(stages, 1):
        if not stage:
            continue
        if number == 2:
            failed = [gating.short(t) for t in first if results.get(gating.short(t), {}).get('status') != gating.PASS
                      and not gating.known_only(gating.short(t), results.get(gating.short(t), {}).get('details', ''),
                                                report.known)]
            if failed:
                report.skipped = {gating.short(t) for t in stage}
                break
        status = invoke(report, stage, log, results, first=number == 1 and len(stages) > 1) or status
    for campaign, name, summarize in ((impact.CONFORMANCE, 'conformance', conformance_summary),
                                      (impact.AGREEMENT, f'agreement ({agree.AGREE_LIMIT} variants)', agreement_summary),
                                      (impact.NATIVE_SMOKE, 'native smoke', smoke_summary)):
        if campaign in plan.campaigns:
            campaign_row(report, name, results, gating.CAMPAIGN_TARGETS[campaign], summarize)
    selected = [t for t in campaigns if '-selected-shard-' in t]
    for kind, name, summarize in (('conformance', f'conformance of {len(plan.conformance)} chosen cases', conformance_summary),
                                  ('agree', f'agreement: the seed-1 sample\'s variants of {len(plan.agreement)} chosen cases',
                                   chosen_agreement_summary)):
        targets = [t for t in selected if gating.short(t).startswith(f'gate-{kind}-selected-')]
        if targets:
            campaign_row(report, name, results, targets, summarize)
    if plan.native:
        campaign_row(report, f'LLVM smoke matrix and Cranelift parity of {len(plan.native)} programs', results,
                     gating.NATIVE_TARGETS, smoke_summary)
    test_rows(report, results, tests)
    if report.skipped:
        report.add(False, f'{len(report.skipped)} targets not run: the chosen corpus cases failed first',
                   ['fix them, then tools/gate --extend: the passed targets are reused'])
    if status and report.passed and not report.excluded:
        report.add(False, f'buck2 test exited {status}', [gating.last_lines(Path(log).read_text(errors='replace'), 30)])
    return results


def invoke(report, targets, log, results, *, first=False):
    """One Buck2 test invocation of these targets, its results added to `results`."""
    say(f'gate: one Buck2 invocation: {len(targets)} pending targets'
        + (' (the chosen corpus cases, first)' if first else ''))
    say(f'gate: Buck2 output: {log}')
    with tempfile.TemporaryDirectory() as scratch, gating.event_logs.recorded('gate') as event_log:
        build_report = Path(scratch) / 'build.json'
        with open(log, 'a') as out:
            invoked = time.monotonic()
            status = gating.buck2('test', '--event-log', str(event_log), '--build-report', str(build_report),
                                  *targets, '--', '--timeout', str(gating.TIMEOUT),
                                  stdout=out, stderr=subprocess.STDOUT).returncode
        wall = time.monotonic() - invoked
        results.update(gating.test_results(event_log) if event_log.exists() else {})
        failures = gating.build_failures(build_report)
    for target, error in sorted(failures.items()):
        report.add(False, f'build of {target} failed', [gating.last_lines(error, 30),
                                                         f'.buck2/bin/buck2 build //:{target}'])
    say(f'gate: tests finished ({wall:.0f} s)')
    return status


def push_gate(base_ref, tokens, why, extend):
    started = time.monotonic()
    base = gating.merge_base(base_ref)
    identity = gating.change_identity(base)
    if not identity:
        say(f'gate: the worktree does not differ from {base[:12]}; nothing to check')
        return 0
    selection = gating.Selection(base)
    say(f'gate: {len(selection.paths)} changed paths from {base[:12]} (change {identity[:12]})')
    errors = gating.policy_errors()
    report = Report(known=gating.known_failures())
    for error in errors:
        report.add(False, error)
    if errors:
        report.print(time.monotonic() - started)
        return 1
    log = gating.green_path().with_name('hirsel-gate.log')
    if gating.is_green(identity, selection.crates) and not tokens:
        say('gate: this change already passed; main moved under it and it rebased cleanly, '
            'so only the workspace build and formatting run')
        # The cheap floor alone, which takes no slot.
        if prepare(report):
            build_only(report, log)
        report.print(time.monotonic() - started)
        return 0 if report.passed else 1
    digests = gating.path_digests(base)
    extended = None
    resumed = gating.green_records().get(identity) if extend else None
    if resumed is not None and resumed.get('crates') != sorted(selection.crates):
        resumed = None
    if resumed is not None:
        say('gate: resuming the recorded targets for this change; local checks run again')
        tokens = list(dict.fromkeys(resumed.get('tokens', []) + list(tokens)))
        scope = gating.Selection(base, paths=resumed.get('paths', selection.paths))
        extended = resumed.get('extends')
    elif extend:
        extended, record = gating.latest_green()
        if record is None or 'digests' not in record:
            say('gate: --extend needs a change this worktree passed; run tools/gate --tests ... --why ...')
            return 1
        delta = gating.changed_since(record, digests)
        say(f'gate: extending change {extended[:12]} (passed {record["at"]}): {len(delta)} paths differ: '
            + ', '.join(delta[:12]) + (f' and {len(delta) - 12} more' if len(delta) > 12 else ''))
        scope = gating.Selection(base, paths=delta)
    else:
        scope = selection
    c = scope.classified
    for kind, paths in (('documentation', c.docs), ('gate tooling', c.tools), ('build-wide', c.build_wide),
                        ('crates', sorted(c.crates)),
                        ('test code', [p for p in c.owned if p.startswith('crates/') and p.split('/')[1] not in c.crates]),
                        ('other inputs', [p for p in c.owned if not p.startswith('crates/')])):
        if paths:
            say(f'gate: {kind}: ' + ', '.join(paths[:12]) + (f' and {len(paths) - 12} more' if len(paths) > 12 else ''))
    if isinstance(c.buck, set) and c.buck:
        say('gate: BUCK rules changed: ' + ', '.join(sorted(c.buck)))
    say(f'gate: why: {why}')
    local = gating.Local()
    local_checks(report, local, base, scope)
    needs_buck2 = c.needs_buck2 or bool(c.tools) or bool(tokens) or c.everything
    plan = floor = None
    pool = 'none'
    target_results = {}
    floor_seconds = slot_wait = None
    if needs_buck2:
        if not prepare(report):
            local_rows(report, local.finish())
            report.print(time.monotonic() - started)
            return 1
        floor = scope.floor()
        if extended and c.owned:
            # The test targets that own each differing file, beside the floor's.
            floor.tests |= scope.owner_tests(c.owned)
        chosen = scope.choose(tokens)
        plan = gating.Plan()
        plan.add(floor)
        plan.add(chosen)
        for part in (plan, floor, chosen):
            part.settle()
        say('gate: the floor:')
        show_plan(floor)
        if tokens:
            say(f'gate: chosen ({" ".join(tokens)}):')
            show_plan(chosen)
        gating.SESSION_CONFIG[:] = plan.config()
        if resumed is not None and resumed.get('config', []) == plan.config():
            target_results = resumed.get('target_results', {})
        # The cheap floor runs before the queue, so a red floor never waits
        # for a slot: formatting, the build-file check, the workspace build
        # and Clippy, and the local checks.
        floor_passed = build_first(report, log)
        if floor_passed and (c.tools or c.needs_buck2):
            # --check lists compiled cases on the pool, after preparation.
            local.start('Buck2 build files match Cargo', [PY, str(ROOT / 'tools/buck2/sync.py'), '--check'])
        local_rows(report, local.finish())
        local = None
        floor_seconds = time.monotonic() - started
        if not report.passed:
            say('gate: the floor failed (formatting, the build files, the build, Clippy or a local check); '
                'no slot taken and no test ran')
        elif not plan.tests and not plan.campaign_targets():
            say(f'gate: no Buck2 test to run; the floor passed in {floor_seconds:.0f} s, so no slot is taken')
        else:
            pool = plan.slot_pool()
            say(f'gate: pool: {pool}; the floor passed in {floor_seconds:.0f} s')
            gating.stop_daemons()
            with gating.gate_slot(pool=pool, stamp=queue_stamp(identity, extend)) as timing:
                slot_wait = timing.wait_seconds if timing else 0
                target_results = run_plan(report, plan, log, target_results)
    if local is not None:
        local_rows(report, local.finish())
    if report.excluded:
        say('gate: known failures excluded (tools/known-failures.tsv on origin/main):')
        for target, failure in report.excluded:
            say(f'  {target}: {failure.describe()}')
    report.print(time.monotonic() - started)
    if gating.change_identity(base) == identity:
        ran = plan.summary() if plan else []
        floored = floor.summary() if floor else []
        if extended and resumed is None:
            # The extended change keeps what its first pass ran.
            ran = record.get('selection', []) + [part for part in ran if part not in record.get('selection', [])]
            floored = record.get('floor', []) + [part for part in floored if part not in record.get('floor', [])]
            why = f'{why} (extending: {record.get("why", "")})'
        if resumed is not None:
            ran = list(dict.fromkeys(resumed.get('selection', []) + ran))
            floored = list(dict.fromkeys(resumed.get('floor', []) + floored))
            extended = resumed.get('extends')
            why = f'{why} (resuming: {resumed.get("why", "")})'
        gating.record_gate(identity, selection.crates, passed=report.passed, why=why, tokens=list(tokens),
                           selection=ran, floor=floored, digests=digests, extends=extended, pool=pool,
                           paths=scope.paths, target_results=target_results, config=plan.config() if plan else [])
    else:
        say('gate: the worktree changed while the gate ran; not recording its results')
    forget_queue_stamp()
    log_gate(identity, pool, report, floor_seconds, slot_wait, time.monotonic() - started)
    return 0 if report.passed else 1


def queue_stamp(identity, extend):
    """The queue place of this worktree's unfinished gate, kept when it is
    restarted with the same change identity or extended: the time it first
    queued. A gate that finishes forgets it."""
    path = gating.green_path().with_name(QUEUE_STAMP)
    try:
        saved = json.loads(path.read_text())
    except (OSError, ValueError):
        saved = None
    now = time.time_ns()
    if saved and (saved.get('identity') == identity or extend) and now - saved.get('stamp', 0) < STAMP_LIFETIME:
        say(f'gate: keeping this worktree\'s place in the queue from {time.strftime("%H:%M:%S", time.localtime(saved["stamp"] / 1e9))}')
        stamp = saved['stamp']
    else:
        stamp = now
    path.write_text(json.dumps(dict(identity=identity, stamp=stamp)) + '\n')
    return stamp


def forget_queue_stamp():
    gating.green_path().with_name(QUEUE_STAMP).unlink(missing_ok=True)


def log_gate(identity, pool, report, floor_seconds, slot_wait, seconds):
    """Append the gate's timings to `hirsel-gates.jsonl` in the clone's common
    git directory: floor, queue wait, time to the first failure, total."""
    common = Path(gating.git('rev-parse', '--path-format=absolute', '--git-common-dir').strip())
    entry = dict(at=time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime()), identity=identity, pool=pool,
                 branch=gating.git('branch', '--show-current').strip(), passed=report.passed,
                 floor_seconds=floor_seconds, slot_wait_seconds=slot_wait, first_failure_seconds=report.first_failure,
                 seconds=seconds, known_failures=[failure.id for _, failure in report.excluded],
                 skipped_targets=len(report.skipped))
    with open(common / GATES_LOG, 'a') as log:
        log.write(json.dumps(entry, sort_keys=True) + '\n')


