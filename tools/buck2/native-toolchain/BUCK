load("//tools/native-toolchain:pins.bzl", "LINK_KIT", "LLVM_DEBS", "NATIVE", "VALGRIND_DEBS")
load(":defs.bzl", "link_kit", "toolchain_proof", "unpack_toolchain")

[http_file(name = "llvm-deb-{}".format(i), urls = [pin["url"]], sha256 = pin["sha256"], size_bytes = pin["size"]) for i, pin in enumerate(LLVM_DEBS)]
[http_file(name = name + "-archive", urls = [pin["url"]], sha256 = pin["sha256"], size_bytes = pin["size"]) for name, pin in NATIVE.items()]

[http_file(name = "valgrind-runtime-{}".format(i), urls = [pin["url"]], sha256 = pin["sha256"], size_bytes = pin["size"]) for i, pin in enumerate(VALGRIND_DEBS)]

unpack_toolchain(
    name = "llvm", kind = "llvm",
    archives = [":llvm-deb-{}".format(i) for i in range(len(LLVM_DEBS))],
    visibility = ["PUBLIC"],
)
[unpack_toolchain(name = name, kind = name, archives = [":" + name + "-archive"] + ([":valgrind-runtime-{}".format(i) for i in range(len(VALGRIND_DEBS))] if name == "valgrind" else []),
    visibility = ["PUBLIC"]) for name in NATIVE]

[http_file(name = "link-kit-" + name.replace(":", "-"), urls = [pin["url"]], sha256 = pin["sha256"], size_bytes = pin["size"]) for name, pin in LINK_KIT.items()]

link_kit(
    name = "kit", llvm = ":llvm", pins = LINK_KIT,
    sources = {name: ":link-kit-" + name.replace(":", "-") for name in LINK_KIT},
    visibility = ["PUBLIC"],
)

# The kit's glibc 2.28 release libraries and loaders, for running executables at
# the floor (never a link input).
unpack_toolchain(
    name = "glibc_floor", kind = "glibc-floor",
    archives = [":link-kit-glibc-amd64", ":link-kit-glibc-arm64"],
    visibility = ["PUBLIC"],
)

export_file(name = "unpack.py")
export_file(name = "link_kit.py")
toolchain_proof(name = "proof", tools = [":llvm", ":arm", ":qemu", ":valgrind"], script = "proof.sh")
export_file(name = "environment.tsv", visibility = ["PUBLIC"])

toolchain_proof(name = "native-compilation-proof", tools = [":llvm", ":kit", "root//:hirsel-rt-archives", "root//:hirsel-driver-test-it-harness"], script = "native_compilation_proof.sh")
