load(":platforms.bzl", "declare_platforms")
load(":host_transition.bzl", "host_transition")

declare_platforms(
    name = "platforms",
    constraints = ["prelude//os:linux", "prelude//cpu:x86_64"],
)

constraint_setting(name = "sanitizer", visibility = ["PUBLIC"])
constraint_value(name = "sanitizer_thread", constraint_setting = ":sanitizer", visibility = ["PUBLIC"])
platform(
    name = "thread",
    constraint_values = ["prelude//os/constraints:linux", "prelude//cpu/constraints:x86_64", ":profile_dev", ":sanitizer_thread"],
    visibility = ["PUBLIC"],
)

constraint_setting(name = "profile")

constraint_value(name = "profile_dev", constraint_setting = ":profile", visibility = ["PUBLIC"])

constraint_value(name = "profile_release", constraint_setting = ":profile", visibility = ["PUBLIC"])

# Native runtime: LTO with cold launch/configuration crates built for size.
constraint_value(name = "profile_runtime", constraint_setting = ":profile", visibility = ["PUBLIC"])

constraint_value(name = "profile_checked", constraint_setting = ":profile", visibility = ["PUBLIC"])

constraint_value(name = "profile_profiling", constraint_setting = ":profile", visibility = ["PUBLIC"])

# Distribution builds trade build time for compiler throughput. Dev/release stay unchanged.
constraint_value(name = "profile_dist", constraint_setting = ":profile", visibility = ["PUBLIC"])

platform(
    name = "dist",
    constraint_values = [
        "prelude//os/constraints:linux",
        "prelude//cpu/constraints:x86_64",
        ":profile_dist",
    ],
    visibility = ["PUBLIC"],
)

# Release code with line information and walkable stacks for perf.
platform(
    name = "profiling",
    constraint_values = [
        "prelude//os/constraints:linux",
        "prelude//cpu/constraints:x86_64",
        ":profile_profiling",
    ],
    visibility = ["PUBLIC"],
)

# Compiler tools and harnesses share one optimized, checked configuration.
platform(
    name = "checked",
    constraint_values = [
        "prelude//os/constraints:linux",
        "prelude//cpu/constraints:x86_64",
        ":profile_checked",
    ],
    visibility = ["PUBLIC"],
)

host_transition(
    name = "test_tool_transition",
    preserve_sanitizer = True,
    configuration_name = "root//tools/buck2:checked",
    budget = ":budget",
    panic = ":panic",
    profile = ":profile_checked",
    cpu = "prelude//cpu/constraints:x86_64",
    visibility = ["PUBLIC"],
)

# Performance budgets measure the production compiler, without test assertions.
host_transition(
    name = "release_tool_transition",
    configuration_name = "root//tools/buck2:release",
    budget = ":budget",
    panic = ":panic",
    profile = ":profile_release",
    cpu = "prelude//cpu/constraints:x86_64",
    visibility = ["PUBLIC"],
)

# The default target platform: Cargo's dev profile.
platform(
    name = "dev",
    constraint_values = [
        "prelude//os/constraints:linux",
        "prelude//cpu/constraints:x86_64",
        ":profile_dev",
    ],
    visibility = ["PUBLIC"],
)

constraint_setting(name = "panic")

constraint_value(name = "panic_abort", constraint_setting = ":panic", visibility = ["PUBLIC"])

# The runtime archives' configurations (`hirsel_runtime_archives` in defs.bzl).
platform(
    name = "runtime-x86_64",
    constraint_values = [
        "prelude//os/constraints:linux",
        "prelude//cpu/constraints:x86_64",
        ":profile_runtime",
        ":panic_abort",
    ],
    visibility = ["PUBLIC"],
)

platform(
    name = "runtime-aarch64",
    constraint_values = [
        "prelude//os/constraints:linux",
        "prelude//cpu/constraints:arm64",
        ":profile_runtime",
        ":panic_abort",
    ],
    visibility = ["PUBLIC"],
)

# Cargo's release profile: `--target-platforms //tools/buck2:release`.
platform(
    name = "release",
    constraint_values = [
        "prelude//os/constraints:linux",
        "prelude//cpu/constraints:x86_64",
        ":profile_release",
    ],
    visibility = ["PUBLIC"],
)

