#!/usr/bin/env python3
"""Run one local command under a hard memory cap, a CPU quota and a timeout.

    tools/capped [--long] [--timeout SECONDS] <command> [arguments...]

The sanctioned way to run anything outside Buck2 on a shared host (a built
`hirsel`, `hirsel-conformance`, a probe): the command runs in a systemd user
scope with `MemoryMax=$HIRSEL_MEMORY_LIMIT` (default 4G), `MemorySwapMax=0`
and `CPUQuota` of `$HIRSEL_JOBS` CPUs (default 2), under a timeout (default
300 s). Where no user manager is reachable (a sandbox without its bus), it
falls back to process limits: RLIMIT_DATA at the cap, RLIMIT_NPROC near the
user's current process count, and CPU affinity to $HIRSEL_JOBS CPUs; the
report names the mechanism that applied. The command sees the same HIRSEL_MEMORY_LIMIT and HIRSEL_JOBS, so a
hirsel binary's own guard (crates/hirsel-guard) caps itself identically.
Runs share numbered slots: MemAvailable / MemoryMax at startup, clamped to
2..8, or HIRSEL_CAPPED_SLOTS. --long uses a separate single slot and is required
for timeouts over 900 s. Queued runs report holders and their wait. At exit it prints the
scope's peak memory, wall time and exit status to stderr. A run that reaches
the cap or the timeout is a finding: report the program and its peak, never
raise the cap to make it pass. Many-program runs go through Buck2 test targets.
"""

import argparse
from contextlib import contextmanager
import fcntl
import json
import os
from pathlib import Path
import re
import resource
import shlex
import signal
import subprocess
import sys
import time

DEFAULT_LIMIT = '4G'
DEFAULT_JOBS = '2'
DEFAULT_TIMEOUT = 300
SHORT_TIMEOUT = 900
# The scope's processes get this long to exit after the timeout's SIGTERM.
GRACE = 10
LIMIT = re.compile(r'[1-9][0-9]*[KMGT]?')
UNITS = {'K': 1 << 10, 'M': 1 << 20, 'G': 1 << 30, 'T': 1 << 40}
# Processes the fallback lets the command add to the user's current count.
SPARE_PROCESSES = 1024


def limit_bytes(text: str) -> int:
    """HIRSEL_MEMORY_LIMIT's bytes, read as systemd's MemoryMax and
    crates/hirsel-guard read it: digits with an optional binary K, M, G or T."""
    return int(text[:-1]) * UNITS[text[-1]] if text[-1] in UNITS else int(text)


def mib(count: int) -> str:
    return f'{count / (1 << 20):.0f} MiB'


def slot_count(limit: int, environ) -> int:
    """Host-selected concurrency, or the available-memory default at startup."""
    if 'HIRSEL_CAPPED_SLOTS' in environ:
        value = environ['HIRSEL_CAPPED_SLOTS']
        if not value.isascii() or not value.isdigit() or int(value) < 1:
            raise ValueError(f'HIRSEL_CAPPED_SLOTS={value!r}: expected a positive slot count')
        return int(value)
    try:
        available = next(int(line.split()[1]) * 1024
                         for line in Path('/proc/meminfo').read_text().splitlines()
                         if line.startswith('MemAvailable:'))
    except (OSError, ValueError, IndexError, StopIteration):
        return 2
    return max(2, min(8, available // limit))


def holder(lock) -> str:
    """Best-effort diagnostics; only the kernel lock decides slot ownership."""
    try:
        lock.seek(0)
        record = json.load(lock)
        age = max(0, time.monotonic() - record['started'])
        return (f'pid={record["pid"]} cwd={record["cwd"]!r} '
                f'command={shlex.join(record["command"])} age={age:.1f} s')
    except (OSError, ValueError, KeyError, TypeError):
        return 'holder metadata unavailable'


@contextmanager
def slot(directory: Path, count: int, command: list[str], long: bool = False):
    """Lease one flock slot, automatically released even if its process dies.

    Never unlink slot files: a waiter may already have the inode open. Stale
    metadata is overwritten after acquisition, without trusting a reused pid.
    """
    prefix = f'hirsel-capped-{os.getuid()}'
    names = [f'{prefix}.long.lock'] if long else [f'{prefix}.slot-{i + 1}.lock' for i in range(count)]
    started = time.monotonic()
    report_at = started
    queued = False
    while True:
        holders = []
        for name in names:
            lock = open(directory / name, 'a+')
            try:
                try:
                    fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
                except BlockingIOError:
                    holders.append(f'{name}: {holder(lock)}')
                    continue
                lock.seek(0)
                lock.truncate()
                json.dump(dict(pid=os.getpid(), cwd=os.getcwd(), command=command,
                               started=time.monotonic()), lock)
                lock.flush()
                if queued:
                    print(f'capped: acquired {name} after waiting {time.monotonic() - started:.1f} s',
                          file=sys.stderr)
                try:
                    yield
                finally:
                    lock.seek(0)
                    lock.truncate()
                return
            finally:
                lock.close()
        now = time.monotonic()
        if now >= report_at:
            print(f'capped: waiting {now - started:.1f} s for a {"long" if long else "short"} slot; '
                  f'holders:\n  ' + '\n  '.join(holders), file=sys.stderr, flush=True)
            report_at = now + 5
        queued = True
        time.sleep(0.1)


def own_cgroup() -> Path | None:
    try:
        for line in Path('/proc/self/cgroup').read_text().splitlines():
            if line.startswith('0::'):
                return Path('/sys/fs/cgroup' + line[3:].rstrip('/'))
    except OSError:
        pass
    return None


def oom_kills(cgroup: Path | None) -> int:
    """The cgroup's count of OOM kills so far (0 when unreadable)."""
    try:
        events = dict(line.split() for line in (cgroup / 'memory.events').read_text().splitlines())
        return int(events.get('oom_kill', '0'))
    except (OSError, TypeError, ValueError):
        return 0


def inside(timeout: int, limit: str, command: list[str], limits=None) -> int:
    """Run the command in its own process group under the timeout, then report
    the peak memory and whether it hit the cap: the scope's when inside one,
    otherwise the largest child's under `limits` (process limits applied in
    the child before it runs the command). Only an OOM kill during this run
    counts, so a cgroup's earlier kills never read as this command's."""
    cgroup = None if limits else own_cgroup()
    kills_before = oom_kills(cgroup)
    start = time.monotonic()
    child = subprocess.Popen(command, start_new_session=True, preexec_fn=limits)
    timed_out = False
    try:
        status = child.wait(timeout)
    except subprocess.TimeoutExpired:
        timed_out = True
        os.killpg(child.pid, signal.SIGTERM)
        try:
            child.wait(GRACE)
        except subprocess.TimeoutExpired:
            os.killpg(child.pid, signal.SIGKILL)
        child.wait()
        status = 124
    except KeyboardInterrupt:
        os.killpg(child.pid, signal.SIGKILL)
        child.wait()
        status = 130
    if status < 0:
        status = 128 - status
    wall = time.monotonic() - start
    peak = 'unknown'
    oom = False
    if limits:
        peak = mib(resource.getrusage(resource.RUSAGE_CHILDREN).ru_maxrss * 1024) + ' RSS'
    elif cgroup:
        try:
            peak = mib(int((cgroup / 'memory.peak').read_text()))
        except (OSError, ValueError):
            pass
        oom = oom_kills(cgroup) > kills_before
    notes = []
    if oom:
        notes.append(f'memory limit {limit} reached (HIRSEL_MEMORY_LIMIT): the kernel killed the command')
    if timed_out:
        notes.append(f'timed out after {timeout} s')
    note = ''.join(f'; {n}' for n in notes)
    mechanism = 'process limits' if limits else 'systemd scope'
    print(f'capped: peak {peak} of {limit} ({mechanism}), {wall:.1f} s, exit {status}{note}', file=sys.stderr)
    return status


def main() -> int:
    parser = argparse.ArgumentParser(
        description='Run one command under the HIRSEL_MEMORY_LIMIT cap, a HIRSEL_JOBS CPU quota and a timeout.')
    parser.add_argument('--timeout', type=int, default=DEFAULT_TIMEOUT, help='seconds (default 300)')
    parser.add_argument('--long', action='store_true',
                        help='use the separate single long-job slot; required for timeouts over 900 s')
    parser.add_argument('--inside', action='store_true', help=argparse.SUPPRESS)
    parser.add_argument('command', nargs=argparse.REMAINDER)
    args = parser.parse_args()
    command = args.command[1:] if args.command[:1] == ['--'] else args.command
    if not command:
        parser.error('a command to run is required')
    if args.timeout <= 0:
        parser.error('--timeout must be positive')
    if args.timeout > SHORT_TIMEOUT and not args.long:
        parser.error('--timeout above 900 s requires --long (the separate long-job slot)')
    limit = os.environ.get('HIRSEL_MEMORY_LIMIT') or DEFAULT_LIMIT
    if not LIMIT.fullmatch(limit):
        parser.error(f'HIRSEL_MEMORY_LIMIT={limit!r}: expected bytes or a K, M, G or T count, for example 4G')
    if args.inside:
        return inside(args.timeout, limit, command)
    jobs = os.environ.get('HIRSEL_JOBS') or DEFAULT_JOBS
    if not jobs.isdigit() or int(jobs) < 1:
        parser.error(f'HIRSEL_JOBS={jobs!r}: expected a positive count of CPUs')
    try:
        slots = slot_count(limit_bytes(limit), os.environ)
    except ValueError as error:
        parser.error(str(error))
    env = dict(os.environ, HIRSEL_MEMORY_LIMIT=limit, HIRSEL_JOBS=jobs)
    # systemd-run --user reaches the user manager through XDG_RUNTIME_DIR.
    runtime = env.setdefault('XDG_RUNTIME_DIR', f'/run/user/{os.getuid()}')
    lock_directory = Path(runtime if os.path.isdir(runtime) else '/tmp')
    with slot(lock_directory, slots, command, args.long):
        if not scope_available(env):
            print('capped: no systemd user manager is reachable; using process limits', file=sys.stderr)
            os.environ.update(HIRSEL_MEMORY_LIMIT=limit, HIRSEL_JOBS=jobs)
            return inside(args.timeout, limit, command, process_limits(limit_bytes(limit), int(jobs)))
        scope = ['systemd-run', '--user', '--scope', '--quiet', '--collect',
                 '-p', f'MemoryMax={limit}', '-p', 'MemorySwapMax=0', '-p', 'OOMPolicy=continue',
                 '-p', f'CPUQuota={int(jobs) * 100}%',
                 '--', sys.executable or 'python3', os.path.abspath(__file__), '--inside', '--timeout', str(args.timeout),
                 *(['--long'] if args.long else []), '--', *command]
        try:
            return subprocess.run(scope, env=env).returncode
        except KeyboardInterrupt:
            return 130


def scope_available(env) -> bool:
    """Whether systemd-run can start a user scope here."""
    try:
        return subprocess.run(['systemd-run', '--user', '--scope', '--quiet', '--collect', '--', 'true'],
                              env=env, capture_output=True, timeout=30).returncode == 0
    except (OSError, subprocess.TimeoutExpired):
        return False


def process_limits(limit: int, jobs: int):
    """The fallback's limits, applied in the child: data at the cap (what
    crates/hirsel-guard sets too; an address-space cap would also count the
    reservations a compiler leaves unused), threads near the user's current
    count, and `jobs` CPUs of the allowed set, chosen by pid to spread runs."""
    # RLIMIT_NPROC counts the user's threads, in every process.
    uid = str(os.getuid())
    processes = 0
    for status in Path('/proc').glob('[0-9]*/status'):
        try:
            fields = dict(line.split(':', 1) for line in status.read_text().splitlines() if ':' in line)
        except OSError:
            continue
        if fields.get('Uid', '').split()[:1] == [uid]:
            processes += int(fields.get('Threads', '1'))
    allowed = sorted(os.sched_getaffinity(0))

    def apply():
        resource.setrlimit(resource.RLIMIT_DATA, (limit, limit))
        resource.setrlimit(resource.RLIMIT_NPROC, (processes + SPARE_PROCESSES,) * 2)
        offset = os.getpid() % len(allowed)
        os.sched_setaffinity(0, [allowed[(offset + i) % len(allowed)] for i in range(min(jobs, len(allowed)))])
    return apply

if __name__ == '__main__':
    sys.exit(main())
