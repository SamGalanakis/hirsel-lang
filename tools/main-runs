#!/usr/bin/env python3
"""Main's test runs on origin/main, each red reported and routed to its likely lane.

    tools/main-runs --tick [--tier fast|full] [--dry-run]

The fast tier (the default) is the build, Clippy, fmt, the workspace and tool
tests; hirsel-main-runs.timer (a systemd user unit, host config) ticks it
every 2 h at pool priority 40 (Nice 10). The full tier is every stage below:
the release gate, run only by hand before milestones. A fast tick skips while
any run is going; a full tick waits for it. A tick skips when origin/main has
not moved since the last run that covered its tier (a full run covers fast);
otherwise it checks main out in the runner's worktree and runs that copy
(--run), so a fix to the runner holds from the next run. --dry-run lists the
tier's stages instead. A run executes its tier's stages except those
tools/main-runs-skip.tsv lists. A red is a failed test, or a failed stage with
none, that tools/known-failures.tsv does not explain. The report
($HIRSEL_MAIN_RUNS/reports/, latest.md) names each red's likely culprit: of
the commits since the last run of its stage, the one that changed most under the red's
crate or its failing corpus cases, with its lane from hirsel-landings.jsonl.
New code reds go to that lane (`sluice tool say`), else to the orchestrator.
Infrastructure reds have no culprit or lane; each run reports them separately
and batches them to the orchestrator. Only code reds enter lane-blame history. Then
docs/api.md is regenerated and, after a full run, the instruction budgets
ratchet down to what gate-perf-counts measured, each pushed straight to main
when it changed.
"""

import fcntl
import json
import os
from pathlib import Path
import re
import runpy
import subprocess
import sys
import tempfile
import time

TREE = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(TREE / 'tools/buck2'))
sys.dont_write_bytecode = True
import event_logs  # noqa: E402
from run_failures import infra_reason  # noqa: E402

PY = sys.executable
RUNS = Path(os.environ.get('HIRSEL_MAIN_RUNS') or Path.home() / '.local/state/hirsel/main-runs')
RUN_TREE, PUSH_TREE = RUNS / 'worktrees/main-runs', RUNS / 'worktrees/main-push'
ROWS = RUNS / 'runs.jsonl'
ORCHESTRATOR = '@agentlang-24'
SLUICE = os.environ.get('HIRSEL_SLUICE', 'sluice')
PASSED = (event_logs.PASS, event_logs.SKIP, event_logs.OMITTED)
PERF_MARKER = 'PERF_COUNTS_RECORD '
# The run's own settings, which the tool tests never inherit.
RUN_VARIABLES = ('HIRSEL_BUCK2_CONFIG', 'HIRSEL_BUCK2_LOG_DIR', 'HIRSEL_PRIORITY', 'HIRSEL_MAIN_RUNS')


def say(message):
    print(f'main-runs: {message}', flush=True)


def git(*arguments, cwd=None):
    return subprocess.run(['git', *arguments], cwd=cwd or TREE, check=True, capture_output=True, text=True).stdout.strip()


def table(path, columns=4):
    """A tab-separated table's rows (comments and blank lines skipped) by first field."""
    lines = path.read_text().splitlines() if path.is_file() else []
    return {f[0]: f for f in (line.split('\t') for line in lines if line.strip() and not line.startswith('#'))
            if len(f) == columns}


def rows():
    return [json.loads(line) for line in ROWS.read_text().splitlines() if line.strip()] if ROWS.exists() else []


def checkout(tree, sha):
    if not (tree / '.git').exists():
        tree.parent.mkdir(parents=True, exist_ok=True)
        git('worktree', 'add', '-f', '--detach', str(tree), sha)
    git('checkout', '-q', '-f', '--detach', sha, cwd=tree)
    git('clean', '-fdq', cwd=tree)


def covers(row, tier):
    return tier == 'fast' or row.get('tier', 'full') == 'full'


def tick(tier):
    RUNS.mkdir(parents=True, exist_ok=True)
    handle = open(RUNS / 'main-runs.lock', 'a+')
    try:
        fcntl.flock(handle, fcntl.LOCK_EX | (fcntl.LOCK_NB if tier == 'fast' else 0))
    except BlockingIOError:
        return say('skip: a run is still going') or 0
    git('fetch', '-q', 'origin', 'main')
    sha = git('rev-parse', 'refs/remotes/origin/main')
    if (covered := [r for r in rows() if covers(r, tier)]) and covered[-1]['sha'] == sha:
        return say(f'skip: the last {tier} run checked origin/main {sha[:12]}') or 0
    checkout(RUN_TREE, sha)
    os.set_inheritable(handle.fileno(), True)  # the lock stays held through the run
    os.execv(PY, [PY, str(RUN_TREE / 'tools/main-runs'), '--run', sha, tier])


def stages(stage, tier):
    """Run the tier's stages, one `stage(name, command)` each: fast is a prefix of full."""
    seed = str(int.from_bytes(os.urandom(4), 'little'))  # a new seed: no cached pass of the seeded tests
    config = ['-c', 'hirsel.full=true', '-c', f'hirsel.test_seed={seed}', '-c', 'hirsel.priority=40']
    os.environ.update(HIRSEL_BUCK2_CONFIG=' '.join(config), HIRSEL_PRIORITY='40')
    buck2 = [PY, 'tools/buck2/event_logs.py']
    release, timeout, long = ['--target-platforms', '//tools/buck2:release'], ['--timeout', '1800'], ['--timeout', '14400']
    stage('Buck2 toolchains and pool configuration', [PY, 'tools/buck2/prepare.py'])
    stage('Buck2 build files and test-cost coverage', [PY, 'tools/buck2/sync.py', '--check'])
    for test in sorted((TREE / 'tools/tests').glob('*.py')):
        stage(f'tool tests: tools/tests/{test.name}', [PY, str(test)], isolated=True)
    stage('tool tests: conformance.py --self-test', [PY, 'tools/buck2/conformance.py', '--self-test'], isolated=True)
    stage('tool tests: bench/native/tests', [PY, '-m', 'unittest', 'discover', '-s', 'bench/native/tests'], isolated=True)

    def query(expression):
        return subprocess.run([*buck2, 'uquery', *config, expression], cwd=TREE, capture_output=True,
                              text=True).stdout.split()
    tests = query('(kind("_rust_test", //...) + attrfilter(labels, doctest, //...)) - attrfilter(labels, gate, //...)')
    libtests = query('kind("_rust_test", //...) - attrfilter(labels, gate, //...)')

    def full_crate_tests(*arguments):
        return [PY, 'tools/buck2/full_gate_counts.py', '--run', *buck2, 'test', *config, *arguments,
                '--', *long, '--test-arg=full_gate_', '--test-arg=--ignored']

    def test(*targets, after=timeout):
        return [*buck2, 'test', *config, *targets, '--', *after]
    from sync import NATIVE_FULL_SHARDS
    stage('workspace build', [*buck2, 'build', *config, '//:', '--materializations', 'none'])
    stage('workspace clippy', [PY, 'tools/buck2/clippy.py'])
    stage('formatting', [PY, 'tools/buck2/fmt.py', '--check'])
    stage('workspace tests', test(*tests))
    if tier == 'fast':
        return
    stage('full gate crate tests', full_crate_tests(*libtests))
    stage('conformance validation and ratchet', [PY, 'tools/buck2/conformance.py'])
    stage('source and IR checker agreement (unrestricted)', [PY, 'tools/buck2/agree.py', '--full'])
    stage('instruction count budgets', test('//:gate-perf-counts'))
    stage('native smoke: heap, x86-64 and real Io replay', test('//:gate-native-smoke'))
    from sync import NATIVE_CORPUS_SHARDS, STD_NATIVE_SHARDS
    stage('std native compile: every public std function on both backends',
          test(*[f'//:gate-std-native-shard-{i}' for i in range(1, STD_NATIVE_SHARDS + 1)]))
    # Cranelift on every runnable case, LLVM O0 on a slice that rotates with the seed.
    stage('native corpus agreement and the GAP-seeded generator',
          test(*[f'//:gate-native-corpus-shard-{i}' for i in range(1, NATIVE_CORPUS_SHARDS + 1)], '//:gate-native-bugs'))
    stage('checker scaling: six families at N=10, 40 and 160',
          test(*[f'//:gate-checker-scaling-shard-{i}' for i in range(1, 7)]))
    stage('release tests', test(*release, *tests))
    stage('full gate crate tests in release', full_crate_tests(*release, *libtests))
    stage('native and Lean checks', ['tools/check-native.sh'])
    stage('native matrix: both targets and named exclusions',
          test('-c', 'hirsel.native_selection=true', *[f'//:gate-native-full-shard-{i}' for i in range(1, NATIVE_FULL_SHARDS + 1)], after=long))
    stage('agreement campaign on heap and native code (unrestricted)', [PY, 'tools/buck2/agree.py', '--native-full'])
    stage('native passing corpus with independent second hash seed', test('//:gate-native-hash-sweep', after=long))


def failing_ids(target, details):
    """What failed in a test: libtest cases as `binary::case`, corpus cases by path."""
    binary = re.sub(r'-shard-\d+$', '', target)
    cases = re.findall(r'^test (\S+)(?: - should panic)? \.\.\. FAILED$', details, re.M)
    cases += re.findall(r'^---- (\S+) stdout ----$', details, re.M)
    ids = [f'{binary}::{case}' for case in cases] + re.findall(r'^(conformance/\S+\.hir): ', details, re.M)
    return list(dict.fromkeys(ids + re.findall(r'"path"\s*:\s*"(conformance/[^"]+\.hir)"', details)))


def run_stages(directory, log, tier):
    """Every stage's verdict: (reds by key, stages run, skipped stages, the perf measurement)."""
    skip, known = table(TREE / 'tools/main-runs-skip.tsv'), table(TREE / 'tools/known-failures.tsv')
    reds, ran, skipped, perf = {}, [], [], []

    def stage(name, command, isolated=False):
        if name in skip:
            return skipped.append(skip[name])
        ran.append(name)
        logs = directory / 'logs' / re.sub(r'[^a-z0-9]+', '-', name.lower()).strip('-')
        logs.mkdir(parents=True, exist_ok=True)
        env = ({k: v for k, v in os.environ.items() if k not in RUN_VARIABLES} if isolated
               else os.environ | {'HIRSEL_BUCK2_LOG_DIR': str(logs)})
        log.write(f'\n== {name}\n')
        log.flush()
        offset = log.tell()
        started = time.monotonic()
        status = subprocess.run(command, cwd=TREE, env=env, stdout=log, stderr=subprocess.STDOUT).returncode
        say(f'{"pass" if status == 0 else "FAIL"}  {name} ({time.monotonic() - started:.0f} s)')
        reason = None
        if status:
            with open(log.name, errors='replace') as output:
                output.seek(offset)
                reason = infra_reason(status) or next((r for line in output if (r := infra_reason(details=line))), None)
        failed, infra = False, False
        for events in sorted(logs.glob('*.pb.zst')):
            for target, result in event_logs.test_results(events).items():
                if target == 'gate-perf-counts' and result['status'] == event_logs.PASS:
                    perf.extend(json.loads(line.removeprefix(PERF_MARKER)) for line in
                                result['details'].splitlines() if line.startswith(PERF_MARKER))
                if result['status'] in PASSED:
                    continue
                failed = True
                ids = failing_ids(target, result['details'])
                test_reason = ('Buck2 Infra Failure' if result['status'] == event_logs.INFRA_FAILURE else
                               infra_reason(details=result['details'], timed_out=result['status'] == event_logs.TIMED_OUT))
                test_reason = test_reason or (reason if not result['details'].strip() else None)
                infra |= test_reason is not None
                if test_reason or not ({target, re.sub(r'-shard-\d+$', '', target)} & known.keys()
                        or ids and all(i in known for i in ids)):
                    reds[f'{name}: {target}'] = dict(stage=name, target=target, ids=ids[:20],
                                                    kind='infra' if test_reason else 'code', reason=test_reason)
        if status and (not failed or reason and not infra):
            reds[f'stage: {name}'] = dict(stage=name, target=None, ids=[], kind='infra' if reason else 'code', reason=reason)
    stages(stage, tier)
    return reds, ran, skipped, perf[0] if len(perf) == 1 else None


def lanes(commits):
    """Each commit's lane: that of the first landing at or after it (a landing row names its tip)."""
    path = Path(git('rev-parse', '--path-format=absolute', '--git-common-dir')) / 'hirsel-landings.jsonl'
    tips = {}
    for line in path.read_text().splitlines() if path.exists() else []:
        row = json.loads(line)
        tips[row.get('landed')] = row.get('branch')
    found, pending = {}, []
    for commit in commits:
        pending.append(commit)
        if commit in tips:
            found.update(dict.fromkeys(pending, tips[commit]))
            pending = []
    return found


def culprit(red, commits, changed):
    """The commit that changed the most files under the red's crate or among its corpus cases, or None."""
    names = {red['target'] or ''} | {i.split('::')[0] for i in red['ids']}
    crates = {f'crates/{c.name}/' for c in (TREE / 'crates').iterdir()
              if any(n == c.name or n.startswith(c.name + '-') for n in names)}
    paths = {i for i in red['ids'] if i.startswith('conformance/')}
    score = {c: sum(p in paths or p.startswith(tuple(crates)) for p in changed[c]) for c in commits}
    best = max(reversed(commits), key=score.get, default=None)
    return best if best and score[best] else (commits[-1] if len(commits) == 1 else None)


def tell(to, body):
    with tempfile.NamedTemporaryFile('w', suffix='.md') as message:
        message.write(body + '\n')
        message.flush()
        sent = subprocess.run([SLUICE, 'tool', 'say', '--project', 'hirsel-lang', '--to', to, '--body-file',
                               message.name], capture_output=True, text=True, env=os.environ | {'SLUICE_ME': '@main-runs'})
    say(f'told {to}' + ('' if sent.returncode == 0 else f' (failed: {sent.stderr.strip()[-300:]})'))
    return sent.returncode == 0


def describe(key, red):
    if red.get('kind') == 'infra':
        return f'- {key}: infrastructure ({red["reason"]})'
    return (f'- {key}: culprit {(red["culprit"] or "unknown")[:12]}' + (f' ({red["lane"]})' if red['lane'] else '')
            + f', red since {red["since"][:12]}' + (f'; failing {", ".join(red["ids"][:5])}' if red['ids'] else ''))


def route(sha, reds, history, report):
    """Route code reds to likely lanes and batch infrastructure reds to the orchestrator.

    A red is compared with the last run that ran its stage (a row without a
    stage list ran them all): a code red it had keeps its culprit, a new one's
    culprit is among the commits since it. Infra never carries lane blame."""
    messages = {}
    for key, red in sorted(reds.items()):
        previous = next((r for r in reversed(history) if red['stage'] in r.get('stages', [red['stage']])), None)
        kind = red.get('kind', 'code')
        if kind == 'infra':
            red.update(culprit=None, lane=None, since=sha)
            messages.setdefault((ORCHESTRATOR, kind), []).append(describe(key, red))
            continue
        if old := (previous or {}).get('reds', {}).get(key):
            red.update(culprit=old.get('culprit'), lane=old.get('lane'), since=old.get('since', previous['sha']))
            continue
        commits = git('rev-list', '--reverse', f'{previous["sha"] if previous else sha + "~10"}..{sha}').split()
        changed = {c: git('diff-tree', '--no-commit-id', '--name-only', '-r', c).split() for c in commits}
        found = culprit(red, commits, changed)
        red.update(culprit=found, lane=lanes(commits).get(found), since=sha)
        messages.setdefault((red['lane'] or ORCHESTRATOR, kind), []).append(describe(key, red))
    for (to, kind), lines in messages.items():
        action = 'Fix forward, or add a row to tools/known-failures.tsv. ' if kind == 'code' else ''
        body = f'main-runs: new {kind} reds on origin/main {sha[:12]}. {action}Report: {report}\n' + '\n'.join(lines)
        if not tell(to, body) and to != ORCHESTRATOR:
            tell(ORCHESTRATOR, body)


def push_to_main(message, update):
    """Commit what `update(tree)` changes on a fresh origin/main and push it."""
    for _ in range(5):
        git('fetch', '-q', 'origin', 'main')
        checkout(PUSH_TREE, git('rev-parse', 'refs/remotes/origin/main'))
        update(PUSH_TREE)
        if not git('status', '--porcelain', cwd=PUSH_TREE):
            return None
        git('commit', '-qam', message, cwd=PUSH_TREE)
        if subprocess.run(['git', 'push', '-q', 'origin', 'HEAD:main'], cwd=PUSH_TREE).returncode == 0:
            return git('rev-parse', 'HEAD', cwd=PUSH_TREE)
    return None


def api_index(tree):
    cli = 'root//:hirsel-cli-bin-hirsel'
    config = os.environ.get('HIRSEL_BUCK2_CONFIG', '').split()
    built = subprocess.run([str(TREE / '.buck2/bin/buck2'), 'build', *config, '--show-json-output', cli], cwd=TREE,
                           capture_output=True, text=True, check=True)
    page = subprocess.run([str(TREE / json.loads(built.stdout)[cli]), 'doc', 'stdlib/std@1/hirsel.json'],
                          cwd=TREE, capture_output=True, check=True, timeout=600).stdout
    (tree / 'docs/api.md').write_bytes(page)


def ratchet(measured, perf_checks):
    def update(tree):
        counts = runpy.run_path(str(tree / 'tools/perf-counts'))
        rows, improvements = counts['ratchet'](counts['read_table'](tree / 'tools/perf-counts.tsv'), [measured])
        # push_to_main can retry against a newer baseline. Only report the
        # changes in the successful push, never a superseded attempt.
        perf_checks[:] = [item for item in improvements
                          if (item['old'] - item['new']) * 100 > item['old'] * 15]
        if improvements:
            (tree / 'tools/perf-counts.tsv').write_text(counts['table'](rows))
    return update


def run(sha, tier):
    start = time.time()
    directory = RUNS / 'runs' / f'{time.strftime("%Y%m%dT%H%M%SZ", time.gmtime(start))}-{sha[:12]}'
    directory.mkdir(parents=True)
    with open(directory / 'run.log', 'w') as log:
        reds, ran, skipped, perf = run_stages(directory, log, tier)
    report = RUNS / 'reports' / f'{directory.name}.md'
    route(sha, reds, rows(), report)
    pushed, perf_checks = [], []
    ratchet_checks = []
    for name, update in (('Regenerate the API index.', api_index),
                         ('Ratchet the instruction budgets main measured.', ratchet(perf, ratchet_checks) if perf else None)):
        try:
            if update and (commit := push_to_main(name, update)):
                pushed.append(f'{commit[:12]} {name}')
                if name == 'Ratchet the instruction budgets main measured.':
                    for item in ratchet_checks:
                        say(f'PERF-CHECK {item["count"]} {item["old"]} -> {item["new"]} (run: {sha[:12]})')
                        perf_checks.append(dict(item, measured_sha=sha, pushed=commit))
        except (subprocess.CalledProcessError, subprocess.TimeoutExpired, OSError, KeyError, ValueError) as error:
            pushed.append(f'{name} failed: {error}')
    minutes = (time.time() - start) / 60
    infra = sum(red.get('kind') == 'infra' for red in reds.values())
    lines = [f'# {tier} main run {sha[:12]}: {len(reds) - infra} code reds, {infra} infra reds', '',
             f'{time.strftime("%Y-%m-%d %H:%M", time.gmtime(start))}Z, {minutes:.0f} min; log {directory / "run.log"}', '']
    for kind, title in (('code', 'Code reds'), ('infra', 'Infrastructure reds')):
        lines += [f'## {title}', ''] + [describe(key, red) for key, red in sorted(reds.items())
                                         if red.get('kind', 'code') == kind] + ['']
    lines += [f'- skipped: {row[0]}: {row[1]} (owner {row[2]}, since {row[3]})' for row in skipped]
    lines += [f'- pushed: {line}' for line in pushed]
    lines += [f'- PERF-CHECK {item["count"]} {item["old"]} -> {item["new"]} '
              f'(pushed {item["pushed"][:12]})' for item in perf_checks]
    report.parent.mkdir(exist_ok=True)
    report.write_text('\n'.join(lines) + '\n')
    (RUNS / 'latest.md').write_text(report.read_text())
    # Keep the existing lane-blame history schema; infra details live in the report.
    code_reds = {key: {k: v for k, v in red.items() if k not in ('kind', 'reason')}
                 for key, red in reds.items() if red.get('kind', 'code') == 'code'}
    with open(ROWS, 'a') as out:
        out.write(json.dumps(dict(sha=sha, tier=tier, stages=ran, start=start, minutes=round(minutes), reds=code_reds,
                                  report=str(report), perf_checks=perf_checks)) + '\n')
    say(f'{tier} {sha[:12]}: {len(reds)} reds in {minutes:.0f} min; report {report}')
    return 0


if __name__ == '__main__':
    arguments, tier = sys.argv[1:], 'fast'
    if arguments[1:3] in (['--tier', 'fast'], ['--tier', 'full']):
        tier = arguments[2]
        del arguments[1:3]
    if arguments == ['--tick', '--dry-run']:
        sys.exit(stages(lambda name, *_, **__: print(name), tier))
    if arguments == ['--tick']:
        sys.exit(tick(tier))
    if arguments[:1] == ['--run'] and arguments[2:] in ([], ['fast'], ['full']) and len(arguments) > 1:
        sys.exit(run(arguments[1], (arguments[2:] or ['fast'])[0]))  # a tick before tiers passes no tier
    sys.exit(print(__doc__, file=sys.stderr) or 2)
