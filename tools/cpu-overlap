#!/usr/bin/env python3
"""Build CPU audit commands before a window, then run them in private cpusets.

--prepare DIR materializes the ordinary and TSan launchers through Buck2.
--run DIR --cpus LIST uses delegated user scopes, which do not reserve CPUs.
The orchestrator alone may run as root with --slice SLICE --uid UID after
fencing the host. This command never changes another unit's CPU assignment.
"""
import argparse
import json
import os
from pathlib import Path
import pwd
import re
import shutil
import subprocess
import time

ROOT = Path(__file__).resolve().parents[1]
ORDERED = 'ordered_allocating_mappers_overlap_and_replay'
ROWS = [(f'ordered-{width}', width, False, ORDERED) for width in (4, 8, 16)] + [
    ('p16', 16, False, 'fresh_cpu_pool_has_physical_width_16'),
    ('tsan-4', 4, True, None), ('tsan-8', 8, True, None)]


def cpu_list(text):
    result = set()
    for item in text.split(','):
        ends = item.split('-')
        first, last = int(ends[0]), int(ends[-1])
        if len(ends) > 2 or first < 0 or first > last:
            raise ValueError(f'invalid CPU range {item!r}')
        result.update(range(first, last + 1))
    return sorted(result)


def target(width, tsan):
    name = f'gate-cpu-pool-native-tsan-{width}' if tsan else f'hirsel-cli-test-cpu_pool_{width}'
    return f'//:{name}[host-command]'


def freeze_command(data, directory, prefix, staged):
    # Buck's root-config sanitizer switch reuses output paths. Preserve the
    # executables and std products for this mode before building the other.
    def freeze(path):
        source = ROOT / path
        if path not in staged:
            saved = directory / f'{prefix}-{len(staged)}-{source.name}'
            if source.is_dir():
                shutil.copytree(source, saved)
            else:
                shutil.copy2(source, saved)
            staged[path] = os.path.relpath(saved, ROOT)
        return staged[path]

    data['command'][1] = freeze(data['command'][1])
    for key, value in data['env'].items():
        if isinstance(value, list):
            if len(value) != 1:
                raise ValueError(f'expected one environment value for {key}: {value}')
            data['env'][key] = value[0]
    for key in ['HIRSEL_TEST_PRODUCTS', 'HIRSEL_PRODUCTS']:
        if key in data['env']:
            data['env'][key] = freeze(data['env'][key])
    if 'HIRSEL_NATIVE_CPU_HARNESS' in data['env']:
        data['env']['HIRSEL_NATIVE_CPU_HARNESS'] = freeze(data['env']['HIRSEL_NATIVE_CPU_HARNESS'])
    binaries = []
    for entry in data['env'].get('HIRSEL_TEST_BIN_EXES', '').split():
        name, path = entry.split('=', 1)
        binaries.append(name + '=' + freeze(path))
    data['env']['HIRSEL_TEST_BIN_EXES'] = ' '.join(binaries)


def prepare(directory):
    for tsan, widths in [(False, (4, 8, 16)), (True, (4, 8))]:
        command = [str(ROOT / '.buck2/bin/buck2'), 'build', '-c', 'hirsel.tests=host']
        if tsan:
            command += ['-c', 'hirsel.native_tsan=true']
        result = subprocess.run(command + [target(w, tsan) for w in widths] + ['--show-full-json-output'],
                                cwd=ROOT, check=True, text=True, stdout=subprocess.PIPE)
        outputs = json.loads(result.stdout)
        staged = {}
        for width in widths:
            matches = [path for label, paths in outputs.items() if target(width, tsan)[2:] in label
                       for path in (paths if isinstance(paths, list) else [paths])]
            if len(matches) != 1:
                raise RuntimeError(f'expected one launcher for {width=} {tsan=}: {outputs}')
            data = json.loads(Path(matches[0]).read_text())
            freeze_command(data, directory, 'tsan' if tsan else 'ordinary', staged)
            data['root'] = str(ROOT)
            (directory / f'{"tsan" if tsan else "ordinary"}-{width}.json').write_text(json.dumps(data))


def run(directory, cpus, slice_name, uid, selection):
    if len(cpus) != 16:
        raise ValueError('the complete audit requires exactly sixteen logical CPUs')
    if slice_name and (os.geteuid() != 0 or '/' in slice_name or '-' in slice_name
                       or not slice_name.endswith('.slice')):
        raise ValueError('--slice requires root and a top-level system slice')
    if not slice_name and uid != os.getuid():
        raise ValueError('user scopes must run as the current user')
    account = pwd.getpwuid(uid)
    runtime = f'/run/user/{uid}'
    manager_env = os.environ | {'XDG_RUNTIME_DIR': runtime,
                               'DBUS_SESSION_BUS_ADDRESS': f'unix:path={runtime}/bus'}
    started = time.monotonic()
    failures = []
    for name, width, tsan, case in ROWS:
        if selection and name not in selection:
            continue
        data = json.loads((directory / f'{"tsan" if tsan else "ordinary"}-{width}.json').read_text())
        for key, value in data['env'].items():
            if isinstance(value, list):
                if len(value) != 1:
                    raise ValueError(f'expected one environment value for {key}: {value}')
                data['env'][key] = value[0]
        assigned = ','.join(map(str, cpus[:width]))
        unit = f'cpu-overlap-{os.getpid()}-{name}'
        environment = os.environ | data['env'] | {
            'HOME': account.pw_dir, 'USER': account.pw_name,
            'HIRSEL_CPU_PRIVATE_SCOPE': 'inside',
            'XDG_RUNTIME_DIR': runtime, 'DBUS_SESSION_BUS_ADDRESS': f'unix:path={runtime}/bus'}
        if width == 16:
            # Existing W16 compiler query cap; runtime still receives all 16 CPUs.
            environment['HIRSEL_JOBS'] = '1'
        command = ['systemd-run', '--scope', '--collect', '--quiet', '--unit', unit,
                   '-p', f'AllowedCPUs={assigned}', '-p', f'CPUQuota={width * 100}%',
                   '-p', f'MemoryMax={data["env"]["HIRSEL_MEMORY_LIMIT"]}', '-p', 'MemorySwapMax=0']
        control = ['systemctl']
        if slice_name:
            command += ['--slice', slice_name, 'setpriv', f'--reuid={uid}',
                        f'--regid={account.pw_gid}', '--init-groups']
        else:
            command += ['--user']
            control += ['--user']
        command += ['taskset', '-c', assigned, *data['command']]
        if case:
            command += [case, '--exact', '--include-ignored', '--nocapture', '--test-threads=1']
        print(f'BEGIN {name} cpus={assigned} unit={unit}', flush=True)
        try:
            remaining = 900 - (time.monotonic() - started)
            if remaining <= 0:
                raise subprocess.TimeoutExpired(command, 900)
            result = subprocess.run(command, cwd=data['root'], env=environment,
                                    timeout=min(600, remaining), capture_output=True, text=True)
            print(result.stdout, end='', flush=True)
            print(result.stderr, end='', flush=True)
            status = result.returncode
            if case and status == 0 and not re.search(r'test result: ok\. 1 passed; 0 failed;', result.stdout):
                print(f'{name}: expected one executed passing body', flush=True)
                status = 1
        except subprocess.TimeoutExpired:
            status = 124
        if status:
            subprocess.run(control + ['stop', unit + '.scope'], env=manager_env,
                           check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        print(f'END {name} EXIT {status}', flush=True)
        if status:
            failures.append(name)
    print(f'CPU audits elapsed={time.monotonic() - started:.1f}s failed={failures}', flush=True)
    return bool(failures)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    mode = parser.add_mutually_exclusive_group(required=True)
    mode.add_argument('--prepare', type=Path)
    mode.add_argument('--run', type=Path)
    parser.add_argument('--cpus', default='0-7,16-23')
    parser.add_argument('--slice')
    parser.add_argument('--uid', type=int, default=os.getuid())
    parser.add_argument('--only', action='append', choices=[row[0] for row in ROWS])
    args = parser.parse_args()
    if args.prepare:
        args.prepare.mkdir(parents=True, exist_ok=True)
        prepare(args.prepare.resolve())
        return 0
    return run(args.run.resolve(), cpu_list(args.cpus), args.slice, args.uid, args.only)


if __name__ == '__main__':
    raise SystemExit(main())
