// rule: PROV-4
// expect: run
// The scoped twin borrows the boxed arena part within the frame.
fn probe(a: Arena) -> u64 {
  let x: String in a = "x"
  let held = (box x, 2u8)
  let f = fn() {
    let (b, n) = held
    1u64
  }
  f()
}

pub fn main() -> Result[(), ()] uses {} {
  let n: u64 = arena.with(fn(a: Arena) -> u64 { probe(a) })
  if n == 1 { Ok(()) } else { Error(()) }
}
