type P {
  x: u32,
  y: u32,
}
fn inc(x: unique u32) -> unique u32 {
  x + 1
}
fn apply(f: fn(u32) -> u32, x: u32) -> u32 {
  f(x)
}
fn twice[T: plain](x: unique T) -> (T, T) {
  (x, x)
}
fn sum(n: unique u32, take p: unique P) -> u32 {
  n + p.x + p.y
}
