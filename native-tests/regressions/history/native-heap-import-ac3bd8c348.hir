pub fn main(rt: Io, args: Args) -> Result[(), OutputError] {
  let mut builder: List[u8] = []
  failure.check(std@1/text.finish(take builder) == Ok(copy ""), TextInvariant())
  out.print(io.stdout(rt), "ok\n")
}
