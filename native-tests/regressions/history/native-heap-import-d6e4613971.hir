fn view(x: Bytes) -> Bytes in x {
  copy x
}
fn same(take b: Bytes, c: Bytes) -> bool {
  view(b) == view((fn() { c })())
}
pub fn main(rt: Io, args: Args) -> Result[(), ()] {
  Ok(())
}
