// Historical native finding: native/heap/heap: UninitializedRead: replace of uninitialized storage
// Mutation: store/mut
// Original: conformance/SEM/SEM-5-equality-order-sensitive.hir
fn output_error[E](take e: E) -> () {}
pub fn main(rt: Io, args: Args) -> Result[(), ()] {
  let mut m: Map[u8, u8] = map.empty()
  map.insert(mut m, 2, 20)
  let mut n: Map[u8, u8] = map.empty()
n = copy m;
  map.insert(mut n, 2, 20)
  out.print(
    io.stdout(rt),
    if m != n {
      "ok\n"
    } else {
      "bad\n"
    }
  ) ? output_error
  Ok(())
}
