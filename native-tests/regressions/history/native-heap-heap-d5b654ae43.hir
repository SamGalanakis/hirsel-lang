fn width(s: String, n: u64) -> u64 {
  string.byte_len(
    if n == 0 {
      s
    } else {
      "other"
    }
  )
}
fn arm(s: String, n: u64) -> u64 {
  string.byte_len(
    match n {
      0 => s,
      1 => "four",
      _ => "x",
    }
  )
