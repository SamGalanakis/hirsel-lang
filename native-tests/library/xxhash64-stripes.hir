// cespare/xxhash xxhash_test.go:13-67 TestAll, plus multi-stripe vectors.
// Both update orders, nonzero list offsets, empty updates and stripe boundaries.
fn check(t: Test, data: Bytes, seed: u64, expected: u64) -> () {
  let cuts: List[u64] = [0, 1, 31, 32, 33, 63, 64, 65, 95, 96, 97, bytes.len(data)]
  for split in cuts {
    if split > bytes.len(data) {
      continue
    }
    let mut state = xxhash64.new_with_seed(seed)
    xxhash64.update(mut state, bytes.slice(data, 0, split))
    let mut suffix: List[u8] = [0xffu8, 0xffu8, 0xffu8]
    let mut i = split
    while i < bytes.len(data) {
      list.push(mut suffix, data[i])
      i += 1
    }
    xxhash64.update_list(mut state, suffix, 3)
    xxhash64.update_list(mut state, suffix, list.len(suffix))
    xxhash64.update_list(mut state, suffix, list.len(suffix) + 1)
    test.equal(t, xxhash64.finish(take state), expected)
    let mut reverse = xxhash64.new_with_seed(seed)
    let mut prefix: List[u8] = [0xffu8]
    let mut j: u64 = 0
    while j < split {
      list.push(mut prefix, data[j])
      j += 1
    }
    xxhash64.update_list(mut reverse, prefix, 1)
    xxhash64.update(mut reverse, b"")
    xxhash64.update(mut reverse, bytes.slice(data, split, bytes.len(data)))
    test.equal(t, xxhash64.finish(take reverse), expected)
  }
}

