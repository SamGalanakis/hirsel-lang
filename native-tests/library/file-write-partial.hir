fn error(take e: FileError) -> () {}

fn require(value: bool) {
  let _ = 1u64 / if value {
    1u64
  } else {
    0u64
  }
}

pub fn main(rt: Io, args: Args) -> Result[(), ()] {
  let d = io.dir(rt, path.of(".")) ? error
  let p = path.of("sample")
  let data = std@1/bytes.replace(b"abcdef", b"q", b"x")
  match file.write_bytes(d, p, take data) {
    Error(FileFault(code)) => require(code == 71u32),
    Error(Canceled(_)) => require(false),
    Error(NotGranted()) => require(false),
    Ok(_) => require(false),
  }
  require(file.read_bytes(d, p) ? error == b"ab")
  Ok(())
}
