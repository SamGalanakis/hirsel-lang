pub fn main(rt: Io) -> Result[(), LaunchError] {
  let mut m: Map[u64, u64] = map.empty()
  map.insert(mut m, 4u64, 1u64)
  map.insert(mut m, 2u64, 2u64)
  map.insert(mut m, 4u64, 3u64)
  for (k, v) in m {
    out.print(io.stdout(rt) ? Grant, std@1/u64.to_string(k + v)) ? Output
  }
  Ok(())
}

pub type LaunchError = Grant(GrantError) | Output(OutputError)
