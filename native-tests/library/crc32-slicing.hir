  for (n, a, b) in cases {
    check(bytes.slice(data, 0, n), a, b)
  }
  let mut builder: List[u8] = [255u8]
  for byte in data {
    list.push(mut builder, byte)
  }
  let mut state = std@1/crc32.new()
  std@1/crc32.update(mut state, b"prefix")
  std@1/crc32.update_list(mut state, builder, 2)
  std@1/crc32.update_list(mut state, builder, 18446744073709551615u64)
  failure.check(std@1/crc32.finish(take state) == 0x80a1fa44u32, TextInvariant())
