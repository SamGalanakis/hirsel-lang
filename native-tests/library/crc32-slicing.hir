    (21, 0x195881fe, 0x40e43538),
    (22, 0xe5c38cfc, 0xcda87569),
    (23, 0x92382767, 0x7d3b930d),
    (24, 0x8295a696, 0x29bc8795),
    (25, 0xd880d40c, 0x6f8a987d),
    (26, 0xbf078bb2, 0xf44eddb4),
    (27, 0x0ab0c3dc, 0x5cba170d),
    (28, 0xd708085d, 0x64dec9c1),
    (29, 0xd30e9683, 0x3ee220e0),
    (30, 0xc5665f58, 0x1e0592d7),
    (31, 0x4d786d77, 0xe95cabcb),
    (32, 0x91267e8a, 0x46dd794e),
    (33, 0xe4908305, 0x9f85a26d),
    (63, 0xdbdea683, 0x7a873004),
    (64, 0x100ece8c, 0xfb6d36eb),
