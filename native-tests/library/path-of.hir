fn error(take e: FileError) -> () {}

fn require(value: bool) {
  let _ = 1u64 / if value {
    1u64
  } else {
    0u64
  }
}

pub fn main(rt: Io, args: Args) -> Result[(), ()] {
  require(path.of("a") == path.of("a"))
  require(path.of("a") != path.of("b"))
  let d = io.dir(rt, path.of(".")) ? error
  file.write_bytes(d, path.of("a"), b"interned") ? error
  require(file.read_bytes(d, path.of("a")) ? error == b"interned")
  Ok(())
}
