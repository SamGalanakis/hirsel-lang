// TLS ABI and rustls link on both targets. The public test CA is from rustls
// v/0.23.46 test-ca/rsa-2048 (third-party/NOTICES.md).
fn grant(take e: GrantError) -> () {}
fn network(take e: NetError) -> () {}
fn output(take e: OutputError) -> () {}
fn argument(take e: ArgError) -> () {}

fn open(n: Net, port: u16) -> Result[Stream of n, NetError] {
  let mut s = net.connect(n, "127.0.0.1", port, Nanos(5000000000u64))?
  net.set_read_timeout(n, mut s, Nanos(5000000000u64))?
  net.set_write_timeout(n, mut s, Nanos(5000000000u64))?
  Ok(take s)
}

pub fn main(rt: Io, args: Args) -> Result[(), ()] {
  let out = io.stdout(rt) ? grant
  let n = io.net(rt) ? grant
  let port = match std@1/u16.parse(path.text(arg.path(args, 0u64) ? argument)) {
    Ok(port) => port,
    Error(_) => return Error(()),
  }
  let roots: TlsRoots = Pem(b"-----BEGIN CERTIFICATE-----\nMIIDPzCCAiegAwIBAgIBATANBgkqhkiG9w0BAQsFADAfMR0wGwYDVQQDDBRwb255\ndG93biBSU0EgMjA0OCBDQTAgFw03NTAxMDEwMDAwMDBaGA80MDk2MDEwMTAwMDAw\nMFowHzEdMBsGA1UEAwwUcG9ueXRvd24gUlNBIDIwNDggQ0EwggEiMA0GCSqGSIb3\nDQEBAQUAA4IBDwAwggEKAoIBAQCy4ZPzrQwfu3tz3ll0xHzlHtAQEHUyXzSo3VIn\nULFPC9D84LWe9zpQBYGxOtl8OVcMdmEbzoIOHO6afNSnzbcQdZymJ4+FMpmusWdV\nCcWQ7Knu4Ok0mWlw7HXgtnhunjX0BRMy5M6WXWk6MH44G7n3DCQDINAJvGAwirIT\nkUfekbnwDCIEmIZNQQKyGdndn6mQGHt+oWdmgiWxI0dPjU/vsyFQDFomX2IF/fn4\nj/lKvhGPEccO/2zQThUrbVck1t7kRilCDZbShGav3+87h42mISriK5yqVOwPzPL4\nHWjIL+G2sMDY7RdFKQHBCY4Gis5rrLtOOhKtoDmos7oCCs1BAgMBAAGjgYMwgYAw\nHwYDVR0jBBgwFoAUZ8fKnr69bZrvOOQ1Jii60vG9ELYwDgYDVR0PAQH/BAQDAgH+\nMB0GA1UdJQQWMBQGCCsGAQUFBwMBBggrBgEFBQcDAjAdBgNVHQ4EFgQUZ8fKnr69\nbZrvOOQ1Jii60vG9ELYwDwYDVR0TAQH/BAUwAwEB/zANBgkqhkiG9w0BAQsFAAOC\nAQEAhTU7Iv/HBuSOaIAOTrgqbvwKUoZsGG0vb1DVOYINasnDDVx+celU9jvzSHRy\n+5kZUgflytZIy1TmE/RvQi8/vd2s6BL4DGF39VyFO49g746EcBUEmNGZFS0J/hVa\niZj3yNO/tO5V3nzrGzTrrx9cRnFykLKE/qDnrIOfCiRk5KYui1M5JYBM61r3MDLA\nlrRCZh4u04jdNVHPF14km5VcgJvhpGkX2mpe3J9ZtOwBdc96e5zJ0PPKofAuVhuD\nJ8t+QNnjXKSyf1Ud/5WAOKinqGK902mRAwEFISQko0OajUkUzjZabr6xnf4fYWId\nJPT9si0E6DxRUmBTQ0Dy4zU1AQ==\n-----END CERTIFICATE-----\n")
  let first = open(n, port) ? network
  match tls.connect(n, take first, "localhost", WebPki()) {
    Error(Tls(UnknownIssuer())) => out.print(out, "issuer rejected\n") ? output,
    _ => return Error(()),
  }
  let second = open(n, port) ? network
  match tls.connect(n, take second, "wrong.example", roots) {
    Error(Tls(NameMismatch())) => out.print(out, "name rejected\n") ? output,
    _ => return Error(()),
  }
  let plain = open(n, port) ? network
  let mut s = tls.connect(n, take plain, "localhost", roots) ? network
  net.write_all(n, mut s, b"ping") ? network
  let mut buffer: List[u8] = []
  let mut reading: bool = true
  while reading {
    let count = net.read(n, mut s, mut buffer, 3u64) ? network
    reading = count != 0u64
  }
  match string.from_bytes(bytes.from_list(take buffer)) {
    Ok(text) => out.print(out, text) ? output,
    Error(_) => return Error(()),
  }
  tls.close(n, take s) ? network
  out.print(out, "closed\n") ? output
  Ok(())
}
