pub fn main(rt: Io) -> Result[(), LaunchError] {
  let xs: Array[f64] = [1e30f64, 1.0f64, -1e30f64]
  out.print(
    io.stdout(rt) ? Grant,
    if std@1/f64.sum_exact(xs) == 1.0f64 {
      "ok\n"
    } else {
      "bad\n"
    }
  ) ? Output
  Ok(())
}

pub type LaunchError = Grant(GrantError) | Output(OutputError)
