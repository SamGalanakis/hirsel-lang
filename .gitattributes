hirsel.json merge=hirsel
conformance/passing.txt merge=hirsel
conformance/pending.txt merge=hirsel
crates/hirsel-engine/src/registry/review-table.txt merge=hirsel
crates/hirsel-modes/src/authority/corpus/passing.txt merge=hirsel
crates/hirsel-modes/src/authority/corpus/pending.txt merge=hirsel
crates/hirsel-modes/src/ownership/tests/passing.txt merge=hirsel
crates/hirsel-modes/src/ownership/tests/pending.txt merge=hirsel
native-tests/library/operations.tsv merge=hirsel
native-tests/regressions/*.txt merge=hirsel
