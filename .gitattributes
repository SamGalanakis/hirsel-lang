# Files many lanes add to: git merges them with tools/buck2/merging.py, the
# `hirsel` merge driver bootstrap.py installs, so a rebase never stops on two
# changes that each add to one.
third-party/NOTICES.md merge=hirsel
hirsel.json merge=hirsel
conformance/passing.txt merge=hirsel
conformance/pending.txt merge=hirsel
crates/hirsel-engine/src/registry/review-table.txt merge=hirsel
crates/hirsel-authority/src/corpus/passing.txt merge=hirsel
crates/hirsel-authority/src/corpus/pending.txt merge=hirsel
crates/hirsel-ownership/src/tests/passing.txt merge=hirsel
crates/hirsel-ownership/src/tests/pending.txt merge=hirsel
native-tests/library/operations.tsv merge=hirsel
native-tests/regressions/*.txt merge=hirsel

# Pure independent lines: declarations and ledger rows have no ordering semantics.
# Three-way set merge preserves removals as well as concurrent additions.
# tools/check-hot-files rejects duplicates before landing.
crates/*/tests/*/modules.rs merge=hirsel
tools/known-failures.tsv merge=hirsel
