#!/usr/bin/env python3
"""Compare frozen before/after network loops with the minimal Rust TCP reference."""
import argparse
import contextlib
import hashlib
import importlib.machinery
import importlib.util
import sys
import json
import os
from pathlib import Path
import subprocess

ROOT = Path(__file__).resolve().parents[3]
parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('--rust', type=Path, required=True)
parser.add_argument('--binary', action='append', required=True, help='name=/absolute/binary (repeat for each change)')
parser.add_argument('--output', type=Path, required=True)
parser.add_argument('--record', action='store_true', help='include a recorded participant for each binary')
args = parser.parse_args()
args.output.mkdir(parents=True, exist_ok=True)
participants = [dict(name='rust', command=[str(args.rust.resolve())])]
for binary in args.binary:
    name, path = binary.split('=', 1)
    command = [str(Path(path).resolve()), '--hirsel-grants', str(ROOT / 'bench/micro/net/grants.json')]
    participants.append(dict(name=name, command=command))
    if args.record:
        participants.append(dict(name=name + '-record', command=[command[0], '--hirsel-record', str((args.output / (name + '.tape')).resolve()), *command[1:]]))
manifest = args.output / 'participants.json'
manifest.write_text(json.dumps(participants, indent=2) + '\n')
env = dict(os.environ, HIRSEL_JOBS='1')
# Take the shared server-core lock before starting the finite client's deadline.
# Reuse the ordinary harness in-process with its inner lock already held.
sys.path.insert(0, str(ROOT / 'bench/micro'))
from measure import timing_lock
loader = importlib.machinery.SourceFileLoader('network_micro_run', str(ROOT / 'bench/micro/run'))
spec = importlib.util.spec_from_loader(loader.name, loader)
runner = importlib.util.module_from_spec(spec)
loader.exec_module(runner)
original_sample = runner.sample
expected_output = hashlib.sha256(b'1024\n').hexdigest()
def checked_sample(*args, **kwargs):
    result = original_sample(*args, **kwargs)
    if result['stdout_sha256'] != expected_output:
        raise ValueError('network participant did not complete 1024 requests')
    return result
runner.sample = checked_sample
with timing_lock(31), (args.output / 'client.log').open('w') as log:
    runner.timing_lock = lambda cpu: contextlib.nullcontext()
    client = subprocess.Popen([str(ROOT / 'tools/capped'), '--timeout', '900', 'taskset', '-c', '7',
        'python3', str(ROOT / 'bench/micro/http/load.py'), '--sessions', str(10 * len(participants)),
        '--output', str(args.output / 'latencies.json')], env=env, stdout=log, stderr=log)
    try:
        sys.argv = [str(ROOT / 'bench/micro/run'), str(manifest), '--rounds', '10', '--seed', '20261020',
                    '--output', str(args.output / 'counts.json')]
        status = runner.main()
        if status:
            raise RuntimeError('measurement failed')
        client.wait(timeout=30)
        if client.returncode:
            raise RuntimeError('client failed: ' + (args.output / 'client.log').read_text())
    finally:
        if client.poll() is None:
            client.terminate()
            client.wait(30)
