fn run(n: u64, salt: u64) -> u64 {
  let mut vocab: List[String] = []
  for i in 0u64..4096u64 {
    list.push(mut vocab, f"word{i}")
  }
  let mut g = prng.seed(42 + salt)
  let mut counts: Map[String, u64] = map.empty()
  for _ in 0u64..n {
    let w = vocab[prng.u64(mut g) % 4096u64]
    match map.get(counts, w) {
      Some(c) => map.insert(mut counts, unique w, c + 1),
      None() => map.insert(mut counts, unique w, 1),
    }
  }
  let mut sum: u64 = 0
  let mut k: u64 = 1
  for w in vocab {
    sum = int.wrapping_add(
      sum,
      u64.wrapping_mul(option.unwrap_or(map.get(counts, w), 0u64), k)
    )
    k += 1
  }
  sum
}

fn arg_u64(args: Args, index: u64, default: u64) -> u64 {
  if arg.len(args) <= index {
    return default
  }
  match arg.text(args, index) {
    Ok(t) => match u64.parse(t) {
      Ok(n) => n,
      Error(_) => default,
    },
    Error(_) => default,
  }
}

pub fn main(rt: Io, args: Args) -> Result[(), String] {
  let n = arg_u64(args, 0, 1000)
  let rounds = arg_u64(args, 1, 1)
  let mut sum: u64 = 0
  for r in 0u64..rounds {
    sum = int.wrapping_add(sum, run(n, r))
  }
  let output = match io.stdout(rt) {
    Ok(o) => o,
    Error(_) => return Error("no stdout"),
  }
  match out.print(output, f"{sum}\n") {
    Ok(()) => Ok(()),
    Error(_) => Error("cannot write output"),
  }
}
