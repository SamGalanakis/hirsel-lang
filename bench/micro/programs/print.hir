pub fn main(rt: Io, args: Args) -> Result[(), String] {
  let n = match arg.text(args, 0) {
    Ok(t) => match u64.parse(t) {
      Ok(v) => v,
      Error(_) => 1000,
    },
    Error(_) => 1000,
  }
  let output = match io.stdout(rt) {
    Ok(o) => o,
    Error(_) => return Error("no stdout"),
  }
  for i in 0u64..n {
    match out.print(output, f"line {i}\n") {
      Ok(()) => {},
      Error(_) => return Error("cannot write output"),
    }
  }
  Ok(())
}
