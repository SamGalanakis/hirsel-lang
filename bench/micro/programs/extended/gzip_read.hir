// One MiB of gzip output, requested in chunks of argv[0] (1 or 4096).
// The fixture is gzip.compress(b'a' * 1048576, mtime=0), Python/zlib level 9.
type Source {
  data: Bytes,
  at: u64,
}

fn refill(mut s: Source, mut out: List[u8], max: u64) -> Result[u64, ()] uses {} {
  let mut n: u64 = 0
  while n < max && s.at < bytes.len(s.data) {
    list.push(mut out, s.data[s.at])
    s.at += 1
    n += 1
  }
  Ok(n)
}

