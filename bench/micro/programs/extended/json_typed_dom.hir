// Typed byte decoding versus the same derived conversion through json.Value.
type Row {
  id: u64,
  name: String,
  score: f64,
  tags: List[String],
  active: bool,
  reference: Option[String],
}

type Document {
  rows: List[Row],
}

fn row_from_json_reader(mut input: json.Reader) -> Result[unique Row, String] uses {} = comptime derive.from_json_reader(
  shape(Row)
)

fn document_from_json_reader(mut input: json.Reader) -> Result[unique Document, String] uses {} = comptime derive.from_json_reader(
  shape(Document)
)

fn document_from_json_bytes(data: Bytes) -> Result[unique Document, String] uses {} = comptime derive.from_json_bytes(
  shape(Document)
)

fn row_from_json(value: json.Value) -> Result[unique Row, String] uses {} = comptime derive.from_json(
  shape(Row)
)

fn document_from_json(value: json.Value) -> Result[unique Document, String] uses {} = comptime derive.from_json(
  shape(Document)
)

fn document(n: u64) -> String {
  let mut out: List[u8] = []
  text.append(mut out, "{\"rows\":[")
  for i in 0u64..n {
    if i > 0u64 {
      text.append(mut out, ",")
    }
    text.append(
      mut out,
      f"{{\"id\":{i},\"name\":\"user{i}\",\"score\":{i * 7u64 % 1000u64}.5,\"tags\":[\"a\",\"bb\",\"ccc\"],\"active\":true,\"reference\":null}}"
    )
  }
  text.append(mut out, "]}")
  text.finish_valid(take out)
}

fn run(n: u64, salt: u64) -> u64 {
  let doc = document(n + salt)
  let mut total: u64 = 0
  for _ in 0u64..10u64 {
    let decoded = document_from_json(
      match json.parse(copy doc) {
        Ok(v) => take v,
        Error(_) => return 1,
      }
    )
    let Ok(value) = take decoded else {
      return 0
    }
    for row in value.rows {
      total += row.id + string.byte_len(row.name) + list.len(row.tags)
    }
  }
  total
}

fn arg_u64(args: Args, index: u64, default: u64) -> u64 {
  if arg.len(args) <= index {
    return default
  }
  match arg.text(args, index) {
    Ok(t) => match u64.parse(t) {
      Ok(n) => n,
      Error(_) => default,
    },
    Error(_) => default,
  }
}

pub fn main(rt: Io, args: Args) -> Result[(), String] {
  let n = arg_u64(args, 0, 1000)
  let rounds = arg_u64(args, 1, 1)
  let mut sum: u64 = 0
  for r in 0u64..rounds {
    sum = int.wrapping_add(sum, run(n, r))
  }
  let output = match io.stdout(rt) {
    Ok(o) => o,
    Error(_) => return Error("no stdout"),
  }
  match out.print(output, f"{sum}\n") {
    Ok(()) => Ok(()),
    Error(_) => Error("cannot write output"),
  }
}
