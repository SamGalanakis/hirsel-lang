#!/usr/bin/env python3
"""Build one micro and its Rust pair; each compiler is a separate capped run."""
import argparse
import json
import shutil
from pathlib import Path
import subprocess
import sys

HERE = Path(__file__).resolve().parent
ROOT = HERE.parents[1]
sys.path.insert(0, str(ROOT / 'bench/native'))
from suite import buck2_build, native_environment  # noqa: E402


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('case', choices=sorted(p.stem for p in (HERE / 'programs').glob('*.hir')))
    parser.add_argument('--size', type=int, default=1000, help='workload size in the generated participant list')
    parser.add_argument('--epochs', type=int, default=1, help='epochs in the generated participant list')
    parser.add_argument('--output', type=Path, default=ROOT / 'build/micro')
    args = parser.parse_args()
    if args.size < 0 or args.epochs < 1:
        parser.error('size must be nonnegative and epochs positive')
    output = args.output.resolve()
    output.mkdir(parents=True, exist_ok=True)
    source = output / f'{args.case}.hir'
    source.write_text((HERE / 'programs' / source.name).read_text())
    sidecar = {'schema': 1, 'package': {'name': 'micro', 'version': '1'},
               'entry': {'module': [], 'name': 'main'}, 'sources': [{'path': source.name, 'module': []}],
               'dependencies': [{'manifest': str(ROOT / 'stdlib/std@1/hirsel.json'),
                                 'package': {'name': 'std', 'version': '1'}, 'expose': []}]}
    source.with_suffix('.hir.json').write_text(json.dumps(sidecar, indent=2) + '\n')
    bundle = buck2_build('--target-platforms', '//tools/buck2:release',
                         '//:hirsel-toolchain')['hirsel-toolchain']
    env = native_environment()
    capped = str(ROOT / 'tools/capped')
    subprocess.run([capped, '--timeout', '900', str(Path(bundle) / 'hirsel'),
                    'build', '--release', str(source), '-o', str(output / args.case)], env=env, check=True)
    subprocess.run([capped, 'rustc', '--edition=2021', '-O', str(HERE / 'rust/main.rs'),
                    '-o', str(output / 'rust')], check=True)
    shutil.copyfile(HERE / 'grants.json', output / 'grants.json')
    workload = [str(args.size)] + ([] if args.case in ('print', 'channel') else [str(args.epochs)])
    participants = [
        {'name': 'rust', 'command': [str(output / 'rust'), args.case, *workload]},
        {'name': 'hirsel', 'command': [str(output / args.case), '--hirsel-grants',
                                       str(output / 'grants.json'), *workload]},
    ]
    manifest = output / f'{args.case}.json'
    manifest.write_text(json.dumps(participants, indent=2) + '\n')
    print(manifest)


if __name__ == '__main__':
    main()
