pub type ServerError = Grant(GrantError) | Network(NetError) | Http(http.HttpError) | Output(
  OutputError
)

pub fn main(rt: Io, args: Args) -> Result[(), ServerError] {
  let tasks = io.tasks(rt) ? Grant
  let n = io.net(rt) ? Grant
  let clock = io.monotonic_clock(rt) ? Grant
  let mut listener = net.listen(
    n,
    SocketAddr(ip: V4([127u8, 0u8, 0u8, 1u8]), port: 18475u16)
  ) ? Network
  let (stream, _) = net.accept(n, mut listener) ? Network
  let mut connection = http.server_connection(
    tasks,
    n,
    take stream,
    http.default_config()
  )
  for _ in 0u64..1024u64 {
    let (owned, _) = match http.next_stream(mut connection, Some(clock)) {
      Ok(Some(exchange)) => take exchange,
      Ok(None()) => return Ok(()),
      Error(e) => return Error(Http(take e)),
    }
    let mut responding = take owned
    http.respond(
      mut responding,
      200u16,
      [http.Header(name: "Content-Type", value: "text/plain")],
      b"Hello, world",
      false
    ) ? Http
  }
  let _ = http.next_stream(mut connection, Some(clock))
  out.print(io.stdout(rt) ? Grant, "1024\n") ? Output
  Ok(())
}
