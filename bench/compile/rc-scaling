#!/usr/bin/env bash
# Time every stage of the native middle end (import to Ready, and the IR
# checker after each) against the size of one function.
#
#   bench/compile/rc-scaling                      every shape at 20, 40, 80, 160
#   bench/compile/rc-scaling straight 160,320,640 one shape at the given sizes
#
# Shapes (crates/hirsel-rc/tests/scaling.rs): straight, chain, nested, locals,
# deep. Times are milliseconds this thread spent running, per stage and size.
# STATS=1 also prints each unit's size at Value, Rc and Ready (slots, values,
# blocks, instructions).
set -euo pipefail
cd "$(dirname "$0")/../.."
if (( $# > 2 )); then echo "usage: bench/compile/rc-scaling [shape [sizes]]" >&2; exit 2; fi
if (( $# >= 1 )); then export SHAPE="$1"; fi
if (( $# == 2 )); then export SIZES="$2"; fi
exec cargo test --quiet --release -p hirsel-rc --test scaling stages -- --ignored --nocapture
