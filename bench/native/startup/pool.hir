pub type AppError = Grant(GrantError) | Pool(CpuPoolError)
pub fn main(rt: Io, args: Args) -> Result[(), AppError] {
  let output = io.stdout(rt) ? Grant
  let pool = match arg.text(args, 0) { Ok("pool") => true, _ => false }
  let width = match arg.text(args, 1) { Ok("4") => 4u32, _ => 1u32 }
  let seed = match arg.text(args, 2) { Ok("21") => 21u64, _ => 0u64 }
  let value = if pool {
    let tasks = io.tasks(rt) ? Grant
    let rows = core@1/cpu.map_scoped(tasks, width,
      fn() -> List[u64] uses {} {
        let mut jobs: List[u64] = []
        for i in 0u64..(if width == 4u32 { 4u64 } else { 1u64 }) { list.push(mut jobs, seed + i) }
        take jobs
      }, fn(take job: u64) -> u64 uses {} { job * 2u64 }) ? Pool
    let mut sum = 0u64
    for row in rows { sum = sum + row }
    sum
  } else { seed * 2u64 }
  failure.check(value == (if pool && width == 4u32 { 180u64 } else { 42u64 }), Bounds())
  let _ = out.print(output, f"{value}\n")
  Ok(())
}
