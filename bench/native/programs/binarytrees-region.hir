// Separate binarytrees/region workload; the frozen binarytrees row is unchanged.
// Each temporary tree has its own arena; the retained tree has a distinct arena.
type Tree = Leaf | Branch(left: box Tree, right: box Tree)
fn tree(a: Arena, depth: u64) -> (box Tree) in a {
  if depth == 0u64 { box Leaf() }
  else { box Branch(left: tree(a, depth - 1u64), right: tree(a, depth - 1u64)) }
}
fn check(t: box Tree) -> u64 {
  match t { Leaf() => 1u64, Branch(left: l, right: r) => 1u64 + check(l) + check(r) }
}
fn workload(data: Bytes) -> Bytes {
  let mut pos: u64 = 0
  let depth = decimal(data, mut pos)
  let total = arena.with(fn(long_arena: Arena) -> u64 {
    let long = tree(long_arena, depth)
    let mut total = arena.with(fn(a: Arena) -> u64 {
      let stretch = tree(a, depth + 1u64)
      check(stretch)
    })
    let mut d: u64 = 4
    while d <= depth {
      for iteration in 0u64..(1u64 << (depth - d)) {
        total += arena.with(fn(a: Arena) -> u64 {
          let temporary = tree(a, d)
          check(temporary)
        })
      }
      d += 2u64
    }
    total + check(long)
  })
  number(total)
}
