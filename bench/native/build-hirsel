#!/usr/bin/env python3
"""Seal actual native executables for the available configurations and workloads."""
import argparse
import json
import subprocess
from pathlib import Path
from suite import ROOT, buck2_build, native_environment, sha, text_size

CONFIGURATIONS = ('regions-on-whole', 'regions-on-singleton', 'regions-off-size-class', 'regions-off-system')

def main():
    p = argparse.ArgumentParser(description=__doc__)
    p.add_argument('--case', action='append', default=[])
    p.add_argument('--output', type=Path, default=ROOT/'build/hirsel.json')
    p.add_argument('--configuration', action='append', choices=CONFIGURATIONS)
    args = p.parse_args()
    helper = Path(buck2_build('--target-platforms', '//tools/buck2:release', '//:hirsel-native-build-bin-hirsel-native-build')['hirsel-native-build-bin-hirsel-native-build'])
    env = native_environment({'HIRSEL_JOBS':'4'})
    revision = subprocess.run(['git','rev-parse','HEAD'],cwd=ROOT.parent.parent,capture_output=True,text=True,check=True).stdout.strip()
    specs = json.loads(args.output.read_text()) if args.output.exists() else {}
    for c in CONFIGURATIONS:specs.setdefault(c,{'cases':{}})
    sources = args.case or ['binarytrees']
    for case in sources:
        source = ROOT/'programs'/f'{case.replace("/", "-")}.hir'
        generated = ROOT/'build/hirsel-source'/source.name
        generated.parent.mkdir(parents=True, exist_ok=True)
        generated.write_text(source.read_text()+'\n'+(ROOT/'programs/common.hir').read_text())
        sidecar = dict(schema=1, package=dict(name='benchmark', version='1'),
                       entry=dict(module=[], name='main'),
                       sources=[dict(path=generated.name, module=[])],
                       dependencies=[dict(manifest=str(ROOT.parent.parent/'stdlib/std@1/hirsel.json'),
                                          package=dict(name='std', version='1'), expose=[])])
        generated.with_suffix('.hir.json').write_text(json.dumps(sidecar, indent=2)+'\n')
        batch = None
        if not args.configuration:
            proc = subprocess.run([str(helper), str(generated), str(ROOT/'build/hirsel'), 'all'],
                                  capture_output=True, text=True, env=env)
            batch = json.loads(proc.stdout) if not proc.returncode else {
                config: {'error': proc.stderr} for config in CONFIGURATIONS}
        for config in args.configuration or CONFIGURATIONS:
            binary = ROOT/'build/hirsel'/config/source.stem/'program'
            if batch is None:
                proc = subprocess.run([str(helper), str(generated), str(binary), config], capture_output=True, text=True, env=env)
            else:
                result = batch[config].get('timing', batch[config])
                proc = subprocess.CompletedProcess([], int('error' in result), json.dumps(result), result.get('error', ''))
            if proc.returncode:
                specs[config]['cases'].pop(case,None)
                specs[config].setdefault('unavailable',{})[case] = dict(reason=proc.stderr, source_sha256=sha(generated), compiler_revision=revision,
                    compiler_helper_sha256=sha(helper))
                print(f'{case}/{config}: unavailable',flush=True)
                continue
            specs[config].get('unavailable',{}).pop(case,None)
            record = json.loads(proc.stdout)
            archive = Path(record.pop("runtime_archive"))
            record.update(compiler_revision=revision, compiler_helper_sha256=sha(helper), runtime_archive_sha256=sha(archive),
                          dependency_source_sha256={str(p.relative_to(ROOT.parent.parent)):sha(p)
                            for p in sorted((ROOT.parent.parent/'stdlib/std@1').glob('*')) if p.is_file()},
                          launch_manifest_sha256=sha(generated.with_suffix('.hir.json')))
            record.update(command=[str(binary), '{case}', '{input}', '{rounds}', '{emit}'],
                          binary_sha256=sha(binary), source_sha256=sha(generated), text_bytes=text_size(binary),
                          counter_status='separate measurement archive; never used for timing')
            if case in ('binarytrees','binarytrees-region'):
                record['binarytrees_storage'] = 'arena' if case=='binarytrees-region' else 'heap'
            counter_binary = binary.with_name('program-measurement')
            if batch is None:
                measured = subprocess.run([str(helper), str(generated), str(counter_binary), config],
                                          capture_output=True, text=True,
                                          env=dict(env, HIRSEL_BENCH_MEASUREMENT='1'))
            else:
                result = batch[config].get('measurement', {'error': 'measurement build absent'})
                measured = subprocess.CompletedProcess([], int('error' in result), json.dumps(result), result.get('error', ''))
            if measured.returncode:
                record['counter_status'] = measured.stderr
            else:
                counter_record = json.loads(measured.stdout)
                counter_archive = Path(counter_record.pop('runtime_archive'))
                counter_record.update(runtime_archive_sha256=sha(counter_archive),
                                      text_bytes=text_size(counter_binary))
                record.update(counter_command=[str(counter_binary), '{case}', '{input}', '{rounds}', '{emit}'],
                              counter_binary_sha256=sha(counter_binary), counter_build=counter_record)
            specs[config]['cases'][case] = record
            print(f'{case}/{config}: built', flush=True)
        args.output.parent.mkdir(parents=True, exist_ok=True)
        args.output.write_text(json.dumps(specs, indent=2)+'\n')
    print(args.output)
if __name__ == '__main__': main()
