// langarena: Etc::Sieve
// Port: rust/src/benchmarks/sieve.rs:25-60 (3c9f84d).
type State {
  limit: u64,
  value_out: u32,
}

fn step(mut state: State, iteration: u64) {
  let limit = state.limit
  let mut primes: List[u8] = []
  for _ in 0u64..limit + 1 {
    list.push(mut primes, 1)
  }
  primes[0] = 0
  primes[1] = 0
  let mut p = 2u64
  while p * p <= limit {
    if primes[p] == 1 {
      let mut multiple = p * p
      while multiple <= limit {
        primes[multiple] = 0
        multiple += p
      }
    }
    p += 1
  }
  let mut last = 2u64
  let mut count = 1u64
  let mut n = 3u64
  while n <= limit {
    if primes[n] == 1 {
      last = n
      count += 1
    }
    n += 2
  }
  state.value_out = u32.wrapping_add(state.value_out, int.truncate(last + count))
}

fn checksum(s: State) -> u32 {
  s.value_out
}

pub fn execute(rt: Io, name: String, config: harness.Config) -> Result[
  harness.Report,
  String
] {
  harness.measure(
    rt,
    config,
    State(limit: harness.number(config, "limit"), value_out: 0),
    step,
    checksum
  )
}
