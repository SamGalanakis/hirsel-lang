// langarena: Binarytrees::Obj
// langarena: Binarytrees::Arena
// Port: rust/src/benchmarks/binarytrees.rs:4-46, 75-139 (3c9f84d).
type Tree = Leaf(item: i64) | Branch(item: i64, left: box Tree, right: box Tree)

fn tree(item: i64, depth: u64) -> box Tree {
  if depth == 0 {
    box Leaf(item: item)
  } else {
    let delta: i64 = int.narrow(1u64 << depth - 1)
    box Branch(
      item: item,
      left: tree(item - delta, depth - 1),
      right: tree(item + delta, depth - 1)
    )
  }
}

fn sum(node: box Tree) -> i64 {
  match node {
    Leaf(item: item) => item + 1,
    Branch(item: item, left: left, right: right) => item + 1 + sum(left) + sum(right),
  }
}

// rust/src/benchmarks/binarytrees.rs:65-76,104-140: twelve-byte nodes,
// signed -1 child sentinels, and wrapping u32 subtree sums.
type Node {
  item: i32,
  left: i32,
  right: i32,
}

fn build(mut nodes: List[Node], item: i32, depth: u64) -> i32 {
  let index = list.len(nodes)
  list.push(mut nodes, Node(item: item, left: -1, right: -1))
  if depth > 0 {
    let delta: i32 = int.narrow(1u64 << depth - 1)
    let left = build(mut nodes, item - delta, depth - 1)
    let right = build(mut nodes, item + delta, depth - 1)
    nodes[index].left = left
    nodes[index].right = right
  }
  int.narrow(index)
}

fn arena_sum(nodes: List[Node], index: i32) -> u32 {
  let position: u64 = int.narrow(index)
  let node = nodes[position]
  let mut total = u32.wrapping_add(int.truncate(node.item), 1)
  if node.left >= 0 {
    total = u32.wrapping_add(total, arena_sum(nodes, node.left))
  }
  if node.right >= 0 {
    total = u32.wrapping_add(total, arena_sum(nodes, node.right))
  }
  total
}

type State {
  depth: u64,
  arena: bool,
  nodes: List[Node],
  value_out: u32,
}

fn step(mut s: State, iteration: u64) {
  let value = if s.arena {
    s.nodes = []
    let root = build(mut s.nodes, 0, s.depth)
    arena_sum(s.nodes, root)
  } else {
    let positive: u64 = int.narrow(sum(tree(0, s.depth)))
    int.truncate(positive)
  }
  s.value_out = u32.wrapping_add(s.value_out, value)
}

fn checksum(s: State) -> u32 {
  s.value_out
}

pub fn execute(rt: Io, name: String, config: harness.Config) -> Result[
  harness.Report,
  String
] {
  harness.measure(
    rt,
    config,
    State(
      depth: harness.number(config, "depth"),
      arena: name == "Binarytrees::Arena",
      nodes: [],
      value_out: 0
    ),
    step,
    checksum
  )
}

@test
fn arena_vectors(t: Test) {
  let mut nodes: List[Node] = []
  let root = build(mut nodes, 0, 0)
  test.check(t, root == 0 && list.len(nodes) == 1)
  test.check(t, nodes[0].left == -1 && nodes[0].right == -1)
  test.check(t, arena_sum(nodes, root) == 1)
  nodes = []
  let branch = build(mut nodes, 0, 2)
  test.check(t, list.len(nodes) == 7 && nodes[0].left == 1 && nodes[0].right == 4)
  test.check(t, nodes[1].item == -2 && nodes[4].item == 2)
  test.check(t, arena_sum(nodes, branch) == 7)
  nodes = []
  let negative = build(mut nodes, -3, 1)
  test.check(t, arena_sum(nodes, negative) == 4294967290u32)
}
