// langarena: Etc::NeuralNet
// Port: LangArena 3c9f84d rust/src/benchmarks/neural_net.rs:11-222.
// Layers share an indexed neuron arena; synapse iteration and update order match.
type Synapse {
  weight: f64,
  prev_weight: f64,
  source: u64,
  dest: u64,
}

type Neuron {
  threshold: f64,
  prev_threshold: f64,
  output: f64,
  error: f64,
  incoming: List[u64],
  outgoing: List[u64],
}

type State {
  neurons: List[Neuron],
  synapses: List[Synapse],
}

fn random(mut seed: u64) -> f64 {
  seed = (seed * 3877 + 29573) % 139968
  let value: f64 = float.from_int(seed)
  value / 139968.0 * 2.0 - 1.0
}

fn feed(mut s: State, a: f64, b: f64) {
  s.neurons[0].output = a
  s.neurons[1].output = b
  for n in 2u64..13u64 {
    let mut activation: f64 = 0.0
    for k in s.neurons[n].incoming {
      let weight = s.synapses[k].weight
      let source = s.synapses[k].source
      activation += weight * s.neurons[source].output
    }
    activation -= s.neurons[n].threshold
    s.neurons[n].output = 1.0 / (1.0 + f64.exp(-activation))
  }
}

fn update(mut s: State, n: u64) {
  // These neuron scalars stay fixed throughout this incoming-synapse pass.
  let error = s.neurons[n].error
  for k in s.neurons[n].incoming {
    let weight = s.synapses[k].weight
    let prev_weight = s.synapses[k].prev_weight
    let source = s.synapses[k].source
    let source_output = s.neurons[source].output
    s.synapses[k].weight = weight + (0.3 * 1.0 * error * source_output + 0.3 * (weight - prev_weight))
    s.synapses[k].prev_weight = weight
  }
  let threshold = s.neurons[n].threshold
  let prev_threshold = s.neurons[n].prev_threshold
  s.neurons[n].threshold = threshold + (0.3 * 1.0 * error * -1.0 + 0.3 * (threshold - prev_threshold))
  s.neurons[n].prev_threshold = threshold
}

fn train(mut s: State, a: f64, b: f64, target: f64) {
  feed(mut s, a, b)
  let output = s.neurons[12].output
  s.neurons[12].error = (target - output) * (output * (1.0 - output))
  update(mut s, 12)
  for n in 2u64..12u64 {
    let mut sum: f64 = 0.0
    for k in s.neurons[n].outgoing {
      let prev_weight = s.synapses[k].prev_weight
      let dest = s.synapses[k].dest
      sum += prev_weight * s.neurons[dest].error
    }
    let value = s.neurons[n].output
    s.neurons[n].error = sum * (value * (1.0 - value))
    update(mut s, n)
  }
}

fn step(mut s: State, iteration: u64) {
  for _ in 0u64..1000u64 {
    train(mut s, 0.0, 0.0, 0.0)
    train(mut s, 1.0, 0.0, 1.0)
    train(mut s, 0.0, 1.0, 1.0)
    train(mut s, 1.0, 1.0, 0.0)
  }
}

fn checksum(s: State) -> u32 {
  let mut net_copy = unique s
  feed(mut net_copy, 0.0, 0.0)
  let mut sum = net_copy.neurons[12].output
  feed(mut net_copy, 0.0, 1.0)
  sum += net_copy.neurons[12].output
  feed(mut net_copy, 1.0, 0.0)
  sum += net_copy.neurons[12].output
  feed(mut net_copy, 1.0, 1.0)
  sum += net_copy.neurons[12].output
  harness.hash_float(sum)
}

pub fn execute(rt: Io, name: String, config: harness.Config) -> Result[
  harness.Report,
  String
] {
  let mut s = State(neurons: [], synapses: [])
  let mut seed = 42u64
  for _ in 0u64..13u64 {
    let t = random(mut seed)
    list.push(
      mut s.neurons,
      Neuron(
        threshold: t,
        prev_threshold: t,
        output: 0.0,
        error: 0.0,
        incoming: [],
        outgoing: []
      )
    )
  }
  for layer in 0u64..2u64 {
    let begin = if layer == 0 {
      0u64
    } else {
      2u64
    }
    let end = if layer == 0 {
      2u64
    } else {
      12u64
    }
    let dest_begin = if layer == 0 {
      2u64
    } else {
      12u64
    }
    let dest_end = if layer == 0 {
      12u64
    } else {
      13u64
    }
    for source in begin..end {
      for dest in dest_begin..dest_end {
        let k = list.len(s.synapses)
        let w = random(mut seed)
        list.push(
          mut s.synapses,
          Synapse(weight: w, prev_weight: w, source: source, dest: dest)
        )
        list.push(mut s.neurons[source].outgoing, k)
        list.push(mut s.neurons[dest].incoming, k)
      }
    }
  }
  harness.measure(rt, config, take s, step, checksum)
}
