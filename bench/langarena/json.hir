// langarena: Json::Generate
// langarena: Json::ParseDom
// langarena: Json::ParseMapping
// LangArena 3c9f84d rust/src/benchmarks/json_generate.rs:8-105,
// json_parse_dom.rs:28-86, json_parse_mapping.rs:5-93.
// Direct derived writer/reader correspond to serde's typed serialization paths.
type Coordinate {
  x: f64,
  y: f64,
  z: f64,
  name: String,
  opts: Map[String, (i32, bool)],
}

type Data {
  coordinates: List[Coordinate],
  info: String,
}

type Point {
  x: f64,
  y: f64,
  z: f64,
}

type Points {
  coordinates: List[Point],
}

fn coordinate_json_into(value: Coordinate, mut out: List[u8], depth: u64) -> Result[
  (),
  std@1/json.JsonError
] uses {} = comptime derive.json_into(shape(Coordinate))

fn data_json_into(value: Data, mut out: List[u8], depth: u64) -> Result[
  (),
  std@1/json.JsonError
] uses {} = comptime derive.json_into(shape(Data))

fn point_from_json_reader(mut cursor: std@1/json.Reader) -> Result[unique Point, String] uses {} = comptime derive.from_json_reader(
  shape(Point)
)

fn points_from_json_reader(mut cursor: std@1/json.Reader) -> Result[
  unique Points,
  String
] uses {} = comptime derive.from_json_reader(shape(Points))

fn points_from_json_bytes(data: Bytes) -> Result[unique Points, String] uses {} = comptime derive.from_json_bytes(
  shape(Points)
)

fn random(mut seed: u64) -> f64 {
  seed = (seed * 3877 + 29573) % 139968
  let value: f64 = float.from_int(seed)
  value / 139968.0
}

fn prepare_data(count: u64) -> Data {
  let mut seed = 42u64
  let mut coordinates: List[Coordinate] = []
  for _ in 0u64..count {
    let x = f64.round(random(mut seed) * 100000000.0) / 100000000.0
    let y = f64.round(random(mut seed) * 100000000.0) / 100000000.0
    let z = f64.round(random(mut seed) * 100000000.0) / 100000000.0
    let fraction = random(mut seed)
    let integer: u64 = int.narrow(
      results.unwrap_or(float.to_i32(random(mut seed) * 10000.0), -1)
    )
    let mut opts: Map[String, (i32, bool)] = map.empty()
    map.insert(mut opts, "1", (1, true))
    list.push(
      mut coordinates,
      Coordinate(x: x, y: y, z: z, name: f"{fraction:.7} {integer}", opts: take opts)
    )
  }
  Data(coordinates: take coordinates, info: "some info")
}

fn serialize(value: Data) -> String {
  let mut out: List[u8] = []
  let Ok(()) = data_json_into(value, mut out, 0) else {
    check(false)
    return ""
  }
  text.finish_valid(take out)
}

fn field(value: std@1/json.Value, key: String) -> f64 {
  let Object(fields) = value else {
    check(false)
    return 0.0
  }
  let Some(Number(spelling)) = map.get(fields, key) else {
    check(false)
    return 0.0
  }
  let Ok(number) = f64.parse(spelling) else {
    check(false)
    return 0.0
  }
  number
}

fn average(points: List[Point]) -> u32 {
  let mut x: f64 = 0.0
  let mut y: f64 = 0.0
  let mut z: f64 = 0.0
  for point in points {
    x += point.x
    y += point.y
    z += point.z
  }
  let count: f64 = float.from_int(list.len(points))
  u32.wrapping_add(
    u32.wrapping_add(harness.hash_float(x / count), harness.hash_float(y / count)),
    harness.hash_float(z / count)
  )
}

type State {
  name: String,
  data: Data,
  source: String,
  rendered: String,
  total: u32,
}

fn step(mut s: State, iteration: u64) {
  if s.name == "Json::Generate" {
    s.rendered = serialize(s.data)
    if string.starts_with(s.rendered, "{\"coordinates\":") {
      s.total = u32.wrapping_add(s.total, 1)
    }
  } else if s.name == "Json::ParseMapping" {
    let Ok(parsed) = points_from_json_bytes(string.as_bytes(s.source)) else {
      check(false)
      return
    }
    s.total = u32.wrapping_add(s.total, average(parsed.coordinates))
  } else {
    let Ok(Object(root)) = std@1/json.parse(unique s.source) else {
      check(false)
      return
    }
    let Some(Array(coordinates)) = map.get(root, "coordinates") else {
      check(false)
      return
    }
    let mut x: f64 = 0.0
    let mut y: f64 = 0.0
    let mut z: f64 = 0.0
    for coordinate in coordinates {
      x += field(coordinate, "x")
      y += field(coordinate, "y")
      z += field(coordinate, "z")
    }
    let count: f64 = float.from_int(list.len(coordinates))
    s.total = u32.wrapping_add(
      s.total,
      u32.wrapping_add(
        u32.wrapping_add(harness.hash_float(x / count), harness.hash_float(y / count)),
        harness.hash_float(z / count)
      )
    )
  }
}

fn checksum(s: State) -> u32 {
  s.total
}

pub fn execute(rt: Io, name: String, config: harness.Config) -> Result[
  harness.Report,
  String
] {
  let value = prepare_data(harness.number(config, "coords"))
  let source = if name == "Json::Generate" {
    ""
  } else {
    serialize(value)
  }
  harness.measure(
    rt,
    config,
    State(name: unique name, data: value, source: source, rendered: "", total: 0),
    step,
    checksum
  )
}

fn check(ok: bool) -> ()
  requires ok {}
