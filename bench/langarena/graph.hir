// langarena: Graph::BFS
// langarena: Graph::DFS
// langarena: Graph::AStar
// Port: LangArena 3c9f84d rust/src/benchmarks/graph_path.rs:11-316.
// Bounded i32 adjacency follows the reference; list indices remain u64.
// Queue storage uses a list and a head index; stack/heap order is unchanged.
type Entry {
  score: i64,
  vertex: u64,
}

fn precedes(a: Entry, b: Entry) -> bool {
  a.score < b.score || a.score == b.score && a.vertex < b.vertex
}

// BinaryHeap<Reverse<Node>>: Rust a7c37f9 library/alloc/src/collections/
// binary_heap/mod.rs:807-882 (sift_up/sift_down). Copyable entries fill holes.
// Pair ordering matches the reference Node::cmp.
fn push(mut queue_heap: unique List[Entry], item: Entry) {
  list.push(mut queue_heap, item)
  let mut i = list.len(queue_heap) - 1
  while i > 0 {
    let parent = (i - 1) / 2
    if !precedes(item, queue_heap[parent]) {
      break
    }
    queue_heap[i] = queue_heap[parent]
    i = parent
  }
  queue_heap[i] = item
}

fn pop(mut queue_heap: unique List[Entry]) -> Entry {
  let first = queue_heap[0]
  let last = option.unwrap_or(list.pop(mut queue_heap), first)
  if list.len(queue_heap) > 0 {
    let mut i = 0u64
    while i * 2 + 1 < list.len(queue_heap) {
      let mut child = i * 2 + 1
      if child + 1 < list.len(queue_heap) && precedes(
        queue_heap[child + 1],
        queue_heap[child]
      ) {
        child += 1
      }
      if !precedes(queue_heap[child], last) {
        break
      }
      queue_heap[i] = queue_heap[child]
      i = child
    }
    queue_heap[i] = last
  }
  first
}

fn random(mut seed: u64, max: u64) -> u64 {
  seed = (seed * 3877 + 29573) % 139968
  let value: f64 = float.from_int(seed)
  let bound: f64 = float.from_int(max)
  int.narrow(results.unwrap_or(float.to_i32(value / 139968.0 * bound), 0))
}

type State {
  adj: List[List[i32]],
  mode: u64,
  value_out: u32,
}

// LangArena graph_path.rs:249-295: identical score admission and stop rule.
// Keep AStar's i32 score storage separate from the BFS/DFS distance frontier.
fn astar(s: State) -> i64 {
  let n = list.len(s.adj)
  let target = n - 1
  if target == 0 {
    return 0
  }
  let mut g: unique List[i32] = []
  let mut best: unique List[i32] = []
  list.reserve(mut g, n)
  list.reserve(mut best, n)
  for _ in 0u64..n {
    list.push(mut g, 2147483647)
    list.push(mut best, 2147483647)
  }
  let mut pending: unique List[Entry] = []
  let start_h: i32 = int.narrow(target)
  g[0] = 0
  best[0] = start_h
  push(mut pending, Entry(score: int.widen(start_h), vertex: 0))
  while list.len(pending) > 0 {
    let current = pop(mut pending)
    let v = current.vertex
    if v == target {
      return int.widen(g[v])
    }
    let current_g = g[v]
    for neighbor_id in s.adj[v] {
      let neighbor: u64 = int.narrow(neighbor_id)
      let tentative = current_g + 1
      if tentative < g[neighbor] {
        g[neighbor] = tentative
        let heuristic: i32 = int.narrow(target - neighbor)
        let f = tentative + heuristic
        if f < best[neighbor] {
          best[neighbor] = f
          push(mut pending, Entry(score: int.widen(f), vertex: neighbor))
        }
      }
    }
  }
  -1
}

fn search(s: State) -> i64 {
  if s.mode == 2 {
    return astar(s)
  }
  let n = list.len(s.adj)
  let target = n - 1
  if target == 0 {
    return 0
  }
  let mut visited: List[bool] = []
  for _ in 0u64..n {
    list.push(mut visited, false)
  }
  let mut pending: List[Entry] = []
  let mut head = 0u64
  let mut shortest = 2147483647i64
  list.push(mut pending, Entry(score: 0, vertex: 0))
  if s.mode == 0 {
    visited[0] = true
  }
  while if s.mode == 0 {
    head < list.len(pending)
  } else {
    list.len(pending) > 0
  } {
    let current = if s.mode == 0 {
      let item = pending[head]
      head += 1
      item
    } else {
      option.unwrap_or(list.pop(mut pending), Entry(score: 0, vertex: 0))
    }
    let v = current.vertex
    let distance = current.score
    if s.mode == 1 {
      if visited[v] || distance >= shortest {
        continue
      }
      visited[v] = true
    }
    for neighbor_id in s.adj[v] {
      let neighbor: u64 = int.narrow(neighbor_id)
      if neighbor == target {
        if s.mode == 0 {
          return distance + 1
        }
        if distance + 1 < shortest {
          shortest = distance + 1
        }
      } else if !visited[neighbor] {
        if s.mode == 0 {
          visited[neighbor] = true
        }
        list.push(mut pending, Entry(score: distance + 1, vertex: neighbor))
      }
    }
  }
  if s.mode == 1 && shortest != 2147483647 {
    shortest
  } else {
    -1
  }
}

fn step(mut s: State, iteration: u64) {
  let wrapped: u64 = int.truncate(search(s))
  s.value_out = u32.wrapping_add(s.value_out, int.truncate(wrapped))
}

fn checksum(s: State) -> u32 {
  s.value_out
}

pub fn execute(rt: Io, name: String, config: harness.Config) -> Result[
  harness.Report,
  String
] {
  let n = harness.number(config, "vertices")
  if n == 0 || n > 2147483647 {
    return Error("graph vertices must be in 1..2147483647")
  }
  let jumps = harness.number(config, "jumps")
  let jump_len = harness.number(config, "jump_len")
  let mut adj: List[List[i32]] = []
  list.reserve(mut adj, n)
  for _ in 0u64..n {
    list.push(mut adj, [])
  }
  for i in 1u64..n {
    list.push(mut adj[i], int.narrow(i - 1))
    list.push(mut adj[i - 1], int.narrow(i))
  }
  let mut seed = 42u64
  for v in 0u64..n {
    let count = random(mut seed, jumps)
    for _ in 0u64..count {
      let offset: i64 = int.narrow(random(mut seed, jump_len))
      let vertex: i64 = int.narrow(v)
      let half: i64 = int.narrow(jump_len / 2)
      let u = vertex + offset - half
      let bound: i64 = int.narrow(n)
      if u >= 0 && u < bound && u != vertex {
        let index: u64 = int.narrow(u)
        let id: i32 = int.narrow(u)
        list.push(mut adj[v], id)
        list.push(mut adj[index], int.narrow(v))
      }
    }
  }
  harness.measure(
    rt,
    config,
    State(
      adj: take adj,
      mode: if name == "Graph::BFS" {
        0
      } else if name == "Graph::DFS" {
        1
      } else {
        2
      },
      value_out: 0
    ),
    step,
    checksum
  )
}
