#!/usr/bin/env python3
"""Regenerate the checked-in matched Hirsel programs (no compiler/runtime edits)."""
from pathlib import Path
HERE = Path(__file__).resolve().parent
HEADER = '''pub type AppError = Grant(GrantError) | Output(OutputError) | Files(FileError)
pub fn main(rt: Io, args: Args) -> Result[(), AppError] {
  let n = match arg.text(args, 0) {
    Ok(t) => match u64.parse(t) { Ok(v) => v, Error(_) => 1000u64, },
    Error(_) => 1000u64,
  }
  let tasks = io.tasks(rt) ? Grant
'''
END = '''  let stdout = io.stdout(rt) ? Grant
  out.print(stdout, f"{sum}\\n") ? Output
  Ok(())
}
'''
BODIES = {
'yield': 'let _ = task.check_canceled(s)\n          sum = sum + 1',
'cancel_depth': 'let _ = task.check_canceled(s)\n          sum = sum + 1',
'atomic': 'sum = sum + atomic.load(tasks, a)',
'roots': '''let owned = copy root
          sum = sum + shared.with(owned, fn(xs: List[u64]) -> u64 { xs[0] })''',
'mutex': '''mutex.with(tasks, m, fn(mut v: u64) { v = v + 1 })
          sum = sum + 1''',
'allocation': '''let mut data: unique List[u64] = unique []
          for _ in 0u64..64u64 { list.push(mut data, 1u64) }
          sum = sum + data[0]''',
'namespace_mix': '''let from = path.of(f"a-{lane}")
          let to = path.of(f"b-{lane}")
          let _f = file.create(dir, from) ? Files
          file.rename(dir, from, to) ? Files
          file.remove(dir, to) ? Files
          sum = sum + 1''',
'independent_files': '''let written = file.write(dir, mut file, string.as_bytes("x")) ? Files
          sum = sum + written''',
}
for case, body in BODIES.items():
    pre = ''
    if case in ('namespace_mix', 'independent_files'):
        pre += '  let dir = io.dir(rt, path.of(".")) ? Files\n'
    if case == 'atomic': pre += '  let a: Atomic[u64] = atomic.create(tasks, 7u64)\n'
    if case == 'mutex': pre += '  let m = mutex.create(tasks, 0u64)\n'
    if case == 'roots':
        pre += '  let mut data: unique List[u64] = unique []\n  for _ in 0u64..64u64 { list.push(mut data, 1u64) }\n  let root = shared.freeze(take data)\n'
    # Fixed logical parallelism independent of physical width.
    text = HEADER + pre + '  let sum = task.scope(tasks, fn(s: Scope) -> Result[u64, AppError] {\n    let mut set: TaskSet[Result[u64, AppError]] of s = task.set(s)\n    for lane in 0u64..8u64 {\n      task.add(s, mut set, task.async(s, fn() -> Result[u64, AppError] {\n'
    if case == 'independent_files': text += '        let mut file = file.create(dir, path.of(f"lane-{lane}")) ? Files\n'
    inner = '        let mut sum = 0u64\n        for _ in 0u64..n {\n          ' + body + '\n        }\n        sum\n'
    if case in ('cancel_depth', 'yield'):
        inner = inner.replace('task.check_canceled(s)', 'task.check_canceled(scope0)')
        for depth in range(4 if case == 'cancel_depth' else 1):
            inner = f'        task.scope(tasks, fn(scope{depth}: Scope) -> u64 {{\n' + inner + '        })\n'
    if case in ('cancel_depth', 'yield'): text += '        let value = ' + inner.strip() + '\n        Ok(value)\n'
    else: text += inner.rsplit('        sum\n', 1)[0] + '        Ok(sum)\n'
    text += '''      }))
    }
    let mut sum = 0u64
    for i in 0u64..8u64 { sum = sum + task.await_at(s, mut set, i)? }
    task.detach_all(s, take set)
    Ok(sum)
  })?
'''
    (HERE/'programs'/f'{case}.hir').write_text(text + END)
(HERE/'programs/fork_join.hir').write_text(HEADER + '''  let sum = task.scope(tasks, fn(s: Scope) -> u64 {
    let mut sum = 0u64
    for i in 0u64..n {
      let child = task.async(s, fn() -> u64 { i + 1 })
      sum = sum + task.await(s, take child)
    }
    sum
  })
''' + END)
(HERE/'programs/late_set.hir').write_text(HEADER + '''  let sum = task.scope(tasks, fn(s: Scope) -> u64 {
    let mut sum = 0u64
    for _ in 0u64..n {
      let (tx, rx): (Sender[u64], Receiver[u64]) = channel.open(tasks)
      let a = task.async(s, fn() -> u64 {
        let mut sender = take tx
        let _ = channel.send(tasks, mut sender, 1u64)
        1
      })
      let b = task.async(s, fn() -> u64 {
        task.scope(tasks, fn(inner: Scope) -> u64 {
          let _ = task.check_canceled(inner)
          2
        })
      })
      let mut receiver = take rx
      let _ = channel.receive(tasks, mut receiver)
      let mut set: TaskSet[u64] of s = task.set(s)
      task.add(s, mut set, take a)
      task.add(s, mut set, take b)
      let first = match task.await_any(s, set) { Some(i) => i, None => 99u64, }
      sum = sum + task.await_at(s, mut set, first)
      task.add(s, mut set, task.async(s, fn() -> u64 { 3 }))
      for _ in 0u64..2u64 {
        let next = match task.await_any(s, set) { Some(i) => i, None => 99u64, }
        sum = sum + task.await_at(s, mut set, next)
      }
      task.detach_all(s, take set)
    }
    sum
  })
''' + END)
(HERE/'programs/channel.hir').write_text((HERE.parent/'micro/programs/channel.hir').read_text())
