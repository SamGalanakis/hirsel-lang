# A standalone serde_json reference; it does not enter the compiler workspace.
rust_binary(
    name = "json-reference",
    crate = "json_reference",
    crate_root = "main.rs",
    srcs = ["main.rs"],
    deps = ["root//third-party:serde_json"],
    edition = "2021",
    rustc_flags = ["-Copt-level=3", "-Coverflow-checks=yes", "-Ccodegen-units=1"],
    visibility = ["PUBLIC"],
)

