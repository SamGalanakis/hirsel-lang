#!/usr/bin/env python3
"""Run the original Hirsel HTTP contract suite against the Rust server."""
import argparse
import json
from pathlib import Path
import subprocess
import tempfile
from support import CAPPED, ROOT, TOOLCHAIN, Server, free_port, line

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('--hirsel', type=Path, default=TOOLCHAIN)
parser.add_argument('--hirsel-server', type=Path, default=Path('/tmp/tasks-rust-hirsel'))
parser.add_argument('--kind', choices=['rust', 'rust-one-worker', 'hirsel'], default='rust')
parser.add_argument('--restart-kind', choices=['rust', 'rust-one-worker', 'hirsel'])
args = parser.parse_args()
with tempfile.TemporaryDirectory(prefix='tasks-e2e-') as temporary:
    directory = Path(temporary)
    port = free_port()
    client_grants = json.dumps({'io': {'stdout': 'stdout.bytes@1', 'dirs': [], 'net': {
        'provider': 'net.stream@1', 'rules': [{'address': '127.0.0.1', 'service': str(port), 'operation': 'connect'}]}}})
    def client(phase):
        return [str(CAPPED), '--timeout', '300', str(args.hirsel), 'run',
                str(ROOT / 'examples/tasks/e2e/hirsel.json'), '--grants', client_grants,
                '--', phase, str(port)]
    server = Server(args.kind, directory, port, args.hirsel_server, directory / 'server.log')
    watcher = None
    try:
        first = subprocess.run(client('first'), capture_output=True, timeout=310)
        assert first.returncode == 0, (first.stdout, first.stderr, (directory / 'server.log').read_text())
        assert first.stdout == b'ok: 96 checks\n', first.stdout
        print(first.stdout.decode(), end='', flush=True)
        watcher = subprocess.Popen(client('watch'), stdout=subprocess.PIPE, stderr=subprocess.PIPE, bufsize=0)
        assert line(watcher, 60) == 'watching'
        server.stop()
        output, errors = watcher.communicate(timeout=60)
        assert watcher.returncode == 0 and output == b'ended\nok: 5 checks\n', (output, errors)
        print(output.decode(), end='', flush=True)
        server = Server(args.restart_kind or args.kind, directory, port, args.hirsel_server, directory / 'restart.log')
        second = subprocess.run(client('second'), capture_output=True, timeout=310)
        assert second.returncode == 0 and second.stdout == b'ok: 14 checks\n', (second.stdout, second.stderr)
        print(second.stdout.decode(), end='', flush=True)
        server.stop()
        snapshots = sorted(directory.glob('board-*.json'))
        assert len(snapshots) == 2, snapshots
        board = json.loads(snapshots[-1].read_text())
        assert board['revision'] == 8 and board['next_id'] == 4, board
        print('ok: 2 snapshot checks (117 total)', flush=True)
    finally:
        server.stop()
        if watcher is not None and watcher.poll() is None:
            watcher.terminate()
            watcher.wait(15)
