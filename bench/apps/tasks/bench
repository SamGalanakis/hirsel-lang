EVENTS = 'task-clock,cycles,instructions,cycles:u,instructions:u'
KINDS = ['hirsel', 'hirsel-recorded', 'rust', 'rust-one-worker']


def is_hirsel(kind):
    return kind in ('hirsel', 'hirsel-recorded', 'hirsel-before')


def binary_for(kind, args):
    return args.baseline_binary if kind == 'hirsel-before' else args.binary if is_hirsel(kind) else RUST


def per_request(row, metric):
    count = 1 if row['operation'] in ('cold', 'restart', 'sse') else row['completed']
    return row['perf'][metric] / count


def run(command, **kwargs):
    return subprocess.run([str(v) for v in command], check=True, **kwargs)


def build(binary):
    run([CAPPED, '--timeout', 300, 'cargo', 'build', '--release', '--locked',
         '--manifest-path', APP / 'rust/Cargo.toml', '--target-dir', APP / 'rust/target'])
    output = subprocess.check_output([str(ROOT / '.buck2/bin/buck2'), 'build',
        '--target-platforms', '//tools/buck2:release', '//:hirsel-toolchain', '//:hirsel-rt-archives',
        '//tools/buck2/native-toolchain:kit', '//tools/buck2/native-toolchain:glibc_floor', '--show-full-output'], cwd=ROOT, text=True)
    paths = {line.split()[0].rsplit(':', 1)[1]: line.split()[1] for line in output.splitlines() if line.startswith('root//')}
    environment = dict(os.environ, LLVM_SYS_211_PREFIX='/usr/lib/llvm-21',
        HIRSEL_RUNTIME_ARCHIVES=paths['hirsel-rt-archives'], HIRSEL_LINK_KIT=paths['kit'], HIRSEL_GLIBC_FLOOR=paths['glibc_floor'])
    run([CAPPED, '--timeout', 300, Path(paths['hirsel-toolchain']) / 'hirsel', 'build', ROOT / 'examples/tasks/hirsel.json',
         '--release', '-o', binary], env=environment)


def sibling():
    fields = next(s.split()[1:] for s in Path('/proc/stat').read_text().splitlines() if s.startswith('cpu15 '))
    values = list(map(int, fields))[:8]
    return {'busy': sum(values) - values[3] - values[4], 'total': sum(values)}


def rss(pid):
    fields = dict(s.split(':', 1) for s in Path(f'/proc/{pid}/status').read_text().splitlines() if ':' in s)
    return int(fields['VmRSS'].split()[0]) * 1024


def request(port):
    connection = http.client.HTTPConnection('127.0.0.1', port, timeout=60)
    connection.request('GET', '/?q=Task+9999')
    response = connection.getresponse()
    assert response.status == 200, response.status
    response.read()
    connection.close()


def fixture(directory, count):
    directory.mkdir()
    board = dict(next_id=count + 1, revision=1, tasks=[dict(id=n, title=f'Task {n}',
        description='Benchmark description', status='Todo', priority='Medium',
        due=None, tags=['bench', f'group-{n % 10}']) for n in range(1, count + 1)])
    (directory / 'board-00000000000000000001.json').write_text(json.dumps(board, separators=(',', ':')))


def counters(path):
    counts, _ = perf_counts(path.read_text())
    return counts


class AttachedPerf:
    def __init__(self, pid, directory, record=False):
        self.record = record
        prefix = 'record-' if record else ''
        self.control = directory / (prefix + 'control')
        self.ack = directory / (prefix + 'ack')
        os.mkfifo(self.control)
        os.mkfifo(self.ack)
        # RDWR avoids FIFO-open deadlock, acknowledgements synchronize measurement.
        self.control_fd = os.open(self.control, os.O_RDWR)
        self.ack_fd = os.open(self.ack, os.O_RDWR)
        self.output = directory / ('profile.data' if record else 'perf.csv')
        command = (['perf', 'record', '-e', 'cycles:u', '-c', '1000000', '-m', '16M',
                    '-g', '--call-graph', 'dwarf,8192'] if record else
                   ['perf', 'stat', '-x', ';', '-e', EVENTS])
        self.process = subprocess.Popen([*command, '-o', str(self.output),
            '-p', str(pid), '-D', '-1', '--control', f'fifo:{self.control},{self.ack}'], stderr=subprocess.PIPE)

    def send(self, command):
        os.write(self.control_fd, (command + '\n').encode())
        import select
        if not select.select([self.ack_fd], [], [], 30)[0]:
            raise RuntimeError('perf control acknowledgement timed out')
        assert os.read(self.ack_fd, 1024).startswith(b'ack'), 'bad perf acknowledgement'

    def stop(self):
        self.process.send_signal(signal.SIGINT)
        _, error = self.process.communicate(timeout=30)
        os.close(self.control_fd)
        os.close(self.ack_fd)
        self.control.unlink()
        self.ack.unlink()
        if self.process.returncode not in (0, -signal.SIGINT):
            raise RuntimeError(error.decode())
        return None if self.record else counters(self.output)


def sample(kind, operation, rate, args, directory, round_number, profile=False):
    directory.mkdir()
    data = directory / 'data'
    count = 0 if operation == 'cold' else 10000
    fixture(data, count)
    port = free_port()
    before = sibling()
    lifetime = directory / 'lifetime.csv' if operation in ('cold', 'restart') else None
    binary = binary_for(kind, args)
    server = Server(kind, data, port, binary, directory / 'server.log', timeout=900, perf=lifetime,
                    record=directory / 'profile.data' if profile and lifetime else None)
    client = None
    perf = None
    recording = None
    try:
        marker = json.loads(server.marker.read_text())
        pid = marker['pid']
        if lifetime:
            pid = int(Path(f'/proc/{pid}/task/{pid}/children').read_text().split()[0])
        request(port)
        first_ms = (time.monotonic_ns() - marker['started_ns']) / 1e6
        idle_rss = rss(pid)
        result = {'kind': kind, 'operation': operation, 'rate': rate, 'round': round_number,
                  'first_ms': first_ms, 'idle_rss': idle_rss, 'binary_bytes': binary.stat().st_size,
                  'sibling_before': before}
        if operation not in ('cold', 'restart'):
            client = subprocess.Popen([str(CAPPED), '--timeout', '600', 'taskset', '-c', '7',
                str(APP / 'rust/target/release/load'), str(port), operation, str(rate), str(args.seconds)],
                stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=open(directory / 'client.log', 'wb'), bufsize=0,
                env=dict(os.environ, HIRSEL_JOBS='1'))
            assert line(client, 120) == 'ready'
            if profile:
                recording = AttachedPerf(pid, directory, record=True)
                # A short fan-out can finish before perf has attached. The ack makes
                # attachment/enable a barrier, just like the comparison counters.
                recording.send('enable')
            perf = AttachedPerf(pid, directory)
            before = sibling()
            result['sibling_before'] = before
            perf.send('enable')
            client.stdin.write(b'go\n')
            client.stdin.flush()
            output, _ = client.communicate(timeout=600)
            perf.send('disable')
            measured_after = sibling()
            result.update(json.loads(output))
            result['perf'] = perf.stop()
            perf = None
            if client.returncode:
                raise RuntimeError((directory / 'client.log').read_text())
            result['load_rss'] = rss(pid)
            if recording:
                recording.send('disable')
                recording.stop()
                recording = None
                result['profile'] = subprocess.check_output(['perf', 'report', '-i', str(directory / 'profile.data'), '--stdio', '--no-children', '--sort', 'symbol', '--percent-limit', '0', '-F', 'overhead,symbol'], text=True)
            denominator = 1 if operation == 'sse' else result['completed']
            result['instructions_per_request'] = result['perf']['instructions'] / denominator
            result['cpu_s_per_request'] = result['perf']['task-clock'] / 1000 / denominator
        server.stop()
        if kind == 'hirsel-recorded':
            tape = directory / 'data.tape'
            if not tape.is_file():
                raise RuntimeError('recorded participant produced no tape')
            result['tape_bytes'] = tape.stat().st_size
            with tape.open('rb') as source:
                result['tape_sha256'] = hashlib.file_digest(source, 'sha256').hexdigest()
            # The exact fixture and commands reproduce tapes; keep their hashes and sizes.
            tape.unlink()
            tape.with_name(tape.name + '.timing.json').unlink(missing_ok=True)
        if lifetime:
            result['perf'] = counters(lifetime)
            result['instructions_per_request'] = result['perf']['instructions']
            result['cpu_s_per_request'] = result['perf']['task-clock'] / 1000
            if profile:
                result['profile'] = subprocess.check_output(['perf', 'report', '-i', str(directory / 'profile.data'), '--stdio', '--no-children', '--sort', 'symbol', '--percent-limit', '0', '-F', 'overhead,symbol'], text=True)
        after = measured_after if operation not in ('cold', 'restart') else sibling()
        result['sibling_after'] = after
        result['sibling_busy_share'] = (after['busy'] - before['busy']) / max(1, after['total'] - before['total'])
        return result
    finally:
        if client and client.poll() is None:
            client.terminate()
            client.wait(30)
        if recording:
            recording.stop()
        if perf:
            perf.stop()
        server.stop(check=False)
        # Snapshot artifacts can exceed gigabytes over a long run; retain counters
        # and diagnostics, but remove the fully reproducible seeded board.
        shutil.rmtree(data)


def startup_profile(kind, operation, args, directory):
    directory.mkdir()
    data = directory / 'data'
    fixture(data, 0 if operation == 'cold' else 10000)
    server = Server(kind, data, free_port(), binary_for(kind, args), directory / 'server.log', record=directory / 'profile.data')
    try:
        request(server.port)
    finally:
        server.stop()
    output = subprocess.check_output([str(CAPPED), '--timeout', '60', 'perf', 'report', '-i', str(directory / 'profile.data'),
                                      '--stdio', '--no-children', '--sort', 'symbol', '--percent-limit', '0', '-F', 'overhead,symbol'], text=True)
    shutil.rmtree(data)
    return output


def memory_profile(kind, args, directory):
    directory.mkdir()
    data = directory / 'data'
    fixture(data, 10000)
    raw = directory / 'heap.raw'
    server = Server(kind, data, free_port(), binary_for(kind, args), directory / 'server.log', heap=raw)
    try:
        request(server.port)
        connection = http.client.HTTPConnection('127.0.0.1', server.port, timeout=60)
        connection.request('GET', '/')
        reply = connection.getresponse()
        assert reply.status == 200
        reply.read()
        connection.close()
        client = run([CAPPED, '--timeout', 300, 'taskset', '-c', 7, APP / 'rust/target/release/load',
                      server.port, 'sse', 100, 1], input=b'go\n', stdout=subprocess.PIPE)
        pid = json.loads(server.marker.read_text())['pid']
        maps = Path(f'/proc/{pid}/smaps').read_text()
        (directory / 'smaps.txt').write_text(maps)
    finally:
        server.stop()
    interpreted = directory / 'heap.interpreted'
    with raw.open('rb') as source, interpreted.open('wb') as output:
        run([CAPPED, '--timeout', 300, '/usr/lib/heaptrack/libexec/heaptrack_interpret'], stdin=source, stdout=output)
    output = subprocess.check_output([str(CAPPED), '--timeout', '300', 'heaptrack_print', '-f', str(interpreted),
                                      '-p', '1', '-a', '0', '-T', '0', '-n', '5', '-s', '2'], text=True)
    shutil.rmtree(data)
    regions = []
    current = None
    for line in maps.splitlines():
        if line and line[0] in '0123456789abcdef' and '-' in line.split()[0]:
            if current:
                regions.append(current)
            current = {'mapping': line}
        elif current and ':' in line:
            key, value = line.split(':', 1)
            if key in ('Size', 'Rss', 'Private_Dirty'):
                current[key] = int(value.split()[0])
    if current:
        regions.append(current)
    largest = sorted(regions, key=lambda r: r.get('Rss', 0), reverse=True)[:12]
    return output + '\nLargest resident mappings after list + 100 subscribers (KiB):\n' + json.dumps(largest, indent=2)


def profile_excerpt(key, value):
    if key.endswith('/heap'):
        lines = value.splitlines()
        start = next((i for i, line in enumerate(lines) if line == 'PEAK MEMORY CONSUMERS'), 0)
        excerpt = lines[start:start + 80]
        excerpt += [line for line in lines if line.startswith(('total runtime:', 'calls to allocation', 'temporary memory', 'peak heap', 'peak RSS', 'total memory'))]
        marker = 'Largest resident mappings after list + 100 subscribers (KiB):\n'
        if marker in value:
            excerpt += ['', marker.strip(), json.dumps(json.loads(value.split(marker, 1)[1])[:4], indent=2)]
        return '\n'.join(excerpt)
    lines = value.splitlines()
    headers = [line for line in lines if line.startswith(('# Samples:', '# Total Lost Samples:', '# Event count'))]
    symbols = [line.rstrip() for line in lines if re.match(r'\s+\d+\.\d+%  \[', line)]
    symbols.sort(key=lambda line: float(line.split('%')[0]), reverse=True)
    return '\n'.join(headers + ['', *[re.sub(r'\s+-\s+-\s*$', '', line) for line in symbols[:20]]]) or value


def profile_costs(profile):
    """Disjoint flat symbol buckets; inline RC and memcpy callers need annotation."""
    costs = dict(increments=0.0, decrements=0.0, destruction=0.0,
                 cow_detaches=0.0, explicit_deep_copy=0.0, recording=0.0)
    for overhead, symbol in re.findall(r'^\s+(\d+\.\d+)%  \[.\] (\S+)', profile, re.M):
        category = None
        if 'hirsel_rt_v2_dup' in symbol or 'hirsel_rt_v2_root_dup' in symbol:
            category = 'increments'
        elif 'drop_last' in symbol:
            category = 'destruction'
        elif 'release_block' in symbol or 'hirsel_rt_v2_release' in symbol or 'hirsel_rt_v2_root_release' in symbol:
            category = 'decrements'
        elif 'detach_sized' in symbol or 'hirsel_rt_v2_detach' in symbol:
            category = 'cow_detaches'
        elif any(name in symbol for name in ('copy_graph', 'clone_block', 'copy_held', 'hirsel_rt_v2_unique_copy')):
            category = 'explicit_deep_copy'
        elif any(name in symbol for name in ('Journaled', 'TapeJournal', 'RecordingWriter', 'render_tape', 'render_recording', 'journal', 'hirsel_run_schema3hex', 'launch3hex')):
            category = 'recording'
        if category:
            costs[category] += float(overhead)
    return costs


def report(document, path):
    rows = document['samples']
    text = ['# Tasks benchmark results', '', 'Generated by `bench/apps/tasks/bench`; raw samples: [results.json](results.json).', '',
        'Implementation, recording-off findings, attribution limits and remaining triggers: [PERFORMANCE.md](PERFORMANCE.md).', '',
        f"Session: {document['session']}; git {document['git']}; seed {document['seed']}; {document['rounds']} rounds.",
        f"Offered rates {document['rates']} req/s, {document['seconds']} s per cell. Each participant stops its sweep at the first capacity knee; every measured cell has ten fresh processes. 10,000 tasks except empty cold start.",
        'Server CPU31; client CPU7; SMT sibling CPU15 busy counters retained for each sample. Rust current_thread and multi_thread/one worker have core parity.', '',
        'Instruction ratios are the verdict. Ratios below are Hirsel / Rust one-worker with paired bootstrap 95% CIs. All timing ratios belong to this session.', '']
    if document.get('source_notes'):
        text += [document['source_notes'], '']
    if set(r['operation'] for r in rows) != {'cold', 'restart', 'list', 'search', 'create', 'update', 'sse'}:
        text += ['**Partial workload selection: omitted operations have no result or verdict.**', '']
    if any(sum((r['operation'], r['rate'], r['kind']) == cell for r in rows) != document['rounds'] for cell in set((r['operation'], r['rate'], r['kind']) for r in rows)):
        text += ['**Session still incomplete: some measured cells have fewer than the required ten rounds.**', '']
    if document.get('errors'):
        text += ['**One or more cells unavailable: failures are listed below. No overall parity verdict. Completed ten-round cells remain reported.**', '']
    text += ['| Operation / offered rate | Participant | Completed req/s | p50 / p99 / p99.9 / max (ms) | CPU s/request | Instructions/request | Idle / load RSS (MiB) | CPU15 busy |',
             '|---|---|---:|---|---:|---:|---|---:|']
    cells = sorted(set((r['operation'], r['rate']) for r in rows))
    for op, rate in cells:
        for kind in KINDS:
            group = [r for r in rows if (r['operation'], r['rate'], r['kind']) == (op, rate, kind)]
            if not group:
                if any(e['cell'].endswith(f'-{kind}-{op}-{rate}') for e in document.get('errors', [])):
                    text += [f'| {op} / {rate} | {kind} | unavailable | capped process failed; see evidence below | — | — | — | — |']
                continue
            med = lambda name: statistics.median(r[name] for r in group)
            if op in ('cold', 'restart'):
                latency = f"first response {med('first_ms'):.3f} ms"
            else:
                latency = ' / '.join(f'{med(k) / 1000:.3f}' for k in ['p50_us', 'p99_us', 'p999_us', 'max_us'])
            text += [f"| {op} / {rate} | {kind} (n={len(group)}) | {med('requests_per_s') if 'requests_per_s' in group[0] else 0:.2f} | {latency} | {med('cpu_s_per_request'):.6f} | {med('instructions_per_request'):.0f} | {med('idle_rss') / 2**20:.1f} / {med('load_rss') / 2**20 if 'load_rss' in group[0] else med('idle_rss') / 2**20:.1f} | {med('sibling_busy_share'):.1%} |"]
    text += ['', '| Operation / rate | Instructions ratio | User instructions ratio | Cycles ratio | task-clock ratio | Hirsel / Rust IPC; IPC ratio CI |', '|---|---|---|---|---|---|']
    for op, rate in cells:
        a = {r['round']: r for r in rows if (r['operation'], r['rate'], r['kind']) == (op, rate, 'hirsel')}
        b = {r['round']: r for r in rows if (r['operation'], r['rate'], r['kind']) == (op, rate, 'rust-one-worker')}
        keys = sorted(a.keys() & b.keys())
        if not keys:
            continue
        ratios = []
        for metric in ['instructions', 'instructions:u', 'cycles', 'task-clock']:
            left = [per_request(a[n], metric) for n in keys]
            right = [per_request(b[n], metric) for n in keys]
            low, high = bootstrap_ratio(left, right, document['seed'], draws=2000)
            ratios.append(f'{ratio(left, right):.3f} [{low:.3f}, {high:.3f}]')
        ipc_a = statistics.median(a[n]['perf']['instructions'] / a[n]['perf']['cycles'] for n in keys)
        ipc_b = statistics.median(b[n]['perf']['instructions'] / b[n]['perf']['cycles'] for n in keys)
        ipc_left = [a[n]['perf']['instructions'] / a[n]['perf']['cycles'] for n in keys]
        ipc_right = [b[n]['perf']['instructions'] / b[n]['perf']['cycles'] for n in keys]
        ipc_low, ipc_high = bootstrap_ratio(ipc_left, ipc_right, document['seed'], draws=2000)
        text += [f"| {op} / {rate} | {' | '.join(ratios)} | {ipc_a:.3f} / {ipc_b:.3f}; {ratio(ipc_left, ipc_right):.3f} [{ipc_low:.3f}, {ipc_high:.3f}] |"]
    if 'hirsel-before' in document.get('binaries', {}):
        text += ['', 'Candidate / before (same session, paired rounds):', '',
                 '| Operation / rate | Instructions ratio [95% CI] | Completed req/s ratio | Idle RSS ratio | Load RSS ratio |',
                 '|---|---:|---:|---:|---:|---:|']
        for op, rate in cells:
            groups = [{r['round']: r for r in rows if (r['operation'], r['rate'], r['kind']) == (op, rate, kind)}
                      for kind in ('hirsel', 'hirsel-before')]
            keys = sorted(groups[0].keys() & groups[1].keys())
            if not keys:
                continue
            left, right = [[group[n]['instructions_per_request'] for n in keys] for group in groups]
            low, high = bootstrap_ratio(left, right, document['seed'], draws=2000)
            values = []
            for metric in ('requests_per_s', 'idle_rss', 'load_rss'):
                values.append(f"{ratio([groups[0][n][metric] for n in keys], [groups[1][n][metric] for n in keys]):.3f}"
                              if metric in groups[0][keys[0]] and metric in groups[1][keys[0]] else '—')
            text += [f'| {op}/{rate} | {ratio(left, right):.3f} [{low:.3f}, {high:.3f}] | ' + ' | '.join(values) + ' |']
    text += ['', 'Recording overhead (recorded / plain, per-request medians):', '', '| Operation / rate | Instructions | Cycles | Idle RSS |', '|---|---:|---:|---:|']
    for op, rate in cells:
        groups = [[r for r in rows if (r['operation'], r['rate'], r['kind']) == (op, rate, kind)]
                  for kind in ('hirsel-recorded', 'hirsel')]
        if all(groups):
            ratios = [statistics.median(per_request(r, metric) for r in groups[0]) /
                      statistics.median(per_request(r, metric) for r in groups[1])
                      for metric in ('instructions', 'cycles')]
            memory = statistics.median(r['idle_rss'] for r in groups[0]) / statistics.median(r['idle_rss'] for r in groups[1])
            text += [f'| {op}/{rate} | {ratios[0]:.3f} | {ratios[1]:.3f} | {memory:.3f} |']
    text += ['', 'Cold start is process-cold with an empty revision-1 snapshot and warm host page cache; restart uses a 10k-task snapshot. The launch marker excludes perf startup but includes its own final marker write and exec.', '', 'Binary bytes: ' + ', '.join(f"{kind} {next((r['binary_bytes'] for r in rows if r['kind'] == kind), 'unavailable')}" for kind in KINDS) + '.', '',
             'Rust baseline noise (one-worker instructions/request; median absolute deviation / median and range):']
    for op, rate in cells:
        values = [r['instructions_per_request'] for r in rows if (r['operation'], r['rate'], r['kind']) == (op, rate, 'rust-one-worker')]
        if values:
            median = statistics.median(values)
            mad = statistics.median(abs(v - median) for v in values) / median
            cpu_values = [r['cpu_s_per_request'] for r in rows if (r['operation'], r['rate'], r['kind']) == (op, rate, 'rust-one-worker')]
            cpu_median = statistics.median(cpu_values)
            cpu_mad = statistics.median(abs(v - cpu_median) for v in cpu_values) / cpu_median
            text += [f'- {op}/{rate}: instruction MAD {mad:.2%}, range {min(values):.0f}–{max(values):.0f}; CPU/request MAD {cpu_mad:.2%}.']
    text += ['', 'Capacity knee (first achieved rate below 90% of offered rate):']
    for kind in KINDS:
        for op in ['list', 'search', 'create', 'update']:
            cells_for_op = sorted(set(r['rate'] for r in rows if r['kind'] == kind and r['operation'] == op))
            knee = next((rate for rate in cells_for_op if statistics.median(r['requests_per_s'] for r in rows if (r['kind'], r['operation'], r['rate']) == (kind, op, rate)) < .9 * rate), None)
            text += [f'- {kind}/{op}: {knee if knee else "not reached in measured sweep"}.']
    text += ['', 'Metrics above 1.2× Rust one-worker (empirical paired-session medians):', '',
             '| Trigger | Metric | Hirsel / Rust | Cause and classification |', '|---|---|---:|---|']
    annotations = document.get('attribution', {})
    gaps = 0
    metrics = ['instructions_per_request', 'cycles_per_request', 'cpu_s_per_request', 'first_ms', 'idle_rss', 'load_rss',
               'binary_bytes', 'p50_us', 'p99_us', 'p999_us', 'max_us']
    for op, rate in cells:
        left = [r for r in rows if (r['operation'], r['rate'], r['kind']) == (op, rate, 'hirsel')]
        right = [r for r in rows if (r['operation'], r['rate'], r['kind']) == (op, rate, 'rust-one-worker')]
        if not left or not right:
            continue
        for metric in metrics:
            if metric != 'cycles_per_request' and (metric not in left[0] or metric not in right[0]):
                continue
            if metric == 'first_ms' and op not in ('cold', 'restart'):
                continue
            def metric_value(row):
                if metric == 'cycles_per_request':
                    count = 1 if op in ('cold', 'restart', 'sse') else row['completed']
                    return row['perf']['cycles'] / count
                return row[metric]
            value = statistics.median(metric_value(r) for r in left) / statistics.median(metric_value(r) for r in right)
            if value <= 1.2:
                continue
            gaps += 1
            category = 'cold' if op == 'cold' else 'heap' if metric in ('idle_rss', 'load_rss') else op
            cause = f'[{category}](#cause-{category})' if category in annotations else 'Attribution open: profile evidence requires review before claiming a cause.'
            text += [f'| {op}/{rate} | {metric} | {value:.3f} | {cause} |']
    if not gaps:
        text += ['No >1.2× metric in the measured cells.']
    text += ['']
    for category, explanation in annotations.items():
        text += [f'<a id="cause-{category}"></a>', f'**{category}**: {explanation}', '']
    text += ['', 'Minimal triggers use the fixture generated by `fixture(data, 10000)` and routes shown in each attribution. CPU profiles contain limited samples for short operations and incomplete unwinds across native fiber switches; flat symbol attribution is stronger than their full call chains. Causes identify measured mechanisms, not a percentage decomposition of every gap.', '', 'CPU and latency evidence comes from separate `perf record` runs; heap evidence is a separate heaptrack run over the same 10k seed and a full list render plus 100 SSE subscriptions. Neither profiling run contributes timing comparisons.',
             'Low offered-rate cells have few requests: histogram tail values are empirical order statistics, not a claim of a production tail-latency bound. CPU15 busy samples are retained; time/cycle conclusions require an idle-sibling rerun when interference is present.', '']
    text += ['Profile attribution (flat self samples, percent of the profile event):', '',
             '| Profile | RC increment slow paths | RC decrement/dispatch | Destruction | COW detach entries | Explicit deep copy | Recording symbols |',
             '|---|---:|---:|---:|---:|---:|---:|']
    for key, value in document.get('profiles', {}).items():
        if not key.endswith('/heap'):
            costs = profile_costs(value)
            text += ['| ' + key + ' | ' + ' | '.join(f'{v:.2f}%' for v in costs.values()) + ' |']
    text += ['', 'Operation profiles sample user cycles; startup profiles sample user instructions. These disjoint symbol buckets are lower bounds: ordinary RC increments/decrements are also emitted inline in application/stdlib symbols; release dispatch includes checks, and destruction is shown separately. Explicit unique graph copies are separate from COW detach entries. Sequence growth mixes capacity changes with COW and is not charged entirely to COW. memcpy without a complete caller chain is unattributed. A zero bucket means no samples resolved there, not zero execution cost. Raw profiles retain all symbols and lost-sample counts.', '', 'Profile evidence:', '']
    profiles = document.get('profiles', {})
    for key, value in profiles.items():
        text += [f'`{key}` (excerpt; full profile in results.json):', '', '```text', profile_excerpt(key, value), '```', '']
    if not profiles:
        text += ['No profile captured. Cause attribution remains open; no cause is inferred from elapsed time alone.', '']
    for error in document.get('errors', []):
        text += [f"- Failed {error['cell']}: {error['error']}" + (f" Server evidence: `{error['server_log']}`" if 'server_log' in error else '')]
    path.write_text('\n'.join(text).rstrip() + '\n')


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--kinds', default=','.join(KINDS), help='comma-separated participants')
    parser.add_argument('--rounds', type=int, default=10)
    parser.add_argument('--seconds', type=float, default=3)
    parser.add_argument('--rates', default='1,4,16,64,256,1024')
    parser.add_argument('--seed', type=int, default=20261020)
    parser.add_argument('--binary', type=Path, default=APP / 'build/tasks-hirsel')
    parser.add_argument('--baseline-binary', type=Path, help='add hirsel-before to the same seeded interleaved session')
    parser.add_argument('--skip-build', action='store_true')
    parser.add_argument('--samples-only', action='store_true', help='finish after comparison samples, without diagnostic profiles')
    parser.add_argument('--report-only', action='store_true', help='regenerate Markdown from saved raw samples')
    parser.add_argument('--startup-profiles-only', action='store_true', help='record startup user instructions without a nested counter profiler')
    parser.add_argument('--heap-only', action='store_true', help='append non-timing heap evidence to a saved session')
    parser.add_argument('--only', default='cold,restart,list,search,create,update,sse')
    args = parser.parse_args()
    selected = args.kinds.split(',')
    if args.baseline_binary:
        KINDS.append('hirsel-before')
        selected.append('hirsel-before')
    if set(selected) - set(KINDS):
        parser.error('unknown participant')
    KINDS[:] = selected
    os.sched_setaffinity(0, {7})
    if args.report_only or args.heap_only or args.startup_profiles_only:
        document = json.loads((APP / 'results.json').read_text())
        for error in document.get('errors', []):
            log = APP / 'build' / document['session'].replace(':', '') / error['cell'] / 'server.log'
            if log.exists():
                error['server_log'] = log.read_text().strip()
        if args.startup_profiles_only:
            with timing_lock(31):
                document = json.loads((APP / 'results.json').read_text())
                archive = APP / 'build' / (document['session'].replace(':', '') + '-startup')
                archive.mkdir(exist_ok=True)
                for op in ('cold', 'restart'):
                    for kind in KINDS:
                        document['profiles'][f'{kind}/{op}'] = startup_profile(kind, op, args, archive / f'{kind}-{op}')
                profile = sample('rust', 'sse', 1000, args, archive / 'rust-sse', -1, profile=True)
                document['profiles']['rust/sse'] = profile['profile']
            (APP / 'results.json').write_text(json.dumps(document, indent=2) + '\n')
        if args.heap_only:
            with timing_lock(31):
                document = json.loads((APP / 'results.json').read_text())
                for error in document.get('errors', []):
                    log = APP / 'build' / document['session'].replace(':', '') / error['cell'] / 'server.log'
                    if log.exists():
                        error['server_log'] = log.read_text().strip()
                archive = APP / 'build' / (document['session'].replace(':', '') + '-heap')
                archive.mkdir(exist_ok=True)
                for kind in KINDS:
                    if f'{kind}/heap' not in document['profiles']:
                        document['profiles'][f'{kind}/heap'] = memory_profile(kind, args, archive / kind)
            (APP / 'results.json').write_text(json.dumps(document, indent=2) + '\n')
        notes = json.loads((APP / 'attribution.json').read_text())
        document['attribution'] = notes['notes'] if notes['binaries'] == document['binaries'] else {}
        (APP / 'results.json').write_text(json.dumps(document, indent=2) + '\n')
        report(document, APP / ('RESULTS-' + document['session'].replace(':', '') + '.md'))
        return 0
    if args.rounds < 10:
        parser.error('measurement protocol requires at least 10 rounds')
    if args.seconds <= 0:
        parser.error('--seconds must be positive')
    args.rates = [int(s) for s in args.rates.split(',')]
    if not args.rates or min(args.rates) < 1:
        parser.error('rates must be positive integers')
    invalid = set(args.only.split(',')) - {'cold', 'restart', 'list', 'search', 'create', 'update', 'sse'}
    if invalid:
        parser.error(f'unknown operations: {invalid}')
    args.binary.parent.mkdir(parents=True, exist_ok=True)
    if not args.skip_build:
        build(args.binary)
    lock = timing_lock(31)
    session = time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime())
    document = dict(session=session, git=subprocess.check_output(['git', 'rev-parse', 'HEAD'], text=True).strip(),
                    rounds=args.rounds, seconds=args.seconds, rates=args.rates, seed=args.seed, samples=[], errors=[], profiles={})
    document['client_sha256'] = hashlib.sha256((APP / 'rust/target/release/load').read_bytes()).hexdigest()
    document['rustc'] = subprocess.check_output(['rustc', '--version'], text=True).strip()
    document['perf_version'] = subprocess.check_output(['perf', '--version'], text=True).strip()
    document['binaries'] = {k: hashlib.sha256(binary_for(k, args).read_bytes()).hexdigest() for k in KINDS}
    operations = args.only.split(',')
    archive = APP / 'build' / session.replace(':', '')
    archive.mkdir(parents=True)
    failed = set()
    ceilings = {}
    def interleaved_cells():
        for round_number in range(args.rounds):
            for _, op in schedule(operations, 1, args.seed + round_number):
                rates = [0] if op in ('cold', 'restart') else [1, 100, 1000] if op == 'sse' else sorted(args.rates)
                for rate in rates:
                    for _, kind in schedule(KINDS, 1, args.seed + round_number * 10007 + rate):
                        if rate <= ceilings.get((kind, op), rate):
                            yield round_number, (kind, op, rate)
    for round_number, (kind, op, rate) in interleaved_cells():
        if (kind, op, rate) in failed:
            continue
        cell = f'{round_number}-{kind}-{op}-{rate}'
        print(cell, flush=True)
        try:
            result = sample(kind, op, rate, args, archive / cell, round_number)
            document['samples'].append(result)
            if round_number == 0 and op in ('list', 'search', 'create', 'update') and result['requests_per_s'] < .9 * rate:
                ceilings[(kind, op)] = rate
        except Exception as error:
            document['errors'].append(dict(cell=cell, error=str(error)))
            failed.add((kind, op, rate))
            # A refused overload also bounds the sweep; never send a still-higher rate.
            if round_number == 0 and op in ('list', 'search', 'create', 'update'):
                ceilings[(kind, op)] = rate
            server_log = archive / cell / 'server.log'
            if server_log.exists():
                document['errors'][-1]['server_log'] = server_log.read_text().strip()
            print(f'FAILED: {error}', flush=True)
        (APP / 'results.json').write_text(json.dumps(document, indent=2) + '\n')
    if args.samples_only:
        report(document, APP / ('RESULTS-' + document['session'].replace(':', '') + '.md'))
        lock.close()
        return 1 if document['errors'] else 0
    for op in operations:
        rate = 0 if op in ('cold', 'restart') else 100 if op == 'sse' else min(16, max(args.rates))
        for kind in KINDS:
            try:
                if op in ('cold', 'restart'):
                    document['profiles'][f'{kind}/{op}'] = startup_profile(kind, op, args, archive / f'profile-{kind}-{op}')
                else:
                    profile_rate = 1000 if op == 'sse' and kind == 'rust' else rate
                    profile = sample(kind, op, profile_rate, args, archive / f'profile-{kind}-{op}', -1, profile=True)
                    document['profiles'][f'{kind}/{op}'] = profile['profile']
            except Exception as error:
                document['errors'].append(dict(cell=f'profile-{kind}-{op}', error=str(error)))
    (APP / 'results.json').write_text(json.dumps(document, indent=2) + '\n')
    report(document, APP / ('RESULTS-' + document['session'].replace(':', '') + '.md'))
    for kind in KINDS:
        try:
            document['profiles'][f'{kind}/heap'] = memory_profile(kind, args, archive / f'heap-{kind}')
        except Exception as error:
            document['errors'].append(dict(cell=f'heap-{kind}', error=str(error)))
    (APP / 'results.json').write_text(json.dumps(document, indent=2) + '\n')
    notes = json.loads((APP / 'attribution.json').read_text())
    document['attribution'] = notes['notes'] if notes['binaries'] == document['binaries'] else {}
    (APP / 'results.json').write_text(json.dumps(document, indent=2) + '\n')
    report(document, APP / ('RESULTS-' + document['session'].replace(':', '') + '.md'))
    lock.close()
    return 1 if document['errors'] else 0


if __name__ == '__main__':
    raise SystemExit(main())
