#!/usr/bin/env python3
"""Compare two tasks binaries and Rust using the tasks-rust lane's frozen workload."""
import argparse
import hashlib
import importlib.machinery
import importlib.util
import json
from pathlib import Path
from types import SimpleNamespace
import statistics
import sys

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('--harness', type=Path, required=True, help='bench/apps/tasks directory')
parser.add_argument('--before', type=Path, required=True)
parser.add_argument('--after', type=Path, required=True)
parser.add_argument('--output', type=Path, required=True)
parser.add_argument('--seed', type=int, default=20261020)
parser.add_argument('--operations', default='cold,restart,search,create,update', help='comma-separated workload cells')
args = parser.parse_args()
operations = args.operations.split(',')
if not operations or set(operations) - {'cold','restart','list','search','create','update','sse'}:
    parser.error('unknown operations')
sys.path.insert(0, str(args.harness.resolve()))
loader = importlib.machinery.SourceFileLoader('tasks_bench', str(args.harness / 'bench'))
spec = importlib.util.spec_from_loader(loader.name, loader)
bench = importlib.util.module_from_spec(spec)
loader.exec_module(bench)
args.output.mkdir(parents=True, exist_ok=True)
participants = {'before': args.before.resolve(), 'after': args.after.resolve(), 'rust': bench.RUST}
document = dict(seed=args.seed, rounds=10, seconds=1, server_cpu=31, client_cpu=7,
                binaries={k:dict(path=str(v), sha256=hashlib.sha256(v.read_bytes()).hexdigest())
                          for k,v in participants.items()}, samples=[], ratios=[])
try:
    with bench.timing_lock(31):
        for r in range(10):
            for _, operation in bench.schedule(operations, 1, args.seed + r):
                for _, name in bench.schedule(list(participants), 1, args.seed + r * 10007):
                    sample = bench.sample('rust' if name == 'rust' else 'hirsel', operation,
                        0 if operation in ('cold','restart') else 1,
                        SimpleNamespace(binary=participants[name], seconds=1),
                        args.output / f'{r}-{name}-{operation}', r)
                    sample['participant'] = name
                    document['samples'].append(sample)
                    (args.output / 'samples.json').write_text(json.dumps(document, indent=2)+'\n')
                    print(r, name, operation, round(sample['instructions_per_request']), flush=True)
    for operation in operations:
        counts = {name:[s['instructions_per_request'] for s in document['samples']
                        if s['operation']==operation and s['participant']==name]
                  for name in participants}
        row = dict(operation=operation, medians={k:statistics.median(v) for k,v in counts.items()})
        for name in ['before','after']:
            row[name+'_rust_ratio'] = bench.ratio(counts[name], counts['rust'])
            row[name+'_rust_ci'] = bench.bootstrap_ratio(counts[name], counts['rust'], args.seed)
        row['after_before_ratio'] = bench.ratio(counts['after'], counts['before'])
        row['user_medians'] = {name:statistics.median(s['perf']['instructions:u'] / s.get('completed', 1)
            for s in document['samples'] if s['operation'] == operation and s['participant'] == name)
            for name in participants}
        for name in ['before', 'after']:
            row[name + '_rust_user_ratio'] = row['user_medians'][name] / row['user_medians']['rust']
        document['ratios'].append(row)
    document['status']='passed'
except BaseException as error:
    document['status']='failed'
    document['error']=str(error)
    raise
finally:
    (args.output / 'samples.json').write_text(json.dumps(document, indent=2)+'\n')
