// rule: MEM-13
// expect: run
// stdout: 7
// stdout: 3
// A Packed constructor's field may be any expression, a called closure
// included, whether the Packed value is a local or a sequence element.
type Outer = Leaf(id: u8) | Node(n: u64, k: u16) | Empty

pub fn main(rt: Io, args: Args) -> Result[(), GrantError] {
  let out = io.stdout(rt)?
  let x: Packed[Outer] = Node(
    n: 5u64,
    k: fn() {
      7u16
    }()
  )
  let _ = out.print(out, u16.to_string(x.Node.k))
  let _ = out.print(out, "\n")
  let xs: List[Packed[Outer]] = [
    Leaf(id: 1u8),
    Node(
      n: fn() {
        3u64
      }(),
      k: 2u16
    )
  ]
  let mut k = 0u64
  for y in xs {
    if k == 1u64 {
      let _ = out.print(out, u64.to_string(y.Node.n))
      let _ = out.print(out, "\n")
    }
    k = k + 1u64
  }
  Ok(())
}
