// rule: MEM-4
// expect: run
// stdout: ok
// "arena.with ... opens a named arena, freed at scope end".
fn output_error[E](take e: E) -> () {}

pub fn main(rt: Io, args: Args) -> Result[(), ()] {
  let n: u64 = arena.with(
    fn(a: Arena) -> u64 {
      let text: String in a = "arena"
      string.byte_len(text)
    }
  )
  out.print(
    io.stdout(rt) ? grant_error,
    if n == 5 {
      "ok\n"
    } else {
      "bad\n"
    }
  ) ? output_error
  Ok(())
}

@noalloc
fn grant_error(refusal: GrantError) -> () uses {} {
  ()
}
