// rule: MEM-14
// expect: run
// stdout: ok
// Spec example "slots.insert" then "slots.get".
fn output_error[E](take e: E) -> () {}

pub fn main(rt: Io, args: Args) -> Result[(), ()] {
  let mut s: Slots[u64] = slots.empty()
  let first: u64 = 10
  let id = slots.insert(mut s, take first)
  let n = slots.get(s, id)
  out.print(
    io.stdout(rt) ? grant_error,
    if n == Some(10) {
      "ok\n"
    } else {
      "bad\n"
    }
  ) ? output_error
  Ok(())
}

@noalloc
fn grant_error(refusal: GrantError) -> () uses {} {
  ()
}
