// rule: MEM-11
// expect: run
// stdout: ok
// "returns the value with ordinary counts restored when s is the last root".
fn output_error[E](take e: E) -> () {}

pub fn main(rt: Io, args: Args) -> Result[(), ()] {
  let built: String = "value"
  let s: Shared[String] = shared.freeze(take built)
  let value = match shared.thaw(take s) {
    Ok(text) => text == "value",
    Error(root) => false,
  }
  out.print(
    io.stdout(rt) ? grant_error,
    if value {
      "ok\n"
    } else {
      "bad\n"
    }
  ) ? output_error
  Ok(())
}

@noalloc
fn grant_error(refusal: GrantError) -> () uses {} {
  ()
}
