// rule: MEM-14
// expect: run
@advance_only(it)
fn stop(mut it: Iter[u64]) {
  let _ = iter.next(mut it)
  failure.check(true, Bounds())
}

fn next(mut state: u64) -> Option[u64] {
  Some(state)
}

pub fn main(rt: Io, args: Args) -> Result[(), ()] {
  let mut it = iter.from(0u64, next)
  stop(mut it)
  Ok(())
}
