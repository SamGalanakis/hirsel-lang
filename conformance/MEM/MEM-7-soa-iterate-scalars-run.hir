// rule: MEM-7
// expect: run
@soa
type Row {
  small: u8,
  x: u64,
  wide: u128,
  flag: bool,
}

fn row(n: u64) -> Row {
  Row(small: 7, x: n, wide: 123456789u128, flag: true)
}

fn check(t: Test, r: Row, n: u64) -> () {
  test.check(t, r.small == 7)
  test.check(t, r.x == n)
  test.check(t, r.flag)
  test.check(t, r.wide == 123456789u128)
}

pub fn main(t: Test) -> Result[(), ()] {
  let rows: List[Row] = [row(1), row(2), row(3)]
  let mut total: u64 = 0
  for r in rows {
    total += r.x
  }
  test.check(t, total == 6)
  let shared = copy rows
  let mut seen: u64 = 0
  for r in take shared {
    check(t, r, seen + 1)
    seen += 1
    if seen == 2 {
      break
    }
  }
  test.check(t, seen == 2)
  check(t, rows[2], 3)
  let fresh: List[Row] = [row(4), row(5), row(6)]
  for r in take fresh {
    check(t, r, 4)
    break
  }
  Ok(())
}
