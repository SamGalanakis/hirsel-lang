// rule: MEM-5
// expect: accept
@noalloc
fn serializable_value[T: serializable](value: T) {}

@noalloc
fn example(text: String) {
  std@1/duration.from_parts(0, 0)
  std@1/duration.parse(text)
  std@1/time.parse(text)
  serializable_value(std@1/duration.from_parts(0, 0))
  serializable_value(std@1/time.Timestamp(unix_nanoseconds: 0))
  ()
}
