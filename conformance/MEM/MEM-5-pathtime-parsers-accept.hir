// rule: MEM-5
// expect: accept
@noalloc
fn serializable_value[T: serializable](value: T) {}

@noalloc
fn example(text: String) {
  duration.from_parts(0, 0)
  duration.parse(text)
  time.parse(text)
  serializable_value(duration.from_parts(0, 0))
  serializable_value(time.Timestamp(unix_nanoseconds: 0))
  ()
}
