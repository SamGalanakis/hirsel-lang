// rule: MEM-12
// expect: run
// stdout: ok
flat type Item {
  text: String,
  n: u64,
}

fn number(x: Item) -> u64 {
  let y = copy x
  y.n + string.byte_len(y.text)
}

fn output_error[E](take e: E) -> () {}

pub fn main(rt: Io, args: Args) -> Result[(), ()] {
  let x = Item(text: "a", n: 1)
  out.print(
    io.stdout(rt) ? grant_error,
    if number(x) == 2 {
      "ok\n"
    } else {
      "bad\n"
    }
  ) ? output_error
  Ok(())
}

@noalloc
fn grant_error(refusal: GrantError) -> () uses {} {
  ()
}
