// rule: MEM-4
// expect: run
fn held(take payload: Bytes) -> fn() -> u64 {
  fn() -> u64 {
    bytes.len(payload)
  }
}

fn fits(cap: u64) -> u64 {
  let outcome = arena.bounded(
    cap,
    fn(a: Arena) -> Region[fn() -> u64] {
      let payload: Bytes in heap = copy_to(heap, b"abc")
      let root = held(take payload)
      arena.seal(take a, take root)
    }
  )
  match take outcome {
    Ok(r) => {
      let mut owned = take r
      region.with(
        mut owned,
        fn(view: fn() -> u64) -> u64 {
          view()
        }
      )
    },
    Error(e) => 0u64,
  }
}

pub fn main(t: Test) -> Result[(), ()] {
  failure.check(fits(10u64) == 0u64, Bounds())
  failure.check(fits(11u64) == 3u64, Bounds())
  Ok(())
}
