// rule: MEM-7
// expect: run
@soa
type Row {
  small: u8,
  x: u64,
  bytes: Bytes,
  children: List[u64],
  flag: bool,
}

fn row(n: u64) -> Row {
  let mut data: List[u8] = [65, 66]
  let bytes = bytes.from_list(take data)
  Row(small: 7, x: n, bytes: take bytes, children: [n], flag: true)
}

fn check(t: Test, r: Row, n: u64) -> () {
  test.check(t, r.small == 7)
  test.check(t, r.x == n)
  test.check(t, r.flag)
  test.check(t, bytes.len(r.bytes) == 2)
  test.check(t, r.bytes[1] == 66)
  test.check(t, r.children[0] == n)
}

fn replace(mut r: Row, n: u64) -> () {
  r = row(n)
}

pub fn main(t: Test) -> Result[(), ()] {
  let mut rows: List[Row] = [row(1), row(2), row(3)]
  let shared = copy rows
  rows[1] = row(8)
  rows[0].x = 9
  check(t, rows[1], 8)
  test.check(t, rows[0].x == 9)
  check(t, shared[0], 1)
  check(t, shared[1], 2)
  let nested = copy rows[2].children
  list.push(mut rows[2].children, 99)
  test.check(t, list.len(nested) == 1)
  test.check(t, list.len(rows[2].children) == 2)
  replace(mut rows[2], 12)
  check(t, rows[2], 12)
  Ok(())
}
