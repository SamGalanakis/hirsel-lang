// rule: MEM-4
// expect: run

fn fits(cap: u64) -> u64 {
  let outcome = arena.bounded(
    cap,
    fn(a: Arena) -> Region[Array[Bytes]] {
      let root: Array[Bytes] in a = [copy_to(heap, b"x"), copy_to(heap, b"abc")]
      arena.seal(take a, take root)
    }
  )
  match take outcome {
    Ok(r) => {
      let mut owned = take r
      region.with(
        mut owned,
        fn(view: Array[Bytes]) -> u64 {
          bytes.len(view[0]) + bytes.len(view[1])
        }
      )
    },
    Error(e) => 0u64,
  }
}

pub fn main(t: Test) -> Result[(), ()] {
  failure.check(fits(19u64) == 0u64, Bounds())
  failure.check(fits(20u64) == 4u64, Bounds())
  Ok(())
}
