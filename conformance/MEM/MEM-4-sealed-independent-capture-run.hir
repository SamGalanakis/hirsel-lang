// rule: MEM-4
// expect: run
fn build() -> fn() -> u64 {
  let mut r = arena.with(
    fn(a: Arena) -> Region[List[u64]] {
      let root: List[u64] in a = [11u64, 12u64]
      arena.seal(take a, take root)
    }
  )
  region.with(
    mut r,
    fn(view: List[u64]) -> fn() -> u64 {
      let independent = copy_to(heap, view)
      fn() -> u64 {
        list.len(independent)
      }
    }
  )
}

pub fn main(t: Test) -> Result[(), ()] {
  let escaped = build()
  failure.check(escaped() == 2u64, Bounds())
  failure.check(escaped() == 2u64, Bounds())
  Ok(())
}
