// rule: MEM-7
// expect: run
@serializable
@soa
type Row {
  small: u8,
  x: u64,
  bytes: Bytes,
  children: List[u64],
  flag: bool,
}

fn row(n: u64) -> Row {
  let mut data: List[u8] = [65, 66]
  let bytes = bytes.from_list(take data)
  Row(small: 7, x: n, bytes: take bytes, children: [n], flag: true)
}

fn check(t: Test, r: Row, n: u64) -> () {
  test.check(t, r.small == 7)
  test.check(t, r.x == n)
  test.check(t, r.flag)
  test.check(t, bytes.len(r.bytes) == 2)
  test.check(t, r.bytes[1] == 66)
  test.check(t, r.children[0] == n)
}

const STORED: List[Row] = [
  Row(small: 7, x: 11, bytes: b"AB", children: [11], flag: true)
]

pub fn main(t: Test) -> Result[(), DecodeError] {
  let empty: List[Row] = []
  test.check(t, list.len(empty) == 0)
  let rows: List[Row] = [row(1), row(2), row(3)]
  check(t, rows[0], 1)
  check(t, rows[2], 3)
  let detached: List[Row] = copy_to(heap, rows)
  check(t, detached[1], 2)
  let mut decoded: List[Row] = codec.decode(codec.encode(rows))?
  check(t, decoded[2], 3)
  list.push(mut decoded, row(4))
  check(t, decoded[3], 4)
  let literal: List[Row] = [
    Row(small: 7, x: 10, bytes: b"AB", children: [10], flag: true)
  ]
  check(t, literal[0], 10)
  let mut from_static = STORED
  check(t, from_static[0], 11)
  list.push(mut from_static, row(12))
  check(t, from_static[1], 12)
  check(t, STORED[0], 11)
  Ok(())
}
