// rule: MEM-3
// expect: fail MEM-3 at line 20
// "Read-only structural operations (==, hash, order) past a fixed recursion
// depth ... exhausting it is Depth". A keyed read hashes its key, so a key past
// the limit fails whatever the map holds (#90).
type Chain = End(value: Option[u64]) | Link(next: box Chain)

fn chain(depth: u64) -> Chain {
  let mut c: Chain = End(value: None)
  for i in 0..depth {
    c = Link(next: box take c)
  }
  take c
}

pub fn main(rt: Io, args: Args) -> Result[(), ()] {
  let mut m: Map[Chain, u64] = map.empty()
  map.insert(mut m, chain(8), 1)
  let deep = chain(544)
  let found = map.get(m, deep)
  Ok(())
}
