// rule: MEM-11
// expect: reject MODE-1 at line 15
// A Shared value is "read by borrowing": dropping the last root frees the whole value,
// so a copy of its content cannot leave the body to be read after the drop.
type Index {
  items: List[u64],
}

fn release(take s: Shared[Index]) -> () {}

fn after(take s: Shared[Index]) -> u64 {
  let kept = shared.with(
    s,
    fn(i: Index) -> List[u64] {
      copy i.items
    }
  )
  release(take s)
  kept[0]
}
