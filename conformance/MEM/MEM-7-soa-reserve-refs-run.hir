// rule: MEM-7
// expect: run
@soa
type Row {
  small: u8,
  x: u64,
  bytes: Bytes,
  children: List[u64],
  flag: bool,
}

fn row(n: u64) -> Row {
  let mut data: List[u8] = [65, 66]
  let bytes = bytes.from_list(take data)
  Row(small: 7, x: n, bytes: take bytes, children: [n], flag: true)
}

fn check(t: Test, r: Row, n: u64) -> () {
  test.check(t, r.small == 7)
  test.check(t, r.x == n)
  test.check(t, r.flag)
  test.check(t, bytes.len(r.bytes) == 2)
  test.check(t, r.bytes[1] == 66)
  test.check(t, r.children[0] == n)
}

pub fn main(t: Test) -> Result[(), ()] {
  let mut rows: List[Row] = []
  list.reserve(mut rows, 1)
  list.push(mut rows, row(1))
  list.reserve(mut rows, 65)
  check(t, rows[0], 1)
  let shared = copy rows
  list.reserve(mut rows, 129)
  check(t, rows[0], 1)
  check(t, shared[0], 1)
  list.reserve(mut rows, 0)
  test.check(t, list.len(rows) == 1)
  Ok(())
}
