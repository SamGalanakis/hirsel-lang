// rule: MEM-14
// expect: run
// stdout: ok
// "removing a slot bumps its generation".
fn output_error[E](take e: E) -> () {}

pub fn main(rt: Io, args: Args) -> Result[(), ()] {
  let mut s: Slots[u64] = slots.empty()
  let first: u64 = 10
  let id = slots.insert(mut s, take first)
  let removed = slots.remove(mut s, id)
  let second: u64 = 20
  let new_id = slots.insert(mut s, take second)
  out.print(
    io.stdout(rt) ? grant_error,
    if slots.get(s, id) == None {
      "ok\n"
    } else {
      "bad\n"
    }
  ) ? output_error
  Ok(())
}

@noalloc
fn grant_error(refusal: GrantError) -> () uses {} {
  ()
}
