// rule: MEM-5
// expect: run
type Identity[T] = T

resource type Token {
  n: u64,
}
@noalloc drop(x) {
  ()
}

@noalloc
fn relay[R: noalloc_drop](read: @noalloc fn() -> Identity[R] uses {}, divisor: u64) -> Identity[
  R
] uses {} {
  let output = read()
  let _ = 1u64 / divisor
  take output
}

@noalloc
fn one() -> Identity[Token] uses {} {
  Token(n: 7)
}

pub fn main() -> Result[(), u64] {
  let value = relay(one, 1u64)
  let n = value.n
  if n != 7u64 {
    return Error(1)
  }
  Ok(())
}
