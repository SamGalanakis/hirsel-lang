// rule: MEM-7
// expect: run
@soa
type Row {
  small: u8,
  x: u64,
  wide: u128,
  flag: bool,
}

fn row(n: u64) -> Row {
  Row(small: 7, x: n, wide: 123456789u128, flag: true)
}

fn check(t: Test, r: Row, n: u64) -> () {
  test.check(t, r.small == 7)
  test.check(t, r.x == n)
  test.check(t, r.flag)
  test.check(t, r.wide == 123456789u128)
}

fn replace(mut r: Row, n: u64) -> () {
  r = row(n)
}

pub fn main(t: Test) -> Result[(), ()] {
  let mut rows: List[Row] = [row(1), row(2), row(3)]
  let shared = copy rows
  rows[1] = row(8)
  rows[0].x = 9
  check(t, rows[1], 8)
  test.check(t, rows[0].x == 9)
  check(t, shared[0], 1)
  check(t, shared[1], 2)
  replace(mut rows[2], 12)
  check(t, rows[2], 12)
  Ok(())
}
