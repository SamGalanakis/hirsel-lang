// rule: MEM-11
// expect: reject MODE-1 at line 14
// twin: MEM/MEM-11-with-escape-ok.hir
// A Shared value is "read by borrowing": a copy of borrowed frozen content stays local
// to the view, so it cannot be the body's global result.
type Index {
  items: List[u64],
}

fn items(s: Shared[Index]) -> List[u64] {
  shared.with(
    s,
    fn(i: Index) -> List[u64] {
      copy i.items
    }
  )
}
