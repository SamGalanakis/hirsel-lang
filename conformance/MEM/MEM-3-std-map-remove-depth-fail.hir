// rule: MEM-3
// expect: fail MEM-3 at line 17
// Even empty-container removal hashes and validates the complete key.
type Chain = End(value: Option[u64]) | Link(next: box Chain)

fn chain(depth: u64) -> Chain {
  let mut c: Chain = End(value: None)
  for _ in 0u64..depth {
    c = Link(next: box take c)
  }
  take c
}

pub fn main(rt: Io, args: Args) -> Result[(), ()] {
  let mut container: unique Map[Chain, u64] = map.empty()
  let deep = chain(544)
  let found = map.remove(mut container, deep)
  Ok(())
}
