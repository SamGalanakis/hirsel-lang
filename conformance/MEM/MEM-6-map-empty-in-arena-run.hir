// rule: MEM-6
// expect: run
// stdout: 64 out of space
// stdout: 2400 fits
// stdout: 2399 out of space
// stdout: 80 fits
// stdout: 79 out of space
// stdout: 48 fits
// stdout: 47 out of space
// stdout: heap fits
// "A Map or Set map.empty() or set.empty() places in a bounded arena is charged as it grows."
// The Map is placed by its binding's relation (PROV-4), so 150 inserts of 16 bytes each
// exhaust 64 bytes and fill 2400 exactly. A Set charges each new member. A remove charges
// nothing and frees nothing, so two inserts, a remove and a third insert charge 48.
fn grow(cap: u64) -> Result[u64, OutOfSpace] {
  arena.bounded(
    cap,
    fn(a: Arena) -> u64 {
      let mut m: Map[u64, u64] in a = map.empty()
      for i in 0u64..150u64 {
        map.insert(mut m, i, i)
      }
      map.len(m)
    }
  )
}

fn members(cap: u64) -> Result[u64, OutOfSpace] {
  arena.bounded(
    cap,
    fn(a: Arena) -> u64 {
      let mut s: Set[u64] in a = set.empty()
      for i in 0u64..10u64 {
        set.insert(mut s, i)
        set.insert(mut s, i)
      }
      set.len(s)
    }
  )
}

fn removed(cap: u64) -> Result[u64, OutOfSpace] {
  arena.bounded(
    cap,
    fn(a: Arena) -> u64 {
      let mut m: Map[u64, u64] in a = map.empty()
      map.insert(mut m, 1u64, 1u64)
      map.insert(mut m, 2u64, 2u64)
      let _ = map.remove(mut m, 1u64)
      let _ = map.remove(mut m, 9u64)
      map.insert(mut m, 3u64, 3u64)
      map.len(m)
    }
  )
}

fn heap_map() -> Result[u64, OutOfSpace] {
  let mut m: Map[u64, u64] = map.empty()
  for i in 0u64..150u64 {
    map.insert(mut m, i, i)
  }
  Ok(map.len(m))
}

fn report(
  stdout: Stdout,
  fits: String,
  over: String,
  r: Result[u64, OutOfSpace],
  value: u64
) -> () {
  if r == Ok(value) {
    let _ = out.print(stdout, fits)
  } else if r == Error(OutOfSpace()) {
    let _ = out.print(stdout, over)
  } else {
    let _ = out.print(stdout, "bad\n")
  }
}

pub fn main(rt: Io, args: Args) -> Result[(), ()] {
  let stdout = io.stdout(rt) ? grant_error
  report(stdout, "64 fits\n", "64 out of space\n", grow(64u64), 150u64)
  report(stdout, "2400 fits\n", "2400 out of space\n", grow(2400u64), 150u64)
  report(stdout, "2399 fits\n", "2399 out of space\n", grow(2399u64), 150u64)
  report(stdout, "80 fits\n", "80 out of space\n", members(80u64), 10u64)
  report(stdout, "79 fits\n", "79 out of space\n", members(79u64), 10u64)
  report(stdout, "48 fits\n", "48 out of space\n", removed(48u64), 2u64)
  report(stdout, "47 fits\n", "47 out of space\n", removed(47u64), 2u64)
  report(stdout, "heap fits\n", "heap out of space\n", heap_map(), 150u64)
  Ok(())
}

@noalloc
fn grant_error(refusal: GrantError) -> () uses {} {
  ()
}
