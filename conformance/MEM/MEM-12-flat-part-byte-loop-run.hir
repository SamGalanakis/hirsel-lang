// rule: MEM-12
// expect: run
// A byte of a flat record's Bytes part is indexed in place on a loop element
// of a flat list. The part is a view local to the list, as its List sibling
// is, and the byte is a plain u8.
flat type Message {
  id: u64,
  tags: List[u64],
  payload: Bytes,
}

flat type Messages {
  items: List[Message],
}

fn sum(messages: Messages) -> u64 {
  let mut s: u64 = 0
  for m in messages.items {
    let b = m.payload[0]
    s = s + int.widen(b)
  }
  s
}

pub fn main(t: Test) -> Result[(), ()] {
  let m = Messages(
    items: [
      Message(id: 1, tags: [5, 6], payload: b"ab"),
      Message(id: 2, tags: [], payload: b"c")
    ]
  )
  test.check(t, sum(m) == 97u64 + 99u64)
  Ok(())
}
