// rule: MEM-5
// expect: reject MEM-5 at line 33
// "Consuming it into another call does not remove cleanup obligations on
// earlier failure paths." In the `@noalloc` closure body the `Token` that
// `make()` returns is a temporary until `keep` is entered, and `100 / d` may
// fail before that, destroying it with a finalizer that may allocate.
resource type Token {
  n: u32,
}
drop(x) {
  ()
}

@noalloc
fn make() -> Token {
  Token(n: 1)
}

@noalloc
fn keep(take x: Token, n: u32) -> Token {
  x
}

@noalloc
fn produce(f: @noalloc fn() -> Token uses {}) -> Token {
  f()
}

@noalloc
fn probe(d: u32) -> Token {
  produce(
    fn() {
      keep(make(), 100 / d)
    }
  )
}
