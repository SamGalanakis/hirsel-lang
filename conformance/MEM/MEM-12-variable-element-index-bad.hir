// rule: MEM-12
// expect: reject MEM-12 at line 15
// twin: MEM/MEM-12-variable-element-index-ok.hir
// "A flat list of variable-size elements is sequential" — " it can be walked but not indexed".
flat type Item {
  text: String,
  n: u64,
}

flat type Items {
  items: List[Item],
}

fn first(xs: Items) -> u64 {
  xs.items[0].n
}
