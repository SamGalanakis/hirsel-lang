// rule: MEM-11
// expect: run
// stdout: ok
// "gives s back otherwise"; another live root prevents thaw.
fn output_error[E](take e: E) -> () {}

pub fn main(rt: Io, args: Args) -> Result[(), ()] {
  let built: String = "value"
  let s: Shared[String] = shared.freeze(take built)
  let other = copy s
  let value: bool = match shared.thaw(take s) {
    Ok(text) => false,
    Error(root) => true,
  }
  let last = shared.thaw(take other)
  out.print(
    io.stdout(rt) ? grant_error,
    if value {
      "ok\n"
    } else {
      "bad\n"
    }
  ) ? output_error
  Ok(())
}

@noalloc
fn grant_error(refusal: GrantError) -> () uses {} {
  ()
}
