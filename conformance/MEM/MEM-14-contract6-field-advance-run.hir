// rule: MEM-14
// expect: run
// stdout: some
type State[T] {
  it: Iter[T],
  count: u64,
}

@advance_only(s.it)
fn step[T](mut s: State[T]) -> Option[T] {
  s.count += 1
  iter.next(mut s.it)
}

fn next(mut position: u64) -> Option[u64] {
  if position < 3 {
    let value = position
    position += 1
    Some(value)
  } else {
    None
  }
}

pub fn main(rt: Io, args: Args) -> Result[(), GrantError] {
  let mut s = State(it: iter.from(0u64, next), count: 0)
  match step(mut s) {
    Some(v) => {
      let _ = out.print(io.stdout(rt)?, "some\n")
    },
    None => {},
  }
  Ok(())
}
