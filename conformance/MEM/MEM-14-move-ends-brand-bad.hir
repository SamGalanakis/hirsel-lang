// rule: MEM-14
// expect: reject PROV-1 at line 9
// "moving ... the container ends [identity]"; brands do not rebind to a new owner.
fn read(take original: Slots[u64]) -> Option[u64] {
  let mut s = take original
  let value: u64 = 1
  let id = slots.insert(mut s, take value)
  let moved = take s
  slots.get(moved, id)
}
