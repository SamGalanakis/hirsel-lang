// rule: MEM-6
// expect: run
// stdout: 48 fits
// stdout: 47 out of space
// "The first write to a shared arena List copies it into the same arena as a new
// unshared List, charged by its copied length." The literal charges 16; copying it
// shares it, so the first push charges 8 for its element and 16 for the copy; the
// copy is unshared, so the second push charges only 8.
fn output_error[E](take e: E) -> () {}

fn shared(cap: u64) -> Result[u64, OutOfSpace] {
  arena.bounded(
    cap,
    fn(a: Arena) -> u64 {
      let mut xs: List[u64] in a = [1u64, 2u64]
      let ys = copy xs
      list.push(mut xs, 3u64)
      list.push(mut xs, 4u64)
      list.len(xs) + list.len(ys)
    }
  )
}

pub fn main(rt: Io, args: Args) -> Result[(), ()] {
  let stdout = io.stdout(rt) ? grant_error
  out.print(
    stdout,
    if shared(48u64) == Ok(6u64) {
      "48 fits\n"
    } else {
      "bad\n"
    }
  ) ? output_error
  out.print(
    stdout,
    if shared(47u64) == Error(OutOfSpace()) {
      "47 out of space\n"
    } else {
      "bad\n"
    }
  ) ? output_error
  Ok(())
}

@noalloc
fn grant_error(refusal: GrantError) -> () uses {} {
  ()
}
