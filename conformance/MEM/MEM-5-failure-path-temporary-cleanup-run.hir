// rule: MEM-5
// expect: run
// stdout: ok
// The twin of MEM-5-failure-path-temporary-cleanup-bad. Reading `d` cannot
// fail, so the `Token` goes to `keep` on every path and the `@noalloc`
// closure body never destroys it. The caller, which may allocate, does.
resource type Token {
  n: u32,
}
drop(x) {
  ()
}

@noalloc
fn make() -> Token {
  Token(n: 1)
}

@noalloc
fn keep(take x: Token, n: u32) -> Token {
  x
}

@noalloc
fn produce(f: @noalloc fn() -> Token uses {}) -> Token {
  f()
}

@noalloc
fn probe(d: u32) -> Token {
  produce(
    fn() {
      keep(make(), d)
    }
  )
}

pub fn main(rt: Io, args: Args) -> Result[(), GrantError] {
  let token = probe(4)
  let _ = out.print(
    io.stdout(rt)?,
    if token.n == 1 {
      "ok\n"
    } else {
      "bad\n"
    }
  )
  Ok(())
}
