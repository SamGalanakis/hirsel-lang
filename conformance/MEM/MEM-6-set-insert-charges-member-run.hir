// rule: MEM-6
// expect: run
// stdout: 80 fits
// stdout: 79 out of space
// "Each map.insert or set.insert of a key a Map or Set in it does not hold charges that
// entry's logical size"; "a set.insert of a member the Set holds copies nothing." Ten new
// members charge 8 each and inserting each again charges nothing.
fn members(cap: u64) -> Result[u64, OutOfSpace] {
  let empty: Set[u64] = set.empty()
  arena.bounded(
    cap,
    fn(a: Arena) -> u64 {
      let mut s = copy_to(a, empty)
      for i in 0u64..10u64 {
        set.insert(mut s, i)
        set.insert(mut s, i)
      }
      if set.contains(s, 9u64) {
        1u64
      } else {
        0u64
      }
    }
  )
}

fn report(
  stdout: Stdout,
  fits: String,
  over: String,
  r: Result[u64, OutOfSpace],
  value: u64
) -> () {
  if r == Ok(value) {
    let _ = out.print(stdout, fits)
  } else if r == Error(OutOfSpace()) {
    let _ = out.print(stdout, over)
  } else {
    let _ = out.print(stdout, "bad\n")
  }
}

pub fn main(rt: Io, args: Args) -> Result[(), ()] {
  let stdout = io.stdout(rt) ? grant_error
  report(stdout, "80 fits\n", "80 out of space\n", members(80u64), 1u64)
  report(stdout, "79 fits\n", "79 out of space\n", members(79u64), 1u64)
  Ok(())
}

@noalloc
fn grant_error(refusal: GrantError) -> () uses {} {
  ()
}
