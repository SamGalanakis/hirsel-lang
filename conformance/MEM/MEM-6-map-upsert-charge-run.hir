// rule: MEM-6
// expect: run
// A vacant entry is charged before initialization; a hit consumes no budget.
pub fn main(t: Test) -> Result[(), ()] {
  let over = arena.bounded(
    0u64,
    fn(a: Arena) -> u64 {
      let mut m: unique Map[u64, u64] in a = map.empty()
      std@1/map.upsert(
        mut m,
        1,
        fn() -> unique u64 uses {} {
          failure.check(false, Bounds())
          0
        },
        fn(mut v: unique u64) -> () uses {} {
          v += 1
        }
      )
      0
    }
  )
  failure.check(over == Error(OutOfSpace()), Bounds())
  let fits = arena.bounded(
    16u64,
    fn(a: Arena) -> u64 {
      let mut m: unique Map[u64, u64] in a = map.empty()
      std@1/map.upsert(
        mut m,
        1,
        fn() -> unique u64 uses {} {
          1
        },
        fn(mut v: unique u64) -> () uses {} {
          v += 1
        }
      )
      std@1/map.upsert(
        mut m,
        1,
        fn() -> unique u64 uses {} {
          failure.check(false, Bounds())
          0
        },
        fn(mut v: unique u64) -> () uses {} {
          v += 2
        }
      )
      failure.check(
        std@1/map.update(
          mut m,
          1,
          fn(mut v: unique u64) -> () uses {} {
            v += 4
          }
        ),
        Bounds()
      )
      match map.get(m, 1) {
        Some(v) => v,
        None() => 0,
      }
    }
  )
  failure.check(fits == Ok(7u64), Bounds())
  Ok(())
}
