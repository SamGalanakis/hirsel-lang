// rule: MEM-3
// expect: run
// stdout: ok
// "Read-only structural operations (==, hash, order)" retain structural meaning.
fn output_error[E](take e: E) -> () {}

pub fn main(rt: Io, args: Args) -> Result[(), ()] {
  let a: Array[String] = ["a", "b"]
  let b: Array[String] = ["a", "b"]
  out.print(
    io.stdout(rt) ? grant_error,
    if a == b {
      "ok\n"
    } else {
      "bad\n"
    }
  ) ? output_error
  Ok(())
}

@noalloc
fn grant_error(refusal: GrantError) -> () uses {} {
  ()
}
