// rule: MEM-5
// expect: run
// stdout: ok
// "Region-local frame constructions and explicit arenas do not charge heap
// allocation, but their lifetimes still cannot escape."
// A `@noalloc` closure may build a local list and return a plain element of
// it, exactly as a named `@noalloc` function may. A `u64` owns no block of the
// list, so the list stays in the closure's frame.
@noalloc
fn invoke(f: @noalloc fn() -> u64 uses {}) -> u64 {
  f()
}

@noalloc
fn example() -> u64 {
  invoke(
    fn() {
      let n: List[u64] = [7]
      n[0]
    }
  )
}

pub fn main(rt: Io, args: Args) -> Result[(), GrantError] {
  let _ = out.print(
    io.stdout(rt)?,
    if example() == 7 {
      "ok\n"
    } else {
      "bad\n"
    }
  )
  Ok(())
}
