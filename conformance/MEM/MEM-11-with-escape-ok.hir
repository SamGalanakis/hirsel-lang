// rule: MEM-11
// expect: accept
// A Shared value is "read by borrowing": `unique` builds fresh storage from borrowed
// frozen content, which the body may return.
type Index {
  items: List[u64],
}

fn items(s: Shared[Index]) -> List[u64] {
  shared.with(
    s,
    fn(i: Index) -> List[u64] {
      unique i.items
    }
  )
}
