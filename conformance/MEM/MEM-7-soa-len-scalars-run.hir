// rule: MEM-7
// expect: run
@soa
type Row {
  small: u8,
  x: u64,
  wide: u128,
  flag: bool,
}

fn row(n: u64) -> Row {
  Row(small: 7, x: n, wide: 123456789u128, flag: true)
}

fn check(t: Test, r: Row, n: u64) -> () {
  test.check(t, r.small == 7)
  test.check(t, r.x == n)
  test.check(t, r.flag)
  test.check(t, r.wide == 123456789u128)
}

pub fn main(t: Test) -> Result[(), ()] {
  let mut rows: List[Row] = []
  test.check(t, list.len(rows) == 0)
  list.reserve(mut rows, 19)
  test.check(t, list.len(rows) == 0)
  list.push(mut rows, row(1))
  test.check(t, list.len(rows) == 1)
  let other: List[Row] = [row(2), row(3)]
  test.check(t, list.len(other) == 2)
  Ok(())
}
