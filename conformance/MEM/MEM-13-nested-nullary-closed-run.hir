// rule: MEM-13
// expect: run
// stdout: ok
type Inner = Closed | Canceled(u64)

type Outer[T] = Empty | Full(T)

fn choose(x: Outer[Inner]) -> u64 {
  match x {
    Empty => 0,
    Full(Closed) => 1,
    Full(Canceled(n)) => n,
  }
}

pub fn main(rt: Io, args: Args) -> Result[(), LaunchError] {
  let value: Outer[Inner] = Full(Closed)
  let selected = choose(value)
  out.print(
    io.stdout(rt) ? Grant,
    if selected == 1 {
      "ok\n"
    } else {
      "bad\n"
    }
  ) ? Output
  Ok(())
}

pub type LaunchError = Grant(GrantError) | Output(OutputError) | Usage(ArgError) | Files(
  FileError
)
