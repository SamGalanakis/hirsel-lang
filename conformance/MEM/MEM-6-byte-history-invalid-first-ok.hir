// rule: MEM-6
// expect: run
pub fn main() -> Result[(), ()] {
  let outcome = arena.bounded(
    1,
    fn(a: Arena) -> u64 {
      let mut out: List[u8] in a = [97u8]
      bytes.append_from_history(mut out, 1, 0)
      list.len(out)
    }
  )
  failure.check(outcome == Ok(1u64), TextInvariant())
  Ok(())
}
