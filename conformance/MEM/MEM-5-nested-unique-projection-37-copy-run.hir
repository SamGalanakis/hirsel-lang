// rule: MEM-5
// expect: run
type State {
  rows: List[List[i64]],
}

@noalloc
fn update(mut state: unique State) -> () uses {} {
  state.rows[0][1] += 1
  state.rows[1][0] -= 1
}

pub fn main() -> Result[(), ()] {
  let shared = State(rows: [[0i64, 0i64], [0i64, 0i64]])
  let saved = copy shared
  let mut state = unique shared
  update(mut state)
  if state.rows[0][1] != 1 || state.rows[1][0] != -1 {
    return Error(())
  }
  Ok(())
}
