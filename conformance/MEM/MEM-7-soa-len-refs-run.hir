// rule: MEM-7
// expect: run
@soa
type Row {
  small: u8,
  x: u64,
  bytes: Bytes,
  children: List[u64],
  flag: bool,
}

fn row(n: u64) -> Row {
  let mut data: List[u8] = [65, 66]
  let bytes = bytes.from_list(take data)
  Row(small: 7, x: n, bytes: take bytes, children: [n], flag: true)
}

fn check(t: Test, r: Row, n: u64) -> () {
  test.check(t, r.small == 7)
  test.check(t, r.x == n)
  test.check(t, r.flag)
  test.check(t, bytes.len(r.bytes) == 2)
  test.check(t, r.bytes[1] == 66)
  test.check(t, r.children[0] == n)
}

pub fn main(t: Test) -> Result[(), ()] {
  let mut rows: List[Row] = []
  test.check(t, list.len(rows) == 0)
  list.reserve(mut rows, 19)
  test.check(t, list.len(rows) == 0)
  list.push(mut rows, row(1))
  test.check(t, list.len(rows) == 1)
  let other: List[Row] = [row(2), row(3)]
  test.check(t, list.len(other) == 2)
  Ok(())
}
