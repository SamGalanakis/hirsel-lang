// rule: MEM-7
// expect: run
// Two records recursive through each other's optional boxes.
type Person {
  name: String,
  employer: Option[box Company],
}

type Company {
  size: u64,
  founder: Option[box Person],
}

fn headcount(employer: Option[box Company]) -> u64 {
  match employer {
    Some(c) => c.size + founders(c.founder),
    None() => 0,
  }
}

fn founders(founder: Option[box Person]) -> u64 {
  match founder {
    Some(p) => 1 + headcount(p.employer),
    None() => 0,
  }
}

pub fn main(t: Test) -> Result[(), ()] {
  let ada = Person(name: "ada", employer: None())
  let lab = Company(size: 3, founder: Some(box ada))
  let bob = Person(name: "bob", employer: Some(box lab))
  test.check(t, headcount(bob.employer) == 4)
  Ok(())
}
