// rule: MEM-7
// expect: run
// A record whose function field takes the record that lists it: the cycle
// runs through a function type and a List.
type Entry {
  name: String,
  size: fn(u64, Registry) -> u64 uses {},
}

type Registry {
  entries: List[Entry],
}

fn own(n: u64, r: Registry) -> u64 uses {} {
  n
}

fn everyone(n: u64, r: Registry) -> u64 uses {} {
  n * list.len(r.entries)
}

fn sizes(r: Registry) -> u64 {
  let mut sum = 0u64
  for e in r.entries {
    sum = sum + e.size(10, r)
  }
  sum
}

pub fn main(t: Test) -> Result[(), ()] {
  let registry = Registry(
    entries: [Entry(name: "own", size: own), Entry(name: "all", size: everyone)]
  )
  test.check(t, sizes(registry) == 30)
  Ok(())
}
