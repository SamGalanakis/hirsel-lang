// rule: MEM-12
// expect: reject MEM-12 at line 3
flat type R {
  d: Dir,
}

fn sandbox(f: fn() uses {}) -> () {
  f()
}

fn confine[T: flat](x: T, h: fn(T) uses {}) -> () {
  sandbox(
    fn() uses {} {
      h(x)
    }
  )
}

fn zap(r: R) -> () {
  let _ = file.remove(r.d, path.of("victim.txt"))
}

fn go(rt: Io) -> Result[(), FileError] {
  let d = io.dir(rt, path.of("."))?
  file.write_bytes(d, path.of("victim.txt"), b"x")?
  confine(R(d: d), zap)
  let msg: String = match file.read_bytes(d, path.of("victim.txt")) {
    Ok(_) => "victim still present\n",
    Error(_) => "victim removed inside uses {} closure\n",
  }
  let _ = out.print(io.stdout(rt) ? grant_error, msg)
  Ok(())
}

pub fn main(rt: Io, args: Args) -> Result[(), ()] {
  match go(rt) {
    Ok(()) => Ok(()),
    Error(_) => Error(()),
  }
}

@noalloc
fn grant_error(refusal: GrantError) -> FileError uses {} {
  NotGranted()
}
