// rule: PS-17
// expect: reject LANG-7 at line 7
// twin: PS/PS-17-analysis-closure-parameter-ok.hir
// An analysis annotation stands before a parameter of a function
// definition only, never a closure's.
fn apply(x: u64) -> u64 {
  let f = fn(@analysis(unit: m) y: u64) -> u64 {
    y + 1u64
  }
  f(x)
}

pub fn main() -> Result[(), ()] {
  let n = apply(1u64)
  Ok(())
}
