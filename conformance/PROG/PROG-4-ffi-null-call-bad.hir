// rule: PROG-4
// expect: reject LANG-7 at line 20
type State {
  value: i32,
}

/// Returns a callback that C owns for this run.
extern "c" fn get(u: Unsafe) -> FnPtr[fn(mut state_0: unique State) -> i32]

/// Calls f on ctx during this call and retains neither.
extern "c" fn invoke(
  u: Unsafe,
  mut ctx: unique State,
  f: FnPtr[fn(mut state_1: unique State) -> i32]
) -> i32

pub fn relay(u: Unsafe) -> i32 {
  let mut ctx = State(value: 0)
  let f = get(u)
  f(mut ctx)
}
