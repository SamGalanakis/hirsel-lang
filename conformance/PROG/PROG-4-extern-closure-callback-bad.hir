// rule: PROG-4
// expect: reject PROG-4 at line 9
// twin: LANG/LANG-7-extern-preserves-unique-ok.hir
type Count {
  calls: u32,
}

/// Calls each once during the call and retains neither the callback nor ctx.
extern "c" fn each(
  u: Unsafe,
  f: fn(mut ctx: unique Count, x: i32) -> i32,
  mut ctx: unique Count,
  n: i32
) -> ()
