// rule: PROG-2
// expect: accept
@loop_source(open, next)
pub type View {
  source: String,
}

pub type Cursor {
  source: String,
  position: u64,
}

@noalloc
fn view(s: String) -> View in s {
  View(source: copy s)
}

@noalloc
fn open(v: View) -> Cursor in v {
  Cursor(source: copy v.source, position: 0)
}

@noalloc
fn next(mut it: Cursor) -> Option[String] in it {
  if it.position == 0 {
    it.position = 1
    Some(copy it.source)
  } else {
    None
  }
}
