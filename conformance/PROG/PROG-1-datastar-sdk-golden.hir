@test
fn get_send_two_events(t: Test) {
  golden(
    t,
    false,
    r##"{
  "events": [
    {
      "type": "patchElements",
      "elements": "<div>Merge</div>"
    },
    {
      "type": "patchElements",
      "elements": "<div>Merge 2</div>"
    }
  ]
}
"##,
    r##"event: datastar-patch-elements
data: elements <div>Merge</div>

event: datastar-patch-elements
data: elements <div>Merge 2</div>

"##
  )
}

@test
fn post_read_signals_from_body(t: Test) {
  golden(
    t,
    true,
    r##"{
  "events": [
    {
      "type": "patchElements",
      "elements": "<div>Merge</div>"
    }
  ]
}
"##,
    r##"event: datastar-patch-elements
data: elements <div>Merge</div>

"##
  )
}
