@test
fn get_patch_elements_with_all_options(t: Test) {
  golden(
    t,
    false,
    r##"{
  "events": [
    {
      "type": "patchElements",
      "elements": "<div>Merge</div>",
      "eventId": "event1",
      "retryDuration": 2000,
      "selector": "div",
      "mode": "append",
      "useViewTransition": true
    }
  ]
}
"##,
    r##"event: datastar-patch-elements
id: event1
retry: 2000
data: selector div
data: mode append
data: useViewTransition true
data: elements <div>Merge</div>

"##
  )
}

