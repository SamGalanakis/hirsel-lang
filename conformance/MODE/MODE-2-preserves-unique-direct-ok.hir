// rule: MODE-2
// expect: accept
// A direct call to a `@preserves_unique` declaration hands `ys` back unique.
// Twin is MODE-2-preserves-unique-indirect-bad.
@preserves_unique(xs)
fn keep(mut xs: List[u64]) -> () {
  list.push(mut xs, 1)
}

fn need(mut xs: unique List[u64]) -> () {}

fn f(mut ys: unique List[u64]) -> () {
  keep(mut ys)
  need(mut ys)
}
