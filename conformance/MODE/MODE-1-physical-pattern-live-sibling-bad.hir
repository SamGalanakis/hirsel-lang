type Pair {
  left: Bytes,
  right: Bytes,
}

fn view(x: Bytes) -> Bytes in x {
  copy x
}

fn bump(mut x: Bytes) {}

fn probe(mut x: Bytes, mut y: Bytes) {
  let slot = Pair(left: view(x), right: view(y))
  let mut Pair(left: a, right: b) = take slot
  a = b"fresh"
  bump(mut y)
  let copied = copy b
}
