// rule: MODE-1
// expect: reject MODE-1 at line 16
fn view(x: Bytes) -> Bytes in x {
  copy x
}

fn bump(mut x: Bytes) {
  x = b"changed"
}

fn probe(mut x: Bytes, mut y: Bytes) {
  let mut slot = view(x)
  let mut n: u32 = 0u32
  while n < 3u32 {
    slot = view(y)
    bump(mut y)
    n += 1u32
  }
  let used = slot
  ()
}
// The holder is used after the conflicting action, so its loan is still live (§04).
