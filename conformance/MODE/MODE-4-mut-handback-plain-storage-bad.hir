// rule: MODE-4
// expect: reject MODE-4 at line 15
// twin: MODE/MODE-4-mut-handback-sendable-run.hir
// The reverse of MODE-4-mut-handback-sendable-storage-bad; storage whose
// type does not state `sendable` would be read as sendable inside a
// callee whose `mut` parameter states it.
fn replace(mut p: sendable fn() -> u64, take q: sendable fn() -> u64) -> () {
  p = q
}

fn probe(take q: sendable fn() -> u64) -> u64 {
  let mut f: fn() -> u64 = fn() {
    1
  }
  replace(mut f, take q)
  f()
}
