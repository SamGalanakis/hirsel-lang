// rule: MODE-4
// expect: accept
// Regression from annotation/mode; TIR/TypeMismatch/call result.
fn mk(a: Arena) -> unique Bytes {
  b"x"
}

fn choose(a: Arena, x: Bytes in a, y: Bytes) -> Bytes in {a, x} {
  x
}

fn fresh(a: Arena, y: Bytes) -> Bytes in a {
  choose(
    a,
    fn() {
      mk(a)
    }(),
    y
  )
}
