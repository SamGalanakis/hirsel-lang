// twin: MODE/MODE-1-receiving-local-holder-branch-field-ok.hir
type Holder {
  value: Bytes,
}

fn identity[T](x: T) -> T in x {
  x
}

fn example(take h: Holder, seed: Bytes, c: bool) -> Bytes {
  let mut r: Holder in r = take h
  if c {
    r.value = identity(seed)
  }
  r.value
}
