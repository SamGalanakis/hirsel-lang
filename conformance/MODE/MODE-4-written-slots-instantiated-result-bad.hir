fn cross(take x: sendable Option[Bytes]) {}

fn probe() {
  let mut s: Slots[Bytes] = slots.empty()
  let fresh: Bytes = b"x"
  let id = slots.insert(mut s, take fresh)
  cross(slots.get(s, id))
}
