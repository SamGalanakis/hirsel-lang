// rule: MODE-4
// expect: run
// Advance-only next retains the inferred state evidence, also under a local loan.
fn step(mut n: u64) -> Option[u64] {
  None
}

fn advance(mut it: sendable Iter[u64]) -> () {
  let _ = iter.next(mut it)
}

pub fn main(rt: Io, args: Args) -> Result[(), ()] {
  let mut it: sendable Iter[u64] = iter.from(0u64, step)
  advance(mut it)
  let mut inferred = iter.from(0u64, step)
  let _ = iter.next(mut inferred)
  Ok(())
}
