// rule: MODE-2
// expect: reject MODE-2 at line 18
// The `let` statement holding the map.get temporary has not ended when its
// branch calls `need` before `continue`, so the map is still aliased there.
// Twin is MODE-2-map-get-borrow-dies-at-continue-run.
fn need(mut m: unique Map[String, String]) -> () {}

fn count(mut m: unique Map[String, String], k: String) -> u64 {
  let mut n = 0u64
  let mut skipped = 0u64
  while n < 3u64 {
    need(mut m)
    n = n + 1u64
    let size = match map.get(m, k) {
      Some(v) => string.byte_len(v),
      None() => 0u64,
    } + if n == 1u64 {
      need(mut m)
      skipped = skipped + 1u64
      continue
    } else {
      0u64
    }
  }
  skipped
}
