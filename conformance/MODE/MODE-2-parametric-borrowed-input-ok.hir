// rule: MODE-2
// expect: accept
// A borrowed input naming another parameter supplies nothing the result
// holds, so pick's result is unique. Twin is MODE-2-parametric-borrowed-input-bad.
fn pick[U, S](take a: U, seen: List[S]) -> U uses {} {
  take a
}

pub fn main(rt: Io, args: Args) -> Result[(), GrantError] {
  let seen: List[Bytes] = []
  let fresh: unique Bytes = core@1/bytes.from_list([1u8])
  let b: unique Bytes = pick(take fresh, seen)
  Ok(())
}
