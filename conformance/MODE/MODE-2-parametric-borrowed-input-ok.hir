// rule: MODE-2
// expect: accept
// pick's checked body cannot move a U out of the borrowed `seen`, copy one, or
// return what it derives from the borrow, so `seen` supplies nothing and pick
// hands its taken value back unique. Twins are
// MODE-2-parametric-borrowed-thunks-bad and GEN-1-parametric-borrowed-share-bad.
fn pick[U](take a: U, seen: List[U]) -> U uses {} {
  take a
}

pub fn main(rt: Io, args: Args) -> Result[(), GrantError] {
  let seen: List[Bytes] = []
  let fresh: unique Bytes = core@1/bytes.from_list([1u8])
  let b: unique Bytes = pick(take fresh, seen)
  Ok(())
}
