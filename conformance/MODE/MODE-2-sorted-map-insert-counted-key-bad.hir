// rule: MODE-2
// expect: reject MODE-2 at line 11
// sorted_map.insert takes a String key that `kept` still shares, so the map is
// aliased after it; only `by` is unretained. Twin is
// MODE-2-sorted-map-insert-unretained-order-ok.
fn need(by: Order[String], mut m: unique SortedMap[String, u64] of by) -> () {}

fn f(by: Order[String], mut m: unique SortedMap[String, u64] of by, take k: String) -> () {
  let kept = copy k
  sorted_map.insert(by, mut m, take k, 2)
  need(by, mut m)
}
