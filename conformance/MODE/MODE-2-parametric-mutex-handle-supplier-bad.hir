// rule: MODE-2
// expect: reject MODE-2 at line 15
// The copied `Mutex` handle qualifies, but the other supplier is a copy of
// `ys`, so the parametric result is aliased. Twin is
// MODE-2-parametric-mutex-handle-supplier-ok.
fn pair[A, B](take a: A, take b: B) -> (A, B) uses {} {
  (take a, take b)
}

fn probe(tasks: Tasks) -> u64 {
  let h: Mutex[List[u64]] = mutex.create(tasks, take [1u64])
  let t = copy h
  let ys: List[u64] = [3u64]
  let zs = copy ys
  let p: unique (Mutex[List[u64]], List[u64]) = pair(take t, take zs)
  list.len(ys)
}
