// rule: MODE-1
// expect: reject MODE-1 at line 30
type Pair {
  left: Bytes,
  right: Bytes,
}

type Nest {
  pair: Pair,
  other: Bytes,
}

type Bucket {
  items: List[Bytes],
  other: Bytes,
}

fn view(x: Bytes) -> Bytes in x {
  copy x
}

fn bump(mut x: Bytes) {
  ()
}

fn probe(mut x: Bytes, mut y: Bytes, c: bool) {
  let mut slot = Pair(left: view(x), right: view(y))
  let kept = copy slot.left
  slot.left = b"fresh"
  bump(mut x)
  let used = kept
  ()
}
// The holder is used after the conflicting action, so its loan is still live (§04).
