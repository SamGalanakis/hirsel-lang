// rule: MODE-1
// expect: reject MODE-1 at line 11
// twin: MODE/MODE-1-called-closure-local-result-ok.hir
// A closure's inferred result cannot refer to a local temporary of its body.
fn view(x: Bytes) -> Bytes in x {
  copy x
}

fn example(a: Bytes) -> Bytes in a {
  fn() {
    view(copy a)
  }()
}
