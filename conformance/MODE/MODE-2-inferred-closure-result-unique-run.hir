// rule: MODE-2
// expect: run
// stdout: ok
// The twin of MODE-2-inferred-closure-result-unique-bad. The literal writes
// its result `unique`, so the list it builds and returns meets the `unique`
// parameter.
fn sink(xs: unique List[u64]) -> u64 {
  list.len(xs)
}

fn probe() -> u64 {
  sink(
    fn() -> unique List[u64] {
      let xs: List[u64] = [1]
      xs
    }()
  )
}

pub fn main(rt: Io, args: Args) -> Result[(), GrantError] {
  let _ = out.print(
    io.stdout(rt)?,
    if probe() == 1 {
      "ok\n"
    } else {
      "bad\n"
    }
  )
  Ok(())
}
