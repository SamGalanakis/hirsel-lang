// rule: MODE-4
// expect: run
// stdout: ok
// The twin of MODE-4-borrowed-parameter-callable-bad. A borrowed parameter
// written `sendable fn` keeps that promise in its body, so it may be lent
// on to another such parameter.
fn needs(g: sendable fn() -> u64) -> u64 {
  g()
}

fn probe(take f: sendable fn() -> u64) -> u64 {
  relay(f)
}

fn relay(f: sendable fn() -> u64) -> u64 {
  needs(f)
}

fn seven() -> u64 {
  7
}

pub fn main(rt: Io, args: Args) -> Result[(), GrantError] {
  let _ = out.print(
    io.stdout(rt)?,
    if probe(take seven) == 7 {
      "ok\n"
    } else {
      "bad\n"
    }
  )
  Ok(())
}
