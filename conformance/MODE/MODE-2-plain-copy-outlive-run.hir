// rule: MODE-2
// expect: run
// The saved copy outlives the original's last mutation and its scope.
pub fn main() -> Result[(), String] {
  let saved = {
    let mut m: Map[u64, u64] = map.empty()
    map.insert(mut m, 1, 10)
    let snapshot = copy m
    map.insert(mut m, 1, 11)
    snapshot
  }
  failure.check(map.get(saved, 1) == Some(10u64), Bounds())
  Ok(())
}
