// rule: MODE-1
// expect: accept
fn view(x: Bytes) -> Bytes in x {
  copy x
}

fn bump(mut x: Bytes) {
  x = b"changed"
}

fn probe(mut x: Bytes, mut y: Bytes) {
  let mut slot = view(x)
  let mut n: u32 = 0u32
  while n < 3u32 {
    slot = view(y)
    n += 1u32
  }
  slot = b"fresh"
  bump(mut y)
  let read = slot
}
