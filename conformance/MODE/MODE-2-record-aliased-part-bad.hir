type Reply {
  status: u16,
  content_length: u64,
  request_id: u64,
  protocol_version: u16,
  body: String,
}

fn make(take body: String) -> unique Reply {
  Reply(
    status: 200u16,
    content_length: 0u64,
    request_id: 0u64,
    protocol_version: 1u16,
    body: take body
  )
}
