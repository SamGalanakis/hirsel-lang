// rule: MODE-2
// expect: reject MODE-2 at line 13
// A callback lent a U is no supplier that receives U only by take, even when its
// own result is unique, so tap's result is not proved unique. Twin is
// MODE-2-parametric-lent-pure-callback-ok.
fn tap[U](take u: U, f: fn(view: U) -> unique U uses {}) -> U uses {f} {
  let _ = f(u)
  take u
}

pub fn main(rt: Io, args: Args) -> Result[(), GrantError] {
  let fresh: unique Bytes = core@1/bytes.from_list([1u8])
  let b: unique Bytes = tap(
    take fresh,
    fn(v: Bytes) -> unique Bytes uses {} {
      core@1/bytes.from_list([2u8])
    }
  )
  Ok(())
}
