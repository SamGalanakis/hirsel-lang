// rule: MODE-2
// expect: reject MODE-2 at line 9
// `y` still shares `x`, which the tuple holds where a parameter needs its
// first part unique. Twin is MODE-2-inferred-tuple-shared-part-run.
fn need(take t: (unique List[u64], List[u64])) -> () {}

fn pair(take x: unique List[u64]) -> () {
  let y = copy x
  let t = (take x, take y)
  need(take t)
}
