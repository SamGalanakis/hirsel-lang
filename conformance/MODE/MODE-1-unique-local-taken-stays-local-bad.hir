// rule: MODE-1
// expect: reject MODE-1 at line 7
// twin: MODE/MODE-1-unique-local-taken-stays-local-ok.hir
// `unique x` of a value already unique makes no copy (MEM-5), so x stays
// local to its own argument and cannot be returned as a global result.
fn preserve(take x: unique Bytes in x) -> unique Bytes {
  unique x
}
