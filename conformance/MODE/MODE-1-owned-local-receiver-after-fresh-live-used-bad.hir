// rule: MODE-1
// expect: reject MODE-1 at line 18
// twin: MODE/MODE-1-owned-local-receiver-after-fresh-ok.hir
fn view(x: Bytes) -> Bytes in x {
  copy x
}

fn bump(mut x: Bytes) {
  ()
}

fn probe(mut x: Bytes, mut y: Bytes) {
  let mut slot = view(x)
  slot = b"fresh"
  bump(mut x)
  slot = view(y)
  // The new view still borrows y.
  bump(mut y)
  let used = slot
  ()
}
// The holder is used after the conflicting action, so its loan is still live (LANG-3).
