// rule: MODE-2
// expect: run
// xs is unique again before b's finalizer runs at the block's end. Twin is
// MODE-2-release-failure-block-end-bad.
resource type Bomb {
  n: u64,
}
drop(b) {
  let _ = 10u64 / b.n
}

fn grow(mut xs: unique List[u64]) uses {} {
  let fresh: unique List[u64] = [1u64]
  {
    let b = Bomb(n: 1u64)
    let kept = copy xs
    xs = take fresh
  }
}

pub fn main(rt: Io, args: Args) -> Result[(), GrantError] {
  let mut xs: unique List[u64] = [0u64]
  grow(mut xs)
  Ok(())
}
