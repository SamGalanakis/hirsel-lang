// rule: MODE-1
// expect: accept
@loop_source(open, next)
type View {
  source: String,
}

type Cursor {
  source: String,
  position: u64,
}

@noalloc
fn view(s: String) -> View in s {
  View(source: copy s)
}

@noalloc
fn open(v: View) -> Cursor in v {
  Cursor(source: copy v.source, position: 0)
}

@noalloc
fn next(mut it: Cursor) -> Option[String] in it {
  if it.position == 0 {
    it.position = 1
    Some(copy it.source)
  } else {
    None
  }
}

fn length() -> u64 {
  let outer: String = "a"
  let s: String in outer = copy outer
  for piece in view(s) {
    return string.byte_len(piece)
  }
  0
}
