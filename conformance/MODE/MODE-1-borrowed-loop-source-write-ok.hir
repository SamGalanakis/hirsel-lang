// rule: MODE-1
// expect: accept
// The twin of MODE-1-borrowed-loop-source-write-bad.hir writes another list,
// so the iterated source stays untouched.
type R {
  name: String,
  n: u64,
}

fn probe() -> u64 {
  let xs: List[R] = [R(name: "ab", n: 1)]
  let mut ys: List[R] = [R(name: "cd", n: 2)]
  for r in xs {
    ys[0].n = 5
  }
  ys[0].n
}
