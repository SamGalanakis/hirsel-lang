// rule: MODE-2
// expect: run
// stdout: ok
// A mutable loop over a unique list binds element places (SEM-4): testing a
// variant field of the element, with `if let` or `match`, and then writing
// another of its fields updates the list in place, which is then returned.
type Kind = Scalar(String) | Ref(u64)

type Field {
  boxed: bool,
  kind: Kind,
}

fn mark(resolved: List[List[Field]]) -> List[Field] uses {} {
  let mut fields = unique resolved[0]
  for f in mut fields {
    if let Ref(_) = f.kind {
      f.boxed = true
    }
  }
  fields
}

fn mark_match(resolved: List[List[Field]]) -> List[Field] uses {} {
  let mut fields = unique resolved[0]
  for f in mut fields {
    match f.kind {
      Ref(_) => {
        f.boxed = true
      },
      Scalar(_) => (),
    }
  }
  fields
}

fn mark_named(resolved: List[List[Field]]) -> List[Field] uses {} {
  let mut fields = unique resolved[0]
  for f in mut fields {
    match f.kind {
      Ref(n) => {
        f.boxed = n == 0
      },
      Scalar(name) => {
        f.boxed = string.byte_len(name) > 3
      },
    }
  }
  fields
}

pub fn main(rt: Io) -> Result[(), GrantError] {
  let input: List[List[Field]] = [
    [Field(boxed: false, kind: Ref(0u64)), Field(boxed: false, kind: Scalar("x"))]
  ]
  let a = mark(input)
  let b = mark_match(input)
  let c = mark_named(input)
  let ok = a[0].boxed && !a[1].boxed && b[0].boxed && !b[1].boxed && c[0].boxed && !c[1].boxed
  let _ = out.print(
    io.stdout(rt)?,
    if ok {
      "ok\n"
    } else {
      "bad\n"
    }
  )
  Ok(())
}
