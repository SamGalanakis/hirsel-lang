// twin: MODE/MODE-2-unique-part-mut-ok.hir
// A field shared by a copy is no longer unique, through a push as before it.
type Queue {
  items: unique List[u64],
}

fn queue(mut q: unique Queue) -> () {
  let kept = copy q.items
  list.push(mut q.items, 1u64)
  let item = list.pop(mut q.items)
}
