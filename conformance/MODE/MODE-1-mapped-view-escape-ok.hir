// rule: MODE-1
// expect: accept
// A body may read the view in place, or return a deep copy, which owns its blocks.
fn keep(d: Dir) -> Result[Bytes, FileError] uses {d} {
  let m = file.map(d, path.of("data"))?
  mapped.with(
    d,
    m,
    fn(view: Bytes) -> Bytes {
      unique bytes.slice(view, 0, 2)
    }
  )
}
