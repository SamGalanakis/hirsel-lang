type Pair {
  left: Bytes,
  right: Bytes,
}

fn view(x: Bytes) -> Bytes in x {
  copy x
}

fn bump(mut x: Bytes) {
  ()
}

fn probe(mut x: Bytes, mut y: Bytes) {
  let mut slot = Pair(left: view(x), right: b"right")
  slot.left = view(y)
  bump(mut x)
  bump(mut y)
  let used = slot
  ()
}
// The holder is used after the conflicting action, so its loan is still live (LANG-3).
