// twin: MODE/MODE-1-last-use-view-dead-before-mut-ok.hir
// The view is used after the `mut`, so its loan is live there (LANG-3).
fn look(x: Bytes) -> u64 {
  0
}

fn view(x: Bytes) -> Bytes in x {
  copy x
}

fn bump(mut x: Bytes) {
  ()
}

fn probe(mut b: Bytes) -> u64 {
  let v = view(b)
  bump(mut b)
  look(v)
}
