// rule: MODE-2
// expect: run
// W1m twin: a deep-copied element does not share the loop source.
type Rec {
  items: List[String],
}

@noalloc
fn by(a: String, b: String) -> i32 uses {} {
  0
}

fn sorted(take r: unique Rec) -> unique Rec {
  let mut owned = take r
  let mut kept = ""
  for item in owned.items {
    kept = unique item
  }
  list.sort(mut owned.items, by)
  take owned
}

pub fn main() -> Result[(), ()] {
  let r = sorted(unique Rec(items: ["b", "a"]))
  failure.check(list.len(r.items) == 2, Arithmetic())
  Ok(())
}
