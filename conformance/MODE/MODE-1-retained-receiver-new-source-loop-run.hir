// rule: MODE-1
// expect: run
// stdout: kept
fn view(x: Bytes) -> Bytes in x {
  copy x
}

fn probe(x: Bytes, y: Bytes, c: bool) -> Bytes in {x, y} {
  let mut slot = view(x)
  let mut more = c
  while more {
    slot = view(y)
    more = false
  }
  slot
}

pub fn main(rt: Io, args: Args) -> Result[(), GrantError] {
  let x: Bytes = b"first"
  let y: Bytes = b"second"
  let got = probe(x, y, true)
  if got == b"second" {
    let _ = out.print(io.stdout(rt)?, "kept\n")
  }
  Ok(())
}
