// rule: MODE-1
// expect: accept
// A copy of taken storage in a block or branch tail is still that storage for
// the result (P2, LANG-11). Here each result is kept by a let in this frame,
// which bounds it. A taken parameter whose content is global and unplaced is
// its own share, so a result may keep its copy.
fn mk(a: Arena) -> Bytes in a {
  b"x"
}

fn id(a: Arena, x: Bytes in a) -> Bytes in {a, x} {
  x
}

fn block(a: Arena, take z: Bytes in a) -> u64 {
  let r = id(
    a,
    {
      copy z
    }
  )
  1u64
}

fn branch(a: Arena, c: bool, take z: Bytes in a) -> u64 {
  let r = id(
    a,
    if c {
      copy z
    } else {
      mk(a)
    }
  )
  1u64
}

fn unique_block(a: Arena, take z: Bytes in a) -> u64 {
  let r = id(
    a,
    unique copy {
      z
    }
  )
  1u64
}

fn global_branch(a: Arena, c: bool, take z: Bytes) -> Bytes in a {
  id(
    a,
    if c {
      copy z
    } else {
      mk(a)
    }
  )
}
