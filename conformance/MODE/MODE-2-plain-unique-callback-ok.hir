// rule: MODE-2
// expect: accept
// A callback header may spell a plain payload with or without `unique`,
// whichever way the required function type spells it.
type P {
  x: u32,
  y: u32,
}

fn each[T](f: fn(mut v: unique T) -> (), take x: unique T) -> () {
  let mut y = x
  f(mut y)
}

fn example(tasks: Tasks, m: Mutex[P], take p: P) -> () {
  let _ = mutex.with(
    tasks,
    m,
    fn(mut value: unique P) uses {} {
      value.x
    }
  )
  let _ = mutex.with(
    tasks,
    m,
    fn(mut value: P) uses {} {
      value.y
    }
  )
  each(
    fn(mut v: P) {
      v.x = 1
    },
    take p
  )
  each(
    fn(mut v: unique u8) {
      v = 1
    },
    take 2u8
  )
}
