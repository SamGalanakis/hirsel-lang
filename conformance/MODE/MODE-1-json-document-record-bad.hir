type Wrapper {
  value: Option[Bytes],
}

fn example() -> Result[Wrapper, json.JsonError] {
  json_document.with_document(
    "\"hello\"",
    fn(doc: json_document.Document) -> Wrapper {
      Wrapper(value: json_document.text_bytes(doc, 0))
    }
  )
}
