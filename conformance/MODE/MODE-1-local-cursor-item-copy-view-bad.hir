// twin: MODE/MODE-1-local-cursor-item-copy-run.hir
fn view(x: String) -> String in x {
  x
}

fn probe(take xs: Set[String] in xs, seed: String) -> u64 {
  let mut keep = view(seed)
  for x in take xs {
    keep = view(copy x)
  }
  string.byte_len(keep)
}
