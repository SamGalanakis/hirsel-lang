// rule: MODE-3
// expect: reject MODE-3 at line 24
// Taking the same capture requires once and cannot satisfy repeat's many promise.
resource type Token {
  n: u64,
}
drop(t) {
  ()
}

fn inspect(take token: Token) {
  let _ = token.n
}

fn repeat(f: fn() uses {}) {
  f()
  f()
}

fn example(take token: Token) {
  let f: once fn() uses {} = fn() {
    inspect(take token)
  }
  repeat(f)
}
