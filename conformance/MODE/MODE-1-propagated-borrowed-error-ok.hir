// rule: MODE-1
// expect: accept
// Twin of the -bad case: a result `in data` may hold an error borrowed from
// `data`, so `?` propagates it.
fn split(data: Bytes) -> Result[Bytes, String] in data {
  Ok(data)
}

fn decode(data: Bytes) -> Result[(), String] in data {
  let _ = split(data)?
  Ok(())
}
