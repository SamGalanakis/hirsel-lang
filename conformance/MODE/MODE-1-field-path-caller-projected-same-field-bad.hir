// rule: MODE-1
// expect: reject MODE-1 at line 22
// v22 #77, a projected argument. The result reads within q.p.a, so writing
// q.p.a while it lives conflicts with that loan.
type Pair {
  a: String,
  b: String,
}

type Outer {
  p: Pair,
  n: u64,
}

fn get(p: Pair) -> String in p.a {
  p.a
}

fn caller(x: String, y: String) -> u64 {
  let mut q = Outer(p: Pair(a: x, b: x), n: 0u64)
  let r = get(q.p)
  q.p.a = y
  string.byte_len(r)
}
