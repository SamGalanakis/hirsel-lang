// rule: MODE-1
// expect: accept
fn view(x: Bytes) -> Bytes in x {
  copy x
}

fn bump(mut x: Bytes) {
  x = b"changed"
}

fn probe(mut x: Bytes, mut y: Bytes) {
  let mut slot = view(x)
  let mut n: u32 = 0u32
  while n < 3u32 {
    slot = view(y)
    bump(mut y)
    n += 1u32
  }
  ()
}
// v22 R2 (§04, LANG-3): a loan lasts until its holder's last use. The holder
// is dead at the conflicting action, so this v21 reject is accepted; the
// holder-used twin is MODE-1-result-holder-loop-live-inside-used-bad.hir.
