// rule: MODE-2
// expect: reject MODE-2 at line 12
// A borrowed input naming U is not counted as a supplier of U, so the
// result stays aliased. Twin is MODE-2-parametric-borrowed-input-ok.
fn pick[U](take a: U, seen: List[U]) -> U uses {} {
  take a
}

pub fn main(rt: Io, args: Args) -> Result[(), GrantError] {
  let seen: List[Bytes] = []
  let fresh: unique Bytes = core@1/bytes.from_list([1u8])
  let b: unique Bytes = pick(take fresh, seen)
  Ok(())
}
