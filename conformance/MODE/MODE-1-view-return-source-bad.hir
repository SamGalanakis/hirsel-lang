// rule: MODE-1
// expect: reject MODE-1 at line 36
// twin: SEM/SEM-4-view-return-source-run.hir
@loop_source(open, next)
pub opaque type View: copyable + noalloc_drop uses {} {
  source: String,
}

pub opaque type Cursor: copyable + noalloc_drop uses {} {
  source: String,
  position: u64,
}

@noalloc
fn view(s: String) -> View in s {
  View(source: copy s)
}

@noalloc
fn open(v: View) -> Cursor in v {
  Cursor(source: copy v.source, position: 0)
}

@noalloc
fn next(mut it: Cursor) -> Option[String] in it {
  if it.position == 0 {
    it.position = 1
    Some(copy it.source)
  } else {
    None
  }
}

fn first(s: String) -> String {
  for piece in view(s) {
    return piece
  }
  copy s
}

pub fn main(rt: Io, args: Args) -> Result[(), GrantError] {
  let _ = out.print(io.stdout(rt)?, first("a"))
  let _ = out.print(io.stdout(rt)?, "\n")
  Ok(())
}
