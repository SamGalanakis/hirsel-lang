// rule: MODE-2
// expect: reject MODE-2 at line 13
// A shared Map cannot lend a unique stored value. Twin is
// MODE-2-map-update-unique-ok.
fn change(mut n: unique u64) -> () uses {} {
  n += 1
}

pub fn main(t: Test) -> Result[(), ()] {
  let mut m: Map[String, u64] = map.empty()
  let other = copy m
  let key = "key"
  let changed = std@1/map.update(mut m, key, change)
  failure.check(map.len(other) == 0, Bounds())
  Ok(())
}
