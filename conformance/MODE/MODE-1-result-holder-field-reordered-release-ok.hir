// rule: MODE-1
// expect: accept
type Pair {
  left: Bytes,
  right: Bytes,
}

type Nest {
  pair: Pair,
  other: Bytes,
}

type Bucket {
  items: List[Bytes],
  other: Bytes,
}

fn view(x: Bytes) -> Bytes in x {
  copy x
}

fn bump(mut x: Bytes) {
  ()
}

fn probe(mut x: Bytes, mut y: Bytes, c: bool) {
  let mut slot = Pair(right: view(y), left: view(x))
  slot.left = b"fresh"
  bump(mut x)
  slot.right = b"new"
  bump(mut y)
  ()
}
