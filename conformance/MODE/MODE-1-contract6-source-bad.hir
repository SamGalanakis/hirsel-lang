// rule: MODE-1
// expect: reject MODE-1 at line 38
@loop_source(open, next)
type View {
  source: String,
}

type Cursor {
  source: String,
  position: u64,
}

@noalloc
fn view(s: String) -> View in s {
  View(source: copy s)
}

@noalloc
fn open(v: View) -> Cursor in v {
  Cursor(source: copy v.source, position: 0)
}

@noalloc
fn next(mut it: Cursor) -> Option[String] in it {
  if it.position == 0 {
    it.position = 1
    Some(copy it.source)
  } else {
    None
  }
}

fn first(s: String) -> String {
  let mut out: String in s = ""
  for piece in view(s) {
    out = copy piece
  }
  out
}
