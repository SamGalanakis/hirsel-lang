// Dropping a resource at scope exit is a use of its loans (DROP-2).
resource type Guard {
  data: Bytes,
}
drop(g) {}

fn guard(x: Bytes) -> Guard in x {
  Guard(data: copy x)
}

fn bump(mut x: Bytes) {
  ()
}

fn probe(mut b: Bytes) {
  let g = guard(b)
  bump(mut b)
  ()
}
