// rule: MODE-2
// expect: reject MODE-2 at line 12
// twin: MODE/MODE-2-preserves-unique-never-arm-ok.hir
// A diverging arm adds nothing to the match, but the other arm's real
// alias still breaks the promise. Twin is
// MODE-2-preserves-unique-never-arm-ok.
@preserves_unique(value)
fn unwrap(t: Test, take value: Result[List[u8], ()]) -> List[u8] {
  match take value {
    Ok(success) => {
      let kept = copy success
      take success
    },
    Error(_) => core@1/test.fail(t),
  }
}
