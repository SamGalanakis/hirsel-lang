// rule: MODE-1
// expect: reject MODE-1 at line 19
// twin: MODE/MODE-1-receiving-local-holder-loop-field-ok.hir
type Holder {
  value: Bytes,
}

fn identity[T](x: T) -> T in x {
  x
}

fn example(take h: Holder, seed: Bytes, c: bool) -> Bytes {
  let mut r: Holder in r = take h
  let mut again = c
  while again {
    r.value = identity(seed)
    again = false
  }
  r.value
}
