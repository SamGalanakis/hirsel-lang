// twin: MODE/MODE-1-field-path-result-through-binding-ok.hir
// v22 #77. A binding read from p.b keeps that part, so returning it under a
// relation to p.a is outside the relation.
type Pair {
  a: Bytes,
  b: Bytes,
}

fn get(p: Pair) -> Bytes in p.a {
  let q = p.b
  q
}
