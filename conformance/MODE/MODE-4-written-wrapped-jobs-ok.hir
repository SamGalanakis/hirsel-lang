// rule: MODE-4
// expect: accept
fn put[T](mut xs: List[T], take x: T) {
  list.push(mut xs, take x)
}

fn put_sendable[T](mut xs: List[sendable T], take x: sendable T) {
  list.push(mut xs, take x)
}

fn probe() {
  let mut xs: List[sendable fn() -> u64] = []
  put(
    mut xs,
    fn() {
      1u64
    }
  )
  put_sendable(
    mut xs,
    fn() {
      2u64
    }
  )
}
