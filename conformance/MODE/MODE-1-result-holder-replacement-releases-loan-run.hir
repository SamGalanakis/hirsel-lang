// rule: MODE-1
// expect: run
// stdout: released
fn view(x: Bytes) -> Bytes in x {
  copy x
}

fn bump(mut x: Bytes) {
  x = b"changed"
}

fn probe(mut x: Bytes) {
  let mut slot = view(x)
  slot = b"fresh"
  bump(mut x)
  let read = slot
}

pub fn main(rt: Io, args: Args) -> Result[(), GrantError] {
  let mut data: Bytes = b"old"
  probe(mut data)
  if data == b"changed" {
    let _ = out.print(io.stdout(rt)?, "released\n")
  }
  Ok(())
}
