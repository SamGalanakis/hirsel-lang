// rule: MODE-2
// expect: accept
// Borrowed keys and callbacks do not weaken the Map's uniqueness. Twin is
// MODE-2-map-update-shared-bad.
fn change(mut n: unique u64) -> () uses {} {
  n += 1
}

pub fn main(t: Test) -> Result[(), ()] {
  let mut m: unique Map[String, u64] = map.empty()
  let key = "key"
  let changed = std@1/map.update(mut m, key, change)
  let again = std@1/map.update(mut m, key, change)
  Ok(())
}
