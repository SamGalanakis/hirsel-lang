// rule: MODE-1
// expect: reject MODE-1 at line 6
// twin: SEM/SEM-4-view-return-graphemes-run.hir
fn first(s: String) -> String {
  for piece in unicode.graphemes(s) {
    return piece
  }
  copy s
}

pub fn main(rt: Io, args: Args) -> Result[(), GrantError] {
  let s = string.concat("a", "b")
  let _ = out.print(io.stdout(rt)?, first(s))
  let _ = out.print(io.stdout(rt)?, "\n")
  Ok(())
}
