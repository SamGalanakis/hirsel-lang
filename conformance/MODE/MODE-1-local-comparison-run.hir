// rule: MODE-1
// expect: run
// stdout: ok
// Locality describes the holder, not the contents, so a local result compares with a global literal.
fn pick(xs: List[Bytes], x: Bytes) -> Bytes in {xs, x} {
  for e in xs {
    return e
  }
  x
}

fn view(x: Bytes) -> Bytes in x {
  copy x
}

fn same(take b: Bytes, c: Bytes) -> bool {
  view(b) == view(c)
}

pub fn main(rt: Io, args: Args) -> Result[(), GrantError] {
  let xs: List[Bytes] = [b"first", b"second"]
  let ok = pick(xs, b"fallback") == b"first" && same(b"x", b"x")
  let _ = out.print(
    io.stdout(rt)?,
    if ok {
      "ok\n"
    } else {
      "bad\n"
    }
  )
  Ok(())
}
