fn pair[A, B](take a: A, take b: B) -> (A, B) uses {} {
  (take a, take b)
}

fn probe(take xs: unique List[u64]) -> u64 {
  let h: Shared[List[u64]] = shared.freeze(take xs)
  let t = copy h
  let ys: List[u64] = [3u64]
  let zs = copy ys
  let p: unique (Shared[List[u64]], List[u64]) = pair(take t, take zs)
  list.len(ys)
}
