// rule: MODE-4
// expect: run
// stdout: ok
// The twin of MODE-4-take-parameter-callable-bad; the taken parameter states
// `sendable`, so it may be handed on to a parameter that requires it.
fn needs(take g: sendable fn() -> u64) -> u64 {
  g()
}

fn probe(take f: sendable fn() -> u64) -> u64 {
  needs(take f)
}

fn seven() -> u64 {
  7
}

pub fn main(rt: Io, args: Args) -> Result[(), GrantError] {
  let _ = out.print(
    io.stdout(rt)?,
    if probe(take seven) == 7 {
      "ok\n"
    } else {
      "bad\n"
    }
  )
  Ok(())
}
