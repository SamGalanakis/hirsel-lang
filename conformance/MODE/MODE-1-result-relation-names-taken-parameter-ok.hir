// rule: MODE-1
// expect: accept
// "A taken parameter named in S is consumed; no read loan remains and the
// result is as local as that argument was." A result may be related to a
// taken parameter that is not an arena.
type Ast {
  bytes: Bytes,
}

fn build(take src: Bytes) -> Ast in src {
  Ast(bytes: take src)
}
