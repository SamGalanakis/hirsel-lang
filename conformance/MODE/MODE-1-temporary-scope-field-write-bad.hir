// rule: MODE-1
// expect: reject MODE-1 at line 16
// twin: MODE/MODE-1-temporary-scope-direct-write-ok.hir
fn view(x: Bytes) -> Bytes in x {
  copy x
}

type Pair {
  left: Bytes,
  right: Bytes,
}

fn probe(mut x: Bytes, mut y: Bytes) {
  let mut pair = Pair(left: view(x), right: view(x))
  while false {
    pair.left = view(copy y)
  }
  ()
}
