// rule: MODE-2
// expect: accept
// The later block argument reads `a` by borrowing and stores a fresh list, so
// `a` is still unique at callee entry and so is the parametric result. Twin is
// MODE-2-parametric-generic-mut-later-argument-share-bad.
fn swap_out[T](mut slot: T, take fresh: T, tag: u64) -> T uses {} {
  replace(mut slot, take fresh)
}

fn probe() -> u64 {
  let mut a: unique List[u64] = [1u64, 2u64]
  let mut keep: List[List[u64]] = []
  let old: unique List[u64] = swap_out(
    mut a,
    take [],
    {
      list.push(mut keep, [list.len(a)])
      0u64
    }
  )
  list.len(keep)
}
