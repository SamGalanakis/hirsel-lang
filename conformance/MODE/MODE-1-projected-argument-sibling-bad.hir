// rule: MODE-1
// expect: reject MODE-1 at line 22
// Replacing q.p overlaps the loan on the argument place q.p, which a live result
// related to the argument holds (places and loans, docs/spec/ownership.md).
type Pair {
  a: String,
  b: String,
}

type Outer {
  p: Pair,
  n: u64,
}

fn view(p: Pair) -> String in p {
  p.b
}

fn caller(x: String, y: String) -> u64 {
  let mut q = Outer(p: Pair(a: x, b: x), n: 0u64)
  let r = view(q.p)
  q.p = Pair(a: y, b: y)
  string.byte_len(r)
}
