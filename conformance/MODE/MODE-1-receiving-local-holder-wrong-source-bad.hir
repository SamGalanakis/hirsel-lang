type Holder {
  value: Bytes,
}

fn identity[T](x: T) -> T in x {
  x
}

fn example(take h: Holder, seed: Bytes) -> Bytes in h {
  let mut r: Holder in r = take h
  r.value = identity(seed)
  r.value
}
