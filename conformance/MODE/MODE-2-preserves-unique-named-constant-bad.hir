// rule: MODE-2
// expect: reject MODE-2 at line 10
// A named constant shares program-lifetime storage, so an arm producing it
// breaks the promise. Twin is MODE-2-preserves-unique-bare-variant-ok.
const SPARE: Option[List[u8]] = Some([1u8])

@preserves_unique(x)
fn wrap(take x: Option[List[u8]]) -> Option[List[u8]] uses {} {
  match take x {
    Some(v) => Some(take v),
    None => SPARE,
  }
}
