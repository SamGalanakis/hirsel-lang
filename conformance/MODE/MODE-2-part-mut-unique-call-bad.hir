// rule: MODE-2
// expect: reject MODE-2 at line 15
// twin: MODE/MODE-2-borrowed-part-argument-keeps-unique-ok.hir
type Store {
  version: u64,
  items: List[u64],
}

fn bump(mut st: unique Store) -> () uses {} {
  st.version += 1
}

fn add(mut st: unique Store) -> () uses {} {
  put(mut st.items)
  bump(mut st)
}

fn put(mut xs: List[u64]) -> () uses {} {
  list.push(mut xs, 1)
}
