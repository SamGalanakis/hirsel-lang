// rule: MODE-2
// expect: accept
// The map.get result and its arm's `v` die with the `let` statement, so the
// map is unique again for `need`. Twin is MODE-2-map-get-scrutinee-live-bad.
fn need(mut m: unique Map[String, String]) -> () {}

fn look(mut m: unique Map[String, String], k: String) -> u64 {
  let n = match map.get(m, k) {
    Some(v) => string.byte_len(v),
    None() => 0,
  }
  need(mut m)
  n
}
