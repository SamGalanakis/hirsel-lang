// rule: MODE-1
// expect: run
// "Plain values are never local." A StrPos or Path field read through a
// borrowed capture holds no loan on its record, so the closure returns it
// global, and a function may return it under a global result.
resource type Cursor {
  text: String,
  pos: StrPos of .text,
  name: Path,
}

fn position(c: Cursor) -> StrPos of c.text {
  fn() {
    c.pos
  }()
}

fn name(c: Cursor) -> Path {
  fn() {
    c.name
  }()
}

pub fn main(t: Test) -> Result[(), ()] {
  let text: String = "ab"
  match string.position(text, 1u64) {
    Some(pos) => {
      let c = Cursor(text: text, pos: pos, name: path.of("a/b"))
      test.check(
        t,
        string.byte_offset(
          c.text,
          fn() {
            c.pos
          }()
        ) == 1u64
      )
      test.check(t, string.byte_offset(c.text, position(c)) == 1u64)
      test.check(t, path.text(name(c)) == "a/b")
    },
    None => test.check(t, false),
  }
  Ok(())
}
