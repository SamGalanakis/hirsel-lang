// rule: MODE-2
// expect: accept
// A borrow from map.get whose binding dies inside the match leaves the unique
// map unique at the exit. Twin is MODE-2-map-get-borrow-escapes-bad.
fn look(mut m: unique Map[String, String], k: String) -> u64 {
  match map.get(m, k) {
    Some(v) => string.byte_len(v),
    None() => 0,
  }
}
