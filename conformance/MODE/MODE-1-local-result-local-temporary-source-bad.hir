// rule: MODE-1
// expect: reject MODE-1 at line 11
// A copy of a local value is a new value in a temporary of this function, and
// its content is bounded by that temporary, so a result viewing it cannot be
// returned. Only an arena value's copy keeps just its arena bound (v22 P2).
fn view(x: Bytes) -> Bytes in x {
  copy x
}

fn relay(y: Bytes, take x: Bytes in y) -> Bytes in {x, y} {
  view(copy x)
}
