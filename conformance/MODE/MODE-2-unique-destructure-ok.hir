// rule: MODE-2
// expect: accept
// "A value is unique or aliased."
// Taking a part from a deep-unique record retains unique receiving evidence.
// The physical pattern still has the field's declared type.
type Rec {
  items: Bytes,
  n: u64,
}

fn example(take r: unique Rec) -> Bytes {
  let Rec(items: items, ..) = take r
  take items
}

fn count(take r: unique Rec) -> u64 {
  match take r {
    Rec(items: items, n: n) => n,
  }
}
