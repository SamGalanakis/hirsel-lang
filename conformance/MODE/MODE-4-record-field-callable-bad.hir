// rule: MODE-4
// expect: reject MODE-4 at line 11
// twin: MODE/MODE-4-record-field-callable-run.hir
// A record field declared `sendable fn` holds only a function value that
// may cross tasks.
type Job {
  run: sendable fn() -> u64,
}

fn probe(take f: fn() -> u64) -> u64 {
  let job = Job(run: f)
  job.run()
}
