// rule: MODE-1
// expect: accept
// Lending from the parameter itself, also through a binding that only holds
// the lent view, names storage of the caller.
fn view(x: Bytes) -> Bytes in x {
  copy x
}

fn direct(x: Bytes) -> Bytes in x {
  view(x)
}

fn held(x: Bytes) -> Bytes in x {
  let v = view(x)
  v
}
