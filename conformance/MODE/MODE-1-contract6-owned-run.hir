// rule: MODE-1
// expect: run
// stdout: owned
@loop_source(open, next)
type View {
  source: String,
}

type Cursor {
  source: String,
  position: u64,
}

@noalloc
fn view(s: String) -> View in s {
  View(source: copy s)
}

@noalloc
fn open(v: View) -> Cursor in v {
  Cursor(source: copy v.source, position: 0)
}

fn next(mut it: Cursor) -> Option[String] {
  if it.position == 0 {
    it.position = 1
    Some("owned")
  } else {
    None
  }
}

fn first(s: String) -> String {
  let mut out: String in s = ""
  for piece in view(s) {
    out = copy piece
  }
  out
}

pub fn main(rt: Io, args: Args) -> Result[(), GrantError] {
  let _ = out.print(io.stdout(rt)?, first("a"))
  let _ = out.print(io.stdout(rt)?, "\n")
  Ok(())
}
