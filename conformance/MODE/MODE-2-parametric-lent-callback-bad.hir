// rule: MODE-2
// expect: reject MODE-2 at line 12
// A callback lent a U value under authority could keep a copy beyond the call,
// so tap's result is not counted unique. Twin is MODE-2-parametric-lent-callback-ok.
fn tap[U](take u: U, f: fn(view: U) -> ()) -> U uses {f} {
  f(u)
  take u
}

pub fn main(rt: Io, args: Args) -> Result[(), GrantError] {
  let fresh: unique Bytes = core@1/bytes.from_list([1u8])
  let b: unique Bytes = tap(
    take fresh,
    fn(v: Bytes) uses {} {
      let _ = core@1/bytes.len(v)
    }
  )
  Ok(())
}
