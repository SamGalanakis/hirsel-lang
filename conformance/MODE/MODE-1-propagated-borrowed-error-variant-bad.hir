// A variant mapper wraps the borrowed error without releasing its bound.
type Failure = Bad(String)

fn split(data: Bytes) -> Result[Bytes, String] in data {
  Ok(data)
}

fn decode(data: Bytes) -> Result[(), Failure] {
  let _ = split(data) ? Bad
  Ok(())
}
