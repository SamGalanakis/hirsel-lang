// rule: MODE-1
// expect: reject MODE-1 at line 15
// spec: #89
// The source of `for r in xs` may only be read in the body (SEM-4). Each
// advance reads it, so the loop keeps it lent while it may advance again,
// even when the body never uses `r` (SEM-4).
type R {
  name: String,
  n: u64,
}

fn probe() -> u64 {
  let mut xs: List[R] = [R(name: "ab", n: 1)]
  for r in xs {
    xs[0].n = 5
  }
  0
}
