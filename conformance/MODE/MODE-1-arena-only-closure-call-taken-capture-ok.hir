// rule: MODE-1
// expect: accept
// Twin of the taken-capture reject. A named closure's environment is named
// storage, as `let m = z` is, so its call result is arena-only and holds a read
// loan on the capture. A literal's result kept by a let only needs to stay in
// this frame, which bounds it, and so does a moved one.
fn mk(a: Arena) -> Bytes in a {
  b"x"
}

fn choose(a: Arena, x: Bytes in a, y: Bytes) -> Bytes in {a, x} {
  x
}

fn id(a: Arena, x: Bytes in a) -> Bytes in {a, x} {
  x
}

fn named(a: Arena, y: Bytes, take z: Bytes in a) -> Bytes in a {
  let g = fn() {
    z
  }
  choose(a, g(), y)
}

fn kept(a: Arena, take z: Bytes in a) -> u64 {
  let r = id(
    a,
    fn() {
      z
    }()
  )
  1u64
}

fn moved(a: Arena, take z: Bytes in a) -> u64 {
  let r = id(
    a,
    take fn() {
      z
    }()
  )
  1u64
}
