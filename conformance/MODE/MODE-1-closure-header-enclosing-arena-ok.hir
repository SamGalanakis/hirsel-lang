// rule: MODE-1
// expect: accept
fn outer(a: Arena) {
  let f = fn(x: Bytes in a) {}
}

fn id(a: Arena, x: Bytes in a) -> Bytes in {a, x} {
  x
}

fn moved(a: Arena, take z: Bytes in a) -> u64 {
  let r = id(
    a,
    take fn() {
      fn(agree_x: Bytes in a) {
        agree_x
      }(z)
    }()
  )
  1u64
}

fn header_capture(a: Arena) {
  let f = fn(x: Bytes in a) {
    fn() {
      x
    }()
  }
}
