// rule: MODE-2
// expect: accept
fn check(mut m: unique Map[u64, String], mut s: unique Set[u64]) -> () {
  let _ = map.remove(mut m, 1)
  let _ = set.remove(mut s, 1)
}

fn fresh() -> () {
  let mut a: unique Map[u64, String] = map.empty()
  let mut b: unique Map[u64, String] = map.empty()
  let mut x: unique Set[u64] = set.empty()
  let mut y: unique Set[u64] = set.empty()
  check(mut a, mut x)
  check(mut b, mut y)
}
