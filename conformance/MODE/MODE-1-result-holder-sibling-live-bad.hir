// rule: MODE-1
// expect: accept
type Pair {
  left: Bytes,
  right: Bytes,
}

type Nest {
  pair: Pair,
  other: Bytes,
}

type Bucket {
  items: List[Bytes],
  other: Bytes,
}

fn view(x: Bytes) -> Bytes in x {
  copy x
}

fn bump(mut x: Bytes) {
  ()
}

fn probe(mut x: Bytes, mut y: Bytes, c: bool) {
  let mut slot = Pair(left: view(x), right: view(y))
  slot.left = b"fresh"
  bump(mut y)
  ()
}
// v22 R2 (§04, LANG-3): a loan lasts until its holder's last use. The holder
// is dead at the conflicting action, so this v21 reject is accepted; the
// holder-used twin is MODE-1-result-holder-sibling-live-used-bad.hir.
