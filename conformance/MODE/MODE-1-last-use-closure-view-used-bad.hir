// The closure capturing the view is called after the `mut` (MODE-5, §04).
fn look(x: Bytes) -> u64 {
  0
}

fn view(x: Bytes) -> Bytes in x {
  copy x
}

fn bump(mut x: Bytes) {
  ()
}

fn probe(mut b: Bytes) -> u64 {
  let v = view(b)
