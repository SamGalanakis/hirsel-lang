// rule: MODE-2
// expect: reject MODE-2 at line 18
// twin: MODE/MODE-2-map-insert-taken-key-unique-ok.hir
// A taken key that `kept` still shares aliases the entries, so the Store root is
// aliased after map.insert. Twin is MODE-2-map-insert-taken-key-unique-ok.
type Store {
  version: u64,
  entries: Map[String, String],
}

fn bump(mut st: unique Store) -> u64 uses {} {
  st.version
}

fn write(mut st: unique Store, take key: String) -> u64 uses {} {
  let kept = copy key
  map.insert(mut st.entries, take key, unique "v")
  bump(mut st)
}
