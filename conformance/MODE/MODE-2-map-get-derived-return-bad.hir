// rule: MODE-2
// expect: reject MODE-2 at line 11
// The returned pair holds the map.get result next to the unrelated `other`, so
// the map's share outlives the call. Twin is
// MODE-2-map-get-unrelated-return-ok.
fn look(mut m: unique Map[String, String], k: String, take other: String) -> (
  String,
  Option[String]
) in m {
  (other, map.get(m, k))
}
