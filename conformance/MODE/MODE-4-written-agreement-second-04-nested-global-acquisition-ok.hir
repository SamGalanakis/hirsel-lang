// rule: MODE-4
// expect: accept
// Regression from the unrestricted written-sendability agreement campaign.
type R {
  xs: unique List[Bytes],
}

fn probe(take r: R) {
  let built = box unique fn() {
    {
      fn(agree_x: R) {
        agree_x
      }(r)
    }.xs
  }()
  let frozen = shared.freeze(take built)
}
