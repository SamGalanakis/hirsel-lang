// rule: MODE-1
// expect: reject MODE-1 at line 17
// OWN-1 makes a flat copy of a borrowed part local to its owner, and a block
// naming the owner reads the part through the same borrow (spec issue #50).
flat type F {
  text: String,
}

type R {
  part: unique F,
}

fn probe(r: R) {
  let built = box {
    r
  }.part
  let frozen = shared.freeze(take built)
}
