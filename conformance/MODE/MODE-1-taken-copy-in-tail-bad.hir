// rule: MODE-1
// expect: reject MODE-1 at line 10
// Twin of the accept. A result that omits the taken parameter z cannot keep a
// copy of z's storage from a block tail past the frame, as `copy z` cannot (P2).
fn id(a: Arena, x: Bytes in a) -> Bytes in {a, x} {
  x
}

fn escaped(a: Arena, take z: Bytes in a) -> Bytes in a {
  id(
    a,
    unique copy {
      z
    }
  )
}
