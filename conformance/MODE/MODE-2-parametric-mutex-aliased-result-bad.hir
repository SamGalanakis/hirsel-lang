// rule: MODE-2
// expect: reject MODE-2 at line 20
// The body's result is declared aliased, so mutex.with's R result is aliased
// and the binding cannot receive it unique. Twin is
// MODE-2-parametric-mutex-result-run.
pub type Store {
  version: u64,
  name: String,
}

pub type Snapshot {
  version: u64,
  text: String,
}

pub fn main(rt: Io) -> Result[(), GrantError] {
  let tasks = io.tasks(rt)?
  let store: unique Store = Store(version: 0u64, name: unique "kv")
  let state = mutex.create(tasks, take store)
  let snapshot: unique Snapshot = mutex.with(
    tasks,
    state,
    fn(mut st: unique Store) -> Snapshot uses {} {
      st.version += 1u64
      Snapshot(version: st.version, text: unique st.name)
    }
  )
  Ok(())
}
