// rule: MODE-2
// expect: reject LANG-7 at line 8
// twin: MODE/MODE-2-tuple-compare-equal-run.hir
// SEM-5: ordering operators stay limited to scalar and byte operands.
// Replacing == by < must still reject a tuple, including borrowed fields.
fn earlier(pair: (u64, List[u64]), take expected: List[(u64, List[u64])]) -> bool {
  let (k, v) = pair
  (k, v) < expected[0]
}
