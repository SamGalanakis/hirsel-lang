// rule: MODE-1
// expect: reject MODE-1 at line 12
// twin: MODE/MODE-1-field-path-result-other-field-ok.hir
// v22 #77. A result related to p.a must stay within p.a, so it cannot read
// p.b, directly or through a binding.
type Pair {
  a: Bytes,
  b: Bytes,
}

fn get(p: Pair) -> Bytes in p.a {
  p.b
}
