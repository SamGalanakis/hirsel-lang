// rule: MODE-1
// expect: run
// stdout: kept
fn view(x: Bytes) -> Bytes in x {
  copy x
}

fn probe(x: Bytes, y: Bytes) -> Bytes in {x, y} {
  let mut slot = view(x)
  let mut n: u32 = 0u32
  while n < 3u32 {
    slot = view(y)
    n += 1u32
  }
  slot
}

pub fn main(rt: Io, args: Args) -> Result[(), GrantError] {
  let x: Bytes = b"first"
  let y: Bytes = b"second"
  let got = probe(x, y)
  if got == b"second" {
    let _ = out.print(io.stdout(rt)?, "kept\n")
  }
  Ok(())
}
