// rule: MODE-4
// expect: run
// stdout: ok
// A parametric result holds only the values its arguments supply, so `id`
// returns `xs` unique and the result can be sent. Twin is
// MODE-4-parametric-result-send-bad.
fn id[T](take value: T) -> T {
  value
}

fn send[T: sendable](take value: T) -> T {
  value
}

fn pass(take xs: unique List[u64]) -> List[u64] {
  let ys = id(take xs)
  send(take ys)
}

pub fn main(rt: Io) -> Result[(), GrantError] {
  let ok = list.len(pass(unique [1u64, 2u64, 3u64])) == 3u64
  let _ = out.print(
    io.stdout(rt)?,
    if ok {
      "ok\n"
    } else {
      "bad\n"
    }
  )
  Ok(())
}
