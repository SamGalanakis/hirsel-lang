// rule: MODE-1
// expect: reject MODE-1 at line 15
// twin: MODE/MODE-1-fresh-local-receiver-capture-ok.hir
// On the path that skips the assignment the receiver still holds the local
// view, so the closure cannot hand out a global value.
fn view(x: Bytes) -> Bytes in x {
  copy x
}

fn called(x: Bytes, fresh: bool) -> Bytes {
  let mut slot = view(x)
  if fresh {
    slot = b"new"
  }
  fn() {
    copy slot
  }()
}
