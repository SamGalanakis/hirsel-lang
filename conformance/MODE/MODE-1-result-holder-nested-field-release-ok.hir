// rule: MODE-1
// expect: accept
type Pair {
  left: Bytes,
  right: Bytes,
}

type Nest {
  pair: Pair,
  other: Bytes,
}

type Bucket {
  items: List[Bytes],
  other: Bytes,
}

fn view(x: Bytes) -> Bytes in x {
  copy x
}

fn bump(mut x: Bytes) {
  ()
}

fn probe(mut x: Bytes, mut y: Bytes, c: bool) {
  let mut slot = Nest(pair: Pair(left: view(x), right: view(y)), other: b"other")
  slot.pair.left = b"fresh"
  bump(mut x)
  slot.pair.right = b"new"
  bump(mut y)
  ()
}
