// rule: MODE-4
// expect: run
// stdout: ok
// A `let mut` binding written `sendable fn` keeps that promise after a
// write, so it may be handed to a parameter that asks no more of it, or to
// one that requires it (the agreement campaign's `annotation/mode` edit
// writes `sendable` on the parameter).
fn call(take g: fn() -> u64) -> u64 {
  g()
}

fn probe(take q: sendable fn() -> u64) -> u64 {
  let mut f: sendable fn() -> u64 = fn() {
    1
  }
  f = q
  call(take f)
}

fn seven() -> u64 {
  7
}

pub fn main(rt: Io, args: Args) -> Result[(), GrantError] {
  let _ = out.print(
    io.stdout(rt)?,
    if probe(take seven) == 7 {
      "ok\n"
    } else {
      "bad\n"
    }
  )
  Ok(())
}
