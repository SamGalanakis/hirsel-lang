// rule: MODE-1
// expect: reject MODE-1 at line 24
// On the early-return path the holder is dropped after the `mut`, a use on that path (§04).
resource type Guard {
  data: Bytes,
}
drop(g) {}

fn guard(x: Bytes) -> Guard in x {
  Guard(data: copy x)
}

fn close(take g: Guard in g) {
  ()
}

fn bump(mut x: Bytes) {
  ()
}

fn probe(mut b: Bytes, c: bool) {
  let g = guard(b)
  if c {
    bump(mut b)
    return ()
  }
  close(take g)
  ()
}
