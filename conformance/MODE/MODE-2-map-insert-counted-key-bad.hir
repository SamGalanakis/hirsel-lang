// map.insert stores a share of its borrowed String key, so the map is aliased
// after it. Twin is MODE-2-map-insert-plain-key-ok.
fn need(mut m: unique Map[String, u64]) -> () {}

fn root(mut m: unique Map[String, u64], k: String) -> () {
  map.insert(mut m, k, 2)
  need(mut m)
}
