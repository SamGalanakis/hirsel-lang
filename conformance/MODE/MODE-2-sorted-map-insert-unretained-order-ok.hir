// rule: MODE-2
// expect: accept
// sorted_map.insert reads its borrowed `by` and stores nothing of it, so the
// ledger marks it unretained and a unique map stays unique. Twin is
// MODE-2-sorted-map-insert-counted-key-bad.
fn need(by: Order[u64], mut m: unique SortedMap[u64, u64] of by) -> () {}

fn f(by: Order[u64], mut m: unique SortedMap[u64, u64] of by) -> () {
  sorted_map.insert(by, mut m, 1, 2)
  need(by, mut m)
}
