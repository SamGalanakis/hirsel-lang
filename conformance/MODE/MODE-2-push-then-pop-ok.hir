// rule: MODE-2
// expect: accept
// A push keeps a unique list unique, so a later pop needs no copy: for a local
// literal, an annotated binding, a list returned unique and a list built by
// a loop of pushes. Twins are MODE-2-push-then-pop-aliased-bad and
// MODE-2-push-loop-aliased-bad.
fn literal() -> () {
  let mut xs: List[u32] = [1u32]
  list.push(mut xs, 2u32)
  let _ = list.pop(mut xs)
}

fn make() -> unique List[u32] {
  [1u32]
}

fn returned() -> () {
  let mut xs = make()
  list.push(mut xs, 2u32)
  let _ = list.pop(mut xs)
}

fn annotated() -> () {
  let mut xs: unique List[u32] = make()
  list.push(mut xs, 2u32)
  let _ = list.pop(mut xs)
}

fn looped() -> Result[unique List[u64], ()] {
  let mut xs: unique List[u64] = []
  for i in 0u64..3u64 {
    list.push(mut xs, i)
  }
  Ok(take xs)
}
