// rule: MODE-2
// expect: accept
fn probe(by: Order[u32], mut m: unique SortedMap[u32, String] of by, take value: String) -> () uses {} {
  let kept = copy value
  let restored = unique value
  sorted_map.insert(by, mut m, 1, take restored)
  let _ = sorted_map.remove(by, mut m, 1)
  let _ = string.byte_len(kept)
}
