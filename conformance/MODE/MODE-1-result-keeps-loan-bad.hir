// rule: MODE-1
// expect: reject MODE-1 at line 15
// twin: MODE/MODE-1-result-keeps-loan-ok.hir
// "While a local(x) result lives, its caller treats x as borrowed."
fn get(x: Bytes) -> Bytes in x {
  x
}

fn change(mut x: Bytes) -> () {
  x = b"new"
}

fn example(mut x: Bytes) -> Bytes in x {
  let part = get(x)
  change(mut x)
  part
}
