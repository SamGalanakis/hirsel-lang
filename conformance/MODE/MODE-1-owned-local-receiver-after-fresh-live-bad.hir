// rule: MODE-1
// expect: accept
fn view(x: Bytes) -> Bytes in x {
  copy x
}

fn bump(mut x: Bytes) {
  ()
}

fn probe(mut x: Bytes, mut y: Bytes) {
  let mut slot = view(x)
  slot = b"fresh"
  bump(mut x)
  slot = view(y)
  // The new view still borrows y.
  bump(mut y)
  ()
}
// LANG-3: a loan lasts until its holder's last use. The holder
// is dead at the conflicting action, so this v21 reject is accepted; the
// holder-used twin is MODE-1-owned-local-receiver-after-fresh-live-used-bad.hir.
