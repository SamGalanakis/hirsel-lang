// rule: CT-5
// expect: reject LANG-7 at line 1
// "The literal's type must equal `F`, or LANG-7 at its header": line 1 of the generated text.
type Point {
  x: u64,
  y: u64,
}

fn wrong_literal() -> Result[Body[fn(Point) -> u64 uses {}], String] {
  Ok(codegen.body("fn(x: u64) -> u64 uses {} { x }"))
}

fn sum(p: Point) -> u64 uses {} = comptime wrong_literal()
