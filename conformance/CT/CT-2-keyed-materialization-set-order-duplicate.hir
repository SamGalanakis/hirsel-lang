// rule: CT-2
// expect: run
// stdout: 21
fn build_set(reverse: bool) -> Set[u64] {
  let mut s: Set[u64] = set.empty()
  if reverse {
    set.insert(mut s, 1)
    set.insert(mut s, 2)
  } else {
    set.insert(mut s, 2)
    set.insert(mut s, 1)
  }
  set.insert(mut s, 2)
  take s
}

const S: Set[u64] = build_set(false)

pub fn main(rt: Io, args: Args) -> Result[(), GrantError] {
  for n in S {
    let _ = out.print(io.stdout(rt)?, u64.to_string(n))
  }
  let _ = out.print(io.stdout(rt)?, "\n")
  Ok(())
}
