// rule: CT-2
// expect: run
// stdout: ok
const M: Map[u64, u64] = map.empty()

const S: Set[u64] = set.empty()

pub fn main(rt: Io, args: Args) -> Result[(), GrantError] {
  for (k, v) in M {
    let _ = out.print(io.stdout(rt)?, "bad")
  }
  for n in S {
    let _ = out.print(io.stdout(rt)?, "bad")
  }
  let _ = out.print(io.stdout(rt)?, "ok\n")
  Ok(())
}
