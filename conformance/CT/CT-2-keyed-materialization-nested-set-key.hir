// rule: CT-2
// expect: run
// stdout: 2120
fn build_set(reverse: bool) -> Set[u64] {
  let mut s: Set[u64] = set.empty()
  if reverse {
    set.insert(mut s, 1)
    set.insert(mut s, 2)
  } else {
    set.insert(mut s, 2)
    set.insert(mut s, 1)
  }
  set.insert(mut s, 2)
  take s
}

fn build() -> Map[Set[u64], u64] {
  let mut m: Map[Set[u64], u64] = map.empty()
  map.insert(mut m, build_set(false), 10)
  map.insert(mut m, build_set(true), 20)
  take m
}

const M: Map[Set[u64], u64] = build()

pub fn main(rt: Io, args: Args) -> Result[(), GrantError] {
  for (k, v) in M {
    for n in k {
      let _ = out.print(io.stdout(rt)?, u64.to_string(n))
    }
    let _ = out.print(io.stdout(rt)?, u64.to_string(v))
  }
  let _ = out.print(io.stdout(rt)?, "\n")
  Ok(())
}
