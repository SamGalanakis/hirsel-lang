// rule: CT-5
// expect: reject CT-1 at line 7
// A deriver takes its type by value and nothing lends a `box T` payload as a `T`
// (MEM-7), so a boxed field has no JSON form.
type Chain = End | Link(u64, box Chain)

fn chain_to_json(c: Chain) -> json.Value uses {} = comptime derive.json_value(
  shape(Chain)
)
