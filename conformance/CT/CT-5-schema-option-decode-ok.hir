// rule: CT-5
// expect: accept
// Nested Option must never collapse through null in either direction.
type Nested {
  value: Option[u8],
}

fn convert(w: json.Value, mut c: schema.CheckState) -> Result[
  unique Nested,
  schema.SchemaError
] uses {} = comptime derive.schema_decode(shape(Nested), schema.strict_policy())
