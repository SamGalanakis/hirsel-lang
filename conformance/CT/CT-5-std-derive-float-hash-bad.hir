// rule: CT-5
// expect: reject CT-1 at line 10
// Floats are not `key` (GEN-1), so derived hashing has no form for them, while derived
// text writes them.
type Sample {
  label: String,
  value: f64,
}

fn sample_hash(s: Sample, mut state: siphash.State) -> () uses {} = comptime derive.hash(
  shape(Sample)
)
