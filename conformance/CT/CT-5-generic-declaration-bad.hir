// rule: CT-5
// expect: reject CT-2 at line 12
// "a generic declaration is CT-2 at `e` (generic shape inputs are reserved)".
type Count {
  n: u64,
}

fn count_body[T](s: TypeShape[T]) -> Result[Body[fn(T) -> u64 uses {}], String] {
  Ok(codegen.body("fn(c: standalone@0/Count) -> u64 uses {} { c.n }"))
}

fn count[T](c: T) -> u64 uses {} = comptime count_body(shape(T))
