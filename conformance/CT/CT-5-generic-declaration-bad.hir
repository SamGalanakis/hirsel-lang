// rule: CT-5
// expect: reject GEN-3 at line 13
// twin: CT/CT-5-std-derive-run.hir
// A generic generated declaration evaluates per selected instance: count[u64] reads shape(u64), and a scalar has no shape.
type Count {
  n: u64,
}

fn count_body[T](s: TypeShape[T]) -> Result[Body[fn(T) -> u64 uses {}], String] {
  Ok(codegen.body("fn(c: standalone@0/Count) -> u64 uses {} { c.n }"))
}

fn count[T](c: T) -> u64 uses {} = comptime count_body(shape(T))

pub fn main() -> Result[(), ()] {
  let _ = count(5u64)
  Ok(())
}
