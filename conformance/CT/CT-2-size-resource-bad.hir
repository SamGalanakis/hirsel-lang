// rule: CT-2
// expect: reject CT-2 at line 13
// twin: CT/CT-2-size-resource-ok.hir
resource type Token {
  value: u64,
}
drop(x) {
  ()
}

fn probe[n: size](xs: Inline[u8, n]) -> Token {
  let _ = xs
  comptime Token(value: n)
}

pub fn main() -> Result[(), ()] {
  let xs: Inline[u8, 1] = [1]
  let _ = probe(xs)
  Ok(())
}
