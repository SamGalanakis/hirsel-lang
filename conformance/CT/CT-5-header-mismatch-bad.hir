// rule: CT-5
// expect: reject LANG-7 at line 13
// "a declaration with any other header is LANG-7 at `e` before evaluation".
type Point {
  x: u64,
  y: u64,
}

fn sum_body() -> Result[Body[fn(Point) -> u64 uses {}], String] {
  Ok(codegen.body("fn(p: standalone@0/Point) -> u64 uses {} { p.x + p.y }"))
}

fn sum(p: Point) -> u32 uses {} = comptime sum_body()
