// rule: CT-5
// expect: accept
// Declaring Item's deriver under its conventional name lets Order's derived body call it.
type Item {
  sku: String,
}

type Order {
  item: Item,
}

fn item_to_json(i: Item) -> json.Value uses {} = comptime derive.json_value(shape(Item))

fn order_to_json(o: Order) -> json.Value uses {} = comptime derive.json_value(
  shape(Order)
)
