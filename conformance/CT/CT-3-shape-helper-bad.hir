// rule: CT-3
// expect: reject CT-3 at line 13
// A helper body is run-time code even when only comptime calls it.
type Rec {
  n: u32,
}

fn name_of[T](s: TypeShape[T]) -> String {
  type_shape.info(s).name
}

fn rec_name() -> String {
  name_of(shape(Rec))
}

const NAME: String = comptime rec_name()
