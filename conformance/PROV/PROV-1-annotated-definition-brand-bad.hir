fn descending(a: u32, b: u32) -> i32 uses {} {
  if a > b {
    -1
  } else if a < b {
    1
  } else {
    0
  }
}

fn probe() -> u64 uses {} {
  let by = Order(compare: descending)
  let m: SortedMap[u32, u8] of u32.order = sorted_map.empty(by)
  sorted_map.len(u32.order, m)
}
