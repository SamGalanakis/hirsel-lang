// rule: PROV-4
// expect: reject PROV-4 at line 13
// The same extraction from a tuple whose string part joins arena and heap
// content.
fn probe(a: Arena, c: bool) -> (String, u8) {
  let x: String in a = "x"
  let y: String = "y"
  let p = if c {
    (x, 1u8)
  } else {
    (y, 2u8)
  }
  unique p
}
