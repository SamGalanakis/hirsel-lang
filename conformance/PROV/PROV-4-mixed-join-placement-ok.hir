// rule: PROV-4
// expect: accept
// Branches whose values live in different places join into a value whose
// placement is unknown. It is as local as every source and is usable wherever
// a borrow or an unplaced local value is.
fn len(b: Bytes) -> u64 {
  0
}

fn direct(c: bool, a: Arena) -> u64 {
  let text: Bytes in a = b"x"
  let other: Bytes = b"yy"
  len(
    if c {
      text
    } else {
      other
    }
  )
}

fn bound(c: bool, a: Arena) -> u64 {
  let text: Bytes in a = b"x"
  let other: Bytes = b"yy"
  let chosen = if c {
    text
  } else {
    other
  }
  len(chosen)
}

fn arms(c: bool, a: Arena, b: Arena) -> u64 {
  let text: Bytes in a = b"x"
  let other: Bytes in b = b"yy"
  let chosen = match c {
    true => text,
    false => other,
  }
  len(chosen)
}

fn pick(c: bool, a: Arena, b: Arena, x: Bytes in a, y: Bytes in b) -> Bytes in {x, y} {
  if c {
    x
  } else {
    y
  }
}

fn either(c: bool, a: Arena, x: Bytes in a, y: Bytes) -> Bytes in {x, y} {
  if c {
    x
  } else {
    y
  }
}

fn heap_or_literal(c: bool) -> u64 {
  let text: String = copy_to(heap, "heap")
  string.byte_len(
    if c {
      text
    } else {
      "literal"
    }
  )
}
