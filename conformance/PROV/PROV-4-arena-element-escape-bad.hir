// rule: PROV-4
// expect: reject PROV-4 at line 10
// "A relation that names an arena ... says x's blocks live in a or in
// something that outlives it." "A global requirement (a result ...) cannot
// receive arena content."
// An element of an arena-placed list lives in the arena, as the list does, so
// a result without a relation cannot keep it.
fn keep(a: Arena) -> String {
  let text: List[String] in a = ["kept"]
  copy text[0]
}
