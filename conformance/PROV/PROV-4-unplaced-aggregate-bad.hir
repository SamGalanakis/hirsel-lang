// rule: PROV-4
// expect: reject PROV-4 at line 11
// twin: PROV/PROV-4-unplaced-aggregate-ok.hir
// "Constructors are placed by the expected type". An aggregate without a
// placement cannot hold a part that lives in an arena.
type Ast {
  bytes: Bytes,
}

fn build(a: Arena, take src: Bytes in a) -> Ast {
  Ast(bytes: take src)
}
