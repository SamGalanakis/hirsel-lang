// rule: PROV-4
// expect: reject PROV-4 at line 13
// twin: PROV/PROV-4-escaping-heap-mut-parameter-capture-ok.hir
// Writing the closure into caller storage through a mut parameter lets it outlive the arena.
type H {
  f: fn() -> u64,
}

fn probe(a: Arena, mut out: H) {
  let x: String in a = "x"
  let pair = (x, 1u8)
  out = H(
    f: fn() {
      let (s, n) = pair
      string.byte_len(s)
    }
  )
}
