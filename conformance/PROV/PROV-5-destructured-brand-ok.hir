// rule: PROV-5
// expect: accept
// "Destructuring it rebrands the field to the new local bound for f."
type Log {
  dir: Dir,
  file: File of .dir,
}

fn inspect(d: Dir, value: File of d) -> () {
  ()
}

fn example(take log: Log, other: Dir) -> () {
  let Log(dir: d, file: value) = take log
  inspect(d, value)
}
