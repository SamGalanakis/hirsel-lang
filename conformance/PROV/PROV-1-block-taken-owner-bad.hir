// rule: PROV-1
// expect: reject PROV-1 at line 21
// A block is transparent to its consumer (#50). Taking a value through a
// block consumes its identity as a bare take does, and a brand on the old
// owner does not describe the new binding (issue #74).
type R {
  n: u64,
}

fn make(r: R) -> Option[u8 of r] {
  None
}

fn inspect(r: R, p: Option[u8 of r]) {}

fn probe(take x: R) {
  let q = make(x)
  let s = {
    take x
  }
  inspect(s, q)
}
