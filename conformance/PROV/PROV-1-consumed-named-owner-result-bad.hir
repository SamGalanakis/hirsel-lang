// rule: PROV-1
// expect: reject PROV-1 at line 16
// spec: #60
// "A brand ends when p is ... moved." The written take moves the named owner
// into the call, so the result it brands has no owner when the call returns.
fn mk(d: List[u64]) -> Option[u8 of d] {
  None
}

fn fresh() -> List[u64] {
  []
}

fn probe() -> () {
  let owner = fresh()
  let value = mk(take owner)
}
