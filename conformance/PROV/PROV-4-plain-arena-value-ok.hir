// rule: PROV-4
// expect: accept
// A plain value is copied bytes, so the arena it was placed in does not bound
// it, alone or in a plain tuple.
fn scalar(a: Arena) -> u64 {
  let x: u64 in a = 3
  x
}

fn grouped(a: Arena) -> u64 {
  let x: u64 in a = 3
  x
}

fn pair(a: Arena) -> (u64, u8) {
  let x: (u64, u8) in a = (3, 1u8)
  x
}
