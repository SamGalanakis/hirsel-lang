// rule: PROV-1
// expect: run
// entry: test_narrow
pub fn test_narrow(t: Test) -> Result[(), FileError] {
  let p = path.of("sub/value")
  let dir = test.dir(t, [(p, b"data")])
  let fresh = file.open(dir, p)?
  let sub = dir.narrow(dir, path.of("sub"))?
  test.check(
    t,
    match file.narrow(sub, take fresh) {
      Some(g) => true,
      None => false,
    }
  )
  Ok(())
}
