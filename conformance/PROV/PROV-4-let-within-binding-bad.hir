// rule: PROV-4
// expect: reject PROV-4 at line 8
// v22 R3. A let relation naming a binding is within it, so the value may
// hold only loans the binding holds. z holds none, so y, placed in b, is
// not within z.
fn bad(b: Arena, y: Bytes in b) -> u64 {
  let z: Bytes = b"global"
  let v: Bytes in z = y
  0
}
