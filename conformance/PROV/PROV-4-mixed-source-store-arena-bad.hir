// rule: PROV-4
// expect: accept
// v22 R3. One relation is a union of places, and naming selected admits what
// selected holds, so the loan on b is inside the relation. The v22 pin for an
// escaping arena is PROV-4-union-arena-outside-binding-bad.
type View {
  bytes: Bytes,
}

fn choose(a: Arena, b: Arena, x: Bytes in a, y: Bytes in b) -> Bytes in {x, y} {
  x
}

fn bad(a: Arena, b: Arena, x: Bytes in a, y: Bytes in b) {
  let selected = choose(a, b, x, y)
  let _: View in {a, selected} = View(bytes: selected)
}
