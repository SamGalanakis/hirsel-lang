// rule: PROV-1
// expect: accept
// A block is transparent to its consumer (#50). A binding initialised from a
// block that takes a value is a new owner, exactly as with a bare take, and
// brands name that binding (issue #74).
type R {
  n: u64,
}

fn make(r: R) -> Option[u8 of r] {
  None
}

fn inspect(r: R, p: Option[u8 of r]) {}

fn probe(take x: R) {
  let s = {
    take x
  }
  let q = make(s)
  inspect(s, q)
}

fn nested(take x: R) {
  let s = {
    let _u = 0u8
    {
      take x
    }
  }
  let q = make(s)
  inspect(s, q)
}

fn argument(take x: R) {
  let q = make(
    {
      take x
    }
  )
}
