// rule: PROV-2
// expect: reject PROV-2 at line 12
// twin: PROV/PROV-2-join-unbranded-ok.hir
// "A value whose brand is a union is a type error at its first branded use."
// One path gives an unbranded file, so the joined value has no identity to
// offer a branded parameter.
fn need(d: Dir, f: File of d) -> () {
  ()
}

fn example(a: Dir, take fa: File of a, take fb: File, pick: bool) -> () {
  need(
    a,
    if pick {
      take fa
    } else {
      take fb
    }
  )
}
