// rule: PROV-1
// expect: accept
fn inspect(d: Dir, h: AtomicFile of d) {}

fn probe(rt: Io) -> Result[(), FileError] {
  let d = io.dir(rt, path.of("."))?
  let opened = file.create_atomic(d, path.of("a.txt"))
  let _ = match take opened {
    Ok(h) => inspect(d, h),
    Error(e) => (),
  }
  Ok(())
}
