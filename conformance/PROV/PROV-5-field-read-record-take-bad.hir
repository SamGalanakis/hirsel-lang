// rule: PROV-5
// expect: reject PROV-1 at line 23
// twin: PROV/PROV-5-field-read-record-take-run.hir
// "Moving the record keeps the relation" holds inside the record only. A
// position copied out of the field is branded by `c.text`, and the written
// take of `c` ends that owner.
resource type Cursor {
  text: String,
  pos: StrPos of .text,
}

fn offset(take c: Cursor) -> u64 {
  string.byte_offset(c.text, c.pos)
}

pub fn main(t: Test) -> Result[(), ()] {
  let text: String = "ab"
  match string.position(text, 1u64) {
    Some(pos) => {
      let c = Cursor(text: text, pos: pos)
      let copied = c.pos
      test.check(t, offset(take c) == 1u64)
      test.check(t, copied == copied)
    },
    None => test.check(t, false),
  }
  Ok(())
}
