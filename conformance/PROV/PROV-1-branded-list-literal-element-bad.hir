// rule: PROV-1
// expect: reject PROV-1 at line 7
// twin: PROV/PROV-1-branded-list-literal-element-ok.hir
// Each element of a literal is kept against the expected element brand, so a
// position of `other` cannot be listed as a position of `text`.
fn single(text: String, other: String, q: StrPos of other) -> u64 {
  let positions: List[StrPos of text] = [q]
  list.len(positions)
}
