// rule: PROV-1
// expect: accept
// "Replacing ... the container ends [its brand]."
fn inspect(s: Slots[u64], id: SlotId[u64] of s) -> () {
  let _ = slots.get(s, id)
}

fn example(mut s: Slots[u64], take replacement: Slots[u64]) -> () {
  let item: u64 = 1
  let id = slots.insert(mut s, take item)
  inspect(s, id)
  s = take replacement
}
