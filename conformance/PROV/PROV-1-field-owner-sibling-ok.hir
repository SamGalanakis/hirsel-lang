// rule: PROV-1
// expect: accept
type Rec {
  n: u64,
  name: String,
}

fn make(r: Rec) -> Option[u8 of r.name] {
  None
}

fn inspect(r: Rec, p: Option[u8 of r.name]) -> () {
  ()
}

fn bump(mut n: u64) -> () {
  n = 3u64
}

fn probe(take r0: Rec) -> () {
  let mut r = r0
  let p = make(r)
  bump(mut r.n)
  inspect(r, p)
}
