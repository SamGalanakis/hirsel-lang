// rule: PROV-4
// expect: accept
// A binding inferred from a construction over arena content lives in that
// arena and may be returned where the arena is named (#79).
type Ast {
  s: String,
}

fn f(a: Arena) -> Ast in a {
  let x: String in a = "x"
  let held = Ast(s: x)
  let n: u64 = 1
  held
}
