// rule: PROV-5
// expect: run
// "Moving the record keeps the relation." Reading the branded field through
// a name does not tie it to that name. After the written take ends the name,
// the moved record still pairs its position with its own text, and
// destructuring rebrands the position to the new local.
resource type Cursor {
  text: String,
  pos: StrPos of .text,
}

fn offset(take c: Cursor) -> u64 {
  let _ = c.pos
  let Cursor(text: text, pos: pos) = take c
  string.byte_offset(text, pos)
}

pub fn main(t: Test) -> Result[(), ()] {
  let text: String = "ab"
  match string.position(text, 1u64) {
    Some(pos) => {
      let c = Cursor(text: text, pos: pos)
      test.check(t, string.byte_offset(c.text, c.pos) == 1u64)
      test.check(t, offset(take c) == 1u64)
    },
    None => test.check(t, false),
  }
  Ok(())
}
