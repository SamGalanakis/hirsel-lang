// rule: PROV-4
// expect: reject PROV-4 at line 13
// twin: PROV/PROV-4-mixed-join-result-ok.hir
// A join that lost an arena placement is as local as every source. The taken
// arena value lends from nothing the result names, so the join ends with the
// function and cannot be its result.
fn pick(c: bool, a: Arena, take x: Bytes in a, y: Bytes) -> Bytes in y {
  let chosen = if c {
    x
  } else {
    copy y
  }
  chosen
}
