// rule: PROV-1
// expect: reject PROV-1 at line 18
// twin: PROV/PROV-1-ended-owner-use-ok.hir
// spec: #60
// "A brand ends when p ... leaves scope." Whole transfer carries the expiry;
// matching the transferred value reads it. The owner here is a temporary.
fn mk(d: List[u64]) -> Option[u8 of d] {
  None
}

fn fresh() -> List[u64] {
  []
}

fn probe() -> () {
  let value = mk(fresh())
  let other = take value
  match other {
    Some(x) => (),
    None => (),
  }
}
