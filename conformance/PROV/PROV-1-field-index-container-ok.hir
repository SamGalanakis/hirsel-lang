// rule: PROV-1
// expect: accept
type R {
  xs: List[u64],
  other: u64,
}

fn make(r: R) -> Option[u8 of r] {
  None
}

fn inspect(r: R, p: Option[u8 of r]) -> () {
  ()
}

fn probe(take r0: R) -> () {
  let mut r = r0
  let p = make(r)
  r.xs[0] = 3u64
  let fresh = make(r)
  inspect(r, fresh)
}
