// rule: PROV-1
// expect: reject PROV-1 at line 21
// twin: PROV/PROV-1-alias-branch-if-exit-ok.hir
// Section 23 selects the branded use when evidence from a continuing mutation is rejected at the branded use.
type R {
  n: u64,
}

fn make(r: R) -> Option[u8 of r] {
  None
}

fn inspect(r: R, p: Option[u8 of r]) -> () {}

fn probe(take x: R, take z: R, c: bool) {
  let mut r = copy x
  let p = make(r)
  if c {
    r = copy z
  }
  inspect(r, p)
}
