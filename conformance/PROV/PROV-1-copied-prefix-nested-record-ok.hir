// rule: PROV-1
// expect: accept
type Inner {
  n: u64,
  other: u64,
}

type R {
  a: Inner,
  b: u64,
}

fn make(r: R) -> Option[u8 of r.a.other] {
  None
}

fn inspect(r: R, p: Option[u8 of r.a.other]) {}

fn probe(take x: R) {
  let mut r = copy x
  r.a.n = 3
  let q = make(r)
  inspect(r, q)
}
