// rule: PROV-5
// expect: accept
// "A field named by a sibling’s brand is neither ... passed mut except together with the whole record."
type Log {
  dir: Dir,
  file: File of .dir,
}

fn change(mut d: Dir) -> () {
  ()
}

fn example(mut value: Log) -> () {
  let mut copied = value.dir
  change(mut copied)
}
