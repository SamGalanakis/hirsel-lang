// rule: PROV-2
// expect: run
// stdout: some
// stdout: none
// stdout: some
pub fn main(rt: Io, args: Args) -> Result[(), LaunchError] {
  let dir = io.dir(rt, path.of(".")) ? Files
  let p = path.of("hirsel-prov-current.txt")
  file.write_bytes(dir, p, b"data") ? Files
  let f = file.open(dir, p) ? Files
  let mut pending = file.create_atomic(dir, p) ? Files
  file.write_all(dir, mut pending, b"data") ? Files
  let transferred = match file.narrow(dir, take f) {
    Some(g) => {
      out.print(io.stdout(rt) ? Grant, "some\n") ? Output
      g
    },
    None => {
      out.print(io.stdout(rt) ? Grant, "none\n") ? Output
      file.open(dir, p) ? Files
    },
  }
  file.commit(dir, take pending) ? Files
  match file.narrow(dir, take transferred) {
    Some(g) => out.print(io.stdout(rt) ? Grant, "some\n") ? Output,
    None => out.print(io.stdout(rt) ? Grant, "none\n") ? Output,
  }
  let fresh = file.open(dir, p) ? Files
  match file.narrow(dir, take fresh) {
    Some(g) => out.print(io.stdout(rt) ? Grant, "some\n") ? Output,
    None => out.print(io.stdout(rt) ? Grant, "none\n") ? Output,
  }
  Ok(())
}

pub type LaunchError = Grant(GrantError) | Output(OutputError) | Usage(ArgError) | Files(
  FileError
)
