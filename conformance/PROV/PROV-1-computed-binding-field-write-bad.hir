// Writing the field again ends the brand that named it.
type R {
  n: u64,
  other: u64,
}

fn id(x: R) -> R {
  copy x
}

fn make_n(r: R) -> Option[u8 of r.n] {
  None
}

fn inspect_n(r: R, p: Option[u8 of r.n]) -> () {}

fn probe(x: R) -> () {
  let mut r = id(x)
  r.n = 3
  let q = make_n(r)
  r.n = 4
  inspect_n(r, q)
}
