// rule: PROV-1
// expect: reject PROV-1 at line 26
// twin: PROV/PROV-1-written-field-taken-owner-ok.hir
// A field written after a computed value is named by the binding, and taking
// the binding ends that name too, so a value branded by the field no longer
// belongs to it.
type R {
  n: u64,
  other: u64,
}

fn id(x: R) -> R {
  copy x
}

fn make_n(r: R) -> Option[u8 of r.n] {
  None
}

fn inspect_n(r: R, p: Option[u8 of r.n]) -> () {}

fn written(x: R) -> () {
  let mut r = id(x)
  r.n = 3
  let q = make_n(r)
  inspect_n(take r, q)
}
