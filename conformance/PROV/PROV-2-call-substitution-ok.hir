// rule: PROV-2
// expect: accept
// "At a call the checker substitutes argument names for parameter names."
fn inspect(d: Dir, value: File of d) -> () {
  ()
}

fn forward(d: Dir, value: File of d) -> () {
  inspect(d, value)
}

fn example(a: Dir, b: Dir, value: File of a) -> () {
  forward(a, value)
}
