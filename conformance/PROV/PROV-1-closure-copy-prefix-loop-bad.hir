// rule: PROV-1
// expect: reject PROV-1 at line 36
// twin: PROV/PROV-1-closure-copy-sibling-loop-ok.hir
type Inner {
  n: u64,
  other: u64,
}

type R {
  a: Inner,
  b: u64,
}

fn make(r: R) -> Option[u8 of r.a.other] {
  None
}

fn inspect(r: R, p: Option[u8 of r.a.other]) {}

fn make_i(r: Inner) -> Option[u8 of r.other] {
  None
}

fn inspect_i(r: Inner, p: Option[u8 of r.other]) {}

fn probe(take x: R, flag: bool) {
  let mut c = flag
  let mut r = copy fn() {
    x
  }()
  let p = make(r)
  while c {
    r.a = Inner(n: 3, other: 4)
    c = false
  }
  inspect(r, p)
}
