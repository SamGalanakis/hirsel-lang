// rule: PROV-4
// expect: accept
// "In explicit arena a or in something that outlives it."
fn store(a: Arena, mut dst: Bytes in a, take src: Bytes in a) -> () {
  dst = take src
}

fn example() -> () {
  arena.with(
    fn(outer: Arena) {
      arena.with(
        fn(inner: Arena) {
          let mut dst: Bytes in outer = b"outer"
          let src: Bytes in outer = b"inner"
          store(outer, mut dst, take src)
        }
      )
    }
  )
}
