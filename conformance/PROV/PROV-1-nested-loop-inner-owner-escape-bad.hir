// rule: PROV-1
// expect: reject PROV-1 at line 25
// twin: PROV/PROV-1-nested-loop-owner-ok.hir
type R {
  x: u64,
}

fn owner() -> R {
  R(x: 0)
}

fn brand(r: R) -> Option[u8 of r] {
  None
}

fn inspect(r: R, token: Option[u8 of r]) {}

fn probe() {
  let r = owner()
  let mut saved = brand(r)
  let ns: List[u64] = [0, 1]
  for n in ns {
    while true {
      let inner = owner()
      saved = brand(inner)
      break
    }
  }
  inspect(r, saved)
}

pub fn main() {}
