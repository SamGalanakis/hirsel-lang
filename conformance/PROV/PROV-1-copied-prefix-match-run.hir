// rule: PROV-1
// expect: run
// stdout: ok
type R {
  n: u64,
  other: u64,
}

fn make(r: R) -> Option[u8 of r] {
  None
}

fn make_n(r: R) -> Option[u8 of r.n] {
  None
}

fn make_other(r: R) -> Option[u8 of r.other] {
  None
}

fn inspect(r: R, p: Option[u8 of r]) {}

fn inspect_n(r: R, p: Option[u8 of r.n]) {}

fn inspect_other(r: R, p: Option[u8 of r.other]) {}

fn probe(take x: R, flag: bool) -> u64 {
  let mut c = flag
  let mut r = copy x
  let original = make(r)
  let sibling = make_other(r)
  match c {
    true => {
      r.n = 3
    },
    false => {},
  }
  inspect(x, original)
  inspect_other(r, sibling)
  let q = make(r)
  inspect(r, q)
  let qn = make_n(r)
  inspect_n(r, qn)
  let qo: Option[u8 of r.other] = make_other(r)
  inspect_other(r, qo)
  let s = copy r
  let qs = make_other(s)
  inspect_other(s, qs)
  r.n + r.other
}

pub fn main(rt: Io, args: Args) -> Result[(), GrantError] {
  let yes = probe(R(n: 1, other: 10), true)
  let no = probe(R(n: 1, other: 10), false)
  let _ = out.print(
    io.stdout(rt)?,
    if yes == 13 && no == 11 {
      "ok\n"
    } else {
      "bad\n"
    }
  )
  Ok(())
}
