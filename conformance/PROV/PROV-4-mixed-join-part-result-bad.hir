// rule: PROV-4
// expect: reject PROV-4 at line 15
// twin: PROV/PROV-4-mixed-join-part-result-ok.hir
// The mixed-placement join rule holds at every depth. The tuple's string part
// joins arena and heap content, so it has no placement and is as local as
// every source, and so is the tuple holding it.
fn probe(a: Arena, c: bool) -> (String, u8) {
  let x: String in a = "x"
  let y: String = "y"
  let p = if c {
    (x, 1u8)
  } else {
    (y, 2u8)
  }
  p
}
