// rule: PROV-1
// expect: accept
// "An operation taking a branded value requires the same p."
// A named function used as a value keeps the brand relations of its header.
fn inspect(d: Dir, f: File of d) -> () {
  ()
}

fn example(d: Dir, p: Path) -> Result[(), FileError] {
  let open = file.open
  let check = inspect
  let f = open(d, p)?
  check(d, f)
  Ok(())
}
