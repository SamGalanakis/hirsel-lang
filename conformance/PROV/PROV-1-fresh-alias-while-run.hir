// rule: PROV-1
// expect: run
// stdout: ok
type R {
  n: u64,
}

fn make(r: R) -> Option[u8 of r] {
  None
}

fn inspect(r: R, p: Option[u8 of r]) -> () {}

fn probe(take x: R, take z: R, flag: bool) -> u64 {
  let mut c = flag
  let mut r = copy x
  let p = make(r)
  while c {
    r = copy z
    c = false
  }
  inspect(x, p)
  let q = make(r)
  inspect(r, q)
  r.n
}

pub fn main(rt: Io, args: Args) -> Result[(), GrantError] {
  let _ = out.print(
    io.stdout(rt)?,
    if probe(R(n: 1), R(n: 2), true) == 2 && probe(R(n: 1), R(n: 2), false) == 1 {
      "ok\n"
    } else {
      "bad\n"
    }
  )
  Ok(())
}
