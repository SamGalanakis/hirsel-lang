// rule: PROV-1
// expect: reject PROV-1 at line 23
// twin: PROV/PROV-1-alias-branch-if-exit-ok.hir
// Section 23 selects the branded use after a continuing identity change.
type R {
  n: u64,
}

fn make(r: R) -> Option[u8 of r] {
  None
}

fn inspect(r: R, p: Option[u8 of r]) -> () {}

fn probe(take x: R, take z: R, flag: bool) {
  let mut c = flag
  let mut r = copy x
  let p = make(r)
  while c {
    r = copy z
    c = false
  }
  inspect(r, p)
}
