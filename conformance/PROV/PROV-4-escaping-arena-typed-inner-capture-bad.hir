// rule: PROV-4
// expect: reject PROV-4 at line 7
// A closure typed global by its binding escapes at its own literal, before the returned closure captures it.
fn probe(a: Arena) -> fn() -> u64 {
  let x: String in a = "x"
  let pair = (x, 1u8)
  let inner: fn() -> u64 = fn() {
    let (s, n) = pair
    string.byte_len(s)
  }
  fn() {
    inner()
  }
}
