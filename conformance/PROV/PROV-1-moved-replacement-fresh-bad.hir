// rule: PROV-1
// expect: reject PROV-1 at line 21
// twin: PROV/PROV-1-moved-replacement-fresh-ok.hir
// "A brand ends when p is reassigned", also by a self-assignment that moves
// the old value back (issue #75).
type R {
  s: Slots[u64],
  k: u64,
}

fn make(r: R) -> Option[u8 of r] {
  None
}

fn inspect(r: R, p: Option[u8 of r]) {}

fn probe() {
  let mut r = R(s: slots.empty(), k: 0u64)
  let p = make(r)
  r = r
  inspect(r, p)
}
