// rule: PROV-4
// expect: reject PROV-4 at line 9
// twin: PROV/PROV-4-let-within-arena-and-binding-ok.hir
// v22 R3. Naming a binding beside an arena admits only the arenas the
// binding holds. z holds none, so y, placed in b, is outside {a, z}, as
// it would be outside a alone.
fn bad(a: Arena, b: Arena, y: Bytes in b) -> u64 {
  let z: Bytes = b"global"
  let v: Bytes in {a, z} = y
  0
}
