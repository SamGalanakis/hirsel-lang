// rule: PROV-1
// expect: reject PROV-1 at line 23
type R {
  n: u64,
}

fn make(r: R) -> Option[u8 of r] {
  None
}

fn inspect(r: R, p: Option[u8 of r]) -> () {}

fn touch(mut r: R) -> () {
  r.n = 3
}

fn probe(take r0: R, c: bool) -> () {
  let mut r = r0
  let p = make(r)
  if c {
    r.n = 3
  }
  inspect(r, p)
}
