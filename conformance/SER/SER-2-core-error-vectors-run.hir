// rule: SER-2
// expect: run
// stdout: cause 
// stdout: file 
// Core errors encode as core nominal nodes (package `core`, version `1`), so their
// descriptors are fixed by the core declarations; every engine prints these bytes.
fn text(mut out: List[u8], s: String) -> () {
  let data = string.as_bytes(s)
  let mut at: u64 = 0
  while at < bytes.len(data) {
    list.push(mut out, data[at])
    at += 1
  }
}

fn show[T: serializable](mut out: List[u8], name: String, x: T, expected: Bytes) -> () {
  let digits: Bytes = b"0123456789abcdef"
  let data = codec.encode(x)
  let decoded: Result[T, DecodeError] = codec.decode(expected)
  let again = match take decoded {
    Ok(y) => codec.encode(y),
    Error(_) => b"",
  }
  failure.check(data == expected && again == data, Arithmetic())
  text(mut out, name)
  list.push(mut out, 32)
  let mut at: u64 = 0
  while at < bytes.len(data) {
    let c = data[at]
    list.push(mut out, digits[int.widen(c >> 4)])
    list.push(mut out, digits[int.widen(c & 15)])
    at += 1
  }
  list.push(mut out, 10)
}

pub fn main(mut rt: Io) -> Result[(), GrantError] {
  let mut out: List[u8] = []
  let cause: CancelCause = DeadlineExceeded()
  show(
    mut out,
    "cause",
    cause,
    b"\x48\x53\x43\x31\x01\x00\x00\x00\x9c\x00\x00\x00\x00\x00\x00\x00\x01\x00\x00\x00\x00\x00\x00\x00\x02\x00\x00\x00\x06\x04\x00\x00\x00\x00\x00\x00\x00\x63\x6f\x72\x65\x01\x00\x00\x00\x00\x00\x00\x00\x31\x00\x00\x00\x00\x0b\x00\x00\x00\x00\x00\x00\x00\x43\x61\x6e\x63\x65\x6c\x43\x61\x75\x73\x65\x01\x00\x00\x00\x03\x04\x00\x00\x00\x09\x00\x00\x00\x00\x00\x00\x00\x52\x65\x71\x75\x65\x73\x74\x65\x64\x00\x00\x00\x00\x06\x00\x00\x00\x00\x00\x00\x00\x50\x61\x72\x65\x6e\x74\x00\x00\x00\x00\x0b\x00\x00\x00\x00\x00\x00\x00\x43\x68\x69\x6c\x64\x46\x61\x69\x6c\x65\x64\x00\x00\x00\x00\x10\x00\x00\x00\x00\x00\x00\x00\x44\x65\x61\x64\x6c\x69\x6e\x65\x45\x78\x63\x65\x65\x64\x65\x64\x00\x00\x00\x00\x04\x00\x00\x00\x00\x00\x00\x00\x03\x00\x00\x00"
  )
  let file: FileError = Canceled(Requested())
