// rule: SER-2
// expect: run
// Wire records remain in row order while decoded native storage uses columns.
@serializable
@soa
type Row {
  small: u8,
  wide: u64,
  text: String,
  flag: bool,
}

fn replace(data: Bytes, at: u64, value: u8) -> Bytes {
  let mut out: List[u8] = []
  for i in 0u64..bytes.len(data) {
    list.push(
      mut out,
      if i == at {
        value
      } else {
        data[i]
      }
    )
  }
  bytes.from_list(take out)
}

pub fn main(t: Test) -> Result[(), DecodeError] {
  // The capacity quantum is eight: two rows exercise capacity-based columns.
  let wire = b"\x48\x53\x43\x31\x01\x00\x00\x00\x94\x00\x00\x00\x00\x00\x00\x00\x01\x00\x00\x00\x00\x00\x00\x00\x07\x00\x00\x00\x05\x01\x01\x00\x00\x00\x00\x01\x00\x00\x00\x06\x0a\x00\x00\x00\x00\x00\x00\x00\x73\x74\x61\x6e\x64\x61\x6c\x6f\x6e\x65\x01\x00\x00\x00\x00\x00\x00\x00\x30\x00\x00\x00\x00\x03\x00\x00\x00\x00\x00\x00\x00\x52\x6f\x77\x02\x00\x00\x00\x02\x04\x00\x00\x00\x05\x00\x00\x00\x00\x00\x00\x00\x73\x6d\x61\x6c\x6c\x03\x00\x00\x00\x04\x00\x00\x00\x00\x00\x00\x00\x77\x69\x64\x65\x04\x00\x00\x00\x04\x00\x00\x00\x00\x00\x00\x00\x74\x65\x78\x74\x05\x00\x00\x00\x04\x00\x00\x00\x00\x00\x00\x00\x66\x6c\x61\x67\x06\x00\x00\x00\x00\x01\x00\x04\x00\x0d\x00\x00\x30\x00\x00\x00\x00\x00\x00\x00\x02\x00\x00\x00\x00\x00\x00\x00\x01\x08\x07\x06\x05\x04\x03\x02\x01\x01\x00\x00\x00\x00\x00\x00\x00\x61\x01\xff\x00\x00\x00\x00\x00\x00\x00\x00\x03\x00\x00\x00\x00\x00\x00\x00\xc3\xa9\x00\x00"
  let rows: List[Row] = codec.decode(wire)?
  test.check(t, codec.encode(rows) == wire)
  let shared = copy rows
  test.check(t, codec.encode(shared) == wire)
  let isolated: List[Row] = copy_to(heap, rows)
  test.check(t, codec.encode(isolated) == wire)
  let empty_wire = b"\x48\x53\x43\x31\x01\x00\x00\x00\x94\x00\x00\x00\x00\x00\x00\x00\x01\x00\x00\x00\x00\x00\x00\x00\x07\x00\x00\x00\x05\x01\x01\x00\x00\x00\x00\x01\x00\x00\x00\x06\x0a\x00\x00\x00\x00\x00\x00\x00\x73\x74\x61\x6e\x64\x61\x6c\x6f\x6e\x65\x01\x00\x00\x00\x00\x00\x00\x00\x30\x00\x00\x00\x00\x03\x00\x00\x00\x00\x00\x00\x00\x52\x6f\x77\x02\x00\x00\x00\x02\x04\x00\x00\x00\x05\x00\x00\x00\x00\x00\x00\x00\x73\x6d\x61\x6c\x6c\x03\x00\x00\x00\x04\x00\x00\x00\x00\x00\x00\x00\x77\x69\x64\x65\x04\x00\x00\x00\x04\x00\x00\x00\x00\x00\x00\x00\x74\x65\x78\x74\x05\x00\x00\x00\x04\x00\x00\x00\x00\x00\x00\x00\x66\x6c\x61\x67\x06\x00\x00\x00\x00\x01\x00\x04\x00\x0d\x00\x00\x08\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00"
  let empty: List[Row] = codec.decode(empty_wire)?
  test.check(t, codec.encode(empty) == empty_wire)
  let rejected: Result[List[Row], DecodeError] = codec.decode(
    replace(wire, bytes.len(wire) - 1, 2)
  )
  match rejected {
    Error(Scalar()) => {},
    _ => test.check(t, false),
  }
  Ok(())
}
