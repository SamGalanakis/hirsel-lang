// rule: SER-2
// expect: run
// RFC 8949 section 5.6 duplicate-key validity, including a non-adjacent duplicate.
pub fn main(t: Test) -> Result[(), ()] {
  let accepted: Result[Map[u8, bool], DecodeError] = codec.decode(
    b"\x48\x53\x43\x31\x01\x00\x00\x00\x20\x00\x00\x00\x00\x00\x00\x00\x01\x00\x00\x00\x00\x00\x00\x00\x03\x00\x00\x00\x05\x05\x02\x00\x00\x00\x00\x01\x00\x00\x00\x00\x02\x00\x00\x00\x00\x01\x00\x00\x0c\x00\x00\x00\x00\x00\x00\x00\x02\x00\x00\x00\x00\x00\x00\x00\x02\x01\x01\x00"
  )
  match accepted {
    Ok(x) => test.check(
      t,
      codec.encode(x) == b"\x48\x53\x43\x31\x01\x00\x00\x00\x20\x00\x00\x00\x00\x00\x00\x00\x01\x00\x00\x00\x00\x00\x00\x00\x03\x00\x00\x00\x05\x05\x02\x00\x00\x00\x00\x01\x00\x00\x00\x00\x02\x00\x00\x00\x00\x01\x00\x00\x0c\x00\x00\x00\x00\x00\x00\x00\x02\x00\x00\x00\x00\x00\x00\x00\x02\x01\x01\x00"
    ),
    Error(_) => test.check(t, false),
  }
  let rejected: Result[Map[u8, bool], DecodeError] = codec.decode(
    b"\x48\x53\x43\x31\x01\x00\x00\x00\x20\x00\x00\x00\x00\x00\x00\x00\x01\x00\x00\x00\x00\x00\x00\x00\x03\x00\x00\x00\x05\x05\x02\x00\x00\x00\x00\x01\x00\x00\x00\x00\x02\x00\x00\x00\x00\x01\x00\x00\x0e\x00\x00\x00\x00\x00\x00\x00\x03\x00\x00\x00\x00\x00\x00\x00\x02\x01\x01\x00\x02\x00"
  )
  test.check(t, rejected == Error(Duplicate()))
  Ok(())
}
