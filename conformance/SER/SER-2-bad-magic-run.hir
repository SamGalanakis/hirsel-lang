// rule: SER-2
// expect: run
// Exactly one recognized envelope.
pub fn main(t: Test) -> Result[(), ()] {
  let accepted: Result[bool, DecodeError] = codec.decode(
    b"\x48\x53\x43\x31\x01\x00\x00\x00\x0e\x00\x00\x00\x00\x00\x00\x00\x01\x00\x00\x00\x00\x00\x00\x00\x01\x00\x00\x00\x00\x00\x01\x00\x00\x00\x00\x00\x00\x00\x01"
  )
  match accepted {
    Ok(x) => test.check(
      t,
      codec.encode(x) == b"\x48\x53\x43\x31\x01\x00\x00\x00\x0e\x00\x00\x00\x00\x00\x00\x00\x01\x00\x00\x00\x00\x00\x00\x00\x01\x00\x00\x00\x00\x00\x01\x00\x00\x00\x00\x00\x00\x00\x01"
    ),
    Error(_) => test.check(t, false),
  }
  let rejected: Result[bool, DecodeError] = codec.decode(
    b"\x48\x53\x58\x31\x01\x00\x00\x00\x0e\x00\x00\x00\x00\x00\x00\x00\x01\x00\x00\x00\x00\x00\x00\x00\x01\x00\x00\x00\x00\x00\x01\x00\x00\x00\x00\x00\x00\x00\x01"
  )
  test.check(t, rejected == Error(Version()))
  Ok(())
}
