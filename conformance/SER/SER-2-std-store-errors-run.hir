// rule: SER-2
// expect: run
// std@1/store's transaction outcomes, errors and call requests round-trip
// through the canonical codec.
fn round[T: serializable](t: Test, x: T) -> Result[(), DecodeError] {
  let encoded = codec.encode(x)
  let read = fn() -> Result[T, DecodeError] {
    codec.decode(encoded)
  }
  let decoded: T = read()?
  test.check(t, codec.encode(decoded) == encoded)
  Ok(())
}

pub fn main(t: Test) -> Result[(), DecodeError] {
  let aborted: store.TxFailure[FileError] = Aborted(NotFound())
  round(t, aborted)?
  let tx_canceled: store.TxFailure[String] = Canceled(Parent())
  round(t, tx_canceled)?
  let storage: store.TxFailure[u8] = Storage(Corrupt("log/00000000000000000001"))
  round(t, storage)?
  let limit: store.TxFailure[u8] = Limit(TransactionBytes())
  round(t, limit)?
  let unknown: store.TxFailure[u8] = Unknown(Storage(FileFault(5)))
  round(t, unknown)?
  let fenced: store.StoreError = Fenced()
  round(t, fenced)?
  let denied: store.CallFailure[u8] = Denied()
  round(t, denied)?
  let failed: store.CallFailure[u8] = Tx(Aborted(3))
  round(t, failed)?
  round(
    t,
    store.CallRequest(
      stream: b"s1",
      epoch: 2,
      position: 7,
      digest: b"d",
      acknowledged: 6
    )
  )?
  Ok(())
}
