// rule: SER-2
// expect: run
// RFC 8949 section 4.2 / Appendix A NaN examples, adapted to fixed SER-2 bits.
pub fn main(t: Test) -> Result[(), ()] {
  let accepted: Result[f32, DecodeError] = codec.decode(
    b"\x48\x53\x43\x31\x01\x00\x00\x00\x0e\x00\x00\x00\x00\x00\x00\x00\x01\x00\x00\x00\x00\x00\x00\x00\x01\x00\x00\x00\x00\x0b\x04\x00\x00\x00\x00\x00\x00\x00\x00\x00\xc0\x7f"
  )
  match accepted {
    Ok(x) => test.check(
      t,
      codec.encode(x) == b"\x48\x53\x43\x31\x01\x00\x00\x00\x0e\x00\x00\x00\x00\x00\x00\x00\x01\x00\x00\x00\x00\x00\x00\x00\x01\x00\x00\x00\x00\x0b\x04\x00\x00\x00\x00\x00\x00\x00\x00\x00\xc0\x7f"
    ),
    Error(_) => test.check(t, false),
  }
  let rejected: Result[f32, DecodeError] = codec.decode(
    b"\x48\x53\x43\x31\x01\x00\x00\x00\x0e\x00\x00\x00\x00\x00\x00\x00\x01\x00\x00\x00\x00\x00\x00\x00\x01\x00\x00\x00\x00\x0b\x04\x00\x00\x00\x00\x00\x00\x00\x01\x00\xc0\x7f"
  )
  test.check(t, rejected == Error(Scalar()))
  Ok(())
}
