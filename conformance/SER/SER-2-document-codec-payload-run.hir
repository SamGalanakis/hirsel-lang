// rule: SER-2
// expect: run
// Literal decoded fields distinguish payload fidelity from encoder/decoder agreement.
pub fn main(t: Test) -> Result[(), DecodeError] {
  let position = toml.Position(line: 3, column: 9)
  let decoded: toml.Position = codec.decode(codec.encode(position))?
  test.check(t, decoded.line == 3)
  test.check(t, decoded.column == 9)
  let config = csv.Config(
    delimiter: 59,
    fields_per_record: Some(3),
    max_record_bytes: 1024
  )
  let read: csv.Config = codec.decode(codec.encode(config))?
  test.check(t, read.delimiter == 59)
  test.check(t, read.fields_per_record == Some(3))
  test.check(t, read.max_record_bytes == 1024)
  Ok(())
}
