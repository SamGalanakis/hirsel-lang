// rule: SER-2
// expect: run
// Serializable declarations recursive through each other round-trip.
@serializable
type Tree = Leaf | Node(box Entry)

@serializable
type Entry {
  left: Tree,
  key: Option[u64],
  right: Tree,
}

pub fn main(t: Test) -> Result[(), DecodeError] {
  let leaf: Tree = Node(box Entry(left: Leaf(), key: None(), right: Leaf()))
  let tree: Tree = Node(box Entry(left: leaf, key: Some(7), right: Leaf()))
  let encoded = codec.encode(tree)
  let back: Tree = codec.decode(encoded)?
  test.check(t, codec.encode(back) == encoded)
  Ok(())
}
