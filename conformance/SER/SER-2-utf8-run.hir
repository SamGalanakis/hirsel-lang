// rule: SER-2
// expect: run
// RFC 8949 section 5.3.1 UTF-8 validity; surrogate encoding rejected.
pub fn main(t: Test) -> Result[(), ()] {
  let accepted: Result[String, DecodeError] = codec.decode(
    b"\x48\x53\x43\x31\x01\x00\x00\x00\x0e\x00\x00\x00\x00\x00\x00\x00\x01\x00\x00\x00\x00\x00\x00\x00\x01\x00\x00\x00\x00\x0d\x0f\x00\x00\x00\x00\x00\x00\x00\x07\x00\x00\x00\x00\x00\x00\x00\xc3\xa9\x00\xf0\x9f\x98\x80"
  )
  match accepted {
    Ok(x) => test.check(
      t,
      codec.encode(x) == b"\x48\x53\x43\x31\x01\x00\x00\x00\x0e\x00\x00\x00\x00\x00\x00\x00\x01\x00\x00\x00\x00\x00\x00\x00\x01\x00\x00\x00\x00\x0d\x0f\x00\x00\x00\x00\x00\x00\x00\x07\x00\x00\x00\x00\x00\x00\x00\xc3\xa9\x00\xf0\x9f\x98\x80"
    ),
    Error(_) => test.check(t, false),
  }
  let rejected: Result[String, DecodeError] = codec.decode(
    b"\x48\x53\x43\x31\x01\x00\x00\x00\x0e\x00\x00\x00\x00\x00\x00\x00\x01\x00\x00\x00\x00\x00\x00\x00\x01\x00\x00\x00\x00\x0d\x0b\x00\x00\x00\x00\x00\x00\x00\x03\x00\x00\x00\x00\x00\x00\x00\xed\xa0\x80"
  )
  test.check(t, rejected == Error(Utf8()))
  Ok(())
}
