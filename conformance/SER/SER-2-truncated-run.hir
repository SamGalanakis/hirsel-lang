      codec.encode(x) == b"\x48\x53\x43\x31\x01\x00\x00\x00\x19\x00\x00\x00\x00\x00\x00\x00\x01\x00\x00\x00\x00\x00\x00\x00\x02\x00\x00\x00\x05\x01\x01\x00\x00\x00\x00\x01\x00\x00\x00\x00\x02\x0c\x00\x00\x00\x00\x00\x00\x00\x02\x00\x00\x00\x00\x00\x00\x00\x01\x00\x02\x01"
    ),
