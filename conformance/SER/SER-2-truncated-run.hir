  }
  let rejected: Result[List[u16], DecodeError] = codec.decode(
    b"\x48\x53\x43\x31\x01\x00\x00\x00\x19\x00\x00\x00\x00\x00\x00\x00\x01\x00\x00\x00\x00\x00\x00\x00\x02\x00\x00\x00\x05\x01\x01\x00\x00\x00\x00\x01\x00\x00\x00\x00\x02\x0a\x00\x00\x00\x00\x00\x00\x00\x02\x00\x00\x00\x00\x00\x00\x00\x01\x00"
  )
  test.check(t, rejected == Error(Truncated()))
