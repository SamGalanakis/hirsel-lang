// rule: SER-2
// expect: run
// Generic std errors round-trip at a serializable argument, as do http.Config with its
// core TlsRoots and the core Durability.
fn round[T: serializable](t: Test, x: T) -> Result[(), DecodeError] {
  let encoded = codec.encode(x)
  let read = fn() -> Result[T, DecodeError] {
    codec.decode(encoded)
  }
  let decoded: T = read()?
  test.check(t, codec.encode(decoded) == encoded)
  Ok(())
}

pub fn main(t: Test) -> Result[(), DecodeError] {
  let source: bufio.ReadError[FileError] = Source(NotFound())
  round(t, source)?
  let limit: bufio.ReadError[FileError] = Limit()
  round(t, limit)?
  let csv_error: csv.ReadError[FileError] = Csv(
    Syntax(csv.Position(start_line: 1, line: 1, column: 5))
  )
  round(t, csv_error)?
  let flate_error: flate.ReadError[FileError] = Input(Source(PermissionDenied()))
  round(t, flate_error)?
  let tar_error: tar.ReadError[FileError] = Archive(Header(512))
  round(t, tar_error)?
  let extract: tar.ExtractError[FileError] = Read(Input(Source(NotGranted())))
  round(t, extract)?
  let file: tar.ExtractError[FileError] = File(AlreadyExists())
  round(t, file)?
  let mut config = http.default_config()
  config.roots = Pem(b"-----BEGIN CERTIFICATE-----")
  round(t, config)?
  let web: TlsRoots = WebPki()
  round(t, web)?
  let durable: Durability = Durable()
  round(t, durable)?
  let volatile: Durability = Volatile()
  round(t, volatile)?
  Ok(())
}
