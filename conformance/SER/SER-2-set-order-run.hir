// rule: SER-2
// expect: run
// RFC 8949 section 4.2 deterministic key order, adapted to canonical Set encodings.
pub fn main(t: Test) -> Result[(), ()] {
  let accepted: Result[Set[u16], DecodeError] = codec.decode(
    b"\x48\x53\x43\x31\x01\x00\x00\x00\x19\x00\x00\x00\x00\x00\x00\x00\x01\x00\x00\x00\x00\x00\x00\x00\x02\x00\x00\x00\x05\x06\x01\x00\x00\x00\x00\x01\x00\x00\x00\x00\x02\x0c\x00\x00\x00\x00\x00\x00\x00\x02\x00\x00\x00\x00\x00\x00\x00\x00\x01\x01\x00"
  )
  match accepted {
    Ok(x) => test.check(
      t,
      codec.encode(x) == b"\x48\x53\x43\x31\x01\x00\x00\x00\x19\x00\x00\x00\x00\x00\x00\x00\x01\x00\x00\x00\x00\x00\x00\x00\x02\x00\x00\x00\x05\x06\x01\x00\x00\x00\x00\x01\x00\x00\x00\x00\x02\x0c\x00\x00\x00\x00\x00\x00\x00\x02\x00\x00\x00\x00\x00\x00\x00\x00\x01\x01\x00"
    ),
    Error(_) => test.check(t, false),
  }
  let rejected: Result[Set[u16], DecodeError] = codec.decode(
    b"\x48\x53\x43\x31\x01\x00\x00\x00\x19\x00\x00\x00\x00\x00\x00\x00\x01\x00\x00\x00\x00\x00\x00\x00\x02\x00\x00\x00\x05\x06\x01\x00\x00\x00\x00\x01\x00\x00\x00\x00\x02\x0c\x00\x00\x00\x00\x00\x00\x00\x02\x00\x00\x00\x00\x00\x00\x00\x01\x00\x00\x01"
  )
  match rejected {
    Error(Order()) => test.check(t, true),
    _ => test.check(t, false),
  }
  Ok(())
}
