// Every engine prints the same canonical bytes for these cross-engine vectors
// and decodes the interpreter's bytes back to the same values.
@serializable
type Row {
  x: u8,
  y: bool,
}

@serializable
type Choice = Empty | Item(String)

@serializable
distinct type Count(v: u64)

@serializable
flat type FlatRow {
  n: u16,
  flag: bool,
}

@serializable
type NumericChoice = Small(value: u64) | Large(value: u64, extra: u64)

fn text(mut out: List[u8], s: String) -> () {
  let data = string.as_bytes(s)
  let mut at: u64 = 0
  while at < bytes.len(data) {
    list.push(mut out, data[at])
    at += 1
  }
}

fn show[T: serializable](mut out: List[u8], name: String, x: T, expected: Bytes) -> () {
  let digits: Bytes = b"0123456789abcdef"
  let data = codec.encode(x)
  let decoded: Result[T, DecodeError] = codec.decode(expected)
  let again = match take decoded {
    Ok(y) => codec.encode(y),
    Error(_) => b"",
  }
  failure.check(data == expected && again == data, Arithmetic())
  text(mut out, name)
  list.push(mut out, 32)
  let mut at: u64 = 0
  while at < bytes.len(data) {
    let c = data[at]
    list.push(mut out, digits[int.widen(c >> 4)])
    list.push(mut out, digits[int.widen(c & 15)])
    at += 1
  }
  list.push(mut out, 10)
}

