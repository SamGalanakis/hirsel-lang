// rule: SER-2
// expect: run
// Checked extent addition before indexing or allocation.
pub fn main(t: Test) -> Result[(), ()] {
  let accepted: Result[Bytes, DecodeError] = codec.decode(
    b"\x48\x53\x43\x31\x01\x00\x00\x00\x0e\x00\x00\x00\x00\x00\x00\x00\x01\x00\x00\x00\x00\x00\x00\x00\x01\x00\x00\x00\x00\x0e\x0b\x00\x00\x00\x00\x00\x00\x00\x03\x00\x00\x00\x00\x00\x00\x00\x00\xff\x80"
  )
  match accepted {
    Ok(x) => test.check(
      t,
      codec.encode(x) == b"\x48\x53\x43\x31\x01\x00\x00\x00\x0e\x00\x00\x00\x00\x00\x00\x00\x01\x00\x00\x00\x00\x00\x00\x00\x01\x00\x00\x00\x00\x0e\x0b\x00\x00\x00\x00\x00\x00\x00\x03\x00\x00\x00\x00\x00\x00\x00\x00\xff\x80"
    ),
    Error(_) => test.check(t, false),
  }
  let rejected: Result[Bytes, DecodeError] = codec.decode(
    b"\x48\x53\x43\x31\x01\x00\x00\x00\x0e\x00\x00\x00\x00\x00\x00\x00\x01\x00\x00\x00\x00\x00\x00\x00\x01\x00\x00\x00\x00\x0e\x08\x00\x00\x00\x00\x00\x00\x00\xff\xff\xff\xff\xff\xff\xff\xff"
  )
  test.check(t, rejected == Error(Length()))
  Ok(())
}
