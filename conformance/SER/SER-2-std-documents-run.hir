// rule: SER-2
// expect: run
// std json, toml, yaml and csv values and errors round-trip through the canonical codec,
// recursive document values and floats included.
fn round[T: serializable](t: Test, x: T) -> Result[(), DecodeError] {
  let encoded = codec.encode(x)
  let read = fn() -> Result[T, DecodeError] {
    codec.decode(encoded)
  }
  let decoded: T = read()?
  test.check(t, codec.encode(decoded) == encoded)
  Ok(())
}

pub fn main(t: Test) -> Result[(), DecodeError] {
  let mut members: Map[String, json.Value] = map.empty()
  map.insert(mut members, "n", Number("1.5e3"))
  map.insert(mut members, "list", Array([Null(), Bool(true), Text("x")]))
  let object: json.Value = Object(members)
  round(t, object)?
  let json_error: json.JsonError = DuplicateKey(7)
  round(t, json_error)?
  let mut table: Map[String, toml.Value] = map.empty()
  map.insert(mut table, "pi", Float(3.25))
  map.insert(mut table, "when", Datetime("1979-05-27T07:32:00Z"))
  map.insert(mut table, "items", Array([Integer(-3), Text("y")]))
  let toml_value: toml.Value = Table(table)
  round(t, toml_value)?
  round(t, toml.Position(line: 3, column: 9))?
  let toml_error: toml.TomlError = Syntax(toml.Position(line: 1, column: 2))
  round(t, toml_error)?
  let toml_segment: toml.Segment = Index(4)
  round(t, toml_segment)?
  let mut mapping: Map[String, yaml.Value] = map.empty()
  map.insert(mut mapping, "f", Float(-0.5))
  map.insert(mut mapping, "seq", Array([Integer(1), Null(), Bool(false)]))
  let yaml_value: yaml.Value = Object(mapping)
  round(t, yaml_value)?
  round(t, yaml.Position(line: 2, column: 1))?
  let yaml_error: yaml.YamlError = Aliases(yaml.Position(line: 5, column: 3))
  round(t, yaml_error)?
  let yaml_segment: yaml.Segment = Key("a")
  round(t, yaml_segment)?
  round(
    t,
    csv.Config(delimiter: 59, fields_per_record: Some(3), max_record_bytes: 1024)
  )?
  let csv_error: csv.CsvError = UnequalFields(2)
  round(t, csv_error)?
  Ok(())
}
