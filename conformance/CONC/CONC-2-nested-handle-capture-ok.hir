// rule: CONC-2
// expect: accept
fn work(m: Mutex[u64], take x: unique String) -> () {}

fn main(rt: Io) -> Result[(), GrantError] {
  let tasks = io.tasks(rt)?
  let state: Mutex[u64] = mutex.create(tasks, 0u64)
  let text: unique String = unique "a"
  task.scope(
    tasks,
    fn(s: Scope) {
      let child = task.async(
        s,
        fn() -> () {
          work(state, take text)
        }
      )
      task.detach(s, take child)
    }
  )
  Ok(())
}
