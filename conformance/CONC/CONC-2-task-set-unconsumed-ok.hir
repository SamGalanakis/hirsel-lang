// rule: CONC-2
// expect: accept
// A task set holds its members' obligations, so it must be consumed like a handle.
fn launch(tasks: Tasks) -> () {
  task.scope(
    tasks,
    fn(s: Scope) {
      let mut set: TaskSet[u64] of s = task.set(s)
      task.add(
        s,
        mut set,
        task.async(
          s,
          fn() -> u64 {
            1
          }
        )
      )
      task.detach_all(s, take set)
    }
  )
}
