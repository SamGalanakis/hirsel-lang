// rule: CONC-2
// expect: reject CONC-2 at line 4
// A parameter taking a task handle holds its caller's await-or-detach obligation.
fn forget(s: Scope, take h: Task[u64] of s) -> u64 {
  0
}

fn launch(tasks: Tasks) -> u64 {
  task.scope(
    tasks,
    fn(s: Scope) -> u64 {
      let h = task.async(
        s,
        fn() -> u64 {
          1
        }
      )
      forget(s, take h)
    }
  )
}
