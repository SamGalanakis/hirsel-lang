// rule: CONC-3
// expect: run
// process: {"provider":"process.script@1","rules":[{"program":"/bin/test"}],"runs":[],"children":[]}
// Program errors precede cancellation in both run and spawn.
pub fn main(rt: Io, args: Args) -> Result[(), GrantError] {
  let tasks = io.tasks(rt)?
  let p = io.process(rt)?
  task.scope(
    tasks,
    fn(s: Scope) {
      let (sender, receiver): (Sender[u8], Receiver[u8]) = channel.open(tasks)
      let h = task.async(
        s,
        fn() -> bool {
          let mut r = take receiver
          let _ = channel.receive(tasks, mut r)
          let ungranted: bool = match proc.run(
            p,
            Command(
              program: path.of("/bin/echo"),
              args: [],
              dir: None(),
              env: None(),
              own_group: false
            ),
            b"",
            64,
            None()
          ) {
            Error(NotGranted()) => true,
            _ => false,
          }
          let invalid: bool = match proc.run(
            p,
            Command(
              program: path.of("echo"),
              args: [],
              dir: None(),
              env: None(),
              own_group: false
            ),
            b"",
            64,
            None()
          ) {
            Error(InvalidInput()) => true,
            _ => false,
          }
          let spawned: bool = match proc.spawn(
            p,
            Command(
              program: path.of("echo"),
              args: [],
              dir: None(),
              env: None(),
              own_group: false
            )
          ) {
            Error(InvalidInput()) => true,
            _ => false,
          }
          let valid_run: bool = match proc.run(
            p,
            Command(
              program: path.of("/bin/test"),
              args: [],
              dir: None(),
              env: None(),
              own_group: false
            ),
            b"",
            64,
            None()
          ) {
            Error(Canceled(Requested)) => true,
            _ => false,
          }
          let valid_spawn: bool = match proc.spawn(
            p,
            Command(
              program: path.of("/bin/test"),
              args: [],
              dir: None(),
              env: None(),
              own_group: false
            )
          ) {
            Error(Canceled(Requested)) => true,
            _ => false,
          }
          ungranted && invalid && spawned && valid_run && valid_spawn
        }
      )
      task.cancel(s, h)
      failure.check(task.await(s, take h), Arithmetic())
    }
  )
  failure.check(
    proc.run(
      p,
      Command(
        program: path.of("/bin/echo"),
        args: [],
        dir: None(),
        env: None(),
        own_group: false
      ),
      b"",
      64,
      None()
    ) == Error(NotGranted()),
    Arithmetic()
  )
  failure.check(
    proc.run(
      p,
      Command(
        program: path.of("echo"),
        args: [],
        dir: None(),
        env: None(),
        own_group: false
      ),
      b"",
      64,
      None()
    ) == Error(InvalidInput()),
    Arithmetic()
  )
  let spawned: bool = match proc.spawn(
    p,
    Command(
      program: path.of("echo"),
      args: [],
      dir: None(),
      env: None(),
      own_group: false
    )
  ) {
    Error(InvalidInput()) => true,
    _ => false,
  }
  failure.check(spawned, Arithmetic())
  Ok(())
}
