// rule: CONC-2
// expect: accept
// Structured children "cannot outlive" their scope; handles are awaited with scope identity.
pub fn sizes(tasks: Tasks, dir: Dir, a: Path, b: Path) -> Result[(u64, u64), FileError] {
  task.scope(
    tasks,
    fn(s: Scope) {
      let ha = task.async(
        s,
        fn() {
          file.size(dir, a)
        }
      )
      let hb = task.async(
        s,
        fn() {
          file.size(dir, b)
        }
      )
      Ok((task.await(s, take ha)?, task.await(s, take hb)?))
    }
  )
}
