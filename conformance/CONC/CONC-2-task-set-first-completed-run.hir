// rule: CONC-2
// expect: run
// stdout: 1 7
// "task.await_any" reports the member that completed first; "task.cancel_all" cancels and
// joins the rest, so the receive blocked on a channel nobody sends to ends Canceled.
pub type AppError = Grant(GrantError) | Output(OutputError)

pub fn main(rt: Io) -> Result[(), AppError] {
  let tasks = io.tasks(rt) ? Grant
  let stdout = io.stdout(rt) ? Grant
  let (tx, rx): (Sender[u64], Receiver[u64]) = channel.open(tasks)
  let (index, value) = task.scope(
    tasks,
    fn(s: Scope) -> (u64, u64) {
      let mut set: TaskSet[u64] of s = task.set(s)
      task.add(
        s,
        mut set,
        task.async(
          s,
          fn() -> u64 {
            let mut r = take rx
            match channel.receive(tasks, mut r) {
              Ok(v) => v,
              Error(_) => 99,
            }
          }
        )
      )
      task.add(
        s,
        mut set,
        task.async(
          s,
          fn() -> u64 {
            7
          }
        )
      )
      let first = match task.await_any(s, set) {
        Some(i) => i,
        None => 100,
      }
      let value = task.await_at(s, mut set, first)
      task.cancel_all(s, take set)
      (first, value)
    }
  )
  out.print(
    stdout,
    if index == 1 && value == 7 {
      "1 7\n"
    } else {
      "wrong\n"
    }
  ) ? Output
  Ok(())
}
