// rule: CONC-2
// expect: accept
// A parameter taking a task set holds its caller's obligation and discharges it by
// consuming the set.
fn stop(s: Scope, take set: TaskSet[u64] of s) -> () {
  task.cancel_all(s, take set)
}

fn launch(tasks: Tasks) -> () {
  task.scope(
    tasks,
    fn(s: Scope) {
      let mut set: TaskSet[u64] of s = task.set(s)
      task.add(
        s,
        mut set,
        task.async(
          s,
          fn() -> u64 {
            1
          }
        )
      )
      stop(s, take set)
    }
  )
}
