// rule: CONC-5
// expect: reject CONC-5 at line 10
// twin: CONC/CONC-5-channel-in-body-ok.hir
// The lock body "holds no authority" and cannot "use a channel".
fn locked(tasks: Tasks, m: Mutex[u32], n: u32) -> () {
  mutex.with(
    tasks,
    m,
    fn(mut value: unique u32) {
      let ends: (Sender[u32], Receiver[u32]) = channel.open(tasks)
    }
  )
}
