// rule: CONC-2
// expect: fail CONC-2 at line 21
// A task set member is awaited at most once.
pub fn main(rt: Io) -> Result[(), GrantError] {
  let tasks = io.tasks(rt)?
  let total = task.scope(
    tasks,
    fn(s: Scope) -> u64 {
      let mut set: TaskSet[u64] of s = task.set(s)
      task.add(
        s,
        mut set,
        task.async(
          s,
          fn() -> u64 {
            1
          }
        )
      )
      let a = task.await_at(s, mut set, 0)
      let b = task.await_at(s, mut set, 0)
      task.detach_all(s, take set)
      a + b
    }
  )
  Ok(())
}
