// rule: CONC-2
// expect: run
// Owning matches receive TaskSet results without stale uniqueness claims.

fn at_ok(s: Scope) -> u64 {
  let mut pending: TaskSet[unique Result[String, String]] of s = task.set(s)
  task.add(
    s,
    mut pending,
    task.async(
      s,
      fn() -> unique Result[String, String] {
        unique Ok("a")
      }
    )
  )
  let slot = 0u64
  let joined = task.await_at(s, mut pending, slot)
  let length = match take joined {
    Ok(row) => string.byte_len(row),
    Error(problem) => string.byte_len(problem),
  }
  task.cancel_all(s, take pending)
  length
}

fn at_error(s: Scope) -> u64 {
  let mut pending: TaskSet[unique Result[String, String]] of s = task.set(s)
  task.add(
    s,
    mut pending,
    task.async(
      s,
      fn() -> unique Result[String, String] {
        unique Error("bad")
      }
    )
  )
  let slot = 0u64
  let joined = task.await_at(s, mut pending, slot)
  let length = match take joined {
    Ok(row) => string.byte_len(row),
    Error(problem) => string.byte_len(problem),
  }
  task.cancel_all(s, take pending)
  length
}

fn any_ok(s: Scope) -> u64 {
  let mut pending: TaskSet[unique Result[String, String]] of s = task.set(s)
  task.add(
    s,
    mut pending,
    task.async(
      s,
      fn() -> unique Result[String, String] {
        unique Ok("a")
      }
    )
  )
  let slot = match task.await_any(s, pending) {
    Some(i) => i,
    None => {
      task.cancel_all(s, take pending)
      return 99u64
    },
  }
  let joined = task.await_at(s, mut pending, slot)
  let length = match take joined {
    Ok(row) => string.byte_len(row),
    Error(problem) => string.byte_len(problem),
  }
  task.cancel_all(s, take pending)
  length
}

