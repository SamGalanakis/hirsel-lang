// rule: CONC-3
// expect: run
// "Pure code is not cancellable"; joins "are not cancellation points".
@noalloc
fn check(x: u32) -> ()
  requires x == 7 {
  ()
}

pub fn main(rt: Io, args: Args) -> Result[(), LaunchError] {
  task.scope(
    io.tasks(rt) ? Grant,
    fn(s: Scope) {
      let h = task.async(
        s,
        fn() -> u32 {
          7
        }
      )
      task.cancel(s, h)
      check(task.await(s, take h))
    }
  )
  Ok(())
}

pub type LaunchError = Grant(GrantError) | Output(OutputError) | Usage(ArgError) | Files(
  FileError
)
