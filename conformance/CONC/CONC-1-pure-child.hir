// rule: CONC-1
// expect: run
// A runtime may suspend "only at Io calls ... and cancellation checks".
pub fn main(rt: Io, args: Args) -> Result[(), LaunchError] {
  task.scope(
    io.tasks(rt) ? Grant,
    fn(s: Scope) {
      let h = task.async(
        s,
        fn() -> u32 {
          1
        }
      )
      let value: u32 = task.await(s, take h)
      let _ = value
    }
  )
  Ok(())
}

pub type LaunchError = Grant(GrantError) | Output(OutputError) | Usage(ArgError) | Files(
  FileError
)
