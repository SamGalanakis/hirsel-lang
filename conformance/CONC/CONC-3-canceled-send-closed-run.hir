// rule: CONC-3
// expect: run
// Closed wins regardless of cancellation and returns the intact owned payload.
fn discard[T](take value: T) -> () {
  ()
}

type Payload {
  bytes: unique List[u8],
}

pub fn main(rt: Io, args: Args) -> Result[(), GrantError] {
  let tasks = io.tasks(rt)?
  task.scope(
    tasks,
    fn(s: Scope) {
      let (sender, receiver): (Sender[Payload], Receiver[Payload]) = channel.open(tasks)
      discard(take receiver)
      let (wake, sleep): (Sender[u8], Receiver[u8]) = channel.open(tasks)
      let child = task.async(
        s,
        fn() -> bool {
          let mut gate = take sleep
          let _ = channel.receive(tasks, mut gate)
          let mut tx = take sender
          let payload = Payload(bytes: unique [7u8, 9u8])
          match channel.send(tasks, mut tx, take payload) {
            Error((returned, Closed())) => returned.bytes == [7u8, 9u8],
            _ => false,
          }
        }
      )
      task.cancel(s, child)
      failure.check(task.await(s, take child), Arithmetic())
      let _ = wake
    }
  )
  Ok(())
}
