// rule: CONC-3
// expect: run
// grant: clock
pub fn main(rt: Io, args: Args) -> Result[(), GrantError] {
  let tasks = io.tasks(rt)?
  let clock = io.monotonic_clock(rt)?
  let d = match io.dir(rt, path.of(".")) {
    Ok(d) => d,
    Error(_) => {
      failure.check(false, Arithmetic())
      return Ok(())
    },
  }
  failure.check(file.mkdir(d, path.of("kept")) == Ok(()), Arithmetic())
  let now = match core@1/clock.monotonic(clock) {
    Ok(now) => now,
    Error(_) => return Ok(()),
  }
  let _ = task.scope_until(
    tasks,
    Deadline(clock: clock, at: now),
    fn(s: Scope) {
      failure.check(
        dir.remove_all(d, path.of("../escape")) == Error(FileFault(1u32)),
        Arithmetic()
      )
      failure.check(
        dir.remove_all(d, path.of(".")) == Error(FileFault(1u32)),
        Arithmetic()
      )
      failure.check(
        file.set_permissions(d, path.of("kept"), 512u32) == Error(FileFault(1u32)),
        Arithmetic()
      )
      failure.check(
        file.set_permissions(d, path.of("kept"), 511u32) == Error(
          Canceled(DeadlineExceeded())
        ),
        Arithmetic()
      )
      failure.check(
        dir.remove_all(d, path.of("kept")) == Error(Canceled(DeadlineExceeded())),
        Arithmetic()
      )
    }
  )
  failure.check(
    match results.and_then(
      take file.read_dir(d, path.of("kept")),
      fn(take entries: Iter[Result[DirEntry, FileError]]) -> Result[
        List[DirEntry],
        FileError
      ] {
        iter.try_collect(take entries)
      }
    ) {
      Ok(entries) => list.len(entries) == 0,
      _ => false,
    },
    Arithmetic()
  )
  Ok(())
}
