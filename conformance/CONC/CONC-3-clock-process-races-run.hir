// rule: CONC-3
// expect: run
// grant: clock
// process: {"provider":"process.script@1","rules":[{"program":"/bin/test"}],"runs":[{"program":"/bin/test","args":[],"outcome":{"output":{"status":{"exited":0},"stdout":[104,105],"stderr":[]}}},{"program":"/bin/test","args":[],"outcome":{"output":{"status":{"exited":0},"stdout":[104,105],"stderr":[]}}}],"children":[]}
// stdout: ran 2
// stdout: timed out
// stdout: ran 2
// stdout: not found
// stdout: at 0
fn after(c: MonotonicClock, start: Instant of c, ns: u64) -> Deadline {
  match instant.checked_add(c, start, ns) {
    Some(at) => Deadline(clock: c, at: at),
    None() => Deadline(clock: c, at: start),
  }
}

fn elapsed(c: MonotonicClock, start: Instant of c) -> String {
  match clock.monotonic(c) {
    Ok(now) => f"at {instant.ticks(now) - instant.ticks(start)}\n",
    Error(_) => "no clock\n",
  }
}

fn outcome(r: Result[ProcessOutput, ProcessError]) -> String {
  match r {
    Ok(ran) => f"ran {bytes.len(ran.stdout)}\n",
    Error(TimedOut()) => "timed out\n",
    Error(NotFound()) => "not found\n",
    Error(_) => "failed\n",
  }
}

pub fn main(rt: Io, args: Args) -> Result[(), GrantError] {
  let output = io.stdout(rt)?
  let c = io.monotonic_clock(rt)?
  let p = io.process(rt)?
  let start = match clock.monotonic(c) {
    Ok(t) => t,
    Error(_) => return Ok(()),
  }
  let test = path.of("/bin/test")
  let _ = out.print(
    output,
    outcome(
      proc.run(
        p,
        Command(program: test, args: [], dir: None(), env: None(), own_group: false),
        b"",
        64u64,
        Some(after(c, start, 1000u64))
      )
    )
  )
  let _ = out.print(
    output,
    outcome(
      proc.run(
        p,
        Command(program: test, args: [], dir: None(), env: None(), own_group: false),
        b"",
        64u64,
        Some(Deadline(clock: c, at: start))
      )
    )
  )
  let _ = out.print(
    output,
    outcome(
      proc.run(
        p,
        Command(program: test, args: [], dir: None(), env: None(), own_group: false),
        b"",
        64u64,
        None()
      )
    )
  )
  let _ = out.print(
    output,
    outcome(
      proc.run(
        p,
        Command(program: test, args: [], dir: None(), env: None(), own_group: false),
        b"",
        64u64,
        None()
      )
    )
  )
  let _ = out.print(output, elapsed(c, start))
  Ok(())
}
