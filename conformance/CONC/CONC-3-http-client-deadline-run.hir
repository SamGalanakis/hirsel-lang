// stdout: expired deadline
// stdout: fresh
// Deadline cancellation discards a checked-out reused connection.
fn http_cause(error: http.HttpError) -> String {
  match error {
    Net(actual) => match actual {
      Canceled(cancel) => if cancel == DeadlineExceeded() {
        "deadline"
      } else {
        "failed"
      },
      _ => "failed",
    },
    _ => "failed",
  }
}

pub fn main(rt: Io, args: Args) -> Result[(), GrantError] {
  let tasks = io.tasks(rt)?
  let c = io.monotonic_clock(rt)?
  let n = io.net(rt)?
  let output = io.stdout(rt)?
  let mut client = match http.client(n, Some(c), http.default_config()) {
    Ok(client) => take client,
    Error(_) => return Ok(()),
  }
  let warm = http.client_fetch(mut client, Get(), "http://example.com/", [], None())
  failure.check(
    match warm {
      Ok(response) => response.body == b"ok",
      _ => false,
    },
    Arithmetic()
  )
  let start = match clock.monotonic(c) {
    Ok(at) => at,
    Error(_) => return Ok(()),
  }
  let at = match instant.checked_add(c, start, 1000u64) {
    Some(at) => at,
    None() => return Ok(()),
  }
  let owned_client = take client
  let bounded = task.scope_until(
    tasks,
    Deadline(clock: c, at: at),
    fn(s: Scope) -> (http.Client, String) {
      let mut current = take owned_client
      let status = match http.client_fetch(
        mut current,
        Get(),
        "http://example.com/",
        [],
        None()
      ) {
        Error(error) => http_cause(error),
        _ => "failed",
      }
      (take current, status)
    }
  )
  let (returned, text) = match take bounded {
    Expired((rest, status)) => (take rest, f"expired {status}\n"),
    Finished((rest, status)) => (take rest, f"finished {status}\n"),
  }
  let _ = out.print(output, text)
  let mut continued = take returned
  let fresh = http.client_fetch(mut continued, Get(), "http://example.com/", [], None())
  failure.check(
    match fresh {
      Ok(response) => response.body == b"ok",
      _ => false,
    },
    Arithmetic()
  )
  let _ = out.print(output, "fresh\n")
  Ok(())
}
