// rule: CONC-5
// expect: accept
// "it may capture inert values under the ordinary borrow rules".
// Passing the body literal with take does not change the parameter it is built for.
fn replace(tasks: Tasks, m: Mutex[List[u32]], n: u32) -> () {
  mutex.with(
    tasks,
    m,
    take fn(mut value: unique List[u32]) {
      let held = n
    }
  )
}
