// rule: CONC-3
// expect: run
// grant: clock
// process: {"provider":"process.script@1","rules":[{"program":"/bin/test"}],"runs":[],"children":[{"program":"/bin/test","args":[],"steps":[{"expect":[103,111]}]},{"program":"/bin/test","args":[],"steps":[{"print":[104,105]},{"exit":{"exited":3}}]}]}
// stdout: timed out
// stdout: exited 3
// stdout: at 0
// A scripted child takes no time: a wait deadline the clock already reached ends the child
// at once, without checking its Expect, and returns TimedOut; a child that ends first
// returns its status. Neither wait advances the clock.
fn after(c: MonotonicClock, start: Instant of c, ns: u64) -> Deadline {
  match instant.checked_add(c, start, ns) {
    Some(at) => Deadline(clock: c, at: at),
    None() => Deadline(clock: c, at: start),
  }
}

fn outcome(r: Result[ExitStatus, ProcessError]) -> String {
  match r {
    Ok(Exited(code)) => f"exited {code}\n",
    Ok(Signaled(n)) => f"signaled {n}\n",
    Error(TimedOut()) => "timed out\n",
    Error(_) => "failed\n",
  }
}

fn spawn(p: Proc) -> Result[Child of p, ProcessError] {
  proc.spawn(
    p,
    Command(program: path.of("/bin/test"), args: [], dir: None(), env: None())
  )
}

pub fn main(rt: Io, args: Args) -> Result[(), GrantError] {
  let output = io.stdout(rt)?
  let c = io.monotonic_clock(rt)?
  let p = io.process(rt)?
  let start = match clock.monotonic(c) {
    Ok(t) => t,
    Error(_) => return Ok(()),
  }
  match spawn(p) {
    Ok(waiting) => {
      let _ = out.print(
        output,
        outcome(child.wait(p, take waiting, Some(after(c, start, 0u64))))
      )
    },
    Error(_) => return Ok(()),
  }
  match spawn(p) {
    Ok(ending) => {
      let _ = out.print(
        output,
        outcome(child.wait(p, take ending, Some(after(c, start, 1000u64))))
      )
    },
    Error(_) => return Ok(()),
  }
  match clock.monotonic(c) {
    Ok(now) => {
      let _ = out.print(output, f"at {instant.ticks(now) - instant.ticks(start)}\n")
    },
    Error(_) => return Ok(()),
  }
  Ok(())
}
