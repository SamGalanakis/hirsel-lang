// rule: FACT-1
// expect: run
// The spec append ensures "list.len(xs) == before(list.len(xs)) + 1".
fn append[T](mut xs: List[T], take x: T) -> ()
  ensures list.len(xs) == before(list.len(xs)) + 1 {
  list.push(mut xs, take x)
}

pub fn main(rt: Io, args: Args) -> Result[(), CliError] {
  let mut xs: List[u32] = []
  append(mut xs, 7)
  Ok(())
}
