// rule: FACT-1
// expect: fail FACT-1 at line 15
// Plain early-return twin; the declared clause wins over caller division.
// Same executable input as plain_contract_22::ensures_early_false::helper.
type Pair {
  left: u32,
  right: u32,
}

fn predicate(a: u32, b: u32) -> bool {
  a == b
}

fn probe(p: Pair) -> Pair
  ensures predicate(result.left, p.right) {
  if p.left == 1u32 {
    return p
  }
  p
}

pub fn main() -> Result[(), u8] {
  let value = probe(Pair(left: 1u32, right: 2u32))
  if value.left != 1u32 {
    return Error(2u8)
  }
  let _ = 9u32 / 0u32
  Ok(())
}
