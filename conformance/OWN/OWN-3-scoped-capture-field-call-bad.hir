// rule: OWN-3
// expect: reject OWN-3 at line 27
type Rec {
  n: u64,
  name: String,
}

fn make(r: Rec) -> Option[u8 of r] {
  None
}

fn inspect(r: Rec, p: Option[u8 of r]) -> () {
  ()
}

fn bump(mut n: u64) -> () {
  n = 3u64
}

fn probe(take r0: Rec, take r1: Rec) -> () {
  let mut r = r0
  let p = make(r)
  let action = fn() {
    inspect(r, p)
  }
  action()
  bump(mut r.n)
  action()
}
