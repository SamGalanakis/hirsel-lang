// rule: OWN-8
// expect: accept
// "To move a part out of an owned value, destructure the whole." The
// destructured part may be assigned into other storage (issue #73).
resource type Token {
  n: u8,
}
drop(t) {}

type Holder {
  token: Token,
}

fn probe(take h: Holder) -> () {
  let mut r: Token = Token(n: 1u8)
  let Holder(token: token) = take h
  r = take token
}
