// rule: OWN-6
// expect: accept
// "A child task borrows nothing counted from its parent."
fn example(tasks: Tasks, take xs: unique Bytes) -> () {
  task.scope(
    tasks,
    fn(s: Scope) {
      let h = task.async(
        s,
        fn() {
          let _ = take xs
        }
      )
      task.await(s, take h)
    }
  )
}
