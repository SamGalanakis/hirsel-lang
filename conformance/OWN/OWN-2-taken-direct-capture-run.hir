// rule: OWN-2
// expect: run
resource type Token {
  value: u8,
}
drop(x) {
  failure.check(x.value == 7u8, Arithmetic())
}

fn make(take token: Token) -> once fn() -> () uses {} {
  fn() {
    let owned = take token
  }
}

pub fn main() -> Result[(), ()] {
  let token = Token(value: 7u8)
  let consume = make(take token)
  consume()
  Ok(())
}
