// rule: OWN-2
// expect: reject OWN-2 at line 16
// "Using a value after it has moved is a compile error."
// The rejected twin of CLO-4-scope-body-takes-let-mut-reassigned-run: the caller
// reads the `let mut` binding the scope body took without installing a new value.
pub fn main(rt: Io) -> Result[(), GrantError] {
  let tasks = io.tasks(rt)?
  let mut bytes: List[u8] = [1u8, 2u8]
  let taken = task.scope(
    tasks,
    fn(s: Scope) -> u64 {
      let owned = take bytes
      list.len(owned)
    }
  )
  failure.check(taken == 2u64 && list.len(bytes) == 2u64, Arithmetic())
  Ok(())
}
