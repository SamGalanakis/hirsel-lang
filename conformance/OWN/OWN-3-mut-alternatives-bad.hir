// rule: OWN-3
// expect: reject OWN-3 at line 13
// twin: MODE/MODE-1-owned-local-field-loop-reception-run.hir
// "A mut borrow is exclusive."
// Provisional reading (spec issue 50). Alternative places are not one place.
// A branch that names one of two bindings has nothing to lend exclusively.
fn first(mut a: Array[u64]) -> () {
  a[0] = 5
}

fn example(mut xs: Array[u64], mut ys: Array[u64], c: bool) -> () {
  first(
    mut if c {
      xs
    } else {
      ys
    }
  )
}
