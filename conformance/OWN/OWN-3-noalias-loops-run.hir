// rule: OWN-3
// expect: run
// stdout: 123506
// stdout: 493952
// stdout: 196180
// stdout: 784698
// stdout: 47
// stdout: 26
// The loop shapes behind Rust's LLVM `noalias` miscompiles, over Hirsel's
// exclusive places: two `mut` scalars stored to and reloaded alternately in an
// unrollable loop, element exchanges between two `mut` lists from sibling fields,
// and one record reached on alternate iterations through a field and through the
// whole, with the callee swapping its fields by `replace`.
type Pair {
  left: List[u64],
  right: List[u64],
  x: u64,
  y: u64,
}

fn mix(mut a: u64, mut b: u64, rounds: u64) -> () {
  let mut i = 0u64
  while i < rounds {
    a = b % 1000003u64 + i
    b = (a * 3u64 + b) % 1000003u64
    i += 1u64
  }
}

fn exchange(mut a: List[u64], mut b: List[u64]) -> () {
  let mut k = 0u64
  while k < list.len(a) && k < list.len(b) {
    let t = a[k]
    a[k] = b[k]
    b[k] = t + a[k]
    k += 1u64
  }
}

fn turn(mut p: Pair) -> () {
  let old = replace(mut p.left, take [])
  let older = replace(mut p.right, take old)
  p.left = older
  p.x += list.len(p.left)
}

fn sum(xs: List[u64]) -> u64 {
  let mut s = 0u64
  for x in xs {
    s += x
  }
  s
}

fn line(out: Stdout, value: u64) -> () {
  let _ = out.print(out, u64.to_string(value))
  let _ = out.print(out, "\n")
}

pub fn main(rt: Io) -> Result[(), GrantError] {
  let out = io.stdout(rt)?
  let mut p = Pair(left: [1u64, 2u64, 3u64], right: [4u64, 5u64], x: 7u64, y: 11u64)
  mix(mut p.x, mut p.y, 37u64)
  let mut xs: List[u64] = [1u64, 2u64, 3u64, 4u64]
  let mut ys: List[u64] = [9u64, 8u64, 7u64, 6u64]
  let mut i = 0u64
  while i < 4u64 {
    mix(mut xs[i], mut ys[3u64 - i], 5u64 + i)
    i += 1u64
  }
  let mut round = 0u64
  while round < 6u64 {
    if round % 2u64 == 0u64 {
      list.push(mut p.left, round + p.x % 10u64)
      exchange(mut p.left, mut p.right)
    } else {
      turn(mut p)
    }
    round += 1u64
  }
  line(out, p.x)
  line(out, p.y)
  line(out, sum(xs))
  line(out, sum(ys))
  line(out, sum(p.left))
  line(out, sum(p.right))
  Ok(())
}
