// rule: OWN-4
// expect: run
fn change[V: copyable](mut m: Map[u64, V], f: fn(mut v: V) -> () uses {}) {
  let _ = std@1/map.update_value(mut m, 1, f)
}

pub fn main() -> Result[(), String] {
  let mut m: Map[u64, u64] = map.empty()
  map.insert(mut m, 1, 10)
  change(
    mut m,
    fn(mut v: u64) -> () uses {} {
      v += 1
    }
  )
  failure.check(map.get(m, 1) == Some(11u64), Bounds())
  Ok(())
}
