// rule: OWN-8
// expect: reject OWN-8 at line 22
// twin: OWN/OWN-8-loop-field-identity-view-ok.hir
type Holder[F] {
  action: F,
}

fn relay[F](take f: F) -> F {
  f
}

fn use_pos(s: Dir, p: u64 of s) {}

fn probe(s: Dir, p: u64 of s) {
  let alias = s
  let action: once fn() = fn() {
    use_pos(alias, p)
    let _ = take alias
  }
  let holder: Holder[once fn()] = Holder(action: take action)
  let forwarded = relay(take holder)
  forwarded.action()
}
