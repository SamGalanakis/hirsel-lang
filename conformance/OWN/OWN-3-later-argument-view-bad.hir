// rule: OWN-3
// expect: reject OWN-3 at line 13
// A later argument may read the reserved place, but a value that still
// borrows it when the callee is entered overlaps the exclusive loan.
fn view(xs: List[u64]) -> List[u64] in xs {
  xs
}

fn f(mut xs: List[u64], ys: List[u64]) -> () {}

fn main() -> () {
  let mut xs: List[u64] = [1]
  f(mut xs, view(xs))
}
