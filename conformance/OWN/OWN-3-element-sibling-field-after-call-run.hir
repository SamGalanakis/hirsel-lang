// rule: OWN-3
// expect: run
// stdout: ok
// The ordering twin of OWN-3-element-sibling-field-block-argument-run. The
// sibling write to the shared list's element follows the call that reads its
// name, so no loan is live when the list detaches (OWN-4).
type R {
  name: String,
  n: u64,
}

fn len(s: String, k: u64) -> u64 {
  string.byte_len(s) + k
}

fn sibling() -> u64 {
  let mut xs: List[R] = [R(name: "ab", n: 1)]
  let i = 0u64
  let ys = copy xs
  let r = len(xs[i].name, 1)
  xs[i].n = 5
  r + xs[0].n * 10 + ys[0].n * 100
}

pub fn main(rt: Io, args: Args) -> Result[(), GrantError] {
  let ok = sibling() == 153
  let _ = out.print(
    io.stdout(rt)?,
    if ok {
      "ok\n"
    } else {
      "bad\n"
    }
  )
  Ok(())
}
