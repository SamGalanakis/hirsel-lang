// rule: OWN-2
// expect: accept
// A while-let evaluates its value before every iteration, so taking a binding
// there moves it again after the first.
fn total(source: List[Option[String]]) -> u64 {
  let mut xs: unique List[Option[String]] = unique source
  let mut n = 0u64
  while let Some(Some(s)) = list.pop(mut xs) {
    n += string.byte_len(s)
  }
  n
}
