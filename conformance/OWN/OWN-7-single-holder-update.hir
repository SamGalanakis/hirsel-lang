// rule: OWN-7
// expect: run
// stdout: ok
// "A block whose count says one holder may be mutated ... in place."
pub fn main(rt: Io, args: Args) -> Result[(), LaunchError] {
  let mut xs: Array[u64] = [1, 2]
  xs[0] = 9
  if (xs[0], xs[1]) == (9, 2) {
    out.print(io.stdout(rt) ? Grant, "ok\n") ? Output
  } else {
    out.print(io.stdout(rt) ? Grant, "wrong\n") ? Output
  }
  Ok(())
}

pub type LaunchError = Grant(GrantError) | Output(OutputError) | Usage(ArgError) | Files(
  FileError
)
