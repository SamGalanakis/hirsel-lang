// rule: OWN-2
// expect: reject OWN-2 at line 12
// Under LANG-11 (#50), a branch is transparent to its consumer's use. The `else`
// arm passes the outer place `t` itself to a take parameter without `take`,
// as `consume(t)` does (#83).
fn consume(take x: String) -> () {
  ()
}

fn example(c: bool) -> () {
  let t: String = "x"
  consume(
    if c {
      "y"
    } else {
      t
    }
  )
}
