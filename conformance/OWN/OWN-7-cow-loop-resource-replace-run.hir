// rule: OWN-7
// expect: run
resource type Trace {
  stdout: Stdout,
  text: String,
}
drop(x) {}

pub fn main(rt: Io, args: Args) -> Result[(), GrantError] {
  let o = io.stdout(rt)?
  let mut m: Map[u8, Trace] = map.empty()
  for (k, v) in mut m {
    v = Trace(
      stdout: fn() {
        o
      }(),
      text: "new\n"
    )
  }
  Ok(())
}
