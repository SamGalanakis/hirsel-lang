// rule: OWN-8
// expect: accept
fn probe_file_narrow(d: Dir, take f: File of d) {
  let value = file.narrow(d, take f)
  let _ = match take value {
    Some(h) => (),
    None => (),
  }
}

fn probe_file_open(d: Dir) {
  let value = file.open(d, path.of("a"))
  let _ = match take value {
    Ok(h) => (),
    Error(e) => (),
  }
}

fn probe_file_walk(d: Dir) {
  let value = file.walk(d)
  let _ = match take value {
    Ok(h) => (),
    Error(e) => (),
  }
}

fn probe_io_dir(rt: Io) {
  let value = io.dir(rt, path.of("."))
  let _ = match take value {
    Ok(h) => (),
    Error(e) => (),
  }
}

fn probe_slots_get(s: Slots[String], id: SlotId[String] of s) {
  let value = slots.get(s, id)
  let _ = match take value {
    Some(h) => (),
    None => (),
  }
}

fn probe_slots_remove(mut s: Slots[String], id: SlotId[String] of s) {
  let value = slots.remove(mut s, id)
  let _ = match take value {
    Some(h) => (),
    None => (),
  }
}

