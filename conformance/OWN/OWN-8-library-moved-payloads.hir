fn probe_int_try_narrow() {
  let value: Option[u8] = int.try_narrow(10u64)
  let _ = match take value {
    Some(h) => (),
    None => (),
  }
}

fn probe_string_from_bytes() {
  let value = string.from_bytes(b"a")
  let _ = match take value {
    Ok(h) => (),
    Error(e) => (),
  }
