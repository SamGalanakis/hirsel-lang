// rule: OWN-6
// expect: run
// stdout: ok
// "Unique values move, and their blocks become the receiving task’s."
pub fn main(rt: Io, args: Args) -> Result[(), LaunchError] {
  let grant_stdout = io.stdout(rt) ? Grant
  let xs: Array[u64] = [3, 5]
  let n = task.scope(
    io.tasks(rt) ? Grant,
    fn(s: Scope) {
      let h = task.async(
        s,
        fn() {
          let owned = take xs
          owned[0] + owned[1]
        }
      )
      task.await(s, take h)
    }
  )
  if n == 8 {
    out.print(grant_stdout, "ok\n") ? Output
  } else {
    out.print(grant_stdout, "wrong\n") ? Output
  }
  Ok(())
}

pub type LaunchError = Grant(GrantError) | Output(OutputError) | Usage(ArgError) | Files(
  FileError
)
