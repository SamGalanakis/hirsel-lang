// rule: OWN-1
// expect: reject OWN-1 at line 12
resource type Trace {
  stdout: Stdout,
  text: String,
}
drop(x) {
  let _ = out.print(x.stdout, x.text)
}

fn store(mut h: Trace, x: Trace) -> () {
  h = x
}

pub fn main(rt: Io, args: Args) -> Result[(), GrantError] {
  let stdout = io.stdout(rt)?
  let mut a = Trace(stdout: stdout, text: "a\n")
  let b = Trace(stdout: stdout, text: "b\n")
  store(mut a, b)
  Ok(())
}
