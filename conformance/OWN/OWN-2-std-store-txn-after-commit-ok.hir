// rule: OWN-2
// expect: accept
// After store.commit takes a transaction, a further write begins a new one.
pub fn main(t: Test) -> Result[(), store.StoreError] {
  let d = test.dir(t, [])
  let mut s = store.open(d, store.default_config())?
  let mut x = store.begin(mut s)
  let _ = store.commit(mut s, take x)?
  let mut y = store.begin(mut s)
  txn.put(mut y, b"k", b"v")
  Ok(())
}
