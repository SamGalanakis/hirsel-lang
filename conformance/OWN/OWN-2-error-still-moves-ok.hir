// rule: OWN-2
// expect: accept
// "Use-after-move is a compile error" even when the callee returns Error.
type Problem = Stop()

fn consume(take x: Bytes) -> Result[(), Problem] {
  Error(Stop)
}

fn inspect(x: Bytes) -> () {
  ()
}

fn example(take x: Bytes) -> () {
  let _ = consume(copy x)
  inspect(x)
}
