// rule: OWN-3
// expect: fail MEM-14 at line 30
// stdout: changed
resource type Observer {
  stdout: Stdout,
  m: Map[u64, List[u64]],
  saved: Map[u64, List[u64]],
}
drop(x) {
  if map.get(x.m, 1) == Some([11u64]) && map.get(x.saved, 1) == Some([10u64]) && map.len(
    x.m
  ) == 1 {
    let _ = out.print(x.stdout, "changed\n")
  } else {
    let _ = out.print(x.stdout, "wrong\n")
  }
}

pub fn main(rt: Io, args: Args) -> Result[(), GrantError] {
  let stdout = io.stdout(rt)?
  let mut m: Map[u64, List[u64]] = map.empty()
  map.insert(mut m, 1, [10])
  let saved = copy m
  let mut owner = Observer(stdout: stdout, m: take m, saved: take saved)
  let _ = std@1/map.update_value(
    mut owner.m,
    1,
    fn(mut v: List[u64]) -> () uses {} {
      v = [11]
      failure.check(false, Bounds())
    }
  )
  Ok(())
}
