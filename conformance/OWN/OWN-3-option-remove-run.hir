// rule: OWN-3
// expect: run
// Adapted from Rust core::option::Option::take documentation examples.
fn remove[T](mut value: Option[T]) -> Option[T] {
  replace(mut value, None)
}

pub fn main() -> Result[(), ()] {
  let mut value: Option[u64] = Some(2)
  let previous = remove(mut value)
  failure.check(previous == Some(2u64) && value == None, Bounds())
  let empty = remove(mut value)
  failure.check(empty == None && value == None, Bounds())
  value = Some(7u64)
  let removed = option.remove(mut value)
  failure.check(removed == Some(7u64) && value == None, Bounds())
  failure.check(option.remove(mut value) == None, Bounds())
  Ok(())
}
