// rule: LANG-9
// expect: run
// entry: trial
pub fn trial(t: Test) -> Result[(), ()] {
  test.assert_eq(t, 2u64 + 2, 4, u64.to_string)
  test.assert_eq(t, "a\"b\n", "a\"b\n", test.quoted)
  let xs: List[u64] = [1, 2]
  test.assert_eq(
    t,
    xs,
    [1, 2],
    fn(values: List[u64]) -> String {
      test.show_list(values, u64.to_string)
    }
  )
  test.check(t, test.show_list(xs, u64.to_string) == "[1, 2]")
  test.check(t, test.quoted("\u{1}\t\\") == "\"\\u{01}\\t\\\\\"")
  Ok(())
}
