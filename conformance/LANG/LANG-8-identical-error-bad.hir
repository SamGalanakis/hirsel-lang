// rule: LANG-8
// expect: reject LANG-8 at line 15
// Shows "plain e? propagates an identical error unchanged; otherwise it injects through an arm."
type Inner = Missing()

type Outer = Wrapped(u32)

@noalloc
fn read(r: Result[u32, Inner]) -> Result[u32, Inner] {
  r
}

@noalloc
fn example(r: Result[u32, Inner]) -> Result[u32, Outer] {
  let n = read(r)?
  Ok(n)
}
