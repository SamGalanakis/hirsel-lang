// rule: LANG-9
// expect: run
// entry: trial
fn gen(t: Test) -> String {
  test.check(t, true)
  std@1/u64.to_string(7)
}

fn law(s: String) -> bool uses {} {
  s == "7"
}

pub fn trial(t: Test) -> Result[(), ()] {
  std@1/test.for_all(t, gen, law)
  Ok(())
}

pub fn main(rt: Io, args: Args) -> Result[(), ()] {
  Ok(())
}
