// rule: LANG-2
// expect: run
// boundary: Local placement stays legal in noalloc; an escaping List cannot become Inline.
@noalloc
fn inferred(x: u64) -> u64 {
  let xs = [x, x]
  xs[1]
}

@noalloc
fn contextual(x: u64) -> u64 {
  let xs: List[u64] = [x, x]
  xs[1]
}

pub fn main() -> Result[(), ()] {
  failure.check(inferred(3u64) == 3 && contextual(4u64) == 4, Arithmetic())
  Ok(())
}
