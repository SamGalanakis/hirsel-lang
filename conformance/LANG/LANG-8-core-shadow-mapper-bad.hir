// rule: LANG-8
// expect: reject LANG-8 at line 9
// twin: LANG/LANG-8-core-shadow-mapper-ok.hir
// With no `Net` variant in the expected error, `? Net` names core's Net type,
// which is not a mapper.
pub type AppError = Network(NetError) | Other

fn connect(r: Result[u64, NetError]) -> Result[u64, AppError] {
  let n = r ? Net
  Ok(n)
}
