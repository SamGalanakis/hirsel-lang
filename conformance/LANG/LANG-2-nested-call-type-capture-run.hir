// rule: LANG-2
// expect: run
// stdout: ok
fn outer(x: u8) -> u8 {
  fn inner[U: plain](y: U) -> u8 {
    let z = y
    x
  }
  inner(1u64)
}

fn output_error[E](take e: E) {}

pub fn main(rt: Io, args: Args) -> Result[(), ()] {
  out.print(
    io.stdout(rt) ? grant_error,
    if outer(7u8) == 7u8 {
      "ok\n"
    } else {
      "bad\n"
    }
  ) ? output_error
  Ok(())
}

@noalloc
fn grant_error(refusal: GrantError) -> () uses {} {
  ()
}
