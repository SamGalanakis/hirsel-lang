// rule: LANG-8
// expect: accept
fn load() -> Result[bool, String] {
  Ok(true)
}

fn encode(value: bool) -> Bytes {
  b"x"
}

fn fake_decode() -> Result[Bytes, String] {
  let decoded: Result[bool, String] = load()
  Ok(encode(decoded?))
}

pub fn decode(data: Bytes) -> Result[Bytes, DecodeError] {
  let decoded: Result[bool, DecodeError] = codec.decode(data)
  Ok(codec.encode(decoded?))
}
