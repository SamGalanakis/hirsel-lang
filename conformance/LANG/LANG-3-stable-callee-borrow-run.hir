// rule: LANG-3
// expect: run
// entry: test_stable
fn make(base: u64) -> fn(u64) -> u64 uses {} {
  let payload: List[u64] = [base]
  fn(x: u64) -> u64 uses {} {
    payload[0u64] + x
  }
}

pub fn test_stable(t: Test) -> Result[(), ()] {
  let mut f = make(7u64)
  test.check(t, f(0u64) == 7u64)
  Ok(())
}
