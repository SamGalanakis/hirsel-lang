// rule: LANG-9
// expect: fail LANG-9 at line 25
// stdout: test log: counterexample: [2]
// stdout: test failure: seed=0 case=0
// entry: trial
// minithesis b20e7e9 test_minithesis.py:613-635.
// Invalid paths satisfy the law; zero-probability draws use choice(0).
fn generate(mut s: test.Source) -> List[u64] {
  let first = test.choice(mut s, 6)
  if first == 6 || first == 4 {
    let _ = test.choice(mut s, 0)
  }
  [first]
}

fn law(xs: List[u64]) -> bool uses {} {
  xs[0] != 2 && xs[0] != 4 && xs[0] != 6
}

fn show(xs: List[u64]) -> String {
  test.show_list(xs, u64.to_string)
}

pub fn trial(t: Test) -> Result[(), ()] {
  test.property_cases(t, 1000, generate, law, show)
  Ok(())
}
