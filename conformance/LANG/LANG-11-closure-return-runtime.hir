// rule: LANG-11
// expect: run
// stdout: 8
// Shows "A block’s value is its final expression."
@noalloc
fn example(x: u64) -> u64 {
  let f = fn(y: u64) -> u64 {
    if y == 0 {
      return 7
    }
    y
  }
  f(x) + 1
}

pub fn main(rt: Io, args: Args) -> Result[(), GrantError] {
  let _ = out.print(io.stdout(rt)?, u64.to_string(example(0)))
  let _ = out.print(io.stdout(rt)?, "\n")
  Ok(())
}
