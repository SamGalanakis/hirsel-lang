// rule: LANG-13
// expect: run
// IEEE equality: both signs of zero match zero, NaN matches no literal,
// and the smallest positive subnormal matches only its exact value.
fn single(value: f32, enabled: bool) -> i32 {
  match value {
    1.5f32 if enabled => 1,
    1.5f32 => 2,
    0.0f32 => 3,
    1e-45f32 => 4,
    _ => 0,
  }
}

fn double(value: f64) -> i32 {
  match value {
    1.5f64 => 1,
    0.0f64 => 2,
    5e-324f64 => 3,
    _ => 0,
  }
}

fn nested(value: Option[(f32, f64)]) -> i32 {
  match value {
    Some((0.0f32, 5e-324f64)) => 1,
    Some((1e-45f32, 0.0f64)) => 2,
    _ => 0,
  }
}

pub fn main(t: Test) -> Result[(), ()] {
  test.check(t, single(1.5f32, true) == 1)
  test.check(t, single(1.5f32, false) == 2)
  test.check(t, single(0.0f32, true) == 3)
  test.check(t, single(-0.0f32, true) == 3)
  test.check(t, single(f32.from_bits(1u32), true) == 4)
  test.check(t, single(f32.from_bits(2u32), true) == 0)
  test.check(t, single(f32.from_bits(2143289344u32), true) == 0)
  test.check(t, single(-1.5f32, true) == 0)
  test.check(t, double(1.5f64) == 1)
  test.check(t, double(0.0f64) == 2)
  test.check(t, double(-0.0f64) == 2)
  test.check(t, double(f64.from_bits(1u64)) == 3)
  test.check(t, double(f64.from_bits(2u64)) == 0)
  test.check(t, double(f64.from_bits(9221120237041090560u64)) == 0)
  test.check(t, double(-1.5f64) == 0)
  test.check(t, nested(Some((-0.0f32, f64.from_bits(1u64)))) == 1)
  test.check(t, nested(Some((f32.from_bits(1u32), -0.0f64))) == 2)
  test.check(t, nested(Some((f32.from_bits(2143289344u32), 0.0f64))) == 0)
  test.check(t, nested(None) == 0)
  Ok(())
}
