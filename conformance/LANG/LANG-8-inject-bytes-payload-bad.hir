// rule: LANG-8
// expect: reject LANG-8 at line 8
// twin: LANG/LANG-8-inject-bytes-payload-ok.hir
// A Bytes error, as from string.from_bytes, is not nominal and needs `? Utf8`.
type ConfigError = Utf8(Bytes) | Empty

fn text(take data: Bytes) -> Result[String, ConfigError] {
  let s = string.from_bytes(take data)?
  Ok(s)
}
