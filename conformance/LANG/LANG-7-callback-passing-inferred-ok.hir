// rule: LANG-7
// expect: accept
// A callback's parameter passing modes are part of its type.
pub fn main(rt: Io, args: Args) -> Result[(), LaunchError] {
  task.scope(
    io.tasks(rt) ? Grant,
    fn(s: Scope) {
      let h = task.async(
        s,
        fn() -> u32 {
          7
        }
      )
      task.detach(s, take h)
    }
  )
  Ok(())
}

pub type LaunchError = Grant(GrantError) | Output(OutputError) | Usage(ArgError) | Files(
  FileError
)
