// rule: LANG-13
// expect: reject LANG-13 at line 6
// twin: LANG/LANG-13-let-else-initializer-ok.hir
// A let-else initializer cannot end in a block, which would take the else.
fn pick(fresh: bool, x: Option[u32]) -> u32 {
  let Some(n) = if fresh { x } else { None } else {
    return 0
  }
  n
}
