// rule: LANG-2
// expect: accept
// A bare name that resolution bound to a provisional pattern local, which the
// checked scrutinee type selects as a nullary variant, names that variant.
fn pick(o: Option[u64]) -> Option[u64] {
  match fn() {
    o
  }() {
    Some(x) => Some(x),
    None => None,
  }
}
