type Value = Empty | Number(u64)

// An owned heap construction cannot refill a borrowed cursor.
fn refill(value: box Value) {
  let mut cursor = value
  cursor = box Number(1u64)
}

pub fn main() -> Result[(), ()] {
  Ok(())
}
