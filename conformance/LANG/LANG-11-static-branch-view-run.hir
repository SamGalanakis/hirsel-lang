// rule: LANG-11
// expect: run
fn arm(s: String, n: u64) -> u64 {
  string.byte_len(
    match n {
      0 => s,
      _ => "x",
    }
  )
  string.byte_len(
    match n {
      0 => s,
      _ => "x",
    }
  )
}

pub fn main(rt: Io, args: Args) -> Result[(), ()] {
  failure.check(arm("ab", 0) == 2 && arm("ab", 1) == 1, Arithmetic())
  Ok(())
}
