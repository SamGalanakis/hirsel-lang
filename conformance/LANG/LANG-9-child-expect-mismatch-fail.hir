// rule: LANG-9
// expect: fail LANG-9 at line 12
// stdout: test failure: child /bin/cat expected b"ping\n" but the program wrote b"pong\n"
// entry: trial
pub fn trial(t: Test) -> Result[(), ProcessError] {
  let p = test.process(
    t,
    [],
    [ChildScript(program: "/bin/cat", args: [], steps: [Expect(b"ping\n")])]
  )
  let mut c = proc.spawn(p, plain(path.of("/bin/cat")))?
  child.write(p, mut c, b"pong\n")?
  Ok(())
}

fn plain(program: Path) -> Command {
  Command(program: program, args: [], dir: None(), env: None())
}
