// rule: LANG-2
// expect: reject LANG-2 at line 11
// "Type arguments are never written in expressions."
// Without an immediate expected callable type, this name cannot choose
// its type arguments from the later use.
fn identity[T](take x: T) -> T {
  x
}

fn example() -> u64 {
  let f = identity
  f(1u64)
}
