// rule: LANG-8
// expect: run
// A plain ? injects through the one arm whose payload is the propagated error.
type ParseError = Empty | TooLong(u64)

type AppError = Input(ParseError) | Limit(u64)

fn parse(n: u64) -> Result[u64, ParseError] {
  if n == 0 {
    return Error(Empty())
  }
  if n > 9 {
    return Error(TooLong(n))
  }
  Ok(n)
}

fn run(n: u64) -> Result[u64, AppError] {
  let parsed = parse(n)?
  Ok(parsed + 1)
}

pub fn main(t: Test) -> Result[(), ()] {
  test.check(t, run(3) == Ok(4))
  test.check(t, run(0) == Error(Input(Empty())))
  test.check(t, run(12) == Error(Input(TooLong(12))))
  Ok(())
}
