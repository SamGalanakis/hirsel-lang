// rule: LANG-8
// expect: run
// stdout: mapped
// stdout: ok
// Shows "plain e? requires identical error types."
type Inner = Missing()

type Outer = Wrapped(Inner)

@noalloc
fn read(r: Result[u32, Inner]) -> Result[u32, Inner] {
  r
}

@noalloc
fn mapped(r: Result[u32, Inner]) -> Result[u32, Outer] {
  let n = read(r) ? Wrapped
  Ok(n)
}

pub fn main(rt: Io, args: Args) -> Result[(), ()] {
  let failed: Result[u32, Inner] = Error(Missing)
  let succeeded: Result[u32, Inner] = Ok(7)
  let _ = out.print(
    io.stdout(rt) ? grant_error,
    if mapped(failed) == Error(Wrapped(Missing)) {
      "mapped\n"
    } else {
      "wrong\n"
    }
  )
  let _ = out.print(
    io.stdout(rt) ? grant_error,
    if mapped(succeeded) == Ok(7) {
      "ok\n"
    } else {
      "wrong\n"
    }
  )
  Ok(())
}

@noalloc
fn grant_error(refusal: GrantError) -> () uses {} {
  ()
}
