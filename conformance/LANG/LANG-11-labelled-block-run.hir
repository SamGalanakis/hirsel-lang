// rule: LANG-11
// expect: run
// exit: 0
fn find(rows: List[List[u64]], wanted: u64) -> Option[(u64, u64)] {
  'search: {
    for i in 0u64..list.len(rows) {
      for j in 0u64..list.len(rows[i]) {
        if rows[i][j] == wanted {
          break 'search Some((i, j))
        }
      }
    }
    None()
  }
}

fn classify(n: u64) -> String {
  let name: String = 'name: {
    if n == 0 {
      break 'name "zero"
    }
    match n % 2 {
      0 => {
        let half = n / 2
        if half == 1 {
          break 'name "two"
        }
      },
      _ => (),
    }
    "other"
  }
  name
}

fn first_even(values: List[u64]) -> u64 {
  let found = 'found: {
    for v in values {
      if v % 2 == 0 {
        break 'found v + 100
      }
    }
    0u64
  }
  found
}

pub fn main() -> Result[(), String] {
  let rows: List[List[u64]] = [[1, 2], [3, 7], [7]]
  failure.check(find(rows, 7) == Some((1u64, 1u64)), TextInvariant())
  failure.check(find(rows, 9) == None(), TextInvariant())
  failure.check(classify(0) == "zero", TextInvariant())
  failure.check(classify(2) == "two", TextInvariant())
  failure.check(classify(5) == "other", TextInvariant())
  failure.check(first_even([1, 3, 4, 6]) == 104, TextInvariant())
  failure.check(first_even([1, 3]) == 0, TextInvariant())
  let mut count: u64 = 0
  'unit: {
    count += 1
    if count == 1 {
      break 'unit
    }
    count += 1000
  }
  failure.check(count == 1, TextInvariant())
  'outer: for i in 0u64..3 {
    'skip: {
      if i == 1 {
        continue 'outer
      }
      if i == 2 {
        break 'outer
      }
      count += 10
    }
    count += 100
  }
  failure.check(count == 111, TextInvariant())
  let nested: u64 = 'a: {
    let inner: u64 = 'b: {
      if count > 0 {
        break 'a 5
      }
      1
    }
    inner + 1000
  }
  failure.check(nested == 5, TextInvariant())
  let plain = 'plain: {
    41u64 + 1
  }
  failure.check(plain == 42, TextInvariant())
  Ok(())
}
