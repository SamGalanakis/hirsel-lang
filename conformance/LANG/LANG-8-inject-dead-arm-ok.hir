// rule: LANG-8
// expect: accept
// An arm of a package-private error type that nothing constructs is a warning, not an error:
// `Stale` warns here (error_injection.rs in the driver tests asserts the warning).
type ParseError = Empty | Stale

type AppError = Input(ParseError)

fn parse(n: u64) -> Result[u64, ParseError] {
  if n == 0 {
    return Error(Empty())
  }
  Ok(n)
}

fn run(n: u64) -> Result[u64, AppError] {
  let v = parse(n)?
  Ok(v)
}
