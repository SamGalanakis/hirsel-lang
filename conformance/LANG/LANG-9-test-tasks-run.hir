// rule: LANG-9
// expect: run
// entry: trial
// A test's own tasks come from its Test capability (`test.tasks`): they run under the
// run's scheduler and need no Io grant.
pub fn trial(t: Test) -> Result[(), ()] {
  let tasks = test.tasks(t)
  let (sender, receiver): (Sender[u64], Receiver[u64]) = channel.open(tasks)
  let total = task.scope(
    tasks,
    fn(s: Scope) -> u64 {
      let child = task.async(
        s,
        fn() {
          let mut tx = take sender
          let _ = channel.send(tasks, mut tx, 1u64)
          let _ = channel.send(tasks, mut tx, 2u64)
        }
      )
      let mut rx = take receiver
      let first = match channel.receive(tasks, mut rx) {
        Ok(value) => value,
        Error(_) => 0u64,
      }
      let second = match channel.receive(tasks, mut rx) {
        Ok(value) => value,
        Error(_) => 0u64,
      }
      task.await(s, take child)
      first * 10u64 + second
    }
  )
  test.check(t, total == 12u64)
  Ok(())
}

pub fn main(rt: Io, args: Args) -> Result[(), ()] {
  Ok(())
}
