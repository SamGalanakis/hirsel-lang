type Inner = Missing()

type Outer = Wrapped(Inner)

@noalloc
fn read(r: Result[u32, Inner]) -> Result[u32, Inner] {
  r
}

@noalloc
fn convert(e: u32) -> Outer {
  Wrapped(Missing)
}

@noalloc
fn example(r: Result[u32, Inner]) -> Result[u32, Outer] {
  let n = read(r) ? convert
  Ok(n)
}
