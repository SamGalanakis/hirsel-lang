// rule: LANG-8
// expect: reject LANG-8 at line 20
// Shows "plain e? requires identical error types."
type Inner = Missing()

type Outer = Wrapped(Inner)

@noalloc
fn read(r: Result[u32, Inner]) -> Result[u32, Inner] {
  r
}

@noalloc
fn convert(e: Inner) -> Inner {
  e
}

@noalloc
fn example(r: Result[u32, Inner]) -> Result[u32, Outer] {
  let n = read(r) ? convert
  Ok(n)
}
