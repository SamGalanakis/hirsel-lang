// rule: LANG-10
// expect: fail LANG-10 at line 29
// Shows "Every other site stays ordinary recursion under the limit above: a `let`-bound result."
type Chain = End | Link(u64, box Chain)

fn sum(take c: box Chain) -> u64 {
  let mut cur = take c
  let mut total = 0u64
  let mut going = true
  while going {
    match take cur {
      End => {
        going = false
        cur = box End
      },
      Link(n, next) => {
        total = total + n
        cur = take next
      },
    }
  }
  total
}

fn chain(n: u64) -> Chain {
  if n == 0 {
    End
  } else {
    let rest = chain(n - 1)
    Link(n, box rest)
  }
}

pub fn main(rt: Io, args: Args) -> Result[(), GrantError] {
  let c = box chain(2000)
  let _ = out.print(io.stdout(rt)?, u64.to_string(sum(take c)))
  let _ = out.print(io.stdout(rt)?, "\n")
  Ok(())
}
