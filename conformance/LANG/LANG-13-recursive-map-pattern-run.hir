// rule: LANG-13
// expect: run
type V = I(i64) | L(List[V]) | T(Map[String, V])

fn count(items: Map[String, V]) -> u64 {
  let mut n = 0u64
  for (_, e) in items {
    if let T(m) = e {
      n += map.len(m)
    }
  }
  n
}

pub fn main() -> Result[(), ()] {
  let mut child: Map[String, V] = map.empty()
  map.insert(mut child, unique "a", I(1))
  let mut m: Map[String, V] = map.empty()
  map.insert(mut m, unique "first", I(0))
  map.insert(mut m, unique "second", T(child))
  failure.check(count(m) == 1, TextInvariant())
  Ok(())
}
