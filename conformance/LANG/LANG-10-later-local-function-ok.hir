// rule: LANG-10
// expect: accept
// Shows "Only top-level definitions recurse; local fns cannot refer to themselves or later locals."
// Local function signatures allow allocation by default (#2).
fn example(n: u32) -> u32 {
  fn second(x: u32) -> u32 {
    x
  }
  fn first(x: u32) -> u32 {
    second(x)
  }
  first(n)
}
