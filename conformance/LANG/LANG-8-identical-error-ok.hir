// rule: LANG-8
// expect: accept
// Shows "plain e? requires identical error types."
type Inner = Missing()

type Outer = Wrapped(Inner)

@noalloc
fn read(r: Result[u32, Inner]) -> Result[u32, Inner] {
  r
}

@noalloc
fn example(r: Result[u32, Inner]) -> Result[u32, Inner] {
  let n = read(r)?
  Ok(n)
}
