type Value = Leaf | Array(List[Value]) | Tagged(value: box Value)

fn bad(value: Value) -> bool uses {} {
  let mut c = value
  match c {
    Tagged(value: inner) => {
      c = inner
    },
    _ => {},
  }
  true
}

