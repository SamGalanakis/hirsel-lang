// rule: LANG-15
// expect: reject LANG-15 at line 14
// twin: LANG/LANG-15-borrow-cursor-tree-ok.hir
type Tree = Leaf(n: u64) | Branch(left: box Tree, right: box Tree)

fn leaf(root: box Tree) -> u64 {
  let mut node = root
  while true {
    match node {
      Leaf(n: n) => {
        return n;
      },
      Branch(left: child, right: _) => {
        node = copy child
      },
    }
  }
  0
}
