// rule: LANG-9
// expect: fail LANG-9 at line 9
// stdout: test log: assertion failed: actual == expected
// stdout: test log:   actual: "a\\"b\\n"
// stdout: test log: expected: "a\\"b"
// entry: trial
pub fn trial(t: Test) -> Result[(), ()] {
  test.assert_eq(t, 2u64 + 2, 4, u64.to_string)
  test.assert_eq(t, "a\"b\n", "a\"b", test.quoted)
  Ok(())
}
