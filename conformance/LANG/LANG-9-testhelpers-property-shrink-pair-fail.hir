// rule: LANG-9
// expect: fail LANG-9 at line 27
// stdout: test log: counterexample: 1 1000
// stdout: test failure: seed=0 case=4
// entry: trial
// minithesis test_reduces_additive_pairs: redistribution reaches 1 and 1000.
type Pair {
  m: u64,
  n: u64,
}

fn pair(mut s: test.Source) -> Pair {
  let m = test.choice(mut s, 1000)
  let n = test.choice(mut s, 1000)
  Pair(m: m, n: n)
}

fn bounded(p: Pair) -> bool uses {} {
  p.m + p.n <= 1000
}

fn show(p: Pair) -> String {
  string.concat(string.concat(u64.to_string(p.m), " "), u64.to_string(p.n))
}

pub fn trial(t: Test) -> Result[(), ()] {
  test.property_cases(t, 1000, pair, bounded, show)
  Ok(())
}
