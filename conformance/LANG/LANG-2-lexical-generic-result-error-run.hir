// rule: LANG-2
// expect: run
pub fn main() -> Result[(), String] {
  fn identity[T](take value: T) -> T {
    value
  }
  let f: fn(take Result[u64, String]) -> Result[u64, String] uses {} = identity
  failure.check(f(Ok(43u64))? == 43, Bounds())
  failure.check(f(Error("kept")) == Error("kept"), Bounds())
  Ok(())
}
