// rule: LANG-13
// expect: reject LANG-13 at line 8
// A let-else or-pattern binds plain values or takes its payloads: a borrowed
// binding would view one of several places past the choice.
type Token = Plus | Name(String) | Label(String)

fn label(t: Token) -> u64 {
  let Name(s) | Label(s) = t else {
    return 0
  }
  string.byte_len(s)
}
