// rule: LANG-7
// expect: accept
// The same closure without the attribute: the call shares `ys`. Twin is
// LANG-7-preserves-unique-fn-type-bad.
fn plain_mut(mut xs: List[u64]) -> () {}

fn f(mut ys: List[u64]) -> () {
  let step: fn(mut xs: List[u64]) -> () = fn(mut xs: List[u64]) -> () {
    plain_mut(mut xs)
  }
  step(mut ys)
  list.push(mut ys, 4)
}
