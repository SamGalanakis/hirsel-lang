// rule: LANG-11
// expect: run
// exit: 0
pub fn main() -> Result[(), String] {
  let rows: List[List[u64]] = [[1, 2], [3, 7], [8, 9]]
  let mut row: u64 = 0
  'search: for i in 0u64..list.len(rows) {
    for value in rows[i] {
      if value == 7 {
        row = i
        break 'search
      }
    }
  }
  failure.check(row == 1, TextInvariant())
  Ok(())
}
