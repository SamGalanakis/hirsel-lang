// rule: LANG-7
// expect: run
// stdout: 7
// A match arm ending in a Never call diverges; the other arm yields the value.
fn stop(step: u8) -> Never {
  stop(step + 255u8)
}

fn probe(flag: bool, take label: String) -> u64 {
  match flag {
    true => 7u64,
    false => {
      {
        let _ = take label
      }
      stop(1u8)
    },
  }
}

pub fn main(rt: Io, args: Args) -> Result[(), GrantError] {
  let _ = out.print(io.stdout(rt)?, std@1/u64.to_string(probe(true, "kept")))
  let _ = out.print(io.stdout(rt)?, "\n")
  Ok(())
}
