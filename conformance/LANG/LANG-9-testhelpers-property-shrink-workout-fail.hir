// rule: LANG-9
// expect: fail LANG-9 at line 36
// stdout: test log: counterexample: [7, 0, 0]
// stdout: test failure: seed=0 case=0
// entry: trial
// minithesis b20e7e9 test_minithesis.py:444-502.
// Bounded generated-tree instance: short failure at 7, longer branch at 9.
fn generate(mut s: test.Source) -> List[u64] {
  let first = test.choice(mut s, 1000)
  let branch = !test.bool(mut s)
  let second = if branch {
    test.choice(mut s, 1000)
  } else {
    0u64
  }
  [
    first,
    if branch {
      1u64
    } else {
      0u64
    },
    second
  ]
}

fn law(xs: List[u64]) -> bool uses {} {
  !(xs[0] >= 7 || xs[1] == 1 && xs[2] >= 9)
}

fn show(xs: List[u64]) -> String {
  test.show_list(xs, u64.to_string)
}

pub fn trial(t: Test) -> Result[(), ()] {
  test.property_cases(t, 1000, generate, law, show)
  Ok(())
}
