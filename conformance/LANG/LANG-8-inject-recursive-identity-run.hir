// rule: LANG-8
// expect: run
// Identity comes before injection: an E error propagates unwrapped even though Wrap(E) exists.
type E = Wrap(box E) | Leaf

fn leaf() -> Result[u64, E] {
  Error(Leaf())
}

fn outer() -> Result[u64, E] {
  let n = leaf()?
  Ok(n)
}

pub fn main(t: Test) -> Result[(), ()] {
  test.check(t, outer() == Error(Leaf()))
  Ok(())
}
