// rule: LANG-9
// expect: run
// entry: trial
fn sample(mut s: test.Source) -> List[i64] {
  test.list_of(
    mut s,
    8,
    fn(mut inner: test.Source) -> i64 {
      test.range_i64(mut inner, -5, 5)
    }
  )
}

fn bounded(xs: List[i64]) -> bool uses {} {
  core@1/list.len(xs) <= 8 && list.all(
    xs,
    fn(x: i64) -> bool uses {} {
      x >= -5 && x <= 5
    }
  )
}

fn show(xs: List[i64]) -> String {
  test.show_list(xs, i64.to_string)
}

pub fn trial(t: Test) -> Result[(), ()] {
  test.property_cases(t, 30, sample, bounded, show)
  test.property_cases(
    t,
    10,
    test.bool,
    fn(b: bool) -> bool uses {} {
      b || !b
    },
    bool.to_string
  )
  test.property_cases(
    t,
    10,
    test.any_u64,
    fn(n: u64) -> bool uses {} {
      n <= 0xffffffffffffffff
    },
    u64.to_string
  )
  Ok(())
}
