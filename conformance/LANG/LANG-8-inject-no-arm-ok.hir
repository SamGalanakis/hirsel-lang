// rule: LANG-8
// expect: accept
// The no-arm fix applied: AppError gains the arm Config(ConfigError).
type ParseError = Empty()

type ConfigError = Missing()

type AppError = Input(ParseError) | Config(ConfigError)

fn config(present: bool) -> Result[u64, ConfigError] {
  if present {
    Ok(1)
  } else {
    Error(Missing())
  }
}

fn run(present: bool) -> Result[u64, AppError] {
  let n = config(present)?
  Ok(n)
}
