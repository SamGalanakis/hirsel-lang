// rule: LANG-9
// expect: fail LANG-9 at line 32
// stdout: test log: counterexample: [1001]
// stdout: test failure: seed=0 case=0
// entry: trial
// minithesis test_finds_small_list_even_with_bad_lists: a drawn length, then that many
// elements, still shrinks to [1001] (sorting, then lowering the length).
fn bad_list(mut s: test.Source) -> List[u64] {
  let n = test.choice(mut s, 10)
  let mut out: List[u64] = []
  let mut i: u64 = 0
  while i < n {
    core@1/list.push(mut out, test.choice(mut s, 10000))
    i += 1
  }
  out
}

fn small_sum(xs: List[u64]) -> bool uses {} {
  let mut total: u64 = 0
  for x in xs {
    total += x
  }
  total <= 1000
}

fn show(xs: List[u64]) -> String {
  test.show_list(xs, u64.to_string)
}

pub fn trial(t: Test) -> Result[(), ()] {
  test.property(t, bad_list, small_sum, show)
  Ok(())
}
