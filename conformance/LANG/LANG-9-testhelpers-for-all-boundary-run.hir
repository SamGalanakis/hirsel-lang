// rule: LANG-9
// expect: run
// entry: trial
pub fn trial(t: Test) -> Result[(), ()] {
  std@1/test.for_all(
    t,
    fn(grant: Test) -> () {
      ()
    },
    fn(value: ()) -> bool uses {} {
      true
    }
  )
  std@1/test.for_all(
    t,
    fn(grant: Test) -> String {
      ""
    },
    fn(value: String) -> bool uses {} {
      value == ""
    }
  )
  Ok(())
}
