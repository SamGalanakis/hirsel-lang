// rule: LANG-9
// expect: run
// entry: trial
resource type Watch {
  n: u8,
}
@noalloc drop(w) {
  core@1/failure.check(w.n == 7, Arithmetic())
}

pub fn trial(t: Test) -> Result[(), ()] {
  let plain: Result[String, u64] = Error(7)
  test.equal(t, test.expect_error(t, take plain), 7)
  let counted: Result[u64, String] = Error("boom")
  let message = test.expect_error(t, take counted)
  test.equal(t, message, "boom")
  let held: Result[u64, Watch] = Error(Watch(n: 7))
  let watch = test.expect_error(t, take held)
  test.equal(t, watch.n, 7)
  Ok(())
}
