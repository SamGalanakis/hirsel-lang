// rule: LANG-8
// expect: run
// Arms are selected once against the abstract E: Source for E, Files for FileProblem,
// and generic[FileProblem] keeps both selections.
type FileProblem = NotFound()

type Mixed[E] = Source(E) | Files(FileProblem)

fn missing() -> Result[u64, FileProblem] {
  Error(NotFound())
}

fn generic[E](f: fn() -> Result[u64, E], read: bool) -> Result[u64, Mixed[E]] uses {f} {
  if read {
    let b = missing()?
    return Ok(b)
  }
  let a = f()?
  Ok(a)
}

pub fn main(t: Test) -> Result[(), ()] {
  test.check(t, generic(missing, false) == Error(Source(NotFound())))
  test.check(t, generic(missing, true) == Error(Files(NotFound())))
  Ok(())
}
