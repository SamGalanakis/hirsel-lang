// rule: LANG-10
// expect: run
// stdout: 50005000
// Shows "Only top-level definitions recurse; local fns cannot refer to themselves or later locals."
@noalloc
fn sum(n: u64, total: u64) -> u64 {
  if n == 0 {
    total
  } else {
    sum(n - 1, total + n)
  }
}

pub fn main(rt: Io, args: Args) -> Result[(), GrantError] {
  let _ = out.print(io.stdout(rt)?, std@1/u64.to_string(sum(10000, 0)))
  let _ = out.print(io.stdout(rt)?, "\n")
  Ok(())
}
