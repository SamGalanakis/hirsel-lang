// rule: LANG-8
// expect: reject LANG-8 at line 14
// twin: LANG/LANG-8-inject-ambiguous-ok.hir
// Two arms carry StoreError, as two roles; plain ? names neither.
type StoreError = Corrupt()

type DbError = Open(StoreError) | Commit(StoreError)

fn open() -> Result[u64, StoreError] {
  Error(Corrupt())
}

fn save() -> Result[u64, DbError] {
  let handle = open()?
  Ok(handle)
}
