// rule: LANG-7
// expect: reject LANG-7 at line 10
// `@preserves_unique` is proved on a body, and C has none, so an extern cannot
// declare it. Twin is LANG-7-extern-preserves-unique-ok.
type Acc {
  items: List[u64],
}

/// Calls f(ctx, n) once during the call and retains neither.
@preserves_unique(ctx)
extern "c" fn visit(
  u: Unsafe,
  f: FnPtr[fn(mut ctx: unique Acc, n: u64) -> i32],
  mut ctx: unique Acc
) -> ()
