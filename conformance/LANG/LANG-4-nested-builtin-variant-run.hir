// rule: LANG-4
// expect: run
type Value = Leaf(u64) | Array(List[u64])

fn wrap(xs: List[u64]) -> Option[Value] {
  Some(Array(unique xs))
}

fn empty(source: Bytes) -> Option[String] in source {
  None
}

pub fn main(t: Test) -> Result[(), ()] {
  test.check(t, empty(b"source") == None)
  let xs: List[u64] = [1, 2]
  match wrap(xs) {
    Some(Array(items)) => test.check(t, items == [1, 2]),
    _ => test.check(t, false),
  }
  Ok(())
}
