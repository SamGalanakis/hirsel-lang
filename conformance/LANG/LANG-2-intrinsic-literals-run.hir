// rule: LANG-2
// expect: run
pub fn main(t: Test) -> Result[(), ()] {
  let request_bytes = b"GET / HTTP/1.1\r\n\r\n"
  let written = match bytes.len(request_bytes) > 0 {
    true => true,
    false => false,
  }
  let reply = if written {
    "yes"
  } else {
    "no"
  }
  let text = match written {
    true => "ok",
    false => "error",
  }
  test.check(t, written && reply == "yes" && text == "ok")
  Ok(())
}
