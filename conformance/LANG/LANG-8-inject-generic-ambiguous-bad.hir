// rule: LANG-8
// expect: reject LANG-8 at line 14
// twin: LANG-8-inject-generic-run.hir
// In a concrete Mixed[FileProblem], Source and Files both carry FileProblem.
type FileProblem = NotFound()

type Mixed[E] = Source(E) | Files(FileProblem)

fn missing() -> Result[u64, FileProblem] {
  Error(NotFound())
}

fn concrete() -> Result[u64, Mixed[FileProblem]] {
  let b = missing()?
  Ok(b)
}
