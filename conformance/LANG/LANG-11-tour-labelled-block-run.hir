// rule: LANG-11
// expect: run
// exit: 0
pub fn main() -> Result[(), ()] {
  let rows: List[List[u64]] = [[1, 2], [3, 7], [8, 9]]
  let found: Option[u64] = 'search: {
    for i in 0u64..list.len(rows) {
      for value in rows[i] {
        if value == 7 {
          break 'search Some(i)
        }
      }
    }
    None()
  }
  failure.check(found == Some(1u64), TextInvariant())
  Ok(())
}
