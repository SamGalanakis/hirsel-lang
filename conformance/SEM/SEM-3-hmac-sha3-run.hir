// rule: SEM-3
// expect: run
// NIST CSRC HMAC-SHA3-256 sample 1 (a 32-byte key below the 136-byte block), and an
// HMAC-SHA3-512 key longer than its 72-byte block, hashed first, as Python hmac computes it.
fn check(key: Bytes, data: Bytes, expected: String) -> () {
  let Ok(tag) = std@1/hex.decode(expected) else {
    failure.check(false, TextInvariant())
    return
  }
  failure.check(
    std@1/hmac.verify with (H = std@1/sha3_256.hash)(key, data, tag),
    TextInvariant()
  )
}

pub fn main() -> Result[(), ()] {
  check(
    b"\x00\x01\x02\x03\x04\x05\x06\x07\x08\x09\x0a\x0b\x0c\x0d\x0e\x0f\x10\x11\x12\x13\x14\x15\x16\x17\x18\x19\x1a\x1b\x1c\x1d\x1e\x1f",
    b"Sample message for keylen<blocklen",
    "4fe8e202c4f058e8dddc23d8c34e467343e23555e24fc2f025d598f558f67205"
  )
  let tag = std@1/hmac.mac with (H = std@1/sha3_512.hash)(
    b"\x00\x01\x02\x03\x04\x05\x06\x07\x08\x09\x0a\x0b\x0c\x0d\x0e\x0f\x10\x11\x12\x13\x14\x15\x16\x17\x18\x19\x1a\x1b\x1c\x1d\x1e\x1f\x20\x21\x22\x23\x24\x25\x26\x27\x28\x29\x2a\x2b\x2c\x2d\x2e\x2f\x30\x31\x32\x33\x34\x35\x36\x37\x38\x39\x3a\x3b\x3c\x3d\x3e\x3f\x40\x41\x42\x43\x44\x45\x46\x47\x48\x49\x4a\x4b\x4c\x4d\x4e\x4f\x50\x51\x52\x53\x54\x55\x56\x57\x58\x59\x5a\x5b\x5c\x5d\x5e\x5f\x60\x61\x62\x63\x64\x65\x66\x67\x68\x69\x6a\x6b\x6c\x6d\x6e\x6f\x70\x71\x72\x73\x74\x75\x76\x77\x78\x79\x7a\x7b\x7c\x7d\x7e\x7f\x80\x81\x82\x83\x84\x85\x86\x87\x88\x89\x8a\x8b\x8c\x8d\x8e\x8f\x90\x91\x92\x93\x94\x95\x96\x97\x98\x99\x9a\x9b\x9c\x9d\x9e\x9f\xa0\xa1\xa2\xa3\xa4\xa5\xa6\xa7",
    b"Sample message for keylen>blocklen"
  )
  failure.check(
    std@1/hex.encode(std@1/bytes.from_inline(tag)) == "e805a52e334d2dab3d5a627d11e3c888c3629152eea68d745ae8df71c21f08ac60e60f349b9e937f60d87dff86b7ddf4375ec4c2122e69304a88fe691c8f5683",
    TextInvariant()
  )
  Ok(())
}
