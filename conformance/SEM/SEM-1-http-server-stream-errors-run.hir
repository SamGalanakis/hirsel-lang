// rule: SEM-1
// expect: run
fn http_net(error: NetError) -> http.HttpError uses {} {
  Net(error)
}

fn invalid(t: Test, status: u16, headers: List[http.Header], expected: http.HttpError) -> Result[
  (),
  http.HttpError
] {
  let n = test.net(
    t,
    [
      NetPeer(
        address: "example.com",
        port: 80u16,
        resolves_to: [],
        tls: Plain(),
        connections: [Open([Send(b"GET / HTTP/1.1\r\n\r\n"), Stall()])]
      )
    ],
    []
  )
  let stream = net.connect(n, "example.com", 80u16, Unbounded()) ? http_net
  let mut c = http.server_connection(
    test.tasks(t),
    n,
    take stream,
    http.default_config()
  )
  let Some((current1, _)) = http.next_stream(mut c, None())? else {
    return Error(Closed())
  }
  let mut exchange1 = take current1
  test.check(t, http.respond_head(mut exchange1, status, headers) == Error(expected))
  test.check(t, http.write_response_body(mut exchange1, b"bad") == Error(OutOfOrder()))
  test.check(t, http.end_response_body(mut exchange1) == Error(OutOfOrder()))
  test.check(t, option.is_none(http.next_stream(mut c, None())?))
  Ok(())
}

fn reset(t: Test, finish: bool) -> Result[(), http.HttpError] {
  let n = test.net(
    t,
    [
      NetPeer(
        address: "example.com",
        port: 80u16,
        resolves_to: [],
        tls: Plain(),
        connections: [
          Open(
            [
              Send(b"GET / HTTP/1.1\r\n\r\n"),
              Expect(
                b"HTTP/1.1 200 \r\nTransfer-Encoding: chunked\r\nConnection: keep-alive\r\n\r\n"
              ),
              Reset()
            ]
          )
        ]
      )
    ],
    []
  )
  let stream = net.connect(n, "example.com", 80u16, Unbounded()) ? http_net
  let mut c = http.server_connection(
    test.tasks(t),
    n,
    take stream,
    http.default_config()
  )
  let Some((current2, _)) = http.next_stream(mut c, None())? else {
    return Error(Closed())
  }
  let mut exchange2 = take current2
  http.respond_head(mut exchange2, 200u16, [])?
  let outcome: Result[(), http.HttpError] = if finish {
    http.end_response_body(mut exchange2)
  } else {
    http.write_response_body(mut exchange2, b"bad")
  }
  match outcome {
    Error(Net(_)) => (),
    _ => test.check(t, false),
  }
  test.check(t, option.is_none(http.next_stream(mut c, None())?))
  test.check(t, http.end_response_body(mut exchange2) == Error(OutOfOrder()))
  Ok(())
}

pub fn main(t: Test) -> Result[(), http.HttpError] {
  invalid(t, 199u16, [], Malformed(Status()))?
  invalid(t, 600u16, [], Malformed(Status()))?
  invalid(
    t,
    200u16,
    [http.Header(name: "Content-Length", value: "1")],
    Malformed(ContentLength())
  )?
  invalid(
    t,
    200u16,
    [http.Header(name: "TRANSFER-ENCODING", value: "gzip")],
    Malformed(ContentLength())
  )?
  invalid(
    t,
    200u16,
    [http.Header(name: "connection", value: "close")],
    Malformed(ContentLength())
  )?
  invalid(
    t,
    200u16,
    [http.Header(name: "x", value: "bad\r\ninjected: yes")],
    Malformed(HeaderValue())
  )?
  reset(t, false)?
  reset(t, true)?
  Ok(())
}
