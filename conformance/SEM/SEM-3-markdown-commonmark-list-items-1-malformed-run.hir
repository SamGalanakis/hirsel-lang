// rule: SEM-3
// expect: run
// Published spec.txt vectors; tools/generate-markdown.py.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.check(
    s,
    "commonmark/List items/253/malformed",
    "A paragraph\nwith two lines.\n\n   \u{0}[&unterminated",
    "<p>A paragraph\nwith two lines.</p>\n<p>�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/List items/254/malformed",
    "1.  A paragraph\n    with two lines.\n\n   \u{0}[&unterminated",
    "<ol>\n<li>A paragraph\nwith two lines.</li>\n</ol>\n<p>�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/List items/255/malformed",
    "- one\n\u{0}[&unterminated",
    "<ul>\n<li>one\n�[&amp;unterminated</li>\n</ul>\n",
    std@1/markdown.default_options()
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
