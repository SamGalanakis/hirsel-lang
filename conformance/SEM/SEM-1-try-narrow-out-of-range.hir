// rule: SEM-1
// expect: run
// stdout: ok
// "try_narrow → Option"; "truncate" keeps the destination-width bits.
fn output_error[E](take e: E) -> () {}

pub fn main(rt: Io, args: Args) -> Result[(), ()] {
  let x: u16 = 256
  let value: Option[u8] = int.try_narrow(x)
  out.print(
    io.stdout(rt) ? grant_error,
    if value == None {
      "ok\n"
    } else {
      "bad\n"
    }
  ) ? output_error
  Ok(())
}

@noalloc
fn grant_error(refusal: GrantError) -> () uses {} {
  ()
}
