// rule: SEM-3
// expect: run
// Inputs: the SEM-3-diff-pairs cases (Go src/internal/diff/testdata, golang/go
// ebe2feef, and fixed pairs). Expected unified diffs are imara-diff's
// (pascalkuthe/imara-diff f02e46a7) Algorithm::Histogram with
// postprocess_no_heuristic, printed as git diff -U3 prints hunks.
fn pairs() -> List[(String, String, String, String)] uses {} {
  [
    (
      "random-1",
      "d0\na1\nc0\ne1\ne0\nc0\nf2\nc0\nc1\na1\nb2\nc2\nf1\na0\nf0\nb0\na0\ng1\nc0\nh2\ng2\nf2\nh1\nc1\nd1\nc1\nc1\nf2\nb0\nc0\nd0\nf1\nd0\nd2\nd2\na1\nh2\nb2\nb1\na0\n",
      "d0\na1\nb0\ne1\ne0\nc0\nf2\nc0\nc1\na1\nc1\nb2\nc2\nf1\nx2\nf0\nb0\ng1\nc0\nh2\ng2\nf2\nh1\nc1\nd1\nc1\nx2\nc1\nf2\nb0\nd0\nf1\nc2\nd0\na1\nd2\na1\nh2\nb2\nb1\na0\nc1\nz2\n",
      "--- old\n+++ new\n@@ -1,6 +1,6 @@\n d0\n a1\n-c0\n+b0\n e1\n e0\n c0\n@@ -8,13 +8,13 @@\n c0\n c1\n a1\n+c1\n b2\n c2\n f1\n-a0\n+x2\n f0\n b0\n-a0\n g1\n c0\n h2\n@@ -24,17 +24,20 @@\n c1\n d1\n c1\n+x2\n c1\n f2\n b0\n-c0\n d0\n f1\n+c2\n d0\n-d2\n+a1\n d2\n a1\n h2\n b2\n b1\n a0\n+c1\n+z2\n"
    )
  ]
}

// Rebuilds `new` from `old` and an edit script, checking each run's positions.
fn replay(old: List[String], new: List[String], script: List[diff.Edit]) -> bool uses {} {
  let mut out: List[String] = []
  let mut i: u64 = 0
  let mut j: u64 = 0
  for e in script {
    match e {
      Keep(a, b, n) => {
        if a != i || b != j || n == 0 {
          return false
        }
        for k in 0u64..n {
          if old[a + k] != new[b + k] {
            return false
          }
          list.push(mut out, unique old[a + k])
        }
        i += n
        j += n
      },
      Delete(a, b, n) => {
        if a != i || b != j || n == 0 {
          return false
        }
        i += n
      },
      Insert(a, b, n) => {
        if a != i || b != j || n == 0 {
          return false
        }
        for k in 0u64..n {
          list.push(mut out, unique new[b + k])
        }
        j += n
      },
    }
  }
  i == list.len(old) && out == new
}

pub fn main(t: Test) -> Result[(), diff.PatchError] {
  let mut case: u64 = 22
  for (_, old, new, histogram) in pairs() {
    test.check_case(
      t,
      diff.unified("old", old, "new", new, Histogram(), 3) == histogram,
      case
    )
    let applied = diff.apply(old, histogram)?
    test.check_case(t, applied.text == new && list.len(applied.rejected) == 0, case)
    let a = diff.split_lines(old)
    let b = diff.split_lines(new)
    test.check_case(t, replay(a, b, diff.edits(a, b, Histogram())), case)
    case += 1
  }
  Ok(())
}
