// rule: SEM-3
// expect: run
// Published spec.txt vectors; tools/generate-markdown.py.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.check(
    s,
    "commonmark/List items/293/malformed",
    "> 1. > Blockquote\n\u{0}[&unterminated",
    "<blockquote>\n<ol>\n<li>\n<blockquote>\n<p>Blockquote\n�[&amp;unterminated</p>\n</blockquote>\n</li>\n</ol>\n</blockquote>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/List items/294/malformed",
    "- foo\n  - bar\n    \u{0}[&unterminated",
    "<ul>\n<li>foo\n<ul>\n<li>bar\n�[&amp;unterminated</li>\n</ul>\n</li>\n</ul>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/List items/295/malformed",
    "- foo\n - bar\n  \u{0}[&unterminated",
    "<ul>\n<li>foo</li>\n<li>bar\n�[&amp;unterminated</li>\n</ul>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/List items/296/malformed",
    "10) foo\n \u{0}[&unterminated",
    "<ol start=\"10\">\n<li>foo\n�[&amp;unterminated</li>\n</ol>\n",
    std@1/markdown.default_options()
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
