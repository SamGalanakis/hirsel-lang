// rule: SEM-3
// expect: run
// Generated by tools/generate-json-vectors.py; see docs/json-domain-vectors.md.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.parses(s, "n_number_2.e-3.json:1", "[2.e-3]", 1)
  failed += harness.parses(s, "n_number_2.e3.json:1", "[2.e3]", 1)
  failed += harness.parses(s, "n_number_9.e+.json:1", "[9.e+]", 1)
  failed += harness.parses(s, "n_number_Inf.json:1", "[Inf]", 1)
  failed += harness.parses(s, "n_number_NaN.json:1", "[NaN]", 1)
  failed += harness.parses(s, "n_number_U+FF11_fullwidth_digit_one.json:1", "[１]", 1)
  failed += harness.parses(s, "n_number_expression.json:1", "[1+2]", 1)
  failed += harness.parses(s, "n_number_hex_1_digit.json:1", "[0x1]", 1)
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
