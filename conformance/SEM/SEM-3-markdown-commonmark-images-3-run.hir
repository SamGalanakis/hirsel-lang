// rule: SEM-3
// expect: run
// Published spec.txt vectors; tools/generate-markdown.py.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.check(
    s,
    "commonmark/Images/579",
    "My ![foo bar](/path/to/train.jpg  \"title\"   )\n",
    "<p>My <img src=\"/path/to/train.jpg\" alt=\"foo bar\" title=\"title\" /></p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Images/580",
    "![foo](<url>)\n",
    "<p><img src=\"url\" alt=\"foo\" /></p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Images/581",
    "![](/url)\n",
    "<p><img src=\"/url\" alt=\"\" /></p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Images/582",
    "![foo][bar]\n\n[bar]: /url\n",
    "<p><img src=\"/url\" alt=\"foo\" /></p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Images/583",
    "![foo][bar]\n\n[BAR]: /url\n",
    "<p><img src=\"/url\" alt=\"foo\" /></p>\n",
    std@1/markdown.default_options()
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
