// rule: SEM-3
// expect: run
// Published spec.txt vectors; tools/generate-markdown.py.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.check(
    s,
    "commonmark/Emphasis and strong emphasis/432",
    "**foo *bar **baz**\nbim* bop**\n",
    "<p><strong>foo <em>bar <strong>baz</strong>\nbim</em> bop</strong></p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Emphasis and strong emphasis/433",
    "**foo [*bar*](/url)**\n",
    "<p><strong>foo <a href=\"/url\"><em>bar</em></a></strong></p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Emphasis and strong emphasis/434",
    "__ is not an empty emphasis\n",
    "<p>__ is not an empty emphasis</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Emphasis and strong emphasis/435",
    "____ is not an empty strong emphasis\n",
    "<p>____ is not an empty strong emphasis</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Emphasis and strong emphasis/436",
    "foo ***\n",
    "<p>foo ***</p>\n",
    std@1/markdown.default_options()
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
