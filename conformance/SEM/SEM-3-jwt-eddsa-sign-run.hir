// rule: SEM-3
// expect: run
// steps: 6000000
// golang-jwt Ed25519 fixture, with RFC 8037 alg EdDSA; public test key only.
fn decode(text: String) -> unique Bytes {
  let Ok(data) = std@1/hex.decode(text) else {
    failure.check(false, TextInvariant())
    return bytes.from_list([])
  }
  data
}

pub fn main() -> Result[(), ()] {
  let mut fields: Map[String, json.Value] = map.empty()
  map.insert(mut fields, "foo", Text("bar"))
  failure.check(
    jwt.sign(
      EdDSAPrivate(
        ed25519.PrivateKey(
          seed: decode(
            "414c119ae6958c5ccd7285c4894dbcd191e4942f0e14e42e8bc9631c10777b9a"
          )
        )
      ),
      Object(take fields)
    ) == Ok(
      "eyJhbGciOiJFZERTQSIsInR5cCI6IkpXVCJ9.eyJmb28iOiJiYXIifQ.rCiLylq-3K-9Y-cvlzvVtkeXhEUOqVYRRH8-7xvAgDRJGLO5WvvlNM2_SdD5AyaNPQCPevoMI_dSLiujr2oJDQ"
    ),
    TextInvariant()
  )
  Ok(())
}
