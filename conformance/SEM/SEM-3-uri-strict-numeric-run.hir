// rule: SEM-3
// expect: run
// RFC 3986 §§2.1/3.2.3 numeric grammar refusal/acceptance twins.
pub fn main() -> Result[(), ()] {
  failure.check(
    std@1/uri.percent_decode("%+f%2F") == string.as_bytes("%+f/"),
    TextInvariant()
  )
  failure.check(
    std@1/uri.percent_decode("%+A%2F") == string.as_bytes("%+A/"),
    TextInvariant()
  )
  failure.check(
    std@1/uri.percent_decode("%-0%2F") == string.as_bytes("%-0/"),
    TextInvariant()
  )
  failure.check(
    std@1/uri.percent_decode("%_0%2F") == string.as_bytes("%_0/"),
    TextInvariant()
  )
  failure.check(
    std@1/uri.percent_decode("%0_%2F") == string.as_bytes("%0_/"),
    TextInvariant()
  )
  failure.check(
    std@1/uri.percent_decode("%__%2F") == string.as_bytes("%__/"),
    TextInvariant()
  )
  failure.check(
    std@1/uri.percent_decode("%%2F") == string.as_bytes("%/"),
    TextInvariant()
  )
  failure.check(
    std@1/uri.percent_decode("%0%2F") == string.as_bytes("%0/"),
    TextInvariant()
  )
  failure.check(
    std@1/uri.percent_decode("%GG%2F") == string.as_bytes("%GG/"),
    TextInvariant()
  )
  failure.check(
    std@1/uri.percent_decode("%0G%2F") == string.as_bytes("%0G/"),
    TextInvariant()
  )
  failure.check(
    std@1/uri.percent_decode("%00%0f%0F%ff%FF%25+") == b"\x00\x0f\x0f\xff\xff%+",
    TextInvariant()
  )
  match std@1/uri.parse("https://example.test:+080/") {
    Error(InvalidPort()) => (),
    _ => {
      return Error(())
    },
  }
  match std@1/uri.parse("https://[::1]:+080/") {
    Error(InvalidPort()) => (),
    _ => {
      return Error(())
    },
  }
  match std@1/uri.parse("https://example.test:-0/") {
    Error(InvalidPort()) => (),
    _ => {
      return Error(())
    },
  }
  match std@1/uri.parse("https://[::1]:-0/") {
    Error(InvalidPort()) => (),
    _ => {
      return Error(())
    },
  }
  match std@1/uri.parse("https://example.test:8_0/") {
    Error(InvalidPort()) => (),
    _ => {
      return Error(())
    },
  }
  match std@1/uri.parse("https://[::1]:8_0/") {
    Error(InvalidPort()) => (),
    _ => {
      return Error(())
    },
  }
  match std@1/uri.parse("https://example.test:1__0/") {
    Error(InvalidPort()) => (),
    _ => {
      return Error(())
    },
  }
  match std@1/uri.parse("https://[::1]:1__0/") {
    Error(InvalidPort()) => (),
    _ => {
      return Error(())
    },
  }
  match std@1/uri.parse("https://example.test:_80/") {
    Error(InvalidPort()) => (),
    _ => {
      return Error(())
    },
  }
  match std@1/uri.parse("https://[::1]:_80/") {
    Error(InvalidPort()) => (),
    _ => {
      return Error(())
    },
  }
  match std@1/uri.parse("https://example.test:80_/") {
    Error(InvalidPort()) => (),
    _ => {
      return Error(())
    },
  }
  match std@1/uri.parse("https://[::1]:80_/") {
    Error(InvalidPort()) => (),
    _ => {
      return Error(())
    },
  }
  match std@1/uri.parse("https://example.test:-1/") {
    Error(InvalidPort()) => (),
    _ => {
      return Error(())
    },
  }
  match std@1/uri.parse("https://[::1]:-1/") {
    Error(InvalidPort()) => (),
    _ => {
      return Error(())
    },
  }
  match std@1/uri.parse("https://example.test:+/") {
    Error(InvalidPort()) => (),
    _ => {
      return Error(())
    },
  }
  match std@1/uri.parse("https://[::1]:+/") {
    Error(InvalidPort()) => (),
    _ => {
      return Error(())
    },
  }
  match std@1/uri.parse("https://example.test:65536/") {
    Error(InvalidPort()) => (),
    _ => {
      return Error(())
    },
  }
  match std@1/uri.parse("https://[::1]:65536/") {
    Error(InvalidPort()) => (),
    _ => {
      return Error(())
    },
  }
  match std@1/uri.parse("https://example.test:999999999999999999999999999999999999/") {
    Error(InvalidPort()) => (),
    _ => {
      return Error(())
    },
  }
  match std@1/uri.parse("https://[::1]:999999999999999999999999999999999999/") {
    Error(InvalidPort()) => (),
    _ => {
      return Error(())
    },
  }
  match std@1/uri.parse("https://example.test:８０/") {
    Error(InvalidPort()) => (),
    _ => {
      return Error(())
    },
  }
  match std@1/uri.parse("https://[::1]:８０/") {
    Error(InvalidPort()) => (),
    _ => {
      return Error(())
    },
  }
  match std@1/uri.parse("https://example.test:80x/") {
    Error(InvalidPort()) => (),
    _ => {
      return Error(())
    },
  }
  match std@1/uri.parse("https://[::1]:80x/") {
    Error(InvalidPort()) => (),
    _ => {
      return Error(())
    },
  }
  match std@1/uri.parse("https://example.test:/") {
    Error(InvalidPort()) => (),
    _ => {
      return Error(())
    },
  }
  match std@1/uri.parse("https://[::1]:/") {
    Error(InvalidPort()) => (),
    _ => {
      return Error(())
    },
  }
  {
    let Ok(parsed_uri) = std@1/uri.parse("https://example.test:0/") else {
      return Error(())
    }
    failure.check(parsed_uri.port == Some(0), TextInvariant())
  }
  {
    let Ok(parsed_uri) = std@1/uri.parse("https://[::1]:0/") else {
      return Error(())
    }
    failure.check(parsed_uri.port == Some(0), TextInvariant())
  }
  {
    let Ok(parsed_uri) = std@1/uri.parse("https://example.test:080/") else {
      return Error(())
    }
    failure.check(parsed_uri.port == Some(80), TextInvariant())
  }
  {
    let Ok(parsed_uri) = std@1/uri.parse("https://[::1]:080/") else {
      return Error(())
    }
    failure.check(parsed_uri.port == Some(80), TextInvariant())
  }
  {
    let Ok(parsed_uri) = std@1/uri.parse(
      "https://example.test:00000000000000000000000000000000000080/"
    ) else {
      return Error(())
    }
    failure.check(parsed_uri.port == Some(80), TextInvariant())
  }
  {
    let Ok(parsed_uri) = std@1/uri.parse(
      "https://[::1]:00000000000000000000000000000000000080/"
    ) else {
      return Error(())
    }
    failure.check(parsed_uri.port == Some(80), TextInvariant())
  }
  {
    let Ok(parsed_uri) = std@1/uri.parse("https://example.test:65535/") else {
      return Error(())
    }
    failure.check(parsed_uri.port == Some(65535), TextInvariant())
  }
  {
    let Ok(parsed_uri) = std@1/uri.parse("https://[::1]:65535/") else {
      return Error(())
    }
    failure.check(parsed_uri.port == Some(65535), TextInvariant())
  }
  let Ok(base) = std@1/uri.parse("https://example.test/base") else {
    return Error(())
  }
  match std@1/uri.resolve(base, "https://example.test:+80/") {
    Error(_) => (),
    Ok(_) => {
      return Error(())
    },
  }
  match std@1/uri.resolve(base, "https://[::1]:8_0/") {
    Error(_) => (),
    Ok(_) => {
      return Error(())
    },
  }
  match std@1/uri.resolve(base, "//example.test:-0/") {
    Error(_) => (),
    Ok(_) => {
      return Error(())
    },
  }
  Ok(())
}
