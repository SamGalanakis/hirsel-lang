// rule: SEM-1
// expect: run
fn http_net(error: NetError) -> http.HttpError uses {} {
  Net(error)
}

fn exercise(t: Test, method: String, modern: bool, status: u16) -> Result[
  (),
  http.HttpError
] {
  let version = if modern {
    "HTTP/1.1"
  } else {
    "HTTP/1.0"
  }
  let request = string.concat(
    string.concat(method, " / "),
    string.concat(
      version,
      "\r\nConnection: keep-alive\r\n\r\nGET /next HTTP/1.1\r\nConnection: close\r\n\r\n"
    )
  )
  let reply = string.concat(
    version,
    string.concat(
      " ",
      string.concat(u16.to_string(status), " \r\nConnection: keep-alive\r\n\r\n")
    )
  )
  let n = test.net(
    t,
    [
      NetPeer(
        address: "example.com",
        port: 80u16,
        resolves_to: [],
        tls: Plain(),
        connections: [
          Open(
            [
              Send(unique string.as_bytes(request)),
              Expect(unique string.as_bytes(reply)),
              Expect(
                b"HTTP/1.1 200 \r\nContent-Length: 2\r\nConnection: close\r\n\r\nok"
              ),
              Close()
            ]
          )
        ]
      )
    ],
    []
  )
  let stream = net.connect(n, "example.com", 80u16, Unbounded()) ? http_net
  let mut c = http.server_connection(n, take stream, http.default_config())
  let _ = http.receive_request(mut c, None())?
  http.respond_head(mut c, status, [])?
  http.write_response_body(mut c, b"elided")?
  http.end_response_body(mut c)?
  let next = http.receive_request(mut c, None())?
  test.check(t, next.target == "/next")
  http.respond(mut c, 200u16, [], b"ok", false)?
  Ok(())
}

pub fn main(t: Test) -> Result[(), http.HttpError] {
  exercise(t, "HEAD", true, 200u16)?
  exercise(t, "HEAD", false, 200u16)?
  exercise(t, "GET", true, 204u16)?
  exercise(t, "GET", false, 204u16)?
  exercise(t, "GET", true, 304u16)?
  exercise(t, "GET", false, 304u16)?
  Ok(())
}
