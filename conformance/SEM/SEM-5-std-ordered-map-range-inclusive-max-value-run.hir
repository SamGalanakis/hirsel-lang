// rule: SEM-5
// expect: run
// Rust f6c1107 library/alloc/src/collections/btree/map/tests.rs:571-929.
fn by(a: i32, b: i32) -> i32 uses {} { if a < b { -1 } else if a > b { 1 } else { 0 } }
fn make(start: i32, end: i32) -> ordered_map.OrderedMap[i32, i32] {
  let mut m: ordered_map.OrderedMap[i32, i32] = ordered_map.empty(by)
  for i in start..end { ordered_map.insert(mut m, i, i) }
  take m
}
fn keys(m: ordered_map.OrderedMap[i32, i32], low: ordered_map.Bound[i32], high: ordered_map.Bound[i32], descending: bool) -> List[i32] {
  let direction = if descending { Descending() } else { Ascending() }
  ordered_map.fold_range(m, low, high, direction, [],
    fn(take acc: List[i32], k: i32, v: i32) -> (List[i32], bool) {
      failure.check(k == v, Bounds())
      let mut out = take acc
      list.push(mut out, k)
      (take out, true)
    })
}
fn check(m: ordered_map.OrderedMap[i32,i32], low: ordered_map.Bound[i32], high: ordered_map.Bound[i32], expected: List[i32]) -> () {
  failure.check(keys(m, low, high, false) == expected, Bounds())
  let mut reversed = copy expected
  list.reverse(mut reversed)
  failure.check(keys(m, low, high, true) == reversed, Bounds())
}

pub fn main(t: Test) -> Result[(), ()] {
  let m = make(2147483647, 2147483647)
  let mut maxmap = take m
  ordered_map.insert(mut maxmap, 2147483647, 2147483647)
  check(maxmap, Included(2147483647), Included(2147483647), [2147483647])
  Ok(())
}
