  let mut out: List[u8] = []
  failure.check(std@1/utf8.append_scalar(mut out, 0u32) == Ok(()), TextInvariant())
  failure.check(std@1/utf8.append_scalar(mut out, 127u32) == Ok(()), TextInvariant())
  failure.check(std@1/utf8.append_scalar(mut out, 128u32) == Ok(()), TextInvariant())
  failure.check(std@1/utf8.append_scalar(mut out, 2047u32) == Ok(()), TextInvariant())
