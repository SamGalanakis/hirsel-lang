// rule: SEM-3
// expect: run
// Published spec.txt vectors; tools/generate-markdown.py.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.check(
    s,
    "commonmark/Setext headings/101",
    "> foo\n-----\n",
    "<blockquote>\n<p>foo</p>\n</blockquote>\n<hr />\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Setext headings/102",
    "\\> foo\n------\n",
    "<h2>&gt; foo</h2>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Setext headings/103",
    "Foo\n\nbar\n---\nbaz\n",
    "<p>Foo</p>\n<h2>bar</h2>\n<p>baz</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Setext headings/104",
    "Foo\nbar\n\n---\n\nbaz\n",
    "<p>Foo\nbar</p>\n<hr />\n<p>baz</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Setext headings/105",
    "Foo\nbar\n* * *\nbaz\n",
    "<p>Foo\nbar</p>\n<hr />\n<p>baz</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Setext headings/106",
    "Foo\nbar\n\\---\nbaz\n",
    "<p>Foo\nbar\n---\nbaz</p>\n",
    std@1/markdown.default_options()
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
