// rule: SEM-3
// expect: run
// Generated by tools/generate-toml-test.py from toml-test ff49d109861c
// tests/files-toml-1.1.0, group valid-table.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.valid(
    s,
    "valid/table/names-with-values",
    "[a.b.c]\nkey = 1\n\n[a.\"b.c\"]\nkey = 2\n\n[a.'d.e']\nkey = 3\n\n[a.' x ']\nkey = 4\n\n[ d.e.f ]\nkey = 5\n\n[ g . h . i ]\nkey = 6\n\n[ j . \"ʞ\" . 'l' ]\nkey = 7\n\n[x.1.2]\nkey = 8\n",
    "{\"a\":{\" x \":{\"key\":{\"type\":\"integer\",\"value\":\"4\"}},\"b\":{\"c\":{\"key\":{\"type\":\"integer\",\"value\":\"1\"}}},\"b.c\":{\"key\":{\"type\":\"integer\",\"value\":\"2\"}},\"d.e\":{\"key\":{\"type\":\"integer\",\"value\":\"3\"}}},\"d\":{\"e\":{\"f\":{\"key\":{\"type\":\"integer\",\"value\":\"5\"}}}},\"g\":{\"h\":{\"i\":{\"key\":{\"type\":\"integer\",\"value\":\"6\"}}}},\"j\":{\"ʞ\":{\"l\":{\"key\":{\"type\":\"integer\",\"value\":\"7\"}}}},\"x\":{\"1\":{\"2\":{\"key\":{\"type\":\"integer\",\"value\":\"8\"}}}}}"
  )
  failed += harness.valid(
    s,
    "valid/table/no-eol-01",
    "# No newline at end of file.\n[table]",
    "{\"table\":{}}"
  )
  failed += harness.valid(
    s,
    "valid/table/no-eol-02",
    "# No newline at end of file.\n[table]\na=1",
    "{\"table\":{\"a\":{\"type\":\"integer\",\"value\":\"1\"}}}"
  )
  failed += harness.valid(
    s,
    "valid/table/sub",
    "[a]\nkey = 1\n\n# a.extend is a key inside the \"a\" table.\n[a.extend]\nkey = 2\n\n[a.extend.more]\nkey = 3\n",
    "{\"a\":{\"key\":{\"type\":\"integer\",\"value\":\"1\"},\"extend\":{\"key\":{\"type\":\"integer\",\"value\":\"2\"},\"more\":{\"key\":{\"type\":\"integer\",\"value\":\"3\"}}}}}"
  )
  failed += harness.valid(
    s,
    "valid/table/sub-empty",
    "[a]\n[a.b]\n",
    "{\"a\":{\"b\":{}}}"
  )
  failed += harness.valid(
    s,
    "valid/table/whitespace",
    "[\"valid key\"]\n",
    "{\"valid key\":{}}"
  )
  failed += harness.valid(
    s,
    "valid/table/with-literal-string",
    "['a']\n[a.'\"b\"']\n[a.'\"b\"'.c]\nanswer = 42 \n",
    "{\"a\":{\"\\\"b\\\"\":{\"c\":{\"answer\":{\"type\":\"integer\",\"value\":\"42\"}}}}}"
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
