// rule: SEM-1
// expect: run
fn check_value(text: String, expected: i128) -> () uses {} {
  match duration.parse(text) {
    Ok(value) => {
      failure.check(value.nanoseconds == expected, Arithmetic())
      match duration.parse(duration.to_string(value)) {
        Ok(again) => failure.check(again.nanoseconds == expected, Arithmetic()),
        Error(_) => failure.check(false, Arithmetic()),
      }
    },
    Error(_) => failure.check(false, Arithmetic()),
  }
}

fn check_invalid(text: String) -> () uses {} {
  match duration.parse(text) {
    Error(Invalid()) => (),
    _ => failure.check(false, Arithmetic()),
  }
}

fn check_large(text: String) -> () uses {} {
  match duration.parse(text) {
    Error(OutOfRange()) => (),
    _ => failure.check(false, Arithmetic()),
  }
}

pub fn main(rt: Io, args: Args) -> Result[(), ()] {
  failure.check(
    duration.from_parts(-2, 1500000000).nanoseconds == -500000000i128,
    Arithmetic()
  )
  failure.check(
    duration.to_string(time.Duration(nanoseconds: -1)) == "-0.000000001s",
    Arithmetic()
  )
  check_value("+001.200s", 1200000000)
  check_value("-0s", 0)
  check_value(
    "170141183460469231731687303715.884105727s",
    170141183460469231731687303715884105727
  )
  check_value(
    "-170141183460469231731687303715.884105728s",
    -170141183460469231731687303715884105728
  )
  check_invalid("1")
  check_invalid("s")
  check_invalid("1.s")
  check_invalid(".1s")
  check_invalid(" 1s")
  check_invalid("1s ")
  check_invalid("1.1234567890s")
  check_invalid("--1s")
  check_invalid("1e2s")
  check_large("170141183460469231731687303715.884105728s")
  check_large("-170141183460469231731687303715.884105729s")
  check_large("99999999999999999999999999999999999999999999999s")
  Ok(())
}
