// rule: SEM-3
// expect: run
// steps: 3000000
// four AES-256-GCM seals and two opens take about 1.3M steps
// Zig std/crypto/aes_gcm.zig tests: AES-256-GCM with an all-0x69 key and all-0x42
// nonce seals each message and data to the expected ciphertext and tag and opens it.
fn repeat(byte: u8, count: u64) -> unique Bytes {
  let mut out: List[u8] = []
  while list.len(out) < count {
    list.push(mut out, byte)
  }
  bytes.from_list(take out)
}

fn roundtrip(message: Bytes, data: Bytes, expected: String) -> () {
  let key = repeat(0x69, 32)
  let nonce = repeat(0x42, 12)
  let sealed = std@1/aes_gcm.seal(key, nonce, message, data)
  failure.check(std@1/hex.encode(sealed) == expected, TextInvariant())
  let Ok(opened) = std@1/aes_gcm.open(key, nonce, sealed, data) else {
    failure.check(false, TextInvariant())
    return
  }
  failure.check(opened == message, TextInvariant())
}

pub fn main() -> Result[(), ()] {
  roundtrip(
    string.as_bytes(""),
    string.as_bytes(""),
    "6b6ff610a16fa4cd59f1fb7903154e92"
  )
  roundtrip(
    string.as_bytes(""),
    string.as_bytes("Test with associated data"),
    "262ed164c2dfb26e080a9d108dd9dd4c"
  )
  roundtrip(
    string.as_bytes("Test with message only"),
    string.as_bytes(""),
    "5ca1642d90009fea33d01f78cf6eefaf01d539472f7c07cd7fc9103e2f9e9bf2dfaa319caff4"
  )
  roundtrip(
    string.as_bytes("Test with message"),
    string.as_bytes("Test with associated data"),
    "5ca1642d90009fea33d01f78cf6eefaf0164accec679d444e2373bd9f6796c0d2c"
  )
  Ok(())
}
