// rule: SEM-3
// expect: run
// Published spec.txt vectors; tools/generate-markdown.py.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.check(
    s,
    "commonmark/Tabs/1/malformed",
    "\tfoo\tba\u{0}[&unterminated",
    "<pre><code>foo\tba�[&amp;unterminated\n</code></pre>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Tabs/2/malformed",
    "  \tfoo\tb\u{0}[&unterminated",
    "<pre><code>foo\tb�[&amp;unterminated\n</code></pre>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Tabs/3/malformed",
    "    a\ta\n\u{0}[&unterminated",
    "<pre><code>a\ta\n</code></pre>\n<p>�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Tabs/4/malformed",
    "  - foo\u{0}[&unterminated",
    "<ul>\n<li>foo�[&amp;unterminated</li>\n</ul>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Tabs/5/malformed",
    "- foo\n\u{0}[&unterminated",
    "<ul>\n<li>foo\n�[&amp;unterminated</li>\n</ul>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Tabs/6/malformed",
    ">\t\t\u{0}[&unterminated",
    "<blockquote>\n<pre><code>  �[&amp;unterminated\n</code></pre>\n</blockquote>\n",
    std@1/markdown.default_options()
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
