// rule: SEM-3
// expect: run
// Go src/archive/tar/reader_test.go TestReader (golang/go ebe2feef): PAX
// path and linkpath records over 100-byte names, sub-second times (whole
// seconds, rounded down, with the record kept) and a zero-padded size record.
// At most `chunk` bytes of `data` per refill.
type Source {
  data: Bytes,
  at: u64,
  chunk: u64,
}

fn feed(mut s: Source, mut buffer: List[u8], requested: u64) -> Result[u64, ()] uses {} {
  let n = if requested < s.chunk {
    requested
  } else {
    s.chunk
  }
  let end = if s.at + n < core@1/bytes.len(s.data) {
    s.at + n
  } else {
    core@1/bytes.len(s.data)
  }
  for byte in core@1/bytes.slice(s.data, s.at, end) {
    list.push(mut buffer, byte)
  }
  let fed = end - s.at
  s.at = end
  Ok(fed)
}

fn kind_text(kind: tar.Kind) -> String {
  match kind {
    Regular() => "0",
    Link() => "1",
    Symlink() => "2",
    Char() => "3",
    Block() => "4",
    Directory() => "5",
    Fifo() => "6",
    Global() => "g",
    Other(flag) => text.finish_valid([flag]),
  }
}

// The header's fields, separated by `|`, and its PAX records in order.
fn summary(h: tar.Header) -> String {
  let mut out: List[u8] = []
  text.append(mut out, h.name)
  let texts: List[String] = [kind_text(h.kind), h.linkname]
  for field in texts {
    list.push(mut out, b'|')
    text.append(mut out, field)
  }
  let numbers: List[u64] = [h.size, h.mode, h.uid, h.gid]
  for n in numbers {
    list.push(mut out, b'|')
    u64.format_into(n, mut out)
  }
  let names: List[String] = [h.uname, h.gname]
  for field in names {
    list.push(mut out, b'|')
    text.append(mut out, field)
  }
  list.push(mut out, b'|')
  i64.format_into(h.modified, mut out)
  let devices: List[u64] = [h.devmajor, h.devminor]
  for n in devices {
    list.push(mut out, b'|')
    u64.format_into(n, mut out)
  }
  list.push(mut out, b'|')
  let mut first = true
  for (key, value) in h.records {
    if !first {
      list.push(mut out, b',')
    }
    first = false
    text.append(mut out, key)
    list.push(mut out, b'=')
    text.append(mut out, value)
  }
  text.finish_valid(take out)
}

// Every entry's summary and data, reading at most `chunk` bytes per refill.
fn listing(take data: Bytes, chunk: u64) -> Result[
  List[(String, Bytes)],
  tar.ReadError[()]
] {
  let mut t = tar.reader(None())
  let mut r = bufio.new(chunk)
  let mut source = Source(data: take data, at: 0, chunk: chunk)
  let mut entries: List[(String, Bytes)] = []
  while true {
    match tar.next(mut t, mut r, mut source, feed)? {
      None() => break,
      Some(h) => {
        let mut body: List[u8] = []
        while tar.read(mut t, mut r, mut source, feed, mut body, 4096)? > 0 {
          failure.check(list.len(body) <= h.size, Bounds())
        }
        list.push(mut entries, (summary(h), core@1/bytes.from_list(take body)))
      },
    }
  }
  Ok(entries)
}

pub fn main(t: Test) -> Result[(), ()] {
  // pax.tar
  test.check(
    t,
    listing(
      b"a/PaxHeaders.6887/12345678910111213141516171819202122232425262728293031323334353637383940414243444540000644\x000001750\x000001750\x0000000000446\x0012036615200\x00022461\x00 x\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00ustar\x0000\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x000000000\x000000000\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00204 path=a/123456789101112131415161718192021222324252627282930313233343536373839404142434445464748495051525354555657585960616263646566676869707172737475767778798081828384858687888990919293949596979899100\x0a30 mtime=1350244992.023960108\x0a30 atime=1350244992.023960108\x0a30 ctime=1350244992.023960108\x0a\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x