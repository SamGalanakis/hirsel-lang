// rule: SEM-3
// expect: run
// Generated by tools/generate-toml-test.py from toml-test ff49d109861c
// tests/files-toml-1.1.0, group valid-key.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.valid(
    s,
    "valid/key/like-date",
    "# '-' is a valid character in keys: make a key that looks like a date.\n2001-02-03   = 1\n\"2001-02-04\" = 2\n'2001-02-05' = 3\n\n# Also include datetime and time for good measure; these need to be quoted as\n# ':' isn't a valid bare key.\n\"2001-02-06T15:16:17+01:00\" = 4\n\"2001-02-07T15:16:17\"       = 5\n\"15:16:17\"                  = 6\n\n# Dotted keys\na.2001-02-08 = 7\na.2001-02-09.2001-02-10 = 8\n2001-02-11.a.2001-02-12 = 9\n\n# Table names\n[2002-01-02]\nk = 10\n\n[2002-01-02.2024-01-03]\nk = 11\n\n[[2002-01-04]]\nk = 12\n",
    "{\"15:16:17\":{\"type\":\"integer\",\"value\":\"6\"},\"2001-02-03\":{\"type\":\"integer\",\"value\":\"1\"},\"2001-02-04\":{\"type\":\"integer\",\"value\":\"2\"},\"2001-02-05\":{\"type\":\"integer\",\"value\":\"3\"},\"2001-02-06T15:16:17+01:00\":{\"type\":\"integer\",\"value\":\"4\"},\"2001-02-07T15:16:17\":{\"type\":\"integer\",\"value\":\"5\"},\"2002-01-04\":[{\"k\":{\"type\":\"integer\",\"value\":\"12\"}}],\"2001-02-11\":{\"a\":{\"2001-02-12\":{\"type\":\"integer\",\"value\":\"9\"}}},\"2002-01-02\":{\"k\":{\"type\":\"integer\",\"value\":\"10\"},\"2024-01-03\":{\"k\":{\"type\":\"integer\",\"value\":\"11\"}}},\"a\":{\"2001-02-08\":{\"type\":\"integer\",\"value\":\"7\"},\"2001-02-09\":{\"2001-02-10\":{\"type\":\"integer\",\"value\":\"8\"}}}}"
  )
  failed += harness.valid(
    s,
    "valid/key/numeric-01",
    "1     = true\n",
    "{\"1\":{\"type\":\"bool\",\"value\":\"true\"}}"
  )
  failed += harness.valid(
    s,
    "valid/key/numeric-02",
    "1.2   = true\n",
    "{\"1\":{\"2\":{\"type\":\"bool\",\"value\":\"true\"}}}"
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
