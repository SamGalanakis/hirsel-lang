// rule: SEM-3
// expect: run
// Go src/archive/zip/reader_test.go TestReader (golang/go ebe2feef): Windows
// and Unix attributes, empty directories, a symlink entry, a UTF-8 name and
// extended timestamps.
fn method_text(m: zip.Method) -> String {
  match m {
    Stored() => "stored",
    Deflate() => "deflate",
    Other(_) => "other",
  }
}

// The entry's fields, separated by `|`.
fn summary(e: zip.Entry) -> String {
  let mut out: List[u8] = []
  text.append(mut out, e.name)
  list.push(mut out, b'|')
  text.append(mut out, method_text(e.method))
  let numbers: List[u64] = [
    e.flags,
    e.size,
    e.compressed,
    core@1/int.widen(e.crc),
    e.offset,
    e.dos_time,
    e.external
  ]
  for n in numbers {
    list.push(mut out, b'|')
    u64.format_into(n, mut out)
  }
  list.push(mut out, b'|')
  match e.modified {
    Some(seconds) => i64.format_into(seconds, mut out),
    None() => text.append(mut out, "-"),
  }
  list.push(mut out, b'|')
  text.append(mut out, e.comment)
  text.finish_valid(take out)
}

// Every entry's summary and data.
fn listing(data: Bytes) -> Result[List[(String, Bytes)], zip.ZipError] {
  let mut out: List[(String, Bytes)] = []
  for e in zip.entries(data)? {
    let contents = zip.read(data, e, 1048576)?
    list.push(mut out, (summary(e), contents))
  }
  Ok(out)
}

