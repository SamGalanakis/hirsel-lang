// rule: SEM-3
// expect: run
// RFC 5869 test case 6 (HKDF-SHA-1), through hkdf.derive.
pub fn main() -> Result[(), ()] {
  let okm = std@1/hkdf.derive(
    std@1/sha1.hash(),
    b"",
    b"\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b",
    b"",
    42
  )
  failure.check(
    std@1/hex.encode(okm) == "0ac1af7002b3d761d1e55298da9d0506b9ae52057220a306e07b6b87e8df21d0ea00033de03984d34918",
    TextInvariant()
  )
  Ok(())
}
