// rule: SEM-3
// expect: run
// Published spec.txt vectors; tools/generate-markdown.py.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.check(
    s,
    "commonmark/Setext headings/80",
    "Foo *bar*\n=========\n\nFoo *bar*\n---------\n",
    "<h1>Foo <em>bar</em></h1>\n<h2>Foo <em>bar</em></h2>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Setext headings/81",
    "Foo *bar\nbaz*\n====\n",
    "<h1>Foo <em>bar\nbaz</em></h1>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Setext headings/82",
    "  Foo *bar\nbaz*\t\n====\n",
    "<h1>Foo <em>bar\nbaz</em></h1>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Setext headings/83",
    "Foo\n-------------------------\n\nFoo\n=\n",
    "<h2>Foo</h2>\n<h1>Foo</h1>\n",
    std@1/markdown.default_options()
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
