// rule: SEM-1
// expect: run
// Month-end arithmetic under Clamp and Reject, leap days, range edges and
// day differences (jiff civil::Date month_add and add_constrained vectors).
fn day(t: Test, y: i32, m: u8, d: u8) -> time.Date {
  let Some(value) = date.new(y, m, d) else {
    test.fail(t)
  }
  value
}

pub fn main(t: Test) -> Result[(), ()] {
  let jan31 = day(t, 2024, 1, 31)
  test.equal(t, date.add_months(jan31, 1, Clamp()), Ok(day(t, 2024, 2, 29)))
  test.equal(t, date.add_months(jan31, 1, Reject()), Error(NoSuchDay()))
  test.equal(t, date.add_months(jan31, 2, Reject()), Ok(day(t, 2024, 3, 31)))
  test.equal(t, date.add_months(jan31, 3, Clamp()), Ok(day(t, 2024, 4, 30)))
  test.equal(t, date.add_months(jan31, 13, Clamp()), Ok(day(t, 2025, 2, 28)))
  test.equal(t, date.add_months(jan31, -2, Clamp()), Ok(day(t, 2023, 11, 30)))
  test.equal(t, date.add_months(jan31, -11, Clamp()), Ok(day(t, 2023, 2, 28)))
  test.equal(
    t,
    date.add_months(day(t, 2023, 3, 31), -1, Clamp()),
    Ok(day(t, 2023, 2, 28))
  )
  test.equal(
    t,
    date.add_months(day(t, 2024, 3, 31), -1, Clamp()),
    Ok(day(t, 2024, 2, 29))
  )
  test.equal(t, date.add_months(day(t, 2024, 3, 31), -1, Reject()), Error(NoSuchDay()))
  test.equal(
    t,
    date.add_months(day(t, 2024, 5, 15), 0, Reject()),
    Ok(day(t, 2024, 5, 15))
  )
  // jiff add_constrained: 2023-03-31 plus one month clamps, then a day follows.
  let april = test.expect_ok(t, date.add_months(day(t, 2023, 3, 31), 1, Clamp()))
  test.equal(t, date.add_days(april, 1), Ok(day(t, 2023, 5, 1)))
  let leap = day(t, 2024, 2, 29)
  test.equal(t, date.add_years(leap, 1, Clamp()), Ok(day(t, 2025, 2, 28)))
  test.equal(t, date.add_years(leap, 1, Reject()), Error(NoSuchDay()))
  test.equal(t, date.add_years(leap, 4, Reject()), Ok(day(t, 2028, 2, 29)))
  test.equal(t, date.add_years(leap, -4, Reject()), Ok(day(t, 2020, 2, 29)))
  test.equal(t, date.add_years(leap, -124, Clamp()), Ok(day(t, 1900, 2, 28)))
  test.equal(t, date.add_years(leap, -24, Reject()), Ok(day(t, 2000, 2, 29)))
  // jiff test_month_add range edges.
  test.equal(
    t,
    date.add_months(day(t, 9999, 12, 1), -1, Reject()),
    Ok(day(t, 9999, 11, 1))
  )
  test.equal(
    t,
    date.add_months(day(t, -9999, 1, 1), 1, Reject()),
    Ok(day(t, -9999, 2, 1))
  )
  test.equal(t, date.add_months(day(t, 9999, 12, 1), 1, Clamp()), Error(OutOfRange()))
  test.equal(t, date.add_months(day(t, -9999, 1, 1), -1, Clamp()), Error(OutOfRange()))
  test.equal(
    t,
    date.add_months(day(t, 2024, 1, 1), 9223372036854775807, Clamp()),
    Error(OutOfRange())
  )
  test.equal(
    t,
    date.add_years(day(t, 2024, 1, 1), -9223372036854775807, Clamp()),
    Error(OutOfRange())
  )
  test.equal(
    t,
    date.add_years(day(t, 2024, 1, 1), 7975, Clamp()),
    Ok(day(t, 9999, 1, 1))
  )
  test.equal(t, date.add_years(day(t, 2024, 1, 1), 7976, Clamp()), Error(OutOfRange()))
  test.equal(
    t,
    date.add_years(day(t, 2024, 1, 1), -12023, Clamp()),
    Ok(day(t, -9999, 1, 1))
  )
  test.equal(t, date.add_days(day(t, 9999, 12, 31), 1), Error(OutOfRange()))
  test.equal(t, date.add_days(day(t, -9999, 1, 1), -1), Error(OutOfRange()))
  test.equal(t, date.add_days(day(t, -9999, 1, 1), 7304483), Ok(day(t, 9999, 12, 31)))
  test.equal(
    t,
    date.add_days(day(t, 2024, 1, 1), -9223372036854775807),
    Error(OutOfRange())
  )
  test.equal(t, date.add_days(day(t, 2024, 2, 28), 1), Ok(leap))
  test.equal(t, date.add_days(day(t, 2023, 2, 28), 1), Ok(day(t, 2023, 3, 1)))
  test.equal(t, date.add_days(day(t, 1900, 2, 28), 1), Ok(day(t, 1900, 3, 1)))
  test.equal(t, date.add_days(day(t, 2000, 2, 28), 1), Ok(day(t, 2000, 2, 29)))
  test.equal(t, date.days_between(day(t, 2024, 1, 1), day(t, 2025, 1, 1)), 366)
  test.equal(t, date.days_between(day(t, 2025, 1, 1), day(t, 2024, 1, 1)), -366)
  test.equal(t, date.days_between(day(t, 2023, 1, 1), day(t, 2024, 1, 1)), 365)
  test.equal(t, date.days_between(day(t, -9999, 1, 1), day(t, 9999, 12, 31)), 7304483)
  test.equal(t, date.compare(day(t, 2024, 1, 2), day(t, 2024, 1, 1)), 1)
  test.equal(t, date.compare(day(t, -1, 12, 31), day(t, 0, 1, 1)), -1)
  test.equal(t, date.compare(leap, day(t, 2024, 2, 29)), 0)
  Ok(())
}
