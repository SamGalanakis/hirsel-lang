// rule: SEM-3
// expect: run
// Published spec.txt vectors; tools/generate-markdown.py.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.check(
    s,
    "commonmark/Links/560/malformed",
    "[[bar [foo]\n\u{0}[&unterminated",
    "<p>[[bar [foo]\n�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Links/561/malformed",
    "[Foo]\n\n[foo]:\u{0}[&unterminated",
    "<p><a href=\"%EF%BF%BD%5B&amp;unterminated\">Foo</a></p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Links/562/malformed",
    "[foo] bar\n\n\u{0}[&unterminated",
    "<p>[foo] bar</p>\n<p>�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Links/563/malformed",
    "\\[foo]\n\n[foo]:\u{0}[&unterminated",
    "<p>[foo]</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Links/564/malformed",
    "[foo*]: /ur\u{0}[&unterminated",
    "",
    std@1/markdown.default_options()
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
