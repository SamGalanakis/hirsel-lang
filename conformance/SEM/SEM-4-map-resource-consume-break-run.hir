// rule: SEM-4
// expect: run
// stdout: first
// stdout: drop-first
// stdout: drop-last
resource type Trace {
  stdout: Stdout,
  text: String,
}
drop(x) {
  let _ = out.print(x.stdout, "drop-")
  let _ = out.print(x.stdout, x.text)
}

pub fn main(rt: Io, args: Args) -> Result[(), GrantError] {
  let o = io.stdout(rt)?
  let mut m: Map[u8, Trace] = map.empty()
  map.insert(mut m, 2, Trace(stdout: o, text: "first\n"))
  map.insert(mut m, 1, Trace(stdout: o, text: "last\n"))
  for (k, v) in take m {
    let _ = out.print(o, v.text)
    break
  }
  Ok(())
}
