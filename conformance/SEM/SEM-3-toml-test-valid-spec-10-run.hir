    "key = \"value\"\nbare_key = \"value\"\nbare-key = \"value\"\n1234 = \"value\"\n",
    "{\"1234\":{\"type\":\"string\",\"value\":\"value\"},\"bare-key\":{\"type\":\"string\",\"value\":\"value\"},\"bare_key\":{\"type\":\"string\",\"value\":\"value\"},\"key\":{\"type\":\"string\",\"value\":\"value\"}}"
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
