// rule: SEM-3
// expect: run
// JSONTestSuite 1ef36fa01286573e846ac449e8683f8833c5b26a test_parsing/*.json:1.
// Differential reader twin of the existing imports; exact JsonError offsets.
fn check(t: Test, source: String) -> () {
  let expected: Result[(), json.JsonError] = match json.parse(unique source) {
    Ok(_) => Ok(()),
    Error(e) => Error(e),
  }
  let mut cursor = json.reader(string.as_bytes(source))
  let actual = match json.skip(mut cursor) {
    Ok(()) => json.finish_reader(mut cursor),
    Error(e) => Error(e),
  }
  test.equal(t, actual, expected)
}

pub fn main(t: Test) -> Result[(), ()] {
  // "n_object_several_trailing_commas.json:1"
  check(t, "{\"id\":0,,,,,}")
  // "n_object_single_quote.json:1"
  check(t, "{'a':0}")
  // "n_object_trailing_comma.json:1"
  check(t, "{\"id\":0,}")
  // "n_object_trailing_comment.json:1"
  check(t, "{\"a\":\"b\"}/**/")
  // "n_object_trailing_comment_open.json:1"
  check(t, "{\"a\":\"b\"}/**//")
  // "n_object_trailing_comment_slash_open.json:1"
  check(t, "{\"a\":\"b\"}//")
  // "n_object_trailing_comment_slash_open_incomplete.json:1"
  check(t, "{\"a\":\"b\"}/")
  // "n_object_two_commas_in_a_row.json:1"
  check(t, "{\"a\":\"b\",,\"c\":\"d\"}")
  Ok(())
}
