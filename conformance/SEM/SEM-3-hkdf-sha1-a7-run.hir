// rule: SEM-3
// expect: run
// RFC 5869 test case 7 (HKDF-SHA-1), through hkdf.derive.
pub fn main() -> Result[(), ()] {
  let okm = std@1/hkdf.derive(
    std@1/sha1.hash(),
    b"",
    b"\x0c\x0c\x0c\x0c\x0c\x0c\x0c\x0c\x0c\x0c\x0c\x0c\x0c\x0c\x0c\x0c\x0c\x0c\x0c\x0c\x0c\x0c",
    b"",
    42
  )
  failure.check(
    std@1/hex.encode(okm) == "2c91117204d745f3500d636a62f64f0ab3bae548aa53d423b0d1f27ebba6f5e5673a081d70cce7acfc48",
    TextInvariant()
  )
  Ok(())
}
