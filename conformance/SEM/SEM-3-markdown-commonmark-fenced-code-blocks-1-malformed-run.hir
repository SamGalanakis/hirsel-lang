    "~~~\n<\n\u{0}[&unterminated",
    "<pre><code>&lt;\n�[&amp;unterminated\n</code></pre>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Fenced code blocks/121/malformed",
    "``\nfo\u{0}[&unterminated",
    "<p>``\nfo�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
