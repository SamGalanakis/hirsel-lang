// expect: run
// Generated by tools/generate-json-vectors.py; see docs/json-domain-vectors.md.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.parses(s, "n_multidigit_number_then_00.json:1", "123\u{0}", 1)
  failed += harness.parses(s, "n_number_++.json:1", "[++1234]", 1)
  failed += harness.parses(s, "n_number_+1.json:1", "[+1]", 1)
  failed += harness.parses(s, "n_number_+Inf.json:1", "[+Inf]", 1)
  failed += harness.parses(s, "n_number_-01.json:1", "[-01]", 1)
  failed += harness.parses(s, "n_number_-1.0..json:1", "[-1.0.]", 1)
  failed += harness.parses(s, "n_number_-2..json:1", "[-2.]", 1)
  failed += harness.parses(s, "n_number_-NaN.json:1", "[-NaN]", 1)
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
