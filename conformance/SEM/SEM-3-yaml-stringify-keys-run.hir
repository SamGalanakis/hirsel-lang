// rule: SEM-3
// expect: run
// std@1/yaml.stringify quotes keys by the rules for strings.
fn writes(take input: String, expected: String) -> bool {
  let Ok(value) = yaml.parse(take input) else {
    return false
  }
  let Ok(written) = yaml.stringify(value) else {
    return false
  }
  if written != expected {
    return false
  }
  yaml.parse(take written) == Ok(value)
}

fn repeat(mut out: List[u8], piece: String, count: u64) -> () {
  let mut i: u64 = 0
  while i < count {
    text.append(mut out, piece)
    i += 1
  }
}

fn nested(levels: u64) -> yaml.Value {
  let mut value: yaml.Value = Null()
  let mut i: u64 = 0
  while i < levels {
    value = Array([take value])
    i += 1
  }
  value
}

pub fn main(rt: Io) -> Result[(), ()] {
  // Keys follow the same rules.
  failure.check(
    writes(
      "{'': 1, 'a b': 2, 'yes': 3, 'x: y': 4, '1': 5, k: {'n': [x]}}",
      "\"\": 1\na b: 2\n\"yes\": 3\n\"x: y\": 4\n\"1\": 5\nk:\n  \"n\":\n    - x\n"
    ),
    TextInvariant()
  )
  Ok(())
}
