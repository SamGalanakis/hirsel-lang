// rule: SEM-3
// expect: run
// std@1/yaml.remove takes a block entry's lines with the comment lines above it,
// keeps the document's leading comment, and leaves an emptied collection as {}.
fn edits(r: Result[(), yaml.YamlError], doc: yaml.Document, expected: String) -> bool {
  r == Ok(()) && yaml.source(doc) == expected
}

pub fn main(rt: Io) -> Result[(), ()] {
  let Ok(doc) = yaml.document(
    "# CI\nname: CI  # the name\non:\n  push:\n    branches: [main]\njobs:\n  test:\n    steps:\n      - uses: checkout\n      # run the tests\n      - run: make\n"
  ) else {
    failure.check(false, TextInvariant())
    return Ok(())
  }
  let mut a = copy doc
  failure.check(
    edits(
      yaml.remove(mut a, [Key("jobs"), Key("test"), Key("steps"), Index(1)]),
      a,
      "# CI\nname: CI  # the name\non:\n  push:\n    branches: [main]\njobs:\n  test:\n    steps:\n      - uses: checkout\n"
    ),
    TextInvariant()
  )
  let mut b = copy doc
  failure.check(
    edits(
      yaml.remove(mut b, [Key("name")]),
      b,
      "# CI\non:\n  push:\n    branches: [main]\njobs:\n  test:\n    steps:\n      - uses: checkout\n      # run the tests\n      - run: make\n"
    ),
    TextInvariant()
  )
  let mut c = copy doc
  failure.check(
    edits(
      yaml.remove(mut c, [Key("on"), Key("push")]),
      c,
      "# CI\nname: CI  # the name\non: {}\njobs:\n  test:\n    steps:\n      - uses: checkout\n      # run the tests\n      - run: make\n"
    ),
    TextInvariant()
  )
  failure.check(
    yaml.remove(mut c, [Key("missing")]) == Error(NotFound()),
    TextInvariant()
  )
  Ok(())
}
