// rule: SEM-3
// expect: run
// dtolnay/semver tests/test_version.rs and tests/test_version_req.rs
// (280ebcb6; offsets are this module's, and precedence ignores build metadata
// where semver's Ord does not), and npm/node-semver test/fixtures
// range-include.js, range-exclude.js, range-parse.js and comparisons.js rows
// without the loose and includePrerelease options (6e05b763; a leading v is
// dropped from versions, and ranges past 2^53 are omitted since numbers here
// are u64). Expected npm spellings are node-semver's, in this module's syntax.
fn npm_matches() -> List[(String, String, bool)] uses {} {
  [
    ("1.0.0 - 2.0.0", "1.2.3", true),
    ("^1.2.3+build", "1.2.3", true),
    ("^1.2.3+build", "1.3.0", true),
    ("1.2.3-pre+asdf - 2.4.3-pre+asdf", "1.2.3", true),
    ("1.2.3-pre+asdf - 2.4.3-pre+asdf", "1.2.3-pre.2", true),
    ("1.2.3-pre+asdf - 2.4.3-pre+asdf", "2.4.3-alpha", true),
    ("1.2.3+asdf - 2.4.3+asdf", "1.2.3", true),
    ("1.0.0", "1.0.0", true),
    (">=*", "0.2.4", true),
    ("", "1.0.0", true),
    ("*", "1.2.3", true),
    (">=1.0.0", "1.0.1", true),
    (">=1.0.0", "1.1.0", true),
    (">1.0.0", "1.0.1", true),
    (">1.0.0", "1.1.0", true),
    ("<=2.0.0", "2.0.0", true),
    ("<=2.0.0", "1.9999.9999", true),
    ("<=2.0.0", "0.2.9", true),
    ("<2.0.0", "1.9999.9999", true),
    ("<2.0.0", "0.2.9", true),
    (">= 1.0.0", "1.0.0", true),
    (">=  1.0.0", "1.0.1", true),
    (">=   1.0.0", "1.1.0", true),
    ("> 1.0.0", "1.0.1", true),
    (">  1.0.0", "1.1.0", true),
    ("<=   2.0.0", "2.0.0", true),
    ("<= 2.0.0", "1.9999.9999", true),
    ("<=  2.0.0", "0.2.9", true),
    ("<    2.0.0", "1.9999.9999", true),
    ("<\t2.0.0", "0.2.9", true),
    (">=0.1.97", "0.1.97", true),
    ("0.1.20 || 1.2.4", "1.2.4", true),
    (">=0.2.3 || <0.0.1", "0.0.0", true),
    (">=0.2.3 || <0.0.1", "0.2.3", true),
    (">=0.2.3 || <0.0.1", "0.2.4", true),
    ("||", "1.3.4", true),
    ("2.x.x", "2.1.3", true),
    ("1.2.x", "1.2.3", true),
    ("1.2.x || 2.x", "2.1.3", true),
    ("1.2.x || 2.x", "1.2.3", true),
    ("x", "1.2.3", true),
    ("2.*.*", "2.1.3", true),
    ("1.2.*", "1.2.3", true),
    ("1.2.* || 2.*", "2.1.3", true),
    ("1.2.* || 2.*", "1.2.3", true),
    ("*", "1.2.3", true),
    ("2", "2.1.2", true),
    ("2.3", "2.3.1", true),
    ("~0.0.1", "0.0.1", true),
    ("~0.0.1", "0.0.2", true),
    ("~x", "0.0.9", true),
    ("~2", "2.0.9", true),
    ("~2.4", "2.4.0", true),
    ("~2.4", "2.4.5", true),
    ("~>3.2.1", "3.2.2", true),
    ("~1", "1.2.3", true),
    ("~>1", "1.2.3", true),
    ("~> 1", "1.2.3", true),
    ("~1.0", "1.0.2", true),
    ("~ 1.0", "1.0.2", true),
    ("~ 1.0.3", "1.0.12", true),
    (">=1", "1.0.0", true),
    (">= 1", "1.0.0", true),
    ("<1.2", "1.1.1", true),
    ("< 1.2", "1.1.1", true),
    ("~v0.5.4-pre", "0.5.5", true),
    ("~v0.5.4-pre", "0.5.4", true),
    ("=0.7.x", "0.7.2", true),
    ("<=0.7.x", "0.7.2", true),
    (">=0.7.x", "0.7.2", true),
    ("<=0.7.x", "0.6.2", true),
    ("~1.2.1 >=1.2.3", "1.2.3", true),
    ("~1.2.1 =1.2.3", "1.2.3", true),
    ("~1.2.1 1.2.3", "1.2.3", true),
    ("~1.2.1 >=1.2.3 1.2.3", "1.2.3", true),
    ("~1.2.1 1.2.3 >=1.2.3", "1.2.3", true),
    (">=1.2.1 1.2.3", "1.2.3", true),
    ("1.2.3 >=1.2.1", "1.2.3", true)
  ]
}

pub fn main(t: Test) -> Result[(), semver.SemverError] {
  let mut case: u64 = 3000
  for (range, spelling, expected) in npm_matches() {
    let req = semver.parse_npm(range)?
    let found = match semver.parse(spelling) {
      Ok(v) => semver.matches(req, v),
      Error(_) => false,
    }
    test.check_case(t, found == expected, case)
    case += 1
  }
  Ok(())
}
