// rule: SEM-3
// expect: run
// CPython Lib/test/test_shlex.py posix_data (testSplitPosix, with comments),
// the same rows without `#` through split, testJoinRoundtrip over data and
// posix_data, testQuote and testJoin (python/cpython 036d309c). Python raises
// ValueError where these return UnclosedQuote or TrailingEscape.
// testCompat's expected words; joining and splitting them round-trips.
fn compat() -> List[List[String]] uses {} {
  [
    ["x"],
    ["foo", "bar"],
    ["foo", "bar"],
    ["foo", "bar"],
    ["foo", "bar", "bla", "fasel"],
    ["x", "y", "z", "xxxx"],
    [r#"\"#, "x", "bar"],
    [r#"\"#, "x", "bar"],
    [r#"\"#, "bar"],
    ["foo", r#"\"#, "x", "bar"],
    ["foo", r#"\"#, "x", "bar"],
    ["foo", r#"\"#, "bar"],
    ["foo", r#""bar""#, "bla"],
    [r#""foo""#, r#""bar""#, r#""bla""#],
    [r#""foo""#, "bar", r#""bla""#],
    [r#""foo""#, "bar", "bla"],
    ["foo", "'bar'", "bla"],
    ["'foo'", "'bar'", "'bla'"],
    ["'foo'", "bar", "'bla'"],
    ["'foo'", "bar", "bla"],
    ["blurb", r#"foo"bar"bar"fasel""#, "baz"],
    ["blurb", "foo'bar'bar'fasel'", "baz"],
    [r#""""#],
    ["''"],
    ["foo", r#""""#, "bar"],
    ["foo", "''", "bar"],
    ["foo", r#""""#, r#""""#, r#""""#, "bar"],
    ["foo", "''", "''", "''", "bar"],
    [r#"\"#, r#""""#],
    [r#""\""#],
    [r#""foo\ bar""#],
    [r#""foo\\ bar""#],
    [r#""foo\\ bar\""#],
    [r#""foo\\""#, "bar", r#"\"#, r#""""#],
    [r#""foo\\ bar\""#, r#"dfadf""#],
    [r#""foo\\\ bar\""#, r#"dfadf""#],
    [r#""foo\\\x bar\""#, r#"dfadf""#],
    [r#""foo\x bar\""#, r#"dfadf""#],
    [r#"\"#, "''"],
    [r#"'foo\ bar'"#],
    [r#"'foo\\ bar'"#],
    [r#""foo\\\x bar\""#, "df'a", r#"\"#, "'df'"],
    [r#"\"#, r#""foo""#],
    [r#"\"#, r#""foo""#, r#"\"#, "x"],
    [r#""foo\x""#],
    [r#""foo\ ""#],
    ["foo", r#"\"#, "xx"],
    ["foo", r#"\"#, "x", r#"\"#, "x"],
    ["foo", r#"\"#, "x", r#"\"#, "x", r#"\"#, r#""""#],
    [r#""foo\ x\x""#],
    [r#""foo\ x\x\\""#],
    [r#""foo\ x\x\\""#, r#""foobar""#],
    [r#""foo\ x\x\\""#, r#"\"#, "''", r#""foobar""#],
    [r#""foo\ x\x\\""#, r#"\"#, r#"'"fo'"#, r#"obar""#],
    [r#""foo\ x\x\\""#, r#"\"#, r#"'"fo'"#, r#"obar""#, "'don'", r#"\"#, "''", "t'"],
    [r#"'foo\ bar'"#],
    [r#"'foo\\ bar'"#],
    ["foo", r#"\"#, "bar"],
    ["foobaz"],
    [":", "-", ")", ";", "-", ")"],
    ["á", "é", "í", "ó", "ú"]
  ]
}

pub fn main(t: Test) -> Result[(), shlex.SplitError] {
  let mut case: u64 = 62
  for expected in compat() {
    test.check_case(t, shlex.split(shlex.join(expected))? == expected, case)
    case += 1
  }
  Ok(())
}
