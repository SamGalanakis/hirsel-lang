// rule: SEM-3
// expect: run
// Inputs: Go src/internal/diff/testdata (golang/go ebe2feef) and fixed pairs.
// Expected unified diffs are git 2.43.0's `git diff --no-index
// --no-indent-heuristic -U<n> --diff-algorithm=<myers|patience>` output, with
// names replaced and the function context after `@@` dropped; expected patch
// results are GNU patch 2.7.6's `patch --fuzz=0 --forward` output and rejected
// hunk numbers.
fn contexts() -> List[(String, String, diff.Algorithm, u64, String)] uses {} {
  [
    (
      "f0\nb2\nf0\nf1\nf2\ng2\nc0\ng1\ne0\nd2\na0\nf1\nh1\ne0\nd2\ne2\ng0\nd2\nd2\nh0\ng1\na2\ne0\nb1\nh2\ng2\na0\nf1\nf1\nb0\nd1\ne1\nc1\nb2\na2\ne2\na2\nc0\ng1\ng2\n",
      "f0\nb2\na0\nf1\nf2\ng2\nc0\ng1\ne0\nd2\na0\nh1\ne0\nb2\ng0\nd2\nd2\nh0\nc2\ng1\ny1\nz1\ne0\nb1\nh2\ng2\na0\nf1\nb0\nd1\ne1\nc1\nb2\na2\nb2\nc0\ng1\ng2\n",
      Patience(),
      1u64,
      "--- old\n+++ new\n@@ -2,3 +2,3 @@\n b2\n-f0\n+a0\n f1\n@@ -11,7 +11,5 @@\n a0\n-f1\n h1\n e0\n-d2\n-e2\n+b2\n g0\n@@ -20,4 +18,6 @@\n h0\n+c2\n g1\n-a2\n+y1\n+z1\n e0\n@@ -28,3 +28,2 @@\n f1\n-f1\n b0\n@@ -35,4 +34,3 @@\n a2\n-e2\n-a2\n+b2\n c0\n"
    ),
    (
      "a1\nd2\nd1\nb0\ng1\na1\nd2\nd2\nh1\nd0\nh1\nc0\nf2\na0\nh2\na1\nb2\nd1\ng1\nf0\nh0\ng2\ng2\ng2\nh0\na0\nb0\ne0\nb0\nh0\nf0\ng1\nb1\nc0\ng0\ng0\ng0\nd2\ng2\ng2\n",
      "a1\ny2\nd2\nd1\nb0\ng1\na1\ny0\nd2\nd2\nh1\nd0\nh1\nc2\nc0\na1\nf2\na0\nh2\nz1\ny1\nb2\nd1\ng1\nf0\nh0\ng2\ng2\nh0\nb1\nb1\ne0\nh0\nf0\ng1\nb1\nc0\ng0\ng0\ng0\nd2\ng2\ng2\n",
      Myers(),
      0u64,
      "--- old\n+++ new\n@@ -1,0 +2 @@\n+y2\n@@ -6,0 +8 @@\n+y0\n@@ -11,0 +14 @@\n+c2\n@@ -12,0 +16 @@\n+a1\n@@ -16 +20,2 @@\n-a1\n+z1\n+y1\n@@ -24 +28,0 @@\n-g2\n@@ -26,2 +30,2 @@\n-a0\n-b0\n+b1\n+b1\n@@ -29 +32,0 @@\n-b0\n"
    )
  ]
}

pub fn main(t: Test) -> Result[(), diff.PatchError] {
  let mut case: u64 = 48
  for (old, new, algorithm, context, expected) in contexts() {
    test.check_case(
      t,
      diff.unified("old", old, "new", new, algorithm, context) == expected,
      case
    )
    let applied = diff.apply(old, expected)?
    test.check_case(t, applied.text == new && list.len(applied.rejected) == 0, case)
    case += 1
  }
  Ok(())
}
