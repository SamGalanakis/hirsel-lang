// expect: run
// Generated by tools/generate-json-vectors.py; see docs/json-domain-vectors.md.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.parses(s, "n_array_star_inside.json:1", "[*]", 1)
  failed += harness.parses(s, "n_array_unclosed.json:1", "[\"\"", 1)
  failed += harness.parses(s, "n_array_unclosed_trailing_comma.json:1", "[1,", 1)
  failed += harness.parses(s, "n_array_unclosed_with_new_lines.json:1", "[1,\n1\n,1", 1)
  failed += harness.parses(s, "n_array_unclosed_with_object_inside.json:1", "[{}", 1)
  failed += harness.parses(s, "n_incomplete_false.json:1", "[fals]", 1)
  failed += harness.parses(s, "n_incomplete_null.json:1", "[nul]", 1)
  failed += harness.parses(s, "n_incomplete_true.json:1", "[tru]", 1)
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
