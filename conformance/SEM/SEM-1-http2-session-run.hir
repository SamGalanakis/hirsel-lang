80\x80\x80\x80\x80\x80\x80\x80\x80\x80\x80\x80\x80\x80\x80\x80\x80\x80"

const FLOW_PAYLOAD: Bytes = b""

@test
fn large_header_encoding(t: Test) {
  let mut client = std@1/http2.session(Client(), 65536)
  let mut server = std@1/http2.session(Server(), 65536)
  handshake(mut client, mut server)
  let mut fields = request_fields()
  list.push(mut fields, field(b"large", LARGE_VALUE))
  test.check(t, std@1/http2.open(mut client, fields, false) == Ok(1))
  let (prefix, frames) = std@1/http2.drain_frames(mut client)
  test.check(t, prefix == b"" && list.len(frames) == 2)
  test.check(t, frames[0].kind == 1 && frames[0].stream == 1 && frames[0].flags == 0)
  test.check(t, bytes.len(frames[0].payload) == 16384)
  test.check(t, frames[1].kind == 9 && frames[1].stream == 1 && frames[1].flags == 4)
  test.check(t, bytes.len(frames[1].payload) > 616)
}

@test
fn large_header_decoding(t: Test) {
  let mut server = std@1/http2.session(Server(), 65536)
  test.check(
    t,
    std@1/http2.receive(
      mut server,
      std@1/http2_wire.Frame(kind: 4, flags: 0, stream: 0, payload: b"")
    ) == Ok(Settings())
  )
  let first = std@1/http2_wire.Frame(
    kind: 1,
    flags: 0,
    stream: 1,
    payload: bytes.slice(LARGE_BLOCK, 0, 16384)
  )
  test.check(t, std@1/http2.receive(mut server, first) == Ok(Idle()))
  let last = std@1/http2_wire.Frame(
    kind: 9,
    flags: 4,
    stream: 1,
    payload: bytes.slice(LARGE_BLOCK, 16384, bytes.len(LARGE_BLOCK))
  )
  test.check(
    t,
    std@1/http2.receive(mut server, last) == Ok(
      Headers(
        1,
        [
          field(b":method", b"GET"),
          field(b":scheme", b"https"),
          field(b":path", b"/"),
          field(b"large", LARGE_VALUE)
        ],
        false
      )
    )
  )
  let body = std@1/http2_wire.Frame(kind: 0, flags: 1, stream: 1, payload: b"x")
  test.check(t, std@1/http2.receive(mut server, body) == Ok(Data(1, b"x", 1, true)))
}

@test
fn backpressure(t: Test) {
  let mut client = std@1/http2.session(Client(), 65536)
  let mut server = std@1/http2.session(Server(), 65536)
  handshake(mut client, mut server)
  test.check(t, std@1/http2.open(mut client, request_fields(), false) == Ok(1))
  let _ = transfer(mut server, std@1/http2.output(mut client))
  let mut sent: u64 = 0
  for i in 0u64..4u64 {
    match std@1/http2.send_data(mut client, 1, FLOW_PAYLOAD, false) {
      Ok(count) => {
        sent += count
      },
      Error(_) => test.check(t, false),
    }
  }
  test.check(t, sent == 65535)
  test.check(t, std@1/http2.send_data(mut client, 1, b"x", true) == Ok(0))
  let (prefix, frames) = std@1/http2.drain_frames(mut client)
  test.check(t, prefix == b"" && list.len(frames) == 4)
  let mut received: u64 = 0
  for frame in frames {
    match std@1/http2.receive(mut server, frame) {
      Ok(Data(id, body, cost, end)) => {
        received += bytes.len(body)
        test.check(t, id == 1 && !end)
        test.check(t, std@1/http2.consumed(mut server, id, cost) == Ok(()))
      },
      _ => test.check(t, false),
    }
  }
  test.check(t, received == sent)
  let _ = transfer(mut client, std@1/http2.output(mut server))
  test.check(t, std@1/http2.send_data(mut client, 1, b"x", true) == Ok(1))
  test.check(
    t,
    transfer(mut server, std@1/http2.output(mut client)) == [Data(1, b"x", 1, true)]
  )
}

@test
fn malformed_stream_preserves_compression(t: Test) {
  let mut server = std@1/http2.session(Server(), 65536)
  let settings = std@1/http2_wire.Frame(kind: 4, flags: 0, stream: 0, payload: b"")
  let _ = std@1/http2.receive(mut server, settings)
  let mut encoder = std@1/hpack.encoder(4096)
  let first = std@1/http2_wire.Frame(
    kind: 1,
    flags: 5,
    stream: 1,
    payload: std@1/hpack.encode(mut encoder, request_fields())
  )
  test.check(
    t,
    std@1/http2.receive(mut server, first) == Ok(Headers(1, request_fields(), true))
  )
  // A header block on a remotely closed stream still updates HPACK before
  // RST_STREAM, since the next stream may refer to its new dynamic entry.
  let addition: List[std@1/hpack.Field] = [field(b"x", b"new")]
  let bad = std@1/http2_wire.Frame(
    kind: 1,
    flags: 5,
    stream: 1,
    payload: std@1/hpack.encode(mut encoder, addition)
  )
  test.check(
    t,
    std@1/http2.receive(mut server, bad) == Error(Wire(StreamError(1, StreamClosed())))
  )
  let mut fields = request_fields()
  list.push(mut fields, field(b"x", b"new"))
  let next = std@1/http2_wire.Frame(
    kind: 1,
    flags: 5,
    stream: 3,
    payload: std@1/hpack.encode(mut encoder, fields)
  )
  test.check(
    t,
    std@1/http2.receive(mut server, next) == Ok(Headers(3, take fields, true))
  )
}

@test
fn informational_trailers_and_lengths(t: Test) {
  let mut client = std@1/http2.session(Client(), 65536)
  let mut server = std@1/http2.session(Server(), 65536)
  handshake(mut client, mut server)
  let _ = std@1/http2.open(mut client, request_fields(), true)
  let _ = transfer(mut server, std@1/http2.output(mut client))
  let info: List[std@1/hpack.Field] = [field(b":status", b"103")]
  let response: List[std@1/hpack.Field] = [
    field(b":status", b"200"),
    field(b"content-length", b"2")
  ]
  let trailers: List[std@1/hpack.Field] = [field(b"checksum", b"ok")]
  test.check(t, std@1/http2.headers(mut server, 1, info, false) == Ok(()))
  test.check(t, std@1/http2.headers(mut server, 1, response, false) == Ok(()))
  test.check(t, std@1/http2.send_data(mut server, 1, b"hi", false) == Ok(2))
  test.check(t, std@1/http2.headers(mut server, 1, trailers, true) == Ok(()))
  test.check(
    t,
    transfer(mut client, std@1/http2.output(mut server)) == [
      Headers(1, take info, false),
      Headers(1, take response, false),
      Data(1, b"hi", 2, false),
      Headers(1, take trailers, true)
    ]
  )
  let mut broken = std@1/http2.session(Server(), 65536)
  let settings = std@1/http2_wire.Frame(kind: 4, flags: 0, stream: 0, payload: b"")
  let _ = std@1/http2.receive(mut broken, settings)
  let mut encoder = std@1/hpack.encoder(4096)
  let mut fields = request_fields()
  list.push(mut fields, field(b"content-length", b"1"))
  let headers = std@1/http2_wire.Frame(
    kind: 1,
    flags: 5,
    stream: 1,
    payload: std@1/hpack.encode(mut encoder, fields)
  )
  test.check(
    t,
    std@1/http2.receive(mut broken, headers) == Error(Wire(StreamError(1, Protocol())))
  )
}

@test
fn scripted_server(t: Test) -> Result[(), std@1/http2.Error] {
  let n = test.net(
    t,
    [
      NetPeer(
        address: "h2.test",
        port: 80u16,
        resolves_to: [V4([127u8, 0u8, 0u8, 1u8])],
        tls: Plain(),
        connections: [
          Open(
            [
              Expect(b"\x00\x00\x06\x04\x00\x00\x00\x00\x00\x00\x03\x00\x00\x00\xfa"),
              Send(b"PRI * HTTP/2.0\r\n\r\nSM\r"),
              Send(
                b"\n\r\n\x00\x00\x00\x04\x00\x00\x00\x00\x00\x00\x00\x03\x01\x05\x00\x00\x00\x01\x82\x86\x84"
              ),
              Expect(b"\x00\x00\x00\x04\x01\x00\x00\x00\x00"),
              Expect(
                b"\x00\x00\x01\x01\x04\x00\x00\x00\x01\x88\x00\x00\x02\x00\x01\x00\x00\x00\x01hi"
              ),
              Close()
            ]
          )
        ]
      )
    ],
    []
  )
  let stream = net.connect(n, "h2.test", 80u16, Unbounded()) ? network_error
  let mut c = std@1/http2.connection(n, take stream, Server(), 65536)
  test.check(t, std@1/http2.next_event(mut c)? == Settings())
  test.check(
    t,
    std@1/http2.next_event(mut c)? == Headers(
      1,
      [field(b":method", b"GET"), field(b":scheme", b"http"), field(b":path", b"/")],
      true
    )
  )
  std@1/http2.write_headers(mut c, 1, [field(b":status", b"200")], false)?
  test.check(t, std@1/http2.write_body(mut c, 1, b"hi", true)? == 2)
  test.check(t, std@1/http2.next_event(mut c) == Error(Closed()))
  Ok(())
}

@test
fn bad_preface(t: Test) -> Result[(), std@1/http2.Error] {
  let n = test.net(
    t,
    [
      NetPeer(
        address: "h2.test",
        port: 80u16,
        resolves_to: [V4([127u8, 0u8, 0u8, 1u8])],
        tls: Plain(),
        connections: [
          Open(
            [
              Expect(b"\x00\x00\x06\x04\x00\x00\x00\x00\x00\x00\x03\x00\x00\x00\xfa"),
              Send(b"X"),
              Close()
            ]
          )
        ]
      )
    ],
    []
  )
  let stream = net.connect(n, "h2.test", 80u16, Unbounded()) ? network_error
  let mut c = std@1/http2.connection(n, take stream, Server(), 65536)
  test.check(t, std@1/http2.next_event(mut c) == Error(InvalidPreface()))
  test.check(t, std@1/http2.next_event(mut c) == Error(Closed()))
  Ok(())
}

@test
fn concurrency_limit_excludes_closed_bodies(t: Test) {
  let mut client = std@1/http2.session(Client(), 65536)
  let mut server = std@1/http2.session(Server(), 65536)
  handshake(mut client, mut server)
  let setting = std@1/http2_wire.Frame(
    kind: 4,
    flags: 0,
    stream: 0,
    payload: b"\x00\x03\x00\x00\x00\x01"
  )
  let _ = std@1/http2.receive(mut client, setting)
  // The setting is synthetic; remove its acknowledgement before transferring requests.
  let _ = std@1/http2.output(mut client)
  test.check(t, std@1/http2.open(mut client, request_fields(), true) == Ok(1))
  test.check(
    t,
    std@1/http2.open(mut client, request_fields(), true) == Error(WouldBlock())
  )
  let _ = transfer(mut server, std@1/http2.output(mut client))
  let _ = std@1/http2.headers(mut server, 1, [field(b":status", b"200")], false)
  let _ = std@1/http2.send_data(mut server, 1, b"hi", true)
  let _ = transfer(mut client, std@1/http2.output(mut server))
  // The application's unconsumed body retains credit, but the stream is closed
  // and no longer contributes to SETTINGS_MAX_CONCURRENT_STREAMS.
  test.check(t, std@1/http2.open(mut client, request_fields(), true) == Ok(3))
  test.check(t, std@1/http2.consumed(mut client, 1, 2) == Ok(()))
}

@test
fn retired_stream_frames(t: Test) {
  // A server treats HEADERS on a retired stream as a stream that went down,
  // a connection error (Go server.go:2167 "stream_went_down"); late DATA only
  // closes its stream and returns the connection credit.
  let mut server = std@1/http2.session(Server(), 65536)
  let mut encoder = std@1/hpack.encoder(4096)
  let _ = std@1/http2.receive(
    mut server,
    std@1/http2_wire.Frame(kind: 4, flags: 0, stream: 0, payload: b"")
  )
  let first = std@1/http2_wire.Frame(
    kind: 1,
    flags: 5,
    stream: 1,
    payload: std@1/hpack.encode(mut encoder, request_fields())
  )
  test.check(
    t,
    std@1/http2.receive(mut server, first) == Ok(Headers(1, request_fields(), true))
  )
  test.check(
    t,
    std@1/http2.headers(mut server, 1, [field(b":status", b"200")], true) == Ok(())
  )
  let _ = std@1/http2.output(mut server)
  let late = std@1/http2_wire.Frame(kind: 0, flags: 1, stream: 1, payload: b"x")
  test.check(
    t,
    std@1/http2.receive(mut server, late) == Error(Wire(StreamError(1, StreamClosed())))
  )
  let (_, credit) = std@1/http2.drain_frames(mut server)
  test.check(
    t,
    list.len(credit) == 2 && credit[0].kind == 8 && credit[0].stream == 0 && credit[1].kind == 3
  )
  let closed = std@1/http2_wire.Frame(
    kind: 1,
    flags: 5,
    stream: 1,
    payload: std@1/hpack.encode(mut encoder, [field(b"x", b"new")])
  )
  test.check(
    t,
    std@1/http2.receive(mut server, closed) == Error(Wire(ConnectionError(Protocol())))
  )
  let (_, goaway) = std@1/http2.drain_frames(mut server)
  test.check(
    t,
    list.len(goaway) == 1 && goaway[0].kind == 7 && std@1/http2_wire.read_u32(
      goaway[0].payload,
      4
    ) == 1
  )
  let mut fresh = std@1/http2.session(Server(), 65536)
  let _ = std@1/http2.receive(
    mut fresh,
    std@1/http2_wire.Frame(kind: 4, flags: 0, stream: 0, payload: b"")
  )
  let idle = std@1/http2_wire.Frame(
    kind: 8,
    flags: 0,
    stream: 2,
    payload: b"\x00\x00\x00\x01"
  )
  test.check(
    t,
    std@1/http2.receive(mut fresh, idle) == Error(Wire(ConnectionError(Protocol())))
  )
}

@test
fn forgotten_stream_preserves_compression(t: Test) {
  // A client may have forgotten a stream it finished, so late response HEADERS
  // close only that stream (h2 proto/streams/streams.rs:500), and still update
  // HPACK, since the next response may refer to the new dynamic entry.
  let mut client = std@1/http2.session(Client(), 65536)
  let mut server = std@1/http2.session(Server(), 65536)
  handshake(mut client, mut server)
  test.check(t, std@1/http2.open(mut client, request_fields(), true) == Ok(1))
  let _ = transfer(mut server, std@1/http2.output(mut client))
  test.check(
    t,
    std@1/http2.headers(mut server, 1, [field(b":status", b"204")], true) == Ok(())
  )
  let _ = transfer(mut client, std@1/http2.output(mut server))
  let mut encoder = std@1/hpack.encoder(4096)
  let _ = std@1/hpack.encode(mut encoder, [field(b":status", b"204")])
  let late = std@1/http2_wire.Frame(
    kind: 1,
    flags: 5,
    stream: 1,
    payload: std@1/hpack.encode(
      mut encoder,
      [field(b":status", b"200"), field(b"x", b"new")]
    )
  )
  test.check(
    t,
    std@1/http2.receive(mut client, late) == Error(Wire(StreamError(1, StreamClosed())))
  )
  test.check(t, std@1/http2.open(mut client, request_fields(), true) == Ok(3))
  let response: List[std@1/hpack.Field] = [
    field(b":status", b"200"),
    field(b"x", b"new")
  ]
  let next = std@1/http2_wire.Frame(
    kind: 1,
    flags: 5,
    stream: 3,
    payload: std@1/hpack.encode(mut encoder, response)
  )
  test.check(
    t,
    std@1/http2.receive(mut client, next) == Ok(Headers(3, take response, true))
  )
}

@test
fn goaway_refuses_new_requests(t: Test) {
  let mut client = std@1/http2.session(Client(), 65536)
  let mut server = std@1/http2.session(Server(), 65536)
  handshake(mut client, mut server)
  test.check(t, std@1/http2.open(mut client, request_fields(), false) == Ok(1))
  test.check(
    t,
    transfer(mut server, std@1/http2.output(mut client)) == [
      Headers(1, request_fields(), false)
    ]
  )
  std@1/http2.goaway(mut server, NoError())
  let (_, initial) = std@1/http2.drain_frames(mut server)
  test.check(
    t,
    list.len(initial) == 1 && initial[0].kind == 7 && std@1/http2_wire.read_u32(
      initial[0].payload,
      0
    ) == 1
  )
  // Stream 3 raced with GOAWAY. Its new dynamic entry must still be decoded.
  let mut fields = request_fields()
  list.push(mut fields, field(b"x", b"new"))
  test.check(t, std@1/http2.open(mut client, fields, true) == Ok(3))
  let (_, raced) = std@1/http2.drain_frames(mut client)
  test.check(t, list.len(raced) == 1)
  test.check(
    t,
    std@1/http2.receive(mut server, raced[0]) == Error(
      Wire(StreamError(3, RefusedStream()))
    )
  )
  let (_, resets) = std@1/http2.drain_frames(mut server)
  test.check(t, list.len(resets) == 1 && resets[0].kind == 3 && resets[0].stream == 3)
  test.check(
    t,
    std@1/http2.headers(mut client, 1, [field(b"x", b"new")], true) == Ok(())
  )
  test.check(
    t,
    transfer(mut server, std@1/http2.output(mut client)) == [
      Headers(1, [field(b"x", b"new")], true)
    ]
  )
  std@1/http2.goaway(mut server, NoError())
  let (_, final) = std@1/http2.drain_frames(mut server)
  test.check(
    t,
    list.len(final) == 1 && final[0].kind == 7 && std@1/http2_wire.read_u32(
      final[0].payload,
      0
    ) == 1
  )
}

// Feed `frames` to a server session after SETTINGS: the first `good` succeed
// and, when that is not all of them, the next is a PROTOCOL_ERROR connection error.
fn frame_order(t: Test, frames: List[std@1/http2_wire.Frame], good: u64) {
  let mut server = std@1/http2.session(Server(), 65536)
  let _ = std@1/http2.receive(
    mut server,
    std@1/http2_wire.Frame(kind: 4, flags: 0, stream: 0, payload: b"")
  )
  let mut i: u64 = 0
  while i < list.len(frames) {
    let outcome = std@1/http2.receive(mut server, frames[i])
    if i < good {
      test.check(
        t,
        match outcome {
          Ok(_) => true,
          Error(_) => false,
        }
      )
    } else {
      test.check(t, outcome == Error(Wire(ConnectionError(Protocol()))))
      return ()
    }
    i += 1
  }
  test.check(t, good == list.len(frames))
}

@test
fn go_read_frame_order(t: Test) {
  // Go frame_test.go TestReadFrameOrder (ebe2feef): HEADERS and CONTINUATION
  // of one block are never interleaved with other frames. Go checks this in
  // its Framer with any fragment; here the session checks it, so the fragments
  // are pieces of one valid HPACK block, and stream 3 replaces Go's even
  // stream 2, which a server rejects as a client stream. Each row ends with
  // Go's trailing DATA on stream 1.
  let mut encoder = std@1/hpack.encoder(4096)
  let block = std@1/hpack.encode(mut encoder, request_fields())
  let size = bytes.len(block)
  let head = fn(id: u32, end: bool, part: Bytes) -> std@1/http2_wire.Frame {
    std@1/http2_wire.Frame(
      kind: 1,
      flags: if end {
        4u8
      } else {
        0u8
      },
      stream: id,
      payload: unique part
    )
  }
  let cont = fn(id: u32, end: bool, part: Bytes) -> std@1/http2_wire.Frame {
    std@1/http2_wire.Frame(
      kind: 9,
      flags: if end {
        4u8
      } else {
        0u8
      },
      stream: id,
      payload: unique part
    )
  }
  let data = std@1/http2_wire.Frame(kind: 0, flags: 1, stream: 1, payload: b"")
  let first = bytes.slice(block, 0, 1)
  let rest = bytes.slice(block, 1, size)
  // 0, 1: complete blocks.
  frame_order(t, [head(1, true, block), copy data], 2)
  frame_order(t, [head(1, true, block), head(3, true, block), copy data], 3)
  // 2, 3: HEADERS or DATA where CONTINUATION of stream 1 must follow.
  frame_order(t, [head(1, false, first), head(3, true, block), copy data], 1)
  frame_order(t, [head(1, false, first), copy data], 1)
  // 4: a finished CONTINUATION allows the next block.
  frame_order(
    t,
    [head(1, false, first), cont(1, true, rest), head(3, true, block), copy data],
    4
  )
  // 5: CONTINUATION on another stream.
  frame_order(
    t,
    [head(1, false, first), cont(3, true, rest), head(3, true, block), copy data],
    1
  )
  // 6, 7: CONTINUATION with no open block.
  frame_order(t, [cont(1, true, block), copy data], 0)
  frame_order(t, [cont(1, false, block), copy data], 0)
  // 8, 9: stream 0.
  frame_order(t, [head(0, true, block), copy data], 0)
  frame_order(t, [cont(0, true, block), copy data], 0)
  // 10: CONTINUATION after the block ended, following five good frames.
  frame_order(
    t,
    [
      head(1, false, bytes.slice(block, 0, 1)),
      cont(1, false, bytes.slice(block, 1, 2)),
      cont(1, false, bytes.slice(block, 2, 3)),
      cont(1, false, bytes.slice(block, 3, 4)),
      cont(1, true, bytes.slice(block, 4, size)),
      cont(1, false, block),
      copy data
    ],
    5
  )
}
