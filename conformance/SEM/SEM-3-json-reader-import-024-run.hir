// rule: SEM-3
// expect: run
// JSONTestSuite 1ef36fa01286573e846ac449e8683f8833c5b26a test_parsing/*.json:1.
// Differential reader twin of the existing imports; exact JsonError offsets.
fn check(t: Test, source: String) -> () {
  let expected: Result[(), json.JsonError] = match json.parse(unique source) {
    Ok(_) => Ok(()),
    Error(e) => Error(e),
  }
  let mut cursor = json.reader(string.as_bytes(source))
  let actual = match json.skip(mut cursor) {
    Ok(()) => json.finish_reader(mut cursor),
    Error(e) => Error(e),
  }
  test.equal(t, actual, expected)
}

pub fn main(t: Test) -> Result[(), ()] {
  // "n_structure_open_object_open_string.json:1"
  check(t, "{\"a")
  // "n_structure_open_object_string_with_apostrophes.json:1"
  check(t, "{'a'")
  // "n_structure_open_open.json:1"
  check(t, "[\"\\{[\"\\{[\"\\{[\"\\{")
  // "n_structure_single_star.json:1"
  check(t, "*")
  // "n_structure_trailing_#.json:1"
  check(t, "{\"a\":\"b\"}#{}")
  // "n_structure_uescaped_LF_before_string.json:1"
  check(t, "[\\u000A\"\"]")
  // "n_structure_unclosed_array.json:1"
  check(t, "[1")
  // "n_structure_unclosed_array_partial_null.json:1"
  check(t, "[ false, nul")
  Ok(())
}
