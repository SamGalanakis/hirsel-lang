// rule: SEM-3
// expect: run
// Generated by tools/generate-toml-test.py from toml-test ff49d109861c
// tests/files-toml-1.0.0, group valid-comment.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.valid(
    s,
    "valid/comment/after-literal-no-ws",
    "inf=inf#infinity\nnan=nan#not a number\ntrue=true#true\nfalse=false#false\n",
    "{\"false\":{\"type\":\"bool\",\"value\":\"false\"},\"inf\":{\"type\":\"float\",\"value\":\"9218868437227405312\"},\"nan\":{\"type\":\"float\",\"value\":\"nan\"},\"true\":{\"type\":\"bool\",\"value\":\"true\"}}"
  )
  failed += harness.valid(
    s,
    "valid/comment/at-eof",
    "# This is a full-line comment\nkey = \"value\" # This is a comment at the end of a line\n",
    "{\"key\":{\"type\":\"string\",\"value\":\"value\"}}"
  )
  failed += harness.valid(
    s,
    "valid/comment/at-eof2",
    "# This is a full-line comment\nkey = \"value\" # This is a comment at the end of a line\n",
    "{\"key\":{\"type\":\"string\",\"value\":\"value\"}}"
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
