// rule: SEM-3
// expect: run
// Published spec.txt vectors; tools/generate-markdown.py.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.check(
    s,
    "commonmark/Code spans/335",
    "``\nfoo\nbar  \nbaz\n``\n",
    "<p><code>foo bar   baz</code></p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Code spans/336",
    "``\nfoo \n``\n",
    "<p><code>foo </code></p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Code spans/337",
    "`foo   bar \nbaz`\n",
    "<p><code>foo   bar  baz</code></p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Code spans/338",
    "`foo\\`bar`\n",
    "<p><code>foo\\</code>bar`</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Code spans/339",
    "``foo`bar``\n",
    "<p><code>foo`bar</code></p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Code spans/340",
    "` foo `` bar `\n",
    "<p><code>foo `` bar</code></p>\n",
    std@1/markdown.default_options()
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
