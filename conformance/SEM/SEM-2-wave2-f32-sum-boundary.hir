// rule: SEM-2
// expect: run
pub fn main(t: Test) -> Result[(), ()] {
  let empty: Array[f32] = []
  core@1/test.check(t, core@1/f32.bits(std@1/f32.sum(empty)) == 0u32)
  core@1/test.check(t, core@1/f32.bits(std@1/f32.sum_exact(empty)) == 0u32)
  let zero: Array[f32] = [-0.0f32, -0.0f32, -0.0f32]
  core@1/test.check(t, core@1/f32.bits(std@1/f32.sum(zero)) == 2147483648u32)
  core@1/test.check(t, core@1/f32.bits(std@1/f32.sum_exact(zero)) == 2147483648u32)
  let positive: Array[f32] = [core@1/f32.from_bits(2139095040u32), 1.0f32]
  core@1/test.check(t, core@1/f32.bits(std@1/f32.sum_exact(positive)) == 2139095040u32)
  let opposite: Array[f32] = [
    core@1/f32.from_bits(2139095040u32),
    core@1/f32.from_bits(4286578688u32)
  ]
  core@1/test.check(t, core@1/f32.bits(std@1/f32.sum(opposite)) == 2143289344u32)
  core@1/test.check(t, core@1/f32.bits(std@1/f32.sum_exact(opposite)) == 2143289344u32)
  let tiny: Array[f32] = [core@1/f32.from_bits(1u32), core@1/f32.from_bits(1u32)]
  core@1/test.check(t, core@1/f32.bits(std@1/f32.sum_exact(tiny)) == 2u32)
  Ok(())
}
