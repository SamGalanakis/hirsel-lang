// rule: SEM-3
// expect: run
// Published spec.txt vectors; tools/generate-markdown.py.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.check(
    s,
    "commonmark/Backslash escapes/16/malformed",
    "foo\\\u{0}[&unterminated",
    "<p>foo\\�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Backslash escapes/17/malformed",
    "`` \\[\u{0}[&unterminated",
    "<p>`` [�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Backslash escapes/18/malformed",
    "    \u{0}[&unterminated",
    "<pre><code>�[&amp;unterminated\n</code></pre>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Backslash escapes/19/malformed",
    "~~~\n\\[\u{0}[&unterminated",
    "<pre><code>\\[�[&amp;unterminated\n</code></pre>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Backslash escapes/20/malformed",
    "<https://exampl\u{0}[&unterminated",
    "<p>&lt;https://exampl�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Backslash escapes/21/malformed",
    "<a href=\"\u{0}[&unterminated",
    "<p>&lt;a href=&quot;�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
