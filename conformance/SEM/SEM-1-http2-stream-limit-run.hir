// rule: SEM-1
// expect: test
// h2 counts.rs:187-224: a peer's concurrent-stream limit and freed slots.
// The full server 250-stream/SETTINGS-ACK acceptance lives in the driver
// fixture http2-stream-limit.hir, with an explicit Rust-local step budget.
fn request_fields() -> List[std@1/hpack.Field] {
  [
    std@1/hpack.Field(name: b":method", value: b"GET", sensitive: false),
    std@1/hpack.Field(name: b":scheme", value: b"https", sensitive: false),
    std@1/hpack.Field(name: b":path", value: b"/", sensitive: false)
  ]
}

@test
fn concurrent_stream_limit(t: Test) {
  let mut client = std@1/http2.session(Client(), 65536)
  let _ = std@1/http2.drain_frames(mut client)
  test.check(
    t,
    std@1/http2.receive(
      mut client,
      std@1/http2_wire.Frame(
        kind: 4,
        flags: 0,
        stream: 0,
        payload: b"\x00\x03\x00\x00\x00\x02"
      )
    ) == Ok(Settings())
  )
  test.check(t, std@1/http2.open(mut client, request_fields(), true) == Ok(1))
  test.check(t, std@1/http2.open(mut client, request_fields(), true) == Ok(3))
  test.check(
    t,
    std@1/http2.open(mut client, request_fields(), true) == Error(WouldBlock())
  )
  test.check(t, std@1/http2.reset(mut client, 1, Cancel()) == Ok(()))
  test.check(t, std@1/http2.open(mut client, request_fields(), true) == Ok(5))
  test.check(
    t,
    std@1/http2.receive(
      mut client,
      std@1/http2_wire.Frame(kind: 3, flags: 0, stream: 3, payload: b"\x00\x00\x00\x08")
    ) == Ok(Reset(3, 8))
  )
  test.check(t, std@1/http2.open(mut client, request_fields(), true) == Ok(7))
  test.check(
    t,
    std@1/http2.open(mut client, request_fields(), true) == Error(WouldBlock())
  )
}
