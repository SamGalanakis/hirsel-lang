// rule: SEM-1
// expect: run
// std@1 format_into appends exactly the to_string text after existing bytes.
// Integer limits are Rust coretests fmt/num.rs test_format_int_limits and
// test_format_int_zero/one (third-party/NOTICES.md); the 128-bit values cross
// each sixteen-digit chunk of the u128 path. Expected text is Python's.
fn text(take out: List[u8]) -> String {
  match string.from_bytes(bytes.from_list(take out)) {
    Ok(s) => take s,
    Error(_) => "invalid",
  }
}

pub fn main(t: Test) -> Result[(), ()] {
  let mut a1: List[u8] = [120u8, 61u8]
  std@1/u8.format_into(0u8, mut a1)
  core@1/test.check(t, text(take a1) == "x=0")
  let mut a2: List[u8] = []
  std@1/u8.format_into(0u8, mut a2)
  core@1/test.check(t, text(take a2) == std@1/u8.to_string(0u8))
