// rule: SEM-3
// expect: run
// Published spec.txt vectors; tools/generate-markdown.py.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.check(
    s,
    "commonmark/HTML blocks/183/malformed",
    "  <!-- foo -->\n\n\u{0}[&unterminated",
    "  <!-- foo -->\n<p>�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/HTML blocks/184/malformed",
    "  <div>\n\n\u{0}[&unterminated",
    "  <div>\n<p>�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/HTML blocks/185/malformed",
    "Foo\n<div>\n\u{0}[&unterminated",
    "<p>Foo</p>\n<div>\n�[&unterminated\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/HTML blocks/186/malformed",
    "<div>\nbar\n<\u{0}[&unterminated",
    "<div>\nbar\n<�[&unterminated\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/HTML blocks/187/malformed",
    "Foo\n<a href\u{0}[&unterminated",
    "<p>Foo\n&lt;a href�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
