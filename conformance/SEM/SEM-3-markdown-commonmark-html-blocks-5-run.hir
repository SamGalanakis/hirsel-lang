// rule: SEM-3
// expect: run
// Published spec.txt vectors; tools/generate-markdown.py.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.check(
    s,
    "commonmark/HTML blocks/164",
    "<i class=\"foo\">\n*bar*\n</i>\n",
    "<i class=\"foo\">\n*bar*\n</i>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/HTML blocks/165",
    "</ins>\n*bar*\n",
    "</ins>\n*bar*\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/HTML blocks/166",
    "<del>\n*foo*\n</del>\n",
    "<del>\n*foo*\n</del>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/HTML blocks/167",
    "<del>\n\n*foo*\n\n</del>\n",
    "<del>\n<p><em>foo</em></p>\n</del>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/HTML blocks/168",
    "<del>*foo*</del>\n",
    "<p><del><em>foo</em></del></p>\n",
    std@1/markdown.default_options()
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
