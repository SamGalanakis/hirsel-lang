// rule: SEM-3
// expect: run
// Go ebe2feef src/compress/flate/reader_test.go:16-24 TestNlitOutOfRange;
// src/compress/gzip/gunzip_test.go:529-579 TestTruncatedStreams original.
pub fn main(t: Test) -> Result[(), ()] {
  test.check(
    t,
    match flate.inflate(
      b"\xfc\xfe\x36\xe7\x5e\x1c\xef\xb3\x55\x58\x77\xb6\x56\xb5\x43\xf4\x6f\xf2\xd2\xe6\x3d\x99\xa0\x85\x8c\x48\xeb\xf8\xda\x83\x04\x2a\x75\xc4\xf8\x0f\x12\x11\xb9\xb4\x4b\x09\xa0\xbe\x8b\x91\x4c",
      1024
    ) {
      Error(Corrupt(_)) => true,
      _ => false,
    }
  )
  let original = b"\x1f\x8b\x08\x04\x00\x09\x6e\x88\x00\xff\x07\x00\x66\x6f\x6f\x20\x62\x61\x72\xcb\x48\xcd\xc9\xc9\xd7\x51\x28\xcf\x2f\xca\x49\x01\x04\x3a\x72\xab\xff\x0c\x00\x00\x00"
  test.equal(t, flate.gzip_decode(original, 1024), Ok(b"hello, world"))
  // Go intentionally starts at one byte. Every proper prefix is truncated.
  for n in 1u64..core@1/bytes.len(original) {
    test.equal(
      t,
      flate.gzip_decode(core@1/bytes.slice(original, 0, n), 1024),
      Error(Truncated())
    )
  }
  Ok(())
}
