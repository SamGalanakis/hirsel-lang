fn check(pattern: String, input: String, expected: Option[regex.Span]) -> Result[(), ()] {
  let re = match regex.compile(pattern, 10000) {
    Ok(re) => take re,
    Error(_) => return Error(()),
  }
  failure.check(regex.find(re, input, 100000) == Ok(expected), TextInvariant())
  Ok(())
}

pub fn main() -> Result[(), ()] {
  // src/regexp/testdata/re2-search.txt:3257
  check("^abc", "", None())?
  // src/regexp/testdata/re2-search.txt:3258
  check("^abc", "aabcdef", None())?
  // src/regexp/testdata/re2-search.txt:3260
  check("^(?:^abc)$", "", None())?
  // src/regexp/testdata/re2-search.txt:3261
  check("^(?:^abc)$", "aabcdef", None())?
  // src/regexp/testdata/re2-search.txt:3263
  check("^(?:^abc)", "", None())?
  // src/regexp/testdata/re2-search.txt:3264
  check("^(?:^abc)", "aabcdef", None())?
  // src/regexp/testdata/re2-search.txt:3266
  check("(?:^abc)$", "", None())?
  // src/regexp/testdata/re2-search.txt:3267
  check("(?:^abc)$", "aabcdef", None())?
  // src/regexp/testdata/re2-search.txt:3273
  check("^[ay]*[bx]+c", "", None())?
  // src/regexp/testdata/re2-search.txt:3274
  check("^[ay]*[bx]+c", "abcdef", Some(regex.Span(start: 0, end: 3)))?
  // src/regexp/testdata/re2-search.txt:3276
