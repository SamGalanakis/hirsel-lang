  // src/regexp/testdata/re2-search.txt:3279
  check("^(?:^[ay]*[bx]+c)", "", None())?
  // src/regexp/testdata/re2-search.txt:3280
  check("^(?:^[ay]*[bx]+c)", "abcdef", Some(regex.Span(start: 0, end: 3)))?
  // src/regexp/testdata/re2-search.txt:3282
  check("(?:^[ay]*[bx]+c)$", "", None())?
  // src/regexp/testdata/re2-search.txt:3283
  check("(?:^[ay]*[bx]+c)$", "abcdef", None())?
