// rule: SEM-1
// expect: run
pub fn main(t: Test) -> Result[(), ()] {
  core@1/test.check(t, std@1/u64.to_string(12u64) == "12")
  core@1/test.check(t, std@1/u64.parse("12") == Ok(12u64))
  let mut buffer: Inline[u8, 2] = [99u8, 99u8]
  core@1/test.check(t, std@1/u64.format(12u64, mut buffer) == Ok(2u64))
  core@1/test.check(t, buffer == [49u8, 50u8])
  Ok(())
}
