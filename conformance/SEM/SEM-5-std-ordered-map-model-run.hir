// rule: SEM-5
// expect: run
// std@1/ordered_map against a reference model: random inserts, replacements
// and removals over a small key space, checking every lookup, the tree's
// invariants and the full ascending and descending walks, while snapshots
// taken along the way keep their contents.
fn by_value(a: u64, b: u64) -> i32 uses {} {
  if a < b {
    -1
  } else if a > b {
    1
  } else {
    0
  }
}

fn walk(m: ordered_map.OrderedMap[u64, u64], direction: ordered_map.Direction) -> List[
  (u64, u64)
] {
  let start: List[(u64, u64)] = []
  ordered_map.fold_range(
    m,
    Unbounded(),
    Unbounded(),
    direction,
    take start,
    fn(take acc: List[(u64, u64)], k: u64, v: u64) -> (List[(u64, u64)], bool) {
      let mut out = take acc
      list.push(mut out, (k, v))
      (take out, true)
    }
  )
}

// The model: value per key, 0 meaning absent (stored values are never 0).
fn expected(model: List[u64], ascending: bool) -> List[(u64, u64)] {
  let mut out: List[(u64, u64)] = []
  let n = list.len(model)
  for i in 0u64..n {
    let k = if ascending {
      i
    } else {
      n - 1 - i
    }
    if model[k] != 0 {
      list.push(mut out, (k, model[k]))
    }
  }
  out
}

pub fn main(t: Test) -> Result[(), prng.SampleError] {
  let keys: u64 = 100
  let mut g = prng.seed(20261019)
  let mut m: ordered_map.OrderedMap[u64, u64] = ordered_map.empty(by_value)
  let mut model: List[u64] = []
  for _ in 0u64..keys {
    list.push(mut model, 0)
  }
  let mut snaps: List[(ordered_map.OrderedMap[u64, u64], List[u64])] = []
  for step in 1u64..=200 {
    let k = prng.below(mut g, keys)?
    if prng.below(mut g, 3)? == 0 {
      let had = model[k]
      let got = ordered_map.remove(mut m, k)
      test.check(
        t,
        got == if had == 0 {
          None()
        } else {
          Some(had)
        }
      )
      model[k] = 0
    } else {
      ordered_map.insert(mut m, k, step)
      model[k] = step
    }
    if step % 70 == 0 {
      list.push(mut snaps, (copy m, copy model))
    }
  }
  test.check(t, ordered_map.valid(m))
  for k in 0u64..keys {
    test.check(
      t,
      ordered_map.get(m, k) == if model[k] == 0 {
        None()
      } else {
        Some(model[k])
      }
    )
  }
  test.check(t, walk(m, Ascending()) == expected(model, true))
  test.check(t, walk(m, Descending()) == expected(model, false))
  for (snap, then) in snaps {
    test.check(
      t,
      ordered_map.valid(snap) && walk(snap, Ascending()) == expected(then, true)
    )
  }
  Ok(())
}
