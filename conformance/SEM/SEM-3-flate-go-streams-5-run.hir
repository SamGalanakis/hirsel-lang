// rule: SEM-3
// expect: run
// Go src/compress/flate/flate_test.go TestStreams, cases 16-18
// (golang/go ebe2feef). Unlike Go, bytes after the final block are an error.
fn check(ok: bool) -> () uses {} {
  failure.check(ok, TextInvariant())
}

pub fn main(t: Test) -> Result[(), ()] {
  // complete HCLenTree, complete HLitTree, degenerate HDistTree, use valid HDist symbol
  check(
    flate.inflate(
      b"\x00\x01\x00\xfe\xff\x00\x0d\xe0\x01\x04\x00\x00\x00\x00\x10\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00<",
      1024
    ) == Ok(b"\x00\x00\x00\x00")
  )
  // complete HCLenTree, degenerate HLitTree, degenerate HDistTree
  check(
    flate.inflate(
      b"\x05\xe0\x01\x04\x00\x00\x00\x00\x10\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x0c",
      1024
    ) == Ok(b"")
  )
  // complete HCLenTree, degenerate HLitTree, empty HDistTree
  check(
    flate.inflate(
      b"\x05\xe0\x01\x04\x00\x00\x00\x00\x10\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x04",
      1024
    ) == Ok(b"")
  )
  Ok(())
}
