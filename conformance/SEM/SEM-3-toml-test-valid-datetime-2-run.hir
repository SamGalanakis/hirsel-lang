// rule: SEM-3
// expect: run
// Generated by tools/generate-toml-test.py from toml-test ff49d109861c
// tests/files-toml-1.0.0, group valid-datetime.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.valid(
    s,
    "valid/datetime/leap-year",
    "2000-datetime       = 2000-02-29 15:15:15Z\n2000-datetime-local = 2000-02-29 15:15:15\n2000-date           = 2000-02-29\n\n2024-datetime       = 2024-02-29 15:15:15Z\n2024-datetime-local = 2024-02-29 15:15:15\n2024-date           = 2024-02-29\n",
    "{\"2000-date\":{\"type\":\"date-local\",\"value\":\"2000-02-29\"},\"2000-datetime\":{\"type\":\"datetime\",\"value\":\"2000-02-29T15:15:15Z\"},\"2000-datetime-local\":{\"type\":\"datetime-local\",\"value\":\"2000-02-29T15:15:15\"},\"2024-date\":{\"type\":\"date-local\",\"value\":\"2024-02-29\"},\"2024-datetime\":{\"type\":\"datetime\",\"value\":\"2024-02-29T15:15:15Z\"},\"2024-datetime-local\":{\"type\":\"datetime-local\",\"value\":\"2024-02-29T15:15:15\"}}"
  )
  failed += harness.valid(
    s,
    "valid/datetime/local",
    "local = 1987-07-05T17:45:00\nmilli = 1977-12-21T10:32:00.555\nspace = 1987-07-05 17:45:00\n",
    "{\"local\":{\"type\":\"datetime-local\",\"value\":\"1987-07-05T17:45:00\"},\"milli\":{\"type\":\"datetime-local\",\"value\":\"1977-12-21T10:32:00.555\"},\"space\":{\"type\":\"datetime-local\",\"value\":\"1987-07-05T17:45:00\"}}"
  )
  failed += harness.valid(
    s,
    "valid/datetime/local-date",
    "bestdayever = 1987-07-05\n",
    "{\"bestdayever\":{\"type\":\"date-local\",\"value\":\"1987-07-05\"}}"
  )
  failed += harness.valid(
    s,
    "valid/datetime/local-time",
    "besttimeever = 17:45:00\nmilliseconds = 10:32:00.555\n",
    "{\"besttimeever\":{\"type\":\"time-local\",\"value\":\"17:45:00\"},\"milliseconds\":{\"type\":\"time-local\",\"value\":\"10:32:00.555\"}}"
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
