  let mut failed: u64 = 0
  failed += harness.valid(
    s,
    "9U5K",
    "---\n# Products purchased\n- item    : Super Hoop\n  quantity: 1\n- item    : Basketball\n  quantity: 4\n- item    : Big Shoes\n  quantity: 1\n",
    [
      "[{\"item\":\"Super Hoop\",\"quantity\":1},{\"item\":\"Basketball\",\"quantity\":4},{\"item\":\"Big Shoes\",\"quantity\":1}]"
    ]
  )
  failed += harness.values(
    s,
    "9WXW",
    "# Private\n!foo \"bar\"\n...\n# Global\n%TAG ! tag:example.com,2000:app/\n---\n!foo \"bar\"\n",
    [
      Tagged(tag: "!foo", value: box Text("bar")),
      Tagged(tag: "tag:example.com,2000:app/foo", value: box Text("bar"))
    ]
  )
  failed += harness.round_trip(s, "9WXW", Tagged(tag: "!foo", value: box Text("bar")))
  failed += harness.round_trip(
    s,
    "9WXW",
    Tagged(tag: "tag:example.com,2000:app/foo", value: box Text("bar"))
  )
  failure.check(failed == 0, TextInvariant())
