// rule: SEM-3
// expect: run
// Published spec.txt vectors; tools/generate-markdown.py.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.check(
    s,
    "commonmark/Lists/309/malformed",
    "-   foo\n\n    notcode\n\n-  \u{0}[&unterminated",
    "<ul>\n<li>\n<p>foo</p>\n<p>notcode</p>\n</li>\n<li>\n<p>�[&amp;unterminated</p>\n</li>\n</ul>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Lists/310/malformed",
    "- a\n - b\n  - c\n   \u{0}[&unterminated",
    "<ul>\n<li>a</li>\n<li>b</li>\n<li>c\n�[&amp;unterminated</li>\n</ul>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Lists/311/malformed",
    "1. a\n\n  2. \u{0}[&unterminated",
    "<ol>\n<li>\n<p>a</p>\n</li>\n<li>\n<p>�[&amp;unterminated</p>\n</li>\n</ol>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Lists/312/malformed",
    "- a\n - b\n  - c\n\u{0}[&unterminated",
    "<ul>\n<li>a</li>\n<li>b</li>\n<li>c\n�[&amp;unterminated</li>\n</ul>\n",
    std@1/markdown.default_options()
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
