// rule: SEM-3
// expect: run
// steps: 20000000
// one program runs the whole vector suite, which outgrows the default budget
// Zig std/crypto/sha3.zig SHA3-256 vectors (FIPS 202 examples), one-shot and streamed.
fn check(input: String, expected: String) -> () {
  failure.check(
    std@1/sha3_256.digest_hex(string.as_bytes(input)) == expected,
    TextInvariant()
  )
}

fn check_1(input: String, expected: String) -> () {
  failure.check(
    std@1/sha3_224.digest_hex(string.as_bytes(input)) == expected,
    TextInvariant()
  )
}

// Formerly SEM-3-sha3-224-golden-run.
fn part_1() -> Result[(), ()] {
  check_1("", "6b4e03423667dbb73b6e15454f0eb1abd4597f9a1b078e3f5b5a6bc7")
  check_1("abc", "e642824c3f8cf24ad09234ee7d3c766fc9a3a5168d0c94ad73b46fdf")
  check_1(
    "abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu",
    "543e6868e1666c1a643630df77367ae5a62a85070a51c14cbf665cbc"
  )
  let mut state = std@1/sha3_224.new()
  std@1/sha3_224.update(mut state, b"a")
  std@1/sha3_224.update(mut state, b"")
  std@1/sha3_224.update(mut state, b"b")
  std@1/sha3_224.update(mut state, b"c")
  failure.check(
    std@1/hex.encode(std@1/bytes.from_inline(std@1/sha3_224.finish(take state))) == "e642824c3f8cf24ad09234ee7d3c766fc9a3a5168d0c94ad73b46fdf",
    TextInvariant()
  )
  Ok(())
}

// Formerly SEM-3-sha3-256-split-run.
fn part_2() -> Result[(), ()] {
  let message = b"\x97\xd1\x2d\x1a\x16\x2d\x36\x4d\x20\x62\x19\x0b\x14\x93\xbb\xf8\x5b\xea\x04\xc2\x61\x8e\xd6\x08\x81\xa1\x1d\x73\x27\x48\xbf\xa4\xba\xb1\x9a\x48\x9c\xf9\x9b\xff\x34\x48\xa9\x75\xea\xc8\xa3\x48\x24\x9d\x75\x27\x48\xec\x03\xb0\xbb\xdf\x33\x90\xe3\x93\xed\x68\x24\x39\x12\xdf\xea\xee\x8c\x9f\x96\xde\x42\x46\x8c\x2b\x17\x83\x36\xfb\xf4\xf7\xff\x79\xb9\x45\x41\xc9\x56\x1a\x6b\x0c\xa4\x1a\xdd\x6b\x95\xe8\x03\x0f\x09\x29\x40\x1b\xea\x87\xfa\xb9\x18\xa9\x95\x07\x7c\x2f\x7c\x33\xfb\xc5\x11\x5e\x81\x0e\xbc\xae\xec\xb3\xe1\x4a\x26\x56\xe8\x5b\x11\x9d\x37\x06\x9b\x34\x31\x6e\xa3\xba\x41\xbc\x11\xd8\xc5\x15\xc9\x30\x2c\x9b\xb6\x71\xd8\x7c\xbc\x38\x2f\xd5\xbd\x30\x96\xd4\xa3\x00\x77\x9d\x55\x4a\x33\x53\xb6\xb3\x35\x1b\xae\xe5\xdc\x22\x23\x85\x95\x88\xf9\x3b\xbf\x74\x13\xaa\xcb\x0a\x60\x79\x13\x79\xc0\x4a\x02\xdb\x1c\xc9\xff\x60\x57\x9a\x70\x28\x58\x60\xbc\x57\x07\xc7\x47\x1a\x45\x71\x76\x94\xfb\x05\xad\xec\x12\x29\x5a\x44\x6a\x81\xd9\xc6\xf0\xb6\x9b\x97\x83\x69\xfb\xdc\x0d\x4a\x67\xbc\x72\xf5\x43\x5e\x9b\x13\xf2\xe4\x6d\x49\xdb\x76\xcb\x42\x6a\x3c\x9f\xa1\xfe\x5e\xca\x0a\xfc\xfa\x39\x27\xd1\x3c\xcb\x9a\xde\x4c\x6b\x09\x8b\x49\xfd\x1e\x3d\x5e\x67\x7c\x57\xad\x90\xcc\x46\x5f\x5c\xae\x6a\x9c\xb2\xcd\x2c\x89\x78\xcf\xf1\x49\x96\x55\x1e\x04\xef\x0e\x1c\xde\x6c\x96\x51\x00\xee\x9a\x1f\x8d\x61\xbc\xeb\xb1\xa6\xa5\x21\x8b\xa7\xf8\x25\x41\x48\x62\x5b\x01\x6c\x7c\x2a\xe8\xff\xf9\xf9\x1f\xe2\x79\x2e\xd1\xff\xa3\x2e\x1c\x3a\x1a\x5d\x2b\x7b\x87\x25\x22\xa4\x90\xea\x26\x9d\xdd\x13\x60\x4c\x10\x03\xf6\x99\xd3\x21\x0c\x69\xc6\xd8\xc8\x9e\x94\x89\x51\x21\xe3\x9a\xcd\xda\x54\x72\x64\xae\x94\x79\x36\x81\x44\x14\x6d\x3a\x0e\xa6\x30\xbf\x95\x99\xa6\xf5\x7f\x4f\xef\xc6\x71\x2f\x36\x13\x14\xa2\x9d\xc2\x0c\x0d\x4e\xc0\x02\xd3\x6f\xee\x98\x5e\x24\x31\x74\x11\x96\x6e\x43\x57\xe8\x8e\xa0\x8d\x3d\x79\x38\x20\xc2\x0f\xb4\x75\x99\x3b\xb1\xf0\xe8\xe1\xda\xf9\xd4\xe6\xd6\xf4\x8a\x32\x4a\x4a\x25\xa8\xd9\x60\xd6\x33\x31\x97\xb9\xb6\xed\x5f\xfc\x15\xbd\x13\xc0\x3a\x3f\x1f\x2d\x09\x1d\xeb\x69\x6a\x