  let expected = "5780048dfa381a1d01c747906e4a08711dd34fd712ecd7c6801dd2b38fd81a89"
  failure.check(std@1/sha3_256.digest_hex(message) == expected, TextInvariant())
  let mut state = std@1/sha3_256.new()
  std@1/sha3_256.update(mut state, bytes.slice(message, 0, 64))
  std@1/sha3_256.update(mut state, bytes.slice(message, 64, 613))
  failure.check(
    std@1/hex.encode(std@1/bytes.from_inline(std@1/sha3_256.finish(take state))) == expected,
    TextInvariant()
  )
  Ok(())
}

fn check_3(input: String, expected: String) -> () {
  failure.check(
    std@1/sha3_384.digest_hex(string.as_bytes(input)) == expected,
    TextInvariant()
  )
}

// Formerly SEM-3-sha3-384-golden-run.
fn part_3() -> Result[(), ()] {
  check_3(
    "",
    "0c63a75b845e4f7d01107d852e4c2485c51a50aaaa94fc61995e71bbee983a2ac3713831264adb47fb6bd1e058d5f004"
  )
  check_3(
    "abc",
    "ec01498288516fc926459f58e2c6ad8df9b473cb0fc08c2596da7cf0e49be4b298d88cea927ac7f539f1edf228376d25"
  )
  check_3(
    "abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu",
    "79407d3b5916b59c3e30b09822974791c313fb9ecc849e406f23592d04f625dc8c709b98b43b3852b337216179aa7fc7"
  )
  let mut state = std@1/sha3_384.new()
  std@1/sha3_384.update(mut state, b"a")
  std@1/sha3_384.update(mut state, b"")
  std@1/sha3_384.update(mut state, b"b")
  std@1/sha3_384.update(mut state, b"c")
  failure.check(
    std@1/hex.encode(std@1/bytes.from_inline(std@1/sha3_384.finish(take state))) == "ec01498288516fc926459f58e2c6ad8df9b473cb0fc08c2596da7cf0e49be4b298d88cea927ac7f539f1edf228376d25",
    TextInvariant()
  )
  Ok(())
}

fn check_4(input: String, expected: String) -> () {
  failure.check(
    std@1/sha3_512.digest_hex(string.as_bytes(input)) == expected,
    TextInvariant()
  )
}

// Formerly SEM-3-sha3-512-golden-run.
fn part_4() -> Result[(), ()] {
  check_4(
    "",
    "a69f73cca23a9ac5c8b567dc185a756e97c982164fe25859e0d1dcc1475c80a615b2123af1f5f94c11e3e9402c3ac558f500199d95b6d3e301758586281dcd26"
  )
  check_4(
    "abc",
    "b751850b1a57168a5693cd924b6b096e08f621827444f70d884f5d0240d2712e10e116e9192af3c91a7ec57647e3934057340b4cf408d5a56592f8274eec53f0"
  )
  check_4(
    "abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu",
    "afebb2ef542e6579c50cad06d2e578f9f8dd6881d7dc824d26360feebf18a4fa73e3261122948efcfd492e74e82e2189ed0fb440d187f382270cb455f21dd185"
  )
  let mut state = std@1/sha3_512.new()
  std@1/sha3_512.update(mut state, b"a")
  std@1/sha3_512.update(mut state, b"")
  std@1/sha3_512.update(mut state, b"b")
  std@1/sha3_512.update(mut state, b"c")
  failure.check(
    std@1/hex.encode(std@1/bytes.from_inline(std@1/sha3_512.finish(take state))) == "b751850b1a57168a5693cd924b6b096e08f621827444f70d884f5d0240d2712e10e116e9192af3c91a7ec57647e3934057340b4cf408d5a56592f8274eec53f0",
    TextInvariant()
  )
  Ok(())
}

pub fn main() -> Result[(), ()] {
  check("", "a7ffc6f8bf1ed76651c14756a061d662f580ff4de43b49fa82d80a4b80f8434a")
  check("abc", "3a985da74fe225b2045c172d6bd390bd855f086e3e9d525b46bfe24511431532")
  check(
    "abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu",
    "916f6061fe879741ca6469b43971dfdb28b1a32dc36cb3254e812be27aad1d18"
  )
  let mut state = std@1/sha3_256.new()
  std@1/sha3_256.update(mut state, b"a")
  std@1/sha3_256.update(mut state, b"")
  std@1/sha3_256.update(mut state, b"b")
  std@1/sha3_256.update(mut state, b"c")
  failure.check(
    std@1/hex.encode(std@1/bytes.from_inline(std@1/sha3_256.finish(take state))) == "3a985da74fe225b2045c172d6bd390bd855f086e3e9d525b46bfe24511431532",
    TextInvariant()
  )
  part_1()?
  part_2()?
  part_3()?
  part_4()?
  Ok(())
}
