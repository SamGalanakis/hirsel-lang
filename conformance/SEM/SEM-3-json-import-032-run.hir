  )
  failed += harness.parses(s, "y_number_real_neg_exp.json:1", "[1e-2]", 0)
  failed += harness.parses(s, "y_number_real_pos_exponent.json:1", "[1e+2]", 0)
  failed += harness.parses(s, "y_number_simple_int.json:1", "[123]", 0)
  failed += harness.parses(s, "y_number_simple_real.json:1", "[123.456789]", 0)
  failed += harness.parses(
    s,
    "y_object.json:1",
    "{\"asd\":\"sdf\", \"dfg\":\"fgh\"}",
    0
  )
  failed += harness.parses(s, "y_object_basic.json:1", "{\"asd\":\"sdf\"}", 0)
  failed += harness.parses(
    s,
    "y_object_duplicated_key.json:1",
    "{\"a\":\"b\",\"a\":\"c\"}",
    2
  )
  failure.check(failed == 0, TextInvariant())
