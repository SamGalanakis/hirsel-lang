// rule: SEM-3
// expect: run
// Published spec.txt vectors; tools/generate-markdown.py.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.check(
    s,
    "commonmark/Lists/313/malformed",
    "1. a\n\n  2. \u{0}[&unterminated",
    "<ol>\n<li>\n<p>a</p>\n</li>\n<li>\n<p>�[&amp;unterminated</p>\n</li>\n</ol>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Lists/314/malformed",
    "- a\n- \u{0}[&unterminated",
    "<ul>\n<li>a</li>\n<li>�[&amp;unterminated</li>\n</ul>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Lists/315/malformed",
    "* a\n*\u{0}[&unterminated",
    "<ul>\n<li>a\n*�[&amp;unterminated</li>\n</ul>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Lists/316/malformed",
    "- a\n- b\n\u{0}[&unterminated",
    "<ul>\n<li>a</li>\n<li>b\n�[&amp;unterminated</li>\n</ul>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Lists/317/malformed",
    "- a\n- b\n\n  [r\u{0}[&unterminated",
    "<ul>\n<li>\n<p>a</p>\n</li>\n<li>\n<p>b</p>\n<p>[r�[&amp;unterminated</p>\n</li>\n</ul>\n",
    std@1/markdown.default_options()
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
