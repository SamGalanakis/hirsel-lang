// rule: SEM-3
// expect: run
// Published spec.txt vectors; tools/generate-markdown.py.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.check(
    s,
    "commonmark/Images/588/malformed",
    "![foo]\n\n[foo]:\u{0}[&unterminated",
    "<p><img src=\"%EF%BF%BD%5B&amp;unterminated\" alt=\"foo\" /></p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Images/589/malformed",
    "![*foo* bar]\n\n[*foo*\u{0}[&unterminated",
    "<p>![<em>foo</em> bar]</p>\n<p>[<em>foo</em>�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Images/590/malformed",
    "![[foo]]\n\n[[foo]\u{0}[&unterminated",
    "<p>![[foo]]</p>\n<p>[[foo]�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Images/591/malformed",
    "![Foo]\n\n[foo]:\u{0}[&unterminated",
    "<p><img src=\"%EF%BF%BD%5B&amp;unterminated\" alt=\"Foo\" /></p>\n",
    std@1/markdown.default_options()
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
