// rule: SEM-5
// expect: run
// CPython 938144ef Lib/test/test_heapq.py:134-185, adapted to seeded integers.
// Expected returns/drains are pinned Python sorted-multiset results (seed 0x51434+k).
@noalloc
fn by(a: i32, b: i32) -> i32 uses {} {
  if a < b {
    -2147483648
  } else if a > b {
    2147483647
  } else {
    0
  }
}

@noalloc
fn backward(a: i32, b: i32) -> i32 uses {} {
  by(b, a)
}

fn check(initial: List[i32], rows: List[(i32, i32)], expected: List[i32], reverse: bool) -> () {
  let compare = if reverse {
    backward
  } else {
    by
  }
  let mut h: unique priority_queue.Heap[i32] = priority_queue.from_list(
    take compare,
    unique initial
  )
  let count = priority_queue.len(h)
  for (value, expected_return) in rows {
    failure.check(priority_queue.push_pop(mut h, value) == expected_return, Bounds())
    failure.check(priority_queue.len(h) == count, Bounds())
  }
  for x in expected {
    failure.check(priority_queue.pop(mut h) == Some(x), Bounds())
  }
  failure.check(priority_queue.len(h) == 0, Bounds())
}

