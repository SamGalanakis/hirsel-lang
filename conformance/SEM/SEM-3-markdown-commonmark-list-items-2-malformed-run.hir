// rule: SEM-3
// expect: run
// Published spec.txt vectors; tools/generate-markdown.py.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.check(
    s,
    "commonmark/List items/256/malformed",
    "- one\n\u{0}[&unterminated",
    "<ul>\n<li>one\n�[&amp;unterminated</li>\n</ul>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/List items/257/malformed",
    " -    one\n\u{0}[&unterminated",
    "<ul>\n<li>one\n�[&amp;unterminated</li>\n</ul>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/List items/258/malformed",
    " -    one\n\u{0}[&unterminated",
    "<ul>\n<li>one\n�[&amp;unterminated</li>\n</ul>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/List items/259/malformed",
    "   > > 1.  one\u{0}[&unterminated",
    "<blockquote>\n<blockquote>\n<ol>\n<li>one�[&amp;unterminated</li>\n</ol>\n</blockquote>\n</blockquote>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/List items/260/malformed",
    ">>- one\n>>\n\u{0}[&unterminated",
    "<blockquote>\n<blockquote>\n<ul>\n<li>one</li>\n</ul>\n</blockquote>\n</blockquote>\n<p>�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
