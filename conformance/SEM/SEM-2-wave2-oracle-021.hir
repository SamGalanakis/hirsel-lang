// rule: SEM-2
// expect: run
// Rust std LowerExp supplies independent shortest digits and decimal parsing.
pub fn main(t: Test) -> Result[(), ()] {
  core@1/test.check(
    t,
    std@1/f32.to_string(core@1/f32.from_bits(2139095039u32)) == "3.4028235e38"
  )
  match std@1/f32.parse("3.4028235e38") {
    Ok(value) => core@1/test.check(t, core@1/f32.bits(value) == 2139095039u32),
    Error(_) => core@1/test.check(t, false),
  }
  Ok(())
}
