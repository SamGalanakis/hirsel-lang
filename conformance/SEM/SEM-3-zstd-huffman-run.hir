// rule: SEM-3
// expect: run
// RFC Huffman weights example, encoded as one and four streams with treeless reuse.
pub fn main(t: Test) -> Result[(), ()] {
  test.equal(
    t,
    zstd.decode(
      b"(\xb5/\xfd\x00\x00e\x00\x00\xc2\x00\x02\x84C \x10-\x10\x03\xd2\x00",
      65536,
      1024
    ),
    Ok(b"\x00\x01\x02\x04\x05\x00\x05\x04\x02\x01\x00\x01")
  )
  test.equal(
    t,
    zstd.decode(
      b"(\xb5/\xfd\x00\x00e\x00\x00\xc2\x00\x02\x84C \x10-\x10\x03\xd2",
      65536,
      1024
    ),
    Error(Truncated())
  )
  test.equal(
    t,
    zstd.decode(
      b"(\xb5/\xfd\x00\x00d\x00\x00\xc2\x00\x02\x84C \x10-\x10\x03\xd2\x00E\x00\x00\xc3\x00\x01-\x10\x03\xd2\x00",
      65536,
      1024
    ),
    Ok(
      b"\x00\x01\x02\x04\x05\x00\x05\x04\x02\x01\x00\x01\x00\x01\x02\x04\x05\x00\x05\x04\x02\x01\x00\x01"
    )
  )
  test.equal(
    t,
    zstd.decode(
      b"(\xb5/\xfd\x00\x00E\x00\x00\xc3\x00\x01-\x10\x03\xd2\x00",
      65536,
      1024
    ),
    Error(Corrupt())
  )
  test.equal(
    t,
    zstd.decode(
      b"(\xb5/\xfd\x00\x00\xa5\x00\x00\xc6\x00\x04\x84C \x10\x01\x00\x02\x00\x02\x00i\x03\x02\x81\x08-\x00",
      65536,
      1024
    ),
    Ok(b"\x00\x01\x02\x04\x05\x00\x05\x04\x02\x01\x00\x01")
  )
  test.equal(
    t,
    zstd.decode(
      b"(\xb5/\xfd\x00\x00\xa5\x00\x00\xc6\x00\x04\x84C \x10\x01\x00\x02\x00\x02\x00i\x03\x02\x81\x08-",
      65536,
      1024
    ),
    Error(Truncated())
  )
  test.equal(
    t,
    zstd.decode(
      b"(\xb5/\xfd\x00\x00\xa4\x00\x00\xc6\x00\x04\x84C \x10\x01\x00\x02\x00\x02\x00i\x03\x02\x81\x08-\x00\x85\x00\x00\xc7\x00\x03\x01\x00\x02\x00\x02\x00i\x03\x02\x81\x08-\x00",
      65536,
      1024
    ),
    Ok(
      b"\x00\x01\x02\x04\x05\x00\x05\x04\x02\x01\x00\x01\x00\x01\x02\x04\x05\x00\x05\x04\x02\x01\x00\x01"
    )
  )
  test.equal(
    t,
    zstd.decode(
      b"(\xb5/\xfd\x00\x00\x85\x00\x00\xc7\x00\x03\x01\x00\x02\x00\x02\x00i\x03\x02\x81\x08-\x00",
      65536,
      1024
    ),
    Error(Corrupt())
  )
  test.equal(
    t,
    zstd.decode(
      b"(\xb5/\xfd\x00\x00e\x00\x00\xc2\x00\x02\x84\x00\x00\x00-\x10\x03\xd2\x00",
      65536,
      1024
    ),
    Error(Corrupt())
  )
  test.equal(
    t,
    zstd.decode(
      b"(\xb5/\xfd\x00\x00e\x00\x00\xc2\x00\x02\x84D \x10-\x10\x03\xd2\x00",
      65536,
      1024
    ),
    Error(Corrupt())
  )
  test.equal(
    t,
    zstd.decode(
      b"(\xb5/\xfd\x00\x00e\x00\x00\xc2\x00\x02\x84\xf3 \x10-\x10\x03\xd2\x00",
      65536,
      1024
    ),
    Error(Corrupt())
  )
  test.equal(
    t,
    zstd.decode(
      b"(\xb5/\xfd\x00\x00e\x00\x00\xc2\x00\x02\x84C \x10-\x10\x03\x00\x00",
      65536,
      1024
    ),
    Error(Corrupt())
  )
  // Size format 2, using the same small RFC literal stream.
  test.equal(
    t,
    zstd.decode(
      b"(\xb5/\xfd\x00\x00\xad\x00\x00\xca\x00@\x00\x84C \x10\x01\x00\x02\x00\x02\x00i\x03\x02\x81\x08-\x00",
      12,
      1024
    ),
    Ok(b"\x00\x01\x02\x04\x05\x00\x05\x04\x02\x01\x00\x01")
  )
  // Size format 3, using the same small RFC literal stream.
  test.equal(
    t,
    zstd.decode(
      b"(\xb5/\xfd\x00\x00\xb5\x00\x00\xce\x00\x00\x04\x00\x84C \x10\x01\x00\x02\x00\x02\x00i\x03\x02\x81\x08-\x00",
      12,
      1024
    ),
    Ok(b"\x00\x01\x02\x04\x05\x00\x05\x04\x02\x01\x00\x01")
  )
  Ok(())
}
