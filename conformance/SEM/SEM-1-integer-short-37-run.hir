// rule: SEM-1
// expect: run
// Go internal/strconv/atoi_test.go width/grammar boundaries, with Hirsel's
// Invalid-over-OutOfRange policy and explicit unsigned 19-digit admission.
pub fn main(t: Test) -> Result[(), ()] {
  failure.check(
    u64.parse("9999999999999999999") == Ok(9999999999999999999u64),
    Bounds()
  )
  failure.check(
    i64.parse("9223372036854775807") == Ok(9223372036854775807i64),
    Bounds()
  )
  failure.check(i64.parse("9223372036854775808") == Error(OutOfRange), Bounds())
  failure.check(
    i64.parse("-9223372036854775808") == Ok(-9223372036854775808i64),
    Bounds()
  )
  failure.check(i64.parse("-9223372036854775809") == Error(OutOfRange), Bounds())
  failure.check(
    u64.parse("18446744073709551615") == Ok(18446744073709551615u64),
    Bounds()
  )
  failure.check(u64.parse("18446744073709551616") == Error(OutOfRange), Bounds())
  failure.check(u8.parse("999999999999999999x") == Error(Invalid), Bounds())
  failure.check(u8.parse("9999999999999999999x") == Error(Invalid), Bounds())
  failure.check(u64.parse("0000000000000000000000000000001") == Ok(1u64), Bounds())
  failure.check(u8.parse_radix("101", 2) == Ok(5u8), Bounds())
  failure.check(u8.parse_radix("2", 2) == Error(Invalid), Bounds())
  failure.check(u8.parse_radix("77", 8) == Ok(63u8), Bounds())
  failure.check(u8.parse_radix("8", 8) == Error(Invalid), Bounds())
  failure.check(u8.parse("+1") == Error(Invalid), Bounds())
  failure.check(u8.parse(" 1") == Error(Invalid), Bounds())
  failure.check(i8.parse("-0") == Ok(0i8), Bounds())
  Ok(())
}
