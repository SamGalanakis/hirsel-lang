// rule: SEM-3
// expect: run
// Published spec.txt vectors; tools/generate-markdown.py.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.check(
    s,
    "commonmark/Fenced code blocks/125",
    "~~~~\naaa\n~~~\n~~~~\n",
    "<pre><code>aaa\n~~~\n</code></pre>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Fenced code blocks/126",
    "```\n",
    "<pre><code></code></pre>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Fenced code blocks/127",
    "`````\n\n```\naaa\n",
    "<pre><code>\n```\naaa\n</code></pre>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Fenced code blocks/128",
    "> ```\n> aaa\n\nbbb\n",
    "<blockquote>\n<pre><code>aaa\n</code></pre>\n</blockquote>\n<p>bbb</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Fenced code blocks/129",
    "```\n\n  \n```\n",
    "<pre><code>\n  \n</code></pre>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Fenced code blocks/130",
    "```\n```\n",
    "<pre><code></code></pre>\n",
    std@1/markdown.default_options()
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
