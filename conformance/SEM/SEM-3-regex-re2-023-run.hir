fn check(pattern: String, input: String, expected: Option[regex.Span]) -> Result[(), ()] {
  let re = match regex.compile(pattern, 10000) {
    Ok(re) => take re,
    Error(_) => return Error(()),
  }
  failure.check(regex.find(re, input, 100000) == Ok(expected), TextInvariant())
  Ok(())
}

pub fn main() -> Result[(), ()] {
  // src/regexp/testdata/re2-search.txt:883
  check("(?:\\bfoo\\b)$", "nofoo foo that", None())?
  // src/regexp/testdata/re2-search.txt:889
  check("a\\b", "", None())?
  // src/regexp/testdata/re2-search.txt:890
  check("a\\b", "faoa x", Some(regex.Span(start: 3, end: 4)))?
  // src/regexp/testdata/re2-search.txt:892
