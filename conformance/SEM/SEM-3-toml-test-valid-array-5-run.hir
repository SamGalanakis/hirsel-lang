// rule: SEM-3
// expect: run
// Generated by tools/generate-toml-test.py from toml-test ff49d109861c
// tests/files-toml-1.0.0, group valid-array.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.valid(
    s,
    "valid/array/mixed-string-table",
    "contributors = [\n  \"Foo Bar <foo@example.com>\",\n  { name = \"Baz Qux\", email = \"bazqux@example.com\", url = \"https://example.com/bazqux\" }\n]\n\n# Start with a table as the first element. This tests a case that some libraries\n# might have where they will check if the first entry is a table/map/hash/assoc\n# array and then encode it as a table array. This was a reasonable thing to do\n# before TOML 1.0 since arrays could only contain one type, but now it's no\n# longer.\nmixed = [{k=\"a\"}, \"b\", 1]\n",
    "{\"contributors\":[{\"type\":\"string\",\"value\":\"Foo Bar <foo@example.com>\"},{\"email\":{\"type\":\"string\",\"value\":\"bazqux@example.com\"},\"name\":{\"type\":\"string\",\"value\":\"Baz Qux\"},\"url\":{\"type\":\"string\",\"value\":\"https://example.com/bazqux\"}}],\"mixed\":[{\"k\":{\"type\":\"string\",\"value\":\"a\"}},{\"type\":\"string\",\"value\":\"b\"},{\"type\":\"integer\",\"value\":\"1\"}]}"
  )
  failed += harness.valid(
    s,
    "valid/array/nested",
    "nest = [[\"a\"], [\"b\"]]\n",
    "{\"nest\":[[{\"type\":\"string\",\"value\":\"a\"}],[{\"type\":\"string\",\"value\":\"b\"}]]}"
  )
  failed += harness.valid(
    s,
    "valid/array/nested-double",
    "nest = [\n\t[\n\t\t[\"a\"],\n\t\t[1, 2, [3]]\n\t]\n]\n",
    "{\"nest\":[[[{\"type\":\"string\",\"value\":\"a\"}],[{\"type\":\"integer\",\"value\":\"1\"},{\"type\":\"integer\",\"value\":\"2\"},[{\"type\":\"integer\",\"value\":\"3\"}]]]]}"
  )
  failed += harness.valid(
    s,
    "valid/array/nested-inline-table",
    "a = [ { b = {} } ]\n",
    "{\"a\":[{\"b\":{}}]}"
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
