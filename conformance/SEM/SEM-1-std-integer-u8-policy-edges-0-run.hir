// rule: SEM-1
// expect: run
// Rust integer-policy edge vectors: every u8 left operand against eight boundary right operands.
pub fn main(t: Test) -> Result[(), ()] {
  let boundaries: Array[u8] = [0u8, 1u8, 2u8, 3u8, 127u8, 128u8, 254u8, 255u8]
  for wide in 0i16..64i16 {
    let a: u8 = int.narrow(wide)
    for b in boundaries {
      let left: i32 = int.widen(a)
      let right: i32 = int.widen(b)
      let difference = left - right
      let product = left * right
      let expected_sub: Option[u8] = int.try_narrow(difference)
      let expected_mul: Option[u8] = int.try_narrow(product)
      failure.check(u8.checked_sub(a, b) == expected_sub, Bounds())
      failure.check(u8.checked_mul(a, b) == expected_mul, Bounds())
      let sub_clamped = if difference < 0i32 {
        0i32
      } else if difference > 255i32 {
        255i32
      } else {
        difference
      }
      let mul_clamped = if product < 0i32 {
        0i32
      } else if product > 255i32 {
        255i32
      } else {
        product
      }
      let saturated_sub: u8 = int.narrow(sub_clamped)
      let saturated_mul: u8 = int.narrow(mul_clamped)
      failure.check(u8.saturating_sub(a, b) == saturated_sub, Bounds())
      failure.check(u8.saturating_mul(a, b) == saturated_mul, Bounds())
      let wrapped_sub: u8 = int.truncate(difference)
      let wrapped_mul: u8 = int.truncate(product)
      failure.check(u8.wrapping_sub(a, b) == wrapped_sub, Bounds())
      failure.check(u8.wrapping_mul(a, b) == wrapped_mul, Bounds())
    }
  }
  Ok(())
}
