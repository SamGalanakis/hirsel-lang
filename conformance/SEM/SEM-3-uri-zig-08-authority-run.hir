    failure.check(parsed_uri.host == Some(Encoded("hostname")), TextInvariant())
    failure.check(parsed_uri.user == Some(Encoded("user")), TextInvariant())
    failure.check(parsed_uri.password == Some(Encoded("p@ssword")), TextInvariant())
    failure.check(parsed_uri.port == Some(1234), TextInvariant())
  }
  {
    let Ok(parsed_uri) = std@1/uri.parse("scheme://user:p@@@word@hostname:1234") else {
      return Error(())
    }
    failure.check(parsed_uri.host == Some(Encoded("hostname")), TextInvariant())
    failure.check(parsed_uri.user == Some(Encoded("user")), TextInvariant())
    failure.check(parsed_uri.password == Some(Encoded("p@@@word")), TextInvariant())
    failure.check(parsed_uri.port == Some(1234), TextInvariant())
  }
  {
    let Ok(parsed_uri) = std@1/uri.parse("scheme://user@name@hostname") else {
      return Error(())
