// rule: SEM-3
// expect: run
// Zig Uri.zig:604-645, authority (bff490a2, MIT).
pub fn main() -> Result[(), ()] {
  {
    let Ok(parsed_uri) = std@1/uri.parse("scheme://hostname") else {
      return Error(())
    }
    failure.check(parsed_uri.host == Some(Encoded("hostname")), TextInvariant())
    failure.check(parsed_uri.user == None(), TextInvariant())
    failure.check(parsed_uri.password == None(), TextInvariant())
    failure.check(parsed_uri.port == None(), TextInvariant())
  }
  {
    let Ok(parsed_uri) = std@1/uri.parse("scheme://userinfo@hostname") else {
      return Error(())
