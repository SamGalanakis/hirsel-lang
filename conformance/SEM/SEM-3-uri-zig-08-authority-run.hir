    failure.check(parsed_uri.user == Some(Encoded("user")), TextInvariant())
    failure.check(parsed_uri.password == Some(Encoded("password")), TextInvariant())
    failure.check(parsed_uri.port == None(), TextInvariant())
  }
  {
    let Ok(parsed_uri) = std@1/uri.parse("scheme://hostname:0") else {
      return Error(())
    }
    failure.check(parsed_uri.host == Some(Encoded("hostname")), TextInvariant())
    failure.check(parsed_uri.user == None(), TextInvariant())
    failure.check(parsed_uri.password == None(), TextInvariant())
    failure.check(parsed_uri.port == Some(0), TextInvariant())
  }
  {
    let Ok(parsed_uri) = std@1/uri.parse("scheme://hostname:1234") else {
      return Error(())
    }
    failure.check(parsed_uri.host == Some(Encoded("hostname")), TextInvariant())
    failure.check(parsed_uri.user == None(), TextInvariant())
    failure.check(parsed_uri.password == None(), TextInvariant())
    failure.check(parsed_uri.port == Some(1234), TextInvariant())
  }
  {
    let Ok(parsed_uri) = std@1/uri.parse("scheme://userinfo@hostname:1234") else {
      return Error(())
    }
    failure.check(parsed_uri.host == Some(Encoded("hostname")), TextInvariant())
    failure.check(parsed_uri.user == Some(Encoded("userinfo")), TextInvariant())
    failure.check(parsed_uri.password == None(), TextInvariant())
    failure.check(parsed_uri.port == Some(1234), TextInvariant())
  }
  {
    let Ok(parsed_uri) = std@1/uri.parse("scheme://user:password@hostname:1234") else {
      return Error(())
    }
    failure.check(parsed_uri.host == Some(Encoded("hostname")), TextInvariant())
    failure.check(parsed_uri.user == Some(Encoded("user")), TextInvariant())
    failure.check(parsed_uri.password == Some(Encoded("password")), TextInvariant())
    failure.check(parsed_uri.port == Some(1234), TextInvariant())
  }
  {
    let Ok(parsed_uri) = std@1/uri.parse("scheme://user:p@ssword@hostname:1234") else {
      return Error(())
