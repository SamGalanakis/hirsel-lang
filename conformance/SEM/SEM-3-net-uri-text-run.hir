// rule: SEM-3
// expect: run
pub fn main(rt: Io, args: Args) -> Result[(), uri.UriError] {
  let parsed = uri.parse("https://example.com/a/b?old")?
  failure.check(
    parsed.scheme == "https" && parsed.host == Some(Encoded("example.com")),
    TextInvariant()
  )
  let raw_uri = uri.Uri(
    scheme: "file",
    user: None(),
    password: None(),
    host: None(),
    port: None(),
    path: Raw("/a/b"),
    query: None(),
    fragment: None()
  )
  failure.check(uri.to_string(raw_uri) == "file:/a/b", TextInvariant())
  failure.check(uri.percent_encode(b"a/b ") == "a%2Fb%20", TextInvariant())
  failure.check(uri.percent_decode("a%2Fb%20") == b"a/b ", TextInvariant())
  failure.check(uri.component_raw(Raw("plain")) == b"plain", TextInvariant())
  failure.check(uri.component_text(Encoded("a%2Fb")) == Ok("a/b"), TextInvariant())
  failure.check(
    uri.component_encoded(Raw("a b?"), Path()) == "a%20b%3F",
    TextInvariant()
  )
  match uri.parse("http://0x7f.0.0.1") {
    Error(InvalidHostName()) => (),
    _ => failure.check(false, TextInvariant()),
  }
  Ok(())
}
