// rule: SEM-3
// expect: run
pub fn main(rt: Io, args: Args) -> Result[(), std@1/uri.UriError] {
  let parsed = std@1/uri.parse("https://example.com/a/b?old")?
  failure.check(
    parsed.scheme == "https" && parsed.host == Some(Encoded("example.com")),
    TextInvariant()
  )
  let raw_uri = std@1/uri.Uri(
    scheme: "file",
    user: None(),
    password: None(),
    host: None(),
    port: None(),
    path: Raw("/a/b"),
    query: None(),
    fragment: None()
  )
  failure.check(std@1/uri.format(raw_uri) == "file:/a/b", TextInvariant())
  failure.check(std@1/uri.percent_encode(b"a/b ") == "a%2Fb%20", TextInvariant())
  failure.check(std@1/uri.percent_decode("a%2Fb%20") == b"a/b ", TextInvariant())
  failure.check(std@1/uri.component_raw(Raw("plain")) == b"plain", TextInvariant())
  failure.check(
    std@1/uri.component_text(Encoded("a%2Fb")) == Ok("a/b"),
    TextInvariant()
  )
  failure.check(
    std@1/uri.component_encoded(Raw("a b?"), Path()) == "a%20b%3F",
    TextInvariant()
  )
  match std@1/uri.parse("http://0x7f.0.0.1") {
    Error(InvalidHostName()) => (),
    _ => failure.check(false, TextInvariant()),
  }
  Ok(())
}
