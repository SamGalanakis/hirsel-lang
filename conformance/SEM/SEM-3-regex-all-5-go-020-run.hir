// rule: SEM-3
// expect: run
// Go ebe2feef regexp/find_test.go whole-match FindAllStringIndex vectors.
// Copyright 2009 The Go Authors. BSD-3-Clause; third-party/NOTICES.md.
fn check(pattern: String, text: String, max: u64, expected: List[regex.Span]) -> Result[
  (),
  ()
] {
  let re = match regex.compile(pattern, 1000) {
    Ok(re) => take re,
    Error(_) => return Error(()),
  }
  failure.check(regex.find_all(re, text, max, 100000) == Ok(expected), TextInvariant())
  Ok(())
}

pub fn main() -> Result[(), ()] {
  // Oracle vector 83.
  check(
    "\\!\\\"\\#\\$\\%\\&\\'\\(\\)\\*\\+\\,\\-\\.\\/\\:\\;\\<\\=\\>\\?\\@\\[\\\\\\]\\^\\_\\{\\|\\}\\~",
    "!\"#$%&'()*+,-./:;<=>?@[\\]^_{|}~",
    100,
    [regex.Span(start: 0, end: 31)]
  )?
  // Oracle vector 84.
  check(
    "[\\!\\\"\\#\\$\\%\\&\\'\\(\\)\\*\\+\\,\\-\\.\\/\\:\\;\\<\\=\\>\\?\\@\\[\\\\\\]\\^\\_\\{\\|\\}\\~]+",
    "!\"#$%&'()*+,-./:;<=>?@[\\]^_{|}~",
    100,
    [regex.Span(start: 0, end: 31)]
  )?
  // Oracle vector 85.
  check("\\`", "`", 100, [regex.Span(start: 0, end: 1)])?
  // Oracle vector 86.
  check("[\\`]+", "`", 100, [regex.Span(start: 0, end: 1)])?
  Ok(())
}
