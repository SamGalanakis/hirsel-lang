// rule: SEM-3
// expect: run
// Go ebe2feef regexp/find_test.go whole-match FindAllStringIndex vectors.
// Copyright 2009 The Go Authors. BSD-3-Clause; third-party/NOTICES.md.
fn check(pattern: String, text: String, max: u64, expected: List[regex.Span]) -> Result[
  (),
  ()
] {
  let re = match regex.compile(pattern, 1000) {
    Ok(re) => take re,
    Error(_) => return Error(()),
  }
  failure.check(regex.find_all(re, text, max, 100000) == Ok(expected), TextInvariant())
  Ok(())
}

pub fn main() -> Result[(), ()] {
  // Oracle vector 87.
  check(
    ".",
    "qwertyuiopasdfghjklzxcvbnm1234567890",
    100,
    [
      regex.Span(start: 0, end: 1),
      regex.Span(start: 1, end: 2),
      regex.Span(start: 2, end: 3),
      regex.Span(start: 3, end: 4),
      regex.Span(start: 4, end: 5),
      regex.Span(start: 5, end: 6),
      regex.Span(start: 6, end: 7),
      regex.Span(start: 7, end: 8),
      regex.Span(start: 8, end: 9),
      regex.Span(start: 9, end: 10),
      regex.Span(start: 10, end: 11),
      regex.Span(start: 11, end: 12),
      regex.Span(start: 12, end: 13),
      regex.Span(start: 13, end: 14),
      regex.Span(start: 14, end: 15),
      regex.Span(start: 15, end: 16),
      regex.Span(start: 16, end: 17),
      regex.Span(start: 17, end: 18),
      regex.Span(start: 18, end: 19),
      regex.Span(start: 19, end: 20),
      regex.Span(start: 20, end: 21),
      regex.Span(start: 21, end: 22),
      regex.Span(start: 22, end: 23),
      regex.Span(start: 23, end: 24),
      regex.Span(start: 24, end: 25),
      regex.Span(start: 25, end: 26),
      regex.Span(start: 26, end: 27),
      regex.Span(start: 27, end: 28),
      regex.Span(start: 28, end: 29),
      regex.Span(start: 29, end: 30),
      regex.Span(start: 30, end: 31),
      regex.Span(start: 31, end: 32),
      regex.Span(start: 32, end: 33),
      regex.Span(start: 33, end: 34),
      regex.Span(start: 34, end: 35),
      regex.Span(start: 35, end: 36)
    ]
  )?
  // Oracle vector 88.
  check("a+b+", "acddee", 100, [])?
  // Oracle vector 89.
  check(
    "a+b+",
    "acddeeabbaxacddeeabbaxacddeeabbaxacddeeabbaxacddeeabbaxacddeeabbaxacddeeabbaxacddeeabbaxacddeeabbaxacddeeabbax",
    100,
    [
      regex.Span(start: 6, end: 9),
      regex.Span(start: 17, end: 20),
      regex.Span(start: 28, end: 31),
      regex.Span(start: 39, end: 42),
      regex.Span(start: 50, end: 53),
      regex.Span(start: 61, end: 64),
      regex.Span(start: 72, end: 75),
      regex.Span(start: 83, end: 86),
      regex.Span(start: 94, end: 97),
      regex.Span(start: 105, end: 108)
    ]
  )?
  // Oracle vector 90.
  check(
    "",
    "aé🐑",
    100,
    [
      regex.Span(start: 0, end: 0),
      regex.Span(start: 1, end: 1),
      regex.Span(start: 3, end: 3),
      regex.Span(start: 7, end: 7)
    ]
  )?
  Ok(())
}
