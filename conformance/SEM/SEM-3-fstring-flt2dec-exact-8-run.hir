// rule: SEM-3
// expect: run
// Rust coretests/tests/num/flt2dec/mod.rs, f6c1107f8be13e48465e12c0fd26e6a39fe18e4f.
// MIT; third-party/NOTICES.md. Original check_exact/check_exact_one row lines below.
// The rounded value in units of 10^cutoff, digit by digit against `expected`.
fn same_digits(d: std@1/internal.decimal_seq.DecimalSeq, expected: String, cutoff: i32) -> bool {
  let point: i64 = core@1/int.widen(d.decimal_point)
  let limit: i64 = core@1/int.widen(cutoff)
  let text = core@1/string.as_bytes(expected)
  let length = core@1/bytes.len(text)
  if point - limit <= 0 {
    return length == 1 && text[0] == 48
  }
  let count: u64 = core@1/int.narrow(point - limit)
  if count != length {
    return false
  }
  let mut i: u64 = 0
  while i < count {
    let digit: u8 = if i < d.num_digits {
      d.digits[i]
    } else {
      0
    }
    if text[i] != digit + 48 {
      return false
    }
    i += 1
  }
  true
}

fn exact(t: Test, mantissa: u64, exponent: i32, expected: String, cutoff: i32) -> () {
  let limit: i64 = core@1/int.widen(cutoff)
  let mut d = std@1/internal.decimal_seq.exact(mantissa, exponent, -limit)
  let point: i64 = core@1/int.widen(d.decimal_point)
  std@1/internal.format.round_decimal(mut d, point - limit)
  test.check(t, same_digits(d, expected, cutoff))
}

pub fn main(t: Test) -> Result[(), ()] {
  // mod.rs:503: 5536995190630837p93f64; digits=11, decimal exponent=44.
  exact(t, 5536995190630837u64, 93i32, "54835744350", 33i32)
  // mod.rs:504: 7225450889282194p710f64; digits=12, decimal exponent=230.
  exact(t, 7225450889282194u64, 710i32, "389190181146", 218i32)
  // mod.rs:505: 7225450889282194p709f64; digits=13, decimal exponent=230.
  exact(t, 7225450889282194u64, 709i32, "1945950905732", 217i32)
  // mod.rs:506: 8703372741147379p117f64; digits=14, decimal exponent=52.
  exact(t, 8703372741147379u64, 117i32, "14460958381605", 38i32)
  // mod.rs:507: 8944262675275217p-1001f64; digits=15, decimal exponent=-285.
  exact(t, 8944262675275217u64, -1001i32, "417367747458531", -300i32)
  // mod.rs:508: 7459803696087692p-707f64; digits=16, decimal exponent=-196.
  exact(t, 7459803696087692u64, -707i32, "1107950772878888", -212i32)
  // mod.rs:509: 6080469016670379p-381f64; digits=17, decimal exponent=-98.
  exact(t, 6080469016670379u64, -381i32, "12345501366327440", -115i32)
  Ok(())
}
