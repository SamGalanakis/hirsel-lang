// rule: SEM-3
// expect: run
// Generated by tools/generate-toml-test.py from toml-test ff49d109861c
// tests/files-toml-1.0.0, group valid-table.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.valid(
    s,
    "valid/table/array-nest",
    "[[albums]]\nname = \"Born to Run\"\n\n  [[albums.songs]]\n  name = \"Jungleland\"\n\n  [[albums.songs]]\n  name = \"Meeting Across the River\"\n\n[[albums]]\nname = \"Born in the USA\"\n  \n  [[albums.songs]]\n  name = \"Glory Days\"\n\n  [[albums.songs]]\n  name = \"Dancing in the Dark\"\n",
    "{\"albums\":[{\"name\":{\"type\":\"string\",\"value\":\"Born to Run\"},\"songs\":[{\"name\":{\"type\":\"string\",\"value\":\"Jungleland\"}},{\"name\":{\"type\":\"string\",\"value\":\"Meeting Across the River\"}}]},{\"name\":{\"type\":\"string\",\"value\":\"Born in the USA\"},\"songs\":[{\"name\":{\"type\":\"string\",\"value\":\"Glory Days\"}},{\"name\":{\"type\":\"string\",\"value\":\"Dancing in the Dark\"}}]}]}"
  )
  failed += harness.valid(
    s,
    "valid/table/array-one",
    "[[people]]\nfirst_name = \"Bruce\"\nlast_name = \"Springsteen\"\n",
    "{\"people\":[{\"first_name\":{\"type\":\"string\",\"value\":\"Bruce\"},\"last_name\":{\"type\":\"string\",\"value\":\"Springsteen\"}}]}"
  )
  failed += harness.valid(
    s,
    "valid/table/array-table-array",
    "[[a]]\n    [[a.b]]\n        [a.b.c]\n            d = \"val0\"\n    [[a.b]]\n        [a.b.c]\n            d = \"val1\"\n",
    "{\"a\":[{\"b\":[{\"c\":{\"d\":{\"type\":\"string\",\"value\":\"val0\"}}},{\"c\":{\"d\":{\"type\":\"string\",\"value\":\"val1\"}}}]}]}"
  )
  failed += harness.valid(
    s,
    "valid/table/array-within-dotted",
    "[fruit]\napple.color = \"red\"\n\n[[fruit.apple.seeds]]\nsize = 2\n",
    "{\"fruit\":{\"apple\":{\"color\":{\"type\":\"string\",\"value\":\"red\"},\"seeds\":[{\"size\":{\"type\":\"integer\",\"value\":\"2\"}}]}}}"
  )
  failed += harness.valid(s, "valid/table/empty", "[a]\n", "{\"a\":{}}")
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
