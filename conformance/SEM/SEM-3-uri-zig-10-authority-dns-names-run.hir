// rule: SEM-3
// expect: run
// Zig Uri.zig:667-678, authority.dns-names (bff490a2, MIT).
pub fn main() -> Result[(), ()] {
  {
    let Ok(parsed_uri) = std@1/uri.parse("scheme://a") else {
      return Error(())
    }
    failure.check(parsed_uri.host == Some(Encoded("a")), TextInvariant())
  }
  {
    let Ok(parsed_uri) = std@1/uri.parse("scheme://a.b") else {
      return Error(())
    }
    failure.check(parsed_uri.host == Some(Encoded("a.b")), TextInvariant())
  }
  {
    let Ok(parsed_uri) = std@1/uri.parse("scheme://example.com") else {
      return Error(())
    }
    failure.check(parsed_uri.host == Some(Encoded("example.com")), TextInvariant())
  }
  {
    let Ok(parsed_uri) = std@1/uri.parse("scheme://www.example.com") else {
      return Error(())
    }
    failure.check(parsed_uri.host == Some(Encoded("www.example.com")), TextInvariant())
  }
  {
    let Ok(parsed_uri) = std@1/uri.parse("scheme://example.org.") else {
      return Error(())
    }
    failure.check(parsed_uri.host == Some(Encoded("example.org.")), TextInvariant())
  }
  {
    let Ok(parsed_uri) = std@1/uri.parse("scheme://www.example.org.") else {
      return Error(())
    }
    failure.check(parsed_uri.host == Some(Encoded("www.example.org.")), TextInvariant())
  }
  {
    let Ok(parsed_uri) = std@1/uri.parse("scheme://xn--nw2a.xn--j6w193g") else {
      return Error(())
    }
    failure.check(
      parsed_uri.host == Some(Encoded("xn--nw2a.xn--j6w193g")),
      TextInvariant()
    )
  }
  {
    let Ok(parsed_uri) = std@1/uri.parse(
      "scheme://fe80--1ff-fe23-4567-890as3.ipv6-literal.net"
    ) else {
      return Error(())
    }
    failure.check(
      parsed_uri.host == Some(Encoded("fe80--1ff-fe23-4567-890as3.ipv6-literal.net")),
      TextInvariant()
    )
  }
  Ok(())
}
