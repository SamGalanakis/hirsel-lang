    let (x, leading, trailing, ones, swapped, reversed) = c
    failure.check(int.leading_zeros(x) == leading, Bounds())
    failure.check(int.trailing_zeros(x) == trailing, Bounds())
    failure.check(int.count_ones(x) == ones, Bounds())
    failure.check(int.swap_bytes(x) == swapped, Bounds())
    failure.check(int.reverse_bits(x) == reversed, Bounds())
  }
