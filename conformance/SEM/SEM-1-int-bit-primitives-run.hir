// rule: SEM-1
// expect: run
// The core integer bit primitives at every width: int.leading_zeros,
// trailing_zeros and count_ones count bits of the two's complement word (the
// width for zero), int.swap_bytes reverses its bytes and int.reverse_bits its
// bits, each result of the operand's type. Rows are the edges, single high and
// low bits and Rust coretests num/int_macros.rs A, B and C (0b0101100,
// 0b0100001, 0b1111001); expected values are Rust's u128 operations on the
// word at the top of 128 bits.
pub fn main(t: Test) -> Result[(), ()] {
  let u8_cases: Array[(u8, u8, u8, u8, u8, u8)] = [
    (0u8, 8u8, 8u8, 0u8, 0u8, 0u8),
    (1u8, 7u8, 0u8, 1u8, 1u8, 128u8),
    (2u8, 6u8, 1u8, 1u8, 2u8, 64u8),
