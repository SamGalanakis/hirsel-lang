// rule: SEM-3
// expect: run
// Published spec.txt vectors; tools/generate-markdown.py.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.check(
    s,
    "commonmark/Indented code blocks/107/malformed",
    "    a simple\n      \u{0}[&unterminated",
    "<pre><code>a simple\n  �[&amp;unterminated\n</code></pre>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Indented code blocks/108/malformed",
    "  - foo\n\u{0}[&unterminated",
    "<ul>\n<li>foo\n�[&amp;unterminated</li>\n</ul>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Indented code blocks/109/malformed",
    "1.  foo\n\n\u{0}[&unterminated",
    "<ol>\n<li>foo</li>\n</ol>\n<p>�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Indented code blocks/110/malformed",
    "    <a/>\n    *\u{0}[&unterminated",
    "<pre><code>&lt;a/&gt;\n*�[&amp;unterminated\n</code></pre>\n",
    std@1/markdown.default_options()
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
