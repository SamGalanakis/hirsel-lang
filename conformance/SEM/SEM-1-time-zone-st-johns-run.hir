// rule: SEM-1
// expect: run
// America/St_Johns from jiff's TZif test file: half-hour offsets on both sides
// of its gap and fold.
pub fn main(t: Test) -> Result[(), ()] {
  let zone = test.expect_ok(t, time_zone.from_tzif(zones.ST_JOHNS))
  check.ambiguity(
    t,
    zone,
    [
      ("1969-12-31T20:30:00", 0, -12600, -12600),
      ("2024-03-10T01:59:59.999999999", 0, -12600, -12600),
      ("2024-03-10T02:00:00", 1, -12600, -9000),
      ("2024-03-10T02:59:59.999999999", 1, -12600, -9000),
      ("2024-03-10T03:00:00", 0, -9000, -9000),
      ("2024-11-03T00:59:59.999999999", 0, -9000, -9000),
      ("2024-11-03T01:00:00", 2, -9000, -12600),
      ("2024-11-03T01:59:59.999999999", 2, -9000, -12600),
      ("2024-11-03T02:00:00", 0, -12600, -12600)
    ]
  )
  Ok(())
}
