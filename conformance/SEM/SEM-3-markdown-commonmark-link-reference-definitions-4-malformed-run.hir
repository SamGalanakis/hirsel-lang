// rule: SEM-3
// expect: run
// Published spec.txt vectors; tools/generate-markdown.py.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.check(
    s,
    "commonmark/Link reference definitions/204/malformed",
    "[foo]\n\n[foo]: fir\u{0}[&unterminated",
    "<p><a href=\"fir%EF%BF%BD%5B&amp;unterminated\">foo</a></p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Link reference definitions/205/malformed",
    "[FOO]: /u\u{0}[&unterminated",
    "",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Link reference definitions/206/malformed",
    "[ΑΓΩ]: /φ\u{0}[&unterminated",
    "",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Link reference definitions/207/malformed",
    "[foo]:\u{0}[&unterminated",
    "",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Link reference definitions/208/malformed",
    "[\nfoo\n]: \u{0}[&unterminated",
    "",
    std@1/markdown.default_options()
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
