// rule: SEM-3
// expect: run
// Generated by tools/generate-toml-test.py from toml-test ff49d109861c
// tests/files-toml-1.0.0, group valid-table.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.valid(s, "valid/table/array-empty", "[[a]]\n", "{\"a\":[{}]}")
  failed += harness.valid(
    s,
    "valid/table/array-empty-name",
    "# Silly thing to do, but valid.\n\n[['']]\na = 1\n[['']]\na = 2\n",
    "{\"\":[{\"a\":{\"type\":\"integer\",\"value\":\"1\"}},{\"a\":{\"type\":\"integer\",\"value\":\"2\"}}]}"
  )
  failed += harness.valid(
    s,
    "valid/table/array-implicit",
    "[[albums.songs]]\nname = \"Glory Days\"\n",
    "{\"albums\":{\"songs\":[{\"name\":{\"type\":\"string\",\"value\":\"Glory Days\"}}]}}"
  )
  failed += harness.valid(
    s,
    "valid/table/array-implicit-and-explicit-after",
    "[[a.b]]\nx = 1\n\n[a]\ny = 2\n",
    "{\"a\":{\"b\":[{\"x\":{\"type\":\"integer\",\"value\":\"1\"}}],\"y\":{\"type\":\"integer\",\"value\":\"2\"}}}"
  )
  failed += harness.valid(
    s,
    "valid/table/array-many",
    "[[people]]\nfirst_name = \"Bruce\"\nlast_name = \"Springsteen\"\n\n[[people]]\nfirst_name = \"Eric\"\nlast_name = \"Clapton\"\n\n[[people]]\nfirst_name = \"Bob\"\nlast_name = \"Seger\"\n",
    "{\"people\":[{\"first_name\":{\"type\":\"string\",\"value\":\"Bruce\"},\"last_name\":{\"type\":\"string\",\"value\":\"Springsteen\"}},{\"first_name\":{\"type\":\"string\",\"value\":\"Eric\"},\"last_name\":{\"type\":\"string\",\"value\":\"Clapton\"}},{\"first_name\":{\"type\":\"string\",\"value\":\"Bob\"},\"last_name\":{\"type\":\"string\",\"value\":\"Seger\"}}]}"
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
