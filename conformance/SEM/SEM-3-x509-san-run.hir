// See docs/x509-prior-art.md for source lines and envelope adaptations.
fn subject(der: Bytes) -> Option[String] uses {} {
  match x509.parse(der) {
    Ok(c) => Some(c.subject),
    Error(_) => None(),
  }
}

pub fn main(t: Test) -> Result[(), x509.X509Error] {
  // DNS.
  test.check(
    t,
    subject(
      b"\x30\x24\x30\x22\x02\x01\x01\x30\x00\x30\x00\x30\x00\x30\x00\x30\x00\xa3\x13\x30\x11\x30\x0f\x06\x03\x55\x1d\x11\x04\x08\x30\x06\x82\x04\x61\x2e\x2e\x62"
    ) == Some("")
  )
  // DNS IA5.
  test.check(
    t,
    subject(
      b"\x30\x21\x30\x1f\x02\x01\x01\x30\x00\x30\x00\x30\x00\x30\x00\x30\x00\xa3\x10\x30\x0e\x30\x0c\x06\x03\x55\x1d\x11\x04\x05\x30\x03\x82\x01\xff"
    ) == None()
  )
  // email IA5.
  test.check(
    t,
    subject(
      b"\x30\x21\x30\x1f\x02\x01\x01\x30\x00\x30\x00\x30\x00\x30\x00\x30\x00\xa3\x10\x30\x0e\x30\x0c\x06\x03\x55\x1d\x11\x04\x05\x30\x03\x81\x01\xff"
    ) == None()
  )
  // email.
  test.check(
    t,
    subject(
      b"\x30\x23\x30\x21\x02\x01\x01\x30\x00\x30\x00\x30\x00\x30\x00\x30\x00\xa3\x12\x30\x10\x30\x0e\x06\x03\x55\x1d\x11\x04\x07\x30\x05\x81\x03\x61\x40\x62"
    ) == Some("")
  )
  // URI IA5.
  test.check(
    t,
    subject(
      b"\x30\x21\x30\x1f\x02\x01\x01\x30\x00\x30\x00\x30\x00\x30\x00\x30\x00\xa3\x10\x30\x0e\x30\x0c\x06\x03\x55\x1d\x11\x04\x05\x30\x03\x86\x01\xff"
    ) == None()
  )
  // URI host.
  test.check(
    t,
    subject(
      b"\x30\x33\x30\x31\x02\x01\x01\x30\x00\x30\x00\x30\x00\x30\x00\x30\x00\xa3\x22\x30\x20\x30\x1e\x06\x03\x55\x1d\x11\x04\x17\x30\x15\x86\x13\x73\x70\x69\x66\x66\x65\x3a\x2f\x2f\x61\x2e\x2e\x62\x2f\x61\x67\x65\x6e\x74"
    ) == None()
  )
  // URI.
  test.check(
    t,
    subject(
      b"\x30\x32\x30\x30\x02\x01\x01\x30\x00\x30\x00\x30\x00\x30\x00\x30\x00\xa3\x21\x30\x1f\x30\x1d\x06\x03\x55\x1d\x11\x04\x16\x30\x14\x86\x12\x73\x70\x69\x66\x66\x65\x3a\x2f\x2f\x61\x2e\x62\x2f\x61\x67\x65\x6e\x74"
    ) == Some("")
  )
  // URI escaped path.
  test.check(
    t,
    subject(
      b"\x30\x30\x30\x2e\x02\x01\x01\x30\x00\x30\x00\x30\x00\x30\x00\x30\x00\xa3\x1f\x30\x1d\x30\x1b\x06\x03\x55\x1d\x11\x04\x14\x30\x12\x86\x10\x73\x70\x69\x66\x66\x65\x3a\x2f\x2f\x61\x2e\x62\x2f\x25\x7a\x7a"
    ) == None()
  )
  // URI control.
  test.check(
    t,
    subject(
      b"\x30\x2e\x30\x2c\x02\x01\x01\x30\x00\x30\x00\x30\x00\x30\x00\x30\x00\xa3\x1d\x30\x1b\x30\x19\x06\x03\x55\x1d\x11\x04\x12\x30\x10\x86\x0e\x73\x70\x69\x66\x66\x65\x3a\x2f\x2f\x61\x2e\x62\x2f\x0a"
    ) == None()
  )
  // URI relative.
  test.check(
    t,
    subject(
      b"\x30\x27\x30\x25\x02\x01\x01\x30\x00\x30\x00\x30\x00\x30\x00\x30\x00\xa3\x16\x30\x14\x30\x12\x06\x03\x55\x1d\x11\x04\x0b\x30\x09\x86\x07\x61\x67\x65\x6e\x74\x2f\x37"
    ) == Some("")
  )
  // IP length.
  test.check(
    t,
    subject(
      b"\x30\x25\x30\x23\x02\x01\x01\x30\x00\x30\x00\x30\x00\x30\x00\x30\x00\xa3\x14\x30\x12\x30\x10\x06\x03\x55\x1d\x11\x04\x09\x30\x07\x87\x05\x31\x32\x33\x34\x35"
    ) == None()
  )
  // IPv4 mapped IPv6.
  test.check(
    t,
    subject(
      b"\x30\x30\x30\x2e\x02\x01\x01\x30\x00\x30\x00\x30\x00\x30\x00\x30\x00\xa3\x1f\x30\x1d\x30\x1b\x06\x03\x55\x1d\x11\x04\x14\x30\x12\x87\x10\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\xff\xff\x7f\x00\x00\x01"
    ) == None()
  )
  // IPv4.
  test.check(
    t,
    subject(
      b"\x30\x24\x30\x22\x02\x01\x01\x30\x00\x30\x00\x30\x00\x30\x00\x30\x00\xa3\x13\x30\x11\x30\x0f\x06\x03\x55\x1d\x11\x04\x08\x30\x06\x87\x04\x7f\x00\x00\x01"
    ) == Some("")
  )
  // IPv6.
  test.check(
    t,
    subject(
      b"\x30\x30\x30\x2e\x02\x01\x01\x30\x00\x30\x00\x30\x00\x30\x00\x30\x00\xa3\x1f\x30\x1d\x30\x1b\x06\x03\x55\x1d\x11\x04\x14\x30\x12\x87\x10\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x01"
    ) == Some("")
  )
  // URI empty.
  test.check(
    t,
    subject(
      b"\x30\x20\x30\x1e\x02\x01\x01\x30\x00\x30\x00\x30\x00\x30\x00\x30\x00\xa3\x0f\x30\x0d\x30\x0b\x06\x03\x55\x1d\x11\x04\x04\x30\x02\x86\x00"
    ) == Some("")
  )
  // URI opaque escape.
  test.check(
    t,
    subject(
      b"\x30\x2f\x30\x2d\x02\x01\x01\x30\x00\x30\x00\x30\x00\x30\x00\x30\x00\xa3\x1e\x30\x1c\x30\x1a\x06\x03\x55\x1d\x11\x04\x13\x30\x11\x86\x0f\x75\x72\x6e\x3a\x65\x78\x61\x6d\x70\x6c\x65\x3a\x25\x7a\x7a"
    ) == Some("")
  )
  // URI raw query.
  test.check(
    t,
    subject(
      b"\x30\x3a\x30\x38\x02\x01\x01\x30\x00\x30\x00\x30\x00\x30\x00\x30\x00\xa3\x29\x30\x27\x30\x25\x06\x03\x55\x1d\x11\x04\x1e\x30\x1c\x86\x1a\x68\x74\x74\x70\x73\x3a\x2f\x2f\x65\x78\x61\x6d\x70\x6c\x65\x2e\x63\x6f\x6d\x2f\x3f\x61\x3d\x25\x7a\x7a"
    ) == Some("")
  )
  // URI fragment escape.
  test.check(
    t,
    subject(
      b"\x30\x38\x30\x36\x02\x01\x01\x30\x00\x30\x00\x30\x00\x30\x00\x30\x00\xa3\x27\x30\x25\x30\x23\x06\x03\x55\x1d\x11\x04\x1c\x30\x1a\x86\x18\x68\x74\x74\x70\x73\x3a\x2f\x2f\x65\x78\x61\x6d\x70\x6c\x65\x2e\x63\x6f\x6d\x2f\x23\x25\x7a\x7a"
    ) == None()
  )
  // URI port.
  test.check(
    t,
    subject(
      b"\x30\x3a\x30\x38\x02\x01\x01\x30\x00\x30\x00\x30\x00\x30\x00\x30\x00\xa3\x29\x30\x27\x30\x25\x06\x03\x55\x1d\x11\x04\x1e\x30\x1c\x86\x1a\x68\x74\x74\x70\x73\x3a\x2f\x2f\x65\x78\x61\x6d\x70\x6c\x65\x2e\x63\x6f\x6d\x3a\x38\x34\x34\x33\x2f\x61"
    ) == Some("")
  )
  // URI invalid port.
  test.check(
    t,
    subject(
      b"\x30\x39\x30\x37\x02\x01\x01\x30\x00\x30\x00\x30\x00\x30\x00\x30\x00\xa3\x28\x30\x26\x30\x24\x06\x03\x55\x1d\x11\x04\x1d\x30\x1b\x86\x19\x68\x74\x74\x70\x73\x3a\x2f\x2f\x65\x78\x61\x6d\x70\x6c\x65\x2e\x63\x6f\x6d\x3a\x61\x62\x63\x2f\x61"
    ) == None()
  )
  // URI mixed case scheme.
  test.check(
    t,
    subject(
      b"\x30\x38\x30\x36\x02\x01\x01\x30\x00\x30\x00\x30\x00\x30\x00\x30\x00\xa3\x27\x30\x25\x30\x23\x06\x03\x55\x1d\x11\x04\x1c\x30\x1a\x86\x18\x68\x54\x74\x50\x73\x3a\x2f\x2f\x65\x78\x61\x6d\x70\x6c\x65\x2e\x63\x6f\x6d\x3a\x38\x30\x2f\x61"
    ) == Some("")
  )
  // URI escaped ASCII host.
  test.check(
    t,
    subject(
      b"\x30\x37\x30\x35\x02\x01\x01\x30\x00\x30\x00\x30\x00\x30\x00\x30\x00\xa3\x26\x30\x24\x30\x22\x06\x03\x55\x1d\x11\x04\x1b\x30\x19\x86\x17\x68\x74\x74\x70\x73\x3a\x2f\x2f\x25\x36\x35\x78\x61\x6d\x70\x6c\x65\x2e\x63\x6f\x6d\x2f\x61"
    ) == None()
  )
  // URI escaped non-ASCII host.
  test.check(
    t,
    subject(
      b"\x30\x2d\x30\x2b\x02\x01\x01\x30\x00\x30\x00\x30\x00\x30\x00\x30\x00\xa3\x1c\x30\x1a\x30\x18\x06\x03\x55\x1d\x11\x04\x11\x30\x0f\x86\x0d\x68\x74\x74\x70\x73\x3a\x2f\x2f\x25\x66\x66\x2f\x61"
    ) == None()
  )
  // URI escaped percent host.
  test.check(
    t,
    subject(
      b"\x30\x34\x30\x32\x02\x01\x01\x30\x00\x30\x00\x30\x00\x30\x00\x30\x00\xa3\x23\x30\x21\x30\x1f\x06\x03\x55\x1d\x11\x04\x18\x30\x16\x86\x14\x68\x74\x74\x70\x73\x3a\x2f\x2f\x65\x78\x61\x6d\x70\x6c\x65\x25\x32\x35\x2f\x61"
    ) == Some("")
  )
  // URI bad userinfo.
  test.check(
    t,
    subject(
      b"\x30\x3b\x30\x39\x02\x01\x01\x30\x00\x30\x00\x30\x00\x30\x00\x30\x00\xa3\x2a\x30\x28\x30\x26\x06\x03\x55\x1d\x11\x04\x1f\x30\x1d\x86\x1b\x68\x74\x74\x70\x73\x3a\x2f\x2f\x75\x5b\x73\x65\x72\x40\x65\x78\x61\x6d\x70\x6c\x65\x2e\x63\x6f\x6d\x2f\x61"
    ) == None()
  )
  // URI userinfo.
  test.check(
    t,
    subject(
      b"\x30\x3f\x30\x3d\x02\x01\x01\x30\x00\x30\x00\x30\x00\x30\x00\x30\x00\xa3\x2e\x30\x2c\x30\x2a\x06\x03\x55\x1d\x11\x04\x23\x30\x21\x86\x1f\x68\x74\x74\x70\x73\x3a\x2f\x2f\x75\x73\x65\x72\x3a\x70\x40\x73\x73\x40\x65\x78\x61\x6d\x70\x6c\x65\x2e\x63\x6f\x6d\x2f\x61"
    ) == Some("")
  )
  // URI valid bracket IPv6.
  test.check(
    t,
    subject(
      b"\x30\x2f\x30\x2d\x02\x01\x01\x30\x00\x30\x00\x30\x00\x30\x00\x30\x00\xa3\x1e\x30\x1c\x30\x1a\x06\x03\x55\x1d\x11\x04\x13\x30\x11\x86\x0f\x68\x74\x74\x70\x73\x3a\x2f\x2f\x5b\x3a\x3a\x31\x5d\x2f\x61"
    ) == Some("")
  )
  // URI invalid bracket IPv6.
  test.check(
    t,
    subject(
      b"\x30\x2f\x30\x2d\x02\x01\x01\x30\x00\x30\x00\x30\x00\x30\x00\x30\x00\xa3\x1e\x30\x1c\x30\x1a\x06\x03\x55\x1d\x11\x04\x13\x30\x11\x86\x0f\x68\x74\x74\x70\x73\x3a\x2f\x2f\x5b\x61\x62\x63\x5d\x2f\x61"
    ) == None()
  )
  // URI IPv4 bracket.
  test.check(
    t,
    subject(
      b"\x30\x35\x30\x33\x02\x01\x01\x30\x00\x30\x00\x30\x00\x30\x00\x30\x00\xa3\x24\x30\x22\x30\x20\x06\x03\x55\x1d\x11\x04\x19\x30\x17\x86\x15\x68\x74\x74\x70\x73\x3a\x2f\x2f\x5b\x31\x32\x37\x2e\x30\x2e\x30\x2e\x31\x5d\x2f\x61"
    ) == None()
  )
  // URI valid IPv6 zone.
  test.check(
    t,
    subject(
      b"\x30\x3a\x30\x38\x02\x01\x01\x30\x00\x30\x00\x30\x00\x30\x00\x30\x00\xa3\x29\x30\x27\x30\x25\x06\x03\x55\x1d\x11\x04\x1e\x30\x1c\x86\x1a\x68\x74\x74\x70\x73\x3a\x2f\x2f\x5b\x66\x65\x38\x30\x3a\x3a\x31\x25\x32\x35\x65\x74\x68\x30\x5d\x2f\x61"
    ) == Some("")
  )
  // URI empty IPv6 zone.
  test.check(
    t,
    subject(
      b"\x30\x36\x30\x34\x02\x01\x01\x30\x00\x30\x00\x30\x00\x30\x00\x30\x00\xa3\x25\x30\x23\x30\x21\x06\x03\x55\x1d\x11\x04\x1a\x30\x18\x86\x16\x68\x74\x74\x70\x73\x3a\x2f\x2f\x5b\x66\x65\x38\x30\x3a\x3a\x31\x25\x32\x35\x5d\x2f\x61"
    ) == None()
  )
  // URI malformed bracket.
  test.check(
    t,
    subject(
      b"\x30\x2e\x30\x2c\x02\x01\x01\x30\x00\x30\x00\x30\x00\x30\x00\x30\x00\xa3\x1d\x30\x1b\x30\x19\x06\x03\x55\x1d\x11\x04\x12\x30\x10\x86\x0e\x68\x74\x74\x70\x73\x3a\x2f\x2f\x5b\x3a\x3a\x31\x2f\x61"
    ) == None()
  )
  // URI leading dot.
  test.check(
    t,
    subject(
      b"\x30\x36\x30\x34\x02\x01\x01\x30\x00\x30\x00\x30\x00\x30\x00\x30\x00\xa3\x25\x30\x23\x30\x21\x06\x03\x55\x1d\x11\x04\x1a\x30\x18\x86\x16\x68\x74\x74\x70\x73\x3a\x2f\x2f\x2e\x65\x78\x61\x6d\x70\x6c\x65\x2e\x63\x6f\x6d\x2f\x61"
    ) == None()
  )
  // URI trailing dot.
  test.check(
    t,
    subject(
      b"\x30\x36\x30\x34\x02\x01\x01\x30\x00\x30\x00\x30\x00\x30\x00\x30\x00\xa3\x25\x30\x23\x30\x21\x06\x03\x55\x1d\x11\x04\x1a\x30\x18\x86\x16\x68\x74\x74\x70\x73\x3a\x2f\x2f\x65\x78\x61\x6d\x70\x6c\x65\x2e\x63\x6f\x6d\x2e\x2f\x61"
    ) == None()
  )
  // URI relative triple slash.
  test.check(
    t,
    subject(
      b"\x30\x2a\x30\x28\x02\x01\x01\x30\x00\x30\x00\x30\x00\x30\x00\x30\x00\xa3\x19\x30\x17\x30\x15\x06\x03\x55\x1d\x11\x04\x0e\x30\x0c\x86\x0a\x2f\x2f\x2f\x61\x67\x65\x6e\x74\x2f\x37"
    ) == Some("")
  )
  Ok(())
}
