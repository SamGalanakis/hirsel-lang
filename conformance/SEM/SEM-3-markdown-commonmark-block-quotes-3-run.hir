// rule: SEM-3
// expect: run
// Published spec.txt vectors; tools/generate-markdown.py.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.check(
    s,
    "commonmark/Block quotes/239",
    ">\n",
    "<blockquote>\n</blockquote>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Block quotes/240",
    ">\n>  \n> \n",
    "<blockquote>\n</blockquote>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Block quotes/241",
    ">\n> foo\n>  \n",
    "<blockquote>\n<p>foo</p>\n</blockquote>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Block quotes/242",
    "> foo\n\n> bar\n",
    "<blockquote>\n<p>foo</p>\n</blockquote>\n<blockquote>\n<p>bar</p>\n</blockquote>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Block quotes/243",
    "> foo\n> bar\n",
    "<blockquote>\n<p>foo\nbar</p>\n</blockquote>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Block quotes/244",
    "> foo\n>\n> bar\n",
    "<blockquote>\n<p>foo</p>\n<p>bar</p>\n</blockquote>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Block quotes/245",
    "foo\n> bar\n",
    "<p>foo</p>\n<blockquote>\n<p>bar</p>\n</blockquote>\n",
    std@1/markdown.default_options()
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
