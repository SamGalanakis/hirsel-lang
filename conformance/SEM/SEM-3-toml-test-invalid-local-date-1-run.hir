// rule: SEM-3
// expect: run
// Generated by tools/generate-toml-test.py from toml-test ff49d109861c
// tests/files-toml-1.1.0, group invalid-local-date.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.invalid(s, "invalid/local-date/day-1digit", "foo = 1997-09-9\n")
  failed += harness.invalid(
    s,
    "invalid/local-date/feb-29",
    "\"not a leap year\" = 2100-02-29\n"
  )
  failed += harness.invalid(
    s,
    "invalid/local-date/feb-30",
    "\"only 28 or 29 days in february\" = 1988-02-30\n\n"
  )
  failed += harness.invalid(
    s,
    "invalid/local-date/mday-over",
    "# date-mday       = 2DIGIT  ; 01-28, 01-29, 01-30, 01-31 based on\n#                           ; month/year\nd = 2006-01-32\n"
  )
  failed += harness.invalid(
    s,
    "invalid/local-date/mday-under",
    "# date-mday       = 2DIGIT  ; 01-28, 01-29, 01-30, 01-31 based on\n#                           ; month/year\nd = 2006-01-00\n"
  )
  failed += harness.invalid(
    s,
    "invalid/local-date/month-over",
    "# date-month      = 2DIGIT  ; 01-12\nd = 2006-13-01\n"
  )
  failed += harness.invalid(
    s,
    "invalid/local-date/month-under",
    "# date-month      = 2DIGIT  ; 01-12\nd = 2007-00-01\n"
  )
  failed += harness.invalid(
    s,
    "invalid/local-date/no-leads",
    "# Month \"7\" instead of \"07\"; the leading zero is required.\nno-leads = 1987-7-05\n"
  )
  failed += harness.invalid(
    s,
    "invalid/local-date/no-leads-with-milli",
    "# Day \"5\" instead of \"05\"; the leading zero is required.\nwith-milli = 1987-07-5\n"
  )
  failed += harness.invalid(
    s,
    "invalid/local-date/trailing-t",
    "# Date cannot end with trailing T\nd = 2006-01-30T\n"
  )
  failed += harness.invalid(
    s,
    "invalid/local-date/y10k",
    "# Maximum RFC3399 year is 9999.\nd = 10000-01-01\n"
  )
  failed += harness.invalid(s, "invalid/local-date/year-3digits", "foo = 199-09-09\n")
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
