// rule: SEM-3
// expect: run
// JSONTestSuite 1ef36fa01286573e846ac449e8683f8833c5b26a test_parsing/*.json:1.
// Differential reader twin of the existing imports; exact JsonError offsets.
fn check(t: Test, source: String) -> () {
  let expected: Result[(), json.JsonError] = match json.parse(unique source) {
    Ok(_) => Ok(()),
    Error(e) => Error(e),
  }
  let mut cursor = json.reader(string.as_bytes(source))
  let actual = match json.skip(mut cursor) {
    Ok(()) => json.finish_reader(mut cursor),
    Error(e) => Error(e),
  }
  test.equal(t, actual, expected)
}

pub fn main(t: Test) -> Result[(), ()] {
  // "n_number_neg_int_starting_with_zero.json:1"
  check(t, "[-012]")
  // "n_number_neg_real_without_int_part.json:1"
  check(t, "[-.123]")
  // "n_number_neg_with_garbage_at_end.json:1"
  check(t, "[-1x]")
  // "n_number_real_garbage_after_e.json:1"
  check(t, "[1ea]")
  // "n_number_real_without_fractional_part.json:1"
  check(t, "[1.]")
  // "n_number_starting_with_dot.json:1"
  check(t, "[.123]")
  // "n_number_with_alpha.json:1"
  check(t, "[1.2a-3]")
  // "n_number_with_alpha_char.json:1"
  check(t, "[1.8011670033376514H-308]")
  Ok(())
}
