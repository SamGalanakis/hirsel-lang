// rule: SEM-3
// expect: run
// Published spec.txt vectors; tools/generate-markdown.py.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.check(
    s,
    "commonmark/HTML blocks/148/malformed",
    "<table><tr><td>\n<pre>\n**Hello**,\n\n\u{0}[&unterminated",
    "<table><tr><td>\n<pre>\n**Hello**,\n<p>�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/HTML blocks/149/malformed",
    "<table>\n  <tr>\n    <td>\n           h\u{0}[&unterminated",
    "<table>\n  <tr>\n    <td>\n           h�[&unterminated\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/HTML blocks/150/malformed",
    " <div>\n  *hello*\n\u{0}[&unterminated",
    " <div>\n  *hello*\n�[&unterminated\n",
    std@1/markdown.default_options()
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
