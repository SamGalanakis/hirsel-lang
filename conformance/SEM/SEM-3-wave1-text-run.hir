// rule: SEM-3
// expect: run
// stdout: ok
pub fn main(rt: Io, args: Args) -> Result[(), LaunchError] {
  let mut builder: List[u8] = []
  text.append(mut builder, "é")
  text.append(mut builder, "😀")
  let text: String = match text.finish(take builder) {
    Ok(s) => take s,
    Error(_) => "bad",
  }
  let parts = string.split(take text, "é")
  failure.check(parts == ["", "😀"], TextInvariant())
  let bytes = string.as_bytes("prefixé😀TAIL")
  let interval = bytes.slice(bytes, 6, 12)
  failure.check(bytes.len(interval) == 6, TextInvariant())
  failure.check(interval[0] == 195u8 && interval[1] == 169u8, TextInvariant())
  failure.check(path.text(path.of("a/../é")) == "a/../é", TextInvariant())
  out.print(io.stdout(rt) ? Grant, "ok\n") ? Output
  Ok(())
}

pub type LaunchError = Grant(GrantError) | Output(OutputError)
