// rule: SEM-3
// expect: run
// stdout: ok
// "There is no length" — " byte_len" counts UTF-8 bytes.
fn output_error[E](take e: E) -> () {}

pub fn main(rt: Io, args: Args) -> Result[(), ()] {
  let s: String = ""
  let n = string.byte_len(s)
  out.print(
    io.stdout(rt) ? grant_error,
    if n == 0 {
      "ok\n"
    } else {
      "bad\n"
    }
  ) ? output_error
  Ok(())
}

@noalloc
fn grant_error(refusal: GrantError) -> () uses {} {
  ()
}
