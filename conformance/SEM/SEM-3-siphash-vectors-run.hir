// rule: SEM-3
// expect: run
// Rust coretests library/coretests/tests/hash/sip.rs (rust-lang/rust f6c1107):
// test_siphash_1_3's 64 vectors (keys 00..0f, messages 00..i), whole and
// incremental, plus the short-write, idempotence, dropped-byte and
// concatenation-alias checks, on std@1/siphash.
const VECTORS: List[u64] = [
  0xabac0158050fc4dc,
  0xc9f49bf37d57ca93,
  0x82cb9b024dc7d44d,
  0x8bf80ab8e7ddf7fb,
  0xcf75576088d38328,
  0xdef9d52f49533b67,
  0xc50d2b50c59f22a7,
  0xd3927d989bb11140,
  0x369095118d299a8e,
  0x25a48eb36c063de4,
  0x79de85ee92ff097f,
  0x70c118c1f94dc352,
  0x78a384b157b4d9a2,
  0x306f760c1229ffa7,
  0x605aa111c0f95d34,
  0xd320d86d2a519956,
  0xcc4fdd1a7d908b66,
  0x9cf2689063dbd80c,
  0x8ffc389cb473e63e,
  0xf21f9de58d297d1c,
  0xc0dc2f46a6cce040,
  0xb992abfe2b45f844,
  0x7ffe7b9ba320872e,
  0x525a0e7fdae6c123,
  0xf464aeb267349c8c,
  0x45cd5928705b0979,
  0x3a3e35e3ca9913a5,
  0xa91dc74e4ade3b35,
  0xfb0bed02ef6cd00d,
  0x88d93cb44ab1e1f4,
  0x540f11d643c5e663,
  0x2370dd1f8c21d1bc,
  0x81157b6c16a7b60d,
  0x4d54b9e57a8ff9bf,
  0x759f12781f2a753e,
  0xcea1a3bebf186b91,
  0x2cf508d3ada26206,
  0xb6101c2da3c33057,
  0xb3f47496ae3a36a1,
  0x626b57547b108392,
  0xc1d2363299e41531,
  0x667cc1923f1ad944,
  0x65704ffec8138825,
  0x24f280d1c28949a6,
  0xc2ca1cedfaf8876b,
  0xc2164bfc9f042196,
  0xa16e9c9368b1d623,
  0x49fb169c8b5114fd,
  0x9f3143f8df074c46,
  0xc6fdaf2412cc86b3,
  0x7eaf49d10a52098f,
  0x1cf313559d292f9a,
  0xc44a30dda2f41f12,
  0x36fae98943a71ed0,
  0x318fb34c73f0bce6,
  0xa27abf3670a7e980,
  0xb4bcc0db243c6d75,
  0x23f8d852fdb71513,
  0x8f035f4da67d8a08,
  0xd89cd0e5b7e8f148,
  0xf6f4e6bcf7a644ee,
  0xaec59ad80f1837f2,
  0xc3b2f6154b6694e0,
  0x9d199062b7bbb3a8
]

const K0: u64 = 0x0706050403020100

const K1: u64 = 0x0f0e0d0c0b0a0908

fn hash_u64(value: u64) -> u64 uses {} {
  let mut s = siphash.new(0, 0)
  siphash.write_u64(mut s, value)
  siphash.finish(s)
}

fn hash_u32(value: u32) -> u64 uses {} {
  let mut s = siphash.new(0, 0)
  siphash.write_u32(mut s, value)
  siphash.finish(s)
}

fn hash_strs(a: String, b: String) -> u64 uses {} {
  let mut s = siphash.new(0, 0)
  siphash.write_str(mut s, a)
  siphash.write_str(mut s, b)
  siphash.finish(s)
}

// A slice of i32 as Rust hashes it: its length, then each element.
fn write_slice(mut s: siphash.State, items: List[i32]) -> () uses {} {
  siphash.write_u64(mut s, list.len(items))
  for item in items {
    siphash.write_i32(mut s, item)
  }
}

fn hash_slices(a: List[i32], b: List[i32], c: List[i32]) -> u64 uses {} {
  let mut s = siphash.new(0, 0)
  write_slice(mut s, a)
  write_slice(mut s, b)
  write_slice(mut s, c)
  siphash.finish(s)
}

pub fn main(t: Test) -> Result[(), ()] {
  // test_siphash_1_3: one-shot, incremental one byte at a time, and split
  // into two writes that leave 1, 7 and half of the bytes in the first for
  // the lengths 1, 9, .. 57.
  let mut buf: List[u8] = []
  let mut incremental = siphash.new(K0, K1)
  let mut n: u64 = 0
  while n < 64 {
    let message = bytes.from_list(copy buf)
    test.equal(t, siphash.digest(K0, K1, message), VECTORS[n])
    test.equal(t, siphash.finish(incremental), VECTORS[n])
    let cuts: List[u64] = [1, 7, n / 2]
    for cut in cuts {
      if n % 8 == 1 && cut <= n {
        let mut split = siphash.new(K0, K1)
        siphash.write(mut split, bytes.slice(message, 0, cut))
        siphash.write(mut split, bytes.slice(message, cut, n))
        test.equal(t, siphash.finish(split), VECTORS[n])
      }
    }
    let byte: u8 = core@1/int.narrow(n)
    list.push(mut buf, byte)
    siphash.write_u8(mut incremental, byte)
    n += 1
  }
  // test_write_short_works, on SipHash-1-3.
  let mut h1 = siphash.new(0, 0)
  siphash.write_u64(mut h1, 0xd0c0b0a0)
  siphash.write(mut h1, b"bytes")
  siphash.write(mut h1, b"string")
  siphash.write_u8(mut h1, 0xffu8)
  siphash.write_u8(mut h1, 0x01u8)
  let mut h2 = siphash.new(0, 0)
  siphash.write(mut h2, b"\xa0\xb0\xc0\xd0\x00\x00\x00\x00")
  siphash.write(mut h2, b"bytes")
  siphash.write(mut h2, b"string")
  siphash.write(mut h2, b"\xff\x01")
  test.equal(t, siphash.finish(h1), siphash.finish(h2))
  // test_hash_idempotent
  test.equal(t, hash_u64(0xdeadbeefdeadbeef), hash_u64(0xdeadbeefdeadbeef))
  test.equal(t, hash_u32(0xdeadbeef), hash_u32(0xdeadbeef))
  // test_hash_no_bytes_dropped_64 and _32
  let val64: u64 = 0xdeadbeefdeadbeef
  let mut byte: u64 = 0
  while byte < 8 {
    test.check(t, hash_u64(val64) != hash_u64(val64 & ~(0xffu64 << byte * 8)))
    byte += 1
  }
  let val32: u32 = 0xdeadbeef
  byte = 0
  while byte < 4 {
    let shift: u32 = core@1/int.narrow(byte * 8)
    test.check(t, hash_u32(val32) != hash_u32(val32 & ~(0xffu32 << shift)))
    byte += 1
  }
  // test_hash_no_concat_alias
  test.check(t, hash_strs("aa", "bb") != hash_strs("aabb", ""))
  test.check(t, hash_strs("aa", "bb") != hash_strs("a", "abb"))
  test.check(t, hash_slices([1], [0, 0], [0]) != hash_slices([1, 0, 0, 0], [], []))
  Ok(())
}
