// rule: SEM-3
// expect: run
// Rust coretests/tests/num/flt2dec/mod.rs, f6c1107f8be13e48465e12c0fd26e6a39fe18e4f.
// MIT; third-party/NOTICES.md. Original check_exact/check_exact_one row lines below.
fn exact(t: Test, mantissa: u64, exponent: i32, expected: String, cutoff: i32) -> () {
  let mut actual = std@1/internal.big.big_from_word(mantissa)
  let scale: u64 = if exponent < 0 {
    core@1/int.narrow(-exponent)
  } else {
    0u64
  }
  std@1/internal.big.big_power(
    mut actual,
    if exponent < 0 {
      5u64
    } else {
      2u64
    },
    if exponent < 0 {
      scale
    } else {
      core@1/int.narrow(exponent)
    }
  )
  let decimal_scale: i32 = core@1/int.narrow(scale)
  let places = decimal_scale + cutoff
  if places >= 0 {
    std@1/internal.format.round_decimal(mut actual, core@1/int.narrow(places))
  } else {
    std@1/internal.big.big_power(mut actual, 10, core@1/int.narrow(-places))
  }
  let mut wanted = std@1/internal.big.big_from_word(0)
  let mut chunk: u64 = 0
  let mut power: u64 = 1
  for digit in core@1/string.as_bytes(expected) {
    chunk = chunk * 10 + core@1/int.widen(digit - 48u8)
    power *= 10
    if power == 1000000000 {
      std@1/internal.big.big_mul_word(mut wanted, power)
      std@1/internal.big.big_add_small(mut wanted, chunk)
      chunk = 0
      power = 1
    }
  }
  std@1/internal.big.big_mul_word(mut wanted, power)
  std@1/internal.big.big_add_small(mut wanted, chunk)
  test.check(t, std@1/internal.big.big_compare(actual, wanted, false) == 0)
}

pub fn main(t: Test) -> Result[(), ()] {
  // mod.rs:496: 8431154198732492p72f64; digits=4, decimal exponent=38.
  exact(t, 8431154198732492u64, 72i32, "3981", 34i32)
  // mod.rs:497: 6475049196144587p99f64; digits=5, decimal exponent=46.
  exact(t, 6475049196144587u64, 99i32, "41040", 41i32)
  // mod.rs:498: 8274307542972842p726f64; digits=6, decimal exponent=235.
  exact(t, 8274307542972842u64, 726i32, "292084", 229i32)
  // mod.rs:499: 5381065484265332p-456f64; digits=7, decimal exponent=-121.
  exact(t, 5381065484265332u64, -456i32, "2891946", -128i32)
  // mod.rs:500: 6761728585499734p-1057f64; digits=8, decimal exponent=-302.
  exact(t, 6761728585499734u64, -1057i32, "43787718", -310i32)
  // mod.rs:501: 7976538478610756p376f64; digits=9, decimal exponent=130.
  exact(t, 7976538478610756u64, 376i32, "122770163", 121i32)
  // mod.rs:502: 5982403858958067p377f64; digits=10, decimal exponent=130.
  exact(t, 5982403858958067u64, 377i32, "1841552452", 120i32)
  Ok(())
}
