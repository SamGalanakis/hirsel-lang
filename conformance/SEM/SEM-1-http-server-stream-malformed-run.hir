// rule: SEM-1
// expect: run
fn http_net(error: NetError) -> http.HttpError uses {} {
  Net(error)
}

fn exercise(t: Test, previous_head: bool) -> Result[(), http.HttpError] {
  let malformed = "GET / HTTP/1.0\r\nBad Header: x\r\n\r\n"
  let mut steps: List[NetStep] = []
  if previous_head {
    list.push(
      mut steps,
      Send(unique string.as_bytes(string.concat("HEAD / HTTP/1.1\r\n\r\n", malformed)))
    )
    list.push(mut steps, Expect(b"HTTP/1.1 200 \r\nConnection: keep-alive\r\n\r\n"))
  } else {
    list.push(mut steps, Send(unique string.as_bytes(malformed)))
  }
  list.push(mut steps, Expect(b"HTTP/1.0 400 \r\nConnection: close\r\n\r\nbad"))
  list.push(mut steps, Close())
  let n = test.net(
    t,
    [
      NetPeer(
        address: "example.com",
        port: 80u16,
        resolves_to: [],
        tls: Plain(),
        connections: [Open(take steps)]
      )
    ],
    []
  )
  let stream = net.connect(n, "example.com", 80u16, Unbounded()) ? http_net
  let mut c = http.server_connection(n, take stream, http.default_config())
  if previous_head {
    let request = http.receive_request(mut c, None())?
    test.check(t, request.method == "HEAD")
    http.respond_head(mut c, 200u16, [])?
    http.write_response_body(mut c, b"elided")?
    http.end_response_body(mut c)?
  }
  test.check(t, http.receive_request(mut c, None()) == Error(Malformed(HeaderName())))
  http.respond_head(mut c, 400u16, [])?
  http.write_response_body(mut c, b"bad")?
  http.end_response_body(mut c)?
  test.check(t, http.receive_request(mut c, None()) == Error(Closed()))
  Ok(())
}

pub fn main(t: Test) -> Result[(), http.HttpError] {
  exercise(t, false)?
  exercise(t, true)?
  Ok(())
}
