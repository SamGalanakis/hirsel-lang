// rule: SEM-1
// expect: run
fn http_net(error: NetError) -> http.HttpError uses {} {
  Net(error)
}

fn exercise(t: Test, previous_head: bool) -> Result[(), http.HttpError] {
  let malformed = "GET / HTTP/1.0\r\nBad Header: x\r\n\r\n"
  let mut steps: List[NetStep] = []
  if previous_head {
    list.push(
      mut steps,
      Send(unique string.as_bytes(string.concat("HEAD / HTTP/1.1\r\n\r\n", malformed)))
    )
    list.push(mut steps, Expect(b"HTTP/1.1 200 \r\nConnection: keep-alive\r\n\r\n"))
  } else {
    list.push(mut steps, Send(unique string.as_bytes(malformed)))
  }
  list.push(
    mut steps,
    Expect(
      b"HTTP/1.1 400 \r\nContent-Length: 11\r\nConnection: close\r\n\r\nBad Request"
    )
  )
  list.push(mut steps, Close())
  let n = test.net(
    t,
    [
      NetPeer(
        address: "example.com",
        port: 80u16,
        resolves_to: [],
        tls: Plain(),
        connections: [Open(take steps)]
      )
    ],
    []
  )
  let stream = net.connect(n, "example.com", 80u16, Unbounded()) ? http_net
  let mut c = http.server_connection(
    test.tasks(t),
    n,
    take stream,
    http.default_config()
  )
  if previous_head {
    let Some((current1, request)) = http.next_stream(mut c, None())? else {
      return Error(Closed())
    }
    let mut exchange1 = take current1
    test.check(t, request.method == "HEAD")
    http.respond_head(mut exchange1, 200u16, [])?
    http.write_response_body(mut exchange1, b"elided")?
    http.end_response_body(mut exchange1)?
  }
  test.check(
    t,
    match http.next_stream(mut c, None()) {
      Error(error) => error == Malformed(HeaderName()),
      _ => false,
    }
  )
  test.check(t, option.is_none(http.next_stream(mut c, None())?))
  Ok(())
}

pub fn main(t: Test) -> Result[(), http.HttpError] {
  exercise(t, false)?
  exercise(t, true)?
  Ok(())
}
