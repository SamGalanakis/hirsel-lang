// rule: SEM-2
// expect: run
// Rust std LowerExp supplies independent shortest digits and decimal parsing.
pub fn main(t: Test) -> Result[(), ()] {
  core@1/test.check(t, f32.to_string(core@1/f32.from_bits(0u32)) == "0")
  match f32.parse("0") {
    Ok(value) => core@1/test.check(t, core@1/f32.bits(value) == 0u32),
    Error(_) => core@1/test.check(t, false),
  }
  Ok(())
}
