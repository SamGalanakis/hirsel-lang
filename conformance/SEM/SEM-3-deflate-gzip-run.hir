// rule: SEM-3
// expect: run
// gzip (RFC 1952) encoding matches zlib 1.3 output (madler/zlib 09155ea) with OS 255 and no name or time: extra flags, stream, CRC-32 and size.
fn check(t: Test, actual: Bytes, expected: Bytes) -> () {
  test.check(t, actual == expected)
}

pub fn main(t: Test) -> Result[(), ()] {
  // repeated words, level 1
  check(
    t,
    flate.gzip_encode(b"hello hello hello hello world", 1),
    b"\x1f\x8b\x08\x00\x00\x00\x00\x00\x04\xff\xcbH\xcd\xc9\xc9W\xc8\xc0 \xcb\xf3\x8brR\x003e44\x1d\x00\x00\x00"
  )
  // repeated words, level 9
  check(
    t,
    flate.gzip_encode(b"hello hello hello hello world", 9),
    b"\x1f\x8b\x08\x00\x00\x00\x00\x00\x02\xff\xcbH\xcd\xc9\xc9W\xc8\xc0 \xcb\xf3\x8brR\x003e44\x1d\x00\x00\x00"
  )
  // empty, level 0
  check(
    t,
    flate.gzip_encode(b"", 0),
    b"\x1f\x8b\x08\x00\x00\x00\x00\x00\x04\xff\x01\x00\x00\xff\xff\x00\x00\x00\x00\x00\x00\x00\x00"
  )
  // huffman-text.in prefix (golang/go ebe2feef), level 6
  check(
    t,
    flate.gzip_encode(
      b"// Copyright 2009 The Go Authors. All rights reserved.\x0d\x0a// Use o",
      6
    ),
    b"\x1f\x8b\x08\x00\x00\x00\x00\x00\x00\xff\xd3\xd7Wp\xce/\xa8,\xcaL\xcf(Q020\xb0T\x08\xc9HUp\xcfWp,-\xc9\xc8/*\xd6Sp\xcc\xc9Q\x00K\x17+\x14\xa5\x16\xa7\x16\x95\xa5\xa6\xe8\xf1r\xe9\xeb+\x84\x16\xa7*\xe4\x03\x00\x01N\xbf6@\x00\x00\x00"
  )
  Ok(())
}
