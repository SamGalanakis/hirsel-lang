// rule: SEM-3
// expect: run
// Go hash/crc32 golden IEEE vectors, one-shot, hex and split around an empty update.
fn check(input: String, expected: u32) -> () {
  let data = string.as_bytes(input)
  failure.check(std@1/crc32.digest(data) == expected, TextInvariant())
  failure.check(std@1/crc32.digest_hex(data) == f"{expected:08x}", TextInvariant())
  let half = bytes.len(data) / 2
  let mut state = std@1/crc32.new()
  std@1/crc32.update(mut state, bytes.slice(data, 0, half))
  std@1/crc32.update(mut state, b"")
  std@1/crc32.update(mut state, bytes.slice(data, half, bytes.len(data)))
  failure.check(std@1/crc32.finish(take state) == expected, TextInvariant())
}

pub fn main() -> Result[(), ()] {
  check("", 0x00000000u32)
  check("a", 0xe8b7be43u32)
  check("ab", 0x9e83486du32)
  check("abc", 0x352441c2u32)
  check("abcd", 0xed82cd11u32)
  check("abcde", 0x8587d865u32)
  check("abcdef", 0x4b8e39efu32)
  check("abcdefg", 0x312a6aa6u32)
  check("abcdefgh", 0xaeef2a50u32)
  check("abcdefghi", 0x8da988afu32)
  check("abcdefghij", 0x3981703au32)
  check("Discard medicine more than two years old.", 0x6b9cdfe7u32)
  check("He who has a shady past knows that nice guys finish last.", 0xc90ef73fu32)
  check("I wouldn't marry him with a ten foot pole.", 0xb902341fu32)
  check("Free! Free!/A trip/to Mars/for 900/empty jars/Burma Shave", 0x042080e8u32)
  check("The days of the digital watch are numbered.  -Tom Stoppard", 0x154c6d11u32)
  check("Nepal premier won't resign.", 0x4c418325u32)
  check(
    "For every action there is an equal and opposite government program.",
    0x33955150u32
  )
  check("His money is twice tainted: 'taint yours and 'taint mine.", 0x26216a4bu32)
  check(
    "There is no reason for any individual to have a computer in their home. -Ken Olsen, 1977",
    0x1abbe45eu32
  )
  check(
    "It's a tiny change to the code and not completely disgusting. - Bob Manchek",
    0xc89a94f7u32
  )
  check("size:  a.out:  bad magic", 0xab3abe14u32)
  check("The major problem is with sendmail.  -Mark Horton", 0xbab102b6u32)
  check(
    "Give me a rock, paper and scissors and I will move the world.  CCFestoon",
    0x999149d7u32
  )
  check("If the enemy is within range, then so are you.", 0x6d52a33cu32)
  check(
    "It's well we cannot hear the screams/That we create in others' dreams.",
    0x90631e8du32
  )
  check(
    "You remind me of a TV show, but that's all right: I watch it anyway.",
    0x78309130u32
  )
  check("C is as portable as Stonehedge!!", 0x7d0a377fu32)
  check(
    "Even if I could be Shakespeare, I think I should still choose to be Faraday. - A. Huxley",
    0x8c79fd79u32
  )
  check(
    "The fugacity of a constituent in a mixture of gases at a given temperature is proportional to its mole fraction.  Lewis-Randall Rule",
    0xa20b7167u32
  )
  check("How can you write a big system without C++?  -Paul Glick", 0x8e0bb443u32)
  Ok(())
}
