// rule: SEM-3
// expect: run
// RFC 3986 §5.4, rfc3986.txt:1993-2063; 19 abnormal reference/target pairs.
pub fn main() -> Result[(), ()] {
  let Ok(base) = std@1/uri.parse("http://a/b/c/d;p?q") else {
    return Error(())
  }
  failure.check(
    std@1/uri.resolve(base, "../../../g") == Ok(
      std@1/uri.Uri(
        scheme: "http",
        user: None(),
        password: None(),
        host: Some(Encoded("a")),
        port: None(),
        path: Encoded("/g"),
        query: None(),
        fragment: None()
      )
    ),
    TextInvariant()
  )
  failure.check(
    std@1/uri.resolve(base, "../../../../g") == Ok(
      std@1/uri.Uri(
        scheme: "http",
        user: None(),
        password: None(),
        host: Some(Encoded("a")),
        port: None(),
        path: Encoded("/g"),
        query: None(),
        fragment: None()
      )
    ),
    TextInvariant()
  )
  failure.check(
    std@1/uri.resolve(base, "/./g") == Ok(
      std@1/uri.Uri(
        scheme: "http",
        user: None(),
        password: None(),
        host: Some(Encoded("a")),
        port: None(),
        path: Encoded("/g"),
        query: None(),
        fragment: None()
      )
    ),
    TextInvariant()
  )
  failure.check(
    std@1/uri.resolve(base, "/../g") == Ok(
      std@1/uri.Uri(
        scheme: "http",
        user: None(),
        password: None(),
        host: Some(Encoded("a")),
        port: None(),
        path: Encoded("/g"),
        query: None(),
        fragment: None()
      )
    ),
    TextInvariant()
  )
  failure.check(
    std@1/uri.resolve(base, "g.") == Ok(
      std@1/uri.Uri(
        scheme: "http",
        user: None(),
        password: None(),
        host: Some(Encoded("a")),
        port: None(),
        path: Encoded("/b/c/g."),
        query: None(),
        fragment: None()
      )
    ),
    TextInvariant()
  )
  failure.check(
    std@1/uri.resolve(base, ".g") == Ok(
      std@1/uri.Uri(
        scheme: "http",
        user: None(),
        password: None(),
        host: Some(Encoded("a")),
        port: None(),
        path: Encoded("/b/c/.g"),
        query: None(),
        fragment: None()
      )
    ),
    TextInvariant()
  )
  failure.check(
    std@1/uri.resolve(base, "g..") == Ok(
      std@1/uri.Uri(
        scheme: "http",
        user: None(),
        password: None(),
        host: Some(Encoded("a")),
        port: None(),
        path: Encoded("/b/c/g.."),
        query: None(),
        fragment: None()
      )
    ),
    TextInvariant()
  )
  failure.check(
    std@1/uri.resolve(base, "..g") == Ok(
      std@1/uri.Uri(
        scheme: "http",
        user: None(),
        password: None(),
        host: Some(Encoded("a")),
        port: None(),
        path: Encoded("/b/c/..g"),
        query: None(),
        fragment: None()
      )
    ),
    TextInvariant()
  )
  failure.check(
    std@1/uri.resolve(base, "./../g") == Ok(
      std@1/uri.Uri(
        scheme: "http",
        user: None(),
        password: None(),
        host: Some(Encoded("a")),
        port: None(),
        path: Encoded("/b/g"),
        query: None(),
        fragment: None()
      )
    ),
    TextInvariant()
  )
  failure.check(
    std@1/uri.resolve(base, "./g/.") == Ok(
      std@1/uri.Uri(
        scheme: "http",
        user: None(),
        password: None(),
        host: Some(Encoded("a")),
        port: None(),
        path: Encoded("/b/c/g/"),
        query: None(),
        fragment: None()
      )
    ),
    TextInvariant()
  )
  failure.check(
    std@1/uri.resolve(base, "g/./h") == Ok(
      std@1/uri.Uri(
        scheme: "http",
        user: None(),
        password: None(),
        host: Some(Encoded("a")),
        port: None(),
        path: Encoded("/b/c/g/h"),
        query: None(),
        fragment: None()
      )
    ),
    TextInvariant()
  )
  failure.check(
    std@1/uri.resolve(base, "g/../h") == Ok(
      std@1/uri.Uri(
        scheme: "http",
        user: None(),
        password: None(),
        host: Some(Encoded("a")),
        port: None(),
        path: Encoded("/b/c/h"),
        query: None(),
        fragment: None()
      )
    ),
    TextInvariant()
  )
  failure.check(
    std@1/uri.resolve(base, "g;x=1/./y") == Ok(
      std@1/uri.Uri(
        scheme: "http",
        user: None(),
        password: None(),
        host: Some(Encoded("a")),
        port: None(),
        path: Encoded("/b/c/g;x=1/y"),
        query: None(),
        fragment: None()
      )
    ),
    TextInvariant()
  )
  failure.check(
    std@1/uri.resolve(base, "g;x=1/../y") == Ok(
      std@1/uri.Uri(
        scheme: "http",
        user: None(),
        password: None(),
        host: Some(Encoded("a")),
        port: None(),
        path: Encoded("/b/c/y"),
        query: None(),
        fragment: None()
      )
    ),
    TextInvariant()
  )
  failure.check(
    std@1/uri.resolve(base, "g?y/./x") == Ok(
      std@1/uri.Uri(
        scheme: "http",
        user: None(),
        password: None(),
        host: Some(Encoded("a")),
        port: None(),
        path: Encoded("/b/c/g"),
        query: Some(Encoded("y/./x")),
        fragment: None()
      )
    ),
    TextInvariant()
  )
  failure.check(
    std@1/uri.resolve(base, "g?y/../x") == Ok(
      std@1/uri.Uri(
        scheme: "http",
        user: None(),
        password: None(),
        host: Some(Encoded("a")),
        port: None(),
        path: Encoded("/b/c/g"),
        query: Some(Encoded("y/../x")),
        fragment: None()
      )
    ),
    TextInvariant()
  )
  failure.check(
    std@1/uri.resolve(base, "g#s/./x") == Ok(
      std@1/uri.Uri(
        scheme: "http",
        user: None(),
        password: None(),
        host: Some(Encoded("a")),
        port: None(),
        path: Encoded("/b/c/g"),
        query: None(),
        fragment: Some(Encoded("s/./x"))
      )
    ),
    TextInvariant()
  )
  failure.check(
    std@1/uri.resolve(base, "g#s/../x") == Ok(
      std@1/uri.Uri(
        scheme: "http",
        user: None(),
        password: None(),
        host: Some(Encoded("a")),
        port: None(),
        path: Encoded("/b/c/g"),
        query: None(),
        fragment: Some(Encoded("s/../x"))
      )
    ),
    TextInvariant()
  )
  failure.check(
    std@1/uri.resolve(base, "http:g") == Ok(
      std@1/uri.Uri(
        scheme: "http",
        user: None(),
        password: None(),
        host: None(),
        port: None(),
        path: Encoded("g"),
        query: None(),
        fragment: None()
      )
    ),
    TextInvariant()
  )
  Ok(())
}
