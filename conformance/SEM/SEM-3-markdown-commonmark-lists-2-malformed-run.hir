// rule: SEM-3
// expect: run
// Published spec.txt vectors; tools/generate-markdown.py.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.check(
    s,
    "commonmark/Lists/305/malformed",
    "The number of windows in my house\u{0}[&unterminated",
    "<p>The number of windows in my house�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Lists/306/malformed",
    "- foo\n\n- b\u{0}[&unterminated",
    "<ul>\n<li>\n<p>foo</p>\n</li>\n<li>\n<p>b�[&amp;unterminated</p>\n</li>\n</ul>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Lists/307/malformed",
    "- foo\n  - bar\n    \u{0}[&unterminated",
    "<ul>\n<li>foo\n<ul>\n<li>bar\n�[&amp;unterminated</li>\n</ul>\n</li>\n</ul>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Lists/308/malformed",
    "- foo\n- bar\n\n<!--\u{0}[&unterminated",
    "<ul>\n<li>foo</li>\n<li>bar</li>\n</ul>\n<!--�[&unterminated\n",
    std@1/markdown.default_options()
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
