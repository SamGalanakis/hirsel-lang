// Generated by tools/generate-toml-test.py from toml-test ff49d109861c
// tests/files-toml-1.1.0, group valid-misc.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.valid(s, "valid/empty-crlf", "\r\n", "{}")
  failed += harness.valid(s, "valid/empty-lf", "\n", "{}")
  failed += harness.valid(s, "valid/empty-nothing", "", "{}")
  failed += harness.valid(s, "valid/empty-space", " ", "{}")
  failed += harness.valid(s, "valid/empty-tab", "\t", "{}")
  failed += harness.valid(
    s,
    "valid/example",
    "best-day-ever = 1987-07-05T17:45:00Z\n\n[numtheory]\nboring = false\nperfection = [6, 28, 496]\n",
    "{\"best-day-ever\":{\"type\":\"datetime\",\"value\":\"1987-07-05T17:45:00Z\"},\"numtheory\":{\"boring\":{\"type\":\"bool\",\"value\":\"false\"},\"perfection\":[{\"type\":\"integer\",\"value\":\"6\"},{\"type\":\"integer\",\"value\":\"28\"},{\"type\":\"integer\",\"value\":\"496\"}]}}"
  )
  failed += harness.valid(
    s,
    "valid/implicit-and-explicit-after",
    "[a.b.c]\nanswer = 42\n\n[a]\nbetter = 43\n",
    "{\"a\":{\"better\":{\"type\":\"integer\",\"value\":\"43\"},\"b\":{\"c\":{\"answer\":{\"type\":\"integer\",\"value\":\"42\"}}}}}"
  )
  failed += harness.valid(
    s,
    "valid/implicit-and-explicit-before",
    "[a]\nbetter = 43\n\n[a.b.c]\nanswer = 42\n",
    "{\"a\":{\"better\":{\"type\":\"integer\",\"value\":\"43\"},\"b\":{\"c\":{\"answer\":{\"type\":\"integer\",\"value\":\"42\"}}}}}"
  )
  failed += harness.valid(
    s,
    "valid/implicit-groups",
    "[a.b.c]\nanswer = 42\n",
    "{\"a\":{\"b\":{\"c\":{\"answer\":{\"type\":\"integer\",\"value\":\"42\"}}}}}"
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
