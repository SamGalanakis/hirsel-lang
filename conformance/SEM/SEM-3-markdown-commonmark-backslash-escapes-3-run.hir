// rule: SEM-3
// expect: run
// Published spec.txt vectors; tools/generate-markdown.py.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.check(
    s,
    "commonmark/Backslash escapes/16",
    "foo\\\nbar\n",
    "<p>foo<br />\nbar</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Backslash escapes/17",
    "`` \\[\\` ``\n",
    "<p><code>\\[\\`</code></p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Backslash escapes/18",
    "    \\[\\]\n",
    "<pre><code>\\[\\]\n</code></pre>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Backslash escapes/19",
    "~~~\n\\[\\]\n~~~\n",
    "<pre><code>\\[\\]\n</code></pre>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Backslash escapes/20",
    "<https://example.com?find=\\*>\n",
    "<p><a href=\"https://example.com?find=%5C*\">https://example.com?find=\\*</a></p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Backslash escapes/21",
    "<a href=\"/bar\\/)\">\n",
    "<a href=\"/bar\\/)\">\n",
    std@1/markdown.default_options()
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
