// rule: SEM-3
// expect: run
// Published spec.txt vectors; tools/generate-markdown.py.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.check(
    s,
    "commonmark/Backslash escapes/22",
    "[foo](/bar\\* \"ti\\*tle\")\n",
    "<p><a href=\"/bar*\" title=\"ti*tle\">foo</a></p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Backslash escapes/23",
    "[foo]\n\n[foo]: /bar\\* \"ti\\*tle\"\n",
    "<p><a href=\"/bar*\" title=\"ti*tle\">foo</a></p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Backslash escapes/24",
    "``` foo\\+bar\nfoo\n```\n",
    "<pre><code class=\"language-foo+bar\">foo\n</code></pre>\n",
    std@1/markdown.default_options()
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
