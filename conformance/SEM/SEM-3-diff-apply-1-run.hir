      "f2\nk86\nh2\ne1\na1\nc0\ne1\ne2\nf0\nb1\ne0\nh0\nc2\nc1\nf0\nf1\nc2\nb1\nx0\na2\ng0\nc0\nh2\ne2\ne1\ne2\nb2\nh0\nd2\nd1\na1\ne2\nd0\nz1\nd1\ne0\nf0\nb1\nc2\ne2\nb2\ne0\n",
      [0u64]
    ),
    (
      "d0\na1\nc0\ne1\ne0\nc0\nf2\nc0\nc1\na1\nb2\nc2\nf1\na0\nf0\nb0\na0\ng1\nc0\nh2\ng2\nk23\nh1\nc1\nd1\nc1\nc1\nf2\nb0\nc0\nd0\nf1\nd0\nd2\nd2\na1\nh2\nb2\nb1\nj20\na0\n",
      "--- old\n+++ new\n@@ -2,3 +2,3 @@\n a1\n-c0\n+b0\n e1\n@@ -10,2 +10,3 @@\n a1\n+c1\n b2\n@@ -13,6 +14,5 @@\n f1\n-a0\n+x2\n f0\n b0\n-a0\n g1\n@@ -26,2 +26,3 @@\n c1\n+x2\n c1\n@@ -29,7 +30,7 @@\n b0\n-c0\n d0\n f1\n+c2\n d0\n-d2\n+a1\n d2\n@@ -40 +41,3 @@\n a0\n+c1\n+z2\n",
