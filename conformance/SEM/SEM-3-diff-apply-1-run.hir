      []
    ),
    (
      "f0\nk87\nf0\nf1\nf2\ng2\nc0\ng1\ne0\nd2\na0\nf1\nh1\ne0\nd2\ne2\ng0\nd2\nj15\nd2\nh0\ng1\na2\ne0\nb1\nh2\ng2\na0\nj38\nf1\nf1\nb0\nd1\ne1\nc1\nb2\na2\ne2\na2\nc0\ng1\ng2\n",
      "--- old\n+++ new\n@@ -3 +3 @@\n-f0\n+a0\n@@ -12 +11,0 @@\n-f1\n@@ -15,2 +14 @@\n-d2\n-e2\n+b2\n@@ -20,0 +19 @@\n+c2\n@@ -22 +21,2 @@\n-a2\n+y1\n+z1\n@@ -29 +28,0 @@\n-f1\n@@ -36,2 +35 @@\n-e2\n-a2\n+b2\n",
      "f0\nk87\na0\nf1\nf2\ng2\nc0\ng1\ne0\nd2\na0\nh1\ne0\nb2\ng0\nd2\nj15\nd2\nc2\nh0\ng1\ny1\nz1\ne0\nb1\nh2\ng2\na0\nj38\nf1\nb0\nd1\ne1\nc1\nb2\na2\nb2\nc0\ng1\ng2\n",
      []
    ),
