      "--- old\n+++ new\n@@ -2,4 +2,5 @@\n b0\n+y2\n h2\n-e1\n+x1\n a1\n@@ -12,2 +13,3 @@\n h0\n+c2\n c1\n@@ -17,5 +19,6 @@\n b1\n+x0\n a2\n g0\n-f1\n+c0\n h2\n@@ -25,3 +28,2 @@\n b2\n-c1\n h0\n@@ -32,2 +34,3 @@\n d0\n+z1\n d1\n@@ -35,3 +38,3 @@\n f0\n-g2\n+b1\n c2\n",
      "f2\nb0\ny2\nh2\nx1\na1\nc0\ne1\ne2\nf0\nb1\ne0\nh0\nc2\nc1\nj32\nf0\nf1\nc2\nb1\nx0\na2\ng0\nc0\nh2\ne2\ne1\ne2\nb2\nh0\nd2\nd1\na1\ne2\nd0\nz1\nd1\ne0\nf0\nb1\nc2\ne2\nb2\ne0\n",
      []
    )
  ]
}

pub fn main(t: Test) -> Result[(), diff.PatchError] {
  let mut case: u64 = 53
  for (source, patch, expected, rejected) in patched() {
    let applied = diff.apply(source, patch)?
    test.check_case(t, applied.text == expected && applied.rejected == rejected, case)
    case += 1
  }
  Ok(())
}
