      "a1\nd2\nd1\nj64\nb0\ng1\na1\nd2\nd2\nh1\nd0\nh1\nc0\nj0\nf2\na0\nh2\na1\nb2\nj27\nd1\ng1\nf0\nh0\ng2\ng2\ng2\nh0\na0\nk0\ne0\nb0\nh0\nf0\ng1\nb1\nc0\ng0\ng0\ng0\nd2\ng2\ng2\n",
