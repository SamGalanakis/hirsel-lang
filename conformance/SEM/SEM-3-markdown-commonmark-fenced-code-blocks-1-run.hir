// rule: SEM-3
// expect: run
// Published spec.txt vectors; tools/generate-markdown.py.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.check(
    s,
    "commonmark/Fenced code blocks/119",
    "```\n<\n >\n```\n",
    "<pre><code>&lt;\n &gt;\n</code></pre>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Fenced code blocks/120",
    "~~~\n<\n >\n~~~\n",
    "<pre><code>&lt;\n &gt;\n</code></pre>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Fenced code blocks/121",
    "``\nfoo\n``\n",
    "<p><code>foo</code></p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Fenced code blocks/122",
    "```\naaa\n~~~\n```\n",
    "<pre><code>aaa\n~~~\n</code></pre>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Fenced code blocks/123",
    "~~~\naaa\n```\n~~~\n",
    "<pre><code>aaa\n```\n</code></pre>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Fenced code blocks/124",
    "````\naaa\n```\n``````\n",
    "<pre><code>aaa\n```\n</code></pre>\n",
    std@1/markdown.default_options()
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
