// rule: SEM-3
// expect: run
// Published spec.txt vectors; tools/generate-markdown.py.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.check(
    s,
    "commonmark/HTML blocks/155",
    "<div>\n*foo*\n\n*bar*\n",
    "<div>\n*foo*\n<p><em>bar</em></p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/HTML blocks/156",
    "<div id=\"foo\"\n*hi*\n",
    "<div id=\"foo\"\n*hi*\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/HTML blocks/157",
    "<div class\nfoo\n",
    "<div class\nfoo\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/HTML blocks/158",
    "<div *???-&&&-<---\n*foo*\n",
    "<div *???-&&&-<---\n*foo*\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/HTML blocks/159",
    "<div><a href=\"bar\">*foo*</a></div>\n",
    "<div><a href=\"bar\">*foo*</a></div>\n",
    std@1/markdown.default_options()
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
