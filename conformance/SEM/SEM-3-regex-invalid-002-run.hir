fn invalid(pattern: String, size_error: bool) {
  failure.check(
    match regex.compile(pattern, 1000) {
      Error(Syntax(_)) => !size_error,
      Error(ProgramTooLarge()) => size_error,
      _ => false,
    },
    TextInvariant()
  )
}

pub fn main() -> Result[(), ()] {
  // src/regexp/syntax/parse_test.go:501
  invalid("a{100000}", true)
  // src/regexp/syntax/parse_test.go:502
  invalid("a{100000,}", true)
  // src/regexp/syntax/parse_test.go:503
  invalid("((((((((((x{2}){2}){2}){2}){2}){2}){2}){2}){2}){2})", true)
  Ok(())
}
