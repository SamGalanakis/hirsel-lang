// rule: SEM-3
// expect: run
// Go ebe2feef capture/flag/replacement vectors (BSD-3-Clause).
// RE2 data Copyright 2009 The RE2 Authors (BSD-3-Clause).
fn check(pattern: String, input: String, maximum: u64, expected: List[regex.Captures]) -> Result[
  (),
  ()
] {
  let Ok(re) = regex.compile(pattern, 10000) else {
    return Error(())
  }
  failure.check(
    regex.find_all_captures(re, input, maximum, 1000000) == Ok(expected),
    TextInvariant()
  )
  if maximum != 0 {
    let first: Option[regex.Captures] = if list.len(expected) == 0 {
      None()
    } else {
      Some(copy expected[0])
    }
    failure.check(regex.find_captures(re, input, 1000000) == Ok(first), TextInvariant())
  }
  Ok(())
}

pub fn main() -> Result[(), ()] {
  // Go find_test.go:46
  check(
    "^",
    "abcde",
    18446744073709551615,
    [regex.Captures(spans: [Some(regex.Span(start: 0, end: 0))])]
  )?
  // Go find_test.go:47
  check(
    "$",
    "abcde",
    18446744073709551615,
    [regex.Captures(spans: [Some(regex.Span(start: 5, end: 5))])]
  )?
  // Go find_test.go:48
  check(
    "^abcd$",
    "abcd",
    18446744073709551615,
    [regex.Captures(spans: [Some(regex.Span(start: 0, end: 4))])]
  )?
  // Go find_test.go:49
  check("^bcd'", "abcdef", 18446744073709551615, [])?
  // Go find_test.go:50
  check("^abcd$", "abcde", 18446744073709551615, [])?
  // Go find_test.go:51
  check(
    "a+",
    "baaab",
    18446744073709551615,
    [regex.Captures(spans: [Some(regex.Span(start: 1, end: 4))])]
  )?
  // Go find_test.go:52
  check(
    "a*",
    "baaab",
    18446744073709551615,
    [
      regex.Captures(spans: [Some(regex.Span(start: 0, end: 0))]),
      regex.Captures(spans: [Some(regex.Span(start: 1, end: 4))]),
      regex.Captures(spans: [Some(regex.Span(start: 5, end: 5))])
    ]
  )?
  // Go find_test.go:53
  check(
    "[a-z]+",
    "abcd",
    18446744073709551615,
    [regex.Captures(spans: [Some(regex.Span(start: 0, end: 4))])]
  )?
  Ok(())
}
