// rule: SEM-3
// expect: run
// Rust alloctests/tests/str.rs:86-100: every scalar-aligned substring,
// first occurrence <= i and last occurrence >= i; exact offsets from Rust semantics.
@noalloc
fn offset(s: String, pat: String, reverse: bool) -> Option[u64] uses {} {
  let found = if reverse {
    string.rfind(s, pat)
  } else {
    string.find(s, pat)
  }
  match found {
    Some(at) => Some(core@1/string.byte_offset(s, at)),
    None() => None(),
  }
}

pub fn main() -> Result[(), ()] {
  failure.check(
    offset("Việt Namacbaabcaabaaba", "baa", false) == Some(12u64),
    TextInvariant()
  )
  failure.check(
    offset("Việt Namacbaabcaabaaba", "baa", true) == Some(19u64),
    TextInvariant()
  )
  failure.check(
    offset("Việt Namacbaabcaabaaba", "baab", false) == Some(12u64),
    TextInvariant()
  )
  failure.check(
    offset("Việt Namacbaabcaabaaba", "baab", true) == Some(19u64),
    TextInvariant()
  )
  failure.check(
    offset("Việt Namacbaabcaabaaba", "baaba", false) == Some(19u64),
    TextInvariant()
  )
  failure.check(
    offset("Việt Namacbaabcaabaaba", "baaba", true) == Some(19u64),
    TextInvariant()
  )
  failure.check(
    offset("Việt Namacbaabcaabaaba", "a", false) == Some(8u64),
    TextInvariant()
  )
  failure.check(
    offset("Việt Namacbaabcaabaaba", "a", true) == Some(23u64),
    TextInvariant()
  )
  failure.check(
    offset("Việt Namacbaabcaabaaba", "aa", false) == Some(13u64),
    TextInvariant()
  )
  failure.check(
    offset("Việt Namacbaabcaabaaba", "aa", true) == Some(20u64),
    TextInvariant()
  )
  failure.check(
    offset("Việt Namacbaabcaabaaba", "aab", false) == Some(13u64),
    TextInvariant()
  )
  failure.check(
    offset("Việt Namacbaabcaabaaba", "aab", true) == Some(20u64),
    TextInvariant()
  )
  failure.check(
    offset("Việt Namacbaabcaabaaba", "aaba", false) == Some(17u64),
    TextInvariant()
  )
  failure.check(
    offset("Việt Namacbaabcaabaaba", "aaba", true) == Some(20u64),
    TextInvariant()
  )
  failure.check(
    offset("Việt Namacbaabcaabaaba", "a", false) == Some(8u64),
    TextInvariant()
  )
  failure.check(
    offset("Việt Namacbaabcaabaaba", "a", true) == Some(23u64),
    TextInvariant()
  )
  failure.check(
    offset("Việt Namacbaabcaabaaba", "ab", false) == Some(14u64),
    TextInvariant()
  )
  failure.check(
    offset("Việt Namacbaabcaabaaba", "ab", true) == Some(21u64),
    TextInvariant()
  )
  failure.check(
    offset("Việt Namacbaabcaabaaba", "aba", false) == Some(18u64),
    TextInvariant()
  )
  failure.check(
    offset("Việt Namacbaabcaabaaba", "aba", true) == Some(21u64),
    TextInvariant()
  )
  failure.check(
    offset("Việt Namacbaabcaabaaba", "b", false) == Some(12u64),
    TextInvariant()
  )
  failure.check(
    offset("Việt Namacbaabcaabaaba", "b", true) == Some(22u64),
    TextInvariant()
  )
  failure.check(
    offset("Việt Namacbaabcaabaaba", "ba", false) == Some(12u64),
    TextInvariant()
  )
  failure.check(
    offset("Việt Namacbaabcaabaaba", "ba", true) == Some(22u64),
    TextInvariant()
  )
  failure.check(
    offset("Việt Namacbaabcaabaaba", "a", false) == Some(8u64),
