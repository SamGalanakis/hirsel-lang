// rule: SEM-3
// expect: run
// Published spec.txt vectors; tools/generate-markdown.py.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.check(
    s,
    "commonmark/Entity and numeric character references/25/malformed",
    "&nbsp; &amp; &copy; &AElig; &Dcaron;\n&frac34; &HilbertS\u{0}[&unterminated",
    "<p>  &amp; © Æ Ď\n¾ &amp;HilbertS�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Entity and numeric character references/26/malformed",
    "&#35; &#1234;\u{0}[&unterminated",
    "<p># Ӓ�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Entity and numeric character references/27/malformed",
    "&#X22; &#XD\u{0}[&unterminated",
    "<p>&quot; &amp;#XD�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
