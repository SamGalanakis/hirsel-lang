  {
    let Ok(parsed_uri) = std@1/uri.parse("scheme://[fe80::1ff:fe23:4567:890a%25eth2]") else {
      return Error(())
    }
    failure.check(
      parsed_uri.host == Some(Encoded("[fe80::1ff:fe23:4567:890a%25eth2]")),
      TextInvariant()
