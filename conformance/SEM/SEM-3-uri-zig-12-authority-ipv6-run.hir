      return Error(())
    }
    failure.check(
      parsed_uri.host == Some(Encoded("[0:0:0:0:0:0:0:1]")),
      TextInvariant()
    )
  }
  {
    let Ok(parsed_uri) = std@1/uri.parse("scheme://[::1]") else {
      return Error(())
