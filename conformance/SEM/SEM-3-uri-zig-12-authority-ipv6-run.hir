// rule: SEM-3
// expect: run
// Zig Uri.zig:692-708, authority.IPv6 (bff490a2, MIT).
pub fn main() -> Result[(), ()] {
  {
    let Ok(parsed_uri) = std@1/uri.parse("scheme://[2001:db8:0:0:0:0:2:1]") else {
      return Error(())
    }
    failure.check(
      parsed_uri.host == Some(Encoded("[2001:db8:0:0:0:0:2:1]")),
      TextInvariant()
    )
  }
  {
    let Ok(parsed_uri) = std@1/uri.parse("scheme://[2001:db8::2:1]") else {
