// rule: SEM-3
// expect: run
// Published spec.txt vectors; tools/generate-markdown.py.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.check(
    s,
    "commonmark/Links/517",
    "[![moon](moon.jpg)](/uri)\n",
    "<p><a href=\"/uri\"><img src=\"moon.jpg\" alt=\"moon\" /></a></p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Links/518",
    "[foo [bar](/uri)](/uri)\n",
    "<p>[foo <a href=\"/uri\">bar</a>](/uri)</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Links/519",
    "[foo *[bar [baz](/uri)](/uri)*](/uri)\n",
    "<p>[foo <em>[bar <a href=\"/uri\">baz</a>](/uri)</em>](/uri)</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Links/520",
    "![[[foo](uri1)](uri2)](uri3)\n",
    "<p><img src=\"uri3\" alt=\"[foo](uri2)\" /></p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Links/521",
    "*[foo*](/uri)\n",
    "<p>*<a href=\"/uri\">foo*</a></p>\n",
    std@1/markdown.default_options()
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
