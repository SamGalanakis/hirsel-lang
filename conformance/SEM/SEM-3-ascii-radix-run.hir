// rule: SEM-3
// expect: run
// Zig ASCII radix boundaries and shared codec/parser regression controls.
pub fn main() -> Result[(), ()] {
  failure.check(std@1/ascii.digit_value('9') == Some(9u32), TextInvariant())
  failure.check(std@1/ascii.digit_value('a') == None(), TextInvariant())
  failure.check(std@1/ascii.digit_value_radix('0', 2) == Some(0u32), TextInvariant())
  failure.check(std@1/ascii.digit_value_radix('1', 2) == Some(1u32), TextInvariant())
  failure.check(std@1/ascii.digit_value_radix('2', 2) == None(), TextInvariant())
  failure.check(std@1/ascii.digit_value_radix('9', 10) == Some(9u32), TextInvariant())
  failure.check(std@1/ascii.digit_value_radix('a', 10) == None(), TextInvariant())
  failure.check(std@1/ascii.digit_value_radix('A', 11) == Some(10u32), TextInvariant())
  failure.check(std@1/ascii.digit_value_radix('f', 16) == Some(15u32), TextInvariant())
  failure.check(std@1/ascii.digit_value_radix('F', 16) == Some(15u32), TextInvariant())
  failure.check(std@1/ascii.digit_value_radix('g', 16) == None(), TextInvariant())
  failure.check(std@1/ascii.digit_value_radix('z', 35) == None(), TextInvariant())
  failure.check(std@1/ascii.digit_value_radix('Z', 36) == Some(35u32), TextInvariant())
  failure.check(std@1/ascii.digit_value_radix('z', 36) == Some(35u32), TextInvariant())
  failure.check(std@1/ascii.digit_value_radix('0', 0) == None(), TextInvariant())
  failure.check(std@1/ascii.digit_value_radix('0', 1) == None(), TextInvariant())
  failure.check(std@1/ascii.digit_value_radix('0', 37) == None(), TextInvariant())
  failure.check(std@1/ascii.digit_value_radix('0', 255) == None(), TextInvariant())
  let rejected: List[u32] = [
    '/',
    ':',
    '@',
    '[',
    '`',
    '{',
    'é',
    '９',
    0xd800u32,
    0x110000u32,
    0xffffffffu32
  ]
  for cp in rejected {
    failure.check(std@1/ascii.digit_value_radix(cp, 36) == None(), TextInvariant())
  }
  failure.check(std@1/ascii.is_space('\u{b}'), TextInvariant())
  failure.check(
    string.split_ascii_whitespace("a\u{b}b") == ["a\u{b}b"],
    TextInvariant()
  )
  failure.check(string.trim("\u{b}a\u{b}") == "a", TextInvariant())
  failure.check(string.ascii_lower("ÉAbC") == "Éabc", TextInvariant())
  let mut all: List[u8] = []
  for cp in 0u32..256u32 {
    list.push(mut all, int.narrow(cp))
  }
  let data = bytes.from_list(take all)
  let encoded = std@1/hex.encode(data)
  failure.check(
    encoded == "",
    TextInvariant()
  )
  failure.check(std@1/hex.decode(encoded) == Ok(copy data), TextInvariant())
  failure.check(
    std@1/hex.decode(string.ascii_upper(encoded)) == Ok(copy data),
    TextInvariant()
  )
  match std@1/json.parse("-1.2e+3") {
    Ok(Number(value)) => failure.check(value == "-1.2e+3", TextInvariant()),
    _ => failure.check(false, TextInvariant()),
  }
  match std@1/json.parse("\"\\u00Af\"") {
    Ok(Text(value)) => failure.check(value == "¯", TextInvariant()),
    _ => failure.check(false, TextInvariant()),
  }
  failure.check(std@1/uri.percent_decode("%+f%-0%2F") == b"\x0f\x00/", TextInvariant())
  failure.check(std@1/net.ends_in_number("0xFf"), TextInvariant())
  failure.check(!std@1/net.ends_in_number("0xg"), TextInvariant())
  failure.check(std@1/net.validate_host("A-b.Example.") == Ok(()), TextInvariant())
  match std@1/net.parse_ipv6("2001:db8::1") {
    Ok(_) => (),
    Error(_) => failure.check(false, TextInvariant()),
  }
  match std@1/uri.parse("https://example.test:+080/path") {
    Ok(_) => (),
    Error(_) => failure.check(false, TextInvariant()),
  }
  failure.check(std@1/u8.parse_radix("ff", 16) == Ok(255u8), TextInvariant())
  failure.check(std@1/u8.parse_radix("100", 16) == Error(OutOfRange), TextInvariant())
  failure.check(std@1/u8.parse_radix("100g", 16) == Error(Invalid), TextInvariant())
  failure.check(std@1/u8.parse_radix("-1", 16) == Error(Invalid), TextInvariant())
  failure.check(std@1/i8.parse_radix("-80", 16) == Ok(-128i8), TextInvariant())
  Ok(())
}
