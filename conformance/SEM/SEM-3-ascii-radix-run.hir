// rule: SEM-3
// expect: run
// Zig ASCII radix boundaries and shared codec/parser regression controls.
pub fn main() -> Result[(), ()] {
  failure.check(std@1/ascii.digit_value(b'9') == Some(9u8), TextInvariant())
  failure.check(std@1/ascii.digit_value(b'a') == None(), TextInvariant())
  failure.check(std@1/ascii.digit_value_radix(b'0', 2) == Some(0u8), TextInvariant())
  failure.check(std@1/ascii.digit_value_radix(b'1', 2) == Some(1u8), TextInvariant())
  failure.check(std@1/ascii.digit_value_radix(b'2', 2) == None(), TextInvariant())
  failure.check(std@1/ascii.digit_value_radix(b'9', 10) == Some(9u8), TextInvariant())
  failure.check(std@1/ascii.digit_value_radix(b'a', 10) == None(), TextInvariant())
  failure.check(std@1/ascii.digit_value_radix(b'A', 11) == Some(10u8), TextInvariant())
  failure.check(std@1/ascii.digit_value_radix(b'f', 16) == Some(15u8), TextInvariant())
  failure.check(std@1/ascii.digit_value_radix(b'F', 16) == Some(15u8), TextInvariant())
  failure.check(std@1/ascii.digit_value_radix(b'g', 16) == None(), TextInvariant())
  failure.check(std@1/ascii.digit_value_radix(b'z', 35) == None(), TextInvariant())
  failure.check(std@1/ascii.digit_value_radix(b'Z', 36) == Some(35u8), TextInvariant())
  failure.check(std@1/ascii.digit_value_radix(b'z', 36) == Some(35u8), TextInvariant())
  failure.check(std@1/ascii.digit_value_radix(b'0', 0) == None(), TextInvariant())
  failure.check(std@1/ascii.digit_value_radix(b'0', 1) == None(), TextInvariant())
  failure.check(std@1/ascii.digit_value_radix(b'0', 37) == None(), TextInvariant())
  failure.check(std@1/ascii.digit_value_radix(b'0', 255) == None(), TextInvariant())
  let rejected: List[u8] = [b'/', b':', b'@', b'[', b'`', b'{', 0x80, 0xc3, 0xff]
  for cp in rejected {
    failure.check(std@1/ascii.digit_value_radix(cp, 36) == None(), TextInvariant())
  }
  failure.check(std@1/ascii.is_space(b'\x0b'), TextInvariant())
  failure.check(
    string.split_ascii_whitespace("a\u{b}b") == ["a\u{b}b"],
    TextInvariant()
  )
  failure.check(string.trim("\u{b}a\u{b}") == "a", TextInvariant())
  failure.check(string.ascii_lower("ÉAbC") == "Éabc", TextInvariant())
  let mut all: List[u8] = []
  for cp in 0u32..256u32 {
    list.push(mut all, int.narrow(cp))
  }
  let data = bytes.from_list(take all)
  let encoded = std@1/hex.encode(data)
  failure.check(
    encoded == "",
    TextInvariant()
  )
  failure.check(std@1/hex.decode(encoded) == Ok(copy data), TextInvariant())
  failure.check(
    std@1/hex.decode(string.ascii_upper(encoded)) == Ok(copy data),
    TextInvariant()
  )
  match std@1/json.parse("-1.2e+3") {
    Ok(Number(value)) => failure.check(value == "-1.2e+3", TextInvariant()),
    _ => failure.check(false, TextInvariant()),
  }
  match std@1/json.parse("\"\\u00Af\"") {
    Ok(Text(value)) => failure.check(value == "¯", TextInvariant()),
    _ => failure.check(false, TextInvariant()),
  }
  failure.check(std@1/uri.percent_decode("%+f%-0%2F") == b"%+f%-0/", TextInvariant())
  failure.check(std@1/net.ends_in_number("0xFf"), TextInvariant())
  failure.check(!std@1/net.ends_in_number("0xg"), TextInvariant())
  failure.check(std@1/net.validate_host("A-b.Example.") == Ok(()), TextInvariant())
  match std@1/net.parse_ipv6("2001:db8::1") {
    Ok(_) => (),
    Error(_) => failure.check(false, TextInvariant()),
  }
  match std@1/uri.parse("https://example.test:+080/path") {
    Error(InvalidPort()) => (),
    _ => failure.check(false, TextInvariant()),
  }
  failure.check(std@1/u8.parse_radix("ff", 16) == Ok(255u8), TextInvariant())
  failure.check(std@1/u8.parse_radix("100", 16) == Error(OutOfRange), TextInvariant())
  failure.check(std@1/u8.parse_radix("100g", 16) == Error(Invalid), TextInvariant())
  failure.check(std@1/u8.parse_radix("-1", 16) == Error(Invalid), TextInvariant())
  failure.check(std@1/i8.parse_radix("-80", 16) == Ok(-128i8), TextInvariant())
  Ok(())
}
