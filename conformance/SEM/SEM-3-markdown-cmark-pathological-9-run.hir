    options
  )
  failed += harness.check(
    s,
    "cmark-pathological/9/malformed",
    "[ (]([ (]([ (]([ (]([ (]([ (]([ (]([ (]([ (]([ (]([ (]([ (](\u{0}[&unterminated",
    "<p>[ (]([ (]([ (]([ (]([ (]([ (]([ (]([ (]([ (]([ (]([ (]([ (](�[&amp;unterminated</p>\n",
    options
