fn check(pattern: String, input: String, expected: Option[regex.Span]) -> Result[(), ()] {
  let re = match regex.compile(pattern, 10000) {
    Ok(re) => take re,
    Error(_) => return Error(()),
  }
  failure.check(regex.find(re, input, 100000) == Ok(expected), TextInvariant())
  Ok(())
}

pub fn main() -> Result[(), ()] {
  // src/regexp/testdata/re2-search.txt:905
  check("\\bbar", "", None())?
  // src/regexp/testdata/re2-search.txt:906
  check("\\bbar", "bar x", Some(regex.Span(start: 0, end: 3)))?
  // src/regexp/testdata/re2-search.txt:908
  check("^(?:\\bbar)$", "", None())?
  // src/regexp/testdata/re2-search.txt:909
