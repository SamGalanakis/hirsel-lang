// rule: SEM-3
// expect: run
// Zig SHA-256 reference vectors and padding boundaries.
pub fn main() -> Result[(), ()] {
  failure.check(
    std@1/sha256.digest_hex(
      string.as_bytes("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")
    ) == "f13b2d724659eb3bf47f2dd6af1accc87b81f09f59f2b75e5c0bed6589dfe8c6",
    TextInvariant()
  )
  Ok(())
}
