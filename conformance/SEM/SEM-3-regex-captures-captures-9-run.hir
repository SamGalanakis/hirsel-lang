// rule: SEM-3
// expect: run
// Go ebe2feef capture/flag/replacement vectors (BSD-3-Clause).
// RE2 data Copyright 2009 The RE2 Authors (BSD-3-Clause).
fn check(pattern: String, input: String, maximum: u64, expected: List[regex.Captures]) -> Result[
  (),
  ()
] {
  let Ok(re) = regex.compile(pattern, 10000) else {
    return Error(())
  }
  failure.check(
    regex.find_all_captures(re, input, maximum, 1000000) == Ok(expected),
    TextInvariant()
  )
  if maximum != 0 {
    let first: Option[regex.Captures] = if list.len(expected) == 0 {
      None()
    } else {
      Some(copy expected[0])
    }
    failure.check(regex.find_captures(re, input, 1000000) == Ok(first), TextInvariant())
  }
  Ok(())
}

pub fn main() -> Result[(), ()] {
  // Go find_test.go:99
  check("(?:(?:^).)", "\n", 18446744073709551615, [])?
  // Go find_test.go:100
  check(
    "\\b",
    "x",
    18446744073709551615,
    [
      regex.Captures(spans: [Some(regex.Span(start: 0, end: 0))]),
      regex.Captures(spans: [Some(regex.Span(start: 1, end: 1))])
    ]
  )?
  // Go find_test.go:101
  check(
    "\\b",
    "xx",
    18446744073709551615,
    [
      regex.Captures(spans: [Some(regex.Span(start: 0, end: 0))]),
      regex.Captures(spans: [Some(regex.Span(start: 2, end: 2))])
    ]
  )?
  // Go find_test.go:102
  check(
    "\\b",
    "x y",
    18446744073709551615,
    [
      regex.Captures(spans: [Some(regex.Span(start: 0, end: 0))]),
      regex.Captures(spans: [Some(regex.Span(start: 1, end: 1))]),
      regex.Captures(spans: [Some(regex.Span(start: 2, end: 2))]),
      regex.Captures(spans: [Some(regex.Span(start: 3, end: 3))])
    ]
  )?
  // Go find_test.go:103
  check(
    "\\b",
    "xx yy",
    18446744073709551615,
    [
      regex.Captures(spans: [Some(regex.Span(start: 0, end: 0))]),
      regex.Captures(spans: [Some(regex.Span(start: 2, end: 2))]),
      regex.Captures(spans: [Some(regex.Span(start: 3, end: 3))]),
      regex.Captures(spans: [Some(regex.Span(start: 5, end: 5))])
    ]
  )?
  // Go find_test.go:104
  check("\\B", "x", 18446744073709551615, [])?
  // Go find_test.go:105
  check(
    "\\B",
    "xx",
    18446744073709551615,
    [regex.Captures(spans: [Some(regex.Span(start: 1, end: 1))])]
  )?
  // Go find_test.go:106
  check("\\B", "x y", 18446744073709551615, [])?
  Ok(())
}
