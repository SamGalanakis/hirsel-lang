// rule: SEM-4
// expect: run
// stdout: ok
fn output_error[E](take e: E) {}

pub fn main(rt: Io, args: Args) -> Result[(), ()] {
  let mut count: u8 = 0
  for i in 254u8..=255u8 {
    count += 1u8
  }
  out.print(
    io.stdout(rt) ? grant_error,
    if count == 2u8 {
      "ok\n"
    } else {
      "bad\n"
    }
  ) ? output_error
  Ok(())
}

@noalloc
fn grant_error(refusal: GrantError) -> () uses {} {
  ()
}
