  failed += harness.check(
    s,
    "commonmark/Autolinks/612",
    "foo@bar.example.com\n",
    "<p>foo@bar.example.com</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Raw HTML/613",
    "<a><bab><c2c>\n",
    "<p><a><bab><c2c></p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Raw HTML/614",
    "<a/><b2/>\n",
    "<p><a/><b2/></p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Raw HTML/615",
    "<a  /><b2\ndata=\"foo\" >\n",
    "<p><a  /><b2\ndata=\"foo\" ></p>\n",
    std@1/markdown.default_options()
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
