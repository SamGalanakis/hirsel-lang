// rule: SEM-3
// expect: run
// Published spec.txt vectors; tools/generate-markdown.py.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.check(
    s,
    "gfm/Task list items (extension)/279/malformed",
    "- [ ] foo\n\u{0}[&unterminated",
    "<ul>\n<li><input disabled=\"\" type=\"checkbox\"> foo\n�[&amp;unterminated</li>\n</ul>\n",
    std@1/markdown.gfm_options()
  )
  failed += harness.check(
    s,
    "gfm/Task list items (extension)/280/malformed",
    "- [x] foo\n  - [ ] bar\n\u{0}[&unterminated",
    "<ul>\n<li><input checked=\"\" disabled=\"\" type=\"checkbox\"> foo\n<ul>\n<li><input disabled=\"\" type=\"checkbox\"> bar\n�[&amp;unterminated</li>\n</ul>\n</li>\n</ul>\n",
    std@1/markdown.gfm_options()
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
