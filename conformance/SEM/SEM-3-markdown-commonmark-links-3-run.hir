// rule: SEM-3
// expect: run
// Published spec.txt vectors; tools/generate-markdown.py.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.check(
    s,
    "commonmark/Links/494",
    "[a](<b)c\n[a](<b)c>\n[a](<b>c)\n",
    "<p>[a](&lt;b)c\n[a](&lt;b)c&gt;\n[a](<b>c)</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Links/495",
    "[link](\\(foo\\))\n",
    "<p><a href=\"(foo)\">link</a></p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Links/496",
    "[link](foo(and(bar)))\n",
    "<p><a href=\"foo(and(bar))\">link</a></p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Links/497",
    "[link](foo(and(bar))\n",
    "<p>[link](foo(and(bar))</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Links/498",
    "[link](foo\\(and\\(bar\\))\n",
    "<p><a href=\"foo(and(bar)\">link</a></p>\n",
    std@1/markdown.default_options()
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
