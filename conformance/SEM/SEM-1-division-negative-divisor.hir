// rule: SEM-1
// expect: run
// stdout: ok
// "/ truncates toward zero, % takes the dividend's sign".
fn output_error[E](take e: E) -> () {}

pub fn main(rt: Io, args: Args) -> Result[(), ()] {
  let a: i32 = 7
  let b: i32 = -3
  let q = a / b
  let r = a % b
  out.print(
    io.stdout(rt) ? grant_error,
    if if q == -2 {
      r == 1
    } else {
      false
    } {
      "ok\n"
    } else {
      "bad\n"
    }
  ) ? output_error
  Ok(())
}

@noalloc
fn grant_error(refusal: GrantError) -> () uses {} {
  ()
}
