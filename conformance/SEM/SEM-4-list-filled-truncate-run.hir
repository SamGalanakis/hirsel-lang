// rule: SEM-4
// expect: run
// Rust alloctests/tests/vec.rs:548-559, 2327-2338, 2803-2807.
pub fn main() -> Result[(), ()] {
  failure.check(list.filled(0, 1u64) == [], Bounds())
  failure.check(list.filled(1, 1u64) == [1], Bounds())
  failure.check(list.filled(2, 1u64) == [1, 1], Bounds())
  failure.check(list.filled(3, 1u64) == [1, 1, 1], Bounds())
  failure.check(list.filled(3, 85u8) == [85u8, 85, 85], Bounds())
  failure.check(list.filled(3, -7i8) == [-7i8, -7, -7], Bounds())
  failure.check(
    list.filled(3, 2147483647i32) == [2147483647i32, 2147483647, 2147483647],
    Bounds()
  )
  failure.check(
    list.filled(3, 4294967295u32) == [4294967295u32, 4294967295, 4294967295],
    Bounds()
  )
  failure.check(
    list.filled(3, 0x0102030405060708u64) == [
      0x0102030405060708u64,
      0x0102030405060708,
      0x0102030405060708
    ],
    Bounds()
  )
  let mut xs: unique List[u8] = list.filled(8, 0u8)
  failure.check(list.len(xs) == 8 && xs[7] == 0, Bounds())
  xs[0] = 9
  list.truncate(mut xs, 18446744073709551615u64)
  failure.check(list.len(xs) == 8 && xs[0] == 9, Bounds())
  list.truncate(mut xs, 8)
  list.truncate(mut xs, 3)
  failure.check(xs == [9u8, 0, 0], Bounds())
  list.truncate(mut xs, 0)
  list.truncate(mut xs, 0)
  list.push(mut xs, 7)
  failure.check(xs == [7u8], Bounds())
  let mut shared: List[u64] = [1, 2, 3]
  let alias = copy shared
  list.truncate(mut shared, 18446744073709551615u64)
  failure.check(shared == alias, Bounds())
  list.truncate(mut shared, 1)
  failure.check(shared == [1] && alias == [1, 2, 3], Bounds())
  let seed: List[u64] = [1, 2]
  let mut rows = list.filled_copyable(3, copy seed)
  rows[0][0] = 9
  failure.check(seed == [1, 2] && rows[1] == [1, 2] && rows[2] == [1, 2], Bounds())
  let zeros: unique List[u64] = list.filled(4, 0u64)
  failure.check(zeros == [0u64, 0, 0, 0], Bounds())
  let units = list.filled(3, ())
  failure.check(list.len(units) == 3, Bounds())
  Ok(())
}
