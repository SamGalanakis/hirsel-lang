// rule: SEM-3
// expect: run
// std@1/toml edits: failed edits leave the document unchanged; the empty path replaces the document.
// Ported from toml_edit tests/testsuite/edit.rs (toml-rs/toml ceac6e44); where
// toml_edit re-renders the document, the expectation keeps the source bytes.
fn k(name: String) -> toml.Segment {
  Key(unique name)
}

fn load(text: String) -> toml.Document {
  match toml.document(unique text) {
    Ok(doc) => doc,
    Error(_) => {
      failure.check(false, TextInvariant())
      load("")
    },
  }
}

fn done(outcome: Result[(), toml.TomlError]) -> () {
  failure.check(outcome == Ok(()), TextInvariant())
}

fn table(pairs: List[(String, toml.Value)]) -> toml.Value {
  let mut entries: Map[String, toml.Value] = map.empty()
  for (key, item) in pairs {
    map.insert(mut entries, unique key, unique item)
  }
  Table(take entries)
}

fn produces(doc: toml.Document, expected: String) -> () {
  failure.check(toml.source(doc) == expected, TextInvariant())
}

pub fn main() -> Result[(), ()] {
  // Errors leave the document unchanged.
  let mut fixed = load("a = 1\n[t]\nb = [1]\n")
  failure.check(
    toml.set(mut fixed, [k("a"), k("b")], Integer(2)) == Error(NotTable()),
    TextInvariant()
  )
  failure.check(
    toml.set(mut fixed, [k("t"), k("b"), k("c")], Integer(2)) == Error(NotTable()),
    TextInvariant()
  )
  failure.check(
    toml.set(mut fixed, [k("t"), k("b"), Index(5)], Integer(2)) == Error(NotFound()),
    TextInvariant()
  )
  failure.check(
    toml.set(mut fixed, [k("t"), Index(0)], Integer(2)) == Error(NotTable()),
    TextInvariant()
  )
  failure.check(
    toml.set(mut fixed, [k("d")], Datetime("noon")) == Error(InvalidValue()),
    TextInvariant()
  )
  failure.check(
    toml.remove(mut fixed, [k("t"), k("missing")]) == Error(NotFound()),
    TextInvariant()
  )
  failure.check(toml.remove(mut fixed, []) == Error(NotFound()), TextInvariant())
  produces(fixed, "a = 1\n[t]\nb = [1]\n")
  // The empty path replaces the whole document.
  done(toml.set(mut fixed, [], table([("only", Bool(true))])))
  produces(fixed, "only = true\n")
  failure.check(
    toml.set(mut fixed, [], Integer(1)) == Error(NotTable()),
    TextInvariant()
  )
  Ok(())
}
