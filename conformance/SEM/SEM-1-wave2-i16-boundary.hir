// rule: SEM-1
// expect: run
pub fn main(t: Test) -> Result[(), ()] {
  core@1/test.check(t, i16.to_string(-32768i16) == "-32768")
  core@1/test.check(t, i16.parse("-32768") == Ok(-32768i16))
  let mut buffer1: Inline[u8, 6] = [99u8, 99u8, 99u8, 99u8, 99u8, 99u8]
  core@1/test.check(t, i16.format_inline(-32768i16, mut buffer1) == Ok(6u64))
  core@1/test.check(t, buffer1 == [45u8, 51u8, 50u8, 55u8, 54u8, 56u8])
  core@1/test.check(t, i16.to_string(32767i16) == "32767")
  core@1/test.check(t, i16.parse("32767") == Ok(32767i16))
  let mut buffer2: Inline[u8, 5] = [99u8, 99u8, 99u8, 99u8, 99u8]
  core@1/test.check(t, i16.format_inline(32767i16, mut buffer2) == Ok(5u64))
  core@1/test.check(t, buffer2 == [51u8, 50u8, 55u8, 54u8, 55u8])
  core@1/test.check(t, i16.to_string(0i16) == "0")
  core@1/test.check(t, i16.parse("0") == Ok(0i16))
  let mut buffer3: Inline[u8, 1] = [99u8]
  core@1/test.check(t, i16.format_inline(0i16, mut buffer3) == Ok(1u64))
  core@1/test.check(t, buffer3 == [48u8])
  Ok(())
}
