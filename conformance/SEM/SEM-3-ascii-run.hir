// rule: SEM-3
// expect: run
// Zig ascii.zig ASCII character classes and whitespace test vectors.
pub fn main(t: Test) -> Result[(), ()] {
  test.check(t, ascii.to_upper(b'c') == b'C')
  test.check(t, ascii.to_upper(b':') == b':')
  test.check(t, ascii.to_upper(0xab) == 0xab)
  test.check(t, ascii.to_lower(b'C') == b'c')
  test.check(t, ascii.to_lower(b':') == b':')
  test.check(t, ascii.to_lower(0xab) == 0xab)
  test.check(t, !ascii.is_upper(b'z') && !ascii.is_lower(b'Z'))
  test.check(t, ascii.is_alnum(b'Z') && ascii.is_alnum(b'z') && ascii.is_alnum(b'5'))
  test.check(t, ascii.is_alnum(b'a') && !ascii.is_alnum(b'!'))
  test.check(t, !ascii.is_alpha(b'5') && ascii.is_alpha(b'c'))
  test.check(t, !ascii.is_alpha(b'@') && ascii.is_alpha(b'Z'))
  test.check(t, !ascii.is_space(b'.') && !ascii.is_space(0x1f))
  test.check(t, !ascii.is_digit(b'~') && ascii.is_digit(b'0') && ascii.is_digit(b'9'))
  let whitespace: List[u8] = [b' ', b'\t', b'\n', b'\r', b'\x0b', b'\x0c']
  for c in whitespace {
    test.check(t, ascii.is_space(c))
  }
  for c in 0u8..128u8 {
    let mut found = false
    for space in whitespace {
      if c == space {
        found = true
      }
    }
    test.check(t, ascii.is_space(c) == found)
  }
  for c in 128u8..=255u8 {
    test.check(t, !ascii.is_alpha(c) && !ascii.is_alnum(c) && !ascii.is_digit(c))
    test.check(t, !ascii.is_upper(c) && !ascii.is_lower(c) && !ascii.is_space(c))
    test.check(t, ascii.to_upper(c) == c && ascii.to_lower(c) == c)
    test.check(t, ascii.digit_value(c) == None())
  }
  let mut expected = 0u8
  for c in b"0123456789" {
    test.check(t, ascii.digit_value(c) == Some(expected))
    expected += 1
  }
  let nondigits: List[u8] = [b'/', b':', b'a', b'\0']
  for c in nondigits {
    test.check(t, ascii.digit_value(c) == None())
  }
  let pairs: List[(u8, u8)] = [(b'a', b'A'), (b'm', b'M'), (b'z', b'Z')]
  for (lower, upper) in pairs {
    test.check(t, ascii.is_lower(lower) && ascii.is_upper(upper))
    test.check(t, ascii.to_upper(lower) == upper && ascii.to_lower(upper) == lower)
  }
  Ok(())
}
