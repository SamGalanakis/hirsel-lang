// rule: SEM-3
// expect: run
// Go ebe2feef capture/flag/replacement vectors (BSD-3-Clause).
// RE2 data Copyright 2009 The RE2 Authors (BSD-3-Clause).
fn check(pattern: String, input: String, maximum: u64, expected: List[regex.Captures]) -> Result[
  (),
  ()
] {
  let Ok(re) = regex.compile(pattern, 10000) else {
    return Error(())
  }
  failure.check(
    regex.find_all_captures(re, input, maximum, 1000000) == Ok(expected),
    TextInvariant()
  )
  if maximum != 0 {
    let first: Option[regex.Captures] = if list.len(expected) == 0 {
      None()
    } else {
      Some(copy expected[0])
    }
    failure.check(regex.find_captures(re, input, 1000000) == Ok(first), TextInvariant())
  }
  Ok(())
}

pub fn main() -> Result[(), ()] {
  // Go find_test.go:107
  check(
    "\\B",
    "xx yy",
    18446744073709551615,
    [
      regex.Captures(spans: [Some(regex.Span(start: 1, end: 1))]),
      regex.Captures(spans: [Some(regex.Span(start: 4, end: 4))])
    ]
  )?
  // Go find_test.go:108
  check(
    "(|a)*",
    "aa",
    18446744073709551615,
    [
      regex.Captures(
        spans: [Some(regex.Span(start: 0, end: 0)), Some(regex.Span(start: 0, end: 0))]
      ),
      regex.Captures(
        spans: [Some(regex.Span(start: 1, end: 1)), Some(regex.Span(start: 1, end: 1))]
      ),
      regex.Captures(
        spans: [Some(regex.Span(start: 2, end: 2)), Some(regex.Span(start: 2, end: 2))]
      )
    ]
  )?
  // Go find_test.go:109
  check(
    "0A|0[aA]",
    "0a",
    18446744073709551615,
    [regex.Captures(spans: [Some(regex.Span(start: 0, end: 2))])]
  )?
  // Go find_test.go:110
  check(
    "0[aA]|0A",
    "0a",
    18446744073709551615,
    [regex.Captures(spans: [Some(regex.Span(start: 0, end: 2))])]
  )?
  // Go find_test.go:113
  check("[^\\S\\s]", "abcd", 18446744073709551615, [])?
  // Go find_test.go:115
  check("[^\\D\\d]", "abcd", 18446744073709551615, [])?
  // Go find_test.go:117
  check("(?i)\\W", "x", 18446744073709551615, [])?
  // Go find_test.go:118
  check("(?i)\\W", "k", 18446744073709551615, [])?
  Ok(())
}
