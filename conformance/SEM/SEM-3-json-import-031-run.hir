fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.parses(s, "y_number_minus_zero.json:1", "[-0]", 0)
  failed += harness.parses(s, "y_number_negative_int.json:1", "[-123]", 0)
  failed += harness.parses(s, "y_number_negative_one.json:1", "[-1]", 0)
  failed += harness.parses(s, "y_number_negative_zero.json:1", "[-0]", 0)
  failed += harness.parses(s, "y_number_real_capital_e.json:1", "[1E22]", 0)
  failed += harness.parses(s, "y_number_real_capital_e_neg_exp.json:1", "[1E-2]", 0)
  failed += harness.parses(s, "y_number_real_capital_e_pos_exp.json:1", "[1E+2]", 0)
  failed += harness.parses(s, "y_number_real_exponent.json:1", "[123e45]", 0)
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
