// rule: SEM-3
// expect: run
// Pinned upstream vectors; tools/generate-markdown-hostile.py.
// commonmark.js test/test.js:178-300; alternate line endings
// Each program is bounded by the corpus step budget and runner timeout.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  let mut options = std@1/markdown.default_options()
  failed += harness.check(
    s,
    "js-pathological/2",
    "- a\n- b\r- c\r\n- d",
    "<ul>\n<li>a</li>\n<li>b</li>\n<li>c</li>\n<li>d</li>\n</ul>\n",
    options
  )
  failed += harness.check(
    s,
    "js-pathological/2/malformed",
    "- a\n- b\r\u{0}[&unterminated",
    "<ul>\n<li>a</li>\n<li>b\n�[&amp;unterminated</li>\n</ul>\n",
    options
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
