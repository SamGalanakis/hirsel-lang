// rule: SEM-3
// expect: run
// steps: 3000000
// one fixed-base multiplication and an encoding take about 1.3M steps
// RFC 8032 section 7.1 TEST 1: a 32-byte seed's public key; the fail twin's 31-byte
// seed is refused.
fn decode(text: String) -> unique Bytes {
  let Ok(data) = std@1/hex.decode(text) else {
    failure.check(false, TextInvariant())
    return bytes.from_list([])
  }
  data
}

pub fn main() -> Result[(), ()] {
  failure.check(
    std@1/hex.encode(
      std@1/ed25519.public_key(
        decode("9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60")
      )
    ) == "d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a",
    TextInvariant()
  )
  Ok(())
}
