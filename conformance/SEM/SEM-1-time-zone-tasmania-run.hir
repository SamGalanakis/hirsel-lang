// rule: SEM-1
// expect: run
// Australia/Tasmania from jiff's TZif test file: southern-hemisphere DST, with
// the fold in April and the gap in October.
pub fn main(t: Test) -> Result[(), ()] {
  let zone = test.expect_ok(t, time_zone.from_tzif(zones.TASMANIA))
  check.ambiguity(
    t,
    zone,
    [
      ("1970-01-01T11:00:00", 0, 39600, 39600),
      ("2024-04-07T01:59:59.999999999", 0, 39600, 39600),
      ("2024-04-07T02:00:00", 2, 39600, 36000),
      ("2024-04-07T02:59:59.999999999", 2, 39600, 36000),
      ("2024-04-07T03:00:00", 0, 36000, 36000),
      ("2024-10-06T01:59:59.999999999", 0, 36000, 36000),
      ("2024-10-06T02:00:00", 1, 36000, 39600),
      ("2024-10-06T02:59:59.999999999", 1, 36000, 39600),
      ("2024-10-06T03:00:00", 0, 39600, 39600)
    ]
  )
  check.instants(
    t,
    zone,
    [
      (0, 39600, "1970-01-01T11:00:00"),
      (1728142200000000000, 36000, "2024-10-06T01:30:00"),
      (1728143999999999999, 36000, "2024-10-06T01:59:59.999999999"),
      (1728144000000000000, 39600, "2024-10-06T03:00:00"),
      (1728145800000000000, 39600, "2024-10-06T03:30:00"),
      (1712415600000000000, 39600, "2024-04-07T02:00:00"),
      (1712417400000000000, 39600, "2024-04-07T02:30:00"),
      (1712419199999999999, 39600, "2024-04-07T02:59:59.999999999"),
      (1712419200000000000, 36000, "2024-04-07T02:00:00"),
      (1712421000000000000, 36000, "2024-04-07T02:30:00")
    ]
  )
  Ok(())
}
