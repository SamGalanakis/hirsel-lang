// rule: SEM-3
// expect: run
// Published spec.txt vectors; tools/generate-markdown.py.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.check(
    s,
    "commonmark/Setext headings/95/malformed",
    "Foo\nBa\u{0}[&unterminated",
    "<p>Foo\nBa�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Setext headings/96/malformed",
    "---\nFoo\n---\n\u{0}[&unterminated",
    "<hr />\n<h2>Foo</h2>\n<p>�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Setext headings/97/malformed",
    "\n==\u{0}[&unterminated",
    "<p>==�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Setext headings/98/malformed",
    "---\n\u{0}[&unterminated",
    "<hr />\n<p>�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Setext headings/99/malformed",
    "- foo\n\u{0}[&unterminated",
    "<ul>\n<li>foo\n�[&amp;unterminated</li>\n</ul>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Setext headings/100/malformed",
    "    fo\u{0}[&unterminated",
    "<pre><code>fo�[&amp;unterminated\n</code></pre>\n",
    std@1/markdown.default_options()
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
