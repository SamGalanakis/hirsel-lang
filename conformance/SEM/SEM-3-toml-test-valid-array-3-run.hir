// tests/files-toml-1.1.0, group valid-array.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.valid(
    s,
    "valid/array/bool",
    "a = [true, false]\n",
    "{\"a\":[{\"type\":\"bool\",\"value\":\"true\"},{\"type\":\"bool\",\"value\":\"false\"}]}"
  )
  failed += harness.valid(
    s,
    "valid/array/empty",
    "thevoid = [[[[[]]]]]\n",
    "{\"thevoid\":[[[[[]]]]]}"
  )
  failed += harness.valid(
    s,
    "valid/array/hetergeneous",
    "mixed = [[1, 2], [\"a\", \"b\"], [1.1, 2.1]]\n",
    "{\"mixed\":[[{\"type\":\"integer\",\"value\":\"1\"},{\"type\":\"integer\",\"value\":\"2\"}],[{\"type\":\"string\",\"value\":\"a\"},{\"type\":\"string\",\"value\":\"b\"}],[{\"type\":\"float\",\"value\":\"4607632778762754458\"},{\"type\":\"float\",\"value\":\"4611911198408756429\"}]]}"
  )
  failed += harness.valid(
    s,
    "valid/array/mixed-int-array",
    "arrays-and-ints =  [1, [\"Arrays are not integers.\"]]\n",
    "{\"arrays-and-ints\":[{\"type\":\"integer\",\"value\":\"1\"},[{\"type\":\"string\",\"value\":\"Arrays are not integers.\"}]]}"
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
