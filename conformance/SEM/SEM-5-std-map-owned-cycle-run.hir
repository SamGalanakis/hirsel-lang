// rule: SEM-5
// expect: run
resource type Item {
  label: String,
}
drop(x) {}

fn cycle(mut m: unique Map[u64, Item]) -> () {
  match take map.remove(mut m, 1) {
    Some(item) => map.insert(mut m, 2, take item),
    None => failure.check(false, Bounds()),
  }
  match take map.remove(mut m, 2) {
    Some(item) => failure.check(item.label == "owned", Bounds()),
    None => failure.check(false, Bounds()),
  }
}

pub fn main(t: Test) -> Result[(), ()] {
  let mut m: unique Map[u64, Item] = map.empty()
  map.insert(mut m, 1, Item(label: "owned"))
  cycle(mut m)
  failure.check(map.len(m) == 0, Bounds())
  Ok(())
}
