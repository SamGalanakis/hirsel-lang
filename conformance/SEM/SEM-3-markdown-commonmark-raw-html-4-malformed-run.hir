// rule: SEM-3
// expect: run
// Published spec.txt vectors; tools/generate-markdown.py.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.check(
    s,
    "commonmark/Raw HTML/626/malformed",
    "foo <!--> foo -->\n\n\u{0}[&unterminated",
    "<p>foo <!--> foo --&gt;</p>\n<p>�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Raw HTML/627/malformed",
    "foo <?php e\u{0}[&unterminated",
    "<p>foo &lt;?php e�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Raw HTML/628/malformed",
    "foo <!ELEMEN\u{0}[&unterminated",
    "<p>foo &lt;!ELEMEN�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Raw HTML/629/malformed",
    "foo <![CDA\u{0}[&unterminated",
    "<p>foo &lt;![CDA�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Raw HTML/630/malformed",
    "foo <a href\u{0}[&unterminated",
    "<p>foo &lt;a href�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
