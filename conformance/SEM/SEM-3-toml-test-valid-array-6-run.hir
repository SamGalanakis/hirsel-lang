// rule: SEM-3
// expect: run
// Generated by tools/generate-toml-test.py from toml-test ff49d109861c
// tests/files-toml-1.0.0, group valid-array.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.valid(
    s,
    "valid/array/nospaces",
    "ints = [1,2,3]\n",
    "{\"ints\":[{\"type\":\"integer\",\"value\":\"1\"},{\"type\":\"integer\",\"value\":\"2\"},{\"type\":\"integer\",\"value\":\"3\"}]}"
  )
  failed += harness.valid(
    s,
    "valid/array/open-parent-table",
    "[[parent-table.arr]]\n[[parent-table.arr]]\n[parent-table]\nnot-arr = 1\n",
    "{\"parent-table\":{\"not-arr\":{\"type\":\"integer\",\"value\":\"1\"},\"arr\":[{},{}]}}"
  )
  failed += harness.valid(
    s,
    "valid/array/string-quote-comma-01",
    "title = [\n\"Client: \\\"XXXX\\\", Job: XXXX\",\n\"Code: XXXX\"\n]\n",
    "{\"title\":[{\"type\":\"string\",\"value\":\"Client: \\\"XXXX\\\", Job: XXXX\"},{\"type\":\"string\",\"value\":\"Code: XXXX\"}]}"
  )
  failed += harness.valid(
    s,
    "valid/array/string-quote-comma-02",
    "title = [ \" \\\", \",]\n",
    "{\"title\":[{\"type\":\"string\",\"value\":\" \\\", \"}]}"
  )
  failed += harness.valid(
    s,
    "valid/array/string-with-comma-01",
    "title = [\n\"Client: XXXX, Job: XXXX\",\n\"Code: XXXX\"\n]\n",
    "{\"title\":[{\"type\":\"string\",\"value\":\"Client: XXXX, Job: XXXX\"},{\"type\":\"string\",\"value\":\"Code: XXXX\"}]}"
  )
  failed += harness.valid(
    s,
    "valid/array/string-with-comma-02",
    "title = [\n\"\"\"Client: XXXX,\nJob: XXXX\"\"\",\n\"Code: XXXX\"\n]\n",
    "{\"title\":[{\"type\":\"string\",\"value\":\"Client: XXXX,\\nJob: XXXX\"},{\"type\":\"string\",\"value\":\"Code: XXXX\"}]}"
  )
  failed += harness.valid(
    s,
    "valid/array/strings",
    "string_array = [ \"all\", 'strings', \"\"\"are the same\"\"\", '''type''']\n",
    "{\"string_array\":[{\"type\":\"string\",\"value\":\"all\"},{\"type\":\"string\",\"value\":\"strings\"},{\"type\":\"string\",\"value\":\"are the same\"},{\"type\":\"string\",\"value\":\"type\"}]}"
  )
  failed += harness.valid(
    s,
    "valid/array/table-array-string-backslash",
    "foo = [ { bar=\"\\\"{{baz}}\\\"\"} ]\n",
    "{\"foo\":[{\"bar\":{\"type\":\"string\",\"value\":\"\\\"{{baz}}\\\"\"}}]}"
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
