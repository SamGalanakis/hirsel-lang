fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.parses(s, "n_single_space.json:1", " ", 1)
  failed += harness.parses(
    s,
    "n_string_1_surrogate_then_escape.json:1",
    "[\"\\uD800\\\"]",
    1
  )
  failed += harness.parses(
    s,
    "n_string_1_surrogate_then_escape_u.json:1",
    "[\"\\uD800\\u\"]",
    1
  )
  failed += harness.parses(
    s,
    "n_string_1_surrogate_then_escape_u1.json:1",
    "[\"\\uD800\\u1\"]",
    1
  )
  failed += harness.parses(
    s,
    "n_string_1_surrogate_then_escape_u1x.json:1",
    "[\"\\uD800\\u1x\"]",
    1
  )
  failed += harness.parses(s, "n_string_accentuated_char_no_quotes.json:1", "[é]", 1)
  failed += harness.parses(s, "n_string_backslash_00.json:1", "[\"\\\u{0}\"]", 1)
  failed += harness.parses(s, "n_string_escape_x.json:1", "[\"\\x00\"]", 1)
  failure.check(failed == 0, TextInvariant())
  Ok(())
