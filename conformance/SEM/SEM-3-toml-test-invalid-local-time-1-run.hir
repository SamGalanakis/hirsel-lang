// Generated by tools/generate-toml-test.py from toml-test ff49d109861c
// tests/files-toml-1.0.0, group invalid-local-time.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.invalid(
    s,
    "invalid/local-time/hour-over",
    "# time-hour       = 2DIGIT  ; 00-23\nd = 24:00:00\n"
  )
  failed += harness.invalid(
    s,
    "invalid/local-time/minute-over",
    "# time-minute     = 2DIGIT  ; 00-59\nd = 00:60:00\n"
  )
  failed += harness.invalid(
    s,
    "invalid/local-time/no-secs",
    "# No seconds in time.\nno-secs = 17:45\n"
  )
  failed += harness.invalid(
    s,
    "invalid/local-time/second-over",
    "# time-second     = 2DIGIT  ; 00-58, 00-59, 00-60 based on leap second\n#                           ; rules\nd = 00:00:61\n"
  )
  failed += harness.invalid(
    s,
    "invalid/local-time/time-no-leads-01",
    "# Leading 0 is always required.\nd = 1:32:00\n"
  )
  failed += harness.invalid(
    s,
    "invalid/local-time/time-no-leads-02",
    "# Leading 0 is always required.\nd = 01:32:0\n"
  )
  failed += harness.invalid(s, "invalid/local-time/trailing-dot", "t = 12:13:14.\n")
  failed += harness.invalid(s, "invalid/local-time/trailing-dotdot", "t = 12:13:14..\n")
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
