// rule: SEM-3
// expect: run
// steps: 6000000
// a signature is two fixed-base multiplications of about 1.2M steps each
// RFC 8032 section 7.1 TEST 1: the seed's signature of the empty message.
fn decode(text: String) -> unique Bytes {
  let Ok(data) = std@1/hex.decode(text) else {
    failure.check(false, TextInvariant())
    return bytes.from_list([])
  }
  data
}

pub fn main() -> Result[(), ()] {
  failure.check(
    std@1/hex.encode(
      std@1/ed25519.sign(
        decode("9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60"),
        b""
      )
    ) == "e5564300c360ac729086e2cc806e828a84877f1eb8e5d974d873e065224901555fb8821590a33bacc61e39701cf9b46bd25bf5f0595bbe24655141438e7a100b",
    TextInvariant()
  )
  Ok(())
}
