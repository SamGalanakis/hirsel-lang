// rule: SEM-3
// expect: run
// Go src/compress/flate/flate_test.go TestStreams, cases 12-15
// (golang/go ebe2feef). Unlike Go, bytes after the final block are an error.
fn check(ok: bool) -> () uses {} {
  failure.check(ok, TextInvariant())
}

fn corrupt(decoded: Result[Bytes, flate.FlateError]) -> bool uses {} {
  match decoded {
    Error(Corrupt(_)) => true,
    _ => false,
  }
}

pub fn main(t: Test) -> Result[(), ()] {
  // complete HCLenTree, over-subscribed HLitTree, empty HDistTree
  check(
    corrupt(
      flate.inflate(
        b"\x05\xe0\x01$\x00\x00\x00\x00\x00\xfc\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\x07\xf0\x0f",
        1024
      )
    )
  )
  // complete HCLenTree, under-subscribed HLitTree, empty HDistTree
  check(
    corrupt(
      flate.inflate(
        b"\x05\xe0\x01$\x00\x00\x00\x00\x00\xfc\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xfc\xff\xff\xff\xff\x07\xf0\x0f",
        1024
      )
    )
  )
  // complete HCLenTree, complete HLitTree with single code, empty HDistTree
  check(
    flate.inflate(
      b"\x05\xe0\x01$\x00\x00\x00\x00\x00\xf8\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\x07\xf0\x0f",
      1024
    ) == Ok(b"\x01")
  )
  // complete HCLenTree, complete HLitTree with multiple codes, empty HDistTree
  check(
    flate.inflate(
      b"\x05\xe3\x01$\x00\x00\x00\x00\x00\xf8\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\x07\x80\x7f",
      1024
    ) == Ok(b"\x01")
  )
  Ok(())
}
