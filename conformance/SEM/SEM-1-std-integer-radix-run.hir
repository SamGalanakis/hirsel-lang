  failure.check(
    i128.parse_radix("7KSYYIZZKUTUDZBV8AQZTECJJ", 36) == Ok(
      170141183460469231731687303715884105727i128
    ),
    Bounds()
  )
  failure.check(
    i128.format_radix(170141183460469231731687303715884105727i128, 36) == Ok(
      "7ksyyizzkutudzbv8aqztecjj"
    ),
    Bounds()
  )
  failure.check(
    i128.parse_radix("170141183460469231731687303715884105728", 10) == Error(OutOfRange),
    Bounds()
  )
  failure.check(
    i128.parse_radix("-170141183460469231731687303715884105729", 10) == Error(
      OutOfRange
    ),
    Bounds()
  )
  for radix in 2u8..37u8 {
    let text = u8.format_radix(255u8, radix)
    match text {
      Ok(value) => failure.check(u8.parse_radix(value, radix) == Ok(255u8), Bounds()),
      Error(_) => failure.check(false, Bounds()),
    }
  }
  let invalid: Array[String] = [
    "",
    "+1",
    "-",
    " 1",
    "1 ",
    "0x10",
    "1_0",
    "é",
    "999999x"
  ]
  for text in invalid {
    failure.check(u8.parse_radix(text, 10) == Error(Invalid), Bounds())
  }
  failure.check(u8.parse("999999x") == Error(Invalid), Bounds())
  failure.check(u8.parse_radix("-1", 10) == Error(Invalid), Bounds())
  failure.check(i8.parse_radix("-0", 36) == Ok(0i8), Bounds())
  failure.check(u8.parse_radix("000ff", 16) == Ok(255u8), Bounds())
  let invalid_radices: Array[u8] = [0u8, 1u8, 37u8, 255u8]
  for radix in invalid_radices {
    failure.check(u64.parse_radix("1", radix) == Error(Invalid), Bounds())
    failure.check(u64.format_radix(1u64, radix) == Error(Invalid), Bounds())
  }
  Ok(())
}
