fn check(pattern: String, input: String, expected: Option[regex.Span]) -> Result[(), ()] {
  let re = match regex.compile(pattern, 10000) {
    Ok(re) => take re,
    Error(_) => return Error(()),
  }
  failure.check(regex.find(re, input, 100000) == Ok(expected), TextInvariant())
  Ok(())
}

pub fn main() -> Result[(), ()] {
  // src/regexp/testdata/re2-search.txt:9
  check("a", "", None())?
  // src/regexp/testdata/re2-search.txt:10
  check("a", "a", Some(regex.Span(start: 0, end: 1)))?
  // src/regexp/testdata/re2-search.txt:12
  check("^(?:a)$", "", None())?
  // src/regexp/testdata/re2-search.txt:13
  check("^(?:a)$", "a", Some(regex.Span(start: 0, end: 1)))?
  // src/regexp/testdata/re2-search.txt:15
  check("^(?:a)", "", None())?
  // src/regexp/testdata/re2-search.txt:16
  check("^(?:a)", "a", Some(regex.Span(start: 0, end: 1)))?
  // src/regexp/testdata/re2-search.txt:18
  check("(?:a)$", "", None())?
  // src/regexp/testdata/re2-search.txt:19
  check("(?:a)$", "a", Some(regex.Span(start: 0, end: 1)))?
  // src/regexp/testdata/re2-search.txt:25
  check("a", "", None())?
  // src/regexp/testdata/re2-search.txt:26
  check("a", "zyzzyva", Some(regex.Span(start: 6, end: 7)))?
  // src/regexp/testdata/re2-search.txt:28
  check("^(?:a)$", "", None())?
  // src/regexp/testdata/re2-search.txt:29
  check("^(?:a)$", "zyzzyva", None())?
  // src/regexp/testdata/re2-search.txt:31
  check("^(?:a)", "", None())?
  // src/regexp/testdata/re2-search.txt:32
  check("^(?:a)", "zyzzyva", None())?
  // src/regexp/testdata/re2-search.txt:34
  check("(?:a)$", "", None())?
  // src/regexp/testdata/re2-search.txt:35
  check("(?:a)$", "zyzzyva", Some(regex.Span(start: 6, end: 7)))?
  // src/regexp/testdata/re2-search.txt:41
  check("a+", "", None())?
  // src/regexp/testdata/re2-search.txt:42
  check("a+", "aa", Some(regex.Span(start: 0, end: 2)))?
  // src/regexp/testdata/re2-search.txt:44
  check("^(?:a+)$", "", None())?
  // src/regexp/testdata/re2-search.txt:45
  check("^(?:a+)$", "aa", Some(regex.Span(start: 0, end: 2)))?
  Ok(())
}
