// rule: SEM-3
// expect: run
// Go zip/reader_test.go:58-584 TestReader: utf8-osx.zip.
pub fn main(t: Test) -> Result[(), ()] {
  let data = b"PK\x03\x04\x0a\x00\x00\x00\x00\x00.ifK\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x06\x00\x10\x00\xe4\xb8\x96\xe7\x95\x8cUX\x0c\x00\x87\xcf\x00Z\x87\xcf\x00Z\xf5\x01\x14\x00PK\x01\x02\x15\x03\x0a\x00\x00\x00\x00\x00.ifK\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x06\x00\x0c\x00\x00\x00\x00\x00\x00\x00\x00@\xa4\x81\x00\x00\x00\x00\xe4\xb8\x96\xe7\x95\x8cUX\x08\x00\x87\xcf\x00Z\x87\xcf\x00ZPK\x05\x06\x00\x00\x00\x00\x01\x00\x01\x00@\x00\x00\x004\x00\x00\x00\x00\x00"
  let es = match zip.entries(data) {
    Ok(es) => es,
    Error(_) => return Error(()),
  }
  test.check(t, list.len(es) == 1)
  test.check(t, es[0].name == "世界" && es[0].size == 0)
  test.check(t, es[0].modified == Some(1510002567i64))
  test.check(t, zip.read(data, es[0], 4096) == Ok(b""))
  test.check(t, es[0].dos_time == 1265002798)
  Ok(())
}
