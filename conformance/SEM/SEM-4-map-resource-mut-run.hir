// rule: SEM-4
// expect: run
// stdout: drop-old
// stdout: new
// stdout: drop-new
resource type Trace {
  stdout: Stdout,
  text: String,
}
drop(x) {
  let _ = out.print(x.stdout, "drop-")
  let _ = out.print(x.stdout, x.text)
}

pub fn main(rt: Io, args: Args) -> Result[(), GrantError] {
  let o = io.stdout(rt)?
  let mut m: Map[u8, Trace] = map.empty()
  map.insert(mut m, 1, Trace(stdout: o, text: "old\n"))
  for (k, v) in mut m {
    v = Trace(stdout: o, text: "new\n")
  }
  for (k, v) in m {
    let _ = out.print(o, v.text)
  }
  Ok(())
}
