fn parse_error(input: Bytes) -> Option[u64] uses {} {
  match x509.parse(input) {
    Error(Malformed(at)) => Some(at),
    Ok(_) => None(),
  }
}

pub fn main(t: Test) -> Result[(), x509.X509Error] {
  let n = x509.parse(names())?
  // The RDNs last first; the multivalued RDN's attributes in DER order; a dotted type's
  // string value as text; special, leading '#' and trailing space characters escaped.
  test.check(
    t,
    n.subject == "SERIALNUMBER=42+CN=agent 7\\ ,OU=\\#ops \\<east\\>,O=Hirsel\\, Inc.,0.9.2342.19200300.100.1.25=hirsel,0.9.2342.19200300.100.1.25=test"
  )
  test.check(t, n.names == ["agent-7.hirsel.test", "2001:db8::1", "192.0.2.7"])
  test.check(t, n.uris == ["spiffe://hirsel.test/agent/7"])
  let c = x509.parse(client())?
  test.check(
    t,
    c.subject == "CN=agent-7,O=Hirsel" && c.names == ["agent-7.hirsel.test"]
  )
  let s = x509.parse(server())?
  test.check(t, s.subject == "CN=localhost" && s.names == ["localhost", "127.0.0.1"])
  // A chain is its certificates concatenated, leaf first.
  let leaf = client()
  let issuer = server()
  let mut chain: List[u8] = []
  for b in leaf {
    list.push(mut chain, b)
  }
  for b in issuer {
    list.push(mut chain, b)
  }
  let parts = x509.certificates(bytes.from_list(take chain))?
  test.check(t, list.len(parts) == 2u64 && parts[0] == leaf && parts[1] == issuer)
  // Truncated input and a stray byte after a certificate are malformed at their offset.
  test.check(t, parse_error(bytes.slice(leaf, 0, 100)) == Some(0u64))
  test.check(t, parse_error(b"") == Some(0u64))
  match x509.certificates(b"\x30\x00\x02") {
    Error(Malformed(at)) => test.check(t, at == 2u64),
    Ok(_) => test.check(t, false),
  }
  Ok(())
}
