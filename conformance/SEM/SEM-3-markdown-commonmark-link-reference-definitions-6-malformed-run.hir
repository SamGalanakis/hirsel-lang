// rule: SEM-3
// expect: run
// Published spec.txt vectors; tools/generate-markdown.py.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.check(
    s,
    "commonmark/Link reference definitions/214/malformed",
    "# [Foo]\n[foo]\u{0}[&unterminated",
    "<h1>[Foo]</h1>\n<p>[foo]�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Link reference definitions/215/malformed",
    "[foo]: /url\nb\u{0}[&unterminated",
    "<p>b�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Link reference definitions/216/malformed",
    "[foo]: /url\u{0}[&unterminated",
    "",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Link reference definitions/217/malformed",
    "[foo]: /foo-url \"foo\"\n[bar]: /bar-url\n  \"\u{0}[&unterminated",
    "<p>&quot;�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
