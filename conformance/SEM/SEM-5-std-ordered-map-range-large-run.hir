// rule: SEM-5
// expect: run
// Rust f6c1107 library/alloc/src/collections/btree/map/tests.rs:571-929.
fn by(a: i32, b: i32) -> i32 uses {} {
  if a < b {
    -1
  } else if a > b {
    1
  } else {
    0
  }
}

fn make(start: i32, end: i32) -> ordered_map.OrderedMap[i32, i32] {
  let mut m: ordered_map.OrderedMap[i32, i32] = ordered_map.empty(by)
  for i in start..end {
    ordered_map.insert(mut m, i, i)
  }
  take m
}

fn keys(
  m: ordered_map.OrderedMap[i32, i32],
  low: ordered_map.Bound[i32],
  high: ordered_map.Bound[i32],
  descending: bool
) -> List[i32] {
  let direction: ordered_map.Direction = if descending {
    Descending()
  } else {
    Ascending()
  }
  ordered_map.fold_range(
    m,
    low,
    high,
    direction,
    [],
    fn(take acc: List[i32], k: i32, v: i32) -> (List[i32], bool) {
      failure.check(k == v, Bounds())
      let mut out = take acc
      list.push(mut out, k)
      (take out, true)
    }
  )
}

fn check(
  m: ordered_map.OrderedMap[i32, i32],
  low: ordered_map.Bound[i32],
  high: ordered_map.Bound[i32],
  expected: List[i32]
) -> () {
  failure.check(keys(m, low, high, false) == expected, Bounds())
  let mut reversed: unique List[i32] = unique expected
  list.reverse(mut reversed)
  failure.check(keys(m, low, high, true) == reversed, Bounds())
}

pub fn main(t: Test) -> Result[(), ()] {
  let size: i32 = 16
  let m = make(1, size + 1)
  let mut all: List[i32] = []
  for i in 1i32..size + 1 {
    list.push(mut all, i)
  }
  let first: List[i32] = [1]
  let last: List[i32] = [size]
  check(m, Excluded(0), Excluded(size + 1), all)
  check(m, Excluded(0), Included(size + 1), all)
  check(m, Excluded(0), Included(size), all)
  check(m, Excluded(0), Unbounded(), all)
  check(m, Included(0), Excluded(size + 1), all)
  check(m, Included(0), Included(size + 1), all)
  check(m, Included(0), Included(size), all)
  check(m, Included(0), Unbounded(), all)
  check(m, Included(1), Excluded(size + 1), all)
  check(m, Included(1), Included(size + 1), all)
  check(m, Included(1), Included(size), all)
  check(m, Included(1), Unbounded(), all)
  check(m, Unbounded(), Excluded(size + 1), all)
  check(m, Unbounded(), Included(size + 1), all)
  check(m, Unbounded(), Included(size), all)
  check(m, Excluded(0), Excluded(1), [])
  check(m, Excluded(0), Included(0), [])
  check(m, Included(0), Included(0), [])
  check(m, Included(0), Excluded(1), [])
  check(m, Unbounded(), Excluded(1), [])
  check(m, Unbounded(), Included(0), [])
  check(m, Excluded(0), Excluded(2), first)
  check(m, Excluded(0), Included(1), first)
  check(m, Included(0), Excluded(2), first)
  check(m, Included(0), Included(1), first)
  check(m, Included(1), Excluded(2), first)
  check(m, Included(1), Included(1), first)
  check(m, Unbounded(), Excluded(2), first)
  check(m, Unbounded(), Included(1), first)
  check(m, Excluded(size - 1), Excluded(size + 1), last)
  check(m, Excluded(size - 1), Included(size + 1), last)
  check(m, Excluded(size - 1), Included(size), last)
  check(m, Excluded(size - 1), Unbounded(), last)
  check(m, Included(size), Excluded(size + 1), last)
  check(m, Included(size), Included(size + 1), last)
  check(m, Included(size), Included(size), last)
  check(m, Included(size), Unbounded(), last)
  check(m, Excluded(size), Excluded(size + 1), [])
  check(m, Excluded(size), Included(size), [])
  check(m, Excluded(size), Unbounded(), [])
  check(m, Included(size + 1), Excluded(size + 1), [])
  check(m, Included(size + 1), Included(size + 1), [])
  check(m, Included(size + 1), Unbounded(), [])
  check(m, Unbounded(), Unbounded(), all)
  failure.check(
    keys(m, Unbounded(), Included(100), false) == keys(
      m,
      Unbounded(),
      Excluded(101),
      false
    ),
    Bounds()
  )
  check(m, Included(5), Included(8), [5, 6, 7, 8])
  check(m, Included(-1), Included(2), [1, 2])
  Ok(())
}
