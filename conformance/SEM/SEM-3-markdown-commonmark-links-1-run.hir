// rule: SEM-3
// expect: run
// Published spec.txt vectors; tools/generate-markdown.py.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.check(
    s,
    "commonmark/Links/482",
    "[link](/uri \"title\")\n",
    "<p><a href=\"/uri\" title=\"title\">link</a></p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Links/483",
    "[link](/uri)\n",
    "<p><a href=\"/uri\">link</a></p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Links/484",
    "[](./target.md)\n",
    "<p><a href=\"./target.md\"></a></p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Links/485",
    "[link]()\n",
    "<p><a href=\"\">link</a></p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Links/486",
    "[link](<>)\n",
    "<p><a href=\"\">link</a></p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Links/487",
    "[]()\n",
    "<p><a href=\"\"></a></p>\n",
    std@1/markdown.default_options()
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
