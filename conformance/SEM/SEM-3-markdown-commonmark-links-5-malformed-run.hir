// rule: SEM-3
// expect: run
// Published spec.txt vectors; tools/generate-markdown.py.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.check(
    s,
    "commonmark/Links/503/malformed",
    "[link](foo%\u{0}[&unterminated",
    "<p>[link](foo%�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Links/504/malformed",
    "[link](\"\u{0}[&unterminated",
    "<p>[link](&quot;�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Links/505/malformed",
    "[link](/url \"title\")\n[link](/ur\u{0}[&unterminated",
    "<p><a href=\"/url\" title=\"title\">link</a>\n[link](/ur�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Links/506/malformed",
    "[link](/url \"ti\u{0}[&unterminated",
    "<p>[link](/url &quot;ti�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
