// rule: SEM-5
// expect: run
pub fn main(t: Test) -> Result[(), ()] {
  let mut s: unique Set[String] = set.empty()
  set.insert(mut s, "zero")
  set.insert(mut s, "one")
  set.insert(mut s, "two")
  set.insert(mut s, "three")
  set.insert(mut s, "four")
  set.insert(mut s, "five")
  set.insert(mut s, "six")
  set.insert(mut s, "seven")
  set.insert(mut s, "eight")
  failure.check(set.len(s) == 9, Bounds())
  failure.check(set.remove(mut s, "zero"), Bounds())
  failure.check(set.remove(mut s, "four"), Bounds())
  failure.check(set.remove(mut s, "eight"), Bounds())
  failure.check(!set.remove(mut s, "four") && set.contains(s, "five"), Bounds())
  set.insert(mut s, "four")
  failure.check(set.len(s) == 7 && set.remove(mut s, "four"), Bounds())
  let _ = set.remove(mut s, "one")
  let _ = set.remove(mut s, "two")
  let _ = set.remove(mut s, "three")
  let _ = set.remove(mut s, "five")
  let _ = set.remove(mut s, "six")
  let _ = set.remove(mut s, "seven")
  failure.check(set.len(s) == 0, Bounds())
  set.insert(mut s, "reused")
  failure.check(set.remove(mut s, "reused") && set.len(s) == 0, Bounds())
  Ok(())
}
