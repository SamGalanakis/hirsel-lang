// rule: SEM-3
// expect: run
// Inputs: Go src/internal/diff/testdata (golang/go ebe2feef) and fixed pairs.
// Expected unified diffs are git 2.43.0's `git diff --no-index
// --no-indent-heuristic -U<n> --diff-algorithm=<myers|patience>` output, with
// names replaced and the function context after `@@` dropped; expected patch
// results are GNU patch 2.7.6's `patch --fuzz=0 --forward` output and rejected
// hunk numbers.
fn pairs() -> List[(String, String, String, String, String)] uses {} {
  [
    (
      "function",
      "#include <stdio.h>\n\nint main(void)\n{\n    printf(\"hello\\n\");\n    return 0;\n}\n",
      "#include <stdio.h>\n\nstatic int twice(int x)\n{\n    return 2 * x;\n}\n\nint main(void)\n{\n    printf(\"hello %d\\n\", twice(2));\n    return 0;\n}\n",
      "--- old\n+++ new\n@@ -1,7 +1,12 @@\n #include <stdio.h>\n \n+static int twice(int x)\n+{\n+    return 2 * x;\n+}\n+\n int main(void)\n {\n-    printf(\"hello\\n\");\n+    printf(\"hello %d\\n\", twice(2));\n     return 0;\n }\n",
      "--- old\n+++ new\n@@ -1,7 +1,12 @@\n #include <stdio.h>\n \n+static int twice(int x)\n+{\n+    return 2 * x;\n+}\n+\n int main(void)\n {\n-    printf(\"hello\\n\");\n+    printf(\"hello %d\\n\", twice(2));\n     return 0;\n }\n"
    )
  ]
}

// Rebuilds `new` from `old` and an edit script, checking each run's positions.
fn replay(old: List[String], new: List[String], script: List[diff.Edit]) -> bool uses {} {
  let mut out: List[String] = []
  let mut i: u64 = 0
  let mut j: u64 = 0
  for e in script {
    match e {
      Keep(a, b, n) => {
        if a != i || b != j || n == 0 {
          return false
        }
        for k in 0u64..n {
          if old[a + k] != new[b + k] {
            return false
          }
          list.push(mut out, unique old[a + k])
        }
        i += n
        j += n
      },
      Delete(a, b, n) => {
        if a != i || b != j || n == 0 {
          return false
        }
        i += n
      },
      Insert(a, b, n) => {
        if a != i || b != j || n == 0 {
          return false
        }
        for k in 0u64..n {
          list.push(mut out, unique new[b + k])
        }
        j += n
      },
    }
  }
  i == list.len(old) && out == new
}

pub fn main(t: Test) -> Result[(), diff.PatchError] {
  let mut case: u64 = 12
  for (_, old, new, myers, patience) in pairs() {
    test.check_case(t, diff.unified("old", old, "new", new, Myers(), 3) == myers, case)
    test.check_case(
      t,
      diff.unified("old", old, "new", new, Patience(), 3) == patience,
      case
    )
    // Applying either diff to the old text gives the new text.
    let both: List[String] = [copy myers, copy patience]
    for patch in both {
      let applied = diff.apply(old, patch)?
      test.check_case(t, applied.text == new && list.len(applied.rejected) == 0, case)
    }
    let a = diff.split_lines(old)
    let b = diff.split_lines(new)
    test.check_case(t, replay(a, b, diff.edits(a, b, Myers())), case)
    test.check_case(t, replay(a, b, diff.edits(a, b, Patience())), case)
    case += 1
  }
  Ok(())
}
