// rule: SEM-3
// expect: run
// Published spec.txt vectors; tools/generate-markdown.py.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.check(
    s,
    "commonmark/Autolinks/604",
    "<foo@bar.example.com>\n",
    "<p><a href=\"mailto:foo@bar.example.com\">foo@bar.example.com</a></p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Autolinks/605",
    "<foo+special@Bar.baz-bar0.com>\n",
    "<p><a href=\"mailto:foo+special@Bar.baz-bar0.com\">foo+special@Bar.baz-bar0.com</a></p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Autolinks/606",
    "<foo\\+@bar.example.com>\n",
    "<p>&lt;foo+@bar.example.com&gt;</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Autolinks/607",
    "<>\n",
    "<p>&lt;&gt;</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Autolinks/608",
    "< https://foo.bar >\n",
    "<p>&lt; https://foo.bar &gt;</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Autolinks/609",
    "<m:abc>\n",
    "<p>&lt;m:abc&gt;</p>\n",
    std@1/markdown.default_options()
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
