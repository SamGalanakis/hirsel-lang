// rule: SEM-3
// expect: run
// Published spec.txt vectors; tools/generate-markdown.py.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.check(
    s,
    "commonmark/Links/539/malformed",
    "[foo][BaR]\n\n[bar\u{0}[&unterminated",
    "<p>[foo][BaR]</p>\n<p>[bar�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Links/540/malformed",
    "[ẞ]\n\n[SS\u{0}[&unterminated",
    "<p>[ẞ]</p>\n<p>[SS�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Links/541/malformed",
    "[Foo\n  bar]: /url\u{0}[&unterminated",
    "",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Links/542/malformed",
    "[foo] [bar]\n\n[ba\u{0}[&unterminated",
    "<p>[foo] [bar]</p>\n<p>[ba�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
