// rule: SEM-3
// expect: run
// JSONTestSuite 1ef36fa01286573e846ac449e8683f8833c5b26a test_parsing/*.json:1.
// Differential reader twin of the existing imports; exact JsonError offsets.
fn check(t: Test, source: String) -> () {
  let expected: Result[(), json.JsonError] = match json.parse(unique source) {
    Ok(_) => Ok(()),
    Error(e) => Error(e),
  }
  let mut cursor = json.reader(string.as_bytes(source))
  let actual = match json.skip(mut cursor) {
    Ok(()) => json.finish_reader(mut cursor),
    Error(e) => Error(e),
  }
  test.equal(t, actual, expected)
}

pub fn main(t: Test) -> Result[(), ()] {
  // "i_number_too_big_pos_int.json:1"
  check(t, "[100000000000000000000]")
  // "i_number_very_big_negative_int.json:1"
  check(t, "[-237462374673276894279832749832423479823246327846]")
  // "i_object_key_lone_2nd_surrogate.json:1"
  check(t, "{\"\\uDFAA\":0}")
  // "i_string_1st_surrogate_but_2nd_missing.json:1"
  check(t, "[\"\\uDADA\"]")
  // "i_string_1st_valid_surrogate_2nd_invalid.json:1"
  check(t, "[\"\\uD888\\u1234\"]")
  // "i_string_incomplete_surrogate_and_escape_valid.json:1"
  check(t, "[\"\\uD800\\n\"]")
  // "i_string_incomplete_surrogate_pair.json:1"
  check(t, "[\"\\uDd1ea\"]")
  // "i_string_incomplete_surrogates_escape_valid.json:1"
  check(t, "[\"\\uD800\\uD800\\n\"]")
  Ok(())
}
