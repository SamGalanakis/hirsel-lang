// rule: SEM-3
// expect: run
// Published spec.txt vectors; tools/generate-markdown.py.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.check(
    s,
    "commonmark/Images/572",
    "![foo](/url \"title\")\n",
    "<p><img src=\"/url\" alt=\"foo\" title=\"title\" /></p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Images/573",
    "![foo *bar*]\n\n[foo *bar*]: train.jpg \"train & tracks\"\n",
    "<p><img src=\"train.jpg\" alt=\"foo bar\" title=\"train &amp; tracks\" /></p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Images/574",
    "![foo ![bar](/url)](/url2)\n",
    "<p><img src=\"/url2\" alt=\"foo bar\" /></p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Images/575",
    "![foo [bar](/url)](/url2)\n",
    "<p><img src=\"/url2\" alt=\"foo bar\" /></p>\n",
    std@1/markdown.default_options()
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
