// rule: SEM-3
// expect: run
// Rust coretests/tests/num/flt2dec/mod.rs, f6c1107f8be13e48465e12c0fd26e6a39fe18e4f.
// MIT; third-party/NOTICES.md. Original check_exact/check_exact_one row lines below.
fn exact(t: Test, mantissa: u64, exponent: i32, expected: String, cutoff: i32) -> () {
  let mut actual = std@1/internal.big.big_from_word(mantissa)
  let scale: u64 = if exponent < 0 {
    core@1/int.narrow(-exponent)
  } else {
    0u64
  }
  std@1/internal.big.big_power(
    mut actual,
    if exponent < 0 {
      5u64
    } else {
      2u64
    },
    if exponent < 0 {
      scale
    } else {
      core@1/int.narrow(exponent)
    }
  )
  let decimal_scale: i32 = core@1/int.narrow(scale)
  let places = decimal_scale + cutoff
  if places >= 0 {
    std@1/internal.format.round_decimal(mut actual, core@1/int.narrow(places))
  } else {
    std@1/internal.big.big_power(mut actual, 10, core@1/int.narrow(-places))
  }
  let mut wanted = std@1/internal.big.big_from_word(0)
  let mut chunk: u64 = 0
  let mut power: u64 = 1
  for digit in core@1/string.as_bytes(expected) {
    chunk = chunk * 10 + core@1/int.widen(digit - 48u8)
    power *= 10
    if power == 1000000000 {
      std@1/internal.big.big_mul_word(mut wanted, power)
      std@1/internal.big.big_add_small(mut wanted, chunk)
      chunk = 0
      power = 1
    }
  }
  std@1/internal.big.big_mul_word(mut wanted, power)
  std@1/internal.big.big_add_small(mut wanted, chunk)
  test.check(t, std@1/internal.big.big_compare(actual, wanted, false) == 0)
}

pub fn main(t: Test) -> Result[(), ()] {
  // mod.rs:526: 8942832835564782p-383f64; digits=10, decimal exponent=-99.
  exact(t, 8942832835564782u64, -383i32, "4539277920", -109i32)
  // mod.rs:527: 8942832835564782p-384f64; digits=11, decimal exponent=-99.
  exact(t, 8942832835564782u64, -384i32, "22696389598", -110i32)
  // mod.rs:528: 8942832835564782p-385f64; digits=12, decimal exponent=-99.
  exact(t, 8942832835564782u64, -385i32, "113481947988", -111i32)
  // mod.rs:529: 6965949469487146p-249f64; digits=13, decimal exponent=-59.
  exact(t, 6965949469487146u64, -249i32, "7700366561890", -72i32)
  // mod.rs:530: 6965949469487146p-250f64; digits=14, decimal exponent=-59.
  exact(t, 6965949469487146u64, -250i32, "38501832809448", -73i32)
  // mod.rs:531: 6965949469487146p-251f64; digits=15, decimal exponent=-59.
  exact(t, 6965949469487146u64, -251i32, "192509164047238", -74i32)
  // mod.rs:532: 7487252720986826p548f64; digits=16, decimal exponent=181.
  exact(t, 7487252720986826u64, 548i32, "6898586531774201", 165i32)
  Ok(())
}
