// rule: SEM-1
// expect: run
// Copyright (c) 2016 Paul Mason. MIT; third-party/NOTICES.md.
// rust_decimal tests/decimal_tests/arithmetic.rs it_adds_decimals, its rows of 28 or
// more digits, in both orders. A sum takes the larger scale, exactly: where rust_decimal
// rounds to its 96-bit coefficient, the expectation is the exact sum.
fn d(text: String) -> decimal.Decimal {
  let Ok(v) = decimal.parse(text) else {
    failure.check(false, TextInvariant())
    return decimal.new(bigint.zero(), 0)
  }
  v
}

fn sum(a: String, b: String, c: String) {
  let x = d(a)
  let y = d(b)
  let forward = decimal.to_string(decimal.add(x, y))
  failure.check(forward == c && decimal.add(y, x) == decimal.add(x, y), Arithmetic())
}

pub fn main() -> Result[(), ()] {
  sum(
    "11.815126050420168067226890757",
    "0.6386554621848739495798319328",
    "12.4537815126050420168067226898"
  )
  sum(
    "-11.815126050420168067226890757",
    "0.6386554621848739495798319328",
    "-11.1764705882352941176470588242"
  )
  sum(
    "11.815126050420168067226890757",
    "-0.6386554621848739495798319328",
    "11.1764705882352941176470588242"
  )
  sum(
    "-11.815126050420168067226890757",
    "-0.6386554621848739495798319328",
    "-12.4537815126050420168067226898"
  )
  sum(
    "11815126050420168067226890757",
    "0.4386554621848739495798319328",
    "11815126050420168067226890757.4386554621848739495798319328"
  )
  sum(
    "-11815126050420168067226890757",
    "0.4386554621848739495798319328",
    "-11815126050420168067226890756.5613445378151260504201680672"
  )
  sum(
    "11815126050420168067226890757",
    "-0.4386554621848739495798319328",
    "11815126050420168067226890756.5613445378151260504201680672"
  )
  sum(
    "-11815126050420168067226890757",
    "-0.4386554621848739495798319328",
    "-11815126050420168067226890757.4386554621848739495798319328"
  )
  sum(
    "0.0872727272727272727272727272",
    "843.65000000",
    "843.7372727272727272727272727272"
  )
  sum(
    "108053.27500000000000000000000",
    "0.00000000000000000000000",
    "108053.27500000000000000000000"
  )
  sum(
    "8097370036018690744.2590371109596744091",
    "3807285637671831400.15346897797550749555",
    "11904655673690522144.41250608893518190465"
  )
  Ok(())
}
