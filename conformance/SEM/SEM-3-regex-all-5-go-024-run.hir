// rule: SEM-3
// expect: run
// Go ebe2feef regexp/find_test.go whole-match FindAllStringIndex vectors.
// Copyright 2009 The Go Authors. BSD-3-Clause; third-party/NOTICES.md.
fn check(pattern: String, text: String, max: u64, expected: List[regex.Span]) -> Result[
  (),
  ()
] {
  let re = match regex.compile(pattern, 1000) {
    Ok(re) => take re,
    Error(_) => return Error(()),
  }
  failure.check(regex.find_all(re, text, max, 100000) == Ok(expected), TextInvariant())
  Ok(())
}

pub fn main() -> Result[(), ()] {
  // Oracle vector 99.
  check("a|$", "aa", 100, [regex.Span(start: 0, end: 1), regex.Span(start: 1, end: 2)])?
  // Oracle vector 100.
  check("^|$", "é🐑", 100, [regex.Span(start: 0, end: 0), regex.Span(start: 6, end: 6)])?
  // Oracle vector 101.
  check(
    "a|\\b",
    "aa",
    100,
    [regex.Span(start: 0, end: 1), regex.Span(start: 1, end: 2)]
  )?
  // Oracle vector 102.
  check(
    "\\b|a",
    "aa",
    100,
    [regex.Span(start: 0, end: 0), regex.Span(start: 1, end: 2)]
  )?
  Ok(())
}
