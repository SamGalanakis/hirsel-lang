// rule: SEM-3
// expect: run
pub fn main() -> Result[(), ()] {
  let value: std@1/json.Value = Array(
    [Null(), Number("1e+02"), Bool(false), Text("some string")]
  )
  let Some(null) = std@1/json_access.element(value, 0) else {
    failure.check(false, TextInvariant())
    return Ok(())
  }
  failure.check(std@1/json_access.is_null(null), TextInvariant())
  let Some(number) = std@1/json_access.element(value, 1) else {
    failure.check(false, TextInvariant())
    return Ok(())
  }
  let Some(spelling) = std@1/json_access.number_text(number) else {
    failure.check(false, TextInvariant())
    return Ok(())
  }
  failure.check(spelling == "1e+02", TextInvariant())
  let Some(flag) = std@1/json_access.element(value, 2) else {
    failure.check(false, TextInvariant())
    return Ok(())
  }
  failure.check(std@1/json_access.as_bool(flag) == Some(false), TextInvariant())
  let Some(text) = std@1/json_access.element(value, 3) else {
    failure.check(false, TextInvariant())
    return Ok(())
  }
  let Some(payload) = std@1/json_access.as_text(text) else {
    failure.check(false, TextInvariant())
    return Ok(())
  }
  failure.check(payload == "some string", TextInvariant())
  Ok(())
}
