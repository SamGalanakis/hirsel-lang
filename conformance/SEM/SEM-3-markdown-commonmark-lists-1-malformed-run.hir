// rule: SEM-3
// expect: run
// Published spec.txt vectors; tools/generate-markdown.py.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.check(
    s,
    "commonmark/Lists/301/malformed",
    "- foo\n- b\u{0}[&unterminated",
    "<ul>\n<li>foo</li>\n<li>b�[&amp;unterminated</li>\n</ul>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Lists/302/malformed",
    "1. foo\n2. \u{0}[&unterminated",
    "<ol>\n<li>foo</li>\n<li>�[&amp;unterminated</li>\n</ol>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Lists/303/malformed",
    "Foo\n- ba\u{0}[&unterminated",
    "<p>Foo</p>\n<ul>\n<li>ba�[&amp;unterminated</li>\n</ul>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Lists/304/malformed",
    "The number of windows in my house \u{0}[&unterminated",
    "<p>The number of windows in my house �[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
