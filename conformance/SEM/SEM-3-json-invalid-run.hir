// rule: SEM-3
// expect: run
pub fn main(rt: Io, args: Args) -> Result[(), OutputError] {
  // serde_json tests/test.rs number/string errors, pinned 20572a6d.
  let inputs: List[String] = [
    "NaN",
    "Infinity",
    "-Infinity",
    "+",
    ".",
    "-",
    "00",
    "0x80",
    "\\0",
    ".0",
    "0.",
    "1.",
    "1.a",
    "1.e1",
    "1e",
    "1e+",
    "1a",
    "[1,]",
    "{\"a\":1,}",
    "[",
    "{",
    "tru",
    "null true",
    "\"",
    "\"lol",
    "\"lol\"a",
    "\"\\uD83C\\uFFFF\"",
    "\"\n\"",
    "\"\u{1f}\"",
    "\"\\uD800\"",
    "\"\\uDC00\"",
    "\"\\uD800\\n\"",
    "\"\\uD800\\uD800\"",
    "\"\\uZZZZ\"",
    "\"\\x00\"",
    "{\"a\" 1}",
    "{1:2}",
    "[1 2]",
    "[false,]",
    "[1,{\"a\":[\"owned\",{\"b\":true}]}, invalid]"
  ]
  for text in inputs {
    match std@1/json.parse(copy text) {
      Error(Syntax(_)) => (),
      _ => failure.check(false, TextInvariant()),
    }
  }
  match std@1/json.parse("{\"a\":1,\"\\u0061\":2}") {
    Error(DuplicateKey(7)) => (),
    _ => failure.check(false, TextInvariant()),
  }
  match std@1/json.parse("[1,\"é\",?]") {
    Error(Syntax(8)) => (),
    _ => failure.check(false, TextInvariant()),
  }
  Ok(())
}
