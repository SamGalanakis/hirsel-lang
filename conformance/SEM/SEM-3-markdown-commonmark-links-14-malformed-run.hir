// rule: SEM-3
// expect: run
// Published spec.txt vectors; tools/generate-markdown.py.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.check(
    s,
    "commonmark/Links/543/malformed",
    "[foo]\n[bar]\n\n[ba\u{0}[&unterminated",
    "<p>[foo]\n[bar]</p>\n<p>[ba�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Links/544/malformed",
    "[foo]: /url1\n\n[foo]\u{0}[&unterminated",
    "<p><a href=\"/url1\">foo</a>�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Links/545/malformed",
    "[bar][foo\\!]\n\u{0}[&unterminated",
    "<p>[bar][foo!]\n�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Links/546/malformed",
    "[foo][ref[]\n\n\u{0}[&unterminated",
    "<p>[foo][ref[]</p>\n<p>�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
