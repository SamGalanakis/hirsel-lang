// rule: SEM-3
// expect: run
// Published spec.txt vectors; tools/generate-markdown.py.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.check(
    s,
    "commonmark/ATX headings/72/malformed",
    "# foo #####################\u{0}[&unterminated",
    "<h1>foo #####################�[&amp;unterminated</h1>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/ATX headings/73/malformed",
    "### foo \u{0}[&unterminated",
    "<h3>foo �[&amp;unterminated</h3>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/ATX headings/74/malformed",
    "### foo\u{0}[&unterminated",
    "<h3>foo�[&amp;unterminated</h3>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/ATX headings/75/malformed",
    "# f\u{0}[&unterminated",
    "<h1>f�[&amp;unterminated</h1>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/ATX headings/76/malformed",
    "### foo \\###\n## f\u{0}[&unterminated",
    "<h3>foo ###</h3>\n<h2>f�[&amp;unterminated</h2>\n",
    std@1/markdown.default_options()
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
