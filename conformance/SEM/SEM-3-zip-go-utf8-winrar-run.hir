// rule: SEM-3
// expect: run
// Go zip/reader_test.go:58-584 TestReader: utf8-winrar.zip.
pub fn main(t: Test) -> Result[(), ()] {
  let data = b"PK\x03\x04\x0a\x00\x00\x08\x00\x00-ifK\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x06\x00\x00\x00\xe4\xb8\x96\xe7\x95\x8cPK\x01\x02\x1f\x00\x0a\x00\x00\x08\x00\x00-ifK\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x06\x00$\x00\x00\x00\x00\x00\x00\x00\x80\x00\x00\x00\x00\x00\x00\x00\xe4\xb8\x96\xe7\x95\x8c\x0a\x00 \x00\x00\x00\x00\x00\x01\x00\x18\x00a\xca\xeb\x87CW\xd3\x01o\xbb\xf0\xdeCW\xd3\x01a\xca\xeb\x87CW\xd3\x01PK\x05\x06\x00\x00\x00\x00\x01\x00\x01\x00X\x00\x00\x00$\x00\x00\x00\x00\x00"
  let es = match zip.entries(data) {
    Ok(es) => es,
    Error(_) => return Error(()),
  }
  test.check(t, list.len(es) == 1)
  test.check(t, es[0].name == "世界" && es[0].size == 0)
  test.check(t, es[0].modified == Some(1510002567i64))
  test.check(t, zip.read(data, es[0], 4096) == Ok(b""))
  test.check(t, es[0].dos_time == 1265002797)
  Ok(())
}
