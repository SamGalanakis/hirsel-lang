// num-bigint tests/consts DIV_REM_QUADRUPLES (u32 digits) and tests/biguint.rs
// test_div_rem_big_multiple, plus a vector that takes Knuth D's add-back step (its
// first quotient estimate is one too large).
fn digits(xs: List[u32]) -> bigint.BigInt {
  let mut value = bigint.zero()
  let mut i = list.len(xs)
  while i > 0 {
    i -= 1
    value = bigint.add(bigint.shl(value, 32), bigint.from_u32(xs[i]))
  }
  value
}

fn quotient(a: List[u32], b: List[u32], q: List[u32], r: List[u32]) {
  failure.check(
    bigint.div_rem(digits(a), digits(b)) == (digits(q), digits(r)),
    Arithmetic()
  )
}

fn one() -> bigint.BigInt {
  bigint.from_u64(1)
}

pub fn main() -> Result[(), ()] {
  let n1: u32 = 4294967295
  let n2: u32 = 4294967294
  let half: u32 = 2147483648
  quotient([1], [2], [], [1])
  quotient([3], [2], [1], [1])
  quotient([1, 1], [2], [half], [1])
  quotient([1, 1, 1], [2], [half, half], [1])
  quotient([0, 1], [n1], [1], [1])
  quotient([n1, n1], [n2], [2, 1], [3])
  let a = bigint.pow(bigint.from_u64(3), 100)
  let a2 = bigint.mul(a, a)
  failure.check(bigint.div_rem(a2, a) == (copy a, bigint.zero()), Arithmetic())
  let a_less = bigint.sub(a, one())
  failure.check(
    bigint.div_rem(bigint.sub(a2, one()), a) == (copy a_less, copy a_less),
    Arithmetic()
  )
  let Ok(add_back_u) = bigint.parse_radix(
    "7fffffffffffffff80000000000000008000000000000000fffffffffffffffe",
    16
  ) else {
    return Error(())
  }
  let Ok(add_back_d) = bigint.parse_radix(
    "ffffffffffffffff00000000000000010000000000000002",
    16
  ) else {
    return Error(())
  }
  let add_back_q = bigint.from_u64(9223372036854775807)
  let add_back_r = bigint.sub(add_back_d, bigint.from_u64(2))
  failure.check(
    bigint.div_rem(add_back_u, add_back_d) == (add_back_q, add_back_r),
    Arithmetic()
  )
  Ok(())
}
