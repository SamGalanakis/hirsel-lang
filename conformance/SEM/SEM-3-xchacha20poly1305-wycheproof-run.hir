// rule: SEM-3
// expect: run
// steps: 5000000
// each case decodes and opens up to 129 bytes, about 164k steps a case
// Wycheproof xchacha20_poly1305_test.json (0.9rc5), part 1 of 1: for each
// key size and flag set with a 192-bit nonce, the first case of each of up to four message and data lengths
// up to 129 bytes, 17 of the 315 cases. A valid case opens to its message
// and an invalid one fails to open. Cases 1, 2, 3, 4, 5, 122, 123, 124, 146, 166, 186, 206, 216, 223, 224, 227, 281.
fn decode(text: String) -> unique Bytes {
  let Ok(data) = std@1/hex.decode(text) else {
    failure.check(false, TextInvariant())
    return bytes.from_list([])
  }
  data
}

fn check(
  key_hex: String,
  nonce_hex: String,
  data_hex: String,
  message_hex: String,
  sealed_hex: String,
  valid: bool
) -> () {
  match std@1/xchacha20poly1305.open(
    decode(key_hex),
    decode(nonce_hex),
    decode(sealed_hex),
    decode(data_hex)
  ) {
    Ok(message) => {
      failure.check(valid, TextInvariant())
      failure.check(std@1/hex.encode(message) == message_hex, TextInvariant())
    },
    Error(AuthenticationFailed()) => failure.check(!valid, TextInvariant()),
  }
}

