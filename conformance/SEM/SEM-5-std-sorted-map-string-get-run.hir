// rule: SEM-5
// expect: run
// Owned counted lookups, empty values and missing keys match ordered-map access.
pub fn main(t: Test) -> Result[(), ()] {
  let by = u64.order
  let mut m: unique SortedMap[u64, String] of by = sorted_map.empty(by)
  u64_maps.insert(mut m, 9, "nine")
  u64_maps.insert(mut m, 0, "")
  u64_maps.insert(mut m, 5, "five")
  let first = u64_maps.get(m, 5)
  let second = u64_maps.get(m, 5)
  failure.check(first == Some("five") && second == Some("five"), Bounds())
  failure.check(u64_maps.get(m, 0) == Some(""), Bounds())
  failure.check(u64_maps.get(m, 9) == Some("nine"), Bounds())
  failure.check(u64_maps.get(m, 4) == None, Bounds())
  failure.check(u64_maps.len(m) == 3, Bounds())
  Ok(())
}
