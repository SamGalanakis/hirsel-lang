// rule: SEM-5
// expect: run
// Owned counted lookups, empty values and missing keys match ordered-map access.
pub fn main(t: Test) -> Result[(), ()] {
  let by = u64.order
  let mut m: unique SortedMap[u64, String] of by = sorted_map.empty(by)
  sorted_map.insert(by, mut m, 9, "nine")
  sorted_map.insert(by, mut m, 0, "")
  sorted_map.insert(by, mut m, 5, "five")
  let first = sorted_map.get(by, m, 5)
  let second = sorted_map.get(by, m, 5)
  failure.check(first == Some("five") && second == Some("five"), Bounds())
  failure.check(sorted_map.get(by, m, 0) == Some(""), Bounds())
  failure.check(sorted_map.get(by, m, 9) == Some("nine"), Bounds())
  failure.check(sorted_map.get(by, m, 4) == None, Bounds())
  failure.check(sorted_map.len(by, m) == 3, Bounds())
  Ok(())
}
