// rule: SEM-3
// expect: run
// Published spec.txt vectors; tools/generate-markdown.py.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.check(
    s,
    "commonmark/Hard line breaks/640",
    "`code  \nspan`\n",
    "<p><code>code   span</code></p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Hard line breaks/641",
    "`code\\\nspan`\n",
    "<p><code>code\\ span</code></p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Hard line breaks/642",
    "<a href=\"foo  \nbar\">\n",
    "<p><a href=\"foo  \nbar\"></p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Hard line breaks/643",
    "<a href=\"foo\\\nbar\">\n",
    "<p><a href=\"foo\\\nbar\"></p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Hard line breaks/644",
    "foo\\\n",
    "<p>foo\\</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Hard line breaks/645",
    "foo  \n",
    "<p>foo</p>\n",
    std@1/markdown.default_options()
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
