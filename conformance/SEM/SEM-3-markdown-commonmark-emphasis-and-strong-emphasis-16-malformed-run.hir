    "foo \u{0}[&unterminated",
    "<p>foo �[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Emphasis and strong emphasis/439/malformed",
    "foo *\u{0}[&unterminated",
    "<p>foo *�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Emphasis and strong emphasis/440/malformed",
    "foo *\u{0}[&unterminated",
    "<p>foo *�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
