// rule: SEM-3
// expect: run
// Published spec.txt vectors; tools/generate-markdown.py.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.check(
    s,
    "commonmark/HTML blocks/176/malformed",
    "<style>p{color:re\u{0}[&unterminated",
    "<style>p{color:re�[&unterminated\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/HTML blocks/177/malformed",
    "<!-- foo -->\u{0}[&unterminated",
    "<!-- foo -->�[&unterminated\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/HTML blocks/178/malformed",
    "<script>\nfoo\n</\u{0}[&unterminated",
    "<script>\nfoo\n</�[&unterminated\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/HTML blocks/179/malformed",
    "<!-- Foo\n\nbar\n \u{0}[&unterminated",
    "<!-- Foo\n\nbar\n �[&unterminated\n",
    std@1/markdown.default_options()
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
