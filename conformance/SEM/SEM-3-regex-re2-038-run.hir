  check("^^^^^^^^\\b$$$$$$$", "", None())?
  // src/regexp/testdata/re2-search.txt:1466
  check("^^^^^^^^\\b$$$$$$$", "x", None())?
  // src/regexp/testdata/re2-search.txt:1468
  check("^(?:^^^^^^^^\\b$$$$$$$)$", "", None())?
  // src/regexp/testdata/re2-search.txt:1469
  check("^(?:^^^^^^^^\\b$$$$$$$)$", "x", None())?
  // src/regexp/testdata/re2-search.txt:1471
  check("^(?:^^^^^^^^\\b$$$$$$$)", "", None())?
  // src/regexp/testdata/re2-search.txt:1472
  check("^(?:^^^^^^^^\\b$$$$$$$)", "x", None())?
  // src/regexp/testdata/re2-search.txt:1474
