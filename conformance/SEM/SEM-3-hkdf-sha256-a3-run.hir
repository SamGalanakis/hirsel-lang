// rule: SEM-3
// expect: run
// RFC 5869 test case 3 (HKDF-SHA-256), through hkdf.derive.
pub fn main() -> Result[(), ()] {
  let okm = std@1/hkdf.derive(
    std@1/sha256.hash,
    b"",
    b"\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b",
    b"",
    42
  )
  failure.check(
    std@1/hex.encode(okm) == "8da4e775a563c18f715f802a063c5a31b8a11f5c5ee1879ec3454e5f3c738d2d9d201395faa4b61a96c8",
    TextInvariant()
  )
  Ok(())
}
