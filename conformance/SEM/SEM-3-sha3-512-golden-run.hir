// rule: SEM-3
// expect: run
// Zig std/crypto/sha3.zig SHA3-512 vectors (FIPS 202 examples), one-shot and streamed.
fn check(input: String, expected: String) -> () {
  failure.check(
    std@1/sha3_512.digest_hex(string.as_bytes(input)) == expected,
    TextInvariant()
  )
}

pub fn main() -> Result[(), ()] {
  check(
    "",
    "a69f73cca23a9ac5c8b567dc185a756e97c982164fe25859e0d1dcc1475c80a615b2123af1f5f94c11e3e9402c3ac558f500199d95b6d3e301758586281dcd26"
  )
  check(
    "abc",
    "b751850b1a57168a5693cd924b6b096e08f621827444f70d884f5d0240d2712e10e116e9192af3c91a7ec57647e3934057340b4cf408d5a56592f8274eec53f0"
  )
  check(
    "abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu",
    "afebb2ef542e6579c50cad06d2e578f9f8dd6881d7dc824d26360feebf18a4fa73e3261122948efcfd492e74e82e2189ed0fb440d187f382270cb455f21dd185"
  )
  let mut state = std@1/sha3_512.new()
  std@1/sha3_512.update(mut state, b"a")
  std@1/sha3_512.update(mut state, b"")
  std@1/sha3_512.update(mut state, b"b")
  std@1/sha3_512.update(mut state, b"c")
  failure.check(
    std@1/hex.encode(std@1/bytes.from_inline(std@1/sha3_512.finish(take state))) == "b751850b1a57168a5693cd924b6b096e08f621827444f70d884f5d0240d2712e10e116e9192af3c91a7ec57647e3934057340b4cf408d5a56592f8274eec53f0",
    TextInvariant()
  )
  Ok(())
}
