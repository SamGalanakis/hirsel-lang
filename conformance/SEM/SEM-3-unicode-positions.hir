// rule: SEM-3
// expect: run
// stdout: ok
// "built-in views over a borrowed string ... are loop sources like sequences".
fn output_error[E](take e: E) -> () {}

pub fn main(rt: Io, args: Args) -> Result[(), ()] {
  let s: String = "é😀"
  let mut valid: bool = true
  for pos in string.positions(s) {
    let slice = string.slice(s, pos, pos)
    if slice != "" {
      valid = false
    }
  }
  out.print(
    io.stdout(rt) ? grant_error,
    if valid {
      "ok\n"
    } else {
      "bad\n"
    }
  ) ? output_error
  Ok(())
}

@noalloc
fn grant_error(refusal: GrantError) -> () uses {} {
  ()
}
