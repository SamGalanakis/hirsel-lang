// rule: SEM-3
// expect: run
// Generated by tools/generate-json-vectors.py; see docs/json-domain-vectors.md.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.parses(s, "n_number_hex_2_digits.json:1", "[0x42]", 1)
  failed += harness.parses(s, "n_number_infinity.json:1", "[Infinity]", 1)
  failed += harness.parses(s, "n_number_invalid+-.json:1", "[0e+-1]", 1)
  failed += harness.parses(
    s,
    "n_number_invalid-negative-real.json:1",
    "[-123.123foo]",
    1
  )
  failed += harness.invalid_utf8(
    s,
    "n_number_invalid-utf-8-in-bigger-int.json:1",
    b"\x5b\x31\x32\x33\xe5\x5d"
  )
  failed += harness.invalid_utf8(
    s,
    "n_number_invalid-utf-8-in-exponent.json:1",
    b"\x5b\x31\x65\x31\xe5\x5d"
  )
  failed += harness.invalid_utf8(
    s,
    "n_number_invalid-utf-8-in-int.json:1",
    b"\x5b\x30\xe5\x5d\x0a"
  )
  failed += harness.parses(s, "n_number_minus_infinity.json:1", "[-Infinity]", 1)
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
