// rule: SEM-3
// expect: run
// Pinned upstream vectors; tools/generate-markdown-hostile.py.
// commonmark.js test/test.js:178-300; 24 #172
// Each program is bounded by the corpus step budget and runner timeout.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  let mut options = std@1/markdown.default_options()
  failed += harness.check(
    s,
    "js-pathological/12",
    "*_* _ *_* _ *_* _ *_* _ *_* _ *_* _ *_* _ *_* _ *_* _ *_* _ *_* _ *_* _ *_* _ *_* _ *_* _ *_* _ *_* _ *_* _ *_* _ *_* _ *_* _ *_* _ *_* _ *_* _ ",
    "<p><em>_</em> _ <em>_</em> _ <em>_</em> _ <em>_</em> _ <em>_</em> _ <em>_</em> _ <em>_</em> _ <em>_</em> _ <em>_</em> _ <em>_</em> _ <em>_</em> _ <em>_</em> _ <em>_</em> _ <em>_</em> _ <em>_</em> _ <em>_</em> _ <em>_</em> _ <em>_</em> _ <em>_</em> _ <em>_</em> _ <em>_</em> _ <em>_</em> _ <em>_</em> _ <em>_</em> _</p>\n",
    options
  )
  failed += harness.check(
    s,
    "js-pathological/12/malformed",
    "*_* _ *_* _ *_* _ *_* _ *_* _ *_* _ *_* _ *_* _ *_* _ *_* _ *_* _ *_* _ \u{0}[&unterminated",
    "<p><em>_</em> _ <em>_</em> _ <em>_</em> _ <em>_</em> _ <em>_</em> _ <em>_</em> _ <em>_</em> _ <em>_</em> _ <em>_</em> _ <em>_</em> _ <em>_</em> _ <em>_</em> _ �[&amp;unterminated</p>\n",
    options
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
