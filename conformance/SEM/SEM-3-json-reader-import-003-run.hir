// rule: SEM-3
// expect: run
// JSONTestSuite 1ef36fa01286573e846ac449e8683f8833c5b26a test_parsing/*.json:1.
// Differential reader twin of the existing imports; exact JsonError offsets.
fn check(t: Test, source: String) -> () {
  let expected: Result[(), json.JsonError] = match json.parse(unique source) {
    Ok(_) => Ok(()),
    Error(e) => Error(e),
  }
  let mut cursor = json.reader(string.as_bytes(source))
  let actual = match json.skip(mut cursor) {
    Ok(()) => json.finish_reader(mut cursor),
    Error(e) => Error(e),
  }
  test.equal(t, actual, expected)
}

pub fn main(t: Test) -> Result[(), ()] {
  // "i_string_invalid_lonely_surrogate.json:1"
  check(t, "[\"\\ud800\"]")
  // "i_string_invalid_surrogate.json:1"
  check(t, "[\"\\ud800abc\"]")
  // "i_string_inverted_surrogates_U+1D11E.json:1"
  check(t, "[\"\\uDd1e\\uD834\"]")
  // "i_string_lone_second_surrogate.json:1"
  check(t, "[\"\\uDFAA\"]")
  // "i_structure_500_nested_arrays.json:1"
  check(
    t,
    "[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]"
  )
  // "i_structure_UTF-8_BOM_empty_object.json:1"
  check(t, "\u{feff}{}")
  // "n_array_1_true_without_comma.json:1"
  check(t, "[1 true]")
  // "n_array_colon_instead_of_comma.json:1"
  check(t, "[\"\": 1]")
  Ok(())
}
