// rule: SEM-3
// expect: run
// Go zip/reader_test.go:58-584 TestReader: time-winrar.zip.
pub fn main(t: Test) -> Result[(), ()] {
  let data = b"PK\x03\x04\x0a\x00\x00\x00\x00\x00|\xa9_K\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x08\x00\x00\x00test.txtPK\x01\x02\x1f\x00\x0a\x00\x00\x00\x00\x00|\xa9_K\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x08\x00$\x00\x00\x00\x00\x00\x00\x00\x80\x00\x00\x00\x00\x00\x00\x00test.txt\x0a\x00 \x00\x00\x00\x00\x00\x01\x00\x18\x00\xb3?\xd9\x8e\xc7R\xd3\x01\xfeG\xf3\xbf\xc7R\xd3\x01\xb3?\xd9\x8e\xc7R\xd3\x01PK\x05\x06\x00\x00\x00\x00\x01\x00\x01\x00Z\x00\x00\x00&\x00\x00\x00\x00\x00"
  let es = match zip.entries(data) {
    Ok(es) => es,
    Error(_) => return Error(()),
  }
  test.check(t, list.len(es) == 1)
  test.check(t, es[0].name == "test.txt" && es[0].size == 0)
  test.check(t, es[0].modified == Some(1509509517i64))
  test.check(t, zip.read(data, es[0], 4096) == Ok(b""))
  test.check(t, es[0].dos_time == 1264560508)
  Ok(())
}
