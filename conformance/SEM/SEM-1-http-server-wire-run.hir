// rule: SEM-1
// expect: run
// entry: main
fn network_error(e: NetError) -> () uses {} {
  ()
}

fn http_error(e: http.HttpError) -> () uses {} {
  ()
}

pub fn main(t: Test) -> Result[(), ()] {
  let n = test.net(
    t,
    [
      NetPeer(
        address: "example.com",
        port: 80u16,
        resolves_to: [V4([127u8, 0u8, 0u8, 1u8])],
        tls: Plain(),
        connections: [
          Open(
            [
              Send(
                b"POST /submit HTTP/1.1\r\nHost: example.com\r\nContent-Length: 3\r\n\r\nabc"
              ),
              Expect(
                b"HTTP/1.1 200 \r\nContent-Length: 3\r\nConnection: close\r\n\r\nabc"
              ),
              Close()
            ]
          )
        ]
      )
    ]
  )
  let mut s = net.connect(n, "example.com", 80u16, Unbounded()) ? network_error
  let incoming = http.receive_request(n, mut s, 1024, 3) ? http_error
  test.check(
    t,
    incoming.method == "POST" && incoming.target == "/submit" && incoming.body == b"abc"
  )
  http.respond(n, mut s, 200u16, [], incoming.body) ? http_error
  net.close(n, take s)
  Ok(())
}
