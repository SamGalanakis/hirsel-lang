// rule: SEM-1
// expect: run
// entry: main
fn network_error(e: NetError) -> () uses {} {
  ()
}

fn http_error(e: http.HttpError) -> () uses {} {
  ()
}

pub fn main(t: Test) -> Result[(), ()] {
  let n = test.net(
    t,
    [
      NetPeer(
        address: "example.com",
        port: 80u16,
        resolves_to: [V4([127u8, 0u8, 0u8, 1u8])],
        tls: Plain(),
        connections: [
          Open(
            [
              Send(
                b"POST /submit HTTP/1.1\r\nHost: example.com\r\nContent-Length: 3\r\n\r\nabc"
              ),
              Expect(
                b"HTTP/1.1 200 \r\nContent-Length: 3\r\nConnection: close\r\n\r\nabc"
              ),
              Close()
            ]
          )
        ]
      )
    ],
    []
  )
  let mut s = net.connect(n, "example.com", 80u16, Unbounded()) ? network_error
  let mut config = http.default_config()
  config.max_head_bytes = 1024
  config.max_body_bytes = 3
  let mut connection = http.server_connection(test.tasks(t), n, take s, config)
  let Some((current1, incoming)) = http.next_stream(mut connection, None()) ? http_error else {
    return Error(())
  }
  let mut exchange1 = take current1
  test.check(
    t,
    incoming.method == "POST" && incoming.target == "/submit" && incoming.body == b"abc"
  )
  http.respond(mut exchange1, 200u16, [], incoming.body, true) ? http_error
  Ok(())
}
