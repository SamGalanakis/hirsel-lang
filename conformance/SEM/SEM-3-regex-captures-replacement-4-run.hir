// rule: SEM-3
// expect: run
// Go ebe2feef capture/flag/replacement vectors (BSD-3-Clause).
// RE2 data Copyright 2009 The RE2 Authors (BSD-3-Clause).
fn check(
  pattern: String,
  input: String,
  replacement: String,
  expected: String,
  literal: bool
) -> Result[(), ()] {
  let Ok(re) = regex.compile(pattern, 10000) else {
    return Error(())
  }
  let actual = if literal {
    regex.replace_all_literal(re, input, replacement, 1000000)
  } else {
    regex.replace_all(re, input, replacement, 1000000)
  }
  failure.check(actual == Ok(expected), TextInvariant())
  Ok(())
}

pub fn main() -> Result[(), ()] {
  // Go all_test.go:179
  check("[a-c]*$", "", "x", "x", false)?
  // Go all_test.go:180
  check("^[a-c]*$", "", "x", "x", false)?
  // Go all_test.go:182
  check("^[a-c]+", "abcdabc", "x", "xdabc", false)?
  // Go all_test.go:183
  check("[a-c]+$", "abcdabc", "x", "abcdx", false)?
  // Go all_test.go:184
  check("^[a-c]+$", "abcdabc", "x", "abcdabc", false)?
  // Go all_test.go:185
  check("^[a-c]+", "abc", "x", "x", false)?
  // Go all_test.go:186
  check("[a-c]+$", "abc", "x", "x", false)?
  // Go all_test.go:187
  check("^[a-c]+$", "abc", "x", "x", false)?
  Ok(())
}
