// rule: SEM-3
// expect: run
// stdout: nfc
pub fn main(rt: Io, args: Args) -> Result[(), LaunchError] {
  match string.from_bytes(b"e\xcc\x81") {
    Ok(text) => failure.check(
      std@1/unicode.normalize_nfc(text) == "\u{e9}",
      TextInvariant()
    ),
    Error(_) => failure.check(false, TextInvariant()),
  }
  out.print(io.stdout(rt) ? Grant, "nfc\n") ? Output
  Ok(())
}

pub type LaunchError = Grant(GrantError) | Output(OutputError)
