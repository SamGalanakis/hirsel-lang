// rule: SEM-3
// expect: run
// Zig path.zig/epoch.zig bff490a23889750de7096d9057c0a432efc929a8 vectors.
// Rust core/src/time.rs f6c1107f8be13e48465e12c0fd26e6a39fe18e4f unit vectors.
fn check_join(base: String, child: String, expected: String) -> () uses {} {
  match std@1/path.join(path.of(base), path.of(child)) {
    Ok(value) => failure.check(path.text(value) == expected, TextInvariant()),
    Error(_) => failure.check(false, TextInvariant()),
  }
}

fn check_parent(input: String, expected: String) -> () uses {} {
  match std@1/path.parent(path.of(input)) {
    Some(value) => failure.check(path.text(value) == expected, TextInvariant()),
    None() => failure.check(false, TextInvariant()),
  }
}

fn check_epoch(seconds: i128, expected: String) -> () uses {} {
  match std@1/time.format(std@1/time.Timestamp(unix_nanoseconds: seconds * 1000000000)) {
    Ok(text) => failure.check(text == expected, TextInvariant()),
    Error(_) => failure.check(false, Arithmetic()),
  }
  match std@1/time.parse(expected) {
    Ok(value) => failure.check(
      value.unix_nanoseconds == seconds * 1000000000,
      Arithmetic()
    ),
    Error(_) => failure.check(false, Arithmetic()),
  }
}

fn check_leap(text: String, valid: bool) -> () uses {} {
  match std@1/time.parse(text) {
    Ok(_) => failure.check(valid, Arithmetic()),
    Error(_) => failure.check(!valid, Arithmetic()),
  }
}

fn check_fraction(nanos: i32, expected: String) -> () uses {} {
  let value = std@1/duration.from_parts(0, nanos)
  failure.check(std@1/duration.format(value) == expected, TextInvariant())
  match std@1/duration.parse(expected) {
    Ok(parsed) => failure.check(parsed.nanoseconds == value.nanoseconds, Arithmetic()),
    Error(_) => failure.check(false, Arithmetic()),
  }
}

pub fn main(rt: Io, args: Args) -> Result[(), ()] {
  check_join("a", "../../..", "../..")
  check_join("..", "../../foo", "../../../foo")
  check_join("a/b/c/", "../../..", ".")
  check_parent("/a/b/c", "/a/b")
  check_parent("/a/b/c///", "/a/b")
  check_parent("/a", "/")
  check_parent("a", ".")
  check_parent("a//", ".")
  failure.check(
    std@1/path.filename(path.of("/dir/basename.ext")) == "basename.ext",
    TextInvariant()
  )
  failure.check(
    std@1/path.filename(path.of("basename.ext//")) == "basename.ext",
    TextInvariant()
  )
  failure.check(std@1/path.filename(path.of("/aaa/")) == "aaa", TextInvariant())
  failure.check(std@1/path.filename(path.of("//a")) == "a", TextInvariant())
  failure.check(std@1/path.filename(path.of("")) == "", TextInvariant())
  failure.check(std@1/path.extension(path.of(".gitignore")) == "", TextInvariant())
  failure.check(std@1/path.extension(path.of(".image.png")) == "png", TextInvariant())
  failure.check(std@1/path.extension(path.of("file.ext.")) == "", TextInvariant())
  failure.check(
    std@1/path.extension(path.of("very-long-file.bruh")) == "bruh",
    TextInvariant()
  )
  failure.check(std@1/path.extension(path.of("/a.b.c/")) == "c", TextInvariant())
  failure.check(
    std@1/path.components(path.of("/a//b/c///")) == ["a", "b", "c"],
    TextInvariant()
  )
  match std@1/path.normalize(path.of("a/b/c/../../..")) {
    Ok(value) => failure.check(path.text(value) == ".", TextInvariant()),
    Error(_) => failure.check(false, TextInvariant()),
  }
  check_epoch(0, "1970-01-01T00:00:00Z")
  check_epoch(31535999, "1970-12-31T23:59:59Z")
  check_epoch(1622924906, "2021-06-05T20:28:26Z")
  check_epoch(1625159473, "2021-07-01T17:11:13Z")
  check_leap("2095-02-29T00:00:00Z", false)
  check_leap("2096-02-29T00:00:00Z", true)
  check_leap("2100-02-29T00:00:00Z", false)
  check_leap("2400-02-29T00:00:00Z", true)
  failure.check(
    std@1/duration.from_parts(1, 1000000000).nanoseconds == 2000000000i128,
    Arithmetic()
  )
  failure.check(
    std@1/duration.format(std@1/duration.from_parts(1, 123456789)) == "1.123456789s",
    TextInvariant()
  )
  match std@1/duration.parse("1.123456789s") {
    Ok(value) => failure.check(value.nanoseconds == 1123456789, Arithmetic()),
    Error(_) => failure.check(false, Arithmetic()),
  }
  // Ported Rust coretests/tests/time.rs secs/subsec_nanos boundary cases.
  check_fraction(0, "0s")
  check_fraction(500000005, "0.500000005s")
  check_fraction(1050000001, "1.050000001s")
  check_fraction(999999999, "0.999999999s")
  check_fraction(1000000001, "1.000000001s")
  Ok(())
}
