// rule: SEM-3
// expect: run
// Published spec.txt vectors; tools/generate-markdown.py.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.check(
    s,
    "commonmark/ATX headings/62/malformed",
    "# foo\n## foo\n### foo\n####\u{0}[&unterminated",
    "<h1>foo</h1>\n<h2>foo</h2>\n<h3>foo</h3>\n<p>####�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/ATX headings/63/malformed",
    "######\u{0}[&unterminated",
    "<p>######�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/ATX headings/64/malformed",
    "#5 bolt\n\n\u{0}[&unterminated",
    "<p>#5 bolt</p>\n<p>�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/ATX headings/65/malformed",
    "\\## \u{0}[&unterminated",
    "<p>## �[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/ATX headings/66/malformed",
    "# foo *bar\u{0}[&unterminated",
    "<h1>foo *bar�[&amp;unterminated</h1>\n",
    std@1/markdown.default_options()
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
