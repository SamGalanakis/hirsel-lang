// rule: SEM-3
// expect: run
// Published spec.txt vectors; tools/generate-markdown.py.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.check(
    s,
    "commonmark/Links/569",
    "[foo][bar][baz]\n\n[baz]: /url\n",
    "<p>[foo]<a href=\"/url\">bar</a></p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Links/570",
    "[foo][bar][baz]\n\n[baz]: /url1\n[bar]: /url2\n",
    "<p><a href=\"/url2\">foo</a><a href=\"/url1\">baz</a></p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Links/571",
    "[foo][bar][baz]\n\n[baz]: /url1\n[foo]: /url2\n",
    "<p>[foo]<a href=\"/url1\">bar</a></p>\n",
    std@1/markdown.default_options()
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
