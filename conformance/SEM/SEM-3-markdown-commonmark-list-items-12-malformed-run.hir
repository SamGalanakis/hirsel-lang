// rule: SEM-3
// expect: run
// Published spec.txt vectors; tools/generate-markdown.py.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.check(
    s,
    "commonmark/List items/297/malformed",
    "10) foo\n\u{0}[&unterminated",
    "<ol start=\"10\">\n<li>foo\n�[&amp;unterminated</li>\n</ol>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/List items/298/malformed",
    "- - \u{0}[&unterminated",
    "<ul>\n<li>\n<ul>\n<li>�[&amp;unterminated</li>\n</ul>\n</li>\n</ul>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/List items/299/malformed",
    "1. - 2\u{0}[&unterminated",
    "<ol>\n<li>\n<ul>\n<li>2�[&amp;unterminated</li>\n</ul>\n</li>\n</ol>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/List items/300/malformed",
    "- # Foo\n- Bar\u{0}[&unterminated",
    "<ul>\n<li>\n<h1>Foo</h1>\n</li>\n<li>Bar�[&amp;unterminated</li>\n</ul>\n",
    std@1/markdown.default_options()
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
