// rule: SEM-2
// expect: run
// Independent integer rational oracle; sum normal significands in units of 2^-50, then round once to 24 bits.
pub fn main(t: Test) -> Result[(), ()] {
  let xs: Array[f32] = [
    core@1/f32.from_bits(3013528834u32),
    core@1/f32.from_bits(864649704u32),
    core@1/f32.from_bits(3020338131u32),
    core@1/f32.from_bits(3213378754u32),
    core@1/f32.from_bits(3095517823u32),
    core@1/f32.from_bits(3172109868u32),
    core@1/f32.from_bits(3220270622u32),
    core@1/f32.from_bits(2990043169u32),
    core@1/f32.from_bits(1166520954u32),
    core@1/f32.from_bits(1211797988u32),
    core@1/f32.from_bits(3400223798u32),
    core@1/f32.from_bits(955450800u32),
    core@1/f32.from_bits(1095208883u32),
    core@1/f32.from_bits(3283728413u32),
    core@1/f32.from_bits(3173424033u32)
  ]
  core@1/test.check(t, core@1/f32.bits(f32.sum_exact(xs)) == 3399833742u32)
  Ok(())
}
