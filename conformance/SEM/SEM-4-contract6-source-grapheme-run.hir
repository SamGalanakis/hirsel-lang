// rule: SEM-4
// expect: run
// stdout: ok
@loop_source(open, next)
type GraphemeView {
  source: String,
}

type Cursor {
  source: String,
  position: u64,
}

@noalloc
fn view(s: String) -> GraphemeView in s {
  GraphemeView(source: copy s)
}

@noalloc
fn open(v: GraphemeView) -> Cursor in v {
  Cursor(source: copy v.source, position: 0)
}

@noalloc
fn next(mut it: Cursor) -> Option[String] in it {
  if it.position == 0 {
    it.position = 1
    Some(copy it.source)
  } else {
    None
  }
}

@noalloc
fn visit(s: String) -> u64 {
  let mut n: u64 = 0
  for piece in view(s) {
    n += string.byte_len(piece)
  }
  n
}

pub fn main(rt: Io, args: Args) -> Result[(), GrantError] {
  let _ = out.print(
    io.stdout(rt)?,
    if visit("a") == 1u64 {
      "ok\n"
    } else {
      "bad\n"
    }
  )
  Ok(())
}
