// rule: SEM-3
// expect: run
// Go ebe2feef capture/flag/replacement vectors (BSD-3-Clause).
// RE2 data Copyright 2009 The RE2 Authors (BSD-3-Clause).
fn check(
  pattern: String,
  input: String,
  replacement: String,
  expected: String,
  literal: bool
) -> Result[(), ()] {
  let Ok(re) = regex.compile(pattern, 10000) else {
    return Error(())
  }
  let actual = if literal {
    regex.replace_all_literal(re, input, replacement, 1000000)
  } else {
    regex.replace_all(re, input, replacement, 1000000)
  }
  failure.check(actual == Ok(expected), TextInvariant())
  Ok(())
}

pub fn main() -> Result[(), ()] {
  // Go all_test.go:188
  check("^[a-c]+", "dabce", "x", "dabce", false)?
  // Go all_test.go:189
  check("[a-c]+$", "dabce", "x", "dabce", false)?
  // Go all_test.go:190
  check("^[a-c]+$", "dabce", "x", "dabce", false)?
  // Go all_test.go:191
  check("^[a-c]+", "", "x", "", false)?
  // Go all_test.go:192
  check("[a-c]+$", "", "x", "", false)?
  // Go all_test.go:193
  check("^[a-c]+$", "", "x", "", false)?
  // Go all_test.go:196
  check("abc", "abcdefg", "def", "defdefg", false)?
  // Go all_test.go:197
  check("bc", "abcbcdcdedef", "BC", "aBCBCdcdedef", false)?
  Ok(())
}
