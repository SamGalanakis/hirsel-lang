// rule: SEM-3
// expect: run
// Published spec.txt vectors; tools/generate-markdown.py.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.check(
    s,
    "commonmark/Links/512/malformed",
    "[link [foo [\u{0}[&unterminated",
    "<p>[link [foo [�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Links/513/malformed",
    "[link] ba\u{0}[&unterminated",
    "<p>[link] ba�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Links/514/malformed",
    "[link [ba\u{0}[&unterminated",
    "<p>[link [ba�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Links/515/malformed",
    "[link \\[b\u{0}[&unterminated",
    "<p>[link [b�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Links/516/malformed",
    "[link *foo **ba\u{0}[&unterminated",
    "<p>[link *foo **ba�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
