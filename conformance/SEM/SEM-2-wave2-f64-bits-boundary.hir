// rule: SEM-2
// expect: run
pub fn main(t: Test) -> Result[(), ()] {
  core@1/test.check(t, core@1/f64.bits(core@1/f64.from_bits(0u64)) == 0u64)
  core@1/test.check(
    t,
    core@1/f64.bits(core@1/f64.from_bits(9223372036854775808u64)) == 9223372036854775808u64
  )
  core@1/test.check(t, core@1/f64.bits(core@1/f64.from_bits(1u64)) == 1u64)
  core@1/test.check(
    t,
    core@1/f64.bits(core@1/f64.from_bits(9223372036854775809u64)) == 9223372036854775809u64
  )
  core@1/test.check(
    t,
    core@1/f64.bits(core@1/f64.from_bits(9218868437227405312u64)) == 9218868437227405312u64
  )
  core@1/test.check(
    t,
    core@1/f64.bits(core@1/f64.from_bits(18446744073709551615u64)) == 9221120237041090560u64
  )
  core@1/test.check(
    t,
    core@1/f64.bits(core@1/f64.from_bits(9218868437227405311u64)) == 9218868437227405311u64
  )
  core@1/test.check(
    t,
    core@1/f64.bits(core@1/f64.from_bits(9221120237041090560u64)) == 9221120237041090560u64
  )
  core@1/test.check(
    t,
    core@1/f64.bits(core@1/f64.from_bits(9218868437227405313u64)) == 9221120237041090560u64
  )
  core@1/test.check(
    t,
    core@1/f64.bits(core@1/f64.from_bits(18444492273895866368u64)) == 9221120237041090560u64
  )
  Ok(())
}
