// rule: SEM-3
// expect: run
// JSONTestSuite 1ef36fa01286573e846ac449e8683f8833c5b26a test_parsing/*.json:1.
// Differential reader twin of the existing imports; exact JsonError offsets.
fn check(t: Test, source: String) -> () {
  let expected: Result[(), json.JsonError] = match json.parse(unique source) {
    Ok(_) => Ok(()),
    Error(e) => Error(e),
  }
  let mut cursor = json.reader(string.as_bytes(source))
  let actual = match json.skip(mut cursor) {
    Ok(()) => json.finish_reader(mut cursor),
    Error(e) => Error(e),
  }
  test.equal(t, actual, expected)
}

pub fn main(t: Test) -> Result[(), ()] {
  // "y_string_unicodeEscapedBackslash.json:1"
  check(t, "[\"\\u005C\"]")
  // "y_string_unicode_2.json:1"
  check(t, "[\"⍂㈴⍂\"]")
  // "y_string_unicode_U+10FFFE_nonchar.json:1"
  check(t, "[\"\\uDBFF\\uDFFE\"]")
  // "y_string_unicode_U+1FFFE_nonchar.json:1"
  check(t, "[\"\\uD83F\\uDFFE\"]")
  // "y_string_unicode_U+200B_ZERO_WIDTH_SPACE.json:1"
  check(t, "[\"\\u200B\"]")
  // "y_string_unicode_U+2064_invisible_plus.json:1"
  check(t, "[\"\\u2064\"]")
  // "y_string_unicode_U+FDD0_nonchar.json:1"
  check(t, "[\"\\uFDD0\"]")
  // "y_string_unicode_U+FFFE_nonchar.json:1"
  check(t, "[\"\\uFFFE\"]")
  Ok(())
}
