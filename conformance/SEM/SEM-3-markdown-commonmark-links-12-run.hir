// rule: SEM-3
// expect: run
// Published spec.txt vectors; tools/generate-markdown.py.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.check(
    s,
    "commonmark/Links/535",
    "[foo *bar][ref]*\n\n[ref]: /uri\n",
    "<p><a href=\"/uri\">foo *bar</a>*</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Links/536",
    "[foo <bar attr=\"][ref]\">\n\n[ref]: /uri\n",
    "<p>[foo <bar attr=\"][ref]\"></p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Links/537",
    "[foo`][ref]`\n\n[ref]: /uri\n",
    "<p>[foo<code>][ref]</code></p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Links/538",
    "[foo<https://example.com/?search=][ref]>\n\n[ref]: /uri\n",
    "<p>[foo<a href=\"https://example.com/?search=%5D%5Bref%5D\">https://example.com/?search=][ref]</a></p>\n",
    std@1/markdown.default_options()
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
