// rule: SEM-3
// expect: run
// Published spec.txt vectors; tools/generate-markdown.py.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.check(
    s,
    "commonmark/HTML blocks/151",
    "</div>\n*foo*\n",
    "</div>\n*foo*\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/HTML blocks/152",
    "<DIV CLASS=\"foo\">\n\n*Markdown*\n\n</DIV>\n",
    "<DIV CLASS=\"foo\">\n<p><em>Markdown</em></p>\n</DIV>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/HTML blocks/153",
    "<div id=\"foo\"\n  class=\"bar\">\n</div>\n",
    "<div id=\"foo\"\n  class=\"bar\">\n</div>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/HTML blocks/154",
    "<div id=\"foo\" class=\"bar\n  baz\">\n</div>\n",
    "<div id=\"foo\" class=\"bar\n  baz\">\n</div>\n",
    std@1/markdown.default_options()
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
