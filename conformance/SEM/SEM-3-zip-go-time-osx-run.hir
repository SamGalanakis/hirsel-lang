// rule: SEM-3
// expect: run
// Go zip/reader_test.go:58-584 TestReader: time-osx.zip.
pub fn main(t: Test) -> Result[(), ()] {
  let data = b"PK\x03\x04\x0a\x00\x00\x00\x00\x00}\xa9_K\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x08\x00\x10\x00test.txtUX\x0c\x00\xd7J\xf9Y\x8dI\xf9Y\xf5\x01\x14\x00PK\x01\x02\x15\x03\x0a\x00\x00\x00\x00\x00}\xa9_K\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x08\x00\x0c\x00\x00\x00\x00\x00\x00\x00\x00@\xa4\x81\x00\x00\x00\x00test.txtUX\x08\x00\xd7J\xf9Y\x8dI\xf9YPK\x05\x06\x00\x00\x00\x00\x01\x00\x01\x00B\x00\x00\x006\x00\x00\x00\x00\x00"
  let es = match zip.entries(data) {
    Ok(es) => es,
    Error(_) => return Error(()),
  }
  test.check(t, list.len(es) == 1)
  test.check(t, es[0].name == "test.txt" && es[0].size == 0)
  test.check(t, es[0].modified == Some(1509509517i64))
  test.check(t, zip.read(data, es[0], 4096) == Ok(b""))
  test.check(t, es[0].dos_time == 1264560509)
  Ok(())
}
