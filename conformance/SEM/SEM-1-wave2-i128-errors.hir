// rule: SEM-1
// expect: run
pub fn main(t: Test) -> Result[(), ()] {
  let mut buffer: Inline[u8, 1] = [99]
  core@1/test.check(t, i128.format(12, mut buffer) == Error(BufferTooSmall))
  core@1/test.check(t, buffer == [99u8])
  core@1/test.check(
    t,
    i128.parse("170141183460469231731687303715884105728") == Error(OutOfRange)
  )
  core@1/test.check(
    t,
    i128.parse("-170141183460469231731687303715884105729") == Error(OutOfRange)
  )
  core@1/test.check(t, i128.parse("") == Error(Invalid))
  core@1/test.check(t, i128.parse("+1") == Error(Invalid))
  core@1/test.check(t, i128.parse(" 1") == Error(Invalid))
  core@1/test.check(t, i128.parse("1 ") == Error(Invalid))
  core@1/test.check(t, i128.parse("1_0") == Error(Invalid))
  core@1/test.check(t, i128.parse("0x1") == Error(Invalid))
  core@1/test.check(t, i128.parse("--1") == Error(Invalid))
  core@1/test.check(t, i128.parse("1z") == Error(Invalid))
  core@1/test.check(
    t,
    i128.parse("170141183460469231731687303715884105728x") == Error(Invalid)
  )
  core@1/test.check(t, i128.parse("00012") == Ok(12i128))
  Ok(())
}
