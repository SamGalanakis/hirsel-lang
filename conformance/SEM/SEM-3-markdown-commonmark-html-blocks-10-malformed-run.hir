// rule: SEM-3
// expect: run
// Published spec.txt vectors; tools/generate-markdown.py.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.check(
    s,
    "commonmark/HTML blocks/180/malformed",
    "<?php\n\n  echo \u{0}[&unterminated",
    "<?php\n\n  echo �[&unterminated\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/HTML blocks/181/malformed",
    "<!DOCTYP\u{0}[&unterminated",
    "<!DOCTYP�[&unterminated\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/HTML blocks/182/malformed",
    "<![CDATA[\nfunction matchwo(a,b)\n{\n  if (a < b && a < 0) the\u{0}[&unterminated",
    "<![CDATA[\nfunction matchwo(a,b)\n{\n  if (a < b && a < 0) the�[&unterminated\n",
    std@1/markdown.default_options()
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
