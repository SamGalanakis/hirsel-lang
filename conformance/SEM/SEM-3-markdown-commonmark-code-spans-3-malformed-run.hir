// rule: SEM-3
// expect: run
// Published spec.txt vectors; tools/generate-markdown.py.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.check(
    s,
    "commonmark/Code spans/341/malformed",
    "*foo\u{0}[&unterminated",
    "<p>*foo�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Code spans/342/malformed",
    "[not a `li\u{0}[&unterminated",
    "<p>[not a `li�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Code spans/343/malformed",
    "`<a hre\u{0}[&unterminated",
    "<p>`&lt;a hre�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Code spans/344/malformed",
    "<a href\u{0}[&unterminated",
    "<p>&lt;a href�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Code spans/345/malformed",
    "`<https://fo\u{0}[&unterminated",
    "<p>`&lt;https://fo�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Code spans/346/malformed",
    "<https://foo\u{0}[&unterminated",
    "<p>&lt;https://foo�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
