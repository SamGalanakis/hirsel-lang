// rule: SEM-3
// expect: run
// node-semver 6e05b763 test/fixtures/valid-versions.js:2-31 (22 rows), equality.js:40-42 (3 option-free rows).
// Strip npm whitespace/v prefixes to use strict SemVer parsing; build metadata has no precedence.
pub fn main(t: Test) -> Result[(), ()] {
  let v1 = test.expect_ok(t, semver.parse("1.0.0"))
  test.equal(t, v1.major, 1u64)
  test.equal(t, v1.minor, 0u64)
  test.equal(t, v1.patch, 0u64)
  test.equal(t, v1.pre, "")
  test.equal(t, v1.build, "")
  let v2 = test.expect_ok(t, semver.parse("2.1.0"))
  test.equal(t, v2.major, 2u64)
  test.equal(t, v2.minor, 1u64)
  test.equal(t, v2.patch, 0u64)
  test.equal(t, v2.pre, "")
  test.equal(t, v2.build, "")
  let v3 = test.expect_ok(t, semver.parse("3.2.1"))
  test.equal(t, v3.major, 3u64)
  test.equal(t, v3.minor, 2u64)
  test.equal(t, v3.patch, 1u64)
  test.equal(t, v3.pre, "")
  test.equal(t, v3.build, "")
  let v4 = test.expect_ok(t, semver.parse("1.2.3"))
  test.equal(t, v4.major, 1u64)
  test.equal(t, v4.minor, 2u64)
  test.equal(t, v4.patch, 3u64)
  test.equal(t, v4.pre, "")
  test.equal(t, v4.build, "")
  let v5 = test.expect_ok(t, semver.parse("1.2.3-0"))
  test.equal(t, v5.major, 1u64)
  test.equal(t, v5.minor, 2u64)
  test.equal(t, v5.patch, 3u64)
  test.equal(t, v5.pre, "0")
  test.equal(t, v5.build, "")
  let v6 = test.expect_ok(t, semver.parse("1.2.3-123"))
  test.equal(t, v6.major, 1u64)
  test.equal(t, v6.minor, 2u64)
  test.equal(t, v6.patch, 3u64)
  test.equal(t, v6.pre, "123")
  test.equal(t, v6.build, "")
  let v7 = test.expect_ok(t, semver.parse("1.2.3-1.2.3"))
  test.equal(t, v7.major, 1u64)
  test.equal(t, v7.minor, 2u64)
  test.equal(t, v7.patch, 3u64)
  test.equal(t, v7.pre, "1.2.3")
  test.equal(t, v7.build, "")
  let v8 = test.expect_ok(t, semver.parse("1.2.3-1a"))
  test.equal(t, v8.major, 1u64)
  test.equal(t, v8.minor, 2u64)
  test.equal(t, v8.patch, 3u64)
  test.equal(t, v8.pre, "1a")
  test.equal(t, v8.build, "")
  let v9 = test.expect_ok(t, semver.parse("1.2.3-a1"))
  test.equal(t, v9.major, 1u64)
  test.equal(t, v9.minor, 2u64)
  test.equal(t, v9.patch, 3u64)
  test.equal(t, v9.pre, "a1")
  test.equal(t, v9.build, "")
  let v10 = test.expect_ok(t, semver.parse("1.2.3-alpha"))
  test.equal(t, v10.major, 1u64)
  test.equal(t, v10.minor, 2u64)
  test.equal(t, v10.patch, 3u64)
  test.equal(t, v10.pre, "alpha")
  test.equal(t, v10.build, "")
  let v11 = test.expect_ok(t, semver.parse("1.2.3-alpha.1"))
  test.equal(t, v11.major, 1u64)
  test.equal(t, v11.minor, 2u64)
  test.equal(t, v11.patch, 3u64)
  test.equal(t, v11.pre, "alpha.1")
  test.equal(t, v11.build, "")
  let v12 = test.expect_ok(t, semver.parse("1.2.3-alpha-1"))
  test.equal(t, v12.major, 1u64)
  test.equal(t, v12.minor, 2u64)
  test.equal(t, v12.patch, 3u64)
  test.equal(t, v12.pre, "alpha-1")
  test.equal(t, v12.build, "")
  let v13 = test.expect_ok(t, semver.parse("1.2.3-alpha-.-beta"))
  test.equal(t, v13.major, 1u64)
  test.equal(t, v13.minor, 2u64)
  test.equal(t, v13.patch, 3u64)
  test.equal(t, v13.pre, "alpha-.-beta")
  test.equal(t, v13.build, "")
  let v14 = test.expect_ok(t, semver.parse("1.2.3+456"))
  test.equal(t, v14.major, 1u64)
  test.equal(t, v14.minor, 2u64)
  test.equal(t, v14.patch, 3u64)
  test.equal(t, v14.pre, "")
  test.equal(t, v14.build, "456")
  let v15 = test.expect_ok(t, semver.parse("1.2.3+build"))
  test.equal(t, v15.major, 1u64)
  test.equal(t, v15.minor, 2u64)
  test.equal(t, v15.patch, 3u64)
  test.equal(t, v15.pre, "")
  test.equal(t, v15.build, "build")
  let v16 = test.expect_ok(t, semver.parse("1.2.3+new-build"))
  test.equal(t, v16.major, 1u64)
  test.equal(t, v16.minor, 2u64)
  test.equal(t, v16.patch, 3u64)
  test.equal(t, v16.pre, "")
  test.equal(t, v16.build, "new-build")
  let v17 = test.expect_ok(t, semver.parse("1.2.3+build.1"))
  test.equal(t, v17.major, 1u64)
  test.equal(t, v17.minor, 2u64)
  test.equal(t, v17.patch, 3u64)
  test.equal(t, v17.pre, "")
  test.equal(t, v17.build, "build.1")
  let v18 = test.expect_ok(t, semver.parse("1.2.3+build.1a"))
  test.equal(t, v18.major, 1u64)
  test.equal(t, v18.minor, 2u64)
  test.equal(t, v18.patch, 3u64)
  test.equal(t, v18.pre, "")
  test.equal(t, v18.build, "build.1a")
  let v19 = test.expect_ok(t, semver.parse("1.2.3+build.a1"))
  test.equal(t, v19.major, 1u64)
  test.equal(t, v19.minor, 2u64)
  test.equal(t, v19.patch, 3u64)
  test.equal(t, v19.pre, "")
  test.equal(t, v19.build, "build.a1")
  let v20 = test.expect_ok(t, semver.parse("1.2.3+build.alpha"))
  test.equal(t, v20.major, 1u64)
  test.equal(t, v20.minor, 2u64)
  test.equal(t, v20.patch, 3u64)
  test.equal(t, v20.pre, "")
  test.equal(t, v20.build, "build.alpha")
  let v21 = test.expect_ok(t, semver.parse("1.2.3+build.alpha.beta"))
  test.equal(t, v21.major, 1u64)
  test.equal(t, v21.minor, 2u64)
  test.equal(t, v21.patch, 3u64)
  test.equal(t, v21.pre, "")
  test.equal(t, v21.build, "build.alpha.beta")
  let v22 = test.expect_ok(t, semver.parse("1.2.3-alpha+build"))
  test.equal(t, v22.major, 1u64)
  test.equal(t, v22.minor, 2u64)
  test.equal(t, v22.patch, 3u64)
  test.equal(t, v22.pre, "alpha")
  test.equal(t, v22.build, "build")
  test.equal(t, semver.parse("v1.2.3"), Error(Syntax(0)))
  test.equal(
    t,
    semver.compare(
      test.expect_ok(t, semver.parse("1.2.3-beta+build")),
      test.expect_ok(t, semver.parse("1.2.3-beta+otherbuild"))
    ),
    0i32
  )
  test.equal(
    t,
    semver.compare(
      test.expect_ok(t, semver.parse("1.2.3+build")),
      test.expect_ok(t, semver.parse("1.2.3+otherbuild"))
    ),
    0i32
  )
  test.equal(
    t,
    semver.compare(
      test.expect_ok(t, semver.parse("1.2.3+build")),
      test.expect_ok(t, semver.parse("1.2.3+otherbuild"))
    ),
    0i32
  )
  Ok(())
}
