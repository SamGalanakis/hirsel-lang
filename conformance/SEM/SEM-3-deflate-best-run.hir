// rule: SEM-3
// expect: run
// Levels 7 to 9 and stored level 0 match zlib 1.3 output (madler/zlib 09155ea).
fn check(t: Test, actual: Bytes, expected: Bytes) -> () {
  test.check(t, actual == expected)
}

pub fn main(t: Test) -> Result[(), ()] {
  // two letters, level 7
  check(
    t,
    flate.deflate(
      b"baaaaaaaaabaaababbabbabaabaaaabaabbbabbaaaabbaaaaabbabbaaaabaaab",
      7
    ),
    b"KJ\x84\x81$0N\x82 \x08\x17LCD@\x9c\xa4D(\x95\x94\x04\xd7\x00\x00"
  )
  // two letters, level 8
  check(
    t,
    flate.deflate(
      b"baaaaaaaaabaaababbabbabaabaaaabaabbbabbaaaabbaaaaabbabbaaaabaaab",
      8
    ),
    b"KJ\x84\x81$0N\x82 \x08\x17LCD@\x9c\xa4D(\x95\x94\x04\xd7\x00\x00"
  )
  // two letters, level 9
  check(
    t,
    flate.deflate(
      b"baaaaaaaaabaaababbabbabaabaaaabaabbbabbaaaabbaaaaabbabbaaaabaaab",
      9
    ),
    b"KJ\x84\x81$0N\x82 \x08\x17LCD@\x9c\xa4D(\x95\x94\x04\xd7\x00\x00"
  )
  // two letters, level 0
  check(
    t,
    flate.deflate(
      b"baaaaaaaaabaaababbabbabaabaaaabaabbbabbaaaabbaaaaabbabbaaaabaaab",
      0
    ),
    b"\x01@\x00\xbf\xffbaaaaaaaaabaaababbabbabaabaaaabaabbbabbaaaabbaaaaabbabbaaaabaaab"
  )
  Ok(())
}
