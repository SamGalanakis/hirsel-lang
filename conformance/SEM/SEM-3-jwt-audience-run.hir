// rule: SEM-3
// expect: run
// entry: main
// golang-jwt example_test.go ExampleParseWithClaims_customClaimsType: the
// "single" audience token verifies with its audience and issuer (golang-jwt/jwt
// d2cffb184933cab5b685db7e9eea56326f0acc0d); one MAC per program, as the corpus
// step budget allows.
fn test_key() -> Bytes uses {} {
  b"\x03#5K+\x0f\xa5\xbc\x83~\x06ew{\xa6\x8fZ\xb3(\xe6\xf0T\xc9(\xa9\x0f\x84\xb2\xd2P.\xbf\xd3\xfbZ\x92\xd2\x06G\xef\x96\x8a\xb4\xc3wb=\"=.!r\x05.O\x08\xc0\xcd\x9a\xf5g\xd0\x80\xa3"
}

pub fn main(t: Test) -> Result[(), jwt.JwtError] {
  let mut wants = jwt.default_validation()
  wants.audience = Some("single")
  wants.issuer = Some("test")
  let claims = jwt.verify_at(
    "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJmb28iOiJiYXIiLCJpc3MiOiJ0ZXN0IiwiYXVkIjoic2luZ2xlIn0.QAWg1vGvnqRuCFTMcPkjZljXHh8U3L_qUjszOtQbeaA",
    HS256(b"AllYourBase"),
    wants,
    0
  )?
  test.check(
    t,
    json.stringify(claims) == Ok(
      "{\"foo\":\"bar\",\"iss\":\"test\",\"aud\":\"single\"}"
    )
  )
  Ok(())
}
