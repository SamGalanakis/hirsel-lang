// rule: SEM-3
// expect: run
// Fixed-code and stored DEFLATE streams written by CPython's zlib, decoded
// within exact bounds.
fn check(ok: bool) -> () uses {} {
  failure.check(ok, TextInvariant())
}

pub fn main(t: Test) -> Result[(), ()] {
  // distances with extra bits.
  let input2 = b"KLJL\xe1JLLLJJ\x04Q \x00\xa4\x15\xa0\xcc$ L\x04)PXw$]&j\xd14\x91%R/\xd3\xb3\x1d\xca\xb7\x9d\x92\xf6i\xeeZ0\xe7\xa9|3_\xa1\x97\x8c\xa0\x0eSw\x93\xb3\xe1\xa1Sg#\xfc\xf2\x8e\xc7\xb9\xb8p=1\xfd)b\xb73\xc2b\xfb\xbc2\x8b\xbdF\x0f\xefr\xfcL\x0ei0\xf2\x98\xb2T6(\x8e\xc9\xf0\xa8Hp\xa7\xefc\x83\xf8\xf2\xb3\xe6\x5c{r\xd9\xf8g<\xe0{\xc8\xea\x99\x88\xd7-\x00"
  check(
    flate.inflate(input2, 170) == Ok(
      b"abad\x0aaaabba\x0aaaaaaaa\x0aaa aaaaaaababaaad\x0aa \xae\xc4g\x1cZ\xa2\x96\x14\xa4\x1a\xe9gk@w\xb6\xca\x1bL\x83\x8a\xa0\x9c\xe5\x1f\x83\x0eqJ\x1c\x11,\x02\x8b\x82C1\xc2\xca\xcdXNn\xc7^DD\x0a\xe45\xf9\x14>\xb9X8\xb7\x9ev8\xbd2\xe1\xdd\x08\xf9cT\x802H\x94\xa5\x1dR^\x021\xc5\x14S\x89M\xe30_w\xcd7\x0a\xbcm\x06\x0f\x98\xe0\x0e\xe1\x05Iabad\x0aaaabba\x0aaaaaaaa\x0aaa aaaaaaa"
    )
  )
  // 258-byte matches at distance 3.
  let input3 = b"KLJN\x1cE0\x04\x00"
  check(
    flate.inflate(input3, 270) == Ok(
      b"abcabcabcabcabcabcabcabcabcabcabcabcabcabcabcabcabcabcabcabcabcabcabcabcabcabcabcabcabcabcabcabcabcabcabcabcabcabcabcabcabcabcabcabcabcabcabcabcabcabcabcabcabcabcabcabcabcabcabcabcabcabcabcabcabcabcabcabcabcabcabcabcabcabcabcabcabcabcabcabcabcabcabcabcabcabcabcabcabcabc"
    )
  )
  // full flushes: several blocks and empty stored blocks.
  let input4 = b"JLJL\xe1JLLLJJ\x04Q \x00\xa4\x15\xa0\xcc$ L\x04)P\x00\x00\x00\x00\xff\xff$\xc7A\x0d\x00\x00\x0c\xc2\xc0?*f\xad\x80\x7f\x0d[\xb2~.\x1dE0\x5c\xc29\xec\xc2\xbfL\x14Z\xbc\x00\x00\x00\xff\xffKVHJ\x04\x01\xae\xa4\xc4\xa4\xe4D\x85\xe4\xe4d\xae\xc4\xa4\xc4\x14\x90Pr\x22\x84LJJNJ\x06\x00"
  check(
    flate.inflate(input4, 120) == Ok(
      b"abad\x0aaaabba\x0aaaaaaaa\x0aaa aaaaaaababaaad\x0aa  \x0ac\x0aaa aaaa\x0aabcaaabbdaaaaaa\x0aa\x0abac\x0acaddabc baaaaa\x0ababca ccc\x0aabadaaaacaaaaacabbcbc"
    )
  )
  // stored blocks.
  let input5 = b"\x01<\x00\xc3\xff\xae\xc4g\x1cZ\xa2\x96\x14\xa4\x1a\xe9gk@w\xb6\xca\x1bL\x83\x8a\xa0\x9c\xe5\x1f\x83\x0eqJ\x1c\x11,\x02\x8b\x82C1\xc2\xca\xcdXNn\xc7^DD\x0a\xe45\xf9\x14>\xb9X8\xb7\x9ev8"
  check(
    flate.inflate(input5, 60) == Ok(
      b"\xae\xc4g\x1cZ\xa2\x96\x14\xa4\x1a\xe9gk@w\xb6\xca\x1bL\x83\x8a\xa0\x9c\xe5\x1f\x83\x0eqJ\x1c\x11,\x02\x8b\x82C1\xc2\xca\xcdXNn\xc7^DD\x0a\xe45\xf9\x14>\xb9X8\xb7\x9ev8"
    )
  )
  Ok(())
}
