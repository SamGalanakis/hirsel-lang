// rule: SEM-3
// expect: run
// zip.writer writes deflated and stored entries with data descriptors, a
// directory, an extended timestamp and a UTF-8 name, as Go
// writer_test.go TestWriter does, and the archive reads back through
// zip.entries and zip.read with the comment it was closed with.
fn named(take name: String, method: zip.Method, modified: Option[i64]) -> zip.Entry {
  let mut e = zip.entry(take name)
  e.method = method
  e.modified = modified
  e
}

pub fn main(t: Test) -> Result[(), zip.ZipError] {
  let mut w = zip.writer()
  let mut out: List[u8] = []
  test.check(
    t,
    zip.create(mut w, named("a.txt", Deflate(), Some(1700000000)), 6, mut out) == Ok(())
  )
  test.check(t, zip.write(mut w, b"hello hello hello", mut out) == Ok(()))
  test.check(t, zip.write(mut w, b" hello", mut out) == Ok(()))
  test.check(
    t,
    zip.create(mut w, named("dir/", Deflate(), None()), 6, mut out) == Ok(())
  )
  test.check(t, zip.write(mut w, b"x", mut out) == Error(Directory()))
  test.check(
    t,
    zip.create(mut w, named("dir/世界.bin", Stored(), None()), 0, mut out) == Ok(())
  )
  test.check(t, zip.write(mut w, b"\x00\x01\x02", mut out) == Ok(()))
  test.check(t, zip.close(mut w, "made by hirsel", mut out) == Ok(()))
  test.check(t, zip.write(mut w, b"late", mut out) == Error(Closed()))
  let data = core@1/bytes.from_list(take out)
  let es = zip.entries(data)?
  test.check(t, list.len(es) == 3)
  let a = es[0]
  test.check(
    t,
    a.name == "a.txt" && a.method == Deflate() && a.flags == 8 && a.size == 23
  )
  // 2023-11-14 22:13:20 UTC in MS-DOS form.
  test.check(t, a.modified == Some(1700000000) && a.dos_time == 0x576eb1aa)
  test.check(t, zip.read(data, a, 100)? == b"hello hello hello hello")
  test.check(
    t,
    es[1].name == "dir/" && es[1].method == Stored() && es[1].flags == 0 && es[1].size == 0
  )
  let c = es[2]
  test.check(
    t,
    c.name == "dir/世界.bin" && c.flags == 0x808 && c.compressed == 3 && c.offset > es[1].offset
  )
  test.check(t, zip.read(data, c, 100)? == b"\x00\x01\x02")
  test.check(t, zip.archive_comment(data)? == "made by hirsel")
  test.check(t, zip.read(data, a, 22) == Error(TooLarge()))
  Ok(())
}
