// rule: SEM-3
// expect: run
// Published spec.txt vectors; tools/generate-markdown.py.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.check(
    s,
    "commonmark/Paragraphs/219",
    "aaa\n\nbbb\n",
    "<p>aaa</p>\n<p>bbb</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Paragraphs/220",
    "aaa\nbbb\n\nccc\nddd\n",
    "<p>aaa\nbbb</p>\n<p>ccc\nddd</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Paragraphs/221",
    "aaa\n\n\nbbb\n",
    "<p>aaa</p>\n<p>bbb</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Paragraphs/222",
    "  aaa\n bbb\n",
    "<p>aaa\nbbb</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Paragraphs/223",
    "aaa\n             bbb\n                                       ccc\n",
    "<p>aaa\nbbb\nccc</p>\n",
    std@1/markdown.default_options()
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
