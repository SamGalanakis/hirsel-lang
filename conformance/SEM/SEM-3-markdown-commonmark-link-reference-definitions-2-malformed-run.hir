// rule: SEM-3
// expect: run
// Published spec.txt vectors; tools/generate-markdown.py.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.check(
    s,
    "commonmark/Link reference definitions/195/malformed",
    "[Foo bar]:\n<my url>\u{0}[&unterminated",
    "<p>[Foo bar]:\n<my url>�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Link reference definitions/196/malformed",
    "[foo]: /url '\ntitle\n\u{0}[&unterminated",
    "<p>[foo]: /url '\ntitle\n�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Link reference definitions/197/malformed",
    "[foo]: /url 'title\n\nwi\u{0}[&unterminated",
    "<p>[foo]: /url 'title</p>\n<p>wi�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Link reference definitions/198/malformed",
    "[foo]:\n/u\u{0}[&unterminated",
    "",
    std@1/markdown.default_options()
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
