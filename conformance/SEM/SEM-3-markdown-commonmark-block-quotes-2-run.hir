// rule: SEM-3
// expect: run
// Published spec.txt vectors; tools/generate-markdown.py.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.check(
    s,
    "commonmark/Block quotes/233",
    "> bar\nbaz\n> foo\n",
    "<blockquote>\n<p>bar\nbaz\nfoo</p>\n</blockquote>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Block quotes/234",
    "> foo\n---\n",
    "<blockquote>\n<p>foo</p>\n</blockquote>\n<hr />\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Block quotes/235",
    "> - foo\n- bar\n",
    "<blockquote>\n<ul>\n<li>foo</li>\n</ul>\n</blockquote>\n<ul>\n<li>bar</li>\n</ul>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Block quotes/236",
    ">     foo\n    bar\n",
    "<blockquote>\n<pre><code>foo\n</code></pre>\n</blockquote>\n<pre><code>bar\n</code></pre>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Block quotes/237",
    "> ```\nfoo\n```\n",
    "<blockquote>\n<pre><code></code></pre>\n</blockquote>\n<p>foo</p>\n<pre><code></code></pre>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Block quotes/238",
    "> foo\n    - bar\n",
    "<blockquote>\n<p>foo\n- bar</p>\n</blockquote>\n",
    std@1/markdown.default_options()
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
