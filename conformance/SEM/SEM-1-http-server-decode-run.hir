// rule: SEM-1
// expect: run
// A server removes request content codings with http.decode_content and answers
// 415 for a coding it cannot remove (RFC 9110 section 15.5.16).
fn check(ok: bool) -> () uses {} {
  failure.check(ok, TextInvariant())
}

fn served(mut c: http.ServerConnection) -> Result[(), http.HttpError] {
  let request = http.receive_request(mut c, None())?
  match http.decode_content(request.headers, request.body, 1024) {
    Ok(body) => http.respond(mut c, 200u16, [], body, false),
    Error(UnsupportedContentEncoding()) => http.respond(mut c, 415u16, [], b"", true),
    Error(error) => Error(error),
  }
}

pub fn main(t: Test) -> Result[(), http.HttpError] {
  let n = test.net(
    t,
    [
      NetPeer(
        address: "example.com",
        port: 80u16,
        resolves_to: [],
        tls: Plain(),
        connections: [
          Open(
            [
              Send(
                b"POST /upload HTTP/1.1\x0d\x0aContent-Encoding: gzip\x0d\x0aContent-Length: 32\x0d\x0a\x0d\x0a\x1f\x8b\x08\x00\x00\x00\x00\x00\x02\x03\xcbH\xcd\xc9\xc9W(\xcf/\xcaI\xe1\x02\x00-;\x08\xaf\x0c\x00\x00\x00"
              ),
              Expect(
                b"HTTP/1.1 200 \x0d\x0aContent-Length: 12\x0d\x0aConnection: keep-alive\x0d\x0a\x0d\x0ahello world\x0a"
              ),
              Send(
                b"POST /br HTTP/1.1\x0d\x0aContent-Encoding: br\x0d\x0aContent-Length: 3\x0d\x0a\x0d\x0axyz"
              ),
              Expect(
                b"HTTP/1.1 415 \x0d\x0aContent-Length: 0\x0d\x0aConnection: close\x0d\x0a\x0d\x0a"
              ),
              Close()
            ]
          )
        ]
      )
    ],
    []
  )
  let mut stream = match net.connect(n, "example.com", 80u16, Unbounded()) {
    Ok(stream) => take stream,
    Error(error) => return Error(Net(error)),
  }
  let mut connection = http.server_connection(n, take stream, http.default_config())
  served(mut connection)?
  served(mut connection)?
  Ok(())
}
