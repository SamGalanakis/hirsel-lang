// rule: SEM-4
// expect: run
// stdout: ok
@noalloc
fn compare(a: u64, b: u64) -> i32 uses {} {
  if a < b {
    -1i32
  } else if a > b {
    1i32
  } else {
    0i32
  }
}

pub fn main(rt: Io, args: Args) -> Result[(), LaunchError] {
  let mut xs: unique List[u64] = unique [4, 1, 3, 2, 2]
  list.sort(mut xs, compare)
  list.reverse(mut xs)
  list.rotate(mut xs, 2)
  if xs == [2, 2, 1, 4, 3] {
    out.print(io.stdout(rt) ? Grant, "ok\n") ? Output
  } else {
    out.print(io.stdout(rt) ? Grant, "bad\n") ? Output
  }
  Ok(())
}

pub type LaunchError = Grant(GrantError) | Output(OutputError)
