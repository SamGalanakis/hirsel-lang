// rule: SEM-3
// expect: reject SEM-3 at line 6
// twin: SEM/SEM-3-format-generic-run.hir
// A generic type's @format function is generic over the type's own parameters;
// one formatting a single instantiation is rejected.
@format(cell_text)
type Cell[T] {
  value: T,
  id: u64,
}

fn cell_text(cell: Cell[u8], mut out: List[u8]) -> () uses {} {
  text.append(mut out, f"cell {cell.id}")
}
