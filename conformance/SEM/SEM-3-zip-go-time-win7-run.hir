// rule: SEM-3
// expect: run
// Go zip/reader_test.go:58-584 TestReader: time-win7.zip.
pub fn main(t: Test) -> Result[(), ()] {
  let data = b"PK\x03\x04\x14\x00\x00\x00\x00\x00}\xa9_K\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x08\x00\x00\x00test.txtPK\x01\x02\x14\x00\x14\x00\x00\x00\x00\x00}\xa9_K\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x08\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00test.txtPK\x05\x06\x00\x00\x00\x00\x01\x00\x01\x006\x00\x00\x00&\x00\x00\x00\x00\x00"
  let es = match zip.entries(data) {
    Ok(es) => es,
    Error(_) => return Error(()),
  }
  test.check(t, list.len(es) == 1)
  test.check(t, es[0].name == "test.txt" && es[0].size == 0)
  test.check(t, zip.read(data, es[0], 4096) == Ok(b""))
  test.check(t, es[0].dos_time == 1264560509)
  Ok(())
}
