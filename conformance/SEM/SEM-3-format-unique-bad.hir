// rule: SEM-3
// expect: reject SEM-3 at line 5
// An @format function must promise @preserves_unique(out), so the f-string's
// builder, and the String it finishes, stay unique.
@format(point_text)
type Point {
  x: i64,
  y: i64,
}

fn point_text(p: Point, mut out: List[u8]) -> () uses {} {
  text.append(mut out, f"({p.x}, {p.y})")
}
