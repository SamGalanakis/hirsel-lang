// rule: SEM-3
// expect: accept
// The association implies the promise: no ownership annotation is needed.
// The builder, and the String it finishes, stay unique.
@format(point_text)
type Point {
  x: i64,
  y: i64,
}

fn point_text(p: Point, mut out: List[u8]) -> () uses {} {
  text.append(mut out, f"({p.x}, {p.y})")
}
