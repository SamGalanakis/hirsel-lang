// rule: SEM-3
// expect: run
// Published spec.txt vectors; tools/generate-markdown.py.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.check(
    s,
    "commonmark/Entity and numeric character references/36/malformed",
    "    f&oum\u{0}[&unterminated",
    "<pre><code>f&amp;oum�[&amp;unterminated\n</code></pre>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Entity and numeric character references/37/malformed",
    "&#42;foo&#\u{0}[&unterminated",
    "<p>*foo&amp;#�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Entity and numeric character references/38/malformed",
    "&#42; fo\u{0}[&unterminated",
    "<p>* fo�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Entity and numeric character references/39/malformed",
    "foo&#10;\u{0}[&unterminated",
    "<p>foo\n�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Entity and numeric character references/40/malformed",
    "&#9;\u{0}[&unterminated",
    "<p>\t�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Entity and numeric character references/41/malformed",
    "[a](url &quo\u{0}[&unterminated",
    "<p>[a](url &amp;quo�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
