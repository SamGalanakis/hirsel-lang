// A WebSocket client refuses the handshakes RFC 6455 section 4.1 rules out: a wrong
// accept key, a status other than 101, an extension it did not offer and a
// protocol it did not offer; a URL scheme other than ws or wss and a caller header
// that names a handshake field fail before connecting. Keys come from the run's
// Random, splitmix64 with seed 0 here.
pub type AppError = Grant(GrantError) | Ws(websocket.WsError)

fn check(ok: bool) -> () {
  failure.check(ok, Arithmetic())
}

fn origin() -> List[http.Header] uses {} {
  [http.Header(name: "Origin", value: "http://echo.test")]
}

pub fn main(rt: Io, args: Args) -> Result[(), AppError] {
  let r = io.random(rt) ? Grant
  let n = io.net(rt) ? Grant
  let url = "ws://echo.test/chat?x=1"
  let mut config = websocket.default_config()
  config.protocols = ["chat"]
  let refused: List[websocket.HandshakeError] = [
    BadAccept(),
    Status(400),
    UnexpectedExtension(),
    UnexpectedProtocol()
  ]
  for expected in refused {
    match websocket.connect(n, r, url, origin(), config) {
      Error(Handshake(e)) => check(e == expected),
      _ => check(false),
    }
  }
  match websocket.connect(n, r, "http://echo.test/", [], config) {
    Error(Handshake(e)) => check(e == UnsupportedScheme()),
    _ => check(false),
  }
  // A caller header may not replace one the handshake writes.
  let reserved: List[String] = [
    "Host",
    "connection",
    "Sec-WebSocket-Key",
    "sec-websocket-extensions"
  ]
  for name in reserved {
    match websocket.connect(
      n,
      r,
      url,
      [http.Header(name: unique name, value: "x")],
      config
    ) {
      Error(Handshake(e)) => check(e == ReservedHeader()),
      _ => check(false),
    }
  }
  Ok(())
}
