// rule: SEM-1
// expect: run
// entry: main
// A WebSocket client refuses the handshakes RFC 6455 section 4.1 rules out: a wrong
// accept key, a status other than 101, an extension it did not offer and a
// protocol it did not offer; a URL scheme other than ws or wss and a caller header
// that names a handshake field fail before connecting. Keys come from the run's
// Random, splitmix64 with seed 0 here.
pub type AppError = Grant(GrantError) | Ws(websocket.WsError)

fn origin() -> List[http.Header] uses {} {
  [http.Header(name: "Origin", value: "http://echo.test")]
}

pub fn main(t: Test, rt: Io) -> Result[(), AppError] {
  let r = io.random(rt) ? Grant
  let n = test.net(
    t,
    [
      NetPeer(
        address: "echo.test",
        port: 80u16,
        resolves_to: [V4([192u8, 0u8, 2u8, 7u8])],
        tls: Plain(),
        connections: [
          Open(
            [
              Expect(
                b"GET /chat?x=1 HTTP/1.1\r\nHost: echo.test\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: r80dezmoIOL0Zbmhap54bg==\r\nSec-WebSocket-Version: 13\r\nSec-WebSocket-Protocol: chat\r\nOrigin: http://echo.test\r\n\r\n"
              ),
              Send(
                b"HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: fhVEOUYbXj9QntixSweUXEpurTQ=\r\n\r\n"
              )
            ]
          ),
          Open(
            [
              Expect(
                b"GET /chat?x=1 HTTP/1.1\r\nHost: echo.test\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: T0UJgBhdxAbsgUxyqLiL+A==\r\nSec-WebSocket-Version: 13\r\nSec-WebSocket-Protocol: chat\r\nOrigin: http://echo.test\r\n\r\n"
              ),
              Send(b"HTTP/1.1 400 Bad Request\r\nContent-Length: 0\r\n\r\n")
            ]
          ),
          Open(
            [
              Expect(
                b"GET /chat?x=1 HTTP/1.1\r\nHost: echo.test\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: m3SoUWqJORvqon50DJ/LUw==\r\nSec-WebSocket-Version: 13\r\nSec-WebSocket-Protocol: chat\r\nOrigin: http://echo.test\r\n\r\n"
              ),
              Send(
                b"HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: yLOj+e37KsOv0xdD9qRJztQ4U8c=\r\nSec-WebSocket-Extensions: permessage-deflate\r\n\r\n"
              )
            ]
          ),
          Open(
            [
              Expect(
                b"GET /chat?x=1 HTTP/1.1\r\nHost: echo.test\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: 4TJFH76agiw8qxbJOhOExQ==\r\nSec-WebSocket-Version: 13\r\nSec-WebSocket-Protocol: chat\r\nOrigin: http://echo.test\r\n\r\n"
              ),
              Send(
                b"HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: 5OIjS5VKirSkiurTz8vQESmwm+E=\r\nSec-WebSocket-Protocol: superchat\r\n\r\n"
              )
            ]
          )
        ]
      )
    ],
    []
  )
  let url = "ws://echo.test/chat?x=1"
  let mut config = websocket.default_config()
  config.protocols = ["chat"]
  let refused: List[websocket.HandshakeError] = [
    BadAccept(),
    Status(400),
    UnexpectedExtension(),
    UnexpectedProtocol()
  ]
  for expected in refused {
    match websocket.connect(n, r, url, origin(), config) {
      Error(Handshake(e)) => test.check(t, e == expected),
      _ => test.check(t, false),
    }
  }
  match websocket.connect(n, r, "http://echo.test/", [], config) {
    Error(Handshake(e)) => test.check(t, e == UnsupportedScheme()),
    _ => test.check(t, false),
  }
  // A caller header may not replace one the handshake writes.
  let reserved: List[String] = [
    "Host",
    "connection",
    "Sec-WebSocket-Key",
    "sec-websocket-extensions"
  ]
  for name in reserved {
    match websocket.connect(
      n,
      r,
      url,
      [http.Header(name: unique name, value: "x")],
      config
    ) {
      Error(Handshake(e)) => test.check(t, e == ReservedHeader()),
      _ => test.check(t, false),
    }
  }
  Ok(())
}
