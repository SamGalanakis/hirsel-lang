// rule: SEM-1
// expect: run
// jiff fff640d4 crates/jiff/src/tz/timezone.rs:2703-2728 and :3333-3356; 13 rows each for loaded Troll TZif and POSIX rule.
pub fn main(t: Test) -> Result[(), ()] {
  let zone = test.expect_ok(t, time_zone.from_tzif(zones.TROLL))
  check.ambiguity(
    t,
    zone,
    [
      ("1970-01-01T00:00:00", 0, 0, 0),
      ("2024-03-31T00:59:59.999999999", 0, 0, 0),
      ("2024-03-31T01:00:00", 1, 0, 7200),
      ("2024-03-31T01:59:59.999999999", 1, 0, 7200),
      ("2024-03-31T02:00:00", 1, 0, 7200),
      ("2024-03-31T02:59:59.999999999", 1, 0, 7200),
      ("2024-03-31T03:00:00", 0, 7200, 7200),
      ("2024-10-27T00:59:59.999999999", 0, 7200, 7200),
      ("2024-10-27T01:00:00", 2, 7200, 0),
      ("2024-10-27T01:59:59.999999999", 2, 7200, 0),
      ("2024-10-27T02:00:00", 2, 7200, 0),
      ("2024-10-27T02:59:59.999999999", 2, 7200, 0),
      ("2024-10-27T03:00:00", 0, 0, 0)
    ]
  )
  let posix = test.expect_ok(
    t,
    time_zone.from_tzif(check.footer_only("<+00>0<+02>-2,M3.5.0/1,M10.5.0/3"))
  )
  check.ambiguity(
    t,
    posix,
    [
      ("1970-01-01T00:00:00", 0, 0, 0),
      ("2024-03-31T00:59:59.999999999", 0, 0, 0),
      ("2024-03-31T01:00:00", 1, 0, 7200),
      ("2024-03-31T01:59:59.999999999", 1, 0, 7200),
      ("2024-03-31T02:00:00", 1, 0, 7200),
      ("2024-03-31T02:59:59.999999999", 1, 0, 7200),
      ("2024-03-31T03:00:00", 0, 7200, 7200),
      ("2024-10-27T00:59:59.999999999", 0, 7200, 7200),
      ("2024-10-27T01:00:00", 2, 7200, 0),
      ("2024-10-27T01:59:59.999999999", 2, 7200, 0),
      ("2024-10-27T02:00:00", 2, 7200, 0),
      ("2024-10-27T02:59:59.999999999", 2, 7200, 0),
      ("2024-10-27T03:00:00", 0, 0, 0)
    ]
  )
  Ok(())
}
