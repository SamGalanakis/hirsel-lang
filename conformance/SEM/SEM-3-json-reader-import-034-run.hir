// rule: SEM-3
// expect: run
// JSONTestSuite 1ef36fa01286573e846ac449e8683f8833c5b26a test_parsing/*.json:1.
// Differential reader twin of the existing imports; exact JsonError offsets.
fn check(t: Test, source: String) -> () {
  let expected: Result[(), json.JsonError] = match json.parse(unique source) {
    Ok(_) => Ok(()),
    Error(e) => Error(e),
  }
  let mut cursor = json.reader(string.as_bytes(source))
  let actual = match json.skip(mut cursor) {
    Ok(()) => json.finish_reader(mut cursor),
    Error(e) => Error(e),
  }
  test.equal(t, actual, expected)
}

pub fn main(t: Test) -> Result[(), ()] {
  // "y_string_three-byte-utf-8.json:1"
  check(t, "[\"\\u0821\"]")
  // "y_string_two-byte-utf-8.json:1"
  check(t, "[\"\\u0123\"]")
  // "y_string_u+2028_line_sep.json:1"
  check(t, "[\"\u{2028}\"]")
  // "y_string_u+2029_par_sep.json:1"
  check(t, "[\"\u{2029}\"]")
  // "y_string_uEscape.json:1"
  check(t, "[\"\\u0061\\u30af\\u30EA\\u30b9\"]")
  // "y_string_uescaped_newline.json:1"
  check(t, "[\"new\\u000Aline\"]")
  // "y_string_unescaped_char_delete.json:1"
  check(t, "[\"\u{7f}\"]")
  // "y_string_unicode.json:1"
  check(t, "[\"\\uA66D\"]")
  Ok(())
}
