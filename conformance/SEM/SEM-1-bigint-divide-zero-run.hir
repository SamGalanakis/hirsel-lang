// rule: SEM-1
// expect: run
// The divide-zero twin: the same division by a nonzero BigInt divisor.
pub fn main(args: Args) -> Result[(), ()] {
  let divisor = bigint.from_u64(arg.count(args) + 8)
  let (q, r) = bigint.div_rem(bigint.from_u64(7), divisor)
  failure.check(bigint.is_zero(q) && r == bigint.from_u64(7), Arithmetic())
  Ok(())
}
