// rule: SEM-3
// expect: run
// Copyright (c) 2009 The RE2 Authors. BSD-3-Clause; third-party/NOTICES.md.
// Go regexp/testdata/re2-search.txt: ordered partial-match column, whole spans only.
fn check(pattern: String, input: String, expected: Option[regex.Span]) -> Result[(), ()] {
  let re = match regex.compile(pattern, 1000) {
    Ok(re) => take re,
    Error(_) => return Error(()),
  }
  failure.check(regex.find(re, input, 10000) == Ok(expected), TextInvariant())
  Ok(())
}

pub fn main() -> Result[(), ()] {
  check("^(?:h.*od?)", "", None())?
  check("^(?:h.*od?)", "hello\ngoodbye\n", Some(regex.Span(start: 0, end: 5)))?
  check("(?:h.*od?)$", "", None())?
  check("h.*o", "", None())?
  check("h.*o", "hello\ngoodbye\n", Some(regex.Span(start: 0, end: 5)))?
  check("^(?:h.*o)$", "", None())?
  check("^(?:h.*o)", "", None())?
  check("^(?:h.*o)", "hello\ngoodbye\n", Some(regex.Span(start: 0, end: 5)))?
  check("(?:h.*o)$", "", None())?
  check("[^\\s\\S]", "", None())?
  check("^(?:[^\\s\\S])$", "", None())?
  check("^(?:[^\\s\\S])", "", None())?
  check("(?:[^\\s\\S])$", "", None())?
  check("a*", "", Some(regex.Span(start: 0, end: 0)))?
  check("^(?:a*)$", "", Some(regex.Span(start: 0, end: 0)))?
  check("^(?:a*)", "", Some(regex.Span(start: 0, end: 0)))?
  check("(?:a*)$", "", Some(regex.Span(start: 0, end: 0)))?
  check("a*b", "", None())?
  check("a*b", "cab", Some(regex.Span(start: 1, end: 3)))?
  check("^(?:a*b)$", "", None())?
  check("^(?:a*b)", "", None())?
  check("(?:a*b)$", "", None())?
  check("(?:a*b)$", "cab", Some(regex.Span(start: 1, end: 3)))?
  check("((((((((((((((((((((x))))))))))))))))))))", "", None())?
  check(
    "((((((((((((((((((((x))))))))))))))))))))",
    "x",
    Some(regex.Span(start: 0, end: 1))
  )?
  check("^(?:((((((((((((((((((((x)))))))))))))))))))))$", "", None())?
  check(
    "^(?:((((((((((((((((((((x)))))))))))))))))))))$",
    "x",
    Some(regex.Span(start: 0, end: 1))
  )?
  check("^(?:((((((((((((((((((((x)))))))))))))))))))))", "", None())?
  check(
    "^(?:((((((((((((((((((((x)))))))))))))))))))))",
    "x",
    Some(regex.Span(start: 0, end: 1))
  )?
  check("(?:((((((((((((((((((((x)))))))))))))))))))))$", "", None())?
  check(
    "(?:((((((((((((((((((((x)))))))))))))))))))))$",
    "x",
    Some(regex.Span(start: 0, end: 1))
  )?
  check("[abcd]", "", None())?
  Ok(())
}
