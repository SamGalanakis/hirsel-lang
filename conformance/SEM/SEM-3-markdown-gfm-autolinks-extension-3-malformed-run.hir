// rule: SEM-3
// expect: run
// Published spec.txt vectors; tools/generate-markdown.py.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.check(
    s,
    "gfm/Autolinks (extension)/625/malformed",
    "www.google.com/sear\u{0}[&unterminated",
    "<p><a href=\"http://www.google.com/sear%EF%BF%BD%5B&amp;unterminated\">www.google.com/sear�[&amp;unterminated</a></p>\n",
    std@1/markdown.gfm_options()
  )
  failed += harness.check(
    s,
    "gfm/Autolinks (extension)/626/malformed",
    "www.google.com/search?q=commonmark&hl=en\u{0}[&unterminated",
    "<p><a href=\"http://www.google.com/search?q=commonmark&amp;hl=en%EF%BF%BD%5B&amp;unterminated\">www.google.com/search?q=commonmark&amp;hl=en�[&amp;unterminated</a></p>\n",
    std@1/markdown.gfm_options()
  )
  failed += harness.check(
    s,
    "gfm/Autolinks (extension)/627/malformed",
    "www.commonma\u{0}[&unterminated",
    "<p><a href=\"http://www.commonma%EF%BF%BD%5B&amp;unterminated\">www.commonma�[&amp;unterminated</a></p>\n",
    std@1/markdown.gfm_options()
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
