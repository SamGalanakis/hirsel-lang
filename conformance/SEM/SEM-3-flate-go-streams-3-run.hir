// rule: SEM-3
// expect: run
// Go src/compress/flate/flate_test.go TestStreams, cases 8-11
// (golang/go ebe2feef). Unlike Go, bytes after the final block are an error.
fn check(ok: bool) -> () uses {} {
  failure.check(ok, TextInvariant())
}

fn corrupt(decoded: Result[Bytes, flate.FlateError]) -> bool uses {} {
  match decoded {
    Error(Corrupt(_)) => true,
    _ => false,
  }
}

pub fn main(t: Test) -> Result[(), ()] {
  // complete HCLenTree, complete HLitTree, too large HDistTree
  check(
    flate.inflate(
      b"\xed\xff\x87\x05\x00\x00\x00\x00 \x04\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x08\x00\x00\x00\x00\x00\x00\x00\x04",
      1024
    ) == Error(Corrupt(3u64))
  )
  // complete HCLenTree, complete HLitTree, empty HDistTree, excessive repeater code
  check(
    corrupt(
      flate.inflate(
        b"\xed\xfd\x87\x05\x00\x00\x00\x00 \x04\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\xe8\xb1\x00",
        1024
      )
    )
  )
  // complete HCLenTree, complete HLitTree, empty HDistTree of normal length 30
  check(
    flate.inflate(
      b"\x05\xfd\x01$\x00\x00\x00\x00\x00\xf8\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\x07\x00\x00\x00\xfe\x01",
      1024
    ) == Ok(b"")
  )
  // complete HCLenTree, complete HLitTree, empty HDistTree of excessive length 31
  check(
    flate.inflate(
      b"\x05\xfe\x01$\x00\x00\x00\x00\x00\xf8\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\x07\x00\x00\x00\xfc\x03",
      1024
    ) == Error(Corrupt(3u64))
  )
  Ok(())
}
