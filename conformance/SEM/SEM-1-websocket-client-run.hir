// A WebSocket client against a scripted server: the RFC 6455 opening handshake
// with a selected protocol, masked frames, a ping answered while receiving and the
// server's closing handshake. The key and every mask come from the run's Random,
// splitmix64 with seed 0 here, so the script names the exact bytes.
pub type AppError = Grant(GrantError) | Ws(websocket.WsError)

fn check(ok: bool) -> () {
  failure.check(ok, Arithmetic())
}

fn origin() -> List[http.Header] uses {} {
  [http.Header(name: "Origin", value: "http://echo.test")]
}

pub fn main(rt: Io, args: Args) -> Result[(), AppError] {
  let r = io.random(rt) ? Grant
  let n = io.net(rt) ? Grant
  let url = "ws://echo.test/chat?x=1"
  let mut config = websocket.default_config()
  config.protocols = ["chat"]
  let mut ws = websocket.connect(n, r, url, origin(), config) ? Ws
  check(websocket.protocol(ws) == Some("chat"))
  check(websocket.receive(mut ws) == Ok(Some(Text("welcome"))))
  websocket.send_text(mut ws, "hi") ? Ws
  check(websocket.receive(mut ws) == Ok(Some(Text("hi"))))
  check(websocket.receive(mut ws) == Ok(None()))
  check(websocket.peer_close(ws) == Some((1000u16, "")))
  Ok(())
}
