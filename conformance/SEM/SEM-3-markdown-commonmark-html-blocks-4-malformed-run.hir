// rule: SEM-3
// expect: run
// Published spec.txt vectors; tools/generate-markdown.py.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.check(
    s,
    "commonmark/HTML blocks/160/malformed",
    "<table><tr><td>\nfoo\u{0}[&unterminated",
    "<table><tr><td>\nfoo�[&unterminated\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/HTML blocks/161/malformed",
    "<div></div>\n``` c\u{0}[&unterminated",
    "<div></div>\n``` c�[&unterminated\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/HTML blocks/162/malformed",
    "<a href=\"foo\"\u{0}[&unterminated",
    "<p>&lt;a href=&quot;foo&quot;�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/HTML blocks/163/malformed",
    "<Warning>\n*ba\u{0}[&unterminated",
    "<Warning>\n*ba�[&unterminated\n",
    std@1/markdown.default_options()
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
