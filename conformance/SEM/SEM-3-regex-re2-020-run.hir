fn check(pattern: String, input: String, expected: Option[regex.Span]) -> Result[(), ()] {
  let re = match regex.compile(pattern, 10000) {
    Ok(re) => take re,
    Error(_) => return Error(()),
  }
  failure.check(regex.find(re, input, 100000) == Ok(expected), TextInvariant())
  Ok(())
}

pub fn main() -> Result[(), ()] {
  // src/regexp/testdata/re2-search.txt:1120
  check("^(?:\\b(foo|bar|[A-Z])\\b)", "foo\n", Some(regex.Span(start: 0, end: 3)))?
  // src/regexp/testdata/re2-search.txt:1122
  check("(?:\\b(foo|bar|[A-Z])\\b)$", "", None())?
  // src/regexp/testdata/re2-search.txt:1123
  check("(?:\\b(foo|bar|[A-Z])\\b)$", "foo\n", None())?
  // src/regexp/testdata/re2-search.txt:1129
  check("\\b(foo|bar|[A-Z])\\b", "", None())?
  // src/regexp/testdata/re2-search.txt:1130
  check("\\b(foo|bar|[A-Z])\\b", "ffoo bbar N x", Some(regex.Span(start: 10, end: 11)))?
  // src/regexp/testdata/re2-search.txt:1132
  check("^(?:\\b(foo|bar|[A-Z])\\b)$", "", None())?
  // src/regexp/testdata/re2-search.txt:1133
  check("^(?:\\b(foo|bar|[A-Z])\\b)$", "ffoo bbar N x", None())?
  // src/regexp/testdata/re2-search.txt:1135
