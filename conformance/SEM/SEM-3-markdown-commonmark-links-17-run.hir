// rule: SEM-3
// expect: run
// Published spec.txt vectors; tools/generate-markdown.py.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.check(
    s,
    "commonmark/Links/556",
    "[foo] \n[]\n\n[foo]: /url \"title\"\n",
    "<p><a href=\"/url\" title=\"title\">foo</a>\n[]</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Links/557",
    "[foo]\n\n[foo]: /url \"title\"\n",
    "<p><a href=\"/url\" title=\"title\">foo</a></p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Links/558",
    "[*foo* bar]\n\n[*foo* bar]: /url \"title\"\n",
    "<p><a href=\"/url\" title=\"title\"><em>foo</em> bar</a></p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Links/559",
    "[[*foo* bar]]\n\n[*foo* bar]: /url \"title\"\n",
    "<p>[<a href=\"/url\" title=\"title\"><em>foo</em> bar</a>]</p>\n",
    std@1/markdown.default_options()
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
