fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.parses(s, "n_number_.-1.json:1", "[.-1]", 1)
  failed += harness.parses(s, "n_number_.2e-3.json:1", "[.2e-3]", 1)
  failed += harness.parses(s, "n_number_0.1.2.json:1", "[0.1.2]", 1)
  failed += harness.parses(s, "n_number_0.3e+.json:1", "[0.3e+]", 1)
  failed += harness.parses(s, "n_number_0.3e.json:1", "[0.3e]", 1)
  failed += harness.parses(s, "n_number_0.e1.json:1", "[0.e1]", 1)
  failed += harness.parses(s, "n_number_0_capital_E+.json:1", "[0E+]", 1)
  failed += harness.parses(s, "n_number_0_capital_E.json:1", "[0E]", 1)
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
