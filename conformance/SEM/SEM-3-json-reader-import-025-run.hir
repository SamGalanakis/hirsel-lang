// rule: SEM-3
// expect: run
// JSONTestSuite 1ef36fa01286573e846ac449e8683f8833c5b26a test_parsing/*.json:1.
// Differential reader twin of the existing imports; exact JsonError offsets.
fn check(t: Test, source: String) -> () {
  let expected: Result[(), json.JsonError] = match json.parse(unique source) {
    Ok(_) => Ok(()),
    Error(e) => Error(e),
  }
  let mut cursor = json.reader(string.as_bytes(source))
  let actual = match json.skip(mut cursor) {
    Ok(()) => json.finish_reader(mut cursor),
    Error(e) => Error(e),
  }
  test.equal(t, actual, expected)
}

pub fn main(t: Test) -> Result[(), ()] {
  // "n_structure_unclosed_array_unfinished_false.json:1"
  check(t, "[ true, fals")
  // "n_structure_unclosed_array_unfinished_true.json:1"
  check(t, "[ false, tru")
  // "n_structure_unclosed_object.json:1"
  check(t, "{\"asd\":\"asd\"")
  // "n_structure_unicode-identifier.json:1"
  check(t, "å")
  // "n_structure_whitespace_U+2060_word_joiner.json:1"
  check(t, "[⁠]")
  // "n_structure_whitespace_formfeed.json:1"
  check(t, "[\u{c}]")
  // "y_array_arraysWithSpaces.json:1"
  check(t, "[[]   ]")
  // "y_array_empty-string.json:1"
  check(t, "[\"\"]")
  Ok(())
}
