// rule: SEM-3
// expect: run
// Published spec.txt vectors; tools/generate-markdown.py.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.check(
    s,
    "commonmark/Hard line breaks/640/malformed",
    "`code  \u{0}[&unterminated",
    "<p>`code  �[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Hard line breaks/641/malformed",
    "`code\\\u{0}[&unterminated",
    "<p>`code\\�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Hard line breaks/642/malformed",
    "<a href=\"f\u{0}[&unterminated",
    "<p>&lt;a href=&quot;f�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Hard line breaks/643/malformed",
    "<a href=\"f\u{0}[&unterminated",
    "<p>&lt;a href=&quot;f�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Hard line breaks/644/malformed",
    "fo\u{0}[&unterminated",
    "<p>fo�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Hard line breaks/645/malformed",
    "foo\u{0}[&unterminated",
    "<p>foo�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
