// rule: SEM-3
// expect: run
// Published spec.txt vectors; tools/generate-markdown.py.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.check(
    s,
    "commonmark/Link reference definitions/204",
    "[foo]\n\n[foo]: first\n[foo]: second\n",
    "<p><a href=\"first\">foo</a></p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Link reference definitions/205",
    "[FOO]: /url\n\n[Foo]\n",
    "<p><a href=\"/url\">Foo</a></p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Link reference definitions/206",
    "[ΑΓΩ]: /φου\n\n[αγω]\n",
    "<p><a href=\"/%CF%86%CE%BF%CF%85\">αγω</a></p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Link reference definitions/207",
    "[foo]: /url\n",
    "",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Link reference definitions/208",
    "[\nfoo\n]: /url\nbar\n",
    "<p>bar</p>\n",
    std@1/markdown.default_options()
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
