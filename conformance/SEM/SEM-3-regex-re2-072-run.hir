fn check(pattern: String, input: String, expected: Option[regex.Span]) -> Result[(), ()] {
  let re = match regex.compile(pattern, 10000) {
    Ok(re) => take re,
    Error(_) => return Error(()),
  }
  failure.check(regex.find(re, input, 100000) == Ok(expected), TextInvariant())
  Ok(())
}

pub fn main() -> Result[(), ()] {
  // src/regexp/testdata/re2-search.txt:3232
  check(
    "^(?:[acegikmoqsuwy]+)",
    "acegikmoqsuwyACEGIKMOQSUWY",
    Some(regex.Span(start: 0, end: 13))
  )?
  // src/regexp/testdata/re2-search.txt:3234
  check("(?:[acegikmoqsuwy]+)$", "", None())?
  // src/regexp/testdata/re2-search.txt:3235
  check("(?:[acegikmoqsuwy]+)$", "acegikmoqsuwyACEGIKMOQSUWY", None())?
  // src/regexp/testdata/re2-search.txt:3241
  check("^abc", "", None())?
  // src/regexp/testdata/re2-search.txt:3242
  check("^abc", "abcdef", Some(regex.Span(start: 0, end: 3)))?
  // src/regexp/testdata/re2-search.txt:3244
  check("^(?:^abc)$", "", None())?
  // src/regexp/testdata/re2-search.txt:3245
  check("^(?:^abc)$", "abcdef", None())?
  // src/regexp/testdata/re2-search.txt:3247
  check("^(?:^abc)", "", None())?
  // src/regexp/testdata/re2-search.txt:3248
  check("^(?:^abc)", "abcdef", Some(regex.Span(start: 0, end: 3)))?
  // src/regexp/testdata/re2-search.txt:3250
  check("(?:^abc)$", "", None())?
  // src/regexp/testdata/re2-search.txt:3251
  check("(?:^abc)$", "abcdef", None())?
  Ok(())
