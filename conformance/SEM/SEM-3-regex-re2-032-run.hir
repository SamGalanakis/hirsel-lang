fn check(pattern: String, input: String, expected: Option[regex.Span]) -> Result[(), ()] {
  let re = match regex.compile(pattern, 10000) {
    Ok(re) => take re,
    Error(_) => return Error(()),
  }
  failure.check(regex.find(re, input, 100000) == Ok(expected), TextInvariant())
  Ok(())
}

pub fn main() -> Result[(), ()] {
  // src/regexp/testdata/re2-search.txt:1225
  check("\\b$", "", None())?
  // src/regexp/testdata/re2-search.txt:1226
  check("\\b$", "x", Some(regex.Span(start: 1, end: 1)))?
  // src/regexp/testdata/re2-search.txt:1228
  check("^(?:\\b$)$", "", None())?
  // src/regexp/testdata/re2-search.txt:1229
  check("^(?:\\b$)$", "x", None())?
