// rule: SEM-3
// expect: run
// Go zip/reader_test.go:58-584 TestReader: Bad-CRC32-in-data-descriptor.
pub fn main(t: Test) -> Result[(), ()] {
  let data = b"PK\x03\x04\x14\x00\x08\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x07\x00\x00\x00foo.txtfoo\x0aPK\x07\x08\xa9e2~\x04\x00\x00\x00\x04\x00\x00\x00PK\x03\x04\x14\x00\x08\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x07\x00\x00\x00bar.txtbar\x0aPK\x07\x08\xe9\xb3\xa2\x04\x04\x00\x00\x00\x04\x00\x00\x00PK\x01\x02\x14\x00\x14\x00\x08\x00\x00\x00\x00\x00\x00\x00\xa8e2~\x04\x00\x00\x00\x04\x00\x00\x00\x07\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00foo.txtPK\x01\x02\x14\x00\x14\x00\x08\x00\x00\x00\x00\x00\x00\x00\xe9\xb3\xa2\x04\x04\x00\x00\x00\x04\x00\x00\x00\x07\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x009\x00\x00\x00bar.txtPK\x05\x06\x00\x00\x00\x00\x02\x00\x02\x00j\x00\x00\x00r\x00\x00\x00\x00\x00"
  let es = match zip.entries(data) {
    Ok(es) => es,
    Error(_) => return Error(()),
  }
  test.check(t, list.len(es) == 2)
  test.check(t, es[0].name == "foo.txt" && es[0].size == 4)
  test.check(t, zip.read(data, es[0], 4096) == Error(Checksum("foo.txt")))
  test.check(t, es[1].name == "bar.txt" && es[1].size == 4)
  test.check(t, zip.read(data, es[1], 4096) == Ok(b"bar\x0a"))
  test.check(t, es[0].dos_time == 0)
  test.check(t, es[1].dos_time == 0)
  Ok(())
}
