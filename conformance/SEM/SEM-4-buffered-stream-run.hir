// rule: SEM-4
// expect: run
pub type ReadFailure = Network(NetError) | Buffered(std@1/bufio.ReadError[NetError])

pub fn main(t: Test) -> Result[(), ReadFailure] {
  let n = test.net(
    t,
    [
      NetPeer(
        address: "example.com",
        port: 80u16,
        resolves_to: [V4([127u8, 0u8, 0u8, 1u8])],
        tls: Plain(),
        connections: [Open([Send(b"a"), Send(b"\nbc\nxy"), Close()])]
      )
    ]
  )
  let mut stream = net.connect(n, "example.com", 80u16, Unbounded()) ? Network
  let mut r = std@1/bufio.new(2)
  test.check(
    t,
    std@1/bufio.stream_read_line(n, mut stream, mut r, 10) ? Buffered == "a\n"
  )
  test.check(
    t,
    std@1/bufio.stream_read_line(n, mut stream, mut r, 10) ? Buffered == "bc\n"
  )
  let mut out: List[u8] = [0]
  std@1/bufio.stream_read_exact(n, mut stream, mut r, mut out, 2) ? Buffered
  test.check(t, out == [0, 120, 121])
  test.check(t, std@1/bufio.stream_read_line(n, mut stream, mut r, 10) ? Buffered == "")
  net.close(n, take stream)
  Ok(())
}
