// rule: SEM-3
// expect: run
// Go readDirectoryEnd/readDirectory64End: absolute ZIP64 locator inside
// a tail buffer with a nonzero origin, plus prefix-relative entry offsets.
pub fn main(t: Test) -> Result[(), FileError] {
  let data = b"\x03\x04\x14\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x01\x00\x00\x00xPK\x01\x02\x14\x00\x14\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00xPK\x06\x06,\x00\x00\x00\x00\x00\x00\x00-\x00-\x00\x00\x00\x00\x00\x00\x00\x00\x00\x01\x00\x00\x00\x00\x00\x00\x00\x01\x00\x00\x00\x00\x00\x00\x00/\x00\x00\x00\x00\x00\x00\x00\x1f\x00\x00\x00\x00\x00\x00\x00PK\x06\x07\x00\x00\x00\x00\xbe\x11\x01\x00\x00\x00\x00\x00\x01\x00\x00\x00PK\x05\x06\x00\x00\x00\x00\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\x00\x00"
  let es = match zip.entries(data) {
    Ok(es) => es,
    Error(_) => return Error(FileFault(1u32)),
  }
  test.check(t, list.len(es) == 1 && es[0].offset == 70000)
  let size = core@1/bytes.len(data)
  let dir = test.dir(t, [(path.of("tail.zip"), take data)])
  let mut f = file.open(dir, path.of("tail.zip"))?
  let fs = match zip.file_entries(dir, mut f, size) {
    Ok(files) => files,
    Error(_) => return Error(FileFault(2u32)),
  }
  test.check(t, fs == es)
  test.check(t, zip.file_read(dir, mut f, fs[0], 1024) == Ok(b""))
  Ok(())
}
