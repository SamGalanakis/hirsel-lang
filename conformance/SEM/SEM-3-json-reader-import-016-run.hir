// rule: SEM-3
// expect: run
// JSONTestSuite 1ef36fa01286573e846ac449e8683f8833c5b26a test_parsing/*.json:1.
// Differential reader twin of the existing imports; exact JsonError offsets.
fn check(t: Test, source: String) -> () {
  let expected: Result[(), json.JsonError] = match json.parse(unique source) {
    Ok(_) => Ok(()),
    Error(e) => Error(e),
  }
  let mut cursor = json.reader(string.as_bytes(source))
  let actual = match json.skip(mut cursor) {
    Ok(()) => json.finish_reader(mut cursor),
    Error(e) => Error(e),
  }
  test.equal(t, actual, expected)
}

pub fn main(t: Test) -> Result[(), ()] {
  // "n_object_unquoted_key.json:1"
  check(t, "{a: \"b\"}")
  // "n_object_unterminated-value.json:1"
  check(t, "{\"a\":\"a")
  // "n_object_with_single_string.json:1"
  check(t, "{ \"foo\" : \"bar\", \"a\" }")
  // "n_object_with_trailing_garbage.json:1"
  check(t, "{\"a\":\"b\"}#")
  // "n_single_space.json:1"
  check(t, " ")
  // "n_string_1_surrogate_then_escape.json:1"
  check(t, "[\"\\uD800\\\"]")
  // "n_string_1_surrogate_then_escape_u.json:1"
  check(t, "[\"\\uD800\\u\"]")
  // "n_string_1_surrogate_then_escape_u1.json:1"
  check(t, "[\"\\uD800\\u1\"]")
  Ok(())
}
