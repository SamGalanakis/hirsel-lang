// rule: SEM-3
// expect: run
// RFC 5869 test case 4 (HKDF-SHA-1), through hkdf.derive.
pub fn main() -> Result[(), ()] {
  let okm = std@1/hkdf.derive(
    std@1/sha1.hash(),
    b"\x00\x01\x02\x03\x04\x05\x06\x07\x08\x09\x0a\x0b\x0c",
    b"\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b",
    b"\xf0\xf1\xf2\xf3\xf4\xf5\xf6\xf7\xf8\xf9",
    42
  )
  failure.check(
    std@1/hex.encode(okm) == "085a01ea1b10f36933068b56efa5ad81a4f14b822f5b091568a9cdd4f155fda2c22e422478d305f3f896",
    TextInvariant()
  )
  Ok(())
}
