// rule: SEM-3
// expect: run
// Levels 4 to 6 (deflate_slow) match zlib 1.3 output (madler/zlib 09155ea).
fn check(t: Test, actual: Bytes, expected: Bytes) -> () {
  test.check(t, actual == expected)
}

pub fn main(t: Test) -> Result[(), ()] {
  // two letters, level 4
  check(
    t,
    flate.deflate(
      b"baaaaaaaaabaaababbabbabaabaaaabaabbbabbaaaabbaaaaabbabbaaaabaaab",
      4
    ),
    b"KJ\x84\x81$0N\x82 \x08\x17LCD@\x1c0\x09U\x01\xd3\x00\x00"
  )
  // two letters, level 5
  check(
    t,
    flate.deflate(
      b"baaaaaaaaabaaababbabbabaabaaaabaabbbabbaaaabbaaaaabbabbaaaabaaab",
      5
    ),
    b"KJ\x84\x81$0N\x82 \x08\x17LCD@\x9c\xa4D(\x95\x04\x93LL\x02\x00"
  )
  // two letters, level 6
  check(
    t,
    flate.deflate(
      b"baaaaaaaaabaaababbabbabaabaaaabaabbbabbaaaabbaaaaabbabbaaaabaaab",
      6
    ),
    b"KJ\x84\x81$0N\x82 \x08\x17LCD@\x9c\xa4D(\x95\x94\x04\xd7\x00\x00"
  )
  Ok(())
}
