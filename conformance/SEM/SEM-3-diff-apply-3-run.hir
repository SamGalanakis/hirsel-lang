// rule: SEM-3
// expect: run
// Inputs: Go src/internal/diff/testdata (golang/go ebe2feef) and fixed pairs.
// Expected unified diffs are git 2.43.0's `git diff --no-index
// --no-indent-heuristic -U<n> --diff-algorithm=<myers|patience>` output, with
// names replaced and the function context after `@@` dropped; expected patch
// results are GNU patch 2.7.6's `patch --fuzz=0 --forward` output and rejected
// hunk numbers.
fn patched() -> List[(String, String, String, List[u64])] uses {} {
  [
    (
      "f0\nb2\nf0\nf1\nf2\ng2\nc0\ng1\ne0\nd2\na0\nf1\nh1\ne0\nd2\ne2\ng0\nd2\nd2\nh0\ng1\na2\ne0\nb1\nh2\ng2\na0\nf1\nf1\nb0\nd1\ne1\nc1\nb2\na2\ne2\nj77\nk70\ng1\ng2\n",
      "--- old\n+++ new\n@@ -2,3 +2,3 @@\n b2\n-f0\n+a0\n f1\n@@ -11,7 +11,5 @@\n a0\n-f1\n h1\n e0\n-d2\n-e2\n+b2\n g0\n@@ -20,4 +18,6 @@\n h0\n+c2\n g1\n-a2\n+y1\n+z1\n e0\n@@ -28,3 +28,2 @@\n f1\n-f1\n b0\n@@ -35,4 +34,3 @@\n a2\n-e2\n-a2\n+b2\n c0\n",
      "f0\nb2\na0\nf1\nf2\ng2\nc0\ng1\ne0\nd2\na0\nh1\ne0\nb2\ng0\nd2\nd2\nh0\nc2\ng1\ny1\nz1\ne0\nb1\nh2\ng2\na0\nf1\nb0\nd1\ne1\nc1\nb2\na2\ne2\nj77\nk70\ng1\ng2\n",
      [4u64]
    ),
    (
      "a1\nd2\nd1\nb0\nj26\ng1\na1\nk53\nd2\nh1\nd0\nh1\nc0\nf2\na0\nh2\na1\nb2\nj28\nd1\ng1\nf0\nh0\ng2\ng2\ng2\nh0\nb0\ne0\nb0\nh0\nf0\ng1\nb1\nc0\ng0\ng0\ng0\nd2\ng2\ng2\n",
      "--- old\n+++ new\n@@ -1,0 +2 @@\n+y2\n@@ -6,0 +8 @@\n+y0\n@@ -11,0 +14 @@\n+c2\n@@ -12,0 +16 @@\n+a1\n@@ -16 +20,2 @@\n-a1\n+z1\n+y1\n@@ -24 +28,0 @@\n-g2\n@@ -26,2 +30,2 @@\n-a0\n-b0\n+b1\n+b1\n@@ -29 +32,0 @@\n-b0\n",
      "a1\ny2\nd2\nd1\nb0\nj26\ng1\ny0\na1\nk53\nd2\nh1\nd0\nc2\nh1\na1\nc0\nf2\na0\nh2\nz1\ny1\nb2\nj28\nd1\ng1\nf0\nh0\ng2\ng2\nh0\nb0\ne0\nh0\nf0\ng1\nb1\nc0\ng0\ng0\ng0\nd2\ng2\ng2\n",
      [6u64]
    ),
    (
      "f2\nb0\nh2\ne1\na1\nc0\ne1\ne2\nf0\nb1\ne0\nh0\nc1\nf0\nf1\nc2\nb1\na2\ng0\nf1\nh2\ne2\ne1\ne2\nb2\nc1\nj89\nh0\nd2\nd1\na1\ne2\nd0\nd1\ne0\nf0\ng2\nc2\ne2\nb2\ne0\n",
      "--- old\n+++ new\n@@ -1,7 +1,8 @@\n f2\n b0\n+y2\n h2\n-e1\n+x1\n a1\n c0\n e1\n@@ -10,30 +11,32 @@\n b1\n e0\n h0\n+c2\n c1\n f0\n f1\n c2\n b1\n+x0\n a2\n g0\n-f1\n+c0\n h2\n e2\n e1\n e2\n b2\n-c1\n h0\n d2\n d1\n a1\n e2\n d0\n+z1\n d1\n e0\n f0\n-g2\n+b1\n c2\n e2\n b2\n",
      "f2\nb0\ny2\nh2\nx1\na1\nc0\ne1\ne2\nf0\nb1\ne0\nh0\nc1\nf0\nf1\nc2\nb1\na2\ng0\nf1\nh2\ne2\ne1\ne2\nb2\nc1\nj89\nh0\nd2\nd1\na1\ne2\nd0\nd1\ne0\nf0\ng2\nc2\ne2\nb2\ne0\n",
      [1u64]
    ),
    (
      "d0\na1\nc0\ne1\ne0\nc0\nf2\nc0\nc1\na1\nb2\nc2\nf1\na0\nf0\nb0\na0\ng1\nc0\nh2\ng2\nf2\nh1\nc1\nd1\nc1\nc1\nf2\nb0\nc0\nd0\nf1\nd0\nd2\nd2\na1\nk41\nb2\nb1\n",
      "--- old\n+++ new\n@@ -2,3 +2,3 @@\n a1\n-c0\n+b0\n e1\n@@ -10,2 +10,3 @@\n a1\n+c1\n b2\n@@ -13,6 +14,5 @@\n f1\n-a0\n+x2\n f0\n b0\n-a0\n g1\n@@ -26,2 +26,3 @@\n c1\n+x2\n c1\n@@ -29,7 +30,7 @@\n b0\n-c0\n d0\n f1\n+c2\n d0\n-d2\n+a1\n d2\n@@ -40 +41,3 @@\n a0\n+c1\n+z2\n",
      "d0\na1\nb0\ne1\ne0\nc0\nf2\nc0\nc1\na1\nc1\nb2\nc2\nf1\nx2\nf0\nb0\ng1\nc0\nh2\ng2\nf2\nh1\nc1\nd1\nc1\nx2\nc1\nf2\nb0\nd0\nf1\nc2\nd0\na1\nd2\na1\nk41\nb2\nb1\n",
      [5u64]
    )
  ]
}

pub fn main(t: Test) -> Result[(), diff.PatchError] {
  let mut case: u64 = 63
  for (source, patch, expected, rejected) in patched() {
    let applied = diff.apply(source, patch)?
    test.check_case(t, applied.text == expected && applied.rejected == rejected, case)
    case += 1
  }
  Ok(())
}
