// rule: SEM-3
// expect: reject SEM-3 at line 16
// twin: SEM/SEM-3-format-precision-ok.hir
// Precision does not apply to a @format type's text.
@format(point_text)
type Point {
  x: i64,
  y: i64,
}

fn point_text(p: Point, mut out: List[u8]) -> () uses {} {
  text.append(mut out, f"({p.x}, {p.y})")
}

fn label(p: Point) -> String {
  f"{p:.3}"
}
