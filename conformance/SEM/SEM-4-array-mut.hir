// rule: SEM-4
// expect: run
// stdout: ok
// "for x in mut xs binds the element place".
fn output_error[E](take e: E) -> () {}

pub fn main(rt: Io, args: Args) -> Result[(), ()] {
  let mut xs: Array[u8] = [1, 2, 3]
  for x in mut xs {
    x += 1
  }
  out.print(
    io.stdout(rt) ? grant_error,
    if xs[0] == 2 {
      "ok\n"
    } else {
      "bad\n"
    }
  ) ? output_error
  Ok(())
}

@noalloc
fn grant_error(refusal: GrantError) -> () uses {} {
  ()
}
