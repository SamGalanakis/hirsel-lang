// rule: SEM-3
// expect: run
pub fn main(rt: Io, args: Args) -> Result[(), OutputError] {
  failure.check(std@1/bytes.replace(b"", b"a", b"b") == b"", TextInvariant())
  failure.check(std@1/bytes.replace(b"aaaaa", b"aa", b"") == b"a", TextInvariant())
  failure.check(std@1/bytes.replace(b"a", b"aa", b"X") == b"a", TextInvariant())
  failure.check(std@1/bytes.replace(b"abc", b"z", b"X") == b"abc", TextInvariant())
  Ok(())
}
