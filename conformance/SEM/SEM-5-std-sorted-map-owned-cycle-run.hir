// rule: SEM-5
// expect: run
resource type Item {
  label: String,
}
drop(x) {}

fn cycle(by: Order[u64], mut m: unique SortedMap[u64, Item] of by) -> () {
  match take sorted_map.remove(by, mut m, 1) {
    Some(item) => sorted_map.insert(by, mut m, 2, take item),
    None => failure.check(false, Bounds()),
  }
  match take sorted_map.remove(by, mut m, 2) {
    Some(item) => failure.check(item.label == "owned", Bounds()),
    None => failure.check(false, Bounds()),
  }
}

pub fn main(t: Test) -> Result[(), ()] {
  let by = u64.order
  let mut m: unique SortedMap[u64, Item] of by = sorted_map.empty(by)
  sorted_map.insert(by, mut m, 1, Item(label: "owned"))
  cycle(by, mut m)
  failure.check(sorted_map.len(by, m) == 0, Bounds())
  Ok(())
}
