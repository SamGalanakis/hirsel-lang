// rule: SEM-3
// expect: run
// slog JSONHandler: duplicate attributes follow built-ins, in input order.
pub fn main(rt: Io) -> Result[(), GrantError] {
  let entry = std@1/log.Entry(
    level: Warn(),
    message: "a\n\"b\\c\t",
    fields: [
      std@1/log.Field(name: "level", value: Text("é")),
      std@1/log.Field(name: "level", value: Text("two"))
    ],
    timestamp: None()
  )
  let encoded = std@1/log.to_string(entry)
  failure.check(
    encoded == "{\"level\":\"WARN\",\"msg\":\"a\\n\\\"b\\\\c\\t\",\"level\":\"é\",\"level\":\"two\"}\n",
    TextInvariant()
  )
  let timestamped = std@1/log.Entry(
    level: Info(),
    message: "ok",
    fields: [],
    timestamp: Some(time.Timestamp(unix_nanoseconds: -1))
  )
  failure.check(
    std@1/log.to_string(timestamped) == "{\"time\":\"1969-12-31T23:59:59.999999999Z\",\"level\":\"INFO\",\"msg\":\"ok\"}\n",
    TextInvariant()
  )
  let empty = std@1/log.Entry(
    level: Debug(),
    message: "",
    fields: [],
    timestamp: None()
  )
  failure.check(
    std@1/log.to_string(empty) == "{\"level\":\"DEBUG\",\"msg\":\"\"}\n",
    TextInvariant()
  )
  let sink = io.stderr(rt)?
  failure.check(std@1/log.write(sink, Error(), entry) == Ok(()), TextInvariant())
  failure.check(std@1/log.write(sink, Debug(), entry) == Ok(()), TextInvariant())
  Ok(())
}
