// rule: SEM-3
// expect: run
// Published spec.txt vectors; tools/generate-markdown.py.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.check(
    s,
    "commonmark/List items/281/malformed",
    "- foo\n-\u{0}[&unterminated",
    "<ul>\n<li>foo\n-�[&amp;unterminated</li>\n</ul>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/List items/282/malformed",
    "- foo\n- \u{0}[&unterminated",
    "<ul>\n<li>foo</li>\n<li>�[&amp;unterminated</li>\n</ul>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/List items/283/malformed",
    "1. foo\n2\u{0}[&unterminated",
    "<ol>\n<li>foo\n2�[&amp;unterminated</li>\n</ol>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/List items/284/malformed",
    "*\u{0}[&unterminated",
    "<p>*�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/List items/285/malformed",
    "foo\n*\n\n\u{0}[&unterminated",
    "<p>foo\n*</p>\n<p>�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
