// rule: SEM-2
// expect: run
// Independent integer rational oracle; sum normal significands in units of 2^-50, then round once to 24 bits.
pub fn main(t: Test) -> Result[(), ()] {
  let xs: Array[f32] = [
    core@1/f32.from_bits(3021698990u32),
    core@1/f32.from_bits(1055977145u32),
    core@1/f32.from_bits(1091030673u32)
  ]
  core@1/test.check(t, core@1/f32.bits(std@1/f32.sum_exact(xs)) == 1091524103u32)
  Ok(())
}
