// rule: SEM-2
// expect: run
// Independent integer rational oracle; sum normal significands in units of 2^-50, then round once to 24 bits.
pub fn main(t: Test) -> Result[(), ()] {
  let xs: Array[f32] = [
    core@1/f32.from_bits(945751308u32),
    core@1/f32.from_bits(938153696u32),
    core@1/f32.from_bits(3297779150u32),
    core@1/f32.from_bits(3310543172u32),
    core@1/f32.from_bits(866810158u32)
  ]
  core@1/test.check(t, core@1/f32.bits(std@1/f32.sum_exact(xs)) == 3314382869u32)
  Ok(())
}
