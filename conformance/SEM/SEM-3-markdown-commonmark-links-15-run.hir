// rule: SEM-3
// expect: run
// Published spec.txt vectors; tools/generate-markdown.py.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.check(
    s,
    "commonmark/Links/547",
    "[foo][ref[bar]]\n\n[ref[bar]]: /uri\n",
    "<p>[foo][ref[bar]]</p>\n<p>[ref[bar]]: /uri</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Links/548",
    "[[[foo]]]\n\n[[[foo]]]: /url\n",
    "<p>[[[foo]]]</p>\n<p>[[[foo]]]: /url</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Links/549",
    "[foo][ref\\[]\n\n[ref\\[]: /uri\n",
    "<p><a href=\"/uri\">foo</a></p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Links/550",
    "[bar\\\\]: /uri\n\n[bar\\\\]\n",
    "<p><a href=\"/uri\">bar\\</a></p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Links/551",
    "[]\n\n[]: /uri\n",
    "<p>[]</p>\n<p>[]: /uri</p>\n",
    std@1/markdown.default_options()
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
