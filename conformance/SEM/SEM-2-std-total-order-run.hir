// rule: SEM-2
// expect: run
// std f32.total_order and f64.total_order: IEEE totalOrder after NaN
// canonicalization (the one NaN is positive, above +inf), -0 below +0, every
// pair of -inf, -MAX, -1, the negative and positive least subnormals, both
// zeros, the least normal, 1, MAX, +inf and NaNs of both signs. Expected
// orders are Rust's f64::total_cmp of the canonicalized bits.
pub fn main(t: Test) -> Result[(), ()] {
  let f32_values: Array[u32] = [
    0xff800000u32,
    0xff7fffffu32,
    0xbf800000u32,
    0x80000001u32,
    0x80000000u32,
    0x0u32,
    0x1u32,
    0x800000u32,
    0x3f800000u32,
    0x7f7fffffu32,
    0x7f800000u32,
    0x7fc00000u32,
    0xffc00000u32
  ]
  let f32_orders: Array[Array[i32]] = [
    [
      0i32,
      -1i32,
      -1i32,
      -1i32,
      -1i32,
      -1i32,
      -1i32,
      -1i32,
      -1i32,
      -1i32,
      -1i32,
      -1i32,
      -1i32
    ],
    [
      1i32,
      0i32,
      -1i32,
      -1i32,
      -1i32,
      -1i32,
      -1i32,
      -1i32,
      -1i32,
      -1i32,
      -1i32,
      -1i32,
      -1i32
    ],
    [
      1i32,
      1i32,
      0i32,
      -1i32,
      -1i32,
      -1i32,
      -1i32,
      -1i32,
      -1i32,
      -1i32,
      -1i32,
      -1i32,
      -1i32
    ],
    [
      1i32,
      1i32,
      1i32,
      0i32,
      -1i32,
      -1i32,
      -1i32,
      -1i32,
      -1i32,
      -1i32,
      -1i32,
      -1i32,
      -1i32
    ],
    [
      1i32,
      1i32,
      1i32,
      1i32,
      0i32,
      -1i32,
      -1i32,
      -1i32,
      -1i32,
      -1i32,
      -1i32,
      -1i32,
      -1i32
    ],
    [
      1i32,
      1i32,
      1i32,
      1i32,
      1i32,
      0i32,
      -1i32,
      -1i32,
      -1i32,
      -1i32,
      -1i32,
      -1i32,
      -1i32
    ],
    [1i32, 1i32, 1i32, 1i32, 1i32, 1i32, 0i32, -1i32, -1i32, -1i32, -1i32, -1i32, -1i32],
    [1i32, 1i32, 1i32, 1i32, 1i32, 1i32, 1i32, 0i32, -1i32, -1i32, -1i32, -1i32, -1i32],
    [1i32, 1i32, 1i32, 1i32, 1i32, 1i32, 1i32, 1i32, 0i32, -1i32, -1i32, -1i32, -1i32],
    [1i32, 1i32, 1i32, 1i32, 1i32, 1i32, 1i32, 1i32, 1i32, 0i32, -1i32, -1i32, -1i32],
    [1i32, 1i32, 1i32, 1i32, 1i32, 1i32, 1i32, 1i32, 1i32, 1i32, 0i32, -1i32, -1i32],
    [1i32, 1i32, 1i32, 1i32, 1i32, 1i32, 1i32, 1i32, 1i32, 1i32, 1i32, 0i32, 0i32],
    [1i32, 1i32, 1i32, 1i32, 1i32, 1i32, 1i32, 1i32, 1i32, 1i32, 1i32, 0i32, 0i32]
  ]
  for i in 0u64..13u64 {
    for j in 0u64..13u64 {
      let order = f32.total_order(
        f32.from_bits(f32_values[i]),
        f32.from_bits(f32_values[j])
      )
      failure.check(order == f32_orders[i][j], Bounds())
    }
  }
  let f64_values: Array[u64] = [
    0xfff0000000000000u64,
    0xffefffffffffffffu64,
    0xbff0000000000000u64,
    0x8000000000000001u64,
    0x8000000000000000u64,
    0x0u64,
    0x1u64,
    0x10000000000000u64,
    0x3ff0000000000000u64,
    0x7fefffffffffffffu64,
    0x7ff0000000000000u64,
    0x7ff8000000000000u64,
    0xfff8000000000000u64
  ]
  let f64_orders: Array[Array[i32]] = [
    [
      0i32,
      -1i32,
      -1i32,
      -1i32,
      -1i32,
      -1i32,
      -1i32,
      -1i32,
      -1i32,
      -1i32,
      -1i32,
      -1i32,
      -1i32
    ],
    [
      1i32,
      0i32,
      -1i32,
      -1i32,
      -1i32,
      -1i32,
      -1i32,
      -1i32,
      -1i32,
      -1i32,
      -1i32,
      -1i32,
      -1i32
    ],
    [
      1i32,
      1i32,
      0i32,
      -1i32,
      -1i32,
      -1i32,
      -1i32,
      -1i32,
      -1i32,
      -1i32,
      -1i32,
      -1i32,
      -1i32
    ],
    [
      1i32,
      1i32,
      1i32,
      0i32,
      -1i32,
      -1i32,
      -1i32,
      -1i32,
      -1i32,
      -1i32,
      -1i32,
      -1i32,
      -1i32
    ],
    [
      1i32,
      1i32,
      1i32,
      1i32,
      0i32,
      -1i32,
      -1i32,
      -1i32,
      -1i32,
      -1i32,
      -1i32,
      -1i32,
      -1i32
    ],
    [
      1i32,
      1i32,
      1i32,
      1i32,
      1i32,
      0i32,
      -1i32,
      -1i32,
      -1i32,
      -1i32,
      -1i32,
      -1i32,
      -1i32
    ],
    [1i32, 1i32, 1i32, 1i32, 1i32, 1i32, 0i32, -1i32, -1i32, -1i32, -1i32, -1i32, -1i32],
    [1i32, 1i32, 1i32, 1i32, 1i32, 1i32, 1i32, 0i32, -1i32, -1i32, -1i32, -1i32, -1i32],
    [1i32, 1i32, 1i32, 1i32, 1i32, 1i32, 1i32, 1i32, 0i32, -1i32, -1i32, -1i32, -1i32],
    [1i32, 1i32, 1i32, 1i32, 1i32, 1i32, 1i32, 1i32, 1i32, 0i32, -1i32, -1i32, -1i32],
    [1i32, 1i32, 1i32, 1i32, 1i32, 1i32, 1i32, 1i32, 1i32, 1i32, 0i32, -1i32, -1i32],
    [1i32, 1i32, 1i32, 1i32, 1i32, 1i32, 1i32, 1i32, 1i32, 1i32, 1i32, 0i32, 0i32],
    [1i32, 1i32, 1i32, 1i32, 1i32, 1i32, 1i32, 1i32, 1i32, 1i32, 1i32, 0i32, 0i32]
  ]
  for i in 0u64..13u64 {
    for j in 0u64..13u64 {
      let order = f64.total_order(
        f64.from_bits(f64_values[i]),
        f64.from_bits(f64_values[j])
      )
      failure.check(order == f64_orders[i][j], Bounds())
    }
  }
  Ok(())
}
