// rule: SEM-3
// expect: run
// Published spec.txt vectors; tools/generate-markdown.py.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.check(
    s,
    "commonmark/Emphasis and strong emphasis/477",
    "__<a href=\"__\">\n",
    "<p>__<a href=\"__\"></p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Emphasis and strong emphasis/478",
    "*a `*`*\n",
    "<p><em>a <code>*</code></em></p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Emphasis and strong emphasis/479",
    "_a `_`_\n",
    "<p><em>a <code>_</code></em></p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Emphasis and strong emphasis/480",
    "**a<https://foo.bar/?q=**>\n",
    "<p>**a<a href=\"https://foo.bar/?q=**\">https://foo.bar/?q=**</a></p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Emphasis and strong emphasis/481",
    "__a<https://foo.bar/?q=__>\n",
    "<p>__a<a href=\"https://foo.bar/?q=__\">https://foo.bar/?q=__</a></p>\n",
    std@1/markdown.default_options()
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
