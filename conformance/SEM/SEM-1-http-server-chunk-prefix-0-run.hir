// rule: SEM-1
// expect: run
pub fn main() -> Result[(), http.HttpError] {
  let input: Bytes = b"POST /upload HTTP/1.1\r\nTransfer-Encoding: chunked\r\n\r\n4;ext=yes\r\nWiki\r\n5\r\npedia\r\n0\r\nx-check: yes\r\n\r\nNEXT"
  let complete = bytes.len(input) - 4
  let mut end: u64 = 0
  while end < complete {
    failure.check(
      http.parse_server_request(bytes.slice(input, 0, end), 1024, 9)? == None(),
      TextInvariant()
    )
    end += 4
  }
  Ok(())
}
