// rule: SEM-4
// expect: run
// stdout: aa
fn first(s: String) -> String in s {
  for piece in unicode.graphemes(s) {
    return piece
  }
  copy s
}

fn first_copy(s: String) -> String in s {
  for piece in unicode.graphemes(s) {
    return copy piece
  }
  copy s
}

pub fn main(rt: Io, args: Args) -> Result[(), GrantError] {
  let s = string.concat("a", "b")
  let _ = out.print(io.stdout(rt)?, first(s))
  let _ = out.print(io.stdout(rt)?, first_copy(s))
  let _ = out.print(io.stdout(rt)?, "\n")
  Ok(())
}
