// rule: SEM-1
// expect: test
fn field(name: Bytes, value: Bytes) -> std@1/hpack.Field {
  std@1/hpack.Field(name: unique name, value: unique value, sensitive: false)
}

fn block(mut d: std@1/hpack.Decoder, encoded: Bytes, expected: List[std@1/hpack.Field]) {
  core@1/failure.check(
    std@1/hpack.decode(mut d, encoded, 65536) == Ok(expected),
    TextInvariant()
  )
}

// Go x/net/http2/hpack TestDecoderDecode and TestDecodeC3/C4.
@test
fn requests(t: Test) {
  let mut d = std@1/hpack.decoder(4096)
  block(
    mut d,
    b"\x40\x0acustom-key\x0dcustom-header",
    [field(b"custom-key", b"custom-header")]
  )
  block(mut d, b"\x04\x0c/sample/path", [field(b":path", b"/sample/path")])
  block(
    mut d,
    b"\x10\x08password\x06secret",
    [std@1/hpack.Field(name: b"password", value: b"secret", sensitive: true)]
  )
  block(mut d, b"\x82", [field(b":method", b"GET")])
  let mut plain = std@1/hpack.decoder(4096)
  let mut huff = std@1/hpack.decoder(4096)
  let first: List[std@1/hpack.Field] = [
    field(b":method", b"GET"),
    field(b":scheme", b"http"),
    field(b":path", b"/"),
    field(b":authority", b"www.example.com")
  ]
  block(mut plain, b"\x82\x86\x84\x41\x0fwww.example.com", first)
  block(
    mut huff,
    b"\x82\x86\x84\x41\x8c\xf1\xe3\xc2\xe5\xf2\x3a\x6b\xa0\xab\x90\xf4\xff",
    first
  )
  let second: List[std@1/hpack.Field] = [
    field(b":method", b"GET"),
    field(b":scheme", b"http"),
    field(b":path", b"/"),
    field(b":authority", b"www.example.com"),
    field(b"cache-control", b"no-cache")
  ]
  block(mut plain, b"\x82\x86\x84\xbe\x58\x08no-cache", second)
  block(mut huff, b"\x82\x86\x84\xbe\x58\x86\xa8\xeb\x10\x64\x9c\xbf", second)
  let third: List[std@1/hpack.Field] = [
    field(b":method", b"GET"),
    field(b":scheme", b"https"),
    field(b":path", b"/index.html"),
    field(b":authority", b"www.example.com"),
    field(b"custom-key", b"custom-value")
  ]
  block(mut plain, b"\x82\x87\x85\xbf\x40\x0acustom-key\x0ccustom-value", third)
  block(
    mut huff,
    b"\x82\x87\x85\xbf\x40\x88\x25\xa8\x49\xe9\x5b\xa9\x7d\x7f\x89\x25\xa8\x49\xe9\x5b\xb8\xe8\xb4\xbf",
    third
  )
  test.check(t, true)
}

@test
fn huffman(t: Test) {
  test.check(
    t,
    std@1/hpack.huffman_encode(b"www.example.com") == b"\xf1\xe3\xc2\xe5\xf2\x3a\x6b\xa0\xab\x90\xf4\xff"
  )
  let mut octets: List[u8] = []
  for n in 0u16..256u16 {
    core@1/list.push(mut octets, core@1/int.narrow(n))
  }
  let data = bytes.from_list(take octets)
  test.check(
    t,
    std@1/hpack.huffman_decode(std@1/hpack.huffman_encode(data), 256) == Ok(data)
  )
  test.check(t, std@1/hpack.huffman_decode(b"", 0) == Ok(b""))
  test.check(t, std@1/hpack.huffman_decode(b"\xff", 100) == Error(InvalidHuffman()))
  test.check(
    t,
    std@1/hpack.huffman_decode(b"\xff\xff\xff\xff", 100) == Error(InvalidHuffman())
  )
  test.check(t, std@1/hpack.huffman_decode(b"\x18", 100) == Error(InvalidHuffman()))
  test.check(t, std@1/hpack.huffman_decode(b"\x1f", 0) == Error(HeaderListTooLarge()))
  test.check(t, std@1/hpack.huffman_decode(b"\x1f", 1) == Ok(b"a"))
}

@test
fn encoder_and_limits(t: Test) {
  let mut e = std@1/hpack.encoder(4096)
  let mut d = std@1/hpack.decoder(4096)
  let fields: List[std@1/hpack.Field] = [
    field(b"custom-key", b"custom-value"),
    field(b":method", b"GET")
  ]
  let first = std@1/hpack.encode(mut e, fields)
  block(mut d, first, fields)
  test.check(t, std@1/hpack.encode(mut e, fields) == b"\xbe\x82")
  block(mut d, b"\xbe\x82", fields)
  std@1/hpack.set_capacity(mut e, 0)
  std@1/hpack.set_capacity(mut e, 100)
  let resized = std@1/hpack.encode(mut e, fields)
  test.check(t, bytes.slice(resized, 0, 4) == b"\x20\x3f\x45\x40")
  block(mut d, resized, fields)
  let secret: List[std@1/hpack.Field] = [
    std@1/hpack.Field(name: b":method", value: b"GET", sensitive: true)
  ]
  block(mut d, std@1/hpack.encode(mut e, secret), secret)
  let mut limited = std@1/hpack.decoder(4096)
  test.check(
    t,
    std@1/hpack.decode(mut limited, b"\x82", 41) == Error(HeaderListTooLarge())
  )
  test.check(t, std@1/hpack.decode(mut limited, b"\x82", 100) == Error(Failed()))
  let mut exact = std@1/hpack.decoder(4096)
  block(mut exact, b"\x82", [field(b":method", b"GET")])
  std@1/hpack.set_allowed_capacity(mut exact, 0)
  test.check(
    t,
    std@1/hpack.decode(mut exact, b"\x20\x82", 42) == Ok([field(b":method", b"GET")])
  )
}

@test
fn malformed(t: Test) {
  let invalid: List[Bytes] = [
    b"\x80",
    b"\xbe",
    b"\xff",
    b"\x40",
    b"\x40\x01x",
    b"\x00\x01x\x7f",
    b"\x3f\xe2\x1f",
    b"\x82\x20",
    b"\x1f\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\x01"
  ]
  for data in invalid {
    let mut d = std@1/hpack.decoder(4096)
    match std@1/hpack.decode(mut d, data, 1000) {
      Error(_) => (),
      Ok(_) => test.check(t, false),
    }
  }
  // Indexed fields cost 42 bytes each even though their wire form is one byte.
  let mut d = std@1/hpack.decoder(4096)
  test.check(
    t,
    std@1/hpack.decode(mut d, b"\x82\x82", 83) == Error(HeaderListTooLarge())
  )
  let mut twin = std@1/hpack.decoder(4096)
  test.check(
    t,
    std@1/hpack.decode(mut twin, b"\x82\x82", 84) == Ok(
      [field(b":method", b"GET"), field(b":method", b"GET")]
    )
  )
}

// Go TestDecodeC5/C6: indexed reuse across table evictions.
@test
fn responses(t: Test) {
  let mut plain = std@1/hpack.decoder(256)
  block(
    mut plain,
    b"\x48\x03\x33\x30\x32\x58\x07\x70\x72\x69\x76\x61\x74\x65\x61\x1d\x4d\x6f\x6e\x2c\x20\x32\x31\x20\x4f\x63\x74\x20\x32\x30\x31\x33\x20\x32\x30\x3a\x31\x33\x3a\x32\x31\x20\x47\x4d\x54\x6e\x17\x68\x74\x74\x70\x73\x3a\x2f\x2f\x77\x77\x77\x2e\x65\x78\x61\x6d\x70\x6c\x65\x2e\x63\x6f\x6d",
    [
      field(b":status", b"302"),
      field(b"cache-control", b"private"),
      field(b"date", b"Mon, 21 Oct 2013 20:13:21 GMT"),
      field(b"location", b"https://www.example.com")
    ]
  )
  block(
    mut plain,
    b"\x48\x03\x33\x30\x37\xc1\xc0\xbf",
    [
      field(b":status", b"307"),
      field(b"cache-control", b"private"),
      field(b"date", b"Mon, 21 Oct 2013 20:13:21 GMT"),
      field(b"location", b"https://www.example.com")
    ]
  )
  block(
    mut plain,
    b"\x88\xc1\x61\x1d\x4d\x6f\x6e\x2c\x20\x32\x31\x20\x4f\x63\x74\x20\x32\x30\x31\x33\x20\x32\x30\x3a\x31\x33\x3a\x32\x32\x20\x47\x4d\x54\xc0\x5a\x04\x67\x7a\x69\x70\x77\x38\x66\x6f\x6f\x3d\x41\x53\x44\x4a\x4b\x48\x51\x4b\x42\x5a\x58\x4f\x51\x57\x45\x4f\x50\x49\x55\x41\x58\x51\x57\x45\x4f\x49\x55\x3b\x20\x6d\x61\x78\x2d\x61\x67\x65\x3d\x33\x36\x30\x30\x3b\x20\x76\x65\x72\x73\x69\x6f\x6e\x3d\x31",
    [
      field(b":status", b"200"),
      field(b"cache-control", b"private"),
      field(b"date", b"Mon, 21 Oct 2013 20:13:22 GMT"),
      field(b"location", b"https://www.example.com"),
      field(b"content-encoding", b"gzip"),
      field(b"set-cookie", b"foo=ASDJKHQKBZXOQWEOPIUAXQWEOIU; max-age=3600; version=1")
    ]
  )
  let mut huff = std@1/hpack.decoder(256)
  block(
    mut huff,
    b"\x48\x82\x64\x02\x58\x85\xae\xc3\x77\x1a\x4b\x61\x96\xd0\x7a\xbe\x94\x10\x54\xd4\x44\xa8\x20\x05\x95\x04\x0b\x81\x66\xe0\x82\xa6\x2d\x1b\xff\x6e\x91\x9d\x29\xad\x17\x18\x63\xc7\x8f\x0b\x97\xc8\xe9\xae\x82\xae\x43\xd3",
    [
      field(b":status", b"302"),
      field(b"cache-control", b"private"),
      field(b"date", b"Mon, 21 Oct 2013 20:13:21 GMT"),
      field(b"location", b"https://www.example.com")
    ]
  )
  block(
    mut huff,
    b"\x48\x83\x64\x0e\xff\xc1\xc0\xbf",
    [
      field(b":status", b"307"),
      field(b"cache-control", b"private"),
      field(b"date", b"Mon, 21 Oct 2013 20:13:21 GMT"),
      field(b"location", b"https://www.example.com")
    ]
  )
  block(
    mut huff,
    b"\x88\xc1\x61\x96\xd0\x7a\xbe\x94\x10\x54\xd4\x44\xa8\x20\x05\x95\x04\x0b\x81\x66\xe0\x84\xa6\x2d\x1b\xff\xc0\x5a\x83\x9b\xd9\xab\x77\xad\x94\xe7\x82\x1d\xd7\xf2\xe6\xc7\xb3\x35\xdf\xdf\xcd\x5b\x39\x60\xd5\xaf\x27\x08\x7f\x36\x72\xc1\xab\x27\x0f\xb5\x29\x1f\x95\x87\x31\x60\x65\xc0\x03\xed\x4e\xe5\xb1\x06\x3d\x50\x07",
    [
      field(b":status", b"200"),
      field(b"cache-control", b"private"),
      field(b"date", b"Mon, 21 Oct 2013 20:13:22 GMT"),
      field(b"location", b"https://www.example.com"),
      field(b"content-encoding", b"gzip"),
      field(b"set-cookie", b"foo=ASDJKHQKBZXOQWEOPIUAXQWEOIU; max-age=3600; version=1")
    ]
  )
  test.check(t, true)
}
