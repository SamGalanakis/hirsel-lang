// rule: SEM-3
// expect: run
pub fn main() -> Result[(), ()] {
  let options = markdown.default_options()
  failure.check(
    markdown.to_html_bounded("é&", options, 15) == Ok("<p>é&amp;</p>\n"),
    TextInvariant()
  )
  failure.check(
    markdown.to_html_bounded("é&", options, 14) == Error(
      markdown.OutputLimit(limit: 14)
    ),
    TextInvariant()
  )
  Ok(())
}
