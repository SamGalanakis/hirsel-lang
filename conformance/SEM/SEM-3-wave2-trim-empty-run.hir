// rule: SEM-3
// expect: run
pub fn main(rt: Io, args: Args) -> Result[(), OutputError] {
  failure.check(std@1/string.trim("") == "", TextInvariant())
  failure.check(std@1/string.trim(" \t\n\r\u{b}\u{c}") == "", TextInvariant())
  failure.check(std@1/string.trim("é😀") == "é😀", TextInvariant())
  Ok(())
}
