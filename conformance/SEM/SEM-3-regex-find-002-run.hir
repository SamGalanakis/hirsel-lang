fn check(pattern: String, input: String, expected: Option[regex.Span]) -> Result[(), ()] {
  let re = match regex.compile(pattern, 10000) {
    Ok(re) => take re,
    Error(_) => return Error(()),
  }
  failure.check(regex.find(re, input, 100000) == Ok(expected), TextInvariant())
  Ok(())
}

pub fn main() -> Result[(), ()] {
  // src/regexp/find_test.go:51
  check("a+", "baaab", Some(regex.Span(start: 1, end: 4)))?
  // src/regexp/find_test.go:52
  check("a*", "baaab", Some(regex.Span(start: 0, end: 0)))?
  // src/regexp/find_test.go:53
  check("[a-z]+", "abcd", Some(regex.Span(start: 0, end: 4)))?
  // src/regexp/find_test.go:54
  check("[^a-z]+", "ab1234cd", Some(regex.Span(start: 2, end: 6)))?
  // src/regexp/find_test.go:55
  check("[a\\-\\]z]+", "az]-bcz", Some(regex.Span(start: 0, end: 4)))?
  // src/regexp/find_test.go:56
  check("[^\\n]+", "abcd\n", Some(regex.Span(start: 0, end: 4)))?
  // src/regexp/find_test.go:57
  check("[日本語]+", "日本語日本語", Some(regex.Span(start: 0, end: 18)))?
  // src/regexp/find_test.go:58
  check("日本語+", "日本語", Some(regex.Span(start: 0, end: 9)))?
  // src/regexp/find_test.go:59
  check("日本語+", "日本語語語語", Some(regex.Span(start: 0, end: 18)))?
  // src/regexp/find_test.go:60
  check("()", "", Some(regex.Span(start: 0, end: 0)))?
  // src/regexp/find_test.go:61
  check("(a)", "a", Some(regex.Span(start: 0, end: 1)))?
  // src/regexp/find_test.go:62
  check("(.)(.)", "日a", Some(regex.Span(start: 0, end: 4)))?
  // src/regexp/find_test.go:63
  check("(.*)", "", Some(regex.Span(start: 0, end: 0)))?
  // src/regexp/find_test.go:64
  check("(.*)", "abcd", Some(regex.Span(start: 0, end: 4)))?
  // src/regexp/find_test.go:65
  check("(..)(..)", "abcd", Some(regex.Span(start: 0, end: 4)))?
  // src/regexp/find_test.go:66
  check("(([^xyz]*)(d))", "abcd", Some(regex.Span(start: 0, end: 4)))?
  // src/regexp/find_test.go:67
  check("((a|b|c)*(d))", "abcd", Some(regex.Span(start: 0, end: 4)))?
  // src/regexp/find_test.go:68
  check("(((a|b|c)*)(d))", "abcd", Some(regex.Span(start: 0, end: 4)))?
