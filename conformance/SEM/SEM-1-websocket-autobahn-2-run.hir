              Send(b"\x88\x82\x124Vx\x11\xdc"),
              Expect(
                b"\x8a}\xfe\xfe\xfe\xfe\xfe\xfe\xfe\xfe\xfe\xfe\xfe\xfe\xfe\xfe\xfe\xfe\xfe\xfe\xfe\xfe\xfe\xfe\xfe\xfe\xfe\xfe\xfe\xfe\xfe\xfe\xfe\xfe\xfe\xfe\xfe\xfe\xfe\xfe\xfe\xfe\xfe\xfe\xfe\xfe\xfe\xfe\xfe\xfe\xfe\xfe\xfe\xfe\xfe\xfe\xfe\xfe\xfe\xfe\xfe\xfe\xfe\xfe\xfe\xfe\xfe\xfe\xfe\xfe\xfe\xfe\xfe\xfe\xfe\xfe\xfe\xfe\xfe\xfe\xfe\xfe\xfe\xfe\xfe\xfe\xfe\xfe\xfe\xfe\xfe\xfe\xfe\xfe\xfe\xfe\xfe\xfe\xfe\xfe\xfe\xfe\xfe\xfe\xfe\xfe\xfe\xfe\xfe\xfe\xfe\xfe\xfe\xfe\xfe\xfe\xfe\xfe\xfe\xfe\xfe\xfe\xfe\xfe\xfe\xfe\xfe\x88\x02\x03\xe8"
              )
            ]
          )
        ]
      )
    ]
  )
  let expected: List[Result[u16, websocket.WsError]] = [
    Ok(1000u16),
    Error(Protocol(ControlTooLong())),
    Ok(1000u16)
  ]
  let mut config = websocket.default_config()
  config.max_message_bytes = 1000
  let mut listener = net.listen(n, home()) ? Network
  for outcome in expected {
    let (stream, _) = net.accept(n, mut listener) ? Network
    let mut connection = http.server_connection(n, take stream, http.default_config())
    let request = http.receive_request(mut connection, None()) ? Http
    let ws = match websocket.accept(take connection, request, config) {
      Ok(ws) => ws,
      Error(_) => {
        test.check(t, false)
        return Ok(())
      },
    }
    test.check(t, echo(take ws) == outcome)
  }
  Ok(())
}
