// rule: SEM-1
// expect: run
// entry: main
// Autobahn testsuite cases 2.3, 2.5, 2.6 (crossbario/autobahn-testsuite
// ff462c0a7ccb6512ad8442d09dab371a3c40a843): binary ping; ping 126; ping 125 in
// 1-byte chunks. Scripted clients play them against an echo server with a
// 1000-byte message limit; each case is its own connection and handshake, so a
// program holds three within the corpus step budget.
pub type AppError = Network(NetError) | Http(http.HttpError)

fn home() -> SocketAddr uses {} {
  SocketAddr(ip: V4([127u8, 0u8, 0u8, 1u8]), port: 9001u16)
}

// Echoes every message; returns the peer's close code or the receive error.
fn echo(take ws: websocket.Conn) -> Result[u16, websocket.WsError] {
  let mut conn = take ws
  while let Some(message) = websocket.receive(mut conn)? {
    match message {
      Text(text) => websocket.send_text(mut conn, text)?,
      Binary(data) => websocket.send_binary(mut conn, data)?,
    }
  }
  match websocket.peer_close(conn) {
    Some((code, _)) => Ok(code),
    None() => Ok(0u16),
  }
}

pub fn main(t: Test) -> Result[(), AppError] {
  let n = test.net(
    t,
    [],
    [
      NetListener(
        address: "127.0.0.1",
        port: 9001u16,
        clients: [
          // Autobahn 2.3 binary ping
          NetClient(
            from: SocketAddr(ip: V4([192u8, 0u8, 2u8, 1u8]), port: 40000u16),
            tls: Plain(),
            steps: [
              Send(
                b"GET / HTTP/1.1\r\nHost: localhost\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\n\r\n"
              ),
              Expect(
                b"HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: s3pPLMBiTxaQ9kYGzzhZRbK+xOo=\r\n\r\n"
              ),
              Send(
                b"\x89\x88\x124Vx\x12\xcb\xa8\x85\xee\xcfV\x87\x88\x82\x124Vx\x11\xdc"
              ),
              Expect(b"\x8a\x08\x00\xff\xfe\xfd\xfc\xfb\x00\xff\x88\x02\x03\xe8")
            ]
          ),
          // Autobahn 2.5 ping 126
          NetClient(
            from: SocketAddr(ip: V4([192u8, 0u8, 2u8, 1u8]), port: 40001u16),
            tls: Plain(),
            steps: [
              Send(
                b"GET / HTTP/1.1\r\nHost: localhost\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\n\r\n"
              ),
              Expect(
                b"HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: s3pPLMBiTxaQ9kYGzzhZRbK+xOo=\r\n\r\n"
              ),
              Send(
                b"\x89\xfe\x00~\x124Vx\xec\xca\xa8\x86\xec\xca\xa8\x86\xec\xca\xa8\x86\xec\xca\xa8\x86\xec\xca\xa8\x86\xec\xca\xa8\x86\xec\xca\xa8\x86\xec\xca\xa8\x86\xec\xca\xa8\x86\xec\xca\xa8\x86\xec\xca\xa8\x86\xec\xca\xa8\x86\xec\xca\xa8\x86\xec\xca\xa8\x86\xec\xca\xa8\x86\xec\xca\xa8\x86\xec\xca\xa8\x86\xec\xca\xa8\x86\xec\xca\xa8\x86\xec\xca\xa8\x86\xec\xca\xa8\x86\xec\xca\xa8\x86\xec\xca\xa8\x86\xec\xca\xa8\x86\xec\xca\xa8\x86\xec\xca\xa8\x86\xec\xca\xa8\x86\xec\xca\xa8\x86\xec\xca\xa8\x86\xec\xca\xa8\x86\xec\xca\xa8\x86\xec\xca"
              ),
              Expect(b"\x88\x02\x03\xea")
            ]
          ),
          // Autobahn 2.6 ping 125 in 1-byte chunks
          NetClient(
            from: SocketAddr(ip: V4([192u8, 0u8, 2u8, 1u8]), port: 40002u16),
            tls: Plain(),
            steps: [
              Send(
                b"GET / HTTP/1.1\r\nHost: localhost\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\n\r\n"
              ),
              Expect(
