// rule: SEM-3
// expect: run
// std@1/toml counts header-created tables and containers below those tables toward MAX_NESTING.
fn error_of(text: String) -> Option[toml.TomlError] {
  match toml.parse(unique text) {
    Ok(_) => None(),
    Error(e) => Some(e),
  }
}

fn at(line: u64, column: u64) -> toml.Position {
  toml.Position(line: line, column: column)
}

fn repeat(piece: String, count: u64) -> String {
  let mut out: List[u8] = []
  let mut i: u64 = 0
  while i < count {
    text.append(mut out, piece)
    i += 1
  }
  text.finish_valid(take out)
}

pub fn main() -> Result[(), ()] {
  failure.check(toml.MAX_NESTING == 128, TextInvariant())
  let header = string.concat("[", string.concat(repeat("a.", 127), "a]"))
  failure.check(error_of(header) == None(), TextInvariant())
  let too_deep = string.concat("[", string.concat(repeat("a.", 128), "a]"))
  failure.check(error_of(too_deep) == Some(Nesting(at(1, 258))), TextInvariant())
  failure.check(
    error_of(string.concat(header, "\nb = {}")) == Some(Nesting(at(2, 5))),
    TextInvariant()
  )
  Ok(())
}
