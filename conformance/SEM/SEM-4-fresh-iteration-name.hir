// rule: SEM-4
// expect: run
// stdout: ok
// "binds a fresh name per iteration"; escaping closures capture that iteration’s plain value.
fn output_error[E](take e: E) -> () {}

pub fn main(rt: Io, args: Args) -> Result[(), ()] {
  let mut fs: Array[fn() -> u64 uses {}] = [
    fn() -> u64 {
      99
    },
    fn() -> u64 {
      99
    },
    fn() -> u64 {
      99
    }
  ]
  let start: u64 = 0
  let end: u64 = 3
  for i in start..end {
    fs[i] = fn() -> u64 {
      i
    }
  }
  out.print(
    io.stdout(rt) ? grant_error,
    if if fs[0]() == 0 {
      if fs[1]() == 1 {
        fs[2]() == 2
      } else {
        false
      }
    } else {
      false
    } {
      "ok\n"
    } else {
      "bad\n"
    }
  ) ? output_error
  Ok(())
}

@noalloc
fn grant_error(refusal: GrantError) -> () uses {} {
  ()
}
