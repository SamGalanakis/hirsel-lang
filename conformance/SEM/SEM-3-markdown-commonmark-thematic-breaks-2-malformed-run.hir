// rule: SEM-3
// expect: run
// Published spec.txt vectors; tools/generate-markdown.py.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.check(
    s,
    "commonmark/Thematic breaks/50/malformed",
    "___________________\u{0}[&unterminated",
    "<p>___________________�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Thematic breaks/51/malformed",
    " - \u{0}[&unterminated",
    "<ul>\n<li>�[&amp;unterminated</li>\n</ul>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Thematic breaks/52/malformed",
    " **  * ** \u{0}[&unterminated",
    "<p>**  * ** �[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Thematic breaks/53/malformed",
    "-     -    \u{0}[&unterminated",
    "<ul>\n<li>\n<pre><code>-    �[&amp;unterminated\n</code></pre>\n</li>\n</ul>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Thematic breaks/54/malformed",
    "- - - \u{0}[&unterminated",
    "<ul>\n<li>\n<ul>\n<li>\n<ul>\n<li>�[&amp;unterminated</li>\n</ul>\n</li>\n</ul>\n</li>\n</ul>\n",
    std@1/markdown.default_options()
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
