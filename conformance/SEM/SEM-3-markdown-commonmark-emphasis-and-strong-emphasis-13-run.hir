// rule: SEM-3
// expect: run
// Published spec.txt vectors; tools/generate-markdown.py.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.check(
    s,
    "commonmark/Emphasis and strong emphasis/421",
    "**** is not an empty strong emphasis\n",
    "<p>**** is not an empty strong emphasis</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Emphasis and strong emphasis/422",
    "**foo [bar](/url)**\n",
    "<p><strong>foo <a href=\"/url\">bar</a></strong></p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Emphasis and strong emphasis/423",
    "**foo\nbar**\n",
    "<p><strong>foo\nbar</strong></p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Emphasis and strong emphasis/424",
    "__foo _bar_ baz__\n",
    "<p><strong>foo <em>bar</em> baz</strong></p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Emphasis and strong emphasis/425",
    "__foo __bar__ baz__\n",
    "<p><strong>foo <strong>bar</strong> baz</strong></p>\n",
    std@1/markdown.default_options()
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
