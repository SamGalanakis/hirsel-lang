// rule: SEM-3
// expect: run
// steps: 20000000
// sixty-five split digests of a 128-byte message
// Zig SHA-256 reference vectors and padding boundaries: every split of one
// 128-byte message into two updates gives its one-shot digest.
fn digest_hex(data: Inline[u8, 32]) -> String {
  let mut out: List[u8] = []
  for byte in data {
    list.push(mut out, byte)
  }
  std@1/hex.encode(bytes.from_list(take out))
}

pub fn main() -> Result[(), ()] {
  let data = b"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
  let whole = std@1/sha256.digest(data)
  failure.check(
    digest_hex(whole) == "6836cf13bac400e9105071cd6af47084dfacad4e5e302c94bfed24e013afb73e",
    TextInvariant()
  )
  for split in 0u64..65u64 {
    let mut state = std@1/sha256.new()
    std@1/sha256.update(mut state, bytes.slice(data, 0, split))
    std@1/sha256.update(mut state, bytes.slice(data, split, 128))
    failure.check(std@1/sha256.finish(take state) == whole, TextInvariant())
  }
  Ok(())
}
