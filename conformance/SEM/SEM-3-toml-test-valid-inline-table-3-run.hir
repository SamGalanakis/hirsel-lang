fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.valid(
    s,
    "valid/inline-table/key-dotted-01",
    "a = {   a.b  =  1   }\nb = {   \"a\".\"b\"  =  1   }\nc = {   a   .   b  =  1   }\nd = {   'a'   .   \"b\"  =  1   }\ne = {a.b=1}\n",
    "{\"a\":{\"a\":{\"b\":{\"type\":\"integer\",\"value\":\"1\"}}},\"b\":{\"a\":{\"b\":{\"type\":\"integer\",\"value\":\"1\"}}},\"c\":{\"a\":{\"b\":{\"type\":\"integer\",\"value\":\"1\"}}},\"d\":{\"a\":{\"b\":{\"type\":\"integer\",\"value\":\"1\"}}},\"e\":{\"a\":{\"b\":{\"type\":\"integer\",\"value\":\"1\"}}}}"
  )
  failed += harness.valid(
    s,
    "valid/inline-table/key-dotted-02",
    "many.dots.here.dot.dot.dot = {a.b.c = 1, a.b.d = 2}\n",
    "{\"many\":{\"dots\":{\"here\":{\"dot\":{\"dot\":{\"dot\":{\"a\":{\"b\":{\"c\":{\"type\":\"integer\",\"value\":\"1\"},\"d\":{\"type\":\"integer\",\"value\":\"2\"}}}}}}}}}}"
  )
  failed += harness.valid(
    s,
    "valid/inline-table/key-dotted-03",
    "[tbl]\na.b.c = {d.e=1}\n\n[tbl.x]\na.b.c = {d.e=1}\n",
    "{\"tbl\":{\"a\":{\"b\":{\"c\":{\"d\":{\"e\":{\"type\":\"integer\",\"value\":\"1\"}}}}},\"x\":{\"a\":{\"b\":{\"c\":{\"d\":{\"e\":{\"type\":\"integer\",\"value\":\"1\"}}}}}}}}"
  )
  failed += harness.valid(
    s,
    "valid/inline-table/key-dotted-04",
    "[[arr]]\nt = {a.b=1}\nT = {a.b=1}\n\n[[arr]]\nt = {a.b=2}\nT = {a.b=2}\n",
    "{\"arr\":[{\"T\":{\"a\":{\"b\":{\"type\":\"integer\",\"value\":\"1\"}}},\"t\":{\"a\":{\"b\":{\"type\":\"integer\",\"value\":\"1\"}}}},{\"T\":{\"a\":{\"b\":{\"type\":\"integer\",\"value\":\"2\"}}},\"t\":{\"a\":{\"b\":{\"type\":\"integer\",\"value\":\"2\"}}}}]}"
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
