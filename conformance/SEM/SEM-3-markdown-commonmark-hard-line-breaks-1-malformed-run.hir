// rule: SEM-3
// expect: run
// Published spec.txt vectors; tools/generate-markdown.py.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.check(
    s,
    "commonmark/Hard line breaks/633/malformed",
    "foo  \u{0}[&unterminated",
    "<p>foo  �[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Hard line breaks/634/malformed",
    "foo\\\u{0}[&unterminated",
    "<p>foo\\�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Hard line breaks/635/malformed",
    "foo    \u{0}[&unterminated",
    "<p>foo    �[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Hard line breaks/636/malformed",
    "foo  \n \u{0}[&unterminated",
    "<p>foo<br />\n�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Hard line breaks/637/malformed",
    "foo\\\n  \u{0}[&unterminated",
    "<p>foo<br />\n�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Hard line breaks/638/malformed",
    "*foo  \u{0}[&unterminated",
    "<p>*foo  �[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Hard line breaks/639/malformed",
    "*foo\\\u{0}[&unterminated",
    "<p>*foo\\�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
