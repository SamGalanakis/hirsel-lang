// rule: SEM-3
// expect: run
// Published spec.txt vectors; tools/generate-markdown.py.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.check(
    s,
    "commonmark/Links/565/malformed",
    "[foo][bar]\n\n[foo]: \u{0}[&unterminated",
    "<p>[foo][bar]</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Links/566/malformed",
    "[foo][]\n\n[f\u{0}[&unterminated",
    "<p>[foo][]</p>\n<p>[f�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Links/567/malformed",
    "[foo]()\n\n[f\u{0}[&unterminated",
    "<p><a href=\"\">foo</a></p>\n<p>[f�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Links/568/malformed",
    "[foo](not a link\u{0}[&unterminated",
    "<p>[foo](not a link�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
