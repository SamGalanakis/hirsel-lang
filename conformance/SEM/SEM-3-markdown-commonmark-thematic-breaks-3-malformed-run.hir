// rule: SEM-3
// expect: run
// Published spec.txt vectors; tools/generate-markdown.py.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.check(
    s,
    "commonmark/Thematic breaks/55/malformed",
    "_ _ _ _ a\n\na--\u{0}[&unterminated",
    "<p>_ _ _ _ a</p>\n<p>a--�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Thematic breaks/56/malformed",
    " *\u{0}[&unterminated",
    "<p>*�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Thematic breaks/57/malformed",
    "- foo\n**\u{0}[&unterminated",
    "<ul>\n<li>foo\n**�[&amp;unterminated</li>\n</ul>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Thematic breaks/58/malformed",
    "Foo\n**\u{0}[&unterminated",
    "<p>Foo\n**�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Thematic breaks/59/malformed",
    "Foo\n--\u{0}[&unterminated",
    "<p>Foo\n--�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Thematic breaks/60/malformed",
    "* Foo\n* *\u{0}[&unterminated",
    "<ul>\n<li>Foo</li>\n<li>*�[&amp;unterminated</li>\n</ul>\n",
    std@1/markdown.default_options()
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
