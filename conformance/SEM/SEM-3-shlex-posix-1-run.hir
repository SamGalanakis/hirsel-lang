// rule: SEM-3
// expect: run
// CPython Lib/test/test_shlex.py posix_data (testSplitPosix, with comments),
// the same rows without `#` through split, testJoinRoundtrip over data and
// posix_data, testQuote and testJoin (python/cpython 036d309c). Python raises
// ValueError where these return UnclosedQuote or TrailingEscape.
fn posix() -> List[(String, List[String])] uses {} {
  [
    ("x", ["x"]),
    ("foo bar", ["foo", "bar"]),
    (" foo bar", ["foo", "bar"]),
    (" foo bar ", ["foo", "bar"]),
    ("foo   bar    bla     fasel", ["foo", "bar", "bla", "fasel"]),
    ("x y  z              xxxx", ["x", "y", "z", "xxxx"]),
    (r#"\x bar"#, ["x", "bar"]),
    (r#"\ x bar"#, [" x", "bar"]),
    (r#"\ bar"#, [" bar"]),
    (r#"foo \x bar"#, ["foo", "x", "bar"]),
    (r#"foo \ x bar"#, ["foo", " x", "bar"]),
    (r#"foo \ bar"#, ["foo", " bar"]),
    (r#"foo "bar" bla"#, ["foo", "bar", "bla"]),
    (r#""foo" "bar" "bla""#, ["foo", "bar", "bla"]),
    (r#""foo" bar "bla""#, ["foo", "bar", "bla"]),
    (r#""foo" bar bla"#, ["foo", "bar", "bla"]),
    ("foo 'bar' bla", ["foo", "bar", "bla"]),
    ("'foo' 'bar' 'bla'", ["foo", "bar", "bla"]),
    ("'foo' bar 'bla'", ["foo", "bar", "bla"]),
    ("'foo' bar bla", ["foo", "bar", "bla"]),
    (r#"blurb foo"bar"bar"fasel" baz"#, ["blurb", "foobarbarfasel", "baz"]),
    ("blurb foo'bar'bar'fasel' baz", ["blurb", "foobarbarfasel", "baz"]),
    (r#""""#, [""]),
    ("''", [""]),
    (r#"foo "" bar"#, ["foo", "", "bar"]),
    ("foo '' bar", ["foo", "", "bar"]),
    (r#"foo "" "" "" bar"#, ["foo", "", "", "", "bar"]),
    ("foo '' '' '' bar", ["foo", "", "", "", "bar"]),
    (r#"\""#, [r#"""#]),
    (r#""\"""#, [r#"""#]),
    (r#""foo\ bar""#, [r#"foo\ bar"#]),
    (r#""foo\\ bar""#, [r#"foo\ bar"#]),
    (r#""foo\\ bar\"""#, [r#"foo\ bar""#]),
    (r#""foo\\" bar\""#, [r#"foo\"#, r#"bar""#]),
    (r#""foo\\ bar\" dfadf""#, [r#"foo\ bar" dfadf"#]),
    (r#""foo\\\ bar\" dfadf""#, [r#"foo\\ bar" dfadf"#]),
    (r#""foo\\\x bar\" dfadf""#, [r#"foo\\x bar" dfadf"#]),
    (r#""foo\x bar\" dfadf""#, [r#"foo\x bar" dfadf"#]),
    (r#"\'"#, ["'"]),
    (r#"'foo\ bar'"#, [r#"foo\ bar"#]),
    (r#"'foo\\ bar'"#, [r#"foo\\ bar"#]),
    (r#""foo\\\x bar\" df'a\ 'df""#, [r#"foo\\x bar" df'a\ 'df"#]),
    (r#"\"foo"#, [r#""foo"#]),
    (r#"\"foo\x"#, [r#""foox"#]),
    (r#""foo\x""#, [r#"foo\x"#]),
    (r#""foo\ ""#, [r#"foo\ "#]),
    (r#"foo\ xx"#, ["foo xx"]),
    (r#"foo\ x\x"#, ["foo xx"]),
    (r#"foo\ x\x\""#, [r#"foo xx""#]),
    (r#""foo\ x\x""#, [r#"foo\ x\x"#]),
    (r#""foo\ x\x\\""#, [r#"foo\ x\x\"#])
  ]
}

pub fn main(t: Test) -> Result[(), shlex.SplitError] {
  let mut case: u64 = 0
  for (line, expected) in posix() {
    test.check_case(t, shlex.split_comments(line)? == expected, case)
    if !string.contains(line, "#") {
      test.check_case(t, shlex.split(line)? == expected, case)
    }
    test.check_case(t, shlex.split(shlex.join(expected))? == expected, case)
    case += 1
  }
  Ok(())
}
