    "`` foo `\u{0}[&unterminated",
    "<p>`` foo `�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Code spans/330/malformed",
    "` `\u{0}[&unterminated",
    "<p><code> </code>�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Code spans/331/malformed",
    "`  `\u{0}[&unterminated",
    "<p><code>  </code>�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Code spans/332/malformed",
    "` \u{0}[&unterminated",
    "<p>` �[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Code spans/333/malformed",
    "` b\u{0}[&unterminated",
    "<p>` b�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Code spans/334/malformed",
    "` `\n\u{0}[&unterminated",
    "<p><code> </code>\n�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
