// rule: SEM-3
// expect: run
// Published spec.txt vectors; tools/generate-markdown.py.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.check(
    s,
    "commonmark/Links/569/malformed",
    "[foo][bar][baz\u{0}[&unterminated",
    "<p>[foo][bar][baz�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Links/570/malformed",
    "[foo][bar][baz]\n\n[baz\u{0}[&unterminated",
    "<p>[foo][bar][baz]</p>\n<p>[baz�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Links/571/malformed",
    "[foo][bar][baz]\n\n[baz\u{0}[&unterminated",
    "<p>[foo][bar][baz]</p>\n<p>[baz�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
