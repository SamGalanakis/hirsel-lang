// rule: SEM-1
// expect: run
// POSIX TZ rules alone, in TZif data with no transitions: jiff's
// time_zone_posix_to_ambiguous_timestamp vectors for northern, southern and
// negative DST under Earlier, Later and Reject.
fn zone(t: Test, rule: String) -> time.TimeZone {
  test.expect_ok(t, time_zone.from_tzif(check.footer_only(rule)))
}

fn offsets(t: Test, rule: String, rows: List[(i128, i32)]) -> () {
  let posix = zone(t, rule)
  for (second, offset) in rows {
    test.equal(
      t,
      time_zone.offset(posix, time.Timestamp(unix_nanoseconds: second * 1000000000)),
      offset
    )
  }
}

pub fn main(t: Test) -> Result[(), ()] {
  check.ambiguity(
    t,
    zone(t, "EST5"),
    [
      ("1969-12-31T19:00:00", 0, -18000, -18000),
      ("2024-03-10T02:00:00", 0, -18000, -18000)
    ]
  )
  check.ambiguity(
    t,
    zone(t, "EST5EDT,M3.2.0,M11.1.0"),
    [
      ("1969-12-31T19:00:00", 0, -18000, -18000),
      ("2024-03-10T01:59:59.999999999", 0, -18000, -18000),
      ("2024-03-10T02:00:00", 1, -18000, -14400),
      ("2024-03-10T02:59:59.999999999", 1, -18000, -14400),
      ("2024-03-10T03:00:00", 0, -14400, -14400),
      ("2024-11-03T00:59:59.999999999", 0, -14400, -14400),
      ("2024-11-03T01:00:00", 2, -14400, -18000),
      ("2024-11-03T01:59:59.999999999", 2, -14400, -18000),
      ("2024-11-03T02:00:00", 0, -18000, -18000)
    ]
  )
  // DST whose offset equals standard time is never ambiguous.
  check.ambiguity(
    t,
    zone(t, "EST5EDT5,M3.2.0,M11.1.0"),
    [
      ("2024-03-10T02:00:00", 0, -18000, -18000),
      ("2024-03-10T02:59:59.999999999", 0, -18000, -18000),
      ("2024-11-03T01:00:00", 0, -18000, -18000),
      ("2024-11-03T01:59:59.999999999", 0, -18000, -18000)
    ]
  )
  // Europe/Dublin: DST an hour behind standard time.
  check.ambiguity(
    t,
    zone(t, "IST-1GMT0,M10.5.0,M3.5.0/1"),
    [
      ("1970-01-01T00:00:00", 0, 0, 0),
      ("2024-03-31T00:59:59.999999999", 0, 0, 0),
      ("2024-03-31T01:00:00", 1, 0, 3600),
      ("2024-03-31T01:59:59.999999999", 1, 0, 3600),
      ("2024-03-31T02:00:00", 0, 3600, 3600),
      ("2024-10-27T00:59:59.999999999", 0, 3600, 3600),
      ("2024-10-27T01:00:00", 2, 3600, 0),
      ("2024-10-27T01:59:59.999999999", 2, 3600, 0),
      ("2024-10-27T02:00:00", 0, 0, 0)
    ]
  )
  // Australia/Tasmania: DST across the new year.
  check.ambiguity(
    t,
    zone(t, "AEST-10AEDT,M10.1.0,M4.1.0/3"),
    [
      ("1970-01-01T11:00:00", 0, 39600, 39600),
      ("2024-04-07T01:59:59.999999999", 0, 39600, 39600),
      ("2024-04-07T02:00:00", 2, 39600, 36000),
      ("2024-04-07T02:59:59.999999999", 2, 39600, 36000),
      ("2024-04-07T03:00:00", 0, 36000, 36000),
      ("2024-10-06T01:59:59.999999999", 0, 36000, 36000),
      ("2024-10-06T02:00:00", 1, 36000, 39600),
      ("2024-10-06T02:59:59.999999999", 1, 36000, 39600),
      ("2024-10-06T03:00:00", 0, 39600, 39600)
    ]
  )
  Ok(())
}
