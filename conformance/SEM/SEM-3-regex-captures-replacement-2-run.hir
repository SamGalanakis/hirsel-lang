// rule: SEM-3
// expect: run
// Go ebe2feef capture/flag/replacement vectors (BSD-3-Clause).
// RE2 data Copyright 2009 The RE2 Authors (BSD-3-Clause).
fn check(
  pattern: String,
  input: String,
  replacement: String,
  expected: String,
  literal: bool
) -> Result[(), ()] {
  let Ok(re) = regex.compile(pattern, 10000) else {
    return Error(())
  }
  let actual = if literal {
    regex.replace_all_literal(re, input, replacement, 1000000)
  } else {
    regex.replace_all(re, input, replacement, 1000000)
  }
  failure.check(actual == Ok(expected), TextInvariant())
  Ok(())
}

pub fn main() -> Result[(), ()] {
  // Go all_test.go:158
  check("y", "", "", "", false)?
  // Go all_test.go:159
  check("y", "", "x", "", false)?
  // Go all_test.go:160
  check("y", "abc", "", "abc", false)?
  // Go all_test.go:161
  check("y", "abc", "x", "abc", false)?
  // Go all_test.go:165
  check("[a-c]*", "日", "x", "x日x", false)?
  // Go all_test.go:166
  check("[^日]", "abc日def", "x", "xxx日xxx", false)?
  // Go all_test.go:169
  check("^[a-c]*", "abcdabc", "x", "xdabc", false)?
  // Go all_test.go:170
  check("[a-c]*$", "abcdabc", "x", "abcdx", false)?
  Ok(())
}
