// rule: SEM-3
// expect: run
// Published spec.txt vectors; tools/generate-markdown.py.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.check(
    s,
    "commonmark/List items/275/malformed",
    "   foo\u{0}[&unterminated",
    "<p>foo�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/List items/276/malformed",
    "-    foo\u{0}[&unterminated",
    "<ul>\n<li>foo�[&amp;unterminated</li>\n</ul>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/List items/277/malformed",
    "-  foo\n\u{0}[&unterminated",
    "<ul>\n<li>foo\n�[&amp;unterminated</li>\n</ul>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/List items/278/malformed",
    "-\n  foo\n-\n  ```\n  ba\u{0}[&unterminated",
    "<ul>\n<li>foo</li>\n<li>\n<pre><code>ba�[&amp;unterminated\n</code></pre>\n</li>\n</ul>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/List items/279/malformed",
    "-   \n\u{0}[&unterminated",
    "<ul>\n<li></li>\n</ul>\n<p>�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/List items/280/malformed",
    "-\n\n \u{0}[&unterminated",
    "<ul>\n<li></li>\n</ul>\n<p>�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
