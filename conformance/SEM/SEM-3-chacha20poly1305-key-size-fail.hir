// rule: SEM-3
// expect: fail SEM-3 at line 402
// A 31-byte ChaCha20-Poly1305 key is refused before any encryption.
pub fn main() -> Result[(), ()] {
  let sealed = std@1/chacha20poly1305.seal(
    b"0123456789abcdef0123456789abcde",
    b"0123456789ab",
    b"",
    b""
  )
  failure.check(bytes.len(sealed) == 16, TextInvariant())
  Ok(())
}
