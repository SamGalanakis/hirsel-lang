// Generated by tools/generate-toml-test.py from toml-test ff49d109861c
// tests/files-toml-1.1.0, group valid-table.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.valid(
    s,
    "valid/table/with-pound",
    "[\"key#group\"]\nanswer = 42\n",
    "{\"key#group\":{\"answer\":{\"type\":\"integer\",\"value\":\"42\"}}}"
  )
  failed += harness.valid(
    s,
    "valid/table/with-single-quotes",
    "['a']\n[a.'b']\n[a.'b'.c]\nanswer = 42 \n",
    "{\"a\":{\"b\":{\"c\":{\"answer\":{\"type\":\"integer\",\"value\":\"42\"}}}}}"
  )
  failed += harness.valid(
    s,
    "valid/table/without-super",
    "# [x] you\n# [x.y] don't\n# [x.y.z] need these\n[x.y.z.w] # for this to work\n[x] # defining a super-table afterwards is ok\n",
    "{\"x\":{\"y\":{\"z\":{\"w\":{}}}}}"
  )
  failed += harness.valid(
    s,
    "valid/table/without-super-with-values",
    "# [x] you\n# [x.y] don't\n# [x.y.z] need these\n[x.y.z.w] # for this to work\na = 1\nb = 2\n[x] # defining a super-table afterwards is ok\nc = 3\nd = 4\n",
    "{\"x\":{\"c\":{\"type\":\"integer\",\"value\":\"3\"},\"d\":{\"type\":\"integer\",\"value\":\"4\"},\"y\":{\"z\":{\"w\":{\"a\":{\"type\":\"integer\",\"value\":\"1\"},\"b\":{\"type\":\"integer\",\"value\":\"2\"}}}}}}"
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
