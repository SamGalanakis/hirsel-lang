// rule: SEM-1
// expect: run
pub fn main(t: Test) -> Result[(), ()] {
  core@1/test.check(t, std@1/i8.to_string(12i8) == "12")
  core@1/test.check(t, std@1/i8.parse("12") == Ok(12i8))
  let mut buffer: Inline[u8, 2] = [99u8, 99u8]
  core@1/test.check(t, std@1/i8.format(12i8, mut buffer) == Ok(2u64))
  core@1/test.check(t, buffer == [49u8, 50u8])
  Ok(())
}
