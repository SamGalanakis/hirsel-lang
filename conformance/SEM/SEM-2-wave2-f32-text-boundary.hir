// rule: SEM-2
// expect: run
@noalloc
fn parsed_bits(t: Test, text: String, expected: u32) -> () {
  match std@1/f32.parse(text) {
    Ok(value) => core@1/test.check(t, core@1/f32.bits(value) == expected),
    Error(_) => core@1/test.check(t, false),
  }
}

pub fn main(t: Test) -> Result[(), ()] {
  core@1/test.check(t, std@1/f32.to_string(core@1/f32.from_bits(0u32)) == "0")
  parsed_bits(t, "0", 0u32)
  core@1/test.check(t, std@1/f32.to_string(core@1/f32.from_bits(2147483648u32)) == "-0")
  parsed_bits(t, "-0", 2147483648u32)
  core@1/test.check(
    t,
    std@1/f32.to_string(core@1/f32.from_bits(2139095040u32)) == "inf"
  )
  parsed_bits(t, "inf", 2139095040u32)
  core@1/test.check(
    t,
    std@1/f32.to_string(core@1/f32.from_bits(4286578688u32)) == "-inf"
  )
  parsed_bits(t, "-inf", 4286578688u32)
  core@1/test.check(
    t,
    std@1/f32.to_string(core@1/f32.from_bits(2143289344u32)) == "NaN"
  )
  parsed_bits(t, "NaN", 2143289344u32)
  parsed_bits(t, "-1e-10000", 2147483648u32)
  parsed_bits(t, "0e999999999999999999999999999999", 0u32)
  Ok(())
}
