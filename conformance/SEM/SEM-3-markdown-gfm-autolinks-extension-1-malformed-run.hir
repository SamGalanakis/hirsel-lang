// rule: SEM-3
// expect: run
// Published spec.txt vectors; tools/generate-markdown.py.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.check(
    s,
    "gfm/Autolinks (extension)/621/malformed",
    "www.commo\u{0}[&unterminated",
    "<p><a href=\"http://www.commo%EF%BF%BD%5B&amp;unterminated\">www.commo�[&amp;unterminated</a></p>\n",
    std@1/markdown.gfm_options()
  )
  failed += harness.check(
    s,
    "gfm/Autolinks (extension)/622/malformed",
    "Visit www.commonmark.org/h\u{0}[&unterminated",
    "<p>Visit <a href=\"http://www.commonmark.org/h%EF%BF%BD%5B&amp;unterminated\">www.commonmark.org/h�[&amp;unterminated</a></p>\n",
    std@1/markdown.gfm_options()
  )
  failed += harness.check(
    s,
    "gfm/Autolinks (extension)/623/malformed",
    "Visit www.commonmark.org.\n\nV\u{0}[&unterminated",
    "<p>Visit <a href=\"http://www.commonmark.org\">www.commonmark.org</a>.</p>\n<p>V�[&amp;unterminated</p>\n",
    std@1/markdown.gfm_options()
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
