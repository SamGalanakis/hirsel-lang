// rule: SEM-3
// expect: run
// Generated by tools/generate-toml-test.py from toml-test ff49d109861c
// tests/files-toml-1.1.0, group valid-key.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.valid(
    s,
    "valid/key/alphanum",
    "alpha = \"a\"\n123 = \"num\"\n000111 = \"leading\"\n10e3 = \"false float\"\none1two2 = \"mixed\"\nwith-dash = \"dashed\"\nunder_score = \"___\"\n34-11 = 23\n\n[2018_10]\n001 = 1\n\n[a-a-a]\n_ = false\n",
    "{\"000111\":{\"type\":\"string\",\"value\":\"leading\"},\"10e3\":{\"type\":\"string\",\"value\":\"false float\"},\"123\":{\"type\":\"string\",\"value\":\"num\"},\"34-11\":{\"type\":\"integer\",\"value\":\"23\"},\"alpha\":{\"type\":\"string\",\"value\":\"a\"},\"one1two2\":{\"type\":\"string\",\"value\":\"mixed\"},\"under_score\":{\"type\":\"string\",\"value\":\"___\"},\"with-dash\":{\"type\":\"string\",\"value\":\"dashed\"},\"2018_10\":{\"001\":{\"type\":\"integer\",\"value\":\"1\"}},\"a-a-a\":{\"_\":{\"type\":\"bool\",\"value\":\"false\"}}}"
  )
  failed += harness.valid(
    s,
    "valid/key/case-sensitive",
    "sectioN = \"NN\"\n\n[section]\nname = \"lower\"\nNAME = \"upper\"\nName = \"capitalized\"\n\n[Section]\nname = \"different section!!\"\n\"μ\" = \"greek small letter mu\"\n\"Μ\" = \"greek capital letter MU\"\nM = \"latin letter M\"\n\n",
    "{\"sectioN\":{\"type\":\"string\",\"value\":\"NN\"},\"Section\":{\"M\":{\"type\":\"string\",\"value\":\"latin letter M\"},\"name\":{\"type\":\"string\",\"value\":\"different section!!\"},\"Μ\":{\"type\":\"string\",\"value\":\"greek capital letter MU\"},\"μ\":{\"type\":\"string\",\"value\":\"greek small letter mu\"}},\"section\":{\"NAME\":{\"type\":\"string\",\"value\":\"upper\"},\"Name\":{\"type\":\"string\",\"value\":\"capitalized\"},\"name\":{\"type\":\"string\",\"value\":\"lower\"}}}"
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
