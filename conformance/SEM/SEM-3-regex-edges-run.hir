// rule: SEM-3
// expect: run
fn span(pattern: String, input: String, start: u64, end: u64) -> Result[(), ()] {
  let re = match regex.compile(pattern, 1000) {
    Ok(re) => take re,
    Error(_) => return Error(()),
  }
  failure.check(
    regex.find(re, input, 10000) == Ok(Some(regex.Span(start: start, end: end))),
    TextInvariant()
  )
  failure.check(regex.is_match(re, input, 10000) == Ok(true), TextInvariant())
  Ok(())
}

fn absent(pattern: String, input: String) -> Result[(), ()] {
  let re = match regex.compile(pattern, 1000) {
    Ok(re) => take re,
    Error(_) => return Error(()),
  }
  failure.check(regex.find(re, input, 10000) == Ok(None()), TextInvariant())
  Ok(())
}

fn invalid(pattern: String, offset: u64) {
  failure.check(
    match regex.compile(pattern, 1000) {
      Error(Syntax(at)) => at == offset,
      _ => false,
    },
    TextInvariant()
  )
}

pub fn main() -> Result[(), ()] {
  span("", "", 0, 0)?
  span("", "abc", 0, 0)?
  span("a*", "aaa", 0, 3)?
  span("a*?", "aaa", 0, 0)?
  span("a+?", "aaa", 0, 1)?
  span("a??", "aaa", 0, 0)?
  span("ab|a", "abc", 0, 2)?
  span("a|ab", "abc", 0, 1)?
  span("(a|aa)*", "aaaa", 0, 4)?
  span("(a*)*", "aaa", 0, 3)?
  span("(|a)*", "aaa", 0, 0)?
  span("(a|)*", "aaa", 0, 3)?
  span("a{2,4}", "aaaaa", 0, 4)?
  span("a{2,4}?", "aaaaa", 0, 2)?
  span("a{2,}", "aaaaa", 0, 5)?
  span("a{0}b", "ab", 1, 2)?
  span("a{0}", "abc", 0, 0)?
  span("(?:ab)+", "zabab", 1, 5)?
  span("(ab)?c", "abc", 0, 3)?
  span("(ab)?c", "xc", 1, 2)?
  span("$", "é🦀", 6, 6)?
  span(".", "🦀", 0, 4)?
  span("[α-ω]+", "xαβ🦀", 1, 5)?
  span("[^a]+", "aé🦀", 1, 7)?
  span("\\d+", "é12z", 2, 4)?
  span("\\D+", "12é", 2, 4)?
  span("\\w+", "é_ab12!", 2, 7)?
  span("\\s+", "x\t\r\n z", 1, 5)?
  span("[\\dA-F]+", "xxB09z", 2, 5)?
  span("[\\D]+", "12é", 2, 4)?
  span("\\bword\\b", "a word!", 2, 6)?
  span("\\Boo\\B", "food", 1, 3)?
  span("[a-]+", "--a", 0, 3)?
  span("[]a]+", "]aa", 0, 3)?
  span("\\Aé\\z", "é", 0, 2)?
  absent(".", "\n")?
  absent("^a", "ba")?
  absent("a$", "a\n")?
  absent("\\d", "٣")?
  absent("\\s", "\u{000b}")?
  absent("a{2}", "a")?
  absent("a{2,4}b", "aaaaac")?
  invalid("é(", 3)
  invalid("é[", 3)
  invalid("a**", 2)
  invalid("(?=a)", 2)
  invalid("\\1", 1)
  invalid("[z-a]", 3)
  invalid("a{3,2}", 6)
  invalid("*a", 0)
  invalid(")", 0)
  invalid("[\\d-a]", 4)
  invalid("[[:alpha:]]", 1)
  Ok(())
}
