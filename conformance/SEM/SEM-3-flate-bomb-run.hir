// rule: SEM-3
// expect: run
// Decompression bombs: a 991-byte zlib stream and a 1003-byte gzip member of a
// million zero bytes (zlib 1.3, level 9) stop at the caller's bound before the
// excess is written, and flate.read never appends more than its max per call;
// a stream within the bound decodes.
type Source {
  data: Bytes,
  at: u64,
}

fn feed(mut s: Source, mut buffer: List[u8], requested: u64) -> Result[u64, ()] uses {} {
  let mut n: u64 = 0
  while n < requested && s.at < core@1/bytes.len(s.data) {
    list.push(mut buffer, s.data[s.at])
    s.at += 1
    n += 1
  }
  Ok(n)
}

// The decoded bytes and the input left after the stream.
fn drain(format: flate.Format, take data: Bytes, capacity: u64, max: u64) -> Result[
  (Bytes, Bytes),
  flate.ReadError[()]
] {
  let mut d = flate.decoder(format)
  let mut r = bufio.new(capacity)
  let mut source = Source(data: take data, at: 0)
  let mut out: List[u8] = []
  while flate.read(mut d, mut r, mut source, feed, mut out, max)? > 0 {
    failure.check(core@1/list.len(out) > 0, Bounds())
  }
  let mut rest: List[u8] = []
  for byte in bufio.contents(r) {
    list.push(mut rest, byte)
  }
  while source.at < core@1/bytes.len(source.data) {
    list.push(mut rest, source.data[source.at])
    source.at += 1
  }
  Ok((core@1/bytes.from_list(take out), core@1/bytes.from_list(take rest)))
}

