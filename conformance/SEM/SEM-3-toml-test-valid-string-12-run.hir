fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.valid(
    s,
    "valid/string/start-mb",
    "# Start first line with a multibyte character.\n#\n# https://github.com/marzer/tomlplusplus/issues/190\ns1 = \"§\"\ns2 = '§'\ns3 = \"\"\"\\\n§\"\"\"\ns4 = \"\"\"\n§\"\"\"\ns5 = \"\"\"§\"\"\"\ns6 = '''\n§'''\ns7 = '''§'''\n",
    "{\"s1\":{\"type\":\"string\",\"value\":\"§\"},\"s2\":{\"type\":\"string\",\"value\":\"§\"},\"s3\":{\"type\":\"string\",\"value\":\"§\"},\"s4\":{\"type\":\"string\",\"value\":\"§\"},\"s5\":{\"type\":\"string\",\"value\":\"§\"},\"s6\":{\"type\":\"string\",\"value\":\"§\"},\"s7\":{\"type\":\"string\",\"value\":\"§\"}}"
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
