    s,
    "commonmark/Autolinks/604/malformed",
    "<foo@bar.ex\u{0}[&unterminated",
    "<p>&lt;foo@bar.ex�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Autolinks/605/malformed",
    "<foo+special@Ba\u{0}[&unterminated",
    "<p>&lt;foo+special@Ba�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Autolinks/606/malformed",
    "<foo\\+@bar.e\u{0}[&unterminated",
    "<p>&lt;foo+@bar.e�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Autolinks/607/malformed",
    "<\u{0}[&unterminated",
    "<p>&lt;�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Autolinks/608/malformed",
    "< https://\u{0}[&unterminated",
    "<p>&lt; https://�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Autolinks/609/malformed",
    "<m:a\u{0}[&unterminated",
    "<p>&lt;m:a�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
