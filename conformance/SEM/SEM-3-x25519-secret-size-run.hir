// rule: SEM-3
// expect: run
// steps: 6000000
// one X25519 is a 255-step Montgomery ladder and an inversion, about 2.8M steps
// Zig std/crypto/25519/x25519.zig "public key calculation from secret key": a 32-byte
// secret's public key; the fail twin's 31-byte secret is refused.
fn decode(text: String) -> unique Bytes {
  let Ok(data) = std@1/hex.decode(text) else {
    failure.check(false, TextInvariant())
    return bytes.from_list([])
  }
  data
}

pub fn main() -> Result[(), ()] {
  failure.check(
    std@1/hex.encode(
      std@1/x25519.public_key(
        decode("8052030376d47112be7f73ed7a019293dd12ad910b654455798b4667d73de166")
      )
    ) == "f1814f0e8ff1043d8a44d25babff3cedcae6c22c3edaa48f857ae70de2baae50",
    TextInvariant()
  )
  Ok(())
}
