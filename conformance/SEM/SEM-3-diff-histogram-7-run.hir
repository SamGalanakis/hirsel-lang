// rule: SEM-3
// expect: run
// Inputs: the SEM-3-diff-pairs cases (Go src/internal/diff/testdata, golang/go
// ebe2feef, and fixed pairs). Expected unified diffs are imara-diff's
// (pascalkuthe/imara-diff f02e46a7) Algorithm::Histogram with
// postprocess_no_heuristic, printed as git diff -U3 prints hunks.
fn pairs() -> List[(String, String, String, String)] uses {} {
  [
    (
      "random-0",
      "f2\nb0\nh2\ne1\na1\nc0\ne1\ne2\nf0\nb1\ne0\nh0\nc1\nf0\nf1\nc2\nb1\na2\ng0\nf1\nh2\ne2\ne1\ne2\nb2\nc1\nh0\nd2\nd1\na1\ne2\nd0\nd1\ne0\nf0\ng2\nc2\ne2\nb2\ne0\n",
      "f2\nb0\ny2\nh2\nx1\na1\nc0\ne1\ne2\nf0\nb1\ne0\nh0\nc2\nc1\nf0\nf1\nc2\nb1\nx0\na2\ng0\nc0\nh2\ne2\ne1\ne2\nb2\nh0\nd2\nd1\na1\ne2\nd0\nz1\nd1\ne0\nf0\nb1\nc2\ne2\nb2\ne0\n",
      "--- old\n+++ new\n@@ -1,7 +1,8 @@\n f2\n b0\n+y2\n h2\n-e1\n+x1\n a1\n c0\n e1\n@@ -10,30 +11,32 @@\n b1\n e0\n h0\n+c2\n c1\n f0\n f1\n c2\n b1\n+x0\n a2\n g0\n-f1\n+c0\n h2\n e2\n e1\n e2\n b2\n-c1\n h0\n d2\n d1\n a1\n e2\n d0\n+z1\n d1\n e0\n f0\n-g2\n+b1\n c2\n e2\n b2\n"
    )
  ]
}

// Rebuilds `new` from `old` and an edit script, checking each run's positions.
fn replay(old: List[String], new: List[String], script: List[diff.Edit]) -> bool uses {} {
  let mut out: List[String] = []
  let mut i: u64 = 0
  let mut j: u64 = 0
  for e in script {
    match e {
      Keep(a, b, n) => {
        if a != i || b != j || n == 0 {
          return false
        }
        for k in 0u64..n {
          if old[a + k] != new[b + k] {
            return false
          }
          list.push(mut out, unique old[a + k])
        }
        i += n
        j += n
      },
      Delete(a, b, n) => {
        if a != i || b != j || n == 0 {
          return false
        }
        i += n
      },
      Insert(a, b, n) => {
        if a != i || b != j || n == 0 {
          return false
        }
        for k in 0u64..n {
          list.push(mut out, unique new[b + k])
        }
        j += n
      },
    }
  }
  i == list.len(old) && out == new
}

pub fn main(t: Test) -> Result[(), diff.PatchError] {
  let mut case: u64 = 21
  for (_, old, new, histogram) in pairs() {
    test.check_case(
      t,
      diff.unified("old", old, "new", new, Histogram(), 3) == histogram,
      case
    )
    let applied = diff.apply(old, histogram)?
    test.check_case(t, applied.text == new && list.len(applied.rejected) == 0, case)
    let a = diff.split_lines(old)
    let b = diff.split_lines(new)
    test.check_case(t, replay(a, b, diff.edits(a, b, Histogram())), case)
    case += 1
  }
  Ok(())
}
