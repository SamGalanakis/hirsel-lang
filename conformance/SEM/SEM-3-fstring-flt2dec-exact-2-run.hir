  // mod.rs:365: 15334037p-146f32; digits=6, decimal exponent=-36.
  exact(t, 15334037u64, -146i32, "171900", -42i32)
  // mod.rs:366: 11518287p-41f32; digits=7, decimal exponent=-5.
