// rule: SEM-3
// expect: run
// Rust coretests/tests/num/flt2dec/mod.rs, f6c1107f8be13e48465e12c0fd26e6a39fe18e4f.
// MIT; third-party/NOTICES.md. Original check_exact/check_exact_one row lines below.
// The rounded value in units of 10^cutoff, digit by digit against `expected`.
fn same_digits(d: std@1/internal.decimal_seq.DecimalSeq, expected: String, cutoff: i32) -> bool {
  let point: i64 = core@1/int.widen(d.decimal_point)
  let limit: i64 = core@1/int.widen(cutoff)
  let text = core@1/string.as_bytes(expected)
  let length = core@1/bytes.len(text)
  if point - limit <= 0 {
    return length == 1 && text[0] == 48
  }
  let count: u64 = core@1/int.narrow(point - limit)
  if count != length {
    return false
  }
  let mut i: u64 = 0
  while i < count {
    let digit: u8 = if i < d.num_digits {
      d.digits[i]
    } else {
      0
    }
    if text[i] != digit + 48 {
      return false
    }
    i += 1
  }
  true
}

fn exact(t: Test, mantissa: u64, exponent: i32, expected: String, cutoff: i32) -> () {
  let limit: i64 = core@1/int.widen(cutoff)
  let mut d = std@1/internal.decimal_seq.exact(mantissa, exponent, -limit)
  let point: i64 = core@1/int.widen(d.decimal_point)
  std@1/internal.format.round_decimal(mut d, point - limit)
  test.check(t, same_digits(d, expected, cutoff))
}

pub fn main(t: Test) -> Result[(), ()] {
  // mod.rs:356: f32::MIN_POSITIVE; digits=38, decimal exponent=-37.
  exact(t, 1u64, -126i32, "11754943508222875079687365372222456778", -75i32)
