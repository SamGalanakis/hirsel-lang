  // mod.rs:361: 12676506p-103f32; digits=2, decimal exponent=-23.
  exact(t, 12676506u64, -103i32, "12", -25i32)
  // mod.rs:362: 15445013p86f32; digits=3, decimal exponent=34.
  exact(t, 15445013u64, 86i32, "119", 31i32)
