// rule: SEM-1
// expect: run
pub fn main(t: Test) -> Result[(), ()] {
  core@1/test.check(t, i64.to_string(-9223372036854775808i64) == "-9223372036854775808")
  core@1/test.check(t, i64.parse("-9223372036854775808") == Ok(-9223372036854775808i64))
  let mut buffer1: Inline[u8, 20] = [
    99u8,
