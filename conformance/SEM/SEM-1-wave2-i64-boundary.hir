  core@1/test.check(t, i64.to_string(9223372036854775807i64) == "9223372036854775807")
  core@1/test.check(t, i64.parse("9223372036854775807") == Ok(9223372036854775807i64))
  let mut buffer2: Inline[u8, 19] = [
    99u8,
    99u8,
    99u8,
    99u8,
    99u8,
    99u8,
    99u8,
    99u8,
