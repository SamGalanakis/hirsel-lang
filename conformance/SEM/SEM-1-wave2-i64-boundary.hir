  core@1/test.check(t, i64.to_string(0i64) == "0")
  core@1/test.check(t, i64.parse("0") == Ok(0i64))
  let mut buffer3: Inline[u8, 1] = [99u8]
  core@1/test.check(t, i64.format(0i64, mut buffer3) == Ok(1u64))
  core@1/test.check(t, buffer3 == [48u8])
