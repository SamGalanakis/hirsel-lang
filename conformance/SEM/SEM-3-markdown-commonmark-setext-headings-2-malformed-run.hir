// rule: SEM-3
// expect: run
// Published spec.txt vectors; tools/generate-markdown.py.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.check(
    s,
    "commonmark/Setext headings/84/malformed",
    "   Foo\n---\n\n  Foo\n\u{0}[&unterminated",
    "<h2>Foo</h2>\n<p>Foo\n�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Setext headings/85/malformed",
    "    Foo\n    --\u{0}[&unterminated",
    "<pre><code>Foo\n--�[&amp;unterminated\n</code></pre>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Setext headings/86/malformed",
    "Foo\n   --\u{0}[&unterminated",
    "<p>Foo\n--�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Setext headings/87/malformed",
    "Foo\n  \u{0}[&unterminated",
    "<p>Foo\n�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Setext headings/88/malformed",
    "Foo\n= =\n\n\u{0}[&unterminated",
    "<p>Foo\n= =</p>\n<p>�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
