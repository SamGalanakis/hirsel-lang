// rule: SEM-3
// expect: run
// std@1/yaml.set with Index(len) appends a block sequence item at the sequence's
// indentation.
fn edits(r: Result[(), yaml.YamlError], doc: yaml.Document, expected: String) -> bool {
  r == Ok(()) && yaml.source(doc) == expected
}

pub fn main(rt: Io) -> Result[(), ()] {
  let Ok(doc) = yaml.document(
    "# CI\nname: CI  # the name\non:\n  push:\n    branches: [main]\njobs:\n  test:\n    steps:\n      - uses: checkout\n      # run the tests\n      - run: make\n"
  ) else {
    failure.check(false, TextInvariant())
    return Ok(())
  }
  let mut c = copy doc
  failure.check(
    edits(
      yaml.set(
        mut c,
        [Key("jobs"), Key("test"), Key("steps"), Index(2)],
        Text("make test")
      ),
      c,
      "# CI\nname: CI  # the name\non:\n  push:\n    branches: [main]\njobs:\n  test:\n    steps:\n      - uses: checkout\n      # run the tests\n      - run: make\n      - make test\n"
    ),
    TextInvariant()
  )
  Ok(())
}
