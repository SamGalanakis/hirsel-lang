// rule: SEM-3
// expect: run
// Published spec.txt vectors; tools/generate-markdown.py.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.check(
    s,
    "commonmark/HTML blocks/183",
    "  <!-- foo -->\n\n    <!-- foo -->\n",
    "  <!-- foo -->\n<pre><code>&lt;!-- foo --&gt;\n</code></pre>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/HTML blocks/184",
    "  <div>\n\n    <div>\n",
    "  <div>\n<pre><code>&lt;div&gt;\n</code></pre>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/HTML blocks/185",
    "Foo\n<div>\nbar\n</div>\n",
    "<p>Foo</p>\n<div>\nbar\n</div>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/HTML blocks/186",
    "<div>\nbar\n</div>\n*foo*\n",
    "<div>\nbar\n</div>\n*foo*\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/HTML blocks/187",
    "Foo\n<a href=\"bar\">\nbaz\n",
    "<p>Foo\n<a href=\"bar\">\nbaz</p>\n",
    std@1/markdown.default_options()
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
