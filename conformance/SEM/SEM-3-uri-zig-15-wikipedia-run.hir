// rule: SEM-3
// expect: run
// Zig Uri.zig:740-754, Examples from wikipedia (bff490a2, MIT).
pub fn main() -> Result[(), ()] {
  match std@1/uri.parse(
    "https://john.doe@www.example.com:123/forum/questions/?tag=networking&order=newest#top"
  ) {
    Ok(_) => (),
    Error(_) => {
      return Error(())
    },
  }
  match std@1/uri.parse("ldap://[2001:db8::7]/c=GB?objectClass?one") {
    Ok(_) => (),
    Error(_) => {
      return Error(())
    },
  }
  match std@1/uri.parse("mailto:John.Doe@example.com") {
    Ok(_) => (),
    Error(_) => {
      return Error(())
    },
  }
  match std@1/uri.parse("news:comp.infosystems.www.servers.unix") {
    Ok(_) => (),
    Error(_) => {
      return Error(())
    },
  }
  match std@1/uri.parse("tel:+1-816-555-1212") {
    Ok(_) => (),
    Error(_) => {
      return Error(())
    },
  }
  match std@1/uri.parse("telnet://192.0.2.16:80/") {
    Ok(_) => (),
    Error(_) => {
      return Error(())
    },
  }
  match std@1/uri.parse("urn:oasis:names:specification:docbook:dtd:xml:4.1.2") {
    Ok(_) => (),
    Error(_) => {
      return Error(())
    },
  }
  match std@1/uri.parse("http://a/b/c/d;p?q") {
    Ok(_) => (),
    Error(_) => {
      return Error(())
    },
  }
  Ok(())
}
