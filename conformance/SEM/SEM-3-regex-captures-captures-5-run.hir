// rule: SEM-3
// expect: run
// Go ebe2feef capture/flag/replacement vectors (BSD-3-Clause).
// RE2 data Copyright 2009 The RE2 Authors (BSD-3-Clause).
fn check(pattern: String, input: String, maximum: u64, expected: List[regex.Captures]) -> Result[
  (),
  ()
] {
  let Ok(re) = regex.compile(pattern, 10000) else {
    return Error(())
  }
  failure.check(
    regex.find_all_captures(re, input, maximum, 1000000) == Ok(expected),
    TextInvariant()
  )
  if maximum != 0 {
    let first: Option[regex.Captures] = if list.len(expected) == 0 {
      None()
    } else {
      Some(copy expected[0])
    }
    failure.check(regex.find_captures(re, input, 1000000) == Ok(first), TextInvariant())
  }
  Ok(())
}

pub fn main() -> Result[(), ()] {
  // Go find_test.go:62
  check(
    "(.)(.)",
    "日a",
    18446744073709551615,
    [
      regex.Captures(
        spans: [
          Some(regex.Span(start: 0, end: 4)),
          Some(regex.Span(start: 0, end: 3)),
          Some(regex.Span(start: 3, end: 4))
        ]
      )
    ]
  )?
  // Go find_test.go:63
  check(
    "(.*)",
    "",
    18446744073709551615,
    [
      regex.Captures(
        spans: [Some(regex.Span(start: 0, end: 0)), Some(regex.Span(start: 0, end: 0))]
      )
    ]
  )?
  // Go find_test.go:64
  check(
    "(.*)",
    "abcd",
    18446744073709551615,
    [
      regex.Captures(
        spans: [Some(regex.Span(start: 0, end: 4)), Some(regex.Span(start: 0, end: 4))]
      )
    ]
  )?
  // Go find_test.go:65
  check(
    "(..)(..)",
    "abcd",
    18446744073709551615,
    [
      regex.Captures(
        spans: [
          Some(regex.Span(start: 0, end: 4)),
          Some(regex.Span(start: 0, end: 2)),
          Some(regex.Span(start: 2, end: 4))
        ]
      )
    ]
  )?
  // Go find_test.go:66
  check(
    "(([^xyz]*)(d))",
    "abcd",
    18446744073709551615,
    [
      regex.Captures(
        spans: [
          Some(regex.Span(start: 0, end: 4)),
          Some(regex.Span(start: 0, end: 4)),
          Some(regex.Span(start: 0, end: 3)),
          Some(regex.Span(start: 3, end: 4))
        ]
      )
    ]
  )?
  // Go find_test.go:67
  check(
    "((a|b|c)*(d))",
    "abcd",
    18446744073709551615,
    [
      regex.Captures(
        spans: [
          Some(regex.Span(start: 0, end: 4)),
          Some(regex.Span(start: 0, end: 4)),
          Some(regex.Span(start: 2, end: 3)),
          Some(regex.Span(start: 3, end: 4))
        ]
      )
    ]
  )?
  // Go find_test.go:68
  check(
    "(((a|b|c)*)(d))",
    "abcd",
    18446744073709551615,
    [
      regex.Captures(
        spans: [
          Some(regex.Span(start: 0, end: 4)),
          Some(regex.Span(start: 0, end: 4)),
          Some(regex.Span(start: 0, end: 3)),
          Some(regex.Span(start: 2, end: 3)),
          Some(regex.Span(start: 3, end: 4))
        ]
      )
    ]
  )?
  // Go find_test.go:69
  check(
    "\\a\\f\\n\\r\\t\\v",
    "\u{7}\u{c}\n\r\t\u{b}",
    18446744073709551615,
    [regex.Captures(spans: [Some(regex.Span(start: 0, end: 6))])]
  )?
  Ok(())
}
