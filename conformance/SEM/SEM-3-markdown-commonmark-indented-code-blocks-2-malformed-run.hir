// rule: SEM-3
// expect: run
// Published spec.txt vectors; tools/generate-markdown.py.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.check(
    s,
    "commonmark/Indented code blocks/111/malformed",
    "    chunk1\n\n    chun\u{0}[&unterminated",
    "<pre><code>chunk1\n\nchun�[&amp;unterminated\n</code></pre>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Indented code blocks/112/malformed",
    "    chunk1\n    \u{0}[&unterminated",
    "<pre><code>chunk1\n�[&amp;unterminated\n</code></pre>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Indented code blocks/113/malformed",
    "Foo\n  \u{0}[&unterminated",
    "<p>Foo\n�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Indented code blocks/114/malformed",
    "    fo\u{0}[&unterminated",
    "<pre><code>fo�[&amp;unterminated\n</code></pre>\n",
    std@1/markdown.default_options()
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
