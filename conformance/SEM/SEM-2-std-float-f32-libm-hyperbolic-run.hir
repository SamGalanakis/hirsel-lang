// rule: SEM-2
// expect: run
// sinh, cosh, tanh, asinh, acosh and atanh for f32: exact bits on IEEE specials,
// each branch threshold of the port and its neighbours, the crate's own test
// inputs and seeded samples. Expected bits are the outputs of the Rust libm
// crate (rust-lang/compiler-builtins f6c1107f, MIT); NaN is the one NaN.
pub fn main(t: Test) -> Result[(), ()] {
