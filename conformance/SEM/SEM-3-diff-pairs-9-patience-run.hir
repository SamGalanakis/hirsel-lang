// rule: SEM-3
// expect: run
// Inputs: Go src/internal/diff/testdata (golang/go ebe2feef) and fixed pairs.
// Expected unified diffs are git 2.43.0's `git diff --no-index
// --no-indent-heuristic -U<n> --diff-algorithm=<myers|patience>` output, with
// names replaced and the function context after `@@` dropped; expected patch
// results are GNU patch 2.7.6's `patch --fuzz=0 --forward` output and rejected
// hunk numbers.
fn pairs() -> List[(String, String, String, String, String)] uses {} {
  [
    (
      "random-2",
      "f0\nb2\nf0\nf1\nf2\ng2\nc0\ng1\ne0\nd2\na0\nf1\nh1\ne0\nd2\ne2\ng0\nd2\nd2\nh0\ng1\na2\ne0\nb1\nh2\ng2\na0\nf1\nf1\nb0\nd1\ne1\nc1\nb2\na2\ne2\na2\nc0\ng1\ng2\n",
      "f0\nb2\na0\nf1\nf2\ng2\nc0\ng1\ne0\nd2\na0\nh1\ne0\nb2\ng0\nd2\nd2\nh0\nc2\ng1\ny1\nz1\ne0\nb1\nh2\ng2\na0\nf1\nb0\nd1\ne1\nc1\nb2\na2\nb2\nc0\ng1\ng2\n",
      "--- old\n+++ new\n@@ -1,6 +1,6 @@\n f0\n b2\n-f0\n+a0\n f1\n f2\n g2\n@@ -9,32 +9,30 @@\n e0\n d2\n a0\n-f1\n h1\n e0\n-d2\n-e2\n+b2\n g0\n d2\n d2\n h0\n+c2\n g1\n-a2\n+y1\n+z1\n e0\n b1\n h2\n g2\n a0\n f1\n-f1\n b0\n d1\n e1\n c1\n b2\n a2\n-e2\n-a2\n+b2\n c0\n g1\n g2\n",
      "--- old\n+++ new\n@@ -1,6 +1,6 @@\n f0\n b2\n-f0\n+a0\n f1\n f2\n g2\n@@ -9,32 +9,30 @@\n e0\n d2\n a0\n-f1\n h1\n e0\n-d2\n-e2\n+b2\n g0\n d2\n d2\n h0\n+c2\n g1\n-a2\n+y1\n+z1\n e0\n b1\n h2\n g2\n a0\n f1\n-f1\n b0\n d1\n e1\n c1\n b2\n a2\n-e2\n-a2\n+b2\n c0\n g1\n g2\n"
    )
  ]
}

// Rebuilds `new` from `old` and an edit script, checking each run's positions.
fn replay(old: List[String], new: List[String], script: List[diff.Edit]) -> bool uses {} {
  let mut out: List[String] = []
  let mut i: u64 = 0
  let mut j: u64 = 0
  for e in script {
    match e {
      Keep(a, b, n) => {
        if a != i || b != j || n == 0 {
          return false
        }
        for k in 0u64..n {
          if old[a + k] != new[b + k] {
            return false
          }
          list.push(mut out, unique old[a + k])
        }
        i += n
        j += n
      },
      Delete(a, b, n) => {
        if a != i || b != j || n == 0 {
          return false
        }
        i += n
      },
      Insert(a, b, n) => {
        if a != i || b != j || n == 0 {
          return false
        }
        for k in 0u64..n {
          list.push(mut out, unique new[b + k])
        }
        j += n
      },
    }
  }
  i == list.len(old) && out == new
}

pub fn main(t: Test) -> Result[(), diff.PatchError] {
  let mut case: u64 = 23
  for (_, old, new, _, patience) in pairs() {
    test.check_case(
      t,
      diff.unified("old", old, "new", new, Patience(), 3) == patience,
      case
    )
    let applied = diff.apply(old, patience)?
    test.check_case(t, applied.text == new && list.len(applied.rejected) == 0, case)
    let a = diff.split_lines(old)
    let b = diff.split_lines(new)
    test.check_case(t, replay(a, b, diff.edits(a, b, Patience())), case)
    case += 1
  }
  Ok(())
}
