// rule: SEM-3
// expect: run
// Generated by tools/generate-json-vectors.py; see docs/json-domain-vectors.md.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.parses(s, "n_number_0e+.json:1", "[0e+]", 1)
  failed += harness.parses(s, "n_number_0e.json:1", "[0e]", 1)
  failed += harness.parses(s, "n_number_1.0e+.json:1", "[1.0e+]", 1)
  failed += harness.parses(s, "n_number_1.0e-.json:1", "[1.0e-]", 1)
  failed += harness.parses(s, "n_number_1.0e.json:1", "[1.0e]", 1)
  failed += harness.parses(s, "n_number_1_000.json:1", "[1 000.0]", 1)
  failed += harness.parses(s, "n_number_1eE2.json:1", "[1eE2]", 1)
  failed += harness.parses(s, "n_number_2.e+3.json:1", "[2.e+3]", 1)
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
