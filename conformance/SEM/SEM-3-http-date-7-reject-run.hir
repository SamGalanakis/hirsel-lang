// rule: SEM-3
// expect: run
fn bad(value: String, offset: u64, kind: http_date.ParseErrorKind) -> () {
  failure.check(
    http_date.parse(value) == Error(http_date.ParseError(offset: offset, kind: kind)),
    TextInvariant()
  )
}

pub fn main() -> Result[(), ()] {
  bad("", 0, Length())
  bad("Sun, 06 Nov 1994 08:49:37 GM", 28, Length())
  bad("Sun, 06 Nov 1994 08:49:37 GMT ", 29, Length())
  bad("Sun, 06 Nov 1994 08:49:37 GMTx", 29, Length())
  bad("Sunday, 06-Nov-94 08:49:37 GMT", 29, Length())
  bad("Sun Nov  6 08:49:37 1994", 24, Length())
  bad("Sun, 06 Nov 10000 08:49:37 GMT", 29, Length())
  bad("Sun, 06 Nov 1994 08:49:37.0 GMT", 29, Length())
  bad("Sunx 06 Nov 1994 08:49:37 GMT", 3, Separator())
  bad("Sun,x06 Nov 1994 08:49:37 GMT", 4, Separator())
  bad("Sun, 06xNov 1994 08:49:37 GMT", 7, Separator())
  bad("Sun, 06 Novx1994 08:49:37 GMT", 11, Separator())
  bad("Sun, 06 Nov 1994x08:49:37 GMT", 16, Separator())
  bad("Sun, 06 Nov 1994 08x49:37 GMT", 19, Separator())
  bad("Sun, 06 Nov 1994 08:49x37 GMT", 22, Separator())
  bad("Sun, 06 Nov 1994 08:49:37xGMT", 25, Separator())
  bad("Sun, 06 Nov 1994 08:49:37 xMT", 26, Separator())
  bad("Sun, 06 Nov 1994 08:49:37 GxT", 27, Separator())
  bad("Sun, 06 Nov 1994 08:49:37 GMx", 28, Separator())
  bad("Sun, x6 Nov 1994 08:49:37 GMT", 5, Digit())
  bad("Sun, 0x Nov 1994 08:49:37 GMT", 6, Digit())
  bad("Sun, 06 Nov x994 08:49:37 GMT", 12, Digit())
  bad("Sun, 06 Nov 1x94 08:49:37 GMT", 13, Digit())
  bad("Sun, 06 Nov 19x4 08:49:37 GMT", 14, Digit())
  bad("Sun, 06 Nov 199x 08:49:37 GMT", 15, Digit())
  bad("Sun, 06 Nov 1994 x8:49:37 GMT", 17, Digit())
  bad("Sun, 06 Nov 1994 0x:49:37 GMT", 18, Digit())
  bad("Sun, 06 Nov 1994 08:x9:37 GMT", 20, Digit())
  bad("Sun, 06 Nov 1994 08:4x:37 GMT", 21, Digit())
  bad("Sun, 06 Nov 1994 08:49:x7 GMT", 23, Digit())
  bad("Sun, 06 Nov 1994 08:49:3x GMT", 24, Digit())
  bad("sun, 06 Nov 1994 08:49:37 GMT", 0, Weekday())
  bad("SUN, 06 Nov 1994 08:49:37 GMT", 0, Weekday())
  bad("Foo, 06 Nov 1994 08:49:37 GMT", 0, Weekday())
  bad("Mon, 06 Nov 1994 08:49:37 GMT", 0, Weekday())
  bad("Sun, 06 nov 1994 08:49:37 GMT", 8, Month())
  bad("Sun, 06 NOV 1994 08:49:37 GMT", 8, Month())
  bad("Sun, 06 Foo 1994 08:49:37 GMT", 8, Month())
  bad("Sun, 00 Nov 1994 08:49:37 GMT", 5, Day())
  bad("Sun, 32 Nov 1994 08:49:37 GMT", 5, Day())
  bad("Sun, 31 Nov 1994 08:49:37 GMT", 5, Day())
  bad("Sun, 06 Nov 1969 08:49:37 GMT", 12, Year())
  bad("Sun, 06 Nov 0000 08:49:37 GMT", 12, Year())
  bad("Sun, 06 Nov 1994 24:49:37 GMT", 17, Hour())
  bad("Sun, 06 Nov 1994 08:60:37 GMT", 20, Minute())
  bad("Sun, 06 Nov 1994 08:49:60 GMT", 23, Second())
  bad("Sun, 06 Nov 1994 08:49:99 GMT", 23, Second())
  bad("Tue, 29 Feb 2100 00:00:00 GMT", 5, Day())
  bad("Mon, 29 Feb 1999 00:00:00 GMT", 5, Day())
  bad("Sun, 31 Apr 2024 00:00:00 GMT", 5, Day())
  bad("Sun, é Nov 1994 08:49:37 GMT", 5, NonAscii())
  bad("Sun, 06 Nov 1994 08:49:37 UTC", 26, Separator())
  Ok(())
}
