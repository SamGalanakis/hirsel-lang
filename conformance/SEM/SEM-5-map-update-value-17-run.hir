// rule: SEM-5
// expect: run
// IndexMap get_mut lookup-then-value projection; ordinary path COW.
fn shared_key() -> Result[(), String] {
  let key = f"word"
  let mut counts: Map[String, u32] = map.empty()
  map.insert(mut counts, copy key, 1)
  std@1/map.update_value(
    mut counts,
    key,
    fn(mut n: u32) -> () uses {} {
      n += 1
    }
  )
  failure.check(key == "word" && map.get(counts, key) == Some(2u32), Bounds())
  Ok(())
}

fn shared_outer() -> Result[(), String] {
  let mut m: Map[u64, u64] = map.empty()
  map.insert(mut m, 1, 10)
  let saved = copy m
  let _ = std@1/map.update_value(
    mut m,
    1,
    fn(mut v: u64) -> () uses {} {
      v += 1
    }
  )
  failure.check(
    map.get(saved, 1) == Some(10u64) && map.get(m, 1) == Some(11u64),
    Bounds()
  )
  Ok(())
}

fn aliased_value() -> Result[(), String] {
  let value: List[u64] = [10]
  let mut m: Map[u64, List[u64]] = map.empty()
  map.insert(mut m, 1, copy value)
  map.insert(mut m, 2, copy value)
  let _ = std@1/map.update_value(
    mut m,
    1,
    fn(mut v: List[u64]) -> () uses {} {
      list.push(mut v, 20)
    }
  )
  failure.check(
    list.len(value) == 1 && map.get(m, 2) == Some([10u64]) && map.get(m, 1) == Some(
      [10u64, 20u64]
    ),
    Bounds()
  )
  Ok(())
}

fn equal_key_value_backing() -> Result[(), String] {
  let key: List[u64] = [1]
  let mut m: Map[List[u64], List[u64]] = map.empty()
  map.insert(mut m, copy key, copy key)
  let _ = std@1/map.update_value(
    mut m,
    key,
    fn(mut v: List[u64]) -> () uses {} {
      v[0] = 9
    }
  )
  failure.check(key == [1u64], Bounds())
  failure.check(map.get(m, key) == Some([9u64]), Bounds())
  failure.check(!map.contains(m, [9u64]), Bounds())
  Ok(())
}

// Adapted from indexmap 41a870887c4c77adf665886e63df08f406bfe37a
// src/map/tests.rs:1055-1094; MIT/Apache-2.0 notices retained in lane root.
fn four_values() -> Result[(), String] {
  let mut m: Map[u64, u64] = map.empty()
  map.insert(mut m, 1, 100)
  map.insert(mut m, 2, 200)
  map.insert(mut m, 3, 300)
  map.insert(mut m, 4, 400)
  failure.check(
    !std@1/map.update_value(
      mut m,
      0,
      fn(mut v: u64) -> () uses {} {
        failure.check(false, Bounds())
      }
    ),
    Bounds()
  )
  failure.check(
    map.get(m, 1) == Some(100u64) && map.get(m, 2) == Some(200u64),
    Bounds()
  )
  failure.check(
    map.get(m, 3) == Some(300u64) && map.get(m, 4) == Some(400u64),
    Bounds()
  )
  let _ = std@1/map.update_value(
    mut m,
    3,
    fn(mut v: u64) -> () uses {} {
      v += 3
    }
  )
  let _ = std@1/map.update_value(
    mut m,
    1,
    fn(mut v: u64) -> () uses {} {
      v += 1
    }
  )
  let _ = std@1/map.update_value(
    mut m,
    4,
    fn(mut v: u64) -> () uses {} {
      v += 4
    }
  )
  let _ = std@1/map.update_value(
    mut m,
    2,
    fn(mut v: u64) -> () uses {} {
      v += 2
    }
  )
  failure.check(
    map.get(m, 1) == Some(101u64) && map.get(m, 2) == Some(202u64),
    Bounds()
  )
  failure.check(
    map.get(m, 3) == Some(303u64) && map.get(m, 4) == Some(404u64),
    Bounds()
  )
  let mut i: u64 = 1
  for (k, v) in m {
    failure.check(k == i, Bounds())
    i += 1
  }
  failure.check(i == 5, Bounds())
  Ok(())
}

fn indexed_tombstones() {
  let mut m: unique Map[u64, u64] = map.empty()
  for i in 0u64..16u64 {
    map.insert(mut m, i, i * 10)
  }
  let _ = map.remove(mut m, 1)
  let _ = map.remove(mut m, 5)
  let mut ordinary: Map[u64, u64] = take m
  let saved = copy ordinary
  failure.check(
    !std@1/map.update_value(
      mut ordinary,
      99,
      fn(mut v: u64) -> () uses {} {
        failure.check(false, Bounds())
      }
    ),
    Bounds()
  )
  failure.check(
    std@1/map.update_value(
      mut ordinary,
      9,
      fn(mut v: u64) -> () uses {} {
        v += 1
      }
    ),
    Bounds()
  )
  failure.check(
    map.len(ordinary) == 14 && map.len(saved) == 14 && map.get(saved, 9) == Some(90u64),
    Bounds()
  )
  let mut ordinal: u64 = 0
  for (k, v) in ordinary {
    if ordinal == 1 || ordinal == 5 {
      ordinal += 1
    }
    failure.check(
      k == ordinal && v == k * 10 + if k == 9 {
        1
      } else {
        0
      },
      Bounds()
    )
    ordinal += 1
  }
  failure.check(ordinal == 16, Bounds())
}

type Pair {
  first: List[u64],
  second: List[u64],
}

fn nested_path() {
  let child: List[u64] = [10]
  let sibling: List[u64] = [40]
  let mut m: Map[u64, Pair] = map.empty()
  map.insert(mut m, 1, Pair(first: copy child, second: copy sibling))
  let saved = copy m
  let _ = std@1/map.update_value(
    mut m,
    1,
    fn(mut v: Pair) -> () uses {} {
      v.first[0] = 20
    }
  )
  failure.check(child == [10u64] && sibling == [40u64], Bounds())
  failure.check(
    map.get(saved, 1) == Some(Pair(first: [10u64], second: [40u64])) && map.get(m, 1) == Some(
      Pair(first: [20u64], second: [40u64])
    ),
    Bounds()
  )
}

pub fn main() -> Result[(), String] {
  shared_key()?
  shared_outer()?
  aliased_value()?
  equal_key_value_backing()?
  four_values()?
  indexed_tombstones()
  nested_path()
  Ok(())
}
