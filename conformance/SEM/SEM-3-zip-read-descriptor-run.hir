// rule: SEM-3
// expect: run
// Go src/archive/zip/reader_test.go TestReader (golang/go ebe2feef): data
// descriptors with and without their signature, and CRC-32s in the headers, which must match the data.
fn method_text(m: zip.Method) -> String {
  match m {
    Stored() => "stored",
    Deflate() => "deflate",
    Other(_) => "other",
  }
}

// The entry's fields, separated by `|`.
fn summary(e: zip.Entry) -> String {
  let mut out: List[u8] = []
  text.append(mut out, e.name)
  list.push(mut out, b'|')
  text.append(mut out, method_text(e.method))
  let numbers: List[u64] = [
    e.flags,
    e.size,
    e.compressed,
    core@1/int.widen(e.crc),
    e.offset,
    e.dos_time,
    e.external
  ]
  for n in numbers {
    list.push(mut out, b'|')
    u64.format_into(n, mut out)
  }
  list.push(mut out, b'|')
  match e.modified {
    Some(seconds) => i64.format_into(seconds, mut out),
    None() => text.append(mut out, "-"),
  }
  list.push(mut out, b'|')
  text.append(mut out, e.comment)
  text.finish_valid(take out)
}

// Every entry's summary and data.
fn listing(data: Bytes) -> Result[List[(String, Bytes)], zip.ZipError] {
  let mut out: List[(String, Bytes)] = []
  for e in zip.entries(data)? {
    let contents = zip.read(data, e, 1048576)?
    list.push(mut out, (summary(e), contents))
  }
  Ok(out)
}

pub fn main(t: Test) -> Result[(), ()] {
  // dd.zip
  test.check(
    t,
    listing(
      b"PK\x03\x04\x14\x00\x08\x00\x08\x00\xcahB>\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x08\x00\x00\x00filename\x0b\xc9\xc8,V\x00\xa2D\x85\x92\xd4\xe2\x12 QQ\x92\x96\x99\x93\xaa\xc7\x05\x00PK\x07\x08\xd3\xd6\xe3\xa2\x18\x00\x00\x00\x19\x00\x00\x00PK\x01\x02\x14\x00\x14\x00\x08\x00\x08\x00\xcahB>\xd3\xd6\xe3\xa2\x18\x00\x00\x00\x19\x00\x00\x00\x08\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00filenamePK\x05\x06\x00\x00\x00\x00\x01\x00\x01\x006\x00\x00\x00N\x00\x00\x00\x00\x00"
    ) == Ok(
      [
        (
          "filename|deflate|8|25|24|2732840659|0|1044539594|0|-|",
          b"This is a test textfile.\x0a"
        )
      ]
    )
  )
  // go-with-datadesc-sig.zip
  test.check(
