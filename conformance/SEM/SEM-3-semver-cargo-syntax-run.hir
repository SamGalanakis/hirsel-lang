// rule: SEM-3
// expect: run
// dtolnay/semver tests/test_version.rs and tests/test_version_req.rs
// (280ebcb6; offsets are this module's, and precedence ignores build metadata
// where semver's Ord does not), and npm/node-semver test/fixtures
// range-include.js, range-exclude.js, range-parse.js and comparisons.js rows
// without the loose and includePrerelease options (6e05b763; a leading v is
// dropped from versions, and ranges past 2^53 are omitted since numbers here
// are u64). Expected npm spellings are node-semver's, in this module's syntax.
fn shown(r: Result[semver.Req, semver.SemverError]) -> String uses {} {
  match r {
    Ok(req) => semver.req_to_string(req),
    Error(_) => "error",
  }
}

fn cargo_errors() -> List[(String, semver.SemverError)] uses {} {
  [
    ("> 0.1.0,", Syntax(8)),
    ("> 0.3.0, ,", Syntax(9)),
    ("1.2.3 - 2.3.4", Syntax(6)),
    ("> 0.0.9 <= 2.5.3", Syntax(8)),
    ("", Syntax(0)),
    ("=1.2.3 || =2.3.4", Syntax(7)),
    ("1.1 || =1.2.3", Syntax(4)),
    ("6.* || 8.* || >= 10.*", Syntax(4)),
    ("\u{0}", Syntax(0)),
    (">= >= 0.0.2", Syntax(3)),
    (">== 0.0.2", Syntax(2)),
    ("a.0.0", Syntax(0)),
    ("1.0.0-", Syntax(6)),
    (">=", Syntax(2)),
    ("*.1", Syntax(0)),
    ("1.*.1", Syntax(4)),
    (">=1.*.1", Syntax(6)),
    ("*, 0.20.0-any", Syntax(0)),
    ("0.20.0-any, *", Syntax(12)),
    ("0.20.0-any, *, 1.0", Syntax(12)),
    ("1.2.3-01", LeadingZero(6)),
    ("1.2.3+4.", Syntax(8)),
    (">", Syntax(1)),
    ("1.", Syntax(2)),
    ("1.*.", Syntax(4)),
    ("1.2.3+4ÿ", Syntax(7))
  ]
}

pub fn main(t: Test) -> Result[(), semver.SemverError] {
  let mut case: u64 = 2000
  for (spelling, expected) in cargo_errors() {
    test.check_case(t, semver.parse_cargo(spelling) == Error(expected), case)
    case += 1
  }
  // test_wildcard, test_comparator_parse and test_eq_hash spellings.
  let star = semver.parse_cargo("*")?
  test.equal(t, semver.parse_cargo("x")?, star)
  test.equal(t, semver.parse_cargo("X")?, star)
  test.equal(t, semver.req_to_string(star), "*")
  let one = semver.parse_cargo("1.*")?
  test.equal(t, semver.parse_cargo("1.x")?, one)
  test.equal(t, semver.parse_cargo("1.X")?, one)
  test.equal(t, semver.parse_cargo("1.*.*")?, one)
  let two = semver.parse_cargo("1.2.*")?
  test.equal(t, semver.parse_cargo("1.2.x")?, two)
  test.equal(t, semver.parse_cargo("1.2.X")?, two)
  test.equal(t, shown(semver.parse_cargo("1.2.3-alpha")), "^1.2.3-alpha")
  test.equal(t, shown(semver.parse_cargo("2.X")), "2.*")
  test.equal(t, shown(semver.parse_cargo("2")), "^2")
  test.equal(t, shown(semver.parse_cargo("2.x.x")), "2.*")
  test.equal(t, semver.parse_cargo("^1")?, semver.parse_cargo("^1")?)
  test.check(t, semver.parse_cargo("^1")? != semver.parse_cargo("^2")?)
  Ok(())
}
