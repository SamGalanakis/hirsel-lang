// rule: SEM-5
// expect: run
resource type Item {
  number: u64,
}
drop(x) {}

@noalloc
fn by(a: Item, b: Item) -> i32 uses {} {
  if a.number < b.number {
    -1
  } else if a.number > b.number {
    1
  } else {
    0
  }
}

pub fn main(t: Test) -> Result[(), ()] {
  let mut q: unique std@1/priority_queue.Heap[Item] = std@1/priority_queue.empty()
  std@1/priority_queue.push(mut q, Item(number: 7), by)
  match take std@1/priority_queue.pop(mut q, by) {
    Some(item) => std@1/priority_queue.push(mut q, take item, by),
    None => failure.check(false, Bounds()),
  }
  match take std@1/priority_queue.pop(mut q, by) {
    Some(item) => failure.check(item.number == 7, Bounds()),
    None => failure.check(false, Bounds()),
  }
  failure.check(std@1/priority_queue.len(q) == 0, Bounds())
  Ok(())
}
