// rule: SEM-3
// expect: run
// Published spec.txt vectors; tools/generate-markdown.py.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.check(
    s,
    "commonmark/Links/517/malformed",
    "[![moon](moon\u{0}[&unterminated",
    "<p>[![moon](moon�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Links/518/malformed",
    "[foo [bar](/\u{0}[&unterminated",
    "<p>[foo [bar](/�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Links/519/malformed",
    "[foo *[bar [baz](/u\u{0}[&unterminated",
    "<p>[foo *[bar [baz](/u�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Links/520/malformed",
    "![[[foo](uri1)\u{0}[&unterminated",
    "<p>![[<a href=\"uri1\">foo</a>�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Links/521/malformed",
    "*[foo*]\u{0}[&unterminated",
    "<p><em>[foo</em>]�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
