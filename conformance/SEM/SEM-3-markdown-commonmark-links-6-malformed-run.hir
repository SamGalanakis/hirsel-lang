  let mut failed: u64 = 0
  failed += harness.check(
    s,
    "commonmark/Links/507/malformed",
    "[link](/ur\u{0}[&unterminated",
    "<p>[link](/ur�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
