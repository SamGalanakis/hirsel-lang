  failed += harness.check(
    s,
    "commonmark/Links/508/malformed",
    "[link](/url \"tit\u{0}[&unterminated",
    "<p>[link](/url &quot;tit�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Links/509/malformed",
    "[link](/url 'tit\u{0}[&unterminated",
    "<p>[link](/url 'tit�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Links/510/malformed",
    "[link](   /uri\u{0}[&unterminated",
    "<p>[link](   /uri�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Links/511/malformed",
    "[link] \u{0}[&unterminated",
    "<p>[link] �[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
