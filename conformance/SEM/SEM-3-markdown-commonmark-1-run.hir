  )
  failed += harness.check(
    s,
    "commonmark/Setext headings/92",
    "> Foo\n---\n",
    "<blockquote>\n<p>Foo</p>\n</blockquote>\n<hr />\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Setext headings/93",
    "> foo\nbar\n===\n",
    "<blockquote>\n<p>foo\nbar\n===</p>\n</blockquote>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Setext headings/94",
    "- Foo\n---\n",
    "<ul>\n<li>Foo</li>\n</ul>\n<hr />\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Setext headings/95",
    "Foo\nBar\n---\n",
    "<h2>Foo\nBar</h2>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Setext headings/96",
    "---\nFoo\n---\nBar\n---\nBaz\n",
    "<hr />\n<h2>Foo</h2>\n<h2>Bar</h2>\n<p>Baz</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Setext headings/97",
    "\n====\n",
    "<p>====</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Setext headings/98",
    "---\n---\n",
    "<hr />\n<hr />\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Setext headings/99",
    "- foo\n-----\n",
    "<ul>\n<li>foo</li>\n</ul>\n<hr />\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Setext headings/100",
    "    foo\n---\n",
    "<pre><code>foo\n</code></pre>\n<hr />\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Setext headings/101",
    "> foo\n-----\n",
    "<blockquote>\n<p>foo</p>\n</blockquote>\n<hr />\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Setext headings/102",
    "\\> foo\n------\n",
    "<h2>&gt; foo</h2>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Setext headings/103",
    "Foo\n\nbar\n---\nbaz\n",
    "<p>Foo</p>\n<h2>bar</h2>\n<p>baz</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Setext headings/104",
    "Foo\nbar\n\n---\n\nbaz\n",
    "<p>Foo\nbar</p>\n<hr />\n<p>baz</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Setext headings/105",
    "Foo\nbar\n* * *\nbaz\n",
    "<p>Foo\nbar</p>\n<hr />\n<p>baz</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Setext headings/106",
    "Foo\nbar\n\\---\nbaz\n",
    "<p>Foo\nbar\n---\nbaz</p>\n",
    std@1/markdown.default_options()
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
