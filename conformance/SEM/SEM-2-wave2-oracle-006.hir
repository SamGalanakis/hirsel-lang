// rule: SEM-2
// expect: run
// Rust std LowerExp supplies independent shortest digits and decimal parsing.
pub fn main(t: Test) -> Result[(), ()] {
  core@1/test.check(
    t,
    std@1/f64.to_string(core@1/f64.from_bits(4607182418800017408u64)) == "1"
  )
  match std@1/f64.parse("1") {
    Ok(value) => core@1/test.check(t, core@1/f64.bits(value) == 4607182418800017408u64),
    Error(_) => core@1/test.check(t, false),
  }
  Ok(())
}
