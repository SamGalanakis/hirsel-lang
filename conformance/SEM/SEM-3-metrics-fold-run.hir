// rule: SEM-3
// expect: run
fn descriptor(kind: std@1/metrics.Kind, name: String, bounds: List[u64]) -> std@1/metrics.Descriptor uses {} {
  std@1/metrics.Descriptor(
    scope: "test",
    version: "1",
    name: unique name,
    kind: kind,
    unit: "1",
    labels: ["a", "z"],
    bounds: unique bounds
  )
}

fn config(ds: List[std@1/metrics.Descriptor], series: u64) -> std@1/metrics.MetricConfig uses {} {
  std@1/metrics.MetricConfig(
    descriptors: unique ds,
    max_series: series,
    max_buckets: 8,
    max_labels: 2,
    max_label_bytes: 16
  )
}

fn measured(
  d: std@1/metrics.Descriptor,
  value: std@1/metrics.Number,
  labels: List[std@1/telemetry.Attribute]
) -> std@1/metrics.CheckedMeasurement uses {} {
  let checked = std@1/metrics.check_measurement(
    std@1/metrics.Measurement(
      descriptor: unique d,
      labels: unique labels,
      value: value,
      exemplar: None()
    )
  )
  let mut values: List[std@1/metrics.CheckedMeasurement] = []
  match take checked {
    Ok(m) => core@1/list.push(mut values, take m),
    Error(_) => failure.check(false, TextInvariant()),
  }
  copy values[0]
}

fn evidence(name: String) -> std@1/metrics.EvidenceId uses {} {
  std@1/metrics.EvidenceId(
    capture: unique name,
    sha256: "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
  )
}

pub fn main() -> () uses {} {
  let d = descriptor(Histogram(), "h", [1, 3, 6])
  let c = descriptor(Counter(), "c", [])
  let u = descriptor(UpDownCounter(), "u", [])
  let g = descriptor(Gauge(), "g", [])
  let cfg = config([copy d, copy c, copy u, copy g], 1)
  let mut Ok(online) = std@1/metrics.registry(cfg) else {
    failure.check(false, TextInvariant())
    return
  }
  let mut Ok(offline) = std@1/metrics.registry(cfg) else {
    failure.check(false, TextInvariant())
    return
  }
  let e = evidence("capture-A")
  let mut saved = std@1/metrics.checkpoint(offline)
  let mut n: u64 = 0
  while n < 10 {
    let labels: List[std@1/telemetry.Attribute] = [
      std@1/telemetry.Attribute(name: "a", value: Unsigned(n % 3))
    ]
    let selected = match n % 4 {
      0 => copy d,
      1 => copy c,
      2 => copy u,
      _ => copy g,
    }
    let number: std@1/metrics.Number = if n % 4 < 2 {
      Unsigned(n)
    } else {
      Signed(-3)
    }
    let m = measured(selected, number, labels)
    failure.check(std@1/metrics.record(mut online, m) == Ok(()), TextInvariant())
    let event = std@1/metrics.Observation(
      evidence: copy e,
      ordinal: n,
      measurement: Some(m)
    )
    failure.check(std@1/metrics.fold(mut offline, event) == Ok(()), TextInvariant())
    failure.check(std@1/metrics.fold(mut offline, event) == Ok(()), TextInvariant())
    if n == 4 {
      saved = std@1/metrics.checkpoint(offline)
    }
    n += 1
  }
  let mut Ok(restarted) = std@1/metrics.restore(saved, e) else {
    failure.check(false, TextInvariant())
    return
  }
  let Ok(raw) = std@1/metrics.checkpoint_data(saved) else {
    failure.check(false, TextInvariant())
    return
  }
  let mut impossible = unique raw
  impossible.state.instruments[0].series[0].aggregate.unsigned = 18446744073709551615
  failure.check(
    std@1/results.error(std@1/metrics.restore_data(impossible, e)) == Some(
      InvalidCheckpoint()
    ),
    TextInvariant()
  )
  let bytes = codec.encode(raw)
  let decoded: Result[std@1/metrics.CheckpointData, DecodeError] = codec.decode(bytes)
  let Ok(data) = decoded else {
    failure.check(false, TextInvariant())
    return
  }
  let Ok(durable) = std@1/metrics.restore_data(data, e) else {
    failure.check(false, TextInvariant())
    return
  }
  failure.check(
    std@1/metrics.snapshot(durable) == std@1/metrics.snapshot(restarted),
    TextInvariant()
  )
  restarted = take durable
  // Re-ingest the complete prefix, including records present in the checkpoint.
  n = 0
  while n < 10 {
    let labels: List[std@1/telemetry.Attribute] = [
      std@1/telemetry.Attribute(name: "a", value: Unsigned(n % 3))
    ]
    let selected = match n % 4 {
      0 => copy d,
      1 => copy c,
      2 => copy u,
      _ => copy g,
    }
    let number: std@1/metrics.Number = if n % 4 < 2 {
      Unsigned(n)
    } else {
      Signed(-3)
    }
    let m = measured(selected, number, labels)
    failure.check(
      std@1/metrics.fold(
        mut restarted,
        std@1/metrics.Observation(evidence: copy e, ordinal: n, measurement: Some(m))
      ) == Ok(()),
      TextInvariant()
    )
    n += 1
  }
  failure.check(
    std@1/metrics.snapshot(online) == std@1/metrics.snapshot(offline),
    TextInvariant()
  )
  failure.check(
    std@1/metrics.snapshot(offline) == std@1/metrics.snapshot(restarted),
    TextInvariant()
  )
  let previous = std@1/metrics.snapshot(restarted)
  failure.check(
    std@1/metrics.fold(
      mut restarted,
      std@1/metrics.Observation(
        evidence: evidence("other"),
        ordinal: 0,
        measurement: None()
      )
    ) == Error(EvidenceMismatch()),
    TextInvariant()
  )
  failure.check(
    std@1/metrics.fold(
      mut restarted,
      std@1/metrics.Observation(evidence: copy e, ordinal: 11, measurement: None())
    ) == Error(OrdinalGap()),
    TextInvariant()
  )
  failure.check(
    std@1/metrics.snapshot(restarted) == previous && !previous.complete,
    TextInvariant()
  )
  failure.check(
    std@1/metrics.fold(
      mut restarted,
      std@1/metrics.Observation(evidence: copy e, ordinal: 10, measurement: None())
    ) == Ok(()),
    TextInvariant()
  )
  failure.check(std@1/metrics.complete(mut restarted, e, 11) == Ok(()), TextInvariant())
  failure.check(std@1/metrics.snapshot(restarted).complete, TextInvariant())
  failure.check(
    std@1/metrics.fold(
      mut restarted,
      std@1/metrics.Observation(evidence: copy e, ordinal: 11, measurement: None())
    ) == Error(Complete()),
    TextInvariant()
  )
  failure.check(
    std@1/results.error(std@1/metrics.restore(saved, evidence("other"))) == Some(
      EvidenceMismatch()
    ),
    TextInvariant()
  )
}
