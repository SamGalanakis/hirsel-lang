// rule: SEM-3
// expect: run
// Generated by tools/generate-json-vectors.py; see docs/json-domain-vectors.md.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.parses(s, "n_array_items_separated_by_semicolon.json:1", "[1:2]", 1)
  failed += harness.parses(s, "n_array_just_comma.json:1", "[,]", 1)
  failed += harness.parses(s, "n_array_just_minus.json:1", "[-]", 1)
  failed += harness.parses(s, "n_array_missing_value.json:1", "[   , \"\"]", 1)
  failed += harness.parses(s, "n_array_newlines_unclosed.json:1", "[\"a\",\n4\n,1,", 1)
  failed += harness.parses(s, "n_array_number_and_comma.json:1", "[1,]", 1)
  failed += harness.parses(s, "n_array_number_and_several_commas.json:1", "[1,,]", 1)
  failed += harness.parses(
    s,
    "n_array_spaces_vertical_tab_formfeed.json:1",
    "[\"\u{b}a\"\\f]",
    1
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
