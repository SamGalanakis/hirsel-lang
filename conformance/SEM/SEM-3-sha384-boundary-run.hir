// rule: SEM-3
// expect: run
// Padding boundaries around the length field and the 128-byte block, checked
// against Python hashlib, one-shot and split around an empty update.
fn check(input: String, expected: String) -> () {
  let data = string.as_bytes(input)
  failure.check(std@1/sha384.digest_hex(data) == expected, TextInvariant())
  let half = bytes.len(data) / 2
  let mut state = std@1/sha384.new()
  std@1/sha384.update(mut state, bytes.slice(data, 0, half))
  std@1/sha384.update(mut state, b"")
  std@1/sha384.update(mut state, bytes.slice(data, half, bytes.len(data)))
  failure.check(
    std@1/hex.encode(std@1/bytes.from_inline(std@1/sha384.finish(take state))) == expected,
    TextInvariant()
  )
}

pub fn main() -> Result[(), ()] {
  check(
    "abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz0123456789abc",
    "a61b8e45507884b8f600ca1ca05eb6eab1429beef0678f87b9f7442ef6dede4701e705429ed469262e5cc5396f10a5b2"
  )
  check(
    "abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrst",
    "594db25d88489f66b9f1b256946b9c23446c5d815000db4380598ac678d32920c22f66b1ed1b02412397374e7b8b1edd"
  )
  Ok(())
}
