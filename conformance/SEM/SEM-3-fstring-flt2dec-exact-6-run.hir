// rule: SEM-3
// expect: run
// Rust coretests/tests/num/flt2dec/mod.rs, f6c1107f8be13e48465e12c0fd26e6a39fe18e4f.
// MIT; third-party/NOTICES.md. Original check_exact/check_exact_one row lines below.
// The rounded value in units of 10^cutoff, digit by digit against `expected`.
fn same_digits(d: std@1/internal.decimal_seq.DecimalSeq, expected: String, cutoff: i32) -> bool {
  let point: i64 = core@1/int.widen(d.decimal_point)
  let limit: i64 = core@1/int.widen(cutoff)
  let text = core@1/string.as_bytes(expected)
  let length = core@1/bytes.len(text)
  if point - limit <= 0 {
    return length == 1 && text[0] == 48
  }
  let count: u64 = core@1/int.narrow(point - limit)
  if count != length {
    return false
  }
  let mut i: u64 = 0
  while i < count {
    let digit: u8 = if i < d.num_digits {
      d.digits[i]
    } else {
      0
    }
    if text[i] != digit + 48 {
      return false
    }
    i += 1
  }
  true
}

fn exact(t: Test, mantissa: u64, exponent: i32, expected: String, cutoff: i32) -> () {
  let limit: i64 = core@1/int.widen(cutoff)
  let mut d = std@1/internal.decimal_seq.exact(mantissa, exponent, -limit)
  let point: i64 = core@1/int.widen(d.decimal_point)
  std@1/internal.format.round_decimal(mut d, point - limit)
  test.check(t, same_digits(d, expected, cutoff))
}

pub fn main(t: Test) -> Result[(), ()] {
  // mod.rs:510: 8385515147034757p721f64; digits=18, decimal exponent=233.
  exact(t, 8385515147034757u64, 721i32, "925031711960365024", 215i32)
  // mod.rs:511: 7514216811389786p-828f64; digits=19, decimal exponent=-233.
  exact(t, 7514216811389786u64, -828i32, "4198047150284889840", -252i32)
  // mod.rs:512: 8397297803260511p-345f64; digits=20, decimal exponent=-87.
  exact(t, 8397297803260511u64, -345i32, "11716315319786511046", -107i32)
  // mod.rs:513: 6733459239310543p202f64; digits=21, decimal exponent=77.
  exact(t, 6733459239310543u64, 202i32, "432810072844612493629", 56i32)
  // mod.rs:514: 8091450587292794p-473f64; digits=22, decimal exponent=-126.
  exact(t, 8091450587292794u64, -473i32, "3317710118160031081518", -148i32)
  // mod.rs:517: 6567258882077402p952f64; digits=1, decimal exponent=303.
  exact(t, 6567258882077402u64, 952i32, "3", 302i32)
  // mod.rs:518: 6712731423444934p535f64; digits=2, decimal exponent=177.
  exact(t, 6712731423444934u64, 535i32, "76", 175i32)
  Ok(())
}
