// rule: SEM-3
// expect: run
// Published spec.txt vectors; tools/generate-markdown.py.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.check(
    s,
    "commonmark/Setext headings/84",
    "   Foo\n---\n\n  Foo\n-----\n\n  Foo\n  ===\n",
    "<h2>Foo</h2>\n<h2>Foo</h2>\n<h1>Foo</h1>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Setext headings/85",
    "    Foo\n    ---\n\n    Foo\n---\n",
    "<pre><code>Foo\n---\n\nFoo\n</code></pre>\n<hr />\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Setext headings/86",
    "Foo\n   ----      \n",
    "<h2>Foo</h2>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Setext headings/87",
    "Foo\n    ---\n",
    "<p>Foo\n---</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Setext headings/88",
    "Foo\n= =\n\nFoo\n--- -\n",
    "<p>Foo\n= =</p>\n<p>Foo</p>\n<hr />\n",
    std@1/markdown.default_options()
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
