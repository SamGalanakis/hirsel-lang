// rule: SEM-5
// expect: run
// Zig bff490a2 lib/std/priority_queue.zig:371-386,654-674.
@noalloc
fn by(a: i32, b: i32) -> i32 uses {} {
  if a < b {
    -1
  } else if a > b {
    1
  } else {
    0
  }
}

@noalloc
fn reverse(a: i32, b: i32) -> i32 uses {} {
  by(b, a)
}

fn valid(xs: List[i32]) -> () {
  for child in 1u64..list.len(xs) {
    failure.check(xs[(child - 1) / 2] <= xs[child], Bounds())
  }
}

pub fn main(t: Test) -> Result[(), ()] {
  let mut xs: unique List[i32] = []
  let vector_1: Array[i32] = [
    15i32,
    7,
    21,
    14,
    13,
    22,
    12,
    6,
    7,
    25,
    5,
    24,
    11,
    16,
    15,
    24,
    2,
    1
  ]
  for x in vector_1 {
    list.push(mut xs, x)
    heap_ops.sift_up(mut xs, list.len(xs) - 1, by)
    valid(xs)
  }
  // Removing 102 replaces it with 8, which must travel upward from index 6.
  xs = [0, 1, 100, 2, 3, 101, 102, 4, 5, 6, 7, 103, 104, 105, 106, 8]
  let last = list.pop(mut xs)
  xs[6] = 8
  heap_ops.sift_up(mut xs, 6, by)
  valid(xs)
  let vector_2: Array[i32] = [
    0i32,
    1,
    2,
    3,
    4,
    5,
    6,
    7,
    8,
    100,
    101,
    103,
    104,
    105,
    106
  ]
  for x in vector_2 {
    failure.check(xs[0] == x, Bounds())
    list.swap(mut xs, 0, list.len(xs) - 1)
    let _ = list.pop(mut xs)
    heap_ops.sift(mut xs, 0, list.len(xs), reverse)
    valid(xs)
  }
  Ok(())
}
