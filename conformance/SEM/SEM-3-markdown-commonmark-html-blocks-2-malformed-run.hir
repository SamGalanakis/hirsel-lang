// rule: SEM-3
// expect: run
// Published spec.txt vectors; tools/generate-markdown.py.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.check(
    s,
    "commonmark/HTML blocks/151/malformed",
    "</div>\u{0}[&unterminated",
    "</div>�[&unterminated\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/HTML blocks/152/malformed",
    "<DIV CLASS=\"foo\">\n\n\u{0}[&unterminated",
    "<DIV CLASS=\"foo\">\n<p>�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/HTML blocks/153/malformed",
    "<div id=\"foo\"\n  cl\u{0}[&unterminated",
    "<div id=\"foo\"\n  cl�[&unterminated\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/HTML blocks/154/malformed",
    "<div id=\"foo\" class=\u{0}[&unterminated",
    "<div id=\"foo\" class=�[&unterminated\n",
    std@1/markdown.default_options()
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
