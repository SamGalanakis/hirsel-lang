// rule: SEM-3
// expect: run
// A merge mapping and its source consume two nesting levels: 128 fits, 129 fails.
pub fn main(rt: Io) -> Result[(), ()] {
  failure.check(
    match yaml.parse(
      "[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[{<<: {}}]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]"
    ) {
      Ok(_) => true,
      _ => false,
    },
    TextInvariant()
  )
  Ok(())
}
