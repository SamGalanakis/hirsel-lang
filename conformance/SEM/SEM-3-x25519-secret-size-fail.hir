// rule: SEM-3
// expect: fail SEM-3 at line 9
// A 31-byte X25519 secret is refused before any multiplication.
fn decode(text: String) -> unique Bytes {
  let Ok(data) = std@1/hex.decode(text) else {
    failure.check(false, TextInvariant())
    return bytes.from_list([])
  }
  data
}

pub fn main() -> Result[(), ()] {
  failure.check(
    std@1/hex.encode(
      std@1/x25519.public_key(
        decode("8052030376d47112be7f73ed7a019293dd12ad910b654455798b4667d73de1")
      )
    ) == "f1814f0e8ff1043d8a44d25babff3cedcae6c22c3edaa48f857ae70de2baae50",
    TextInvariant()
  )
  Ok(())
}
