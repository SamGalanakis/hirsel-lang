// rule: SEM-1
// expect: run
pub fn main(t: Test) -> Result[(), http.SseError] {
  match http.sse_event(None(), [], Some("bad\u{0}field"), None()) {
    Error(IdNul()) => (),
    _ => test.check(t, false),
  }
  test.check(
    t,
    http.sse_event(Some("valid"), ["data"], Some("id"), None()) == Ok(
      b"event: valid\ndata: data\nid: id\n\n"
    )
  )
  Ok(())
}
