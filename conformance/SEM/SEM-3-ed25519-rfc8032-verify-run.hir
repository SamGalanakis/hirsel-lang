// rule: SEM-3
// expect: run
// steps: 8000000
// verification decodes two points and runs a double multiplication, about 4M steps
// RFC 8032 section 7.1 TEST 2: the one-byte message's signature verifies under the public key.
fn decode(text: String) -> unique Bytes {
  let Ok(data) = std@1/hex.decode(text) else {
    failure.check(false, TextInvariant())
    return bytes.from_list([])
  }
  data
}

pub fn main() -> Result[(), ()] {
  failure.check(
    std@1/ed25519.verify(
      decode("3d4017c3e843895a92b70aa74d1b7ebc9c982ccf2ec4968cc0cd55f12af4660c"),
      decode("72"),
      decode(
        "92a009a9f0d4cab8720e820b5f642540a2b27b5416503f8fb3762223ebdb69da085ac1e43e15996e458f3613d0f11d8c387b2eaeb4302aeeb00d291612bb0c00"
      )
    ),
    TextInvariant()
  )
  Ok(())
}
