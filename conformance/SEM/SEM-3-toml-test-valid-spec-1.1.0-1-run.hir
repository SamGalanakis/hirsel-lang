    "# RECOMMENDED\n\napple.type = \"fruit\"\napple.skin = \"thin\"\napple.color = \"red\"\n\norange.type = \"fruit\"\norange.skin = \"thick\"\norange.color = \"orange\"\n",
    "{\"apple\":{\"color\":{\"type\":\"string\",\"value\":\"red\"},\"skin\":{\"type\":\"string\",\"value\":\"thin\"},\"type\":{\"type\":\"string\",\"value\":\"fruit\"}},\"orange\":{\"color\":{\"type\":\"string\",\"value\":\"orange\"},\"skin\":{\"type\":\"string\",\"value\":\"thick\"},\"type\":{\"type\":\"string\",\"value\":\"fruit\"}}}"
  )
  failed += harness.valid(
