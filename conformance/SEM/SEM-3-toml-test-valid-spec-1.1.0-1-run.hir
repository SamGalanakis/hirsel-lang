    "valid/spec-1.1.0/common-13",
    "str1 = \"\"\"\nRoses are red\nViolets are blue\"\"\"\n",
    "{\"str1\":{\"type\":\"string\",\"value\":\"Roses are red\\nViolets are blue\"}}"
