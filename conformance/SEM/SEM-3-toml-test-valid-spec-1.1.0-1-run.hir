    "str = \"I'm a string. \\\"You can quote me\\\". Name\\tJos\\xE9\\nLocation\\tSF.\"\n",
    "{\"str\":{\"type\":\"string\",\"value\":\"I'm a string. \\\"You can quote me\\\". Name\\tJosé\\nLocation\\tSF.\"}}"
  )
  failed += harness.valid(
