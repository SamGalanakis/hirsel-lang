// rule: SEM-3
// expect: run
// Published spec.txt vectors; tools/generate-markdown.py.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.check(
    s,
    "commonmark/HTML blocks/176",
    "<style>p{color:red;}</style>\n*foo*\n",
    "<style>p{color:red;}</style>\n<p><em>foo</em></p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/HTML blocks/177",
    "<!-- foo -->*bar*\n*baz*\n",
    "<!-- foo -->*bar*\n<p><em>baz</em></p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/HTML blocks/178",
    "<script>\nfoo\n</script>1. *bar*\n",
    "<script>\nfoo\n</script>1. *bar*\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/HTML blocks/179",
    "<!-- Foo\n\nbar\n   baz -->\nokay\n",
    "<!-- Foo\n\nbar\n   baz -->\n<p>okay</p>\n",
    std@1/markdown.default_options()
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
