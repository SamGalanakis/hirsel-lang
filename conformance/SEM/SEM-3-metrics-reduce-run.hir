// rule: SEM-3
// expect: run
fn descriptor(kind: std@1/metrics.Kind, name: String, bounds: List[u64]) -> std@1/metrics.Descriptor uses {} {
  std@1/metrics.Descriptor(
    scope: "test",
    version: "1",
    name: unique name,
    kind: kind,
    unit: "1",
    labels: ["a", "z"],
    bounds: unique bounds
  )
}

fn config(ds: List[std@1/metrics.Descriptor], series: u64) -> std@1/metrics.MetricConfig uses {} {
  std@1/metrics.MetricConfig(
    descriptors: unique ds,
    max_series: series,
    max_buckets: 8,
    max_labels: 2,
    max_label_bytes: 16
  )
}

fn measured(
  d: std@1/metrics.Descriptor,
  value: std@1/metrics.Number,
  labels: List[std@1/telemetry.Attribute]
) -> std@1/metrics.CheckedMeasurement uses {} {
  let checked = std@1/metrics.check_measurement(
    std@1/metrics.Measurement(
      descriptor: unique d,
      labels: unique labels,
      value: value,
      exemplar: None()
    )
  )
  let mut values: List[std@1/metrics.CheckedMeasurement] = []
  match take checked {
    Ok(m) => core@1/list.push(mut values, take m),
    Error(_) => failure.check(false, TextInvariant()),
  }
  copy values[0]
}

pub fn main() -> Result[(), std@1/metrics.MetricError] uses {} {
  let h = descriptor(Histogram(), "h", [1, 3, 6])
  let c = descriptor(Counter(), "c", [])
  let u = descriptor(UpDownCounter(), "u", [])
  let g = descriptor(Gauge(), "g", [])
  let mut Ok(r) = std@1/metrics.registry(config([copy h, copy c, copy u, copy g], 1)) else {
    failure.check(false, TextInvariant())
    return Ok(())
  }
  // OTel Rust check_buckets_are_selected_correctly: 1..=10 -> [1,2,3,4].
  let mut n: u64 = 1
  while n <= 10 {
    failure.check(
      std@1/metrics.record(mut r, measured(h, Unsigned(n), [])) == Ok(()),
      TextInvariant()
    )
    n += 1
  }
  let hist = std@1/metrics.snapshot(r).instruments[0].series[0].aggregate
  failure.check(
    hist.count == 10 && hist.unsigned == 55 && hist.buckets == [1, 2, 3, 4],
    TextInvariant()
  )
  let a: List[std@1/telemetry.Attribute] = [
    std@1/telemetry.Attribute(name: "a", value: Text("one"))
  ]
  let b: List[std@1/telemetry.Attribute] = [
    std@1/telemetry.Attribute(name: "a", value: Text("two"))
  ]
  let z: List[std@1/telemetry.Attribute] = [
    std@1/telemetry.Attribute(name: "z", value: Text("other"))
  ]
  failure.check(
    std@1/metrics.record(mut r, measured(c, Unsigned(1), a)) == Ok(()),
    TextInvariant()
  )
  failure.check(
    std@1/metrics.record(mut r, measured(c, Unsigned(2), b)) == Ok(()),
    TextInvariant()
  )
  failure.check(
    std@1/metrics.record(mut r, measured(c, Unsigned(4), z)) == Ok(()),
    TextInvariant()
  )
  failure.check(
    std@1/metrics.record(mut r, measured(c, Unsigned(8), a)) == Ok(()),
    TextInvariant()
  )
  let counter = std@1/metrics.snapshot(r).instruments[1]
  failure.check(
    core@1/list.len(counter.series) == 1 && counter.series[0].aggregate.unsigned == 9,
    TextInvariant()
  )
  failure.check(
    counter.overflow.count == 2 && counter.overflow.unsigned == 6,
    TextInvariant()
  )
  failure.check(
    std@1/metrics.record(mut r, measured(u, Signed(9), [])) == Ok(()),
    TextInvariant()
  )
  failure.check(
    std@1/metrics.record(mut r, measured(u, Signed(-12), [])) == Ok(()),
    TextInvariant()
  )
  failure.check(
    std@1/metrics.record(mut r, measured(g, Signed(8), [])) == Ok(()),
    TextInvariant()
  )
  failure.check(
    std@1/metrics.record(mut r, measured(g, Signed(-2), [])) == Ok(()),
    TextInvariant()
  )
  let snap = std@1/metrics.snapshot(r)
  failure.check(snap.instruments[2].series[0].aggregate.signed == -3, TextInvariant())
  failure.check(snap.instruments[3].series[0].aggregate.signed == -2, TextInvariant())
  // The preallocated overflow interval also exists for an empty-bound histogram.
  let empty = descriptor(Histogram(), "empty", [])
  let mut Ok(all_overflow) = std@1/metrics.registry(config([copy empty], 0)) else {
    failure.check(false, TextInvariant())
    return Ok(())
  }
  failure.check(
    std@1/metrics.record(mut all_overflow, measured(empty, Unsigned(0), [])) == Ok(()),
    TextInvariant()
  )
  failure.check(
    std@1/metrics.snapshot(all_overflow).instruments[0].overflow.buckets == [1],
    TextInvariant()
  )
  Ok(())
}
