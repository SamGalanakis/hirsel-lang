// rule: SEM-3
// expect: run
pub fn main(rt: Io, args: Args) -> Result[(), OutputError] {
  failure.check(bytes.replace(b"aaaaa", b"aa", b"x") == b"xxa", TextInvariant())
  failure.check(bytes.replace(b"ababa", b"aba", b"X") == b"Xba", TextInvariant())
  failure.check(
    bytes.replace(b"\xff\0\xff", b"\xff", b"\xfe\xfd") == b"\xfe\xfd\0\xfe\xfd",
    TextInvariant()
  )
  failure.check(bytes.replace(b"aaaa", b"aa", b"aaa") == b"aaaaaa", TextInvariant())
  Ok(())
}
