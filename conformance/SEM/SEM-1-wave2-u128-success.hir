// rule: SEM-1
// expect: run
pub fn main(t: Test) -> Result[(), ()] {
  core@1/test.check(t, u128.to_string(12u128) == "12")
  core@1/test.check(t, u128.parse("12") == Ok(12u128))
  let mut buffer: Inline[u8, 2] = [99u8, 99u8]
  core@1/test.check(t, u128.format_inline(12u128, mut buffer) == Ok(2u64))
  core@1/test.check(t, buffer == [49u8, 50u8])
  Ok(())
}
