// rule: SEM-3
// expect: run
// Published spec.txt vectors; tools/generate-markdown.py.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.check(
    s,
    "commonmark/Tabs/7/malformed",
    "-\t\t\u{0}[&unterminated",
    "<ul>\n<li>\n<pre><code>  �[&amp;unterminated\n</code></pre>\n</li>\n</ul>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Tabs/8/malformed",
    "    fo\u{0}[&unterminated",
    "<pre><code>fo�[&amp;unterminated\n</code></pre>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Tabs/9/malformed",
    " - foo\n   - \u{0}[&unterminated",
    "<ul>\n<li>foo\n<ul>\n<li>�[&amp;unterminated</li>\n</ul>\n</li>\n</ul>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Tabs/10/malformed",
    "#\tF\u{0}[&unterminated",
    "<h1>F�[&amp;unterminated</h1>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Tabs/11/malformed",
    "*\t*\u{0}[&unterminated",
    "<ul>\n<li>*�[&amp;unterminated</li>\n</ul>\n",
    std@1/markdown.default_options()
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
