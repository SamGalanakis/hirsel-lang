    "EHF6",
    "!!map {\n  k: !!seq\n  [ a, !!str b]\n}\n",
    ["{\"k\":[\"a\",\"b\"]}"]
  )
  failed += harness.invalid(s, "EW3V", "k1: v1\n k2: v2\n")
  failed += harness.valid(s, "EX5H", "---\na\nb  \n  c\nd\n\ne\n", ["\"a b c d\\ne\""])
  failed += harness.valid(s, "EXG3", "---\n---word1\nword2\n", ["\"---word1 word2\""])
  failed += harness.valid(
    s,
    "F2C7",
    " - &a !!str a\n - !!int 2\n - !!int &c 4\n - &d d\n",
    ["[\"a\",2,4,\"d\"]"]
  )
  failed += harness.valid(
    s,
    "F3CP",
    "---\n{ a: [b, c, { d: [e, f] } ] }\n",
    ["{\"a\":[\"b\",\"c\",{\"d\":[\"e\",\"f\"]}]}"]
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
