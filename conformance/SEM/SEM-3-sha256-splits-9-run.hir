// rule: SEM-3
// expect: run
// Zig SHA-256 reference vectors and padding boundaries.
fn digest_hex(data: Inline[u8, 32]) -> String {
  let mut out: List[u8] = []
  for byte in data {
    list.push(mut out, byte)
  }
  std@1/hex.encode(bytes.from_list(take out))
}

pub fn main() -> Result[(), ()] {
  let data = b"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
  let mut state18 = std@1/sha256.new()
  std@1/sha256.update(mut state18, bytes.slice(data, 0, 18))
  std@1/sha256.update(mut state18, bytes.slice(data, 18, 128))
  failure.check(
    digest_hex(std@1/sha256.finish(take state18)) == "6836cf13bac400e9105071cd6af47084dfacad4e5e302c94bfed24e013afb73e",
    TextInvariant()
  )
  let mut state19 = std@1/sha256.new()
  std@1/sha256.update(mut state19, bytes.slice(data, 0, 19))
  std@1/sha256.update(mut state19, bytes.slice(data, 19, 128))
  failure.check(
    digest_hex(std@1/sha256.finish(take state19)) == "6836cf13bac400e9105071cd6af47084dfacad4e5e302c94bfed24e013afb73e",
    TextInvariant()
  )
  Ok(())
}
