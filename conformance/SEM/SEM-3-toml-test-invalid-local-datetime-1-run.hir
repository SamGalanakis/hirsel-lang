// rule: SEM-3
// expect: run
// Generated by tools/generate-toml-test.py from toml-test ff49d109861c
// tests/files-toml-1.1.0, group invalid-local-datetime.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.invalid(
    s,
    "invalid/local-datetime/feb-29",
    "\"not a leap year\" = 2100-02-29T15:15:15\n"
  )
  failed += harness.invalid(
    s,
    "invalid/local-datetime/feb-30",
    "\"only 28 or 29 days in february\" = 1988-02-30T15:15:15\n\n"
  )
  failed += harness.invalid(
    s,
    "invalid/local-datetime/hour-over",
    "# time-hour       = 2DIGIT  ; 00-23\nd = 2006-01-01T24:00:00\n"
  )
  failed += harness.invalid(
    s,
    "invalid/local-datetime/mday-over",
    "# date-mday       = 2DIGIT  ; 01-28, 01-29, 01-30, 01-31 based on\n#                           ; month/year\nd = 2006-01-32T00:00:00\n"
  )
  failed += harness.invalid(
    s,
    "invalid/local-datetime/mday-under",
    "# date-mday       = 2DIGIT  ; 01-28, 01-29, 01-30, 01-31 based on\n#                           ; month/year\nd = 2006-01-00T00:00:00\n"
  )
  failed += harness.invalid(
    s,
    "invalid/local-datetime/minute-over",
    "# time-minute     = 2DIGIT  ; 00-59\nd = 2006-01-01T00:60:00\n"
  )
  failed += harness.invalid(
    s,
    "invalid/local-datetime/month-over",
    "# date-month      = 2DIGIT  ; 01-12\nd = 2006-13-01T00:00:00\n"
  )
  failed += harness.invalid(
    s,
    "invalid/local-datetime/month-under",
    "# date-month      = 2DIGIT  ; 01-12\nd = 2007-00-01T00:00:00\n"
  )
  failed += harness.invalid(
    s,
    "invalid/local-datetime/no-leads",
    "# Month \"7\" instead of \"07\"; the leading zero is required.\nno-leads = 1987-7-05T17:45:00\n"
  )
  failed += harness.invalid(
    s,
    "invalid/local-datetime/no-leads-with-milli",
    "# Day \"5\" instead of \"05\"; the leading zero is required.\nwith-milli = 1987-07-5T17:45:00.12\n"
  )
  failed += harness.invalid(
    s,
    "invalid/local-datetime/no-t",
    "# No \"t\" or \"T\" between the date and time.\nno-t = 1987-07-0517:45:00\n"
  )
  failed += harness.invalid(
    s,
    "invalid/local-datetime/second-over",
    "# time-second     = 2DIGIT  ; 00-58, 00-59, 00-60 based on leap second\n#                           ; rules\nd = 2006-01-01T00:00:61\n"
  )
  failed += harness.invalid(
    s,
    "invalid/local-datetime/time-no-leads",
    "# Leading 0 is always required.\nd = 2023-10-01T1:32:00Z\n"
  )
  failed += harness.invalid(
    s,
    "invalid/local-datetime/y10k",
    "# Maximum RFC3399 year is 9999.\nd = 10000-01-01 00:00:00\n"
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
