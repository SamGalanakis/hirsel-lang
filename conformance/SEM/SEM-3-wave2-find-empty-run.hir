// rule: SEM-3
// expect: run
pub fn main(rt: Io, args: Args) -> Result[(), OutputError] {
  let source: String = ""
  failure.check(
    match string.find(source, "") {
      Some(p) => string.byte_offset(source, p) == 0,
      None() => false,
    },
    TextInvariant()
  )
  failure.check(
    match string.find(source, "x") {
      Some(_) => false,
      None() => true,
    },
    TextInvariant()
  )
  Ok(())
}
