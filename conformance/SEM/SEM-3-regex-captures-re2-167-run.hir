// rule: SEM-3
// expect: run
// Go ebe2feef capture/flag/replacement vectors (BSD-3-Clause).
// RE2 data Copyright 2009 The RE2 Authors (BSD-3-Clause).
fn check(pattern: String, input: String, maximum: u64, expected: List[regex.Captures]) -> Result[
  (),
  ()
] {
  let Ok(re) = regex.compile(pattern, 10000) else {
    return Error(())
  }
  failure.check(
    regex.find_all_captures(re, input, maximum, 1000000) == Ok(expected),
    TextInvariant()
  )
  if maximum != 0 {
    let first: Option[regex.Captures] = if list.len(expected) == 0 {
      None()
    } else {
      Some(copy expected[0])
    }
    failure.check(regex.find_captures(re, input, 1000000) == Ok(first), TextInvariant())
  }
  Ok(())
}

pub fn main() -> Result[(), ()] {
  // Go re2-search.txt:2719
  check("^(?:^.....$)", "", 1, [])?
  // Go re2-search.txt:2720
  check("^(?:^.....$)", ".本.", 1, [])?
  // Go re2-search.txt:2722
  check("(?:^.....$)$", "", 1, [])?
  // Go re2-search.txt:2723
  check("(?:^.....$)$", ".本.", 1, [])?
  // Go re2-search.txt:2729
  check("\\B(fo|foo)\\B", "", 1, [])?
  // Go re2-search.txt:2730
  check(
    "\\B(fo|foo)\\B",
    "xfooo",
    1,
    [
      regex.Captures(
        spans: [Some(regex.Span(start: 1, end: 3)), Some(regex.Span(start: 1, end: 3))]
      )
    ]
  )?
  // Go re2-search.txt:2732
  check("^(?:\\B(fo|foo)\\B)$", "", 1, [])?
  // Go re2-search.txt:2733
  check("^(?:\\B(fo|foo)\\B)$", "xfooo", 1, [])?
  Ok(())
}
