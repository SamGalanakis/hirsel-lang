// rule: SEM-3
// expect: run
// Go src/archive/tar/writer_test.go TestWriter (golang/go ebe2feef):
// PAX global headers and records the header states reproduce
// pax-global-records.tar byte for byte.
fn records(entries: List[(String, String)]) -> Map[String, String] {
  let mut m: Map[String, String] = map.empty()
  for (key, value) in entries {
    map.insert(mut m, unique key, unique value)
  }
  m
}

fn entry(mut w: tar.Writer, h: tar.Header, data: Bytes, mut out: List[u8]) -> bool {
  tar.write_header(mut w, h, mut out) == Ok(()) && tar.write(mut w, data, mut out) == Ok(
    ()
  )
}

