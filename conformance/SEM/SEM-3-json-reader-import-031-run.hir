// rule: SEM-3
// expect: run
// JSONTestSuite 1ef36fa01286573e846ac449e8683f8833c5b26a test_parsing/*.json:1.
// Differential reader twin of the existing imports; exact JsonError offsets.
fn check(t: Test, source: String) -> () {
  let expected: Result[(), json.JsonError] = match json.parse(unique source) {
    Ok(_) => Ok(()),
    Error(e) => Error(e),
  }
  let mut cursor = json.reader(string.as_bytes(source))
  let actual = match json.skip(mut cursor) {
    Ok(()) => json.finish_reader(mut cursor),
    Error(e) => Error(e),
  }
  test.equal(t, actual, expected)
}

pub fn main(t: Test) -> Result[(), ()] {
  // "y_string_1_2_3_bytes_UTF-8_sequences.json:1"
  check(t, "[\"\\u0060\\u012a\\u12AB\"]")
  // "y_string_accepted_surrogate_pair.json:1"
  check(t, "[\"\\uD801\\udc37\"]")
  // "y_string_accepted_surrogate_pairs.json:1"
  check(t, "[\"\\ud83d\\ude39\\ud83d\\udc8d\"]")
  // "y_string_allowed_escapes.json:1"
  check(t, "[\"\\\"\\\\\\/\\b\\f\\n\\r\\t\"]")
  // "y_string_backslash_and_u_escaped_zero.json:1"
  check(t, "[\"\\\\u0000\"]")
  // "y_string_backslash_doublequotes.json:1"
  check(t, "[\"\\\"\"]")
  // "y_string_comments.json:1"
  check(t, "[\"a/*b*/c/*d//e\"]")
  // "y_string_double_escape_a.json:1"
  check(t, "[\"\\\\a\"]")
  Ok(())
}
