// rule: SEM-3
// expect: run
// Published spec.txt vectors; tools/generate-markdown.py.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.check(
    s,
    "commonmark/Links/499/malformed",
    "[link](<foo\u{0}[&unterminated",
    "<p>[link](&lt;foo�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Links/500/malformed",
    "[link](f\u{0}[&unterminated",
    "<p>[link](f�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Links/501/malformed",
    "[link](#fragment)\n\n[link](https://example.com#fr\u{0}[&unterminated",
    "<p><a href=\"#fragment\">link</a></p>\n<p>[link](https://example.com#fr�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Links/502/malformed",
    "[link](f\u{0}[&unterminated",
    "<p>[link](f�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
