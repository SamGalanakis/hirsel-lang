// rule: SEM-3
// expect: run
// A selection of Go crypto/sha512 golden256 (SHA-512/256) vectors and the FIPS 180-2
// two-block message.
fn check(input: String, expected: String) -> () {
  failure.check(
    std@1/sha512_256.digest_hex(string.as_bytes(input)) == expected,
    TextInvariant()
  )
}

pub fn main() -> Result[(), ()] {
  check("", "c672b8d1ef56ed28ab87c3622c5114069bdd3ad7b8f9737498d0c01ecef0967a")
  check("a", "455e518824bc0601f9fb858ff5c37d417d67c2f8e0df2babe4808858aea830f8")
  check("ab", "22d4d37ec6370571af7109fb12eae79673d5f7c83e6e677083faa3cfac3b2c14")
  check("abc", "53048e2681941ef99b2e29b76b4c7dabe4c2d0c634fc6d46e0e2f13107e7af23")
  check(
    "abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu",
    "3928e184fb8690f840da3988121d31be65cb9d3ef83ee6146feac861e19b563a"
  )
  Ok(())
}
