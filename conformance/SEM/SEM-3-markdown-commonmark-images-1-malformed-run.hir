// rule: SEM-3
// expect: run
// Published spec.txt vectors; tools/generate-markdown.py.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.check(
    s,
    "commonmark/Images/572/malformed",
    "![foo](/ur\u{0}[&unterminated",
    "<p>![foo](/ur�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Images/573/malformed",
    "![foo *bar*]\n\n[foo *bar*]: \u{0}[&unterminated",
    "<p><img src=\"%EF%BF%BD%5B&amp;unterminated\" alt=\"foo bar\" /></p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Images/574/malformed",
    "![foo ![bar](\u{0}[&unterminated",
    "<p>![foo ![bar](�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Images/575/malformed",
    "![foo [bar](/\u{0}[&unterminated",
    "<p>![foo [bar](/�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
