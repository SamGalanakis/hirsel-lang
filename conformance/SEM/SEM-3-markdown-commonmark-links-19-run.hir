// rule: SEM-3
// expect: run
// Published spec.txt vectors; tools/generate-markdown.py.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.check(
    s,
    "commonmark/Links/565",
    "[foo][bar]\n\n[foo]: /url1\n[bar]: /url2\n",
    "<p><a href=\"/url2\">foo</a></p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Links/566",
    "[foo][]\n\n[foo]: /url1\n",
    "<p><a href=\"/url1\">foo</a></p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Links/567",
    "[foo]()\n\n[foo]: /url1\n",
    "<p><a href=\"\">foo</a></p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Links/568",
    "[foo](not a link)\n\n[foo]: /url1\n",
    "<p><a href=\"/url1\">foo</a>(not a link)</p>\n",
    std@1/markdown.default_options()
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
