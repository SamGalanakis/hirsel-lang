// rule: SEM-3
// expect: run
// Go src/compress/gzip/gunzip_test.go gunzipTests (golang/go ebe2feef), members
// written by CPython's gzip, and hand-built headers and members.
fn check(ok: bool) -> () uses {} {
  failure.check(ok, TextInvariant())
}

pub fn main(t: Test) -> Result[(), ()] {
  // empty.txt
  check(
    flate.gzip_decode(
      b"\x1f\x8b\x08\x08\xf7^\x14J\x00\x03empty.txt\x00\x03\x00\x00\x00\x00\x00\x00\x00\x00\x00",
      4096
    ) == Ok(b"")
  )
  // empty - with no file name
  check(
    flate.gzip_decode(
      b"\x1f\x8b\x08\x00\x00\x09n\x88\x00\xff\x01\x00\x00\xff\xff\x00\x00\x00\x00\x00\x00\x00\x00",
      4096
    ) == Ok(b"")
  )
  // hello.txt
  check(
    flate.gzip_decode(
      b"\x1f\x8b\x08\x08\xc8X\x13J\x00\x03hello.txt\x00\xcbH\xcd\xc9\xc9W(\xcf/\xcaI\xe1\x02\x00-;\x08\xaf\x0c\x00\x00\x00",
      4096
    ) == Ok(b"hello world\x0a")
  )
  // hello.txt x2
  check(
    flate.gzip_decode(
      b"\x1f\x8b\x08\x08\xc8X\x13J\x00\x03hello.txt\x00\xcbH\xcd\xc9\xc9W(\xcf/\xcaI\xe1\x02\x00-;\x08\xaf\x0c\x00\x00\x00\x1f\x8b\x08\x08\xc8X\x13J\x00\x03hello.txt\x00\xcbH\xcd\xc9\xc9W(\xcf/\xcaI\xe1\x02\x00-;\x08\xaf\x0c\x00\x00\x00",
      4096
    ) == Ok(b"hello world\x0ahello world\x0a")
  )
  // shesells.txt
  check(
    flate.gzip_decode(
      b"\x1f\x8b\x08\x08rf\x8bJ\x00\x03shesells.txt\x00+\xceHU(N\xcd\xc9)\x06\x92\x89\xc5\x19`VR\xa5B\x09X\x18(\x90_\x94\xca\x05\x00v\xb0;\xeb$\x00\x00\x00",
      4096
    ) == Ok(b"she sells seashells by the seashore\x0a")
  )
  // hello.txt + garbage
  check(
    flate.gzip_decode(
      b"\x1f\x8b\x08\x08\xc8X\x13J\x00\x03hello.txt\x00\xcbH\xcd\xc9\xc9W(\xcf/\xcaI\xe1\x02\x00-;\x08\xaf\x0c\x00\x00\x00garbage!!!",
      4096
    ) == Error(Header())
  )
  // hello.txt + garbage
  check(
    flate.gzip_decode(
      b"\x1f\x8b\x08\x08\xc8X\x13J\x00\x03hello.txt\x00\xcbH\xcd\xc9\xc9W(\xcf/\xcaI\xe1\x02\x00-;\x08\xaf\x0c\x00\x00\x00\x1f",
      4096
    ) == Error(Truncated())
  )
  // hello.txt + corrupt checksum
  check(
    flate.gzip_decode(
      b"\x1f\x8b\x08\x08\xc8X\x13J\x00\x03hello.txt\x00\xcbH\xcd\xc9\xc9W(\xcf/\xcaI\xe1\x02\x00\xff\xff\xff\xff\x0c\x00\x00\x00",
      4096
    ) == Error(Checksum())
  )
  // hello.txt + corrupt size
  check(
    flate.gzip_decode(
      b"\x1f\x8b\x08\x08\xc8X\x13J\x00\x03hello.txt\x00\xcbH\xcd\xc9\xc9W(\xcf/\xcaI\xe1\x02\x00-;\x08\xaf\xff\x00\x00\x00",
      4096
    ) == Error(Checksum())
  )
  // header with all fields used
  check(
    flate.gzip_decode(
      b"\x1f\x8b\x08\x1ep\xf0\xf9J\x00\xaa\x09\x00zz\x05\x00abcdef1l3n4m3.tXt\x00\x01\x02\x03\x04\x05\x06\x07\x08\x09\x0a\x0b\x0c\x0d\x0e\x0f\x10\x11\x12\x13\x14\x15\x16\x17\x18\x19\x1a\x1b\x1c\x1d\x1e\x1f !\x22#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\x5c]^_`abcdefghijklmnopqrstuvwxyz{|}~\x7f\x80\x81\x82\x83\x84\x85\x86\x87\x88\x89\x8a\x8b\x8c\x8d\x8e\x8f\x90\x91\x92\x93\x94\x95\x96\x97\x98\x99\x9a\x9b\x9c\x9d\x9e\x9f\xa0\xa1\xa2\xa3\xa4\xa5\xa6\xa7\xa8\xa9\xaa\xab\xac\xad\xae\xaf\xb0\xb1\xb2\xb3\xb4\xb5\xb6\xb7\xb8\xb9\xba\xbb\xbc\xbd\xbe\xbf\xc0\xc1\xc2\xc3\xc4\xc5\xc6\xc7\xc8\xc9\xca\xcb\xcc\xcd\xce\xcf\xd0\xd1\xd2\xd3\xd4\xd5\xd6\xd7\xd8\xd9\xda\xdb\xdc\xdd\xde\xdf\xe0\xe1\xe2\xe3\xe4\xe5\xe6\xe7\xe8\xe9\xea\xeb\xec\xed\xee\xef\xf0\xf1\xf2\xf3\xf4\xf5\xf6\xf7\xf8\xf9\xfa\xfb\xfc\xfd\xfe\xff\x00\x92\xfd\x01\x00\x00\xff\xff\x00\x00\x00\x00\x00\x00\x00\x00",
      4096
    ) == Ok(b"")
  )
  // truncated gzip file amid raw-block
  check(
    flate.gzip_decode(
      b"\x1f\x8b\x08\x00\x00\x00\x00\x00\x00\xff\x00\x0c\x00\xf3\xffhello",
      4096
    ) == Error(Truncated())
  )
  // truncated gzip file amid fixed-block
  check(
    flate.gzip_decode(b"\x1f\x8b\x08\x00\x00\x00\x00\x00\x00\xff\xf2H\xcd", 4096) == Error(
      Truncated()
    )
  )
  // gzip header with truncated name
  check(
    flate.gzip_decode(
      b"\x1f\x8b\x08\x08\xc8X\x13J\x00\x03hello.txt\x00\xcbH\xcd\xc9\xc9W(\xcf/\xcaI\xe1\x02\x00-;\x08\xaf\x0c\x00\x00\x00\x1f\x8b\x08\x08\x00\x00\x00\x00\x00\xff\x01",
      4096
    ) == Error(Truncated())
  )
  // gzip header with truncated comment
  check(
    flate.gzip_decode(
      b"\x1f\x8b\x08\x10\xc8X\x13J\x00\x03hello.txt\x00\xcbH\xcd\xc9\xc9W(\xcf/\xcaI\xe1\x02\x00-;\x08\xaf\x0c\x00\x00\x00\x1f\x8b\x08\x10\x00\x00\x00\x00\x00\xff\x01",
      4096
    ) == Error(Truncated())
  )
  // The all-fields header with its header CRC corrupted.
  check(
    flate.gzip_decode(
      b"\x1f\x8b\x08\x1ep\xf0\xf9J\x00\xaa\x09\x00zz\x05\x00abcdef1l3n4m3.tXt\x00\x01\x02\x03\x04\x05\x06\x07\x08\x09\x0a\x0b\x0c\x0d\x0e\x0f\x10\x11\x12\x13\x14\x15\x16\x17\x18\x19\x1a\x1b\x1c\x1d\x1e\x1f !\x22#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\x5c]^_`abcdefghijklmnopqrstuvwxyz{|}~\x7f\x80\x81\x82\x83\x84\x85\x86\x87\x88\x89\x8a\x8b\x8c\x8d\x8e\x8f\x90\x91\x92\x93\x94\x95\x96\x97\x98\x99\x9a\x9b\x9c\x9d\x9e\x9f\xa0\xa1\xa2\xa3\xa4\xa5\xa6\xa7\xa8\xa9\xaa\xab\xac\xad\xae\xaf\xb0\xb1\xb2\xb3\xb4\xb5\xb6\xb7\xb8\xb9\xba\xbb\xbc\xbd\xbe\xbf\xc0\xc1\xc2\xc3\xc4\xc5\xc6\xc7\xc8\xc9\xca\xcb\xcc\xcd\xce\xcf\xd0\xd1\xd2\xd3\xd4\xd5\xd6\xd7\xd8\xd9\xda\xdb\xdc\xdd\xde\xdf\xe0\xe1\xe2\xe3\xe4\xe5\xe6\xe7\xe8\xe9\xea\xeb\xec\xed\xee\xef\xf0\xf1\xf2\xf3\xf4\xf5\xf6\xf7\xf8\xf9\xfa\xfb\xfc\xfd\xfe\xff\x00\x93\xfd\x01\x00\x00\xff\xff\x00\x00\x00\x00\x00\x00\x00\x00",
      4096
    ) == Error(Header())
  )
  // RFC 1952 section 2.3.1.2: reserved flag bits must be zero.
  check(
    flate.gzip_decode(
      b"\x1f\x8b\x08(\xc8X\x13J\x00\x03hello.txt\x00\xcbH\xcd\xc9\xc9W(\xcf/\xcaI\xe1\x02\x00-;\x08\xaf\x0c\x00\x00\x00",
      4096
    ) == Error(Header())
  )
  // A member cannot reach back into the previous member's output.
  check(
    flate.gzip_decode(
      b"\x1f\x8b\x08\x00\x00\x00\x00\x00\x00\xffK\x04\x02\x00E\xe5\x98\xad\x04\x00\x00\x00",
      4096
    ) == Ok(b"aaaa")
  )
  check(
    flate.gzip_decode(
      b"\x1f\x8b\x08\x00\x00\x00\x00\x00\x00\xffK\x04\x02\x00E\xe5\x98\xad\x04\x00\x00\x00\x1f\x8b\x08\x00\x00\x00\x00\x00\x00\xff\x03\x02\x00-s\x07\xf0\x03\x00\x00\x00",
      4096
    ) == Error(Corrupt(34u64))
  )
  // The bound covers every member.
  let twice = b"\x1f\x8b\x08\x08\xc8X\x13J\x00\x03hello.txt\x00\xcbH\xcd\xc9\xc9W(\xcf/\xcaI\xe1\x02\x00-;\x08\xaf\x0c\x00\x00\x00\x1f\x8b\x08\x08\xc8X\x13J\x00\x03hello.txt\x00\xcbH\xcd\xc9\xc9W(\xcf/\xcaI\xe1\x02\x00-;\x08\xaf\x0c\x00\x00\x00"
  check(flate.gzip_decode(twice, 24) == Ok(b"hello world\nhello world\n"))
  check(flate.gzip_decode(twice, 23) == Error(TooLarge()))
  check(flate.gzip_decode(b"", 4096) == Error(Truncated()))
  // CPython gzip: dynamic Huffman codes.
  check(
    flate.gzip_decode(
      b"\x1f\x8b\x08\x00\x00\x00\x00\x00\x02\x035\x8d\xc1\x0d\x00A\x08\x02\xffVak\x03\xf6_\xc3\xe1\xee\xad&bp\x88\x88)@be+\xda\xff\xaa4\x0bt\x97\x9f_\xc8'1\x8f/\xe123\xb9\xb4\xae\xa9\xa5\xdaN,/\xd62wJ\x96?\x86\x95S5x\x00\x00\x00",
      120
    ) == Ok(
      b"abad\x0aaaabba\x0aaaaaaaa\x0aaa aaaaaaababaaad\x0aa  \x0ac\x0aaa aaaa\x0aabcaaabbdaaaaaa\x0aa\x0abac\x0acaddabc baaaaa\x0ababca ccc\x0aabadaaaacaaaaacabbcbc"
    )
  )
  Ok(())
}
