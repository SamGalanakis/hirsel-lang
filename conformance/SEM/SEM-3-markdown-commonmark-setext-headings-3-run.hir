// rule: SEM-3
// expect: run
// Published spec.txt vectors; tools/generate-markdown.py.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.check(
    s,
    "commonmark/Setext headings/89",
    "Foo  \n-----\n",
    "<h2>Foo</h2>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Setext headings/90",
    "Foo\\\n----\n",
    "<h2>Foo\\</h2>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Setext headings/91",
    "`Foo\n----\n`\n\n<a title=\"a lot\n---\nof dashes\"/>\n",
    "<h2>`Foo</h2>\n<p>`</p>\n<h2>&lt;a title=&quot;a lot</h2>\n<p>of dashes&quot;/&gt;</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Setext headings/92",
    "> Foo\n---\n",
    "<blockquote>\n<p>Foo</p>\n</blockquote>\n<hr />\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Setext headings/93",
    "> foo\nbar\n===\n",
    "<blockquote>\n<p>foo\nbar\n===</p>\n</blockquote>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Setext headings/94",
    "- Foo\n---\n",
    "<ul>\n<li>Foo</li>\n</ul>\n<hr />\n",
    std@1/markdown.default_options()
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
