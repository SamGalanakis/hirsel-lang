// tests/files-toml-1.0.0, group valid-inline-table.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.valid(
    s,
    "valid/inline-table/key-dotted-05",
    "arr-1 = [{a.b = 1}]\narr-2 = [\"str\", {a.b = 1}]\n\narr-3 = [{a.b = 1}, {a.b = 2}]\narr-4 = [\"str\", {a.b = 1}, {a.b = 2}]\n",
    "{\"arr-1\":[{\"a\":{\"b\":{\"type\":\"integer\",\"value\":\"1\"}}}],\"arr-2\":[{\"type\":\"string\",\"value\":\"str\"},{\"a\":{\"b\":{\"type\":\"integer\",\"value\":\"1\"}}}],\"arr-3\":[{\"a\":{\"b\":{\"type\":\"integer\",\"value\":\"1\"}}},{\"a\":{\"b\":{\"type\":\"integer\",\"value\":\"2\"}}}],\"arr-4\":[{\"type\":\"string\",\"value\":\"str\"},{\"a\":{\"b\":{\"type\":\"integer\",\"value\":\"1\"}}},{\"a\":{\"b\":{\"type\":\"integer\",\"value\":\"2\"}}}]}"
  )
  failed += harness.valid(
    s,
    "valid/inline-table/key-dotted-06",
    "top.dot.dot = [\n\t{dot.dot.dot = 1},\n\t{dot.dot.dot = 2},\n]\n",
    "{\"top\":{\"dot\":{\"dot\":[{\"dot\":{\"dot\":{\"dot\":{\"type\":\"integer\",\"value\":\"1\"}}}},{\"dot\":{\"dot\":{\"dot\":{\"type\":\"integer\",\"value\":\"2\"}}}}]}}}"
  )
  failed += harness.valid(
    s,
    "valid/inline-table/key-dotted-07",
    "arr = [\n\t{a.b = [{c.d = 1}]}\n]\n",
    "{\"arr\":[{\"a\":{\"b\":[{\"c\":{\"d\":{\"type\":\"integer\",\"value\":\"1\"}}}]}}]}"
  )
  failed += harness.valid(
    s,
    "valid/inline-table/multiline",
    "tbl_multiline = { a = 1, b = \"\"\"\nmultiline\n\"\"\", c = \"\"\"and yet\nanother line\"\"\", d = 4 }\n",
    "{\"tbl_multiline\":{\"a\":{\"type\":\"integer\",\"value\":\"1\"},\"b\":{\"type\":\"string\",\"value\":\"multiline\\n\"},\"c\":{\"type\":\"string\",\"value\":\"and yet\\nanother line\"},\"d\":{\"type\":\"integer\",\"value\":\"4\"}}}"
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
