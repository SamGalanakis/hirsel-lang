// rule: SEM-1
// expect: run
// Slim TZif files from Go's time testdata, whose tables stop where the POSIX
// footer takes over: Go TestLoadLocationFromTZDataSlim's Gaza and Dublin
// offsets, then the footer's gaps and folds, including Gaza's rule hours past
// 24 and Dublin's negative DST (offsets cross-checked against CPython zoneinfo).
pub fn main(t: Test) -> Result[(), ()] {
  check.ambiguity(
    t,
    test.expect_ok(t, time_zone.from_tzif(zones.GAZA_SLIM)),
    [
      ("2020-10-29T15:30:00", 0, 7200, 7200),
      ("2021-03-26T23:59:59", 0, 7200, 7200),
      ("2021-03-27T00:00:00", 1, 7200, 10800),
      ("2021-03-27T00:59:59", 1, 7200, 10800),
      ("2021-03-27T01:00:00", 0, 10800, 10800),
      ("2021-10-29T23:59:59", 0, 10800, 10800),
      ("2021-10-30T00:00:00", 2, 10800, 7200),
      ("2021-10-30T00:59:59", 2, 10800, 7200),
      ("2021-10-30T01:00:00", 0, 7200, 7200),
      ("2040-03-24T00:30:00", 1, 7200, 10800),
      ("2040-10-27T00:30:00", 2, 10800, 7200)
    ]
  )
  check.ambiguity(
    t,
    test.expect_ok(t, time_zone.from_tzif(zones.DUBLIN_SLIM)),
    [
      ("2021-04-02T11:12:13", 0, 3600, 3600),
      ("2021-03-28T00:59:59", 0, 0, 0),
      ("2021-03-28T01:00:00", 1, 0, 3600),
      ("2021-03-28T01:59:59", 1, 0, 3600),
      ("2021-03-28T02:00:00", 0, 3600, 3600),
      ("2021-10-31T00:59:59", 0, 3600, 3600),
      ("2021-10-31T01:00:00", 2, 3600, 0),
      ("2021-10-31T01:59:59", 2, 3600, 0),
      ("2021-10-31T02:00:00", 0, 0, 0)
    ]
  )
  Ok(())
}
