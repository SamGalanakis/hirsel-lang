// rule: SEM-1
// expect: run
// America/Sitka's 24-hour fold of 1867 and every Pacific/Honolulu transition,
// whose last begins a gap before the POSIX rule takes over (jiff test files).
pub fn main(t: Test) -> Result[(), ()] {
  let sitka = test.expect_ok(t, time_zone.from_tzif(zones.SITKA))
  check.ambiguity(
    t,
    sitka,
    [
      ("1969-12-31T16:00:00", 0, -28800, -28800),
      ("-009999-01-02T16:58:46", 0, 53927, 53927),
      ("1867-10-18T15:29:59", 0, 53927, 53927),
      ("1867-10-18T15:30:00", 2, 53927, -32473),
      ("1867-10-19T15:29:59.999999999", 2, 53927, -32473),
      ("1867-10-19T15:30:00", 0, -32473, -32473)
    ]
  )
  check.instants(
    t,
    sitka,
    [
      (0, -28800, "1969-12-31T16:00:00"),
      (-377705023201000000000, 53927, "-009999-01-02T16:58:46"),
      (-3225223728000000000, 53927, "1867-10-19T15:29:59"),
      (-3225223727000000000, -32473, "1867-10-18T15:30:00"),
      (-3225223726000000000, -32473, "1867-10-18T15:30:01")
    ]
  )
  let honolulu = test.expect_ok(t, time_zone.from_tzif(zones.HONOLULU))
  check.ambiguity(
    t,
    honolulu,
    [
      ("1896-01-13T11:59:59", 0, -37886, -37886),
      ("1896-01-13T12:00:00", 1, -37886, -37800),
      ("1896-01-13T12:01:25", 1, -37886, -37800),
      ("1896-01-13T12:01:26", 0, -37800, -37800),
      ("1933-04-30T01:59:59", 0, -37800, -37800),
      ("1933-04-30T02:00:00", 1, -37800, -34200),
      ("1933-04-30T02:59:59", 1, -37800, -34200),
      ("1933-04-30T03:00:00", 0, -34200, -34200),
      ("1933-05-21T10:59:59", 0, -34200, -34200),
      ("1933-05-21T11:00:00", 2, -34200, -37800),
      ("1933-05-21T11:59:59", 2, -34200, -37800),
      ("1933-05-21T12:00:00", 0, -37800, -37800),
      ("1942-02-09T01:59:59", 0, -37800, -37800),
      ("1942-02-09T02:00:00", 1, -37800, -34200),
      ("1942-02-09T02:59:59", 1, -37800, -34200),
      ("1942-02-09T03:00:00", 0, -34200, -34200),
      ("1945-08-14T13:29:59", 0, -34200, -34200),
      ("1945-08-14T13:30:00", 0, -34200, -34200),
      ("1945-08-14T13:30:01", 0, -34200, -34200),
      ("1945-09-30T00:59:59", 0, -34200, -34200),
      ("1945-09-30T01:00:00", 2, -34200, -37800),
      ("1945-09-30T01:59:59", 2, -34200, -37800),
      ("1945-09-30T02:00:00", 0, -37800, -37800),
      ("1947-06-08T01:59:59", 0, -37800, -37800),
      ("1947-06-08T02:00:00", 1, -37800, -36000),
      ("1947-06-08T02:29:59", 1, -37800, -36000),
      ("1947-06-08T02:30:00", 0, -36000, -36000)
    ]
  )
  check.instants(
    t,
    honolulu,
    [
      (-2334101315000000000, -37886, "1896-01-13T11:59:59"),
      (-2334101314000000000, -37800, "1896-01-13T12:01:26"),
      (-1157283001000000000, -37800, "1933-04-30T01:59:59"),
      (-1157283000000000000, -34200, "1933-04-30T03:00:00"),
      (-1155436201000000000, -34200, "1933-05-21T11:59:59"),
      (-1155436200000000000, -37800, "1933-05-21T11:00:00"),
      (-880198201000000000, -37800, "1942-02-09T01:59:59"),
      (-880198200000000000, -34200, "1942-02-09T03:00:00"),
      (-769395600000000000, -34200, "1945-08-14T13:30:00"),
      (-765376201000000000, -34200, "1945-09-30T01:59:59"),
      (-765376200000000000, -37800, "1945-09-30T01:00:00"),
      (-712150201000000000, -37800, "1947-06-08T01:59:59"),
      (-712150200000000000, -36000, "1947-06-08T02:30:00"),
      (-712150199000000000, -36000, "1947-06-08T02:30:01")
    ]
  )
  Ok(())
}
