// rule: SEM-3
// expect: run
// JSONTestSuite 1ef36fa01286573e846ac449e8683f8833c5b26a test_parsing/*.json:1.
// Differential reader twin of the existing imports; exact JsonError offsets.
fn check(t: Test, source: String) -> () {
  let expected: Result[(), json.JsonError] = match json.parse(unique source) {
    Ok(_) => Ok(()),
    Error(e) => Error(e),
  }
  let mut cursor = json.reader(string.as_bytes(source))
  let actual = match json.skip(mut cursor) {
    Ok(()) => json.finish_reader(mut cursor),
    Error(e) => Error(e),
  }
  test.equal(t, actual, expected)
}

pub fn main(t: Test) -> Result[(), ()] {
  // "y_number_negative_int.json:1"
  check(t, "[-123]")
  // "y_number_negative_one.json:1"
  check(t, "[-1]")
  // "y_number_negative_zero.json:1"
  check(t, "[-0]")
  // "y_number_real_capital_e.json:1"
  check(t, "[1E22]")
  // "y_number_real_capital_e_neg_exp.json:1"
  check(t, "[1E-2]")
  // "y_number_real_capital_e_pos_exp.json:1"
  check(t, "[1E+2]")
  // "y_number_real_exponent.json:1"
  check(t, "[123e45]")
  // "y_number_real_fraction_exponent.json:1"
  check(t, "[123.456e78]")
  Ok(())
}
