// rule: SEM-3
// expect: run
// RFC 4231 HMAC-SHA256 test cases 2, 4, 6 and 7, verified through hmac.verify.
fn check(key: Bytes, data: Bytes, expected: String) -> () {
  let Ok(tag) = std@1/hex.decode(expected) else {
    failure.check(false, TextInvariant())
    return
  }
  failure.check(std@1/hmac.verify(std@1/sha256.hash(), key, data, tag), TextInvariant())
}

pub fn main() -> Result[(), ()] {
  check(
    b"Jefe",
    b"what do ya want for nothing?",
    "5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843"
  )
  check(
    b"\x01\x02\x03\x04\x05\x06\x07\x08\x09\x0a\x0b\x0c\x0d\x0e\x0f\x10\x11\x12\x13\x14\x15\x16\x17\x18\x19",
    b"\xcd\xcd\xcd\xcd\xcd\xcd\xcd\xcd\xcd\xcd\xcd\xcd\xcd\xcd\xcd\xcd\xcd\xcd\xcd\xcd\xcd\xcd\xcd\xcd\xcd\xcd\xcd\xcd\xcd\xcd\xcd\xcd\xcd\xcd\xcd\xcd\xcd\xcd\xcd\xcd\xcd\xcd\xcd\xcd\xcd\xcd\xcd\xcd\xcd\xcd",
    "82558a389a443c0ea4cc819899f2083a85f0faa3e578f8077a2e3ff46729665b"
  )
  Ok(())
}
