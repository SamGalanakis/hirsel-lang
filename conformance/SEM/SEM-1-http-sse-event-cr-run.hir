// rule: SEM-1
// expect: run
pub fn main(t: Test) {
  match http.sse_event(Some("bad\rfield"), [], None(), None()) {
    Error(EventLineBreak()) => (),
    _ => test.check(t, false),
  }
  test.check(
    t,
    http.sse_event(Some("valid"), ["data"], Some("id"), None()) == Ok(
      b"event: valid\ndata: data\nid: id\n\n"
    )
  )
}
