// rule: SEM-1
// expect: run
// America/New_York from jiff's TZif test file: the 2024 spring gap and autumn
// fold under each disambiguation, and offsets at instants around both.
pub fn main(t: Test) -> Result[(), ()] {
  let zone = test.expect_ok(t, time_zone.from_tzif(zones.NEW_YORK))
  check.ambiguity(
    t,
    zone,
    [
      ("1969-12-31T19:00:00", 0, -18000, -18000),
      ("2024-03-10T01:59:59.999999999", 0, -18000, -18000),
      ("2024-03-10T02:00:00", 1, -18000, -14400),
      ("2024-03-10T02:59:59.999999999", 1, -18000, -14400),
      ("2024-03-10T03:00:00", 0, -14400, -14400),
      ("2024-11-03T00:59:59.999999999", 0, -14400, -14400),
      ("2024-11-03T01:00:00", 2, -14400, -18000),
      ("2024-11-03T01:59:59.999999999", 2, -14400, -18000),
      ("2024-11-03T02:00:00", 0, -18000, -18000)
    ]
  )
  check.instants(
    t,
    zone,
    [
      (0, -18000, "1969-12-31T19:00:00"),
      (1710052200000000000, -18000, "2024-03-10T01:30:00"),
      (1710053999999999999, -18000, "2024-03-10T01:59:59.999999999"),
      (1710054000000000000, -14400, "2024-03-10T03:00:00"),
      (1710055800000000000, -14400, "2024-03-10T03:30:00"),
      (1730610000000000000, -14400, "2024-11-03T01:00:00"),
      (1730611800000000000, -14400, "2024-11-03T01:30:00"),
      (1730613599999999999, -14400, "2024-11-03T01:59:59.999999999"),
      (1730613600000000000, -18000, "2024-11-03T01:00:00"),
      (1730615400000000000, -18000, "2024-11-03T01:30:00"),
      // Past the last transition (2007) the footer rule decides.
      (4102444800000000000, -18000, "2099-12-31T19:00:00"),
      (4087195200000000000, -14400, "2099-07-08T08:00:00"),
      // Before the first transition, type 0 (LMT, -4:56:02).
      (-2717650801000000000, -17762, "1883-11-18T12:03:57"),
      (-2717650800000000000, -18000, "1883-11-18T12:00:00")
    ]
  )
  // Beyond the date range the offset is the range end's, and no civil datetime exists.
  let far = time.Timestamp(unix_nanoseconds: -170141183460469231731687303715884105728)
  test.equal(t, time_zone.offset(zone, far), -17762)
  test.equal(t, time_zone.to_datetime(zone, far), Error(OutOfRange()))
  let later = time.Timestamp(unix_nanoseconds: 170141183460469231731687303715884105727)
  test.equal(t, time_zone.offset(zone, later), -18000)
  Ok(())
}
