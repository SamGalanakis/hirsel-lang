// rule: SEM-3
// expect: run
// Published spec.txt vectors; tools/generate-markdown.py.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.check(
    s,
    "commonmark/List items/272/malformed",
    "    indented code\n\npar\u{0}[&unterminated",
    "<pre><code>indented code\n</code></pre>\n<p>par�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/List items/273/malformed",
    "1.     indented code\n\n   p\u{0}[&unterminated",
    "<ol>\n<li>\n<pre><code>indented code\n</code></pre>\n<p>p�[&amp;unterminated</p>\n</li>\n</ol>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/List items/274/malformed",
    "1.      indented code\n\n   p\u{0}[&unterminated",
    "<ol>\n<li>\n<pre><code> indented code\n</code></pre>\n<p>p�[&amp;unterminated</p>\n</li>\n</ol>\n",
    std@1/markdown.default_options()
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
