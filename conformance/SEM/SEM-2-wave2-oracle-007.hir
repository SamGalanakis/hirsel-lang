// rule: SEM-2
// expect: run
// Rust std LowerExp supplies independent shortest digits and decimal parsing.
pub fn main(t: Test) -> Result[(), ()] {
  core@1/test.check(
    t,
    f64.to_string(core@1/f64.from_bits(4591870180066957722u64)) == "0.1"
  )
  match f64.parse("0.1") {
    Ok(value) => core@1/test.check(t, core@1/f64.bits(value) == 4591870180066957722u64),
    Error(_) => core@1/test.check(t, false),
  }
  Ok(())
}
