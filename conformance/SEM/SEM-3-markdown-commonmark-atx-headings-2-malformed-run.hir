// rule: SEM-3
// expect: run
// Published spec.txt vectors; tools/generate-markdown.py.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.check(
    s,
    "commonmark/ATX headings/67/malformed",
    "#                  foo\u{0}[&unterminated",
    "<h1>foo�[&amp;unterminated</h1>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/ATX headings/68/malformed",
    " ### foo\n  ##\u{0}[&unterminated",
    "<h3>foo</h3>\n<p>##�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/ATX headings/69/malformed",
    "    #\u{0}[&unterminated",
    "<pre><code>#�[&amp;unterminated\n</code></pre>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/ATX headings/70/malformed",
    "foo\n   \u{0}[&unterminated",
    "<p>foo\n�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/ATX headings/71/malformed",
    "## foo ##\n  ##\u{0}[&unterminated",
    "<h2>foo</h2>\n<p>##�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
