// rule: SEM-3
// expect: run
// Generated by tools/generate-toml-test.py from toml-test ff49d109861c
// tests/files-toml-1.0.0, group valid-inline-table.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.valid(
    s,
    "valid/inline-table/array-01",
    "arr = [ {'a'= 1}, {'a'= 2} ]\n\npeople = [{first_name = \"Bruce\", last_name = \"Springsteen\"},\n          {first_name = \"Eric\", last_name = \"Clapton\"},\n          {first_name = \"Bob\", last_name = \"Seger\"}]\n",
    "{\"arr\":[{\"a\":{\"type\":\"integer\",\"value\":\"1\"}},{\"a\":{\"type\":\"integer\",\"value\":\"2\"}}],\"people\":[{\"first_name\":{\"type\":\"string\",\"value\":\"Bruce\"},\"last_name\":{\"type\":\"string\",\"value\":\"Springsteen\"}},{\"first_name\":{\"type\":\"string\",\"value\":\"Eric\"},\"last_name\":{\"type\":\"string\",\"value\":\"Clapton\"}},{\"first_name\":{\"type\":\"string\",\"value\":\"Bob\"},\"last_name\":{\"type\":\"string\",\"value\":\"Seger\"}}]}"
  )
  failed += harness.valid(
    s,
    "valid/inline-table/array-02",
    "# \"No newlines are allowed between the curly braces unless they are valid within\n# a value\"\n\na = { a = [\n]}\n",
    "{\"a\":{\"a\":[]}}"
  )
  failed += harness.valid(
    s,
    "valid/inline-table/array-03",
    "b = { a = [\n\t\t1,\n\t\t2,\n\t], b = [\n\t\t3,\n\t\t4,\n\t]}\n",
    "{\"b\":{\"a\":[{\"type\":\"integer\",\"value\":\"1\"},{\"type\":\"integer\",\"value\":\"2\"}],\"b\":[{\"type\":\"integer\",\"value\":\"3\"},{\"type\":\"integer\",\"value\":\"4\"}]}}"
  )
  failed += harness.valid(
    s,
    "valid/inline-table/bool",
    "a = {a = true, b = false}\n",
    "{\"a\":{\"a\":{\"type\":\"bool\",\"value\":\"true\"},\"b\":{\"type\":\"bool\",\"value\":\"false\"}}}"
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
