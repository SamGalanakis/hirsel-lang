// expect: run
// Published spec.txt vectors; tools/generate-markdown.py.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.check(
    s,
    "commonmark/Entity and numeric character references/28/malformed",
    "&nbsp &x; &#; &#x;\n&#87654321;\n&#\u{0}[&unterminated",
    "<p>&amp;nbsp &amp;x; &amp;#; &amp;#x;\n&amp;#87654321;\n&amp;#�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Entity and numeric character references/29/malformed",
    "&co\u{0}[&unterminated",
    "<p>&amp;co�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Entity and numeric character references/30/malformed",
    "&MadeUp\u{0}[&unterminated",
    "<p>&amp;MadeUp�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Entity and numeric character references/31/malformed",
    "<a href=\"&ouml\u{0}[&unterminated",
    "<p>&lt;a href=&quot;&amp;ouml�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
