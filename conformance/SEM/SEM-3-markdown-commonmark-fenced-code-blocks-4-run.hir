// rule: SEM-3
// expect: run
// Published spec.txt vectors; tools/generate-markdown.py.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.check(
    s,
    "commonmark/Fenced code blocks/136",
    "   ```\naaa\n  ```\n",
    "<pre><code>aaa\n</code></pre>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Fenced code blocks/137",
    "```\naaa\n    ```\n",
    "<pre><code>aaa\n    ```\n</code></pre>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Fenced code blocks/138",
    "``` ```\naaa\n",
    "<p><code> </code>\naaa</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Fenced code blocks/139",
    "~~~~~~\naaa\n~~~ ~~\n",
    "<pre><code>aaa\n~~~ ~~\n</code></pre>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Fenced code blocks/140",
    "foo\n```\nbar\n```\nbaz\n",
    "<p>foo</p>\n<pre><code>bar\n</code></pre>\n<p>baz</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Fenced code blocks/141",
    "foo\n---\n~~~\nbar\n~~~\n# baz\n",
    "<h2>foo</h2>\n<pre><code>bar\n</code></pre>\n<h1>baz</h1>\n",
    std@1/markdown.default_options()
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
