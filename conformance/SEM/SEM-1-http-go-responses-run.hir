// rule: SEM-1
// expect: test
// Go ebe2feefc400 src/net/http/{response_test.go:39,readrequest_test.go:30}.
// Literal upstream tables, adapted to owned headers, raw request targets and
// scripted Net. See docs/http1-prior-art.md for representation/policy differences.
fn incoming(
  t: Test,
  raw: Bytes,
  method: http.Method,
  status: u16,
  reason: String,
  version: http.Version,
  length: Option[u64],
  chunked: bool,
  keep: bool,
  headers: List[http.Header],
  body: Bytes,
  trailers: List[http.Header]
) -> Result[(), http.HttpError] {
  let n = test.net(
    t,
    [
      NetPeer(
        address: "example.com",
        port: 80u16,
        resolves_to: [],
        tls: Plain(),
        connections: [Open([Send(unique raw), Close()])]
      )
    ],
    []
  )
  let mut request = http.request(
    n,
    http.default_config(),
    method,
    "http://example.com/",
    []
  )?
  http.send_bodiless(mut request)?
  let head = http.receive_head(mut request)?
  test.check(
    t,
    head.status == status && head.reason == reason && head.version == version
  )
  test.check(
    t,
    head.content_length == length && head.chunked == chunked && head.keep_alive == keep
  )
  test.check(t, head.headers == headers)
  test.check(t, http.read_all(mut request, 4096)? == body)
  test.check(t, http.trailers(request) == trailers)
  Ok(())
}

fn rejected(t: Test, raw: Bytes, expected: http.HttpError) -> Result[(), http.HttpError] {
  let n = test.net(
    t,
    [
      NetPeer(
        address: "example.com",
        port: 80u16,
        resolves_to: [],
        tls: Plain(),
        connections: [Open([Send(unique raw), Close()])]
      )
    ],
    []
  )
  let mut request = http.request(
    n,
    http.default_config(),
    Get(),
    "http://example.com/",
    []
  )?
  http.send_bodiless(mut request)?
  test.check(t, http.receive_head(mut request) == Error(expected))
  Ok(())
}

// response_test.go:41, respTests[0]: Unchunked response without Content-Length
@test
fn response_0(t: Test) -> Result[(), http.HttpError] {
  incoming(
    t,
    b"HTTP/1.0 200 OK\r\nConnection: close\r\n\r\nBody here\n",
    Get(),
    200,
    "OK",
    Http10(),
    None(),
    false,
    false,
    [http.Header(name: "Connection", value: "close")],
    b"Body here\n",
    []
  )
}

