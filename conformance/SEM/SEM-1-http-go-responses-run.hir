// response_test.go:680, respTests[21]: keep-alive timeout
@test
fn response_21(t: Test) -> Result[(), http.HttpError] {
  incoming(
    t,
    b"HTTP/1.1 200 OK\r\nContent-Encoding: gzip\r\nContent-Length: 23\r\nConnection: keep-alive\r\nKeep-Alive: timeout=7200\r\n\r\n\x1f\x8b\x08\x00\x00\x00\x00\x00\x00\x00s\xf3\xf7\x07\x00\xab'\xd4\x1a\x03\x00\x00\x00",
    Get(),
    200,
    "OK",
    Http11(),
    Some(23),
    false,
    true,
    [
      http.Header(name: "Content-Encoding", value: "gzip"),
      http.Header(name: "Content-Length", value: "23"),
      http.Header(name: "Connection", value: "keep-alive"),
      http.Header(name: "Keep-Alive", value: "timeout=7200")
    ],
    b"\x1f\x8b\x08\x00\x00\x00\x00\x00\x00\x00s\xf3\xf7\x07\x00\xab'\xd4\x1a\x03\x00\x00\x00",
    []
  )
}

// response_test.go:717, respTests[22]: Two spaces between HTTP version and status
@test
fn response_22(t: Test) -> Result[(), http.HttpError] {
  incoming(
    t,
    b"HTTP/1.0  401 Unauthorized\r\nContent-type: text/html\r\nWWW-Authenticate: Basic realm=\"\"\r\n\r\nYour Authentication failed.\r\n",
    Get(),
    401,
    "Unauthorized",
    Http10(),
    None(),
    false,
    false,
    [
      http.Header(name: "Content-type", value: "text/html"),
      http.Header(name: "WWW-Authenticate", value: "Basic realm=\"\"")
    ],
    b"Your Authentication failed.\r\n",
    []
  )
}

// HTTP/1.0 Transfer-Encoding also wins over an explicit keep-alive token.
@test
fn http10_transfer_encoding_closes(t: Test) -> Result[(), http.HttpError] {
  incoming(
    t,
    b"HTTP/1.0 200 OK\r\nTransfer-Encoding: chunked\r\nContent-Length: 2\r\nConnection: keep-alive\r\n\r\nok",
    Get(),
    200,
    "OK",
    Http10(),
    Some(2),
    false,
    false,
    [
      http.Header(name: "Transfer-Encoding", value: "chunked"),
      http.Header(name: "Content-Length", value: "2"),
      http.Header(name: "Connection", value: "keep-alive")
    ],
    b"ok",
    []
  )
}

// Skip only the head's extra status spaces; count the original wire bytes,
// including when the spaces and status arrive in different reads.
@test
fn status_spaces_fragmented(t: Test) -> Result[(), http.HttpError] {
  let raw: Bytes = b"HTTP/1.1   200 OK\r\nContent-Length: 2\r\n\r\nok"
  let head_size = bytes.len(raw) - 2
  for extra in 0u64..2u64 {
    let n = test.net(
      t,
      [
        NetPeer(
          address: "example.com",
          port: 80u16,
          resolves_to: [],
          tls: Plain(),
          connections: [
            Open(
              [
                Send(b"HTTP/1.1  "),
                Send(b" 200 OK\r\nContent-Length: 2\r\n\r\nok"),
                Close()
              ]
            )
          ]
        )
      ],
      []
    )
    let mut config = http.default_config()
    config.max_head_bytes = head_size - extra
    let mut r = http.request(n, config, Get(), "http://example.com/", [])?
    http.send_bodiless(mut r)?
    if extra == 0 {
      let head = http.receive_head(mut r)?
      test.check(
        t,
        head.status == 200 && head.keep_alive && head.content_length == Some(2)
      )
      test.check(t, http.read_all(mut r, 2)? == b"ok")
    } else {
      test.check(t, http.receive_head(mut r) == Error(HeadTooLarge()))
    }
  }
  Ok(())
}
