// rule: SEM-3
// expect: run
// Public fixed-format twins of Rust flt2dec exact rows; see the exact fixtures.
pub fn main(t: Test) -> Result[(), ()] {
  test.check(
    t,
    f"{core@1/f64.from_bits(4503599627370496u64):.345}" == "0."
  )
  test.check(
    t,
    f"{core@1/f64.from_bits(1u64):.361}" == "0."
  )
  Ok(())
}
