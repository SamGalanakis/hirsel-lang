// rule: SEM-3
// expect: run
// Go zip/reader_test.go:58-584 TestReader: time-infozip.zip.
pub fn main(t: Test) -> Result[(), ()] {
  let data = b"PK\x03\x04\x0a\x00\x00\x00\x00\x00}\xa9_K\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x08\x00\x1c\x00test.txtUT\x09\x00\x03\x8dI\xf9Y\x8dI\xf9Yux\x0b\x00\x01\x04\xe8\x03\x00\x00\x04\xe8\x03\x00\x00PK\x01\x02\x1e\x03\x0a\x00\x00\x00\x00\x00}\xa9_K\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x08\x00\x18\x00\x00\x00\x00\x00\x00\x00\x00\x00\xa4\x81\x00\x00\x00\x00test.txtUT\x05\x00\x03\x8dI\xf9Yux\x0b\x00\x01\x04\xe8\x03\x00\x00\x04\xe8\x03\x00\x00PK\x05\x06\x00\x00\x00\x00\x01\x00\x01\x00N\x00\x00\x00B\x00\x00\x00\x00\x00"
  let es = match zip.entries(data) {
    Ok(es) => es,
    Error(_) => return Error(()),
  }
  test.check(t, list.len(es) == 1)
  test.check(t, es[0].name == "test.txt" && es[0].size == 0)
  test.check(t, es[0].modified == Some(1509509517i64))
  test.check(t, zip.read(data, es[0], 4096) == Ok(b""))
  test.check(t, es[0].dos_time == 1264560509)
  Ok(())
}
