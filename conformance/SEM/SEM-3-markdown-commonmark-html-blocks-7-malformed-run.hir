// rule: SEM-3
// expect: run
// Published spec.txt vectors; tools/generate-markdown.py.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.check(
    s,
    "commonmark/HTML blocks/170/malformed",
    "<script type=\"text/javascript\">\n// JavaScript example\n\ndocument.get\u{0}[&unterminated",
    "<script type=\"text/javascript\">\n// JavaScript example\n\ndocument.get�[&unterminated\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/HTML blocks/171/malformed",
    "<textarea>\n\n*foo*\n\n\u{0}[&unterminated",
    "<textarea>\n\n*foo*\n\n�[&unterminated\n",
    std@1/markdown.default_options()
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
