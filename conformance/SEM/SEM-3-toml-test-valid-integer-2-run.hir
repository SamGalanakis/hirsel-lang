// rule: SEM-3
// expect: run
// Generated by tools/generate-toml-test.py from toml-test ff49d109861c
// tests/files-toml-1.1.0, group valid-integer.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.valid(
    s,
    "valid/integer/long",
    "# int64 \"should\" be supported, but is not mandatory. It's fine to skip this\n# test.\nint64-max     = 9223372036854775807\nint64-max-neg = -9223372036854775808\n",
    "{\"int64-max\":{\"type\":\"integer\",\"value\":\"9223372036854775807\"},\"int64-max-neg\":{\"type\":\"integer\",\"value\":\"-9223372036854775808\"}}"
  )
  failed += harness.valid(
    s,
    "valid/integer/underscore",
    "kilo = 1_000\nx = 1_1_1_1\n",
    "{\"kilo\":{\"type\":\"integer\",\"value\":\"1000\"},\"x\":{\"type\":\"integer\",\"value\":\"1111\"}}"
  )
  failed += harness.valid(
    s,
    "valid/integer/zero",
    "d1 = 0\nd2 = +0\nd3 = -0\n\nh1 = 0x0\nh2 = 0x00\nh3 = 0x00000\n\no1 = 0o0\na2 = 0o00\na3 = 0o00000\n\nb1 = 0b0\nb2 = 0b00\nb3 = 0b00000\n",
    "{\"a2\":{\"type\":\"integer\",\"value\":\"0\"},\"a3\":{\"type\":\"integer\",\"value\":\"0\"},\"b1\":{\"type\":\"integer\",\"value\":\"0\"},\"b2\":{\"type\":\"integer\",\"value\":\"0\"},\"b3\":{\"type\":\"integer\",\"value\":\"0\"},\"d1\":{\"type\":\"integer\",\"value\":\"0\"},\"d2\":{\"type\":\"integer\",\"value\":\"0\"},\"d3\":{\"type\":\"integer\",\"value\":\"0\"},\"h1\":{\"type\":\"integer\",\"value\":\"0\"},\"h2\":{\"type\":\"integer\",\"value\":\"0\"},\"h3\":{\"type\":\"integer\",\"value\":\"0\"},\"o1\":{\"type\":\"integer\",\"value\":\"0\"}}"
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
