// rule: SEM-1
// expect: run
pub fn main(t: Test) -> Result[(), ()] {
  core@1/test.check(t, std@1/u16.to_string(0u16) == "0")
  core@1/test.check(t, std@1/u16.parse("0") == Ok(0u16))
  let mut buffer1: Inline[u8, 1] = [99u8]
  core@1/test.check(t, std@1/u16.format(0u16, mut buffer1) == Ok(1u64))
  core@1/test.check(t, buffer1 == [48u8])
  core@1/test.check(t, std@1/u16.to_string(65535u16) == "65535")
  core@1/test.check(t, std@1/u16.parse("65535") == Ok(65535u16))
  let mut buffer2: Inline[u8, 5] = [99u8, 99u8, 99u8, 99u8, 99u8]
  core@1/test.check(t, std@1/u16.format(65535u16, mut buffer2) == Ok(5u64))
  core@1/test.check(t, buffer2 == [54u8, 53u8, 53u8, 51u8, 53u8])
  core@1/test.check(t, std@1/u16.to_string(0u16) == "0")
  core@1/test.check(t, std@1/u16.parse("0") == Ok(0u16))
  let mut buffer3: Inline[u8, 1] = [99u8]
  core@1/test.check(t, std@1/u16.format(0u16, mut buffer3) == Ok(1u64))
  core@1/test.check(t, buffer3 == [48u8])
  Ok(())
}
