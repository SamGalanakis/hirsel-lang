// rule: SEM-1
// expect: run
// jiff fff640d4 crates/jiff/src/tz/timezone.rs:3063-3200; the seven remaining Honolulu instant rows.
pub fn main(t: Test) -> Result[(), ()] {
  let zone = test.expect_ok(t, time_zone.from_tzif(zones.HONOLULU))
  check.instants(
    t,
    zone,
    [
      (-2334101313000000000, -37800, "1896-01-13T12:01:27"),
      (-1157282999000000000, -34200, "1933-04-30T03:00:01"),
      (-1155436199000000000, -37800, "1933-05-21T11:00:01"),
      (-880198199000000000, -34200, "1942-02-09T03:00:01"),
      (-769395601000000000, -34200, "1945-08-14T13:29:59"),
      (-769395599000000000, -34200, "1945-08-14T13:30:01"),
      (-765376199000000000, -37800, "1945-09-30T01:00:01")
    ]
  )
  Ok(())
}
