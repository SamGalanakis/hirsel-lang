  failed += harness.parses(s, "n_array_extra_comma.json:1", "[\"\",]", 1)
  failed += harness.parses(s, "n_array_incomplete.json:1", "[\"x\"", 1)
  failed += harness.parses(s, "n_array_incomplete_invalid_value.json:1", "[x", 1)
  failed += harness.parses(s, "n_array_inner_array_no_comma.json:1", "[3[4]]", 1)
