// rule: SEM-1
// expect: run
// RFC 9110 sections 9.3.2, 15.3.5, 15.4.5; hyper src/proto/h1/role.rs:524-545.
// Complete replies retain HEAD metadata and suppress 204/304 framing and payload.
fn http_net(error: NetError) -> http.HttpError uses {} {
  Net(error)
}

pub fn main(t: Test) -> Result[(), http.HttpError] {
  let addr = SocketAddr(ip: V4([127u8, 0u8, 0u8, 1u8]), port: 8080u16)
  let n = test.net(
    t,
    [],
    [
      NetListener(
        address: "127.0.0.1",
        port: addr.port,
        clients: [
          NetClient(
            from: addr,
            tls: Plain(),
            steps: [
              Send(
                b"GET / HTTP/1.1\r\n\r\nHEAD /head HTTP/1.1\r\n\r\nGET /cached HTTP/1.1\r\n\r\nGET /next HTTP/1.1\r\nConnection: close\r\n\r\n"
              ),
              Expect(b"HTTP/1.1 204 \r\nConnection: keep-alive\r\n\r\n"),
              Expect(
                b"HTTP/1.1 200 \r\nContent-Length: 5\r\nConnection: keep-alive\r\n\r\n"
              ),
              Expect(b"HTTP/1.1 304 \r\nConnection: keep-alive\r\n\r\n"),
              Expect(
                b"HTTP/1.1 200 \r\nContent-Length: 2\r\nConnection: close\r\n\r\nok"
              ),
              Close()
            ]
          )
        ]
      )
    ]
  )
  let mut listener = net.listen(n, addr) ? http_net
  let (stream, _) = net.accept(n, mut listener) ? http_net
  let mut c = http.server_connection(
    test.tasks(t),
    n,
    take stream,
    http.default_config()
  )
  let Some((current1, first)) = http.next_stream(mut c, None())? else {
    return Error(Closed())
  }
  let mut exchange1 = take current1
  test.check(t, first.method == "GET")
  http.respond(mut exchange1, 204u16, [], b"hello", false)?
  let Some((current_head, head)) = http.next_stream(mut c, None())? else {
    return Error(Closed())
  }
  let mut exchange_head = take current_head
  test.check(t, head.method == "HEAD" && head.target == "/head")
  http.respond(mut exchange_head, 200u16, [], b"hello", false)?
  let Some((cached, cached_request)) = http.next_stream(mut c, None())? else {
    return Error(Closed())
  }
  let mut cached_exchange = take cached
  test.check(t, cached_request.target == "/cached")
  http.respond(mut cached_exchange, 304u16, [], b"elided", false)?
  let Some((current2, next)) = http.next_stream(mut c, None())? else {
    return Error(Closed())
  }
  let mut exchange2 = take current2
  test.check(t, next.method == "GET" && next.target == "/next")
  http.respond(mut exchange2, 200u16, [], b"ok", false)?
  test.check(t, option.is_none(http.next_stream(mut c, None())?))
  Ok(())
}
