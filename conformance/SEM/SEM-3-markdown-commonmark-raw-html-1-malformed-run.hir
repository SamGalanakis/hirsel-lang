    s,
    "commonmark/Raw HTML/613/malformed",
    "<a><bab\u{0}[&unterminated",
    "<p><a>&lt;bab�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Raw HTML/614/malformed",
    "<a/><\u{0}[&unterminated",
    "<p><a/>&lt;�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Raw HTML/615/malformed",
    "<a  /><b2\nd\u{0}[&unterminated",
    "<p><a  />&lt;b2\nd�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Raw HTML/616/malformed",
    "<a foo=\"bar\" bam = 'baz <em>\"</e\u{0}[&unterminated",
    "<p>&lt;a foo=&quot;bar&quot; bam = 'baz <em>&quot;&lt;/e�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
