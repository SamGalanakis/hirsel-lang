// rule: SEM-3
// expect: run
// CPython Lib/test/test_shlex.py posix_data (testSplitPosix, with comments),
// the same rows without `#` through split, testJoinRoundtrip over data and
// posix_data, testQuote and testJoin (python/cpython 036d309c). Python raises
// ValueError where these return UnclosedQuote or TrailingEscape.
pub fn main(t: Test) -> Result[(), shlex.SplitError] {
  // testQuote.
  let safe = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789@%_-+=:,./"
  test.equal(t, shlex.quote(""), "''")
  test.equal(t, shlex.quote(safe), safe)
  test.equal(t, shlex.quote("test file name"), "'test file name'")
  let quoted: List[String] = ["\"", "`", "$", "\\", "!", "\u{e9}", "\u{e0}", "\u{df}"]
  for u in quoted {
    test.equal(t, shlex.quote(f"test{u}name"), f"'test{u}name'")
    test.equal(t, shlex.quote(f"test{u}'name'"), f"'test{u}'\"'\"'name'\"'\"''")
  }
  // testForceQuote without force.
  test.equal(t, shlex.quote("spam"), "spam")
  test.equal(t, shlex.quote("spam eggs"), "'spam eggs'")
  test.equal(t, shlex.quote("two's-complement"), "'two'\"'\"'s-complement'")
  // testJoin.
  test.equal(t, shlex.join(["a ", "b"]), "'a ' b")
  test.equal(t, shlex.join(["a", " b"]), "a ' b'")
  test.equal(t, shlex.join(["a", " ", "b"]), "a ' ' b")
  test.equal(t, shlex.join(["\"a", "b\""]), "'\"a' 'b\"'")
  test.equal(t, shlex.join([]), "")
  test.equal(t, shlex.join(["", "x"]), "'' x")
  // Errors carry the byte offset of the opening quote or the backslash.
  test.equal(t, shlex.split("a 'b"), Error(UnclosedQuote(2)))
  test.equal(t, shlex.split("\"abc"), Error(UnclosedQuote(0)))
  test.equal(t, shlex.split("x \"a\\\""), Error(UnclosedQuote(2)))
  test.equal(t, shlex.split("abc\\"), Error(TrailingEscape(3)))
  test.equal(t, shlex.split("\"abc\\"), Error(TrailingEscape(4)))
  test.equal(t, shlex.split_comments("a # 'unclosed\nb"), Ok(["a", "b"]))
  test.equal(t, shlex.split_comments("a '#' b#c\nd"), Ok(["a", "#", "b", "d"]))
  test.equal(
    t,
    shlex.split("\u{e9}\\\u{e9} '\u{1f411}'"),
    Ok(["\u{e9}\u{e9}", "\u{1f411}"])
  )
  test.equal(t, shlex.split(""), Ok([]))
  test.equal(t, shlex.split(" \t\r\n"), Ok([]))
  Ok(())
}
