// rule: SEM-1
// expect: run
// hyper b0733787 tests/server.rs:691-728,1072-1113: keep-alive/pipelining.
// httparse a0fa552e src/lib.rs request vectors; Hirsel scripted IO is deterministic.
fn network(error: NetError) -> http.HttpError uses {} {
  Net(error)
}

pub fn main(t: Test) -> Result[(), http.HttpError] {
  let n = test.net(
    t,
    [
      NetPeer(
        address: "example.com",
        port: 80u16,
        resolves_to: [],
        tls: Plain(),
        connections: [
          Open(
            [
              Send(
                b"POST /one?q=x HTTP/1.1\r\nHost: example.com\r\nX-Name: value\r\nContent-Length: 3\r\n\r\nabcHEAD /two HTTP/1.1\r\nHost: example.com\r\n\r\n"
              ),
              Expect(
                b"HTTP/1.1 201 \r\nContent-Length: 3\r\nConnection: keep-alive\r\n\r\nabc"
              ),
              Expect(
                b"HTTP/1.1 200 \r\nContent-Length: 4\r\nConnection: keep-alive\r\n\r\n"
              ),
              Send(
                b"GET /last HTTP/1.0\r\nHost: example.com\r\nConnection: close\r\n\r\n"
              ),
              Expect(
                b"HTTP/1.1 200 \r\nContent-Length: 4\r\nConnection: close\r\n\r\nlast"
              ),
              Close()
            ]
          )
        ]
      )
    ],
    []
  )
  let tasks = test.tasks(t)
  let socket = net.connect(n, "example.com", 80u16, Unbounded()) ? network
  let mut c = http.server_connection(tasks, n, take socket, http.default_config())
  test.check(
    t,
    http.serve_next(
      mut c,
      None(),
      fn(r: http.ServerRequestView) -> Result[http.ServerResponse, http.HttpError] {
        test.check(t, http.server_request_method(r) == "POST")
        test.check(t, http.server_request_target(r) == "/one?q=x")
        test.check(t, http.server_request_header(r, "x-name") == Some("value"))
        test.check(t, http.server_request_header(r, "missing") == None())
        let owned = http.server_request_owned(r)
        test.check(
          t,
          owned.body == b"abc" && owned.version == Http11() && owned.keep_alive
        )
        Ok(
          http.ServerResponse(
            status: 201u16,
            headers: [],
            body: unique owned.body,
            close: false
          )
        )
      }
    )?
  )
  test.check(
    t,
    http.serve_next(
      mut c,
      None(),
      fn(r: http.ServerRequestView) -> Result[http.ServerResponse, http.HttpError] {
        test.check(
          t,
          http.server_request_method(r) == "HEAD" && http.server_request_target(r) == "/two"
        )
        test.check(t, http.server_request_body(r) == b"")
        Ok(
          http.ServerResponse(status: 200u16, headers: [], body: b"head", close: false)
        )
      }
    )?
  )
  test.check(
    t,
    http.serve_next(
      mut c,
      None(),
      fn(r: http.ServerRequestView) -> Result[http.ServerResponse, http.HttpError] {
        test.check(
          t,
          http.server_request_version(r) == Http10() && http.server_request_target(r) == "/last"
        )
        Ok(
          http.ServerResponse(status: 200u16, headers: [], body: b"last", close: false)
        )
      }
    )?
  )
  test.check(
    t,
    !http.serve_next(
      mut c,
      None(),
      fn(r: http.ServerRequestView) -> Result[http.ServerResponse, http.HttpError] uses {} {
        Ok(http.ServerResponse(status: 500u16, headers: [], body: b"", close: true))
      }
    )?
  )
  Ok(())
}
