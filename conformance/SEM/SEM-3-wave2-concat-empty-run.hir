// rule: SEM-3
// expect: run
pub fn main(rt: Io, args: Args) -> Result[(), OutputError] {
  failure.check(std@1/string.concat("", "") == "", TextInvariant())
  failure.check(std@1/string.concat("", "é") == "é", TextInvariant())
  failure.check(std@1/string.concat("é", "") == "é", TextInvariant())
  Ok(())
}
