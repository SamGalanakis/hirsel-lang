    s,
    "n_number_real_with_invalid_utf8_after_e.json:1",
    b"\x5b\x31\x65\xe5\x5d"
  )
  failed += harness.parses(s, "n_number_real_without_fractional_part.json:1", "[1.]", 1)
  failure.check(failed == 0, TextInvariant())
