fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.parses(
    s,
    "n_number_minus_sign_with_trailing_garbage.json:1",
    "[-foo]",
    1
  )
  failed += harness.parses(s, "n_number_minus_space_1.json:1", "[- 1]", 1)
  failed += harness.parses(s, "n_number_neg_int_starting_with_zero.json:1", "[-012]", 1)
  failed += harness.parses(s, "n_number_neg_real_without_int_part.json:1", "[-.123]", 1)
  failed += harness.parses(s, "n_number_neg_with_garbage_at_end.json:1", "[-1x]", 1)
  failed += harness.parses(s, "n_number_real_garbage_after_e.json:1", "[1ea]", 1)
