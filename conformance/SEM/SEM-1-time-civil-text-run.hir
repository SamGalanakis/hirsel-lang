// rule: SEM-1
// expect: run
// ISO 8601 date-only, time-only and datetime text, including jiff's expanded
// six-digit signed years, and @format through f-strings.
fn day(t: Test, y: i32, m: u8, d: u8) -> time.Date {
  let Some(value) = date.new(y, m, d) else {
    test.fail(t)
  }
  value
}

fn clock(t: Test, h: u8, m: u8, s: u8, ns: u32) -> time.TimeOfDay {
  let Some(value) = time_of_day.new(h, m, s, ns) else {
    test.fail(t)
  }
  value
}

pub fn main(t: Test) -> Result[(), ()] {
  let dates: List[(String, i32, u8, u8)] = [
    ("2024-02-29", 2024, 2, 29),
    ("0000-01-01", 0, 1, 1),
    ("9999-12-31", 9999, 12, 31),
    ("-000001-03-01", -1, 3, 1),
    ("-009999-01-01", -9999, 1, 1),
    ("+010000-01-01", 0, 0, 0)
  ]
  for (text, y, m, d) in dates {
    if m == 0 {
      test.equal(t, date.parse(text), Error(OutOfRange()))
    } else {
      let value = day(t, y, m, d)
      test.equal(t, date.parse(text), Ok(value))
      test.equal(t, date.to_string(value), text)
    }
  }
  test.equal(t, date.parse("+002024-02-29"), Ok(day(t, 2024, 2, 29)))
  test.equal(t, date.to_string(day(t, 12, 3, 4)), "0012-03-04")
  let bad_dates: List[String] = [
    "",
    "2024-2-29",
    "2023-02-29",
    "2024-13-01",
    "2024-00-10",
    "2024-04-31",
    "24-01-01",
    "2024/01/01",
    "2024-01-01T",
    "-0001-01-01",
    "-000000-01-01",
    "2024-01-01 "
  ]
  for text in bad_dates {
    test.equal(t, date.parse(text), Error(Invalid()))
  }
  test.equal(t, time_of_day.parse("00:00"), Ok(time_of_day.midnight()))
  test.equal(
    t,
    time_of_day.parse("23:59:59.999999999"),
    Ok(clock(t, 23, 59, 59, 999999999))
  )
  test.equal(t, time_of_day.parse("12:30:05.5"), Ok(clock(t, 12, 30, 5, 500000000)))
  test.equal(t, time_of_day.to_string(clock(t, 12, 30, 5, 500000000)), "12:30:05.5")
  test.equal(t, time_of_day.to_string(clock(t, 7, 0, 0, 1)), "07:00:00.000000001")
  test.equal(t, time_of_day.to_string(time_of_day.midnight()), "00:00:00")
  let bad_times: List[String] = [
    "24:00:00",
    "23:60:00",
    "23:59:60",
    "1:00:00",
    "12:30:",
    "12:30:00.",
    "12:30.5",
    "12:30:00.1234567890",
    "12"
  ]
  for text in bad_times {
    test.equal(t, time_of_day.parse(text), Error(Invalid()))
  }
  test.equal(t, time_of_day.new(24, 0, 0, 0), None())
  test.equal(t, time_of_day.new(0, 0, 0, 1000000000), None())
  test.equal(t, time_of_day.compare(clock(t, 1, 0, 0, 1), clock(t, 1, 0, 0, 0)), 1)
  test.equal(
    t,
    time_of_day.compare(clock(t, 0, 59, 59, 999999999), clock(t, 1, 0, 0, 0)),
    -1
  )
  let moment = time.DateTime(
    date: day(t, 2024, 7, 14),
    time: clock(t, 17, 31, 59, 120000000)
  )
  test.equal(t, date_time.to_string(moment), "2024-07-14T17:31:59.12")
  test.equal(t, date_time.parse("2024-07-14t17:31:59.120"), Ok(moment))
  test.equal(t, date_time.parse("2024-07-14 17:31:59"), Error(Invalid()))
  test.equal(t, date_time.parse("2024-07-14T17:31:59Z"), Error(Invalid()))
  test.equal(t, date_time.parse("2024-07-14"), Error(Invalid()))
  test.equal(
    t,
    f"{day(t, -44, 3, 15)} {clock(t, 9, 5, 0, 0)} {moment}",
    "-000044-03-15 09:05:00 2024-07-14T17:31:59.12"
  )
  test.equal(t, f"[{day(t, 2024, 1, 2):>12}]", "[  2024-01-02]")
  Ok(())
}
