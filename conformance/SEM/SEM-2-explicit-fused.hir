// rule: SEM-2
// expect: run
// stdout: ok
// "IEEE binary32/64, round-to-nearest-even"; "No contraction or reassociation".
fn output_error[E](take e: E) -> () {}

pub fn main(rt: Io, args: Args) -> Result[(), ()] {
  let a: f32 = 4097.0
  let value = float.mul_add(a, a, -16785408.0)
  out.print(
    io.stdout(rt) ? grant_error,
    if value == 1.0 {
      "ok\n"
    } else {
      "bad\n"
    }
  ) ? output_error
  Ok(())
}

@noalloc
fn grant_error(refusal: GrantError) -> () uses {} {
  ()
}
