fn check(pattern: String, input: String, expected: Option[regex.Span]) -> Result[(), ()] {
  let re = match regex.compile(pattern, 10000) {
    Ok(re) => take re,
    Error(_) => return Error(()),
  }
  failure.check(regex.find(re, input, 100000) == Ok(expected), TextInvariant())
  Ok(())
}

pub fn main() -> Result[(), ()] {
  // src/regexp/testdata/re2-search.txt:403
  check("(?:aa)$", "aA", None())?
  // src/regexp/testdata/re2-search.txt:409
  check("a", "", None())?
  // src/regexp/testdata/re2-search.txt:410
  check("a", "Aa", Some(regex.Span(start: 1, end: 2)))?
  // src/regexp/testdata/re2-search.txt:412
  check("^(?:a)$", "", None())?
  // src/regexp/testdata/re2-search.txt:413
  check("^(?:a)$", "Aa", None())?
  // src/regexp/testdata/re2-search.txt:415
  check("^(?:a)", "", None())?
  // src/regexp/testdata/re2-search.txt:416
  check("^(?:a)", "Aa", None())?
  // src/regexp/testdata/re2-search.txt:418
  check("(?:a)$", "", None())?
  // src/regexp/testdata/re2-search.txt:419
  check("(?:a)$", "Aa", Some(regex.Span(start: 1, end: 2)))?
  // src/regexp/testdata/re2-search.txt:425
  check("a", "", None())?
  // src/regexp/testdata/re2-search.txt:426
  check("a", "A", None())?
  // src/regexp/testdata/re2-search.txt:428
  check("^(?:a)$", "", None())?
  // src/regexp/testdata/re2-search.txt:429
  check("^(?:a)$", "A", None())?
  // src/regexp/testdata/re2-search.txt:431
  check("^(?:a)", "", None())?
  // src/regexp/testdata/re2-search.txt:432
  check("^(?:a)", "A", None())?
  // src/regexp/testdata/re2-search.txt:434
  check("(?:a)$", "", None())?
  // src/regexp/testdata/re2-search.txt:435
  check("(?:a)$", "A", None())?
  // src/regexp/testdata/re2-search.txt:441
  check("ABC", "", None())?
  // src/regexp/testdata/re2-search.txt:442
  check("ABC", "abc", None())?
  // src/regexp/testdata/re2-search.txt:444
  check("^(?:ABC)$", "", None())?
  Ok(())
}
