// rule: SEM-2
// expect: run
// f64.from_f32 widens exactly and f32.from_f64 rounds to nearest, ties to even:
// signed zeros, infinities, the NaN, f32 extremes and subnormals, halfway
// cases at 1, at MAX (rounding to MAX or infinity) and at the smallest
// subnormal. Expected bits are Rust's `as` conversions; NaN is the one NaN.
pub fn main(t: Test) -> Result[(), ()] {
  let widen_cases: Array[(u32, u64)] = [
    (0x0u32, 0x0u64),
    (0x80000000u32, 0x8000000000000000u64),
    (0x3f800000u32, 0x3ff0000000000000u64),
    (0xbf800000u32, 0xbff0000000000000u64),
    (0x3dcccccdu32, 0x3fb99999a0000000u64),
    (0x3eaaaaabu32, 0x3fd5555560000000u64),
    (0x7f7fffffu32, 0x47efffffe0000000u64),
    (0xff7fffffu32, 0xc7efffffe0000000u64),
    (0x800000u32, 0x3810000000000000u64),
    (0x1u32, 0x36a0000000000000u64),
    (0x80000001u32, 0xb6a0000000000000u64),
    (0x7fffffu32, 0x380fffffc0000000u64),
    (0x4b800000u32, 0x4170000000000000u64),
    (0x7f800000u32, 0x7ff0000000000000u64),
    (0xff800000u32, 0xfff0000000000000u64),
    (0x7fc00000u32, 0x7ff8000000000000u64)
  ]
  for widen_case in widen_cases {
    let (x, want) = widen_case
    failure.check(f64.bits(f64.from_f32(f32.from_bits(x))) == want, Bounds())
  }
  let narrow_cases: Array[(u64, u32)] = [
    (0x0u64, 0x0u32),
    (0x8000000000000000u64, 0x80000000u32),
    (0x3ff0000000000000u64, 0x3f800000u32),
    (0xbff0000000000000u64, 0xbf800000u32),
    (0x3fb999999999999au64, 0x3dcccccdu32),
    (0x3fd5555555555555u64, 0x3eaaaaabu32),
    (0x7e37e43c8800759cu64, 0x7f800000u32),
    (0xfe37e43c8800759cu64, 0xff800000u32),
    (0x1a56e1fc2f8f359u64, 0x0u32),
    (0x81a56e1fc2f8f359u64, 0x80000000u32),
    (0x7ff0000000000000u64, 0x7f800000u32),
    (0xfff0000000000000u64, 0xff800000u32),
    (0x7ff8000000000000u64, 0x7fc00000u32),
    (0x3ff0000010000000u64, 0x3f800000u32),
    (0x3ff0000030000000u64, 0x3f800002u32),
    (0x3ff0000010000001u64, 0x3f800001u32),
    (0x47effffff0000000u64, 0x7f800000u32),
    (0x47efffffefffffffu64, 0x7f7fffffu32),
    (0x3690000000000000u64, 0x0u32),
    (0x3690000000000004u64, 0x1u32),
    (0x36a8000000000000u64, 0x2u32),
    (0x36a0000000000000u64, 0x1u32),
    (0x380fffffbb1dd6a1u64, 0x7fffffu32),
    (0x3810000000000000u64, 0x800000u32),
    (0xb690000000000000u64, 0x80000000u32)
  ]
  for narrow_case in narrow_cases {
    let (x, want) = narrow_case
    failure.check(f32.bits(f32.from_f64(f64.from_bits(x))) == want, Bounds())
  }
  Ok(())
}
