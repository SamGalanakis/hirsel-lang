// rule: SEM-3
// expect: fail SEM-3 at line 195
// A 33-byte BLAKE2s key exceeds the limit and fails in new_keyed.
pub fn main() -> Result[(), ()] {
  let mut key: List[u8] = []
  while list.len(key) < 33 {
    list.push(mut key, 7)
  }
  let state = std@1/blake2s.new_keyed(bytes.from_list(take key))
  failure.check(
    std@1/hex.encode(std@1/bytes.from_inline(std@1/blake2s.finish(take state))) == "d0e5209ac463a0b2c17e279379a71220496ae04f1e9f0c9d6241b82e84e145b0",
    TextInvariant()
  )
  Ok(())
}
