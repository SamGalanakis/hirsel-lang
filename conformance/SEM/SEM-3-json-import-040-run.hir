  failed += harness.parses(s, "y_structure_true_in_array.json:1", "[true]", 0)
  failed += harness.parses(s, "y_structure_whitespace_array.json:1", " [] ", 0)
  failure.check(failed == 0, TextInvariant())
  Ok(())
