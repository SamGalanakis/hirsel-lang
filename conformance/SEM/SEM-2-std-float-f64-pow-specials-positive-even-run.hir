    (0x7fefffffffffffffu64, 0xc018000000000000u64, 0x0u64),
    (0x7fefffffffffffffu64, 0xc000000000000000u64, 0x0u64),
    (0x7fefffffffffffffu64, 0x4000000000000000u64, 0x7ff0000000000000u64),
    (0x7fefffffffffffffu64, 0x4018000000000000u64, 0x7ff0000000000000u64),
    (0x7fefffffffffffffu64, 0x4020000000000000u64, 0x7ff0000000000000u64),
    (0x7fefffffffffffffu64, 0x4024000000000000u64, 0x7ff0000000000000u64),
    (0x7fefffffffffffffu64, 0x4036000000000000u64, 0x7ff0000000000000u64),
    (0x7fefffffffffffffu64, 0x4059000000000000u64, 0x7ff0000000000000u64),
    (0x7fefffffffffffffu64, 0x7fefffffffffffffu64, 0x7ff0000000000000u64),
    (0x7fefffffffffffffu64, 0xc01c000000000000u64, 0x0u64),
    (0x7fefffffffffffffu64, 0xc008000000000000u64, 0x0u64),
    (0x7fefffffffffffffu64, 0x4008000000000000u64, 0x7ff0000000000000u64),
    (0x7fefffffffffffffu64, 0x401c000000000000u64, 0x7ff0000000000000u64),
    (0x7fefffffffffffffu64, 0xfff0000000000000u64, 0x0u64),
    (0x7fefffffffffffffu64, 0x7ff0000000000000u64, 0x7ff0000000000000u64),
    (0x7fefffffffffffffu64, 0xbff0000000000000u64, 0x4000000000000u64),
    (0x7fefffffffffffffu64, 0x3ff0000000000000u64, 0x7fefffffffffffffu64)
  ]
  for pow_case in pow_cases {
    let (x, y, want) = pow_case
    failure.check(
      core@1/f64.bits(f64.pow(core@1/f64.from_bits(x), core@1/f64.from_bits(y))) == want,
      Bounds()
    )
  }
  Ok(())
}
