// rule: SEM-3
// expect: run
// Published spec.txt vectors; tools/generate-markdown.py.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.check(
    s,
    "commonmark/Emphasis and strong emphasis/356",
    "5*6*78\n",
    "<p>5<em>6</em>78</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Emphasis and strong emphasis/357",
    "_foo bar_\n",
    "<p><em>foo bar</em></p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Emphasis and strong emphasis/358",
    "_ foo bar_\n",
    "<p>_ foo bar_</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Emphasis and strong emphasis/359",
    "a_\"foo\"_\n",
    "<p>a_&quot;foo&quot;_</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Emphasis and strong emphasis/360",
    "foo_bar_\n",
    "<p>foo_bar_</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Emphasis and strong emphasis/361",
    "5_6_78\n",
    "<p>5_6_78</p>\n",
    std@1/markdown.default_options()
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
