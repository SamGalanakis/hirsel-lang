fn check(pattern: String, input: String, expected: Option[regex.Span]) -> Result[(), ()] {
  let re = match regex.compile(pattern, 10000) {
    Ok(re) => take re,
    Error(_) => return Error(()),
  }
  failure.check(regex.find(re, input, 100000) == Ok(expected), TextInvariant())
  Ok(())
}

pub fn main() -> Result[(), ()] {
  // src/regexp/testdata/re2-search.txt:1625
  check("\\B", "", Some(regex.Span(start: 0, end: 0)))?
  // src/regexp/testdata/re2-search.txt:1626
  check("\\B", "x", None())?
  // src/regexp/testdata/re2-search.txt:1628
  check("^(?:\\B)$", "", Some(regex.Span(start: 0, end: 0)))?
  // src/regexp/testdata/re2-search.txt:1629
  check("^(?:\\B)$", "x", None())?
  // src/regexp/testdata/re2-search.txt:1631
  check("^(?:\\B)", "", Some(regex.Span(start: 0, end: 0)))?
  // src/regexp/testdata/re2-search.txt:1632
  check("^(?:\\B)", "x", None())?
  // src/regexp/testdata/re2-search.txt:1634
  check("(?:\\B)$", "", Some(regex.Span(start: 0, end: 0)))?
  // src/regexp/testdata/re2-search.txt:1635
  check("(?:\\B)$", "x", None())?
  // src/regexp/testdata/re2-search.txt:1641
  check("\\B(foo|bar|[A-Z])", "", None())?
  // src/regexp/testdata/re2-search.txt:1642
  check("\\B(foo|bar|[A-Z])", "foo", None())?
  // src/regexp/testdata/re2-search.txt:1644
  check("^(?:\\B(foo|bar|[A-Z]))$", "", None())?
  // src/regexp/testdata/re2-search.txt:1645
  check("^(?:\\B(foo|bar|[A-Z]))$", "foo", None())?
  // src/regexp/testdata/re2-search.txt:1647
  check("^(?:\\B(foo|bar|[A-Z]))", "", None())?
  // src/regexp/testdata/re2-search.txt:1648
  check("^(?:\\B(foo|bar|[A-Z]))", "foo", None())?
  // src/regexp/testdata/re2-search.txt:1650
  check("(?:\\B(foo|bar|[A-Z]))$", "", None())?
  // src/regexp/testdata/re2-search.txt:1651
