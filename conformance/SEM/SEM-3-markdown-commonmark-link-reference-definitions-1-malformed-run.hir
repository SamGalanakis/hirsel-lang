// rule: SEM-3
// expect: run
// Published spec.txt vectors; tools/generate-markdown.py.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.check(
    s,
    "commonmark/Link reference definitions/192/malformed",
    "[foo]: /url \"\u{0}[&unterminated",
    "<p>[foo]: /url &quot;�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Link reference definitions/193/malformed",
    "   [foo]: \n      /url  \n    \u{0}[&unterminated",
    "<p>�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Link reference definitions/194/malformed",
    "[Foo*bar\\]]:my_(url) 'title \u{0}[&unterminated",
    "<p>[Foo*bar]]:my_(url) 'title �[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
