// rule: SEM-3
// expect: run
// JSONTestSuite 1ef36fa01286573e846ac449e8683f8833c5b26a test_parsing/*.json:1.
// Differential reader twin of the existing imports; exact JsonError offsets.
fn check(t: Test, source: String) -> () {
  let expected: Result[(), json.JsonError] = match json.parse(unique source) {
    Ok(_) => Ok(()),
    Error(e) => Error(e),
  }
  let mut cursor = json.reader(string.as_bytes(source))
  let actual = match json.skip(mut cursor) {
    Ok(()) => json.finish_reader(mut cursor),
    Error(e) => Error(e),
  }
  test.equal(t, actual, expected)
}

pub fn main(t: Test) -> Result[(), ()] {
  // "n_structure_ascii-unicode-identifier.json:1"
  check(t, "aå")
  // "n_structure_capitalized_True.json:1"
  check(t, "[True]")
  // "n_structure_close_unopened_array.json:1"
  check(t, "1]")
  // "n_structure_comma_instead_of_closing_brace.json:1"
  check(t, "{\"x\": true,")
  // "n_structure_double_array.json:1"
  check(t, "[][]")
  // "n_structure_end_array.json:1"
  check(t, "]")
  // "n_structure_lone-open-bracket.json:1"
  check(t, "[")
  // "n_structure_no_data.json:1"
  check(t, "")
  Ok(())
}
