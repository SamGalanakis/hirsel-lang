// rule: SEM-3
// expect: run
// One update over a run of 0xff one byte longer than the 5552-byte reduction
// window, so a single reduction crosses it. The expected value is zlib.adler32.
fn check(data: Bytes, expected: u32) -> () {
  let mut state = std@1/adler32.new()
  std@1/adler32.update(mut state, data)
  failure.check(std@1/adler32.finish(take state) == expected, TextInvariant())
}

pub fn main() -> Result[(), ()] {
  let mut run: List[u8] = []
  while list.len(run) < 5553 {
    list.push(mut run, 255)
  }
  let ones = bytes.from_list(take run)
  check(ones, 0x8e299c8bu32)
  Ok(())
}
