// rule: SEM-3
// expect: run
// Published spec.txt vectors; tools/generate-markdown.py.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.check(
    s,
    "commonmark/Block quotes/239/malformed",
    ">\u{0}[&unterminated",
    "<blockquote>\n<p>�[&amp;unterminated</p>\n</blockquote>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Block quotes/240/malformed",
    ">\n> \u{0}[&unterminated",
    "<blockquote>\n<p>�[&amp;unterminated</p>\n</blockquote>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Block quotes/241/malformed",
    ">\n> fo\u{0}[&unterminated",
    "<blockquote>\n<p>fo�[&amp;unterminated</p>\n</blockquote>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Block quotes/242/malformed",
    "> foo\n\u{0}[&unterminated",
    "<blockquote>\n<p>foo\n�[&amp;unterminated</p>\n</blockquote>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Block quotes/243/malformed",
    "> foo\n\u{0}[&unterminated",
    "<blockquote>\n<p>foo\n�[&amp;unterminated</p>\n</blockquote>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Block quotes/244/malformed",
    "> foo\n>\u{0}[&unterminated",
    "<blockquote>\n<p>foo\n�[&amp;unterminated</p>\n</blockquote>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Block quotes/245/malformed",
    "foo\n>\u{0}[&unterminated",
    "<p>foo</p>\n<blockquote>\n<p>�[&amp;unterminated</p>\n</blockquote>\n",
    std@1/markdown.default_options()
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
