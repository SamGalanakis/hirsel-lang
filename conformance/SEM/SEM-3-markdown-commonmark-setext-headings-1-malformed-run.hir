// rule: SEM-3
// expect: run
// Published spec.txt vectors; tools/generate-markdown.py.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.check(
    s,
    "commonmark/Setext headings/80/malformed",
    "Foo *bar*\n=========\n\u{0}[&unterminated",
    "<h1>Foo <em>bar</em></h1>\n<p>�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Setext headings/81/malformed",
    "Foo *bar\n\u{0}[&unterminated",
    "<p>Foo *bar\n�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Setext headings/82/malformed",
    "  Foo *bar\n\u{0}[&unterminated",
    "<p>Foo *bar\n�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Setext headings/83/malformed",
    "Foo\n--------------\u{0}[&unterminated",
    "<p>Foo\n--------------�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
