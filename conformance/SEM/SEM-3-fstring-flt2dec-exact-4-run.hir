// rule: SEM-3
// expect: run
// Rust coretests/tests/num/flt2dec/mod.rs, f6c1107f8be13e48465e12c0fd26e6a39fe18e4f.
// MIT; third-party/NOTICES.md. Original check_exact/check_exact_one row lines below.
// The rounded value in units of 10^cutoff, digit by digit against `expected`.
fn same_digits(d: std@1/internal.decimal_seq.DecimalSeq, expected: String, cutoff: i32) -> bool {
  let point: i64 = core@1/int.widen(d.decimal_point)
  let limit: i64 = core@1/int.widen(cutoff)
  let text = core@1/string.as_bytes(expected)
  let length = core@1/bytes.len(text)
  if point - limit <= 0 {
    return length == 1 && text[0] == 48
  }
  let count: u64 = core@1/int.narrow(point - limit)
  if count != length {
    return false
  }
  let mut i: u64 = 0
  while i < count {
    let digit: u8 = if i < d.num_digits {
      d.digits[i]
    } else {
      0
    }
    if text[i] != digit + 48 {
      return false
    }
    i += 1
  }
  true
}

fn exact(t: Test, mantissa: u64, exponent: i32, expected: String, cutoff: i32) -> () {
  let limit: i64 = core@1/int.widen(cutoff)
  let mut d = std@1/internal.decimal_seq.exact(mantissa, exponent, -limit)
  let point: i64 = core@1/int.widen(d.decimal_point)
  std@1/internal.format.round_decimal(mut d, point - limit)
  test.check(t, same_digits(d, expected, cutoff))
}

pub fn main(t: Test) -> Result[(), ()] {
  // mod.rs:462: 0.5f64; digits=1, decimal exponent=0.
  exact(t, 1u64, -1i32, "5", -1i32)
  // mod.rs:463: 0.95f64; digits=38, decimal exponent=0.
  exact(
    t,
    4278419646001971u64,
    -52i32,
    "94999999999999995559107901499373838305",
    -38i32
  )
  // mod.rs:464: 100.0f64; digits=1, decimal exponent=3.
  exact(t, 25u64, 2i32, "1", 2i32)
  // mod.rs:465: 999.5f64; digits=38, decimal exponent=3.
  exact(t, 1999u64, -1i32, "99950000000000000000000000000000000000", -35i32)
  // mod.rs:466: 1.0f64/3.0; digits=38, decimal exponent=0.
  exact(
    t,
    6004799503160661u64,
    -54i32,
    "33333333333333331482961625624739099294",
    -38i32
  )
  // mod.rs:467: 3.141592f64; digits=38, decimal exponent=1.
  exact(
    t,
    3537118140137533u64,
    -50i32,
    "31415920000000001621742740098852664232",
    -37i32
  )
  // mod.rs:468: 3.141592e17f64; digits=7, decimal exponent=18.
  exact(t, 19174755859375u64, 14i32, "3141592", 11i32)
  // mod.rs:469: 1.0e23f64; digits=23, decimal exponent=23.
  exact(t, 2980232238769531u64, 25i32, "99999999999999991611392", 0i32)
  // mod.rs:470: f64::MAX; digits=38, decimal exponent=309.
  exact(
    t,
    9007199254740991u64,
    971i32,
    "17976931348623157081452742373170435680",
    271i32
  )
  // mod.rs:471: f64::MIN_POSITIVE; digits=38, decimal exponent=-307.
  exact(t, 1u64, -1022i32, "22250738585072013830902327173324040642", -345i32)
  // mod.rs:472: minf64; digits=38, decimal exponent=-323.
  exact(t, 1u64, -1074i32, "49406564584124654417656879286822137237", -361i32)
  // mod.rs:493: 8511030020275656p-342f64; digits=1, decimal exponent=-87.
  exact(t, 8511030020275656u64, -342i32, "9", -88i32)
  // mod.rs:494: 5201988407066741p-824f64; digits=2, decimal exponent=-232.
  exact(t, 5201988407066741u64, -824i32, "46", -234i32)
  // mod.rs:495: 6406892948269899p237f64; digits=3, decimal exponent=88.
  exact(t, 6406892948269899u64, 237i32, "141", 85i32)
  Ok(())
}
