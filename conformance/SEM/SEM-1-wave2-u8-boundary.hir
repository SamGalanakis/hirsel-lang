// rule: SEM-1
// expect: run
pub fn main(t: Test) -> Result[(), ()] {
  core@1/test.check(t, u8.to_string(0u8) == "0")
  core@1/test.check(t, u8.parse("0") == Ok(0u8))
  let mut buffer1: Inline[u8, 1] = [99u8]
  core@1/test.check(t, u8.format(0u8, mut buffer1) == Ok(1u64))
  core@1/test.check(t, buffer1 == [48u8])
  core@1/test.check(t, u8.to_string(255u8) == "255")
  core@1/test.check(t, u8.parse("255") == Ok(255u8))
  let mut buffer2: Inline[u8, 3] = [99u8, 99u8, 99u8]
  core@1/test.check(t, u8.format(255u8, mut buffer2) == Ok(3u64))
  core@1/test.check(t, buffer2 == [50u8, 53u8, 53u8])
  core@1/test.check(t, u8.to_string(0u8) == "0")
  core@1/test.check(t, u8.parse("0") == Ok(0u8))
  let mut buffer3: Inline[u8, 1] = [99u8]
  core@1/test.check(t, u8.format(0u8, mut buffer3) == Ok(1u64))
  core@1/test.check(t, buffer3 == [48u8])
  Ok(())
}
