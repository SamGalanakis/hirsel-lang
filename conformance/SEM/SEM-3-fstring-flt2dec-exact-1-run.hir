// rule: SEM-3
// expect: run
// Rust coretests/tests/num/flt2dec/mod.rs, f6c1107f8be13e48465e12c0fd26e6a39fe18e4f.
// MIT; third-party/NOTICES.md. Original check_exact/check_exact_one row lines below.
// The rounded value in units of 10^cutoff, digit by digit against `expected`.
fn same_digits(d: std@1/internal.decimal_seq.DecimalSeq, expected: String, cutoff: i32) -> bool {
  let point: i64 = core@1/int.widen(d.decimal_point)
  let limit: i64 = core@1/int.widen(cutoff)
  let text = core@1/string.as_bytes(expected)
  let length = core@1/bytes.len(text)
  if point - limit <= 0 {
    return length == 1 && text[0] == 48
  }
  let count: u64 = core@1/int.narrow(point - limit)
  if count != length {
    return false
  }
  let mut i: u64 = 0
  while i < count {
    let digit: u8 = if i < d.num_digits {
      d.digits[i]
    } else {
      0
    }
    if text[i] != digit + 48 {
      return false
    }
    i += 1
  }
  true
}

fn exact(t: Test, mantissa: u64, exponent: i32, expected: String, cutoff: i32) -> () {
  let limit: i64 = core@1/int.widen(cutoff)
  let mut d = std@1/internal.decimal_seq.exact(mantissa, exponent, -limit)
  let point: i64 = core@1/int.widen(d.decimal_point)
  std@1/internal.format.round_decimal(mut d, point - limit)
  test.check(t, same_digits(d, expected, cutoff))
}

pub fn main(t: Test) -> Result[(), ()] {
  // mod.rs:283: 0.1f16; digits=12, decimal exponent=-1.
  exact(t, 819u64, -13i32, "999755859375", -13i32)
  // mod.rs:284: 0.5f16; digits=1, decimal exponent=0.
  exact(t, 1u64, -1i32, "5", -1i32)
  // mod.rs:285: 1.0f16/3.0; digits=12, decimal exponent=0.
  exact(t, 1365u64, -12i32, "333251953125", -12i32)
  // mod.rs:286: 3.141f16; digits=7, decimal exponent=1.
  exact(t, 201u64, -6i32, "3140625", -6i32)
  // mod.rs:287: 3.141e4f16; digits=5, decimal exponent=5.
  exact(t, 1963u64, 4i32, "31408", 0i32)
  // mod.rs:288: f16::MAX; digits=5, decimal exponent=5.
  exact(t, 2047u64, 5i32, "65504", 0i32)
  // mod.rs:289: f16::MIN_POSITIVE; digits=10, decimal exponent=-4.
  exact(t, 1u64, -14i32, "6103515625", -14i32)
  // mod.rs:290: minf16; digits=15, decimal exponent=-7.
  exact(t, 1u64, -24i32, "596046447753906", -22i32)
  // mod.rs:350: 0.1f32; digits=27, decimal exponent=0.
  exact(t, 13421773u64, -27i32, "100000001490116119384765625", -27i32)
  // mod.rs:351: 0.5f32; digits=1, decimal exponent=0.
  exact(t, 1u64, -1i32, "5", -1i32)
  // mod.rs:352: 1.0f32/3.0; digits=25, decimal exponent=0.
  exact(t, 11184811u64, -25i32, "3333333432674407958984375", -25i32)
  // mod.rs:353: 3.141592f32; digits=20, decimal exponent=1.
  exact(t, 1647099u64, -19i32, "31415920257568359375", -19i32)
  // mod.rs:354: 3.141592e17f32; digits=18, decimal exponent=18.
  exact(t, 2285809u64, 37i32, "314159196796878848", 0i32)
  // mod.rs:355: f32::MAX; digits=38, decimal exponent=39.
  exact(t, 16777215u64, 104i32, "34028234663852885981170418348451692544", 1i32)
  Ok(())
}
