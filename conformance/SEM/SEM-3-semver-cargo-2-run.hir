// rule: SEM-3
// expect: run
// dtolnay/semver tests/test_version.rs and tests/test_version_req.rs
// (280ebcb6; offsets are this module's, and precedence ignores build metadata
// where semver's Ord does not), and npm/node-semver test/fixtures
// range-include.js, range-exclude.js, range-parse.js and comparisons.js rows
// without the loose and includePrerelease options (6e05b763; a leading v is
// dropped from versions, and ranges past 2^53 are omitted since numbers here
// are u64). Expected npm spellings are node-semver's, in this module's syntax.
fn version(spelling: String) -> semver.Version uses {} {
  match semver.parse(spelling) {
    Ok(v) => v,
    Error(_) => semver.Version(
      major: 999,
      minor: 999,
      patch: 999,
      pre: "unparsed",
      build: ""
    ),
  }
}

fn cargo_reqs() -> List[(String, String, List[String], List[String])] uses {} {
  [
    ("*", "", ["0.9.1", "2.9.0", "0.0.9", "1.0.1", "1.1.1"], ["1.0.0-pre"]),
    ("1.*", "", ["1.2.0", "1.2.1", "1.1.1", "1.3.0"], ["0.0.9", "1.2.0-pre"]),
    (
      "1.2.*",
      "",
      ["1.2.0", "1.2.2", "1.2.4"],
      ["1.9.0", "1.0.9", "2.0.1", "0.1.3", "1.2.2-pre"]
    ),
    ("*", "", ["0.0.1", "0.1.0", "1.0.0"], []),
    ("=2.1.1-really.0", "", ["2.1.1-really.0"], []),
    ("0.*.*", "0.*", ["0.5.0"], []),
    ("0.0.*", "0.0.*", [], [])
  ]
}

pub fn main(t: Test) -> Result[(), semver.SemverError] {
  let mut case: u64 = 1031
  for (spelling, display, all, none) in cargo_reqs() {
    let req = semver.parse_cargo(spelling)?
    if string.byte_len(display) > 0 {
      test.check_case(t, semver.req_to_string(req) == display, case)
    }
    for v in all {
      test.check_case(t, semver.matches(req, version(v)), case)
    }
    for v in none {
      test.check_case(t, !semver.matches(req, version(v)), case)
    }
    case += 1
  }
  Ok(())
}
