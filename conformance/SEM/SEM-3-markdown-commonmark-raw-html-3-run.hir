// rule: SEM-3
// expect: run
// Published spec.txt vectors; tools/generate-markdown.py.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.check(
    s,
    "commonmark/Raw HTML/622",
    "<a href='bar'title=title>\n",
    "<p>&lt;a href='bar'title=title&gt;</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Raw HTML/623",
    "</a></foo >\n",
    "<p></a></foo ></p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Raw HTML/624",
    "</a href=\"foo\">\n",
    "<p>&lt;/a href=&quot;foo&quot;&gt;</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Raw HTML/625",
    "foo <!-- this is a --\ncomment - with hyphens -->\n",
    "<p>foo <!-- this is a --\ncomment - with hyphens --></p>\n",
    std@1/markdown.default_options()
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
