// rule: SEM-3
// expect: run
// Generated by tools/generate-json-vectors.py; see docs/json-domain-vectors.md.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.wire(s, "rmp edge de0000", false, b"\xde\x00\x00", "{}", b"\x80")
  failed += harness.wire(
    s,
    "rmp edge df00000000",
    false,
    b"\xdf\x00\x00\x00\x00",
    "{}",
    b"\x80"
  )
  failed += harness.wire(s, "rmp edge d900", false, b"\xd9\x00", "\"\"", b"\xa0")
  failed += harness.unsupported(
    s,
    "rmp nonfinite ca7f800000",
    false,
    b"\xca\x7f\x80\x00\x00"
  )
  failed += harness.unsupported(
    s,
    "rmp nonfinite caff800000",
    false,
    b"\xca\xff\x80\x00\x00"
  )
  failed += harness.unsupported(
    s,
    "rmp nonfinite cb7ff0000000000000",
    false,
    b"\xcb\x7f\xf0\x00\x00\x00\x00\x00\x00"
  )
  failed += harness.unsupported(
    s,
    "rmp nonfinite cbfff0000000000000",
    false,
    b"\xcb\xff\xf0\x00\x00\x00\x00\x00\x00"
  )
  failed += harness.edge(s, "rmp invalid a2c328", b"\xa2\xc3\x28", 1)
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
