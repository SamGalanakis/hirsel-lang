// rule: SEM-3
// expect: run
// std@1/yaml stops billion laughs (nine levels of nine aliases) at MAX_ALIAS_NODES.
fn repeat(mut out: List[u8], piece: String, count: u64) -> () {
  let mut i: u64 = 0
  while i < count {
    text.append(mut out, piece)
    i += 1
  }
}

pub fn main(rt: Io) -> Result[(), ()] {
  // Billion laughs stops at the limit.
  let mut laughs: List[u8] = []
  text.append(mut laughs, "a: &a [lol, lol, lol, lol, lol, lol, lol, lol, lol]\n")
  let names: List[String] = ["a", "b", "c", "d", "e", "f", "g", "h"]
  let mut i: u64 = 1
  while i < list.len(names) {
    text.append(mut laughs, f"{names[i]}: &{names[i]} [")
    repeat(mut laughs, f"*{names[i - 1]}, ", 9)
    text.append(mut laughs, "]\n")
    i += 1
  }
  failure.check(
    match yaml.parse(text.finish_valid(take laughs)) {
      Error(Aliases(p)) => p.line == 6,
      _ => false,
    },
    TextInvariant()
  )
  Ok(())
}
