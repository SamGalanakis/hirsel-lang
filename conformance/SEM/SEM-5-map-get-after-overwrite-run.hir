// rule: SEM-5
// expect: run
// stdout: 10 30 20
// "Map insertion replaces an existing value in its existing position" (docs/spec/core-library.md),
// so a keyed read sees the replacement, and a result read earlier keeps its value.
fn output_error[E](take e: E) -> () {}

fn show(found: Option[u64]) -> String {
  match found {
    Some(v) => std@1/u64.to_string(v),
    None => "none",
  }
}

pub fn main(rt: Io, args: Args) -> Result[(), ()] {
  let out = io.stdout(rt) ? grant_error
  let mut m: Map[u32, u64] = map.empty()
  map.insert(mut m, 1, 10)
  map.insert(mut m, 2, 20)
  let earlier = map.get(m, 1)
  map.insert(mut m, 1, 30)
  out.print(out, show(earlier)) ? output_error
  out.print(out, " ") ? output_error
  out.print(out, show(map.get(m, 1))) ? output_error
  out.print(out, " ") ? output_error
  out.print(out, show(map.get(m, 2))) ? output_error
  out.print(out, "\n") ? output_error
  Ok(())
}

@noalloc
fn grant_error(refusal: GrantError) -> () uses {} {
  ()
}
