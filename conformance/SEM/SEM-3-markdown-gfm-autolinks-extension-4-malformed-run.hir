// rule: SEM-3
// expect: run
// Published spec.txt vectors; tools/generate-markdown.py.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.check(
    s,
    "gfm/Autolinks (extension)/628/malformed",
    "http://commonmark.org\n\n(Visit https://encrypted.google.com/search?q=\u{0}[&unterminated",
    "<p><a href=\"http://commonmark.org\">http://commonmark.org</a></p>\n<p>(Visit <a href=\"https://encrypted.google.com/search?q=%EF%BF%BD%5B&amp;unterminated\">https://encrypted.google.com/search?q=�[&amp;unterminated</a></p>\n",
    std@1/markdown.gfm_options()
  )
  failed += harness.check(
    s,
    "gfm/Autolinks (extension)/629/malformed",
    "foo@ba\u{0}[&unterminated",
    "<p>foo@ba�[&amp;unterminated</p>\n",
    std@1/markdown.gfm_options()
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
