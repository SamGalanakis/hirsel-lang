// rule: SEM-3
// expect: run
// Zig SHA-256 reference vectors and padding boundaries.
pub fn main() -> Result[(), ()] {
  failure.check(
    std@1/sha256.digest_hex(
      string.as_bytes("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")
    ) == "9f4390f8d30c2dd92ec9f095b65e2b9ae9b0a925a5258e241c9f1e910f734318",
    TextInvariant()
  )
  Ok(())
}
