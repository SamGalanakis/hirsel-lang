// rule: SEM-3
// expect: run
// Go src/compress/flate/flate_test.go TestStreams, cases 23-26
// (golang/go ebe2feef). Unlike Go, bytes after the final block are an error.
fn check(ok: bool) -> () uses {} {
  failure.check(ok, TextInvariant())
}

fn corrupt(decoded: Result[Bytes, flate.FlateError]) -> bool uses {} {
  match decoded {
    Error(Corrupt(_)) => true,
    _ => false,
  }
}

pub fn main(t: Test) -> Result[(), ()] {
  // fixed block, use reserved symbol 287
  check(corrupt(flate.inflate(b"3\x18\x07\x00", 1024)))
  // raw block
  check(flate.inflate(b"\x01\x01\x00\xfe\xff\x11", 1024) == Ok(b"\x11"))
  // issue 10426 - over-subscribed HCLenTree causes a hang
  check(corrupt(flate.inflate(b"4LJNIMK\x07\x00\x00\xff..\xff.....\xff", 1024)))
  // issue 11030 - empty HDistTree unexpectedly leads to error
  check(
    flate.inflate(b"\x05\xc0\x07\x06\x00\x00\x00\x80@\x0f\xff7\xa0\xca", 1024) == Ok(
      b""
    )
  )
  Ok(())
}
