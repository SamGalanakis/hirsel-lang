// rule: SEM-5
// expect: run
// Rust VecDeque and Zig deque endpoint vectors, including alternating removals.
pub fn main(t: Test) -> Result[(), ()] {
  let mut q: unique deque.Deque[u64] = deque.empty()
  failure.check(
    deque.len(q) == 0 && deque.pop_front(mut q) == None && deque.pop_back(mut q) == None,
    Bounds()
  )
  for i in 0u64..128u64 {
    deque.push_back(mut q, i)
  }
  failure.check(deque.len(q) == 128, Bounds())
  for i in 0u64..64u64 {
    failure.check(deque.pop_front(mut q) == Some(i), Bounds())
    failure.check(deque.pop_back(mut q) == Some(127 - i), Bounds())
  }
  failure.check(deque.len(q) == 0, Bounds())
  for i in 0u64..128u64 {
    deque.push_front(mut q, i)
  }
  for i in 0u64..128u64 {
    failure.check(deque.pop_back(mut q) == Some(i), Bounds())
  }
  for i in 0u64..20u64 {
    deque.push_back(mut q, i)
    deque.push_front(mut q, 100 + i)
    failure.check(deque.pop_front(mut q) == Some(100 + i), Bounds())
    failure.check(deque.pop_back(mut q) == Some(i), Bounds())
  }
  failure.check(
    deque.pop_front(mut q) == None && deque.pop_back(mut q) == None,
    Bounds()
  )
  Ok(())
}
