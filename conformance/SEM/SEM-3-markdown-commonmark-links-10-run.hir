// rule: SEM-3
// expect: run
// Published spec.txt vectors; tools/generate-markdown.py.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.check(
    s,
    "commonmark/Links/527",
    "[foo][bar]\n\n[bar]: /url \"title\"\n",
    "<p><a href=\"/url\" title=\"title\">foo</a></p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Links/528",
    "[link [foo [bar]]][ref]\n\n[ref]: /uri\n",
    "<p><a href=\"/uri\">link [foo [bar]]</a></p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Links/529",
    "[link \\[bar][ref]\n\n[ref]: /uri\n",
    "<p><a href=\"/uri\">link [bar</a></p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Links/530",
    "[link *foo **bar** `#`*][ref]\n\n[ref]: /uri\n",
    "<p><a href=\"/uri\">link <em>foo <strong>bar</strong> <code>#</code></em></a></p>\n",
    std@1/markdown.default_options()
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
