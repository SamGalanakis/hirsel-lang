// rule: SEM-3
// expect: run
// SHA3-512 of zero bytes at the 72-byte rate boundaries, the values Python hashlib (OpenSSL) gives.
fn check(count: u64, expected: String) -> () {
  let mut data: List[u8] = []
  while list.len(data) < count {
    list.push(mut data, 0)
  }
  failure.check(
    std@1/sha3_512.digest_hex(bytes.from_list(take data)) == expected,
    TextInvariant()
  )
}

pub fn main() -> Result[(), ()] {
  check(
    71,
    "cd87417194c917561a59c7f2eb4b95145971e32e8e4ef3b23b0f190bfd29e3692cc7975275750a27df95d5c6a99b7a341e1b8a38a750a51aca5b77bae41fbbfc"
  )
  check(
    72,
    "f8d76fdd8a082a67eaab47b5518ac486cb9a90dcb9f3c9efcfd86d5c8b3f1831601d3c8435f84b9e56da91283d5b98040e6e7b2c8dd9aa5bd4ebdf1823a7cf29"
  )
  check(
    73,
    "4ed8ba5741d94caef309c190bc13d18eb0f16942ebea76dcf0c6db1a35311fc04611313ea7d0ff2228a131cd68a84b3872c93d75700601107b6addeaffaa7a90"
  )
  check(
    144,
    "07625da1770011d59b0a71a8dec551f0ddf1917e4117fc860bd7e0a0e42f3e012284f86d509e2f22a8682aea5930197fc1f3c353d0141665c9ac2643278c3821"
  )
  Ok(())
}
