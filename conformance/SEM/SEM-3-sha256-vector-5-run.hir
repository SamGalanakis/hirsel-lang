// rule: SEM-3
// expect: run
// Zig SHA-256 reference vectors and padding boundaries.
pub fn main() -> Result[(), ()] {
  failure.check(
    std@1/sha256.digest_hex(
      string.as_bytes("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")
    ) == "7d3e74a05d7db15bce4ad9ec0658ea98e3f06eeecf16b4c6fff2da457ddc2f34",
    TextInvariant()
  )
  Ok(())
}
