// rule: SEM-2
// expect: run
// Independent integer rational oracle; sum normal significands in units of 2^-50, then round once to 24 bits.
pub fn main(t: Test) -> Result[(), ()] {
  let xs: Array[f32] = [
    core@1/f32.from_bits(3022671493u32),
    core@1/f32.from_bits(1133423059u32),
    core@1/f32.from_bits(3010753791u32),
    core@1/f32.from_bits(3081602375u32),
    core@1/f32.from_bits(3166468600u32),
    core@1/f32.from_bits(866108571u32),
    core@1/f32.from_bits(3374422504u32)
  ]
  core@1/test.check(t, core@1/f32.bits(f32.sum_exact(xs)) == 3374417939u32)
  Ok(())
}
