// rule: SEM-3
// expect: run
// Published spec.txt vectors; tools/generate-markdown.py.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.check(
    s,
    "commonmark/Link reference definitions/209",
    "[foo]: /url \"title\" ok\n",
    "<p>[foo]: /url &quot;title&quot; ok</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Link reference definitions/210",
    "[foo]: /url\n\"title\" ok\n",
    "<p>&quot;title&quot; ok</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Link reference definitions/211",
    "    [foo]: /url \"title\"\n\n[foo]\n",
    "<pre><code>[foo]: /url &quot;title&quot;\n</code></pre>\n<p>[foo]</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Link reference definitions/212",
    "```\n[foo]: /url\n```\n\n[foo]\n",
    "<pre><code>[foo]: /url\n</code></pre>\n<p>[foo]</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Link reference definitions/213",
    "Foo\n[bar]: /baz\n\n[bar]\n",
    "<p>Foo\n[bar]: /baz</p>\n<p>[bar]</p>\n",
    std@1/markdown.default_options()
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
