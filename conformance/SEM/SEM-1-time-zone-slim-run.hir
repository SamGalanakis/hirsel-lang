// rule: SEM-1
// expect: run
// Slim TZif files from Go's time testdata, whose tables stop where the POSIX
// footer takes over: Go TestLoadLocationFromTZDataSlim's Berlin and Nuuk
// offsets, then the footer's gaps and folds, including Nuuk's negative rule
// times (offsets cross-checked against CPython zoneinfo).
pub fn main(t: Test) -> Result[(), ()] {
  check.ambiguity(
    t,
    test.expect_ok(t, time_zone.from_tzif(zones.BERLIN_SLIM)),
    [
      ("2020-10-29T15:30:00", 0, 3600, 3600),
      ("2021-03-28T01:59:59", 0, 3600, 3600),
      ("2021-03-28T02:00:00", 1, 3600, 7200),
      ("2021-03-28T02:59:59", 1, 3600, 7200),
      ("2021-03-28T03:00:00", 0, 7200, 7200),
      ("2021-10-31T01:59:59", 0, 7200, 7200),
      ("2021-10-31T02:00:00", 2, 7200, 3600),
      ("2021-10-31T02:59:59", 2, 7200, 3600),
      ("2021-10-31T03:00:00", 0, 3600, 3600),
      ("2040-03-25T02:30:00", 1, 3600, 7200),
      ("2040-10-28T02:30:00", 2, 7200, 3600)
    ]
  )
  check.ambiguity(
    t,
    test.expect_ok(t, time_zone.from_tzif(zones.NUUK_SLIM)),
    [
      ("2020-10-29T15:30:00", 0, -10800, -10800),
      ("2021-03-27T21:59:59", 0, -10800, -10800),
      ("2021-03-27T22:00:00", 1, -10800, -7200),
      ("2021-03-27T22:59:59", 1, -10800, -7200),
      ("2021-03-27T23:00:00", 0, -7200, -7200),
      ("2021-10-30T21:59:59", 0, -7200, -7200),
      ("2021-10-30T22:00:00", 2, -7200, -10800),
      ("2021-10-30T22:59:59", 2, -7200, -10800),
      ("2021-10-30T23:00:00", 0, -10800, -10800)
    ]
  )
  Ok(())
}
