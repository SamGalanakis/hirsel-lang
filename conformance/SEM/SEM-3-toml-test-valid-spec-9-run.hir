fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.valid(
    s,
    "valid/spec-1.0.0/inline-table-0",
    "name = { first = \"Tom\", last = \"Preston-Werner\" }\npoint = { x = 1, y = 2 }\nanimal = { type.name = \"pug\" }\n",
    "{\"animal\":{\"type\":{\"name\":{\"type\":\"string\",\"value\":\"pug\"}}},\"name\":{\"first\":{\"type\":\"string\",\"value\":\"Tom\"},\"last\":{\"type\":\"string\",\"value\":\"Preston-Werner\"}},\"point\":{\"x\":{\"type\":\"integer\",\"value\":\"1\"},\"y\":{\"type\":\"integer\",\"value\":\"2\"}}}"
  )
  failed += harness.valid(
    s,
    "valid/spec-1.0.0/inline-table-1",
    "[name]\nfirst = \"Tom\"\nlast = \"Preston-Werner\"\n\n[point]\nx = 1\ny = 2\n\n[animal]\ntype.name = \"pug\"\n",
    "{\"animal\":{\"type\":{\"name\":{\"type\":\"string\",\"value\":\"pug\"}}},\"name\":{\"first\":{\"type\":\"string\",\"value\":\"Tom\"},\"last\":{\"type\":\"string\",\"value\":\"Preston-Werner\"}},\"point\":{\"x\":{\"type\":\"integer\",\"value\":\"1\"},\"y\":{\"type\":\"integer\",\"value\":\"2\"}}}"
  )
  failed += harness.valid(
    s,
    "valid/spec-1.0.0/inline-table-2",
    "[product]\ntype = { name = \"Nail\" }\n# type.edible = false  # INVALID\n",
    "{\"product\":{\"type\":{\"name\":{\"type\":\"string\",\"value\":\"Nail\"}}}}"
  )
  failed += harness.valid(
    s,
    "valid/spec-1.0.0/inline-table-3",
    "[product]\ntype.name = \"Nail\"\n# type = { edible = false }  # INVALID\n",
    "{\"product\":{\"type\":{\"name\":{\"type\":\"string\",\"value\":\"Nail\"}}}}"
  )
  failed += harness.valid(
    s,
    "valid/spec-1.0.0/integer-0",
    "int1 = +99\nint2 = 42\nint3 = 0\nint4 = -17\n",
    "{\"int1\":{\"type\":\"integer\",\"value\":\"99\"},\"int2\":{\"type\":\"integer\",\"value\":\"42\"},\"int3\":{\"type\":\"integer\",\"value\":\"0\"},\"int4\":{\"type\":\"integer\",\"value\":\"-17\"}}"
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
