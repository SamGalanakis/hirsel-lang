// rule: SEM-1
// expect: run
// itoa's decimal quads and pairs, every u128 power-of-ten boundary, signs,
// exact capacity, and atomic failure of the public inline formatter.
fn unsigned(t: Test, value: u128, expected: String) {
  let mut out: Inline[u8, 40] = [
    63u8,
    63u8,
    63u8,
    63u8,
    63u8,
    63u8,
    63u8,
    63u8,
    63u8,
    63u8,
    63u8,
    63u8,
    63u8,
    63u8,
    63u8,
    63u8,
    63u8,
    63u8,
    63u8,
    63u8,
    63u8,
    63u8,
    63u8,
    63u8,
    63u8,
    63u8,
    63u8,
    63u8,
    63u8,
    63u8,
    63u8,
    63u8,
    63u8,
    63u8,
    63u8,
    63u8,
    63u8,
    63u8,
    63u8,
    63u8
  ]
  let size = string.byte_len(expected)
  test.check(t, u128.format_inline(value, mut out) == Ok(size))
  let data = string.as_bytes(expected)
  for i in 0u64..size {
    test.check(t, out[i] == data[i])
  }
  for i in size..40u64 {
    test.check(t, out[i] == 63u8)
  }
}

