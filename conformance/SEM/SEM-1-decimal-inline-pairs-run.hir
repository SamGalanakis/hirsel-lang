  unsigned(
    t,
    340282366920938463463374607431768211455u128,
    "340282366920938463463374607431768211455"
  )
  let mut exact: Inline[u8, 4] = [63u8, 63u8, 63u8, 63u8]
  test.check(t, i128.format_inline(-123i128, mut exact) == Ok(4u64))
  test.check(t, exact == [45u8, 49u8, 50u8, 51u8])
  test.check(t, i128.format_inline(-1000i128, mut exact) == Error(BufferTooSmall))
  test.check(t, exact == [45u8, 49u8, 50u8, 51u8])
  test.check(t, u128.format_inline(10000u128, mut exact) == Error(BufferTooSmall))
  test.check(t, exact == [45u8, 49u8, 50u8, 51u8])
  let mut empty: Inline[u8, 0] = []
  test.check(t, u128.format_inline(0u128, mut empty) == Error(BufferTooSmall))
  Ok(())
