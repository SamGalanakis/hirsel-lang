// rule: SEM-3
// expect: run
// Published spec.txt vectors; tools/generate-markdown.py.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.check(
    s,
    "commonmark/HTML blocks/164/malformed",
    "<i class=\"foo\u{0}[&unterminated",
    "<p>&lt;i class=&quot;foo�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/HTML blocks/165/malformed",
    "</ins>\u{0}[&unterminated",
    "<p></ins>�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/HTML blocks/166/malformed",
    "<del>\n*fo\u{0}[&unterminated",
    "<del>\n*fo�[&unterminated\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/HTML blocks/167/malformed",
    "<del>\n\n*fo\u{0}[&unterminated",
    "<del>\n<p>*fo�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/HTML blocks/168/malformed",
    "<del>*fo\u{0}[&unterminated",
    "<p><del>*fo�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
