// rule: SEM-3
// expect: run
// Published spec.txt vectors; tools/generate-markdown.py.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.check(
    s,
    "commonmark/Emphasis and strong emphasis/471/malformed",
    "**foo **b\u{0}[&unterminated",
    "<p>**foo **b�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Emphasis and strong emphasis/472/malformed",
    "*foo *b\u{0}[&unterminated",
    "<p>*foo *b�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Emphasis and strong emphasis/473/malformed",
    "*[bar*]\u{0}[&unterminated",
    "<p><em>[bar</em>]�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Emphasis and strong emphasis/474/malformed",
    "_foo [bar\u{0}[&unterminated",
    "<p>_foo [bar�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Emphasis and strong emphasis/475/malformed",
    "*<img src=\"foo\u{0}[&unterminated",
    "<p>*&lt;img src=&quot;foo�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Emphasis and strong emphasis/476/malformed",
    "**<a hre\u{0}[&unterminated",
    "<p>**&lt;a hre�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
