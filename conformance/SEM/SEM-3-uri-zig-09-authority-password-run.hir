// rule: SEM-3
// expect: run
// Zig Uri.zig:647-660, authority.password (bff490a2, MIT).
pub fn main() -> Result[(), ()] {
  {
    let Ok(parsed_uri) = std@1/uri.parse("scheme://username@a") else {
      return Error(())
    }
    failure.check(parsed_uri.host == Some(Encoded("a")), TextInvariant())
    failure.check(parsed_uri.user == Some(Encoded("username")), TextInvariant())
    failure.check(parsed_uri.password == None(), TextInvariant())
    failure.check(parsed_uri.port == None(), TextInvariant())
  }
  {
    let Ok(parsed_uri) = std@1/uri.parse("scheme://username:@a") else {
      return Error(())
    }
    failure.check(parsed_uri.host == Some(Encoded("a")), TextInvariant())
    failure.check(parsed_uri.user == Some(Encoded("username")), TextInvariant())
    failure.check(parsed_uri.password == None(), TextInvariant())
    failure.check(parsed_uri.port == None(), TextInvariant())
  }
  {
    let Ok(parsed_uri) = std@1/uri.parse("scheme://username:password@a") else {
      return Error(())
    }
    failure.check(parsed_uri.host == Some(Encoded("a")), TextInvariant())
    failure.check(parsed_uri.user == Some(Encoded("username")), TextInvariant())
    failure.check(parsed_uri.password == Some(Encoded("password")), TextInvariant())
    failure.check(parsed_uri.port == None(), TextInvariant())
  }
  {
    let Ok(parsed_uri) = std@1/uri.parse("scheme://username::@a") else {
      return Error(())
    }
    failure.check(parsed_uri.host == Some(Encoded("a")), TextInvariant())
    failure.check(parsed_uri.user == Some(Encoded("username")), TextInvariant())
    failure.check(parsed_uri.password == Some(Encoded(":")), TextInvariant())
    failure.check(parsed_uri.port == None(), TextInvariant())
  }
  Ok(())
}
