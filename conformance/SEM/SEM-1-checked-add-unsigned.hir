// rule: SEM-1
// expect: run
// stdout: ok
// "other behaviours are named functions".
fn output_error[E](take e: E) -> () {}

pub fn main(rt: Io, args: Args) -> Result[(), ()] {
  let a: u8 = 255
  let b: u8 = 1
  let value = int.checked_add(a, b)
  out.print(
    io.stdout(rt) ? grant_error,
    if value == None {
      "ok\n"
    } else {
      "bad\n"
    }
  ) ? output_error
  Ok(())
}

@noalloc
fn grant_error(refusal: GrantError) -> () uses {} {
  ()
}
