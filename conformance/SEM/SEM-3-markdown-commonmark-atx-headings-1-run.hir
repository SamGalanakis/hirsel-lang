// rule: SEM-3
// expect: run
// Published spec.txt vectors; tools/generate-markdown.py.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.check(
    s,
    "commonmark/ATX headings/62",
    "# foo\n## foo\n### foo\n#### foo\n##### foo\n###### foo\n",
    "<h1>foo</h1>\n<h2>foo</h2>\n<h3>foo</h3>\n<h4>foo</h4>\n<h5>foo</h5>\n<h6>foo</h6>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/ATX headings/63",
    "####### foo\n",
    "<p>####### foo</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/ATX headings/64",
    "#5 bolt\n\n#hashtag\n",
    "<p>#5 bolt</p>\n<p>#hashtag</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/ATX headings/65",
    "\\## foo\n",
    "<p>## foo</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/ATX headings/66",
    "# foo *bar* \\*baz\\*\n",
    "<h1>foo <em>bar</em> *baz*</h1>\n",
    std@1/markdown.default_options()
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
