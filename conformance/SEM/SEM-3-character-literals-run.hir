// rule: SEM-3
// expect: run
fn digit(c: u32) -> bool
  ensures result == (c >= '0' && c <= '9') {
  c >= '0' && c <= '9'
}

fn classify(c: u32) -> u32 {
  match c {
    'a' => 1,
    '\n' => 2,
    _ => 0,
  }
}

pub fn main() -> Result[(), ()] {
  let c = 'a'
  failure.check(c == 97u32 && classify(c) == 1 && classify('\n') == 2, TextInvariant())
  failure.check('\n' == 10u32 && '\t' == 9u32 && '\r' == 13u32, TextInvariant())
  failure.check('\\' == 92u32 && '\'' == 39u32 && '\0' == 0u32, TextInvariant())
  failure.check('é' == 233u32 && '🐑' == 0x1f411u32, TextInvariant())
  failure.check('\u{1f411}' == '🐑' && '\u{10ffff}' == 0x10ffffu32, TextInvariant())
  let mut count = 0u64
  let text = "aé🐑"
  for scalar in string.scalars(text) {
    failure.check(scalar == 'a' || scalar == 'é' || scalar == '🐑', TextInvariant())
    count += 1
  }
  failure.check(count == 3 && digit('5') && !digit('x'), TextInvariant())
  Ok(())
}
