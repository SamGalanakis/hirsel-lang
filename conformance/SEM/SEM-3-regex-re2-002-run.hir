  // src/regexp/testdata/re2-search.txt:106
  check("h.*o", "hello\ngoodbye\n", Some(regex.Span(start: 0, end: 5)))?
  // src/regexp/testdata/re2-search.txt:108
  check("^(?:h.*o)$", "", None())?
  // src/regexp/testdata/re2-search.txt:109
  check("^(?:h.*o)$", "hello\ngoodbye\n", None())?
  // src/regexp/testdata/re2-search.txt:111
