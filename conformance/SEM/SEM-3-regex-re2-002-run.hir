fn check(pattern: String, input: String, expected: Option[regex.Span]) -> Result[(), ()] {
  let re = match regex.compile(pattern, 10000) {
    Ok(re) => take re,
    Error(_) => return Error(()),
  }
  failure.check(regex.find(re, input, 100000) == Ok(expected), TextInvariant())
  Ok(())
}

pub fn main() -> Result[(), ()] {
  // src/regexp/testdata/re2-search.txt:80
  check("^(?:ab|cd)", "xabcdx", None())?
  // src/regexp/testdata/re2-search.txt:82
  check("(?:ab|cd)$", "", None())?
  // src/regexp/testdata/re2-search.txt:83
  check("(?:ab|cd)$", "xabcdx", None())?
  // src/regexp/testdata/re2-search.txt:89
  check("h.*od?", "", None())?
  // src/regexp/testdata/re2-search.txt:90
  check("h.*od?", "hello\ngoodbye\n", Some(regex.Span(start: 0, end: 5)))?
  // src/regexp/testdata/re2-search.txt:92
