// rule: SEM-3
// expect: run
// steps: 2000000
// two seals, two opens and six rejected opens take about 0.8M steps, near the default budget
// Zig std/crypto/chacha20.zig "seal" and "open": RFC 8439 section 2.8.2 and an empty message.
// Flipping a bit of the ciphertext, tag, data, key or nonce, or truncating the tag, fails to open.
fn decode(text: String) -> unique Bytes {
  let Ok(data) = std@1/hex.decode(text) else {
    failure.check(false, TextInvariant())
    return bytes.from_list([])
  }
  data
}

fn rejects(key: Bytes, nonce: Bytes, sealed: Bytes, data: Bytes) -> () {
  let Error(AuthenticationFailed()) = std@1/chacha20poly1305.open(
    key,
    nonce,
    sealed,
    data
  ) else {
    failure.check(false, TextInvariant())
    return
  }
}

// `data` with byte `at` XORed with 1.
fn flip(data: Bytes, at: u64) -> unique Bytes {
  let mut out: List[u8] = []
  for byte in data {
    list.push(mut out, byte)
  }
  out[at] = out[at] ^ 1
  bytes.from_list(take out)
}

pub fn main() -> Result[(), ()] {
  let key = decode("808182838485868788898a8b8c8d8e8f909192939495969798999a9b9c9d9e9f")
  let nonce = decode("070000004041424344454647")
  let data = decode("50515253c0c1c2c3c4c5c6c7")
  let message = b"Ladies and Gentlemen of the class of '99: If I could offer you only one tip for the future, sunscreen would be it."
  let sealed = std@1/chacha20poly1305.seal(key, nonce, message, data)
  failure.check(
    std@1/hex.encode(sealed) == "d31a8d34648e60db7b86afbc53ef7ec2a4aded51296e08fea9e2b5a736ee62d63dbea45e8ca9671282fafb69da92728b1a71de0a9e060b2905d6a5b67ecd3b3692ddbd7f2d778b8c9803aee328091b58fab324e4fad675945585808b4831d7bc3ff4def08e4b7a9de576d26586cec64b61161ae10b594f09e26a7e902ecbd0600691",
    TextInvariant()
  )
  let Ok(opened) = std@1/chacha20poly1305.open(key, nonce, sealed, data) else {
    failure.check(false, TextInvariant())
    return Ok(())
  }
  failure.check(opened == message, TextInvariant())
  let empty = std@1/chacha20poly1305.seal(key, nonce, b"", b"")
  failure.check(
    std@1/hex.encode(empty) == "a0784d7a4716f3feb4f64e7f4b39bf04",
    TextInvariant()
  )
  let Ok(nothing) = std@1/chacha20poly1305.open(key, nonce, empty, b"") else {
    failure.check(false, TextInvariant())
    return Ok(())
  }
  failure.check(bytes.len(nothing) == 0, TextInvariant())
  rejects(key, nonce, flip(sealed, 0), data)
  rejects(key, nonce, flip(sealed, 129), data)
  rejects(key, nonce, sealed, flip(data, 0))
  rejects(flip(key, 0), nonce, sealed, data)
  rejects(key, flip(nonce, 0), sealed, data)
  rejects(key, nonce, bytes.slice(sealed, 0, 129), data)
  rejects(key, nonce, bytes.slice(empty, 0, 15), b"")
  rejects(key, nonce, b"", b"")
  Ok(())
}
