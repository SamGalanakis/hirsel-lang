// rule: SEM-2
// expect: run
// Independent integer rational oracle; sum normal significands in units of 2^-50, then round once to 24 bits.
pub fn main(t: Test) -> Result[(), ()] {
  let xs: Array[f32] = [
    core@1/f32.from_bits(3405140089u32),
    core@1/f32.from_bits(951909432u32),
    core@1/f32.from_bits(3324959423u32),
    core@1/f32.from_bits(3092658609u32),
    core@1/f32.from_bits(3296406991u32),
    core@1/f32.from_bits(3167424199u32),
    core@1/f32.from_bits(3384515454u32),
    core@1/f32.from_bits(865751253u32),
    core@1/f32.from_bits(1110319392u32)
  ]
  core@1/test.check(t, core@1/f32.bits(std@1/f32.sum_exact(xs)) == 3407006500u32)
  Ok(())
}
