}

@noalloc
fn bits64_u128(x: u128) -> u64 {
  f64.bits(float.from_int(x))
}

pub type RunError = Grant(GrantError) | Output(OutputError)

pub fn main(rt: Io, args: Args) -> Result[(), RunError] {
  failure.check(bits32_i8(0i8) == 0u32, Bounds())
