  f64.bits(float.from_int(x))
}

@noalloc
fn bits32_i64(x: i64) -> u32 {
  f32.bits(float.from_int(x))
}

@noalloc
fn bits64_i64(x: i64) -> u64 {
  f64.bits(float.from_int(x))
}

@noalloc
fn bits32_i128(x: i128) -> u32 {
  f32.bits(float.from_int(x))
}

@noalloc
fn bits64_i128(x: i128) -> u64 {
  f64.bits(float.from_int(x))
}

@noalloc
