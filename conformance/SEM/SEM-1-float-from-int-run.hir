// rule: SEM-1
// expect: run
// stdout: ok
// Rust coretests/tests/num/floats.rs exact integer limits and from_u64_i64;
// core/src/num/f32.rs and f64.rs nearest-even cast examples.
@noalloc
fn bits32_i8(x: i8) -> u32 {
  f32.bits(float.from_int(x))
}

@noalloc
fn bits64_i8(x: i8) -> u64 {
  f64.bits(float.from_int(x))
}

@noalloc
fn bits32_i16(x: i16) -> u32 {
  f32.bits(float.from_int(x))
}

@noalloc
