fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.valid(
    s,
    "valid/string/multibyte",
    "# Test each multibyte length: 2, 3, and 4 bytes:\n# ɑ € 𐫱\n\nbasic    = \"ɑ € 𐫱 ɑ€𐫱\"\nraw      = 'ɑ € 𐫱 ɑ€𐫱'\nml-basic = \"\"\"ɑ € 𐫱 ɑ€𐫱\"\"\"\nml-raw   = '''ɑ € 𐫱 ɑ€𐫱'''\n",
    "{\"basic\":{\"type\":\"string\",\"value\":\"ɑ € 𐫱 ɑ€𐫱\"},\"ml-basic\":{\"type\":\"string\",\"value\":\"ɑ € 𐫱 ɑ€𐫱\"},\"ml-raw\":{\"type\":\"string\",\"value\":\"ɑ € 𐫱 ɑ€𐫱\"},\"raw\":{\"type\":\"string\",\"value\":\"ɑ € 𐫱 ɑ€𐫱\"}}"
  )
  failed += harness.valid(
    s,
    "valid/string/multibyte-escape",
    "# Test each multibyte length: 2, 3, and 4 bytes:\n# ɑ € 𐫱\n\nbasic-1    = \"\\u0251 \\u20ac \\U00010AF1 \\u0251\\u20ac\\U00010AF1\"\nml-basic-1 = \"\"\"\\u0251 \\u20ac \\U00010AF1 \\u0251\\u20ac\\U00010AF1\"\"\"\n\n# Again, but only using \\U\nbasic-2    = \"\\U00000251 \\U000020ac \\U00010AF1 \\U00000251\\U000020ac\\U00010AF1\"\nml-basic-2 = \"\"\"\\U00000251 \\U000020ac \\U00010AF1 \\U00000251\\U000020ac\\U00010AF1\"\"\"\n",
    "{\"basic-1\":{\"type\":\"string\",\"value\":\"ɑ € 𐫱 ɑ€𐫱\"},\"ml-basic-1\":{\"type\":\"string\",\"value\":\"ɑ € 𐫱 ɑ€𐫱\"},\"basic-2\":{\"type\":\"string\",\"value\":\"ɑ € 𐫱 ɑ€𐫱\"},\"ml-basic-2\":{\"type\":\"string\",\"value\":\"ɑ € 𐫱 ɑ€𐫱\"}}"
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
