// rule: SEM-3
// expect: run
// Published spec.txt vectors; tools/generate-markdown.py.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.check(
    s,
    "gfm/Autolinks (extension)/630/malformed",
    "hello@mail+xyz.example isn't vali\u{0}[&unterminated",
    "<p>hello@mail+xyz.example isn't vali�[&amp;unterminated</p>\n",
    std@1/markdown.gfm_options()
  )
  failed += harness.check(
    s,
    "gfm/Autolinks (extension)/631/malformed",
    "a.b-c_d@a.b\n\na.b-c_d@a.b.\n\n\u{0}[&unterminated",
    "<p><a href=\"mailto:a.b-c_d@a.b\">a.b-c_d@a.b</a></p>\n<p><a href=\"mailto:a.b-c_d@a.b\">a.b-c_d@a.b</a>.</p>\n<p>�[&amp;unterminated</p>\n",
    std@1/markdown.gfm_options()
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
