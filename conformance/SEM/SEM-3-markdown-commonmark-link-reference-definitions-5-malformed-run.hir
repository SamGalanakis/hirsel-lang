// rule: SEM-3
// expect: run
// Published spec.txt vectors; tools/generate-markdown.py.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.check(
    s,
    "commonmark/Link reference definitions/209/malformed",
    "[foo]: /url\u{0}[&unterminated",
    "",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Link reference definitions/210/malformed",
    "[foo]: /url\u{0}[&unterminated",
    "",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Link reference definitions/211/malformed",
    "    [foo]: /url\u{0}[&unterminated",
    "<pre><code>[foo]: /url�[&amp;unterminated\n</code></pre>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Link reference definitions/212/malformed",
    "```\n[foo]: /u\u{0}[&unterminated",
    "<pre><code>[foo]: /u�[&amp;unterminated\n</code></pre>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Link reference definitions/213/malformed",
    "Foo\n[bar]: \u{0}[&unterminated",
    "<p>Foo\n[bar]: �[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
