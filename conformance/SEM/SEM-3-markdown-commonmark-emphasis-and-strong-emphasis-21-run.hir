// rule: SEM-3
// expect: run
// Published spec.txt vectors; tools/generate-markdown.py.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.check(
    s,
    "commonmark/Emphasis and strong emphasis/471",
    "**foo **bar baz**\n",
    "<p>**foo <strong>bar baz</strong></p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Emphasis and strong emphasis/472",
    "*foo *bar baz*\n",
    "<p>*foo <em>bar baz</em></p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Emphasis and strong emphasis/473",
    "*[bar*](/url)\n",
    "<p>*<a href=\"/url\">bar*</a></p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Emphasis and strong emphasis/474",
    "_foo [bar_](/url)\n",
    "<p>_foo <a href=\"/url\">bar_</a></p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Emphasis and strong emphasis/475",
    "*<img src=\"foo\" title=\"*\"/>\n",
    "<p>*<img src=\"foo\" title=\"*\"/></p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Emphasis and strong emphasis/476",
    "**<a href=\"**\">\n",
    "<p>**<a href=\"**\"></p>\n",
    std@1/markdown.default_options()
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
