// rule: SEM-3
// expect: run
// Published spec.txt vectors; tools/generate-markdown.py.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.check(
    s,
    "commonmark/Entity and numeric character references/32/malformed",
    "[foo](/f&ouml;&ouml\u{0}[&unterminated",
    "<p>[foo](/fö&amp;ouml�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Entity and numeric character references/33/malformed",
    "[foo]\n\n[foo]: /f&ouml;\u{0}[&unterminated",
    "<p><a href=\"/f%C3%B6%EF%BF%BD%5B&amp;unterminated\">foo</a></p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Entity and numeric character references/34/malformed",
    "``` f&ouml;&o\u{0}[&unterminated",
    "<pre><code class=\"language-fö&amp;o�[&amp;unterminated\"></code></pre>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Entity and numeric character references/35/malformed",
    "`f&ouml;\u{0}[&unterminated",
    "<p>`fö�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
