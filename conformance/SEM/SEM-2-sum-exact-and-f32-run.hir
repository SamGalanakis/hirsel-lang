// rule: SEM-2
// expect: run
@noalloc
fn check(holds: bool) -> ()
  requires holds {
  ()
}

pub fn main(rt: Io, args: Args) -> Result[(), CliError] {
  let xs: Array[f64] = [1.0e16, 1.0, -1.0e16, 1.0]
  check(f64.sum_exact(xs) == 2.0)
  let ys: Array[f32] = [1.0e8f32, 1.0f32, -1.0e8f32, 1.0f32]
  check(f32.sum(ys) == 0.0f32)
  check(f32.sum_exact(ys) == 2.0f32)
  Ok(())
}
