// rule: SEM-3
// expect: run
// Go ebe2feef capture/flag/replacement vectors (BSD-3-Clause).
// RE2 data Copyright 2009 The RE2 Authors (BSD-3-Clause).
fn check(
  pattern: String,
  input: String,
  replacement: String,
  expected: String,
  literal: bool
) -> Result[(), ()] {
  let Ok(re) = regex.compile(pattern, 10000) else {
    return Error(())
  }
  let actual = if literal {
    regex.replace_all_literal(re, input, replacement, 1000000)
  } else {
    regex.replace_all(re, input, replacement, 1000000)
  }
  failure.check(actual == Ok(expected), TextInvariant())
  Ok(())
}

pub fn main() -> Result[(), ()] {
  // Go all_test.go:198
  check("abc", "abcdabc", "", "d", false)?
  // Go all_test.go:199
  check("x", "xxxXxxx", "xXx", "xXxxXxxXxXxXxxXxxXx", false)?
  // Go all_test.go:200
  check("abc", "", "d", "", false)?
  // Go all_test.go:201
  check("abc", "abc", "d", "d", false)?
  // Go all_test.go:202
  check(".+", "abc", "x", "x", false)?
  // Go all_test.go:203
  check("[a-c]*", "def", "x", "xdxexfx", false)?
  // Go all_test.go:204
  check("[a-c]+", "abcbcdcdedef", "x", "xdxdedef", false)?
  // Go all_test.go:205
  check("[a-c]*", "abcbcdcdedef", "x", "xdxdxexdxexfx", false)?
  Ok(())
}
