// rule: SEM-3
// expect: run
// Go ebe2feef capture/flag/replacement vectors (BSD-3-Clause).
// RE2 data Copyright 2009 The RE2 Authors (BSD-3-Clause).
fn check(pattern: String, input: String, maximum: u64, expected: List[regex.Captures]) -> Result[
  (),
  ()
] {
  let Ok(re) = regex.compile(pattern, 10000) else {
    return Error(())
  }
  failure.check(
    regex.find_all_captures(re, input, maximum, 1000000) == Ok(expected),
    TextInvariant()
  )
  if maximum != 0 {
    let first: Option[regex.Captures] = if list.len(expected) == 0 {
      None()
    } else {
      Some(copy expected[0])
    }
    failure.check(regex.find_captures(re, input, 1000000) == Ok(first), TextInvariant())
  }
  Ok(())
}

pub fn main() -> Result[(), ()] {
  // Go find_test.go:54
  check(
    "[^a-z]+",
    "ab1234cd",
    18446744073709551615,
    [regex.Captures(spans: [Some(regex.Span(start: 2, end: 6))])]
  )?
  // Go find_test.go:55
  check(
    "[a\\-\\]z]+",
    "az]-bcz",
    18446744073709551615,
    [
      regex.Captures(spans: [Some(regex.Span(start: 0, end: 4))]),
      regex.Captures(spans: [Some(regex.Span(start: 6, end: 7))])
    ]
  )?
  // Go find_test.go:56
  check(
    "[^\\n]+",
    "abcd\n",
    18446744073709551615,
    [regex.Captures(spans: [Some(regex.Span(start: 0, end: 4))])]
  )?
  // Go find_test.go:57
  check(
    "[日本語]+",
    "日本語日本語",
    18446744073709551615,
    [regex.Captures(spans: [Some(regex.Span(start: 0, end: 18))])]
  )?
  // Go find_test.go:58
  check(
    "日本語+",
    "日本語",
    18446744073709551615,
    [regex.Captures(spans: [Some(regex.Span(start: 0, end: 9))])]
  )?
  // Go find_test.go:59
  check(
    "日本語+",
    "日本語語語語",
    18446744073709551615,
    [regex.Captures(spans: [Some(regex.Span(start: 0, end: 18))])]
  )?
  // Go find_test.go:60
  check(
    "()",
    "",
    18446744073709551615,
    [
      regex.Captures(
        spans: [Some(regex.Span(start: 0, end: 0)), Some(regex.Span(start: 0, end: 0))]
      )
    ]
  )?
  // Go find_test.go:61
  check(
    "(a)",
    "a",
    18446744073709551615,
    [
      regex.Captures(
        spans: [Some(regex.Span(start: 0, end: 1)), Some(regex.Span(start: 0, end: 1))]
      )
    ]
  )?
  Ok(())
}
