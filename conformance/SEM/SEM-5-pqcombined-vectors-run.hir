// rule: SEM-5
// expect: run
// CPython 938144ef Lib/test/test_heapq.py:178-185, 233-262.
@noalloc
fn by(a: i32, b: i32) -> i32 uses {} {
  if a < b {
    -2147483648
  } else if a > b {
    2147483647
  } else {
    0
  }
}

fn drain(mut h: unique priority_queue.Heap[i32], expected: List[i32]) -> () {
  for value in expected {
    failure.check(priority_queue.pop(mut h) == Some(value), Bounds())
  }
  failure.check(priority_queue.pop(mut h) == None, Bounds())
}

pub fn main(t: Test) -> Result[(), ()] {
  let mut h: unique priority_queue.Heap[i32] = priority_queue.empty(by)
  failure.check(priority_queue.push_pop(mut h, -2147483648) == -2147483648, Bounds())
  failure.check(priority_queue.len(h) == 0, Bounds())
  failure.check(priority_queue.replace_top(mut h, 9) == None, Bounds())
  failure.check(priority_queue.len(h) == 1, Bounds())
  failure.check(priority_queue.push_pop(mut h, 8) == 8, Bounds())
  failure.check(priority_queue.push_pop(mut h, 9) == 9, Bounds())
  failure.check(priority_queue.push_pop(mut h, 10) == 9, Bounds())
  failure.check(priority_queue.replace_top(mut h, -2147483648) == Some(10), Bounds())
  failure.check(
    priority_queue.replace_top(mut h, 2147483647) == Some(-2147483648),
    Bounds()
  )
  drain(mut h, [2147483647])
  let mut both: unique priority_queue.Heap[i32] = priority_queue.from_list(
    by,
    unique [1, 3, 2, 7, 5, 4, 6]
  )
  failure.check(priority_queue.replace_top(mut both, 9) == Some(1), Bounds())
  failure.check(priority_queue.push_pop(mut both, 8) == 2, Bounds())
  failure.check(priority_queue.replace_top(mut both, 0) == Some(3), Bounds())
  drain(mut both, [0, 4, 5, 6, 7, 8, 9])
  let mut dup: unique priority_queue.Heap[i32] = priority_queue.from_list(
    by,
    unique [2, 2, 2]
  )
  failure.check(priority_queue.replace_top(mut dup, 2) == Some(2), Bounds())
  failure.check(priority_queue.push_pop(mut dup, 2) == 2, Bounds())
  drain(mut dup, [2, 2, 2])
  Ok(())
}
