// rule: SEM-3
// expect: run
// Rust coretests/tests/num/flt2dec/mod.rs, f6c1107f8be13e48465e12c0fd26e6a39fe18e4f.
// MIT; third-party/NOTICES.md. Original check_exact/check_exact_one row lines below.
// The rounded value in units of 10^cutoff, digit by digit against `expected`.
fn same_digits(d: std@1/internal.decimal_seq.DecimalSeq, expected: String, cutoff: i32) -> bool {
  let point: i64 = core@1/int.widen(d.decimal_point)
  let limit: i64 = core@1/int.widen(cutoff)
  let text = core@1/string.as_bytes(expected)
  let length = core@1/bytes.len(text)
  if point - limit <= 0 {
    return length == 1 && text[0] == 48
  }
  let count: u64 = core@1/int.narrow(point - limit)
  if count != length {
    return false
  }
  let mut i: u64 = 0
  while i < count {
    let digit: u8 = if i < d.num_digits {
      d.digits[i]
    } else {
      0
    }
    if text[i] != digit + 48 {
      return false
    }
    i += 1
  }
  true
}

fn exact(t: Test, mantissa: u64, exponent: i32, expected: String, cutoff: i32) -> () {
  let limit: i64 = core@1/int.widen(cutoff)
  let mut d = std@1/internal.decimal_seq.exact(mantissa, exponent, -limit)
  let point: i64 = core@1/int.widen(d.decimal_point)
  std@1/internal.format.round_decimal(mut d, point - limit)
  test.check(t, same_digits(d, expected, cutoff))
}

pub fn main(t: Test) -> Result[(), ()] {
  // mod.rs:519: 6712731423444934p534f64; digits=3, decimal exponent=177.
  exact(t, 6712731423444934u64, 534i32, "378", 174i32)
  // mod.rs:520: 5298405411573037p-957f64; digits=4, decimal exponent=-272.
  exact(t, 5298405411573037u64, -957i32, "4350", -276i32)
  // mod.rs:521: 5137311167659507p-144f64; digits=5, decimal exponent=-27.
  exact(t, 5137311167659507u64, -144i32, "23037", -32i32)
  // mod.rs:522: 6722280709661868p363f64; digits=6, decimal exponent=126.
  exact(t, 6722280709661868u64, 363i32, "126301", 120i32)
  // mod.rs:523: 5344436398034927p-169f64; digits=7, decimal exponent=-35.
  exact(t, 5344436398034927u64, -169i32, "7142211", -42i32)
  // mod.rs:524: 8369123604277281p-853f64; digits=8, decimal exponent=-240.
  exact(t, 8369123604277281u64, -853i32, "13934574", -248i32)
  // mod.rs:525: 8995822108487663p-780f64; digits=9, decimal exponent=-218.
  exact(t, 8995822108487663u64, -780i32, "141463449", -227i32)
  Ok(())
}
