// rule: SEM-3
// expect: run
// Published spec.txt vectors; tools/generate-markdown.py.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.check(
    s,
    "commonmark/Backslash escapes/22/malformed",
    "[foo](/bar\\*\u{0}[&unterminated",
    "<p>[foo](/bar*�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Backslash escapes/23/malformed",
    "[foo]\n\n[foo]: /\u{0}[&unterminated",
    "<p><a href=\"/%EF%BF%BD%5B&amp;unterminated\">foo</a></p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Backslash escapes/24/malformed",
    "``` foo\\+b\u{0}[&unterminated",
    "<pre><code class=\"language-foo+b�[&amp;unterminated\"></code></pre>\n",
    std@1/markdown.default_options()
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
