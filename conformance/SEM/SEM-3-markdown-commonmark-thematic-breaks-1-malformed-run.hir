// rule: SEM-3
// expect: run
// Published spec.txt vectors; tools/generate-markdown.py.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.check(
    s,
    "commonmark/Thematic breaks/43/malformed",
    "***\n--\u{0}[&unterminated",
    "<hr />\n<p>--�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Thematic breaks/44/malformed",
    "++\u{0}[&unterminated",
    "<p>++�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Thematic breaks/45/malformed",
    "==\u{0}[&unterminated",
    "<p>==�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Thematic breaks/46/malformed",
    "--\n*\u{0}[&unterminated",
    "<p>--\n*�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Thematic breaks/47/malformed",
    " ***\n  **\u{0}[&unterminated",
    "<hr />\n<p>**�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Thematic breaks/48/malformed",
    "    \u{0}[&unterminated",
    "<pre><code>�[&amp;unterminated\n</code></pre>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Thematic breaks/49/malformed",
    "Foo\n  \u{0}[&unterminated",
    "<p>Foo\n�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
