// rule: SEM-3
// expect: run
// Published spec.txt vectors; tools/generate-markdown.py.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.check(
    s,
    "commonmark/List items/261/malformed",
    "-one\n\n\u{0}[&unterminated",
    "<p>-one</p>\n<p>�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/List items/262/malformed",
    "- foo\n\n\u{0}[&unterminated",
    "<ul>\n<li>foo</li>\n</ul>\n<p>�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/List items/263/malformed",
    "1.  foo\n\n    ```\n    bar\n \u{0}[&unterminated",
    "<ol>\n<li>\n<p>foo</p>\n<pre><code>bar\n</code></pre>\n</li>\n</ol>\n<p>�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/List items/264/malformed",
    "- Foo\n\n      b\u{0}[&unterminated",
    "<ul>\n<li>\n<p>Foo</p>\n<pre><code>b�[&amp;unterminated\n</code></pre>\n</li>\n</ul>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/List items/265/malformed",
    "1234567\u{0}[&unterminated",
    "<p>1234567�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
