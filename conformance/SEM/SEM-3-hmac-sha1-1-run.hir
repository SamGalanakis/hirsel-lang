// rule: SEM-3
// expect: run
// RFC 2202 HMAC-SHA1 test cases 2, 6 and 7 and the FIPS 198 block-sized key
// sample from Go crypto/hmac, verified through hmac.verify.
fn check(key: Bytes, data: Bytes, expected: String) -> () {
  let Ok(tag) = std@1/hex.decode(expected) else {
    failure.check(false, TextInvariant())
    return
  }
  failure.check(std@1/hmac.verify(std@1/sha1.hash(), key, data, tag), TextInvariant())
}

pub fn main() -> Result[(), ()] {
  check(
    b"\xaa\xaa\xaa\xaa\xaa\xaa\xaa\xaa\xaa\xaa\xaa\xaa\xaa\xaa\xaa\xaa\xaa\xaa\xaa\xaa\xaa\xaa\xaa\xaa\xaa\xaa\xaa\xaa\xaa\xaa\xaa\xaa\xaa\xaa\xaa\xaa\xaa\xaa\xaa\xaa\xaa\xaa\xaa\xaa\xaa\xaa\xaa\xaa\xaa\xaa\xaa\xaa\xaa\xaa\xaa\xaa\xaa\xaa\xaa\xaa\xaa\xaa\xaa\xaa\xaa\xaa\xaa\xaa\xaa\xaa\xaa\xaa\xaa\xaa\xaa\xaa\xaa\xaa\xaa\xaa",
    b"Test Using Larger Than Block-Size Key and Larger Than One Block-Size Data",
    "e8e99d0f45237d786d6bbaa7965c7808bbff1a91"
  )
  check(
    b"\x00\x01\x02\x03\x04\x05\x06\x07\x08\x09\x0a\x0b\x0c\x0d\x0e\x0f\x10\x11\x12\x13\x14\x15\x16\x17\x18\x19\x1a\x1b\x1c\x1d\x1e\x1f\x20\x21\x22\x23\x24\x25\x26\x27\x28\x29\x2a\x2b\x2c\x2d\x2e\x2f\x30\x31\x32\x33\x34\x35\x36\x37\x38\x39\x3a\x3b\x3c\x3d\x3e\x3f",
    b"Sample #1",
    "4f4ca3d5d68ba7cc0a1208c9c61e9c5da0403c0a"
  )
  Ok(())
}
