// rule: SEM-5
// expect: run
@noalloc
fn check(n: u64) -> ()
  requires n == 34 {
  ()
}

pub fn main(rt: Io, args: Args) -> Result[(), CliError] {
  let mut m: Map[u32, u64] = map.empty()
  map.insert(mut m, 1, 1)
  map.insert(mut m, 2, 4)
  map.insert(mut m, 1, 3)
  let mut digits: u64 = 0
  for pair in m {
    let (k, v) = pair
    digits = digits * 10 + v
  }
  check(digits)
  Ok(())
}
