// rule: SEM-3
// expect: run
// Published spec.txt vectors; tools/generate-markdown.py.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.check(
    s,
    "commonmark/Link reference definitions/199",
    "[foo]:\n\n[foo]\n",
    "<p>[foo]:</p>\n<p>[foo]</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Link reference definitions/200",
    "[foo]: <>\n\n[foo]\n",
    "<p><a href=\"\">foo</a></p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Link reference definitions/201",
    "[foo]: <bar>(baz)\n\n[foo]\n",
    "<p>[foo]: <bar>(baz)</p>\n<p>[foo]</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Link reference definitions/202",
    "[foo]: /url\\bar\\*baz \"foo\\\"bar\\baz\"\n\n[foo]\n",
    "<p><a href=\"/url%5Cbar*baz\" title=\"foo&quot;bar\\baz\">foo</a></p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Link reference definitions/203",
    "[foo]\n\n[foo]: url\n",
    "<p><a href=\"url\">foo</a></p>\n",
    std@1/markdown.default_options()
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
