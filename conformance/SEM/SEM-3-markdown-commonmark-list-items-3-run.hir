// rule: SEM-3
// expect: run
// Published spec.txt vectors; tools/generate-markdown.py.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.check(
    s,
    "commonmark/List items/261",
    "-one\n\n2.two\n",
    "<p>-one</p>\n<p>2.two</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/List items/262",
    "- foo\n\n\n  bar\n",
    "<ul>\n<li>\n<p>foo</p>\n<p>bar</p>\n</li>\n</ul>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/List items/263",
    "1.  foo\n\n    ```\n    bar\n    ```\n\n    baz\n\n    > bam\n",
    "<ol>\n<li>\n<p>foo</p>\n<pre><code>bar\n</code></pre>\n<p>baz</p>\n<blockquote>\n<p>bam</p>\n</blockquote>\n</li>\n</ol>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/List items/264",
    "- Foo\n\n      bar\n\n\n      baz\n",
    "<ul>\n<li>\n<p>Foo</p>\n<pre><code>bar\n\n\nbaz\n</code></pre>\n</li>\n</ul>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/List items/265",
    "123456789. ok\n",
    "<ol start=\"123456789\">\n<li>ok</li>\n</ol>\n",
    std@1/markdown.default_options()
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
