// See docs/x509-prior-art.md for source lines and envelope adaptations.
fn subject(der: Bytes) -> Option[String] uses {} {
  match x509.parse(der) {
    Ok(c) => Some(c.subject),
    Error(_) => None(),
  }
}

// Go's certBytes contains a chain; TestPKIXNameString uses ParseCertificates(der)[0].
fn chain_subject(chain: Bytes) -> Option[String] uses {} {
  match x509.certificates(chain) {
    Ok(parts) => if list.len(parts) > 0 {
      subject(parts[0])
    } else {
      None()
    },
    Error(_) => None(),
  }
}

