    "[](./tar\u{0}[&unterminated",
    "<p>[](./tar�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Links/485/malformed",
    "[lin\u{0}[&unterminated",
    "<p>[lin�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
