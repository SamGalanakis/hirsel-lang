  // src/regexp/testdata/re2-search.txt:3600
  check("^(?:a)", "a", Some(regex.Span(start: 0, end: 1)))?
  // src/regexp/testdata/re2-search.txt:3602
  check("(?:a)$", "", None())?
  // src/regexp/testdata/re2-search.txt:3603
  check("(?:a)$", "a", Some(regex.Span(start: 0, end: 1)))?
