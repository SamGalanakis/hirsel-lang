  check("^(?:^^)", "a", Some(regex.Span(start: 0, end: 0)))?
  // src/regexp/testdata/re2-search.txt:3586
  check("(?:^^)$", "", Some(regex.Span(start: 0, end: 0)))?
  // src/regexp/testdata/re2-search.txt:3587
  check("(?:^^)$", "a", None())?
  // src/regexp/testdata/re2-search.txt:3593
  check("a", "", None())?
  // src/regexp/testdata/re2-search.txt:3594
  check("a", "a", Some(regex.Span(start: 0, end: 1)))?
  // src/regexp/testdata/re2-search.txt:3596
