fn check(pattern: String, input: String, expected: Option[regex.Span]) -> Result[(), ()] {
  let re = match regex.compile(pattern, 10000) {
    Ok(re) => take re,
    Error(_) => return Error(()),
  }
  failure.check(regex.find(re, input, 100000) == Ok(expected), TextInvariant())
  Ok(())
}

pub fn main() -> Result[(), ()] {
  // src/regexp/testdata/re2-search.txt:3577
  check("^^", "", Some(regex.Span(start: 0, end: 0)))?
  // src/regexp/testdata/re2-search.txt:3578
  check("^^", "a", Some(regex.Span(start: 0, end: 0)))?
  // src/regexp/testdata/re2-search.txt:3580
