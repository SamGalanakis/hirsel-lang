// rule: SEM-4
// expect: reject SEM-4 at line 3
@loop_source(open, next)
type View {
  source: String,
}

type Cursor {
  source: String,
  position: u64,
}

@noalloc
fn view(s: String) -> View in s {
  View(source: copy s)
}

@noalloc
fn open(v: View) -> Cursor in v {
  Cursor(source: copy v.source, position: 0)
}

@noalloc
fn next(mut it: Cursor) -> FakeOption[String] in it {
  if it.position == 0 {
    it.position = 1
    FakeSome(copy it.source)
  } else {
    FakeNone
  }
}

type FakeOption[T] = FakeNone | FakeSome(T)
