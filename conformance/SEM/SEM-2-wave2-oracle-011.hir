// rule: SEM-2
// expect: run
// Rust std LowerExp supplies independent shortest digits and decimal parsing.
pub fn main(t: Test) -> Result[(), ()] {
  core@1/test.check(
    t,
    std@1/f64.to_string(core@1/f64.from_bits(4906019910204099648u64)) == "100000000000000000000"
  )
  match std@1/f64.parse("100000000000000000000") {
    Ok(value) => core@1/test.check(t, core@1/f64.bits(value) == 4906019910204099648u64),
    Error(_) => core@1/test.check(t, false),
  }
  Ok(())
}
