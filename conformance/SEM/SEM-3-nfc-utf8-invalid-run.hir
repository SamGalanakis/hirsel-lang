// rule: SEM-3
// expect: run
// stdout: nfc
pub fn main(rt: Io, args: Args) -> Result[(), LaunchError] {
  match string.from_bytes(b"\xff") {
    Error(raw) => failure.check(raw == b"\xff", TextInvariant()),
    Ok(_) => failure.check(false, TextInvariant()),
  }
  out.print(io.stdout(rt) ? Grant, "nfc\n") ? Output
  Ok(())
}

pub type LaunchError = Grant(GrantError) | Output(OutputError)
