// rule: SEM-3
// expect: run
// Zig std/crypto/sha3.zig SHAKE vectors and the FIPS 202 empty-input SHAKE128 and SHAKE256
// outputs; a 300-byte output spans two SHAKE128 squeezes and its every prefix is a shorter output.
fn hex(data: Bytes) -> unique String {
  std@1/hex.encode(data)
}

pub fn main() -> Result[(), ()] {
  failure.check(
    hex(std@1/shake128.digest(b"hello123", 10)) == "1b85861510bc4d8e467d",
    TextInvariant()
  )
  failure.check(
    hex(std@1/shake256.digest(b"hello123", 10)) == "ade612ba265f92de4a37",
    TextInvariant()
  )
  failure.check(
    hex(std@1/shake128.digest(b"", 32)) == "7f9c2ba4e88f827d616045507605853ed73b8093f6efbc88eb1a6eacfa66ef26",
    TextInvariant()
  )
  failure.check(
    hex(std@1/shake256.digest(b"", 64)) == "46b9dd2b0ba88d13233b3feb743eeb243fcd52ea62b81b82b50c27646ed5762fd75dc4ddd8c0f200cb05019d67b592f6fc821c49479ab48640292eacb3b7c4be",
    TextInvariant()
  )
  failure.check(core@1/bytes.len(std@1/shake128.digest(b"", 0)) == 0, TextInvariant())
  let mut state = std@1/shake128.new()
  std@1/shake128.update(mut state, b"hello")
  std@1/shake128.update(mut state, b"123")
  let long = std@1/shake128.finish(take state, 300)
  failure.check(
    hex(long) == "",
    TextInvariant()
  )
  failure.check(
    bytes.slice(long, 0, 10) == std@1/shake128.digest(b"hello123", 10),
    TextInvariant()
  )
  failure.check(
    bytes.slice(long, 0, 168) == std@1/shake128.digest(b"hello123", 168),
    TextInvariant()
  )
  Ok(())
}
