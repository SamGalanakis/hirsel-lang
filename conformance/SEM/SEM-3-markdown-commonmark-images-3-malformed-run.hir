    s,
    "commonmark/Images/579/malformed",
    "My ![foo bar](/path/to/\u{0}[&unterminated",
    "<p>My ![foo bar](/path/to/�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Images/580/malformed",
    "![foo](\u{0}[&unterminated",
    "<p>![foo](�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Images/581/malformed",
    "![](/\u{0}[&unterminated",
    "<p>![](/�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Images/582/malformed",
    "![foo][bar]\n\u{0}[&unterminated",
    "<p>![foo][bar]\n�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Images/583/malformed",
    "![foo][bar]\n\u{0}[&unterminated",
    "<p>![foo][bar]\n�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
