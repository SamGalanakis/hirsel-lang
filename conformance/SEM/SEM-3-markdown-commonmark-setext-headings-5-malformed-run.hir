// rule: SEM-3
// expect: run
// Published spec.txt vectors; tools/generate-markdown.py.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.check(
    s,
    "commonmark/Setext headings/101/malformed",
    "> foo\n\u{0}[&unterminated",
    "<blockquote>\n<p>foo\n�[&amp;unterminated</p>\n</blockquote>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Setext headings/102/malformed",
    "\\> foo\n\u{0}[&unterminated",
    "<p>&gt; foo\n�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Setext headings/103/malformed",
    "Foo\n\nbar\u{0}[&unterminated",
    "<p>Foo</p>\n<p>bar�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Setext headings/104/malformed",
    "Foo\nbar\n\n\u{0}[&unterminated",
    "<p>Foo\nbar</p>\n<p>�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Setext headings/105/malformed",
    "Foo\nbar\n*\u{0}[&unterminated",
    "<p>Foo\nbar\n*�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Setext headings/106/malformed",
    "Foo\nbar\n\u{0}[&unterminated",
    "<p>Foo\nbar\n�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
