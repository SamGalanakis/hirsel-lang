// rule: SEM-3
// expect: run
// std@1/yaml.document keeps a document's text; get reads values by path and set
// respells one value in place, keeping comments; paths through scalars fail.
fn edits(r: Result[(), yaml.YamlError], doc: yaml.Document, expected: String) -> bool {
  r == Ok(()) && yaml.source(doc) == expected
}

pub fn main(rt: Io) -> Result[(), ()] {
  let Ok(doc) = yaml.document(
    "# CI\nname: CI  # the name\non:\n  push:\n    branches: [main]\njobs:\n  test:\n    steps:\n      - uses: checkout\n      # run the tests\n      - run: make\n"
  ) else {
    failure.check(false, TextInvariant())
    return Ok(())
  }
  failure.check(string.starts_with(yaml.source(doc), "# CI\n"), TextInvariant())
  failure.check(yaml.get(doc, [Key("name")]) == Some(Text("CI")), TextInvariant())
  failure.check(
    yaml.get(doc, [Key("on"), Key("push"), Key("branches"), Index(0)]) == Some(
      Text("main")
    ),
    TextInvariant()
  )
  failure.check(yaml.get(doc, [Key("jobs"), Key("build")]) == None(), TextInvariant())
  failure.check(yaml.get(doc, [Key("name"), Index(0)]) == None(), TextInvariant())
  failure.check(yaml.get(doc, []) == Some(yaml.root(doc)), TextInvariant())
  let mut renamed = copy doc
  failure.check(
    edits(
      yaml.set(mut renamed, [Key("name")], Text("Build and test")),
      renamed,
      "# CI\nname: Build and test  # the name\non:\n  push:\n    branches: [main]\njobs:\n  test:\n    steps:\n      - uses: checkout\n      # run the tests\n      - run: make\n"
    ),
    TextInvariant()
  )
  failure.check(
    yaml.get(renamed, [Key("name")]) == Some(Text("Build and test")),
    TextInvariant()
  )
  // A failed edit leaves the document unchanged.
  let mut kept = copy doc
  failure.check(
    yaml.set(mut kept, [Key("name"), Key("x")], Integer(1)) == Error(NotCollection()),
    TextInvariant()
  )
  failure.check(
    yaml.set(mut kept, [Key("jobs"), Index(0)], Integer(1)) == Error(NotCollection()),
    TextInvariant()
  )
  failure.check(
    yaml.set(mut kept, [Key("jobs"), Key("test"), Key("steps"), Index(5)], Integer(1)) == Error(
      NotFound()
    ),
    TextInvariant()
  )
  failure.check(yaml.source(kept) == yaml.source(doc), TextInvariant())
  Ok(())
}
