  test.equal(t, path.normalize(path.of("./")), Ok(path.of(".")))
  test.equal(t, path.normalize(path.of("../")), Ok(path.of("..")))
  test.equal(t, path.normalize(path.of("../../")), Ok(path.of("../..")))
  test.equal(t, path.normalize(path.of("/abc/")), Ok(path.of("/abc")))
  test.equal(t, path.normalize(path.of("abc//def//ghi")), Ok(path.of("abc/def/ghi")))
  test.equal(t, path.normalize(path.of("//abc")), Ok(path.of("/abc")))
  test.equal(t, path.normalize(path.of("///abc")), Ok(path.of("/abc")))
  test.equal(t, path.normalize(path.of("//abc//")), Ok(path.of("/abc")))
  test.equal(t, path.normalize(path.of("abc//")), Ok(path.of("abc")))
  test.equal(t, path.normalize(path.of("abc/./def")), Ok(path.of("abc/def")))
