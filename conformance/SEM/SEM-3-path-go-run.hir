  test.equal(t, path.parent(path.of("/")), None())
  test.equal(t, path.parent(path.of("////")), None())
  test.equal(t, path.parent(path.of("/foo")), Some(path.of("/")))
  test.equal(t, path.parent(path.of("x/")), Some(path.of(".")))
  test.equal(t, path.parent(path.of("abc")), Some(path.of(".")))
  test.equal(t, path.parent(path.of("abc/def")), Some(path.of("abc")))
  test.equal(t, path.parent(path.of("abc////def")), Some(path.of("abc")))
  test.equal(t, path.parent(path.of("a/b/.x")), Some(path.of("a/b")))
