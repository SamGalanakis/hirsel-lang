  test.equal(t, path.filename(path.of("/")), None())
  test.equal(t, path.filename(path.of("////")), None())
  test.equal(t, path.filename(path.of("x/")), Some("x"))
  test.equal(t, path.filename(path.of("abc")), Some("abc"))
  test.equal(t, path.filename(path.of("abc/def")), Some("def"))
  test.equal(t, path.filename(path.of("a/b/.x")), Some(".x"))
  test.equal(t, path.filename(path.of("a/b/c.")), Some("c."))
  test.equal(t, path.filename(path.of("a/b/c.x")), Some("c.x"))
  // exttests: Go path_test.go:152
  test.equal(t, path.extension(path.of("path.go")), Some("go"))
