// rule: SEM-1
// expect: run
// Go src/time/time_test.go:945-1005, all 43 parseDurationTests rows, unchanged.
// Commit 7f86f957633ee31a1c17a1eb8452ca7a3d9bc141; BSD-3-Clause.
pub fn main(t: Test) -> Result[(), ()] {
  let vectors: List[(String, i128)] = [
    ("0", 0i128),
    ("5s", 5000000000i128),
    ("30s", 30000000000i128),
    ("1478s", 1478000000000i128),
    ("-5s", -5000000000i128),
    ("+5s", 5000000000i128),
    ("-0", 0i128),
    ("+0", 0i128),
    ("5.0s", 5000000000i128),
    ("5.6s", 5600000000i128),
    ("5.s", 5000000000i128),
    (".5s", 500000000i128),
    ("1.0s", 1000000000i128),
    ("1.00s", 1000000000i128),
    ("1.004s", 1004000000i128),
    ("1.0040s", 1004000000i128),
    ("100.00100s", 100001000000i128),
    ("10ns", 10i128),
    ("11us", 11000i128),
    ("12µs", 12000i128),
    ("12μs", 12000i128),
    ("13ms", 13000000i128),
    ("14s", 14000000000i128),
    ("15m", 900000000000i128),
    ("16h", 57600000000000i128),
    ("3h30m", 12600000000000i128),
    ("10.5s4m", 250500000000i128),
    ("-2m3.4s", -123400000000i128),
    ("1h2m3s4ms5us6ns", 3723004005006i128),
    ("39h9m14.425s", 140954425000000i128),
    ("52763797000ns", 52763797000i128),
    ("0.3333333333333333333h", 1200000000000i128),
    ("9007199254740993ns", 9007199254740993i128),
    ("9223372036854775807ns", 9223372036854775807i128),
    ("9223372036854775.807us", 9223372036854775807i128),
    ("9223372036s854ms775us807ns", 9223372036854775807i128),
    ("-9223372036854775808ns", -9223372036854775808i128),
    ("-9223372036854775.808us", -9223372036854775808i128),
    ("-9223372036s854ms775us808ns", -9223372036854775808i128),
    ("-9223372036854775808ns", -9223372036854775808i128),
    ("-2562047h47m16.854775808s", -9223372036854775808i128),
    ("0.100000000000000000000h", 360000000000i128),
    ("0.830103483285477580700h", 2988372539827i128)
  ]
  for (text, nanos) in vectors {
    test.equal(t, duration.parse(text), Ok(time.Duration(nanoseconds: nanos)))
  }
  Ok(())
}
