// rule: SEM-3
// expect: run
// Published spec.txt vectors; tools/generate-markdown.py.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.check(
    s,
    "commonmark/Autolinks/599",
    "<made-up-scheme://foo,bar>\n",
    "<p><a href=\"made-up-scheme://foo,bar\">made-up-scheme://foo,bar</a></p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Autolinks/600",
    "<https://../>\n",
    "<p><a href=\"https://../\">https://../</a></p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Autolinks/601",
    "<localhost:5001/foo>\n",
    "<p><a href=\"localhost:5001/foo\">localhost:5001/foo</a></p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Autolinks/602",
    "<https://foo.bar/baz bim>\n",
    "<p>&lt;https://foo.bar/baz bim&gt;</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Autolinks/603",
    "<https://example.com/\\[\\>\n",
    "<p><a href=\"https://example.com/%5C%5B%5C\">https://example.com/\\[\\</a></p>\n",
    std@1/markdown.default_options()
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
