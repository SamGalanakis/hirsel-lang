// rule: SEM-1
// expect: run
// entry: main
// Autobahn testsuite cases 3.1, 6.3.1 and 9.x played by scripted clients against
// an echo server with a 1000-byte message limit: a protocol error closes with 1002,
// invalid UTF-8 with 1007 and an oversized message with 1009. The other cases
// run three to a program in SEM-1-websocket-autobahn-{1..7}-run.hir.
pub type AppError = Network(NetError) | Http(http.HttpError)

fn home() -> SocketAddr uses {} {
  SocketAddr(ip: V4([127u8, 0u8, 0u8, 1u8]), port: 9001u16)
}

// Echoes every message; returns the peer's close code or the receive error.
fn echo(take ws: websocket.Conn) -> Result[u16, websocket.WsError] {
  let mut conn = take ws
  while let Some(message) = websocket.receive(mut conn)? {
    match message {
      Text(text) => websocket.send_text(mut conn, text)?,
      Binary(data) => websocket.send_binary(mut conn, data)?,
    }
  }
  match websocket.peer_close(conn) {
    Some((code, _)) => Ok(code),
    None() => Ok(0u16),
  }
}

pub fn main(t: Test) -> Result[(), AppError] {
  let n = test.net(
    t,
    [],
    [
      NetListener(
        address: "127.0.0.1",
        port: 9001u16,
        clients: [
          // Autobahn 3.1 rsv1
          NetClient(
            from: SocketAddr(ip: V4([192u8, 0u8, 2u8, 1u8]), port: 40000u16),
            tls: Plain(),
            steps: [
              Send(
                b"GET / HTTP/1.1\r\nHost: localhost\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\n\r\n"
              ),
              Expect(
                b"HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: s3pPLMBiTxaQ9kYGzzhZRbK+xOo=\r\n\r\n"
              ),
              Send(b"\xc1\x85\x124VxZQ:\x14}"),
              Expect(b"\x88\x02\x03\xea")
            ]
          ),
          // Autobahn 6.3.1 invalid UTF-8
          NetClient(
            from: SocketAddr(ip: V4([192u8, 0u8, 2u8, 1u8]), port: 40001u16),
            tls: Plain(),
            steps: [
              Send(
                b"GET / HTTP/1.1\r\nHost: localhost\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\n\r\n"
              ),
              Expect(
                b"HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: s3pPLMBiTxaQ9kYGzzhZRbK+xOo=\r\n\r\n"
              ),
              Send(
                b"\x81\x94\x124Vx\xdc\x8e\xb7\xc5\xab\xfb\xd5\xb6\xae\xfa\xe3\x95\xb2\xb43\x1c{@3\x1c"
              ),
              Expect(b"\x88\x02\x03\xef")
            ]
          ),
          // Autobahn 9.x message above the limit
          NetClient(
            from: SocketAddr(ip: V4([192u8, 0u8, 2u8, 1u8]), port: 40002u16),
            tls: Plain(),
            steps: [
              Send(
                b"GET / HTTP/1.1\r\nHost: localhost\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\n\r\n"
              ),
              Expect(
                b"HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: s3pPLMBiTxaQ9kYGzzhZRbK+xOo=\r\n\r\n"
              ),
              Send(
                b"\x02\xfe\x02X\x124VxsU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19sU7\x19\x80\xfe\x02X\x124VxpV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1apV4\x1a"
              ),
              Expect(b"\x88\x02\x03\xf1")
            ]
          )
        ]
      )
    ]
  )
  let expected: List[Result[u16, websocket.WsError]] = [
    Error(Protocol(ReservedBits())),
    Error(Protocol(InvalidUtf8())),
    Error(Protocol(TooLarge()))
  ]
  let mut config = websocket.default_config()
  config.max_message_bytes = 1000
  let mut listener = net.listen(n, home()) ? Network
  for outcome in expected {
    let (stream, _) = net.accept(n, mut listener) ? Network
    let mut connection = http.server_connection(n, take stream, http.default_config())
    let request = http.receive_request(mut connection, None()) ? Http
    let ws = match websocket.accept(take connection, request, config) {
      Ok(ws) => ws,
      Error(_) => {
        test.check(t, false)
        return Ok(())
      },
    }
    test.check(t, echo(take ws) == outcome)
  }
  Ok(())
}
