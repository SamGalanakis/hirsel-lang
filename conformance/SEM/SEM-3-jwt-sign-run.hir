// rule: SEM-3
// expect: run
// entry: main
// golang-jwt hmac_example_test.go ExampleNewWithClaims_hmac: signing
// {"foo":"bar","nbf":1444478400} with test/hmacTestKey gives the documented
// token (golang-jwt/jwt d2cffb184933cab5b685db7e9eea56326f0acc0d); one MAC per
// program, as the corpus step budget allows.
fn test_key() -> Bytes uses {} {
  b"\x03#5K+\x0f\xa5\xbc\x83~\x06ew{\xa6\x8fZ\xb3(\xe6\xf0T\xc9(\xa9\x0f\x84\xb2\xd2P.\xbf\xd3\xfbZ\x92\xd2\x06G\xef\x96\x8a\xb4\xc3wb=\"=.!r\x05.O\x08\xc0\xcd\x9a\xf5g\xd0\x80\xa3"
}

pub fn main(t: Test) -> Result[(), jwt.JwtError] {
  let mut claims: Map[String, json.Value] = map.empty()
  map.insert(mut claims, "foo", Text("bar"))
  map.insert(mut claims, "nbf", Number("1444478400"))
  test.check(
    t,
    jwt.sign(HS256(test_key()), Object(take claims)) == Ok(
      "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJmb28iOiJiYXIiLCJuYmYiOjE0NDQ0Nzg0MDB9.u1riaD1rW97opCoAuRCTy4w58Br-Zk-bh7vLiRIsrpU"
    )
  )
  Ok(())
}
