// Twins for the URI validation and HTTP/1.0 framing rules exposed above.
@test
fn target_boundaries(t: Test) -> Result[(), http.HttpError] {
  rejected(t, b"GET /bad% HTTP/1.1\r\n\r\n", Malformed(Token()))
  rejected(t, b"GET /bad%xx HTTP/1.1\r\n\r\n", Malformed(Token()))
  rejected(t, b"CONNECT [::1]garbage HTTP/1.1\r\n\r\n", Malformed(Token()))
  incoming(
    t,
    b"GET /ok%20path?q=%xx HTTP/1.1\r\n\r\n",
    "GET",
    "/ok%20path?q=%xx",
    Http11(),
    true,
    b"",
    [],
    [],
    33
  )?
  incoming(
    t,
    b"CONNECT [::1]:443 HTTP/1.1\r\n\r\n",
    "CONNECT",
    "[::1]:443",
    Http11(),
    true,
    b"",
    [],
    [],
    30
  )?
  incoming(
    t,
    b"POST / HTTP/1.0\r\nTransfer-Encoding: bogus\r\nContent-Length: 2\r\nConnection: keep-alive\r\n\r\nok",
    "POST",
    "/",
    Http10(),
    false,
    b"ok",
    [
      http.Header(name: "Transfer-Encoding", value: "bogus"),
      http.Header(name: "Content-Length", value: "2"),
      http.Header(name: "Connection", value: "keep-alive")
    ],
    [],
    90
  )
}
