// rule: SEM-1
// expect: test
// Go ebe2feefc400 src/net/http/{response_test.go:39,readrequest_test.go:30}.
// Literal upstream tables, adapted to owned headers, raw request targets and
// scripted Net. See docs/http1-prior-art.md for representation/policy differences.
fn incoming(
  t: Test,
  raw: Bytes,
  method: String,
  target: String,
  version: http.Version,
  keep: bool,
  body: Bytes,
  headers: List[http.Header],
  trailers: List[http.Header],
  consumed: u64
) -> Result[(), http.HttpError] {
  match http.parse_server_request(raw, http.default_config())? {
    Some((request, end)) => {
      test.check(t, request.method == method && request.target == target)
      test.check(t, request.version == version && request.keep_alive == keep)
      test.check(t, request.body == body && request.trailers == trailers)
      test.check(t, request.headers == headers && end == consumed)
    },
    None() => test.check(t, false),
  }
  Ok(())
}

fn rejected(t: Test, raw: Bytes, expected: http.HttpError) {
  test.check(
    t,
    http.parse_server_request(raw, http.default_config()) == Error(expected)
  )
}

// readrequest_test.go:33, reqTests[0]
@test
fn request_0(t: Test) -> Result[(), http.HttpError] {
  incoming(
    t,
    b"GET http://www.techcrunch.com/ HTTP/1.1\r\nHost: www.techcrunch.com\r\nUser-Agent: Fake\r\nAccept: text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8\r\nAccept-Language: en-us,en;q=0.5\r\nAccept-Encoding: gzip,deflate\r\nAccept-Charset: ISO-8859-1,utf-8;q=0.7,*;q=0.7\r\nKeep-Alive: 300\r\nContent-Length: 7\r\nProxy-Connection: keep-alive\r\n\r\nabcdef\n???",
    "GET",
    "http://www.techcrunch.com/",
    Http11(),
    true,
    b"abcdef\n",
    [
      http.Header(name: "Host", value: "www.techcrunch.com"),
      http.Header(name: "User-Agent", value: "Fake"),
      http.Header(
        name: "Accept",
        value: "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8"
      ),
      http.Header(name: "Accept-Language", value: "en-us,en;q=0.5"),
      http.Header(name: "Accept-Encoding", value: "gzip,deflate"),
      http.Header(name: "Accept-Charset", value: "ISO-8859-1,utf-8;q=0.7,*;q=0.7"),
      http.Header(name: "Keep-Alive", value: "300"),
      http.Header(name: "Content-Length", value: "7"),
      http.Header(name: "Proxy-Connection", value: "keep-alive")
    ],
    [],
    345
  )
}

