// rule: SEM-5
// expect: run
// Rust tests.rs:841-852: borrowed String bounds.

pub fn main(t: Test) -> Result[(), ()] {
  let mut m: ordered_map.OrderedMap[String,i32] = ordered_map.empty(fn(a: String,b: String) -> i32 uses {} { if a < b { -1 } else if a > b { 1 } else { 0 } })
  ordered_map.insert(mut m, "aardvark", 1)
  ordered_map.insert(mut m, "baboon", 2)
  ordered_map.insert(mut m, "coyote", 3)
  ordered_map.insert(mut m, "dingo", 4)
  let result = ordered_map.fold_range(m, Included("b"), Excluded("d"), Ascending(), [], fn(take acc: List[i32], k: String, v: i32) -> (List[i32],bool) {
    let mut out = take acc
    list.push(mut out, v)
    (take out,true)
  })
  failure.check(result == [2,3], Bounds())
  Ok(())
}
