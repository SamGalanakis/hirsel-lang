// rule: SEM-3
// expect: run
// Generated by tools/generate-toml-test.py from toml-test ff49d109861c
// tests/files-toml-1.0.0, group valid-spec.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.valid(
    s,
    "valid/spec-1.0.0/keys-5",
    "# VALID BUT DISCOURAGED\n\napple.type = \"fruit\"\norange.type = \"fruit\"\n\napple.skin = \"thin\"\norange.skin = \"thick\"\n\napple.color = \"red\"\norange.color = \"orange\"\n",
    "{\"apple\":{\"color\":{\"type\":\"string\",\"value\":\"red\"},\"skin\":{\"type\":\"string\",\"value\":\"thin\"},\"type\":{\"type\":\"string\",\"value\":\"fruit\"}},\"orange\":{\"color\":{\"type\":\"string\",\"value\":\"orange\"},\"skin\":{\"type\":\"string\",\"value\":\"thick\"},\"type\":{\"type\":\"string\",\"value\":\"fruit\"}}}"
  )
  failed += harness.valid(
    s,
    "valid/spec-1.0.0/keys-6",
    "# RECOMMENDED\n\napple.type = \"fruit\"\napple.skin = \"thin\"\napple.color = \"red\"\n\norange.type = \"fruit\"\norange.skin = \"thick\"\norange.color = \"orange\"\n",
    "{\"apple\":{\"color\":{\"type\":\"string\",\"value\":\"red\"},\"skin\":{\"type\":\"string\",\"value\":\"thin\"},\"type\":{\"type\":\"string\",\"value\":\"fruit\"}},\"orange\":{\"color\":{\"type\":\"string\",\"value\":\"orange\"},\"skin\":{\"type\":\"string\",\"value\":\"thick\"},\"type\":{\"type\":\"string\",\"value\":\"fruit\"}}}"
  )
  failed += harness.valid(
    s,
    "valid/spec-1.0.0/keys-7",
    "3.14159 = \"pi\"\n",
    "{\"3\":{\"14159\":{\"type\":\"string\",\"value\":\"pi\"}}}"
  )
  failed += harness.valid(
    s,
    "valid/spec-1.0.0/local-date-0",
    "ld1 = 1979-05-27\n",
    "{\"ld1\":{\"type\":\"date-local\",\"value\":\"1979-05-27\"}}"
  )
  failed += harness.valid(
    s,
    "valid/spec-1.0.0/local-date-time-0",
    "ldt1 = 1979-05-27T07:32:00\nldt2 = 1979-05-27T00:32:00.999\n",
    "{\"ldt1\":{\"type\":\"datetime-local\",\"value\":\"1979-05-27T07:32:00\"},\"ldt2\":{\"type\":\"datetime-local\",\"value\":\"1979-05-27T00:32:00.999\"}}"
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
