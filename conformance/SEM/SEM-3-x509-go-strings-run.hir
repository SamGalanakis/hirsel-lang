// See docs/x509-prior-art.md for source lines and envelope adaptations.
fn subject(der: Bytes) -> Option[String] uses {} {
  match x509.parse(der) {
    Ok(c) => Some(c.subject),
    Error(_) => None(),
  }
}

pub fn main(t: Test) -> Result[(), x509.X509Error] {
  // TestParseASN1String 1/15: T61String (parser_test.go:25-149).
  test.check(
    t,
    subject(
      b"\x30\x1d\x30\x1b\x02\x01\x01\x30\x00\x30\x00\x30\x00\x30\x0e\x31\x0c\x30\x0a\x06\x03\x55\x04\x03\x14\x03\xbf\x61\x3f\x30\x00"
    ) == Some("CN=¿a?")
  )
  // TestParseASN1String 2/15: PrintableString (parser_test.go:25-149).
  test.check(
    t,
    subject(
      b"\x30\x1d\x30\x1b\x02\x01\x01\x30\x00\x30\x00\x30\x00\x30\x0e\x31\x0c\x30\x0a\x06\x03\x55\x04\x03\x13\x03\x50\x51\x52\x30\x00"
    ) == Some("CN=PQR")
  )
  // TestParseASN1String 3/15: PrintableString invalid (parser_test.go:25-149).
  test.check(
    t,
    subject(
      b"\x30\x1d\x30\x1b\x02\x01\x01\x30\x00\x30\x00\x30\x00\x30\x0e\x31\x0c\x30\x0a\x06\x03\x55\x04\x03\x13\x03\x01\x02\x03\x30\x00"
    ) == None()
  )
  // TestParseASN1String 3/15: PrintableString invalid (parser_test.go:25-149).
  test.check(
    t,
    subject(
      b"\x30\x1d\x30\x1b\x02\x01\x01\x30\x00\x30\x00\x30\x00\x30\x0e\x31\x0c\x30\x0a\x06\x03\x2a\x03\x04\x13\x03\x01\x02\x03\x30\x00"
    ) == None()
  )
  // TestParseASN1String 4/15: UTF8String (parser_test.go:25-149).
  test.check(
    t,
    subject(
      b"\x30\x1d\x30\x1b\x02\x01\x01\x30\x00\x30\x00\x30\x00\x30\x0e\x31\x0c\x30\x0a\x06\x03\x55\x04\x03\x0c\x03\x50\x51\x52\x30\x00"
    ) == Some("CN=PQR")
  )
  // TestParseASN1String 5/15: UTF8String invalid (parser_test.go:25-149).
  test.check(
    t,
    subject(
      b"\x30\x1b\x30\x19\x02\x01\x01\x30\x00\x30\x00\x30\x00\x30\x0c\x31\x0a\x30\x08\x06\x03\x55\x04\x03\x0c\x01\xff\x30\x00"
    ) == None()
  )
  // TestParseASN1String 5/15: UTF8String invalid (parser_test.go:25-149).
  test.check(
    t,
    subject(
      b"\x30\x1b\x30\x19\x02\x01\x01\x30\x00\x30\x00\x30\x00\x30\x0c\x31\x0a\x30\x08\x06\x03\x2a\x03\x04\x0c\x01\xff\x30\x00"
    ) == None()
  )
  // TestParseASN1String 6/15: BMPString (parser_test.go:25-149).
  test.check(
    t,
    subject(
      b"\x30\x1c\x30\x1a\x02\x01\x01\x30\x00\x30\x00\x30\x00\x30\x0d\x31\x0b\x30\x09\x06\x03\x55\x04\x03\x1e\x02\x50\x51\x30\x00"
    ) == Some("CN=偑")
  )
  // TestParseASN1String 7/15: BMPString invalid length (parser_test.go:25-149).
  test.check(
    t,
    subject(
      b"\x30\x1b\x30\x19\x02\x01\x01\x30\x00\x30\x00\x30\x00\x30\x0c\x31\x0a\x30\x08\x06\x03\x55\x04\x03\x1e\x01\xff\x30\x00"
    ) == None()
  )
  // TestParseASN1String 7/15: BMPString invalid length (parser_test.go:25-149).
  test.check(
    t,
    subject(
      b"\x30\x1b\x30\x19\x02\x01\x01\x30\x00\x30\x00\x30\x00\x30\x0c\x31\x0a\x30\x08\x06\x03\x2a\x03\x04\x1e\x01\xff\x30\x00"
    ) == None()
  )
  // TestParseASN1String 8/15: BMPString invalid surrogate (parser_test.go:25-149).
  test.check(
    t,
    subject(
      b"\x30\x1e\x30\x1c\x02\x01\x01\x30\x00\x30\x00\x30\x00\x30\x0f\x31\x0d\x30\x0b\x06\x03\x55\x04\x03\x1e\x04\x50\x51\xd8\x01\x30\x00"
    ) == None()
  )
  // TestParseASN1String 8/15: BMPString invalid surrogate (parser_test.go:25-149).
  test.check(
    t,
    subject(
      b"\x30\x1e\x30\x1c\x02\x01\x01\x30\x00\x30\x00\x30\x00\x30\x0f\x31\x0d\x30\x0b\x06\x03\x2a\x03\x04\x1e\x04\x50\x51\xd8\x01\x30\x00"
    ) == None()
  )
  // TestParseASN1String 9/15: BMPString invalid noncharacter fdd1 (parser_test.go:25-149).
  test.check(
    t,
    subject(
      b"\x30\x1e\x30\x1c\x02\x01\x01\x30\x00\x30\x00\x30\x00\x30\x0f\x31\x0d\x30\x0b\x06\x03\x55\x04\x03\x1e\x04\x50\x51\xfd\xd1\x30\x00"
    ) == None()
  )
  // TestParseASN1String 9/15: BMPString invalid noncharacter fdd1 (parser_test.go:25-149).
  test.check(
    t,
    subject(
      b"\x30\x1e\x30\x1c\x02\x01\x01\x30\x00\x30\x00\x30\x00\x30\x0f\x31\x0d\x30\x0b\x06\x03\x2a\x03\x04\x1e\x04\x50\x51\xfd\xd1\x30\x00"
    ) == None()
  )
  // TestParseASN1String 10/15: BMPString invalid noncharacter ffff (parser_test.go:25-149).
  test.check(
    t,
    subject(
      b"\x30\x1e\x30\x1c\x02\x01\x01\x30\x00\x30\x00\x30\x00\x30\x0f\x31\x0d\x30\x0b\x06\x03\x55\x04\x03\x1e\x04\x50\x51\xff\xff\x30\x00"
    ) == None()
  )
  // TestParseASN1String 10/15: BMPString invalid noncharacter ffff (parser_test.go:25-149).
  test.check(
    t,
    subject(
      b"\x30\x1e\x30\x1c\x02\x01\x01\x30\x00\x30\x00\x30\x00\x30\x0f\x31\x0d\x30\x0b\x06\x03\x2a\x03\x04\x1e\x04\x50\x51\xff\xff\x30\x00"
    ) == None()
  )
  // TestParseASN1String 11/15: BMPString invalid noncharacter fffe (parser_test.go:25-149).
  test.check(
    t,
    subject(
      b"\x30\x1e\x30\x1c\x02\x01\x01\x30\x00\x30\x00\x30\x00\x30\x0f\x31\x0d\x30\x0b\x06\x03\x55\x04\x03\x1e\x04\x50\x51\xff\xfe\x30\x00"
    ) == None()
  )
  // TestParseASN1String 11/15: BMPString invalid noncharacter fffe (parser_test.go:25-149).
  test.check(
    t,
    subject(
      b"\x30\x1e\x30\x1c\x02\x01\x01\x30\x00\x30\x00\x30\x00\x30\x0f\x31\x0d\x30\x0b\x06\x03\x2a\x03\x04\x1e\x04\x50\x51\xff\xfe\x30\x00"
    ) == None()
  )
  // TestParseASN1String 12/15: IA5String (parser_test.go:25-149).
  test.check(
    t,
    subject(
      b"\x30\x1c\x30\x1a\x02\x01\x01\x30\x00\x30\x00\x30\x00\x30\x0d\x31\x0b\x30\x09\x06\x03\x55\x04\x03\x16\x02\x50\x51\x30\x00"
    ) == Some("CN=PQ")
  )
  // TestParseASN1String 13/15: IA5String invalid (parser_test.go:25-149).
  test.check(
    t,
    subject(
      b"\x30\x1b\x30\x19\x02\x01\x01\x30\x00\x30\x00\x30\x00\x30\x0c\x31\x0a\x30\x08\x06\x03\x55\x04\x03\x16\x01\xff\x30\x00"
    ) == None()
  )
  // TestParseASN1String 13/15: IA5String invalid (parser_test.go:25-149).
  test.check(
    t,
    subject(
      b"\x30\x1b\x30\x19\x02\x01\x01\x30\x00\x30\x00\x30\x00\x30\x0c\x31\x0a\x30\x08\x06\x03\x2a\x03\x04\x16\x01\xff\x30\x00"
    ) == None()
  )
  // TestParseASN1String 14/15: NumericString (parser_test.go:25-149).
  test.check(
    t,
    subject(
      b"\x30\x1c\x30\x1a\x02\x01\x01\x30\x00\x30\x00\x30\x00\x30\x0d\x31\x0b\x30\x09\x06\x03\x55\x04\x03\x12\x02\x31\x32\x30\x00"
    ) == Some("CN=12")
  )
  // TestParseASN1String 15/15: NumericString invalid (parser_test.go:25-149).
  test.check(
    t,
    subject(
      b"\x30\x1b\x30\x19\x02\x01\x01\x30\x00\x30\x00\x30\x00\x30\x0c\x31\x0a\x30\x08\x06\x03\x55\x04\x03\x12\x01\x50\x30\x00"
    ) == None()
  )
  // TestParseASN1String 15/15: NumericString invalid (parser_test.go:25-149).
  test.check(
    t,
    subject(
      b"\x30\x1b\x30\x19\x02\x01\x01\x30\x00\x30\x00\x30\x00\x30\x0c\x31\x0a\x30\x08\x06\x03\x2a\x03\x04\x12\x01\x50\x30\x00"
    ) == None()
  )
  Ok(())
}
