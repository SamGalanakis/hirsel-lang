// rule: SEM-3
// expect: run
// Published spec.txt vectors; tools/generate-markdown.py.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.check(
    s,
    "commonmark/Raw HTML/622/malformed",
    "<a href='bar'\u{0}[&unterminated",
    "<p>&lt;a href='bar'�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Raw HTML/623/malformed",
    "</a></\u{0}[&unterminated",
    "<p></a>&lt;/�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Raw HTML/624/malformed",
    "</a href\u{0}[&unterminated",
    "<p>&lt;/a href�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Raw HTML/625/malformed",
    "foo <!-- this is a --\nco\u{0}[&unterminated",
    "<p>foo &lt;!-- this is a --\nco�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
