// rule: SEM-3
// expect: run
// Rust alloctests/tests/str.rs:86-100: every scalar-aligned substring,
// first occurrence <= i and last occurrence >= i; exact offsets from Rust semantics.
@noalloc
fn offset(s: String, pat: String, reverse: bool) -> Option[u64] uses {} {
  let found = if reverse {
    string.rfind(s, pat)
  } else {
    string.find(s, pat)
  }
  match found {
    Some(at) => Some(core@1/string.byte_offset(s, at)),
    None() => None(),
  }
}

pub fn main() -> Result[(), ()] {
  failure.check(
    offset("Việt Namacbaabcaabaaba", "bcaabaaba", false) == Some(15u64),
    TextInvariant()
  )
  failure.check(
    offset("Việt Namacbaabcaabaaba", "bcaabaaba", true) == Some(15u64),
    TextInvariant()
  )
