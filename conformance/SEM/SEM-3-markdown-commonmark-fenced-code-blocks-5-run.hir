// rule: SEM-3
// expect: run
// Published spec.txt vectors; tools/generate-markdown.py.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.check(
    s,
    "commonmark/Fenced code blocks/142",
    "```ruby\ndef foo(x)\n  return 3\nend\n```\n",
    "<pre><code class=\"language-ruby\">def foo(x)\n  return 3\nend\n</code></pre>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Fenced code blocks/143",
    "~~~~    ruby startline=3 $%@#$\ndef foo(x)\n  return 3\nend\n~~~~~~~\n",
    "<pre><code class=\"language-ruby\">def foo(x)\n  return 3\nend\n</code></pre>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Fenced code blocks/144",
    "````;\n````\n",
    "<pre><code class=\"language-;\"></code></pre>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Fenced code blocks/145",
    "``` aa ```\nfoo\n",
    "<p><code>aa</code>\nfoo</p>\n",
    std@1/markdown.default_options()
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
