// rule: SEM-3
// expect: run
// Published spec.txt vectors; tools/generate-markdown.py.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.check(
    s,
    "commonmark/Raw HTML/617/malformed",
    "Foo <responsive-ima\u{0}[&unterminated",
    "<p>Foo &lt;responsive-ima�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Raw HTML/618/malformed",
    "<33> \u{0}[&unterminated",
    "<p>&lt;33&gt; �[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Raw HTML/619/malformed",
    "<a h*#re\u{0}[&unterminated",
    "<p>&lt;a h*#re�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Raw HTML/620/malformed",
    "<a href=\"hi'>\u{0}[&unterminated",
    "<p>&lt;a href=&quot;hi'&gt;�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Raw HTML/621/malformed",
    "< a><\nfoo><bar/ >\n<fo\u{0}[&unterminated",
    "<p>&lt; a&gt;&lt;\nfoo&gt;&lt;bar/ &gt;\n&lt;fo�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
