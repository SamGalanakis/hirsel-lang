// rule: SEM-3
// expect: run
// google/uuid uuid_test.go tests (TestUUID, in both cases) and TestFromBytes
// (google/uuid 2d3c2a9c), uuid-rs parser.rs test_parse_valid and the inputs of
// test_parse_invalid (uuid-rs/uuid 276c2362; offsets are this module's), and the
// RFC 9562 appendix A.3 and A.6 examples. The default run's Random is
// random.splitmix64@1 with seed 0; expected draws come from SplitMix64.
fn go_vectors() -> List[(String, Option[(u8, uuid.Variant)])] uses {} {
  [
    ("f47ac10b-58cc-0372-8567-0e02b2c3d479", Some((0u8, Rfc9562()))),
    ("f47ac10b-58cc-1372-8567-0e02b2c3d479", Some((1u8, Rfc9562()))),
    ("f47ac10b-58cc-2372-8567-0e02b2c3d479", Some((2u8, Rfc9562()))),
    ("f47ac10b-58cc-3372-8567-0e02b2c3d479", Some((3u8, Rfc9562()))),
    ("f47ac10b-58cc-4372-8567-0e02b2c3d479", Some((4u8, Rfc9562()))),
    ("f47ac10b-58cc-5372-8567-0e02b2c3d479", Some((5u8, Rfc9562()))),
    ("f47ac10b-58cc-6372-8567-0e02b2c3d479", Some((6u8, Rfc9562()))),
    ("f47ac10b-58cc-7372-8567-0e02b2c3d479", Some((7u8, Rfc9562()))),
    ("f47ac10b-58cc-8372-8567-0e02b2c3d479", Some((8u8, Rfc9562()))),
    ("f47ac10b-58cc-9372-8567-0e02b2c3d479", Some((9u8, Rfc9562()))),
    ("f47ac10b-58cc-a372-8567-0e02b2c3d479", Some((10u8, Rfc9562()))),
    ("f47ac10b-58cc-b372-8567-0e02b2c3d479", Some((11u8, Rfc9562()))),
    ("f47ac10b-58cc-c372-8567-0e02b2c3d479", Some((12u8, Rfc9562()))),
    ("f47ac10b-58cc-d372-8567-0e02b2c3d479", Some((13u8, Rfc9562()))),
    ("f47ac10b-58cc-e372-8567-0e02b2c3d479", Some((14u8, Rfc9562()))),
    ("f47ac10b-58cc-f372-8567-0e02b2c3d479", Some((15u8, Rfc9562()))),
    ("urn:uuid:f47ac10b-58cc-4372-0567-0e02b2c3d479", Some((4u8, Ncs()))),
    ("URN:UUID:f47ac10b-58cc-4372-0567-0e02b2c3d479", Some((4u8, Ncs()))),
    ("f47ac10b-58cc-4372-0567-0e02b2c3d479", Some((4u8, Ncs()))),
    ("f47ac10b-58cc-4372-1567-0e02b2c3d479", Some((4u8, Ncs()))),
    ("f47ac10b-58cc-4372-2567-0e02b2c3d479", Some((4u8, Ncs()))),
    ("f47ac10b-58cc-4372-3567-0e02b2c3d479", Some((4u8, Ncs()))),
    ("f47ac10b-58cc-4372-4567-0e02b2c3d479", Some((4u8, Ncs()))),
    ("f47ac10b-58cc-4372-5567-0e02b2c3d479", Some((4u8, Ncs()))),
    ("f47ac10b-58cc-4372-6567-0e02b2c3d479", Some((4u8, Ncs()))),
    ("f47ac10b-58cc-4372-7567-0e02b2c3d479", Some((4u8, Ncs())))
  ]
}

pub fn main(t: Test) -> Result[(), uuid.UuidError] {
  let mut case: u64 = 0
  for (spelling, expected) in go_vectors() {
    let forms: List[String] = [copy spelling, string.ascii_upper(spelling)]
    for form in forms {
      let found: Option[(u8, uuid.Variant)] = match uuid.parse(form) {
        Ok(id) => Some((uuid.version(id), uuid.variant(id))),
        Error(_) => None(),
      }
      test.check_case(t, found == expected, case)
    }
    case += 1
  }
  Ok(())
}
