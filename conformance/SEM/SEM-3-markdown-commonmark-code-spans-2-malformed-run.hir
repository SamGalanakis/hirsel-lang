// rule: SEM-3
// expect: run
// Published spec.txt vectors; tools/generate-markdown.py.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.check(
    s,
    "commonmark/Code spans/335/malformed",
    "``\nfoo\nbar\u{0}[&unterminated",
    "<p>``\nfoo\nbar�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Code spans/336/malformed",
    "``\nfo\u{0}[&unterminated",
    "<p>``\nfo�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Code spans/337/malformed",
    "`foo   b\u{0}[&unterminated",
    "<p>`foo   b�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Code spans/338/malformed",
    "`foo\\\u{0}[&unterminated",
    "<p>`foo\\�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Code spans/339/malformed",
    "``foo`\u{0}[&unterminated",
    "<p>``foo`�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Code spans/340/malformed",
    "` foo `\u{0}[&unterminated",
    "<p><code>foo</code>�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
