// rule: SEM-3
// expect: run
// Published spec.txt vectors; tools/generate-markdown.py.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.check(
    s,
    "commonmark/HTML blocks/188/malformed",
    "<div>\n\n*Emphasize\u{0}[&unterminated",
    "<div>\n<p>*Emphasize�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/HTML blocks/189/malformed",
    "<div>\n*Emphasize\u{0}[&unterminated",
    "<div>\n*Emphasize�[&unterminated\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/HTML blocks/190/malformed",
    "<table>\n\n<tr>\n\n<td>\nHi\n\u{0}[&unterminated",
    "<table>\n<tr>\n<td>\nHi\n�[&unterminated\n",
    std@1/markdown.default_options()
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
