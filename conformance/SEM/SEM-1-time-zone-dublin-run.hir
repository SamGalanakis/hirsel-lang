// rule: SEM-1
// expect: run
// Europe/Dublin from jiff's TZif test file, whose DST is an hour behind
// standard time: its gap opens in March and its fold in October.
pub fn main(t: Test) -> Result[(), ()] {
  let zone = test.expect_ok(t, time_zone.from_tzif(zones.DUBLIN))
  check.ambiguity(
    t,
    zone,
    [
      ("1970-01-01T00:00:00", 0, 3600, 3600),
      ("2024-03-31T00:59:59.999999999", 0, 0, 0),
      ("2024-03-31T01:00:00", 1, 0, 3600),
      ("2024-03-31T01:59:59.999999999", 1, 0, 3600),
      ("2024-03-31T02:00:00", 0, 3600, 3600),
      ("2024-10-27T00:59:59.999999999", 0, 3600, 3600),
      ("2024-10-27T01:00:00", 2, 3600, 0),
      ("2024-10-27T01:59:59.999999999", 2, 3600, 0),
      ("2024-10-27T02:00:00", 0, 0, 0)
    ]
  )
  check.instants(
    t,
    zone,
    [
      (1711846800000000000, 3600, "2024-03-31T02:00:00"),
      (1711846799000000000, 0, "2024-03-31T00:59:59"),
      (1729990800000000000, 0, "2024-10-27T01:00:00"),
      (1729990799000000000, 3600, "2024-10-27T01:59:59")
    ]
  )
  Ok(())
}
