// rule: SEM-3
// expect: run
// Go ebe2feef capture/flag/replacement vectors (BSD-3-Clause).
// RE2 data Copyright 2009 The RE2 Authors (BSD-3-Clause).
fn check(
  pattern: String,
  input: String,
  replacement: String,
  expected: String,
  literal: bool
) -> Result[(), ()] {
  let Ok(re) = regex.compile(pattern, 10000) else {
    return Error(())
  }
  let actual = if literal {
    regex.replace_all_literal(re, input, replacement, 1000000)
  } else {
    regex.replace_all(re, input, replacement, 1000000)
  }
  failure.check(actual == Ok(expected), TextInvariant())
  Ok(())
}

pub fn main() -> Result[(), ()] {
  // Go all_test.go:148
  check("", "", "", "", false)?
  // Go all_test.go:149
  check("", "", "x", "x", false)?
  // Go all_test.go:150
  check("", "abc", "", "abc", false)?
  // Go all_test.go:151
  check("", "abc", "x", "xaxbxcx", false)?
  // Go all_test.go:154
  check("b", "", "", "", false)?
  // Go all_test.go:155
  check("b", "", "x", "", false)?
  // Go all_test.go:156
  check("b", "abc", "", "ac", false)?
  // Go all_test.go:157
  check("b", "abc", "x", "axc", false)?
  Ok(())
}
