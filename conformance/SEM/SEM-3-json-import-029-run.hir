// rule: SEM-3
// expect: run
// Generated by tools/generate-json-vectors.py; see docs/json-domain-vectors.md.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.parses(s, "y_array_empty-string.json:1", "[\"\"]", 0)
  failed += harness.parses(s, "y_array_empty.json:1", "[]", 0)
  failed += harness.parses(s, "y_array_ending_with_newline.json:1", "[\"a\"]", 0)
  failed += harness.parses(s, "y_array_false.json:1", "[false]", 0)
  failed += harness.parses(s, "y_array_heterogeneous.json:1", "[null, 1, \"1\", {}]", 0)
  failed += harness.parses(s, "y_array_null.json:1", "[null]", 0)
  failed += harness.parses(s, "y_array_with_1_and_newline.json:1", "[1\n]", 0)
  failed += harness.parses(s, "y_array_with_leading_space.json:1", " [1]", 0)
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
