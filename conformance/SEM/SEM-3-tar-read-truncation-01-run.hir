// rule: SEM-3
// expect: run
// Go tar/reader_test.go:819, TestReadTruncation row 1.
// Both automatic and manual discard, with whole and short refills.
type Source {
  data: Bytes,
  at: u64,
  chunk: u64,
}

fn feed(mut s: Source, mut buffer: List[u8], requested: u64) -> Result[u64, ()] {
  let n = if requested < s.chunk {
    requested
  } else {
    s.chunk
  }
  let end = if s.at + n < core@1/bytes.len(s.data) {
    s.at + n
  } else {
    core@1/bytes.len(s.data)
  }
  for byte in core@1/bytes.slice(s.data, s.at, end) {
    list.push(mut buffer, byte)
  }
  let fed = end - s.at
  s.at = end
  Ok(fed)
}

fn error_kind(e: tar.ReadError[()]) -> u64 {
  match e {
    Archive(Truncated()) => 1,
    Archive(Header(_)) => 2,
    _ => 3,
  }
}

fn scan(data: Bytes, chunk: u64, manual: bool) -> (u64, u64) {
  let mut t = tar.reader(None())
  let mut r = bufio.new(chunk)
  let mut source = Source(data: data, at: 0, chunk: chunk)
  let mut count: u64 = 0
  while true {
    match tar.next(mut t, mut r, mut source, feed) {
      Ok(None()) => return (count, 0),
      Error(e) => return (count, error_kind(e)),
      Ok(Some(_)) => {
        count += 1
        if manual {
          let mut body: List[u8] = []
          while true {
            match tar.read(mut t, mut r, mut source, feed, mut body, 4096) {
              Ok(0) => break,
              Ok(_) => {},
              Error(e) => return (count, error_kind(e)),
            }
          }
        }
      },
    }
  }
  (count, 3)
}

pub fn main(t: Test) -> Result[(), ()] {
  let data = b"small.txt\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x000000640\x000216501\x000011610\x0000000000005\x0011213074064\x00012105\x00 0\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00ustar  \x00dsymonds\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00eng\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00"
  test.check(t, scan(data, 512, false) == (0, 1))
  test.check(t, scan(data, 512, true) == (0, 1))
  test.check(t, scan(data, 17, false) == (0, 1))
  test.check(t, scan(data, 17, true) == (0, 1))
  Ok(())
}
