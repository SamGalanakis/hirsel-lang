// rule: SEM-3
// expect: run
// Published spec.txt vectors; tools/generate-markdown.py.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.check(
    s,
    "commonmark/Indented code blocks/111",
    "    chunk1\n\n    chunk2\n  \n \n \n    chunk3\n",
    "<pre><code>chunk1\n\nchunk2\n\n\n\nchunk3\n</code></pre>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Indented code blocks/112",
    "    chunk1\n      \n      chunk2\n",
    "<pre><code>chunk1\n  \n  chunk2\n</code></pre>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Indented code blocks/113",
    "Foo\n    bar\n\n",
    "<p>Foo\nbar</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Indented code blocks/114",
    "    foo\nbar\n",
    "<pre><code>foo\n</code></pre>\n<p>bar</p>\n",
    std@1/markdown.default_options()
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
