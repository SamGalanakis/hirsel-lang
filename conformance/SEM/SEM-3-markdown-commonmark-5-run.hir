    "<p>[link](/url &quot;title &quot;and&quot; title&quot;)</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Links/509",
    "[link](/url 'title \"and\" title')\n",
    "<p><a href=\"/url\" title=\"title &quot;and&quot; title\">link</a></p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Links/510",
    "[link](   /uri\n  \"title\"  )\n",
    "<p><a href=\"/uri\" title=\"title\">link</a></p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Links/511",
    "[link] (/uri)\n",
    "<p>[link] (/uri)</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Links/512",
    "[link [foo [bar]]](/uri)\n",
    "<p><a href=\"/uri\">link [foo [bar]]</a></p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Links/513",
    "[link] bar](/uri)\n",
    "<p>[link] bar](/uri)</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Links/514",
    "[link [bar](/uri)\n",
    "<p>[link <a href=\"/uri\">bar</a></p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Links/515",
    "[link \\[bar](/uri)\n",
    "<p><a href=\"/uri\">link [bar</a></p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Links/516",
    "[link *foo **bar** `#`*](/uri)\n",
    "<p><a href=\"/uri\">link <em>foo <strong>bar</strong> <code>#</code></em></a></p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Links/517",
    "[![moon](moon.jpg)](/uri)\n",
    "<p><a href=\"/uri\"><img src=\"moon.jpg\" alt=\"moon\" /></a></p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Links/518",
    "[foo [bar](/uri)](/uri)\n",
    "<p>[foo <a href=\"/uri\">bar</a>](/uri)</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Links/519",
    "[foo *[bar [baz](/uri)](/uri)*](/uri)\n",
    "<p>[foo <em>[bar <a href=\"/uri\">baz</a>](/uri)</em>](/uri)</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Links/520",
    "![[[foo](uri1)](uri2)](uri3)\n",
    "<p><img src=\"uri3\" alt=\"[foo](uri2)\" /></p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Links/521",
    "*[foo*](/uri)\n",
    "<p>*<a href=\"/uri\">foo*</a></p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Links/522",
    "[foo *bar](baz*)\n",
    "<p><a href=\"baz*\">foo *bar</a></p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Links/523",
    "*foo [bar* baz]\n",
    "<p><em>foo [bar</em> baz]</p>\n",
    std@1/markdown.default_options()
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
