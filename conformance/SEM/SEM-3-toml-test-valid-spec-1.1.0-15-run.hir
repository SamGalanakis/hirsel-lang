    s,
    "valid/spec-1.1.0/common-40",
    "[a.b.c]            # this is best practice\n[ d.e.f ]          # same as [d.e.f]\n[ g .  h  . i ]    # same as [g.h.i]\n[ j . \"ʞ\" . 'l' ]  # same as [j.\"ʞ\".'l']\n",
    "{\"a\":{\"b\":{\"c\":{}}},\"d\":{\"e\":{\"f\":{}}},\"g\":{\"h\":{\"i\":{}}},\"j\":{\"ʞ\":{\"l\":{}}}}"
  )
  failed += harness.valid(
    s,
    "valid/spec-1.1.0/common-41",
    "# [x] you\n# [x.y] don't\n# [x.y.z] need these\n[x.y.z.w] # for this to work\n\n[x] # defining a super-table afterward is ok\n",
    "{\"x\":{\"y\":{\"z\":{\"w\":{}}}}}"
  )
  failed += harness.valid(
    s,
    "valid/spec-1.1.0/common-42",
    "# VALID BUT DISCOURAGED\n[fruit.apple]\n[animal]\n[fruit.orange]\n",
    "{\"animal\":{},\"fruit\":{\"apple\":{},\"orange\":{}}}"
  )
  failed += harness.valid(
    s,
    "valid/spec-1.1.0/common-43",
    "# RECOMMENDED\n[fruit.apple]\n[fruit.orange]\n[animal]\n",
    "{\"animal\":{},\"fruit\":{\"apple\":{},\"orange\":{}}}"
  )
  failed += harness.valid(
    s,
    "valid/spec-1.1.0/common-44",
    "# Top-level table begins.\nname = \"Fido\"\nbreed = \"pug\"\n\n# Top-level table ends.\n[owner]\nname = \"Regina Dogman\"\nmember_since = 1999-08-04\n",
    "{\"breed\":{\"type\":\"string\",\"value\":\"pug\"},\"name\":{\"type\":\"string\",\"value\":\"Fido\"},\"owner\":{\"member_since\":{\"type\":\"date-local\",\"value\":\"1999-08-04\"},\"name\":{\"type\":\"string\",\"value\":\"Regina Dogman\"}}}"
  )
  failure.check(failed == 0, TextInvariant())
