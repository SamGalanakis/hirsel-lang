// rule: SEM-1
// expect: run
fn check_value(text: String, expected: i128, canonical: String) -> () uses {} {
  match time.parse(text) {
    Ok(value) => {
      failure.check(value.unix_nanoseconds == expected, Arithmetic())
      match time.to_string(value) {
        Ok(formatted) => failure.check(formatted == canonical, TextInvariant()),
        Error(_) => failure.check(false, Arithmetic()),
      }
    },
    Error(_) => failure.check(false, Arithmetic()),
  }
}

fn check_invalid(text: String) -> () uses {} {
  match time.parse(text) {
    Error(Invalid()) => (),
    _ => failure.check(false, Arithmetic()),
  }
}

pub fn main(rt: Io, args: Args) -> Result[(), ()] {
  check_value("1970-01-01T00:00:00Z", 0, "1970-01-01T00:00:00Z")
  check_value("1969-12-31t23:59:59.999999999z", -1, "1969-12-31T23:59:59.999999999Z")
  check_value(
    "2000-02-29T23:30:00.1200-01:00",
    951870600120000000,
    "2000-03-01T00:30:00.12Z"
  )
  check_value("0000-01-01T00:00:00Z", -62167219200000000000, "0000-01-01T00:00:00Z")
  check_value(
    "9999-12-31T23:59:59.999999999Z",
    253402300799999999999,
    "9999-12-31T23:59:59.999999999Z"
  )
  check_value("2000-01-01T00:00:60Z", 946684859000000000, "2000-01-01T00:00:59Z")
  check_invalid("1900-02-29T00:00:00Z")
  check_invalid("2000-01-01 00:00:00Z")
  check_invalid("2000-01-01T24:00:00Z")
  check_invalid("2000-01-01T00:00:00+24:00")
  check_invalid("2000-01-01T00:00:00.1234567890Z")
  check_invalid("2000-01-01T00:00:00.Z")
  check_invalid("2000-13-01T00:00:00Z")
  check_invalid("2000-04-31T00:00:00Z")
  Ok(())
}
