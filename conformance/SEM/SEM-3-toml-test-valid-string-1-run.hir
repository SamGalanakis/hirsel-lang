// rule: SEM-3
// expect: run
// Generated by tools/generate-toml-test.py from toml-test ff49d109861c
// tests/files-toml-1.1.0, group valid-string.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.valid(
    s,
    "valid/string/basic-escape-01",
    "# Escape \"\ntest = \"\\\"one\\\"\"\n",
    "{\"test\":{\"type\":\"string\",\"value\":\"\\\"one\\\"\"}}"
  )
  failed += harness.valid(
    s,
    "valid/string/basic-escape-02",
    "# Escape \\ and then \"\ntest = \"\\\\\\\"one\"\n",
    "{\"test\":{\"type\":\"string\",\"value\":\"\\\\\\\"one\"}}"
  )
  failed += harness.valid(
    s,
    "valid/string/basic-escape-03",
    "# Escape \\ four times and then \"\ntest = \"\\\\\\\\\\\\\\\\\\\"one\"\n",
    "{\"test\":{\"type\":\"string\",\"value\":\"\\\\\\\\\\\\\\\\\\\"one\"}}"
  )
  failed += harness.valid(
    s,
    "valid/string/empty",
    "answer = \"\"\n",
    "{\"answer\":{\"type\":\"string\",\"value\":\"\"}}"
  )
  failed += harness.valid(
    s,
    "valid/string/ends-in-whitespace-escape",
    "beee = \"\"\"\nheeee\ngeeee\\  \n\n\n      \"\"\"\n",
    "{\"beee\":{\"type\":\"string\",\"value\":\"heeee\\ngeeee\"}}"
  )
  failed += harness.valid(
    s,
    "valid/string/escape-esc",
    "esc = \"\\e There is no escape! \\e\"\n",
    "{\"esc\":{\"type\":\"string\",\"value\":\"\\u001b There is no escape! \\u001b\"}}"
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
