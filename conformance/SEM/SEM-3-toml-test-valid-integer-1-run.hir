// tests/files-toml-1.1.0, group valid-integer.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.valid(
    s,
    "valid/integer/float64-max",
    "# Maximum and minimum safe float64 natural numbers. Mainly here for\n# -int-as-float.\nmax_int =  9_007_199_254_740_991\nmin_int = -9_007_199_254_740_991\n",
    "{\"max_int\":{\"type\":\"integer\",\"value\":\"9007199254740991\"},\"min_int\":{\"type\":\"integer\",\"value\":\"-9007199254740991\"}}"
  )
  failed += harness.valid(
    s,
    "valid/integer/integer",
    "answer = 42\nposanswer = +42\nneganswer = -42\nzero = 0\n",
    "{\"answer\":{\"type\":\"integer\",\"value\":\"42\"},\"neganswer\":{\"type\":\"integer\",\"value\":\"-42\"},\"posanswer\":{\"type\":\"integer\",\"value\":\"42\"},\"zero\":{\"type\":\"integer\",\"value\":\"0\"}}"
  )
  failed += harness.valid(
    s,
    "valid/integer/literals",
    "bin1 = 0b11010110\nbin2 = 0b1_0_1\n\noct1 = 0o01234567\noct2 = 0o755\noct3 = 0o7_6_5\n\nhex1 = 0xDEADBEEF\nhex2 = 0xdeadbeef\nhex3 = 0xdead_beef\nhex4 = 0x00987\n",
    "{\"bin1\":{\"type\":\"integer\",\"value\":\"214\"},\"bin2\":{\"type\":\"integer\",\"value\":\"5\"},\"hex1\":{\"type\":\"integer\",\"value\":\"3735928559\"},\"hex2\":{\"type\":\"integer\",\"value\":\"3735928559\"},\"hex3\":{\"type\":\"integer\",\"value\":\"3735928559\"},\"hex4\":{\"type\":\"integer\",\"value\":\"2439\"},\"oct1\":{\"type\":\"integer\",\"value\":\"342391\"},\"oct2\":{\"type\":\"integer\",\"value\":\"493\"},\"oct3\":{\"type\":\"integer\",\"value\":\"501\"}}"
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
