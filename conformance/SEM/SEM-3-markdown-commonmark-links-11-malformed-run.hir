// rule: SEM-3
// expect: run
// Published spec.txt vectors; tools/generate-markdown.py.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.check(
    s,
    "commonmark/Links/531/malformed",
    "[![moon](moon.jpg)]\u{0}[&unterminated",
    "<p>[<img src=\"moon.jpg\" alt=\"moon\" />]�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Links/532/malformed",
    "[foo [bar](/uri)][\u{0}[&unterminated",
    "<p>[foo <a href=\"/uri\">bar</a>][�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Links/533/malformed",
    "[foo *bar [baz][ref]\u{0}[&unterminated",
    "<p>[foo *bar [baz][ref]�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Links/534/malformed",
    "*[foo*][ref]\n\u{0}[&unterminated",
    "<p><em>[foo</em>][ref]\n�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
