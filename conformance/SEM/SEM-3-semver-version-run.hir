// Formerly SEM-3-semver-order-run.
fn part_12(t: Test) -> Result[(), semver.SemverError] {
  // test_lt, test_gt and test_spec_order; build metadata has no precedence.
  test.equal(t, semver.compare(version("0.0.0"), version("1.2.3-alpha2")), -1)
  test.equal(t, semver.compare(version("1.2.0"), version("1.2.3-alpha2")), -1)
  test.equal(t, semver.compare(version("1.2.3-alpha1"), version("1.2.3")), -1)
  test.equal(t, semver.compare(version("1.2.3"), version("1.2.3-alpha2")), 1)
  test.equal(t, semver.compare(version("1.2.3-alpha2"), version("1.2.3-alpha2")), 0)
  test.equal(t, semver.compare(version("1.2.3+23"), version("1.2.3+42")), 0)
  let spec: List[String] = [
    "1.0.0-alpha",
    "1.0.0-alpha.1",
    "1.0.0-alpha.beta",
    "1.0.0-beta",
    "1.0.0-beta.2",
    "1.0.0-beta.11",
    "1.0.0-rc.1",
    "1.0.0"
  ]
  let mut i: u64 = 1
  while i < list.len(spec) {
    test.check_case(t, semver.compare(version(spec[i - 1]), version(spec[i])) == -1, i)
    test.check_case(t, semver.compare(version(spec[i]), version(spec[i - 1])) == 1, i)
    i += 1
  }
  let mut case: u64 = 100
  for (high, low) in npm_ordered() {
    test.check_case(t, semver.compare(version(high), version(low)) == 1, case)
    test.check_case(t, semver.compare(version(low), version(high)) == -1, case)
    case += 1
  }
  Ok(())
}

pub fn main(t: Test) -> Result[(), semver.SemverError] {
  // test_version.rs test_parse.
  test.equal(t, semver.parse(""), Error(Empty()))
  test.equal(t, semver.parse("  "), Error(Syntax(0)))
  test.equal(t, semver.parse("1"), Error(Syntax(1)))
  test.equal(t, semver.parse("1.2"), Error(Syntax(3)))
  test.equal(t, semver.parse("1.2.3-"), Error(Syntax(6)))
  test.equal(t, semver.parse("a.b.c"), Error(Syntax(0)))
  test.equal(t, semver.parse("1.2.3 abc"), Error(Syntax(5)))
  test.equal(t, semver.parse("1.2.3-01"), Error(LeadingZero(6)))
  test.equal(t, semver.parse("1.2.3++"), Error(Syntax(6)))
  test.equal(t, semver.parse("07"), Error(LeadingZero(0)))
  test.equal(t, semver.parse("111111111111111111111.0.0"), Error(Overflow(0)))
  test.equal(t, semver.parse("8\u{0}"), Error(Syntax(1)))
  test.equal(t, semver.parse("v1.2.3"), Error(Syntax(0)))
  test.equal(
    t,
    semver.parse("18446744073709551615.0.0")?.major,
    18446744073709551615u64
  )
  test.equal(
    t,
    semver.parse("1.2.3")?,
    semver.Version(major: 1, minor: 2, patch: 3, pre: "", build: "")
  )
  test.equal(
    t,
    semver.parse("1.2.3-alpha1")?,
    semver.Version(major: 1, minor: 2, patch: 3, pre: "alpha1", build: "")
  )
  test.equal(
    t,
    semver.parse("1.2.3+build5")?,
    semver.Version(major: 1, minor: 2, patch: 3, pre: "", build: "build5")
  )
  test.equal(t, semver.parse("1.2.3+5build")?.build, "5build")
  test.equal(
    t,
    semver.parse("1.2.3-alpha1+build5")?,
    semver.Version(major: 1, minor: 2, patch: 3, pre: "alpha1", build: "build5")
  )
  let long = semver.parse("1.2.3-1.alpha1.9+build5.7.3aedf")?
  test.equal(t, (long.pre, long.build), ("1.alpha1.9", "build5.7.3aedf"))
  let zero = semver.parse("1.2.3-0a.alpha1.9+05build.7.3aedf")?
  test.equal(t, (zero.pre, zero.build), ("0a.alpha1.9", "05build.7.3aedf"))
  test.equal(
    t,
    semver.parse("0.4.0-beta.1+0851523")?,
    semver.Version(major: 0, minor: 4, patch: 0, pre: "beta.1", build: "0851523")
  )
  test.equal(t, semver.parse("1.1.0-beta-10")?.pre, "beta-10")
  // test_eq, test_ne and test_display.
  test.check(t, version("1.2.3+build.42") == version("1.2.3+build.42"))
  test.check(t, version("1.2.3-alpha") != version("1.2.3-beta"))
  test.check(t, version("1.2.3+23") != version("1.2.3+42"))
  let shows: List[String] = [
    "1.2.3",
    "1.2.3-alpha1",
    "1.2.3+build.42",
    "1.2.3-alpha1+42"
  ]
  for spelling in shows {
    test.equal(t, semver.to_string(version(spelling)), spelling)
  }
  let rc = version("1.2.3-rc1")
  test.equal(t, f"{rc:*^20}", "*****1.2.3-rc1******")
  part_1(t)?
  part_2(t)?
  part_3(t)?
  part_4(t)?
  part_5(t)?
  part_6(t)?
  part_7(t)?
  part_8(t)?
  part_9(t)?
  part_10(t)?
  part_11(t)?
  part_12(t)?
  Ok(())
}
