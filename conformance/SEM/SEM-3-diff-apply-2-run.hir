      "--- old\n+++ new\n@@ -1,6 +1,6 @@\n d0\n a1\n-c0\n+b0\n e1\n e0\n c0\n@@ -8,13 +8,13 @@\n c0\n c1\n a1\n+c1\n b2\n c2\n f1\n-a0\n+x2\n f0\n b0\n-a0\n g1\n c0\n h2\n@@ -24,17 +24,20 @@\n c1\n d1\n c1\n+x2\n c1\n f2\n b0\n-c0\n d0\n f1\n+c2\n d0\n-d2\n+a1\n d2\n a1\n h2\n b2\n b1\n a0\n+c1\n+z2\n",
      "d0\na1\nb0\ne1\ne0\nc0\nf2\nc0\nc1\nj44\na1\nb2\nc2\nf1\na0\nf0\nb0\na0\nc0\nh2\ng2\nf2\nh1\nc1\nd1\nc1\nx2\nc1\nf2\nb0\nd0\nf1\nc2\nd0\na1\nd2\na1\nh2\nb2\nb1\na0\nc1\nz2\n",
      [1u64]
    )
  ]
}

pub fn main(t: Test) -> Result[(), diff.PatchError] {
  let mut case: u64 = 58
  for (source, patch, expected, rejected) in patched() {
    let applied = diff.apply(source, patch)?
    test.check_case(t, applied.text == expected && applied.rejected == rejected, case)
    case += 1
  }
  Ok(())
}
