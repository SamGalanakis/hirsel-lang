// rule: SEM-3
// expect: run
// Generated by tools/generate-toml-test.py from toml-test ff49d109861c
// tests/files-toml-1.0.0, group valid-key.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.valid(
    s,
    "valid/key/quoted-unicode",
    "\n\"\\u0000\" = \"null\"\n'\\u0000' = \"different key\"\n\"\\u0008 \\u000c \\U00000041 \\u007f \\u0080 \\u00ff \\ud7ff \\ue000 \\uffff \\U00010000 \\U0010ffff\" = \"escaped key\"\n\n\"~  ÿ ퟿  ￿ 𐀀 􏿿\" = \"basic key\"\n'l ~  ÿ ퟿  ￿ 𐀀 􏿿' = \"literal key\"\n",
    "{\"\\u0000\":{\"type\":\"string\",\"value\":\"null\"},\"\\b \\f A \u{7f}  ÿ ퟿  ￿ 𐀀 􏿿\":{\"type\":\"string\",\"value\":\"escaped key\"},\"\\\\u0000\":{\"type\":\"string\",\"value\":\"different key\"},\"l ~  ÿ ퟿  ￿ 𐀀 􏿿\":{\"type\":\"string\",\"value\":\"literal key\"},\"~  ÿ ퟿  ￿ 𐀀 􏿿\":{\"type\":\"string\",\"value\":\"basic key\"}}"
  )
  failed += harness.valid(
    s,
    "valid/key/space",
    "# Keep whitespace inside quotes keys at all positions.\n\"a b\"   = 1\n\" c d \" = 2\n\"  much \t\t  whitespace  \t\\n  \\r\\n  \" = 3\n\n[ \" tbl \" ]\n\"\\ttab\\ttab\\t\" = \"tab\"\n",
    "{\"  much \\t\\t  whitespace  \\t\\n  \\r\\n  \":{\"type\":\"integer\",\"value\":\"3\"},\" c d \":{\"type\":\"integer\",\"value\":\"2\"},\"a b\":{\"type\":\"integer\",\"value\":\"1\"},\" tbl \":{\"\\ttab\\ttab\\t\":{\"type\":\"string\",\"value\":\"tab\"}}}"
  )
  failed += harness.valid(
    s,
    "valid/key/special-chars",
    "\"=~!@$^&*()_+-`1234567890[]|/?><.,;:'=\" = 1\n",
    "{\"=~!@$^&*()_+-`1234567890[]|/?><.,;:'=\":{\"type\":\"integer\",\"value\":\"1\"}}"
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
