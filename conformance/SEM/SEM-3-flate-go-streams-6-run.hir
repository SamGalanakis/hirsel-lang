// rule: SEM-3
// expect: run
// Go src/compress/flate/flate_test.go TestStreams, cases 19-20
// (golang/go ebe2feef). Unlike Go, bytes after the final block are an error.
fn check(ok: bool) -> () uses {} {
  failure.check(ok, TextInvariant())
}

pub fn main(t: Test) -> Result[(), ()] {
  // complete HCLenTree, complete HLitTree, empty HDistTree, spanning repeater code
  check(
    flate.inflate(
      b"\xed\xfd\x87\x05\x00\x00\x00\x00 \x04\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\xe8\xb0\x00",
      1024
    ) == Error(TrailingData(43u64))
  )
  check(
    flate.inflate(
      b"\xed\xfd\x87\x05\x00\x00\x00\x00 \x04\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\xe8\xb0",
      1024
    ) == Ok(b"")
  )
  // complete HCLenTree with length codes, complete HLitTree, empty HDistTree
  check(
    flate.inflate(
      b"\xed\xe0\x01\x04\x00\x00\x00\x00\x10\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x04\x00\x00@\x00",
      1024
    ) == Ok(b"")
  )
  Ok(())
}
