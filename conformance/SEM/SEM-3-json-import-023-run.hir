// expect: run
// Generated by tools/generate-json-vectors.py; see docs/json-domain-vectors.md.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.parses(s, "n_structure_UTF8_BOM_no_data.json:1", "\u{feff}", 1)
  failed += harness.parses(s, "n_structure_angle_bracket_..json:1", "<.>", 1)
  failed += harness.parses(s, "n_structure_angle_bracket_null.json:1", "[<null>]", 1)
  failed += harness.parses(s, "n_structure_array_trailing_garbage.json:1", "[1]x", 1)
  failed += harness.parses(
    s,
    "n_structure_array_with_extra_array_close.json:1",
    "[1]]",
    1
  )
  failed += harness.parses(
    s,
    "n_structure_array_with_unclosed_string.json:1",
    "[\"asd]",
    1
  )
  failed += harness.parses(s, "n_structure_ascii-unicode-identifier.json:1", "aå", 1)
  failed += harness.parses(s, "n_structure_capitalized_True.json:1", "[True]", 1)
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
