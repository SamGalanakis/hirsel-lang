// rule: SEM-1
// expect: run
// Every concrete add-policy entry point agrees at overflow and exact boundaries.
pub fn main(t: Test) -> Result[(), ()] {
  failure.check(u8.wrapping_add(255u8, 1u8) == 0u8, Bounds())
  failure.check(u8.saturating_add(255u8, 1u8) == 255u8, Bounds())
  match u8.checked_add(255u8, 1u8) {
    None => {},
    Some(_) => failure.check(false, Bounds()),
  }
  failure.check(u8.wrapping_add(0u8, 255u8) == 255u8, Bounds())
  failure.check(u8.saturating_add(0u8, 255u8) == 255u8, Bounds())
  match u8.checked_add(0u8, 255u8) {
    Some(value) => failure.check(value == 255u8, Bounds()),
    None => failure.check(false, Bounds()),
  }
  failure.check(u16.wrapping_add(65535u16, 1u16) == 0u16, Bounds())
  failure.check(u16.saturating_add(65535u16, 1u16) == 65535u16, Bounds())
  match u16.checked_add(65535u16, 1u16) {
    None => {},
    Some(_) => failure.check(false, Bounds()),
  }
  failure.check(u16.wrapping_add(0u16, 65535u16) == 65535u16, Bounds())
  failure.check(u16.saturating_add(0u16, 65535u16) == 65535u16, Bounds())
  match u16.checked_add(0u16, 65535u16) {
    Some(value) => failure.check(value == 65535u16, Bounds()),
    None => failure.check(false, Bounds()),
  }
  failure.check(u32.wrapping_add(4294967295u32, 1u32) == 0u32, Bounds())
  failure.check(u32.saturating_add(4294967295u32, 1u32) == 4294967295u32, Bounds())
  match u32.checked_add(4294967295u32, 1u32) {
    None => {},
    Some(_) => failure.check(false, Bounds()),
  }
  failure.check(u32.wrapping_add(0u32, 4294967295u32) == 4294967295u32, Bounds())
  failure.check(u32.saturating_add(0u32, 4294967295u32) == 4294967295u32, Bounds())
  match u32.checked_add(0u32, 4294967295u32) {
    Some(value) => failure.check(value == 4294967295u32, Bounds()),
    None => failure.check(false, Bounds()),
  }
  failure.check(u64.wrapping_add(18446744073709551615u64, 1u64) == 0u64, Bounds())
  failure.check(
    u64.saturating_add(18446744073709551615u64, 1u64) == 18446744073709551615u64,
    Bounds()
  )
  match u64.checked_add(18446744073709551615u64, 1u64) {
    None => {},
    Some(_) => failure.check(false, Bounds()),
  }
  failure.check(
    u64.wrapping_add(0u64, 18446744073709551615u64) == 18446744073709551615u64,
    Bounds()
  )
  failure.check(
    u64.saturating_add(0u64, 18446744073709551615u64) == 18446744073709551615u64,
    Bounds()
  )
  match u64.checked_add(0u64, 18446744073709551615u64) {
    Some(value) => failure.check(value == 18446744073709551615u64, Bounds()),
    None => failure.check(false, Bounds()),
  }
  failure.check(
    u128.wrapping_add(340282366920938463463374607431768211455u128, 1u128) == 0u128,
    Bounds()
  )
  failure.check(
    u128.saturating_add(340282366920938463463374607431768211455u128, 1u128) == 340282366920938463463374607431768211455u128,
    Bounds()
  )
  match u128.checked_add(340282366920938463463374607431768211455u128, 1u128) {
    None => {},
    Some(_) => failure.check(false, Bounds()),
  }
  failure.check(
    u128.wrapping_add(0u128, 340282366920938463463374607431768211455u128) == 340282366920938463463374607431768211455u128,
    Bounds()
  )
  failure.check(
    u128.saturating_add(0u128, 340282366920938463463374607431768211455u128) == 340282366920938463463374607431768211455u128,
    Bounds()
  )
  match u128.checked_add(0u128, 340282366920938463463374607431768211455u128) {
    Some(value) => failure.check(
      value == 340282366920938463463374607431768211455u128,
      Bounds()
    ),
    None => failure.check(false, Bounds()),
  }
  failure.check(i8.wrapping_add(127i8, 1i8) == -128i8, Bounds())
  failure.check(i8.saturating_add(127i8, 1i8) == 127i8, Bounds())
  match i8.checked_add(127i8, 1i8) {
    None => {},
    Some(_) => failure.check(false, Bounds()),
  }
  failure.check(i8.wrapping_add(0i8, 127i8) == 127i8, Bounds())
  failure.check(i8.saturating_add(0i8, 127i8) == 127i8, Bounds())
  match i8.checked_add(0i8, 127i8) {
    Some(value) => failure.check(value == 127i8, Bounds()),
    None => failure.check(false, Bounds()),
  }
  failure.check(i8.wrapping_add(-128i8, -1i8) == 127i8, Bounds())
  failure.check(i8.saturating_add(-128i8, -1i8) == -128i8, Bounds())
  match i8.checked_add(-128i8, -1i8) {
    None => {},
    Some(_) => failure.check(false, Bounds()),
  }
  failure.check(i16.wrapping_add(32767i16, 1i16) == -32768i16, Bounds())
  failure.check(i16.saturating_add(32767i16, 1i16) == 32767i16, Bounds())
  match i16.checked_add(32767i16, 1i16) {
    None => {},
    Some(_) => failure.check(false, Bounds()),
  }
  failure.check(i16.wrapping_add(0i16, 32767i16) == 32767i16, Bounds())
  failure.check(i16.saturating_add(0i16, 32767i16) == 32767i16, Bounds())
  match i16.checked_add(0i16, 32767i16) {
    Some(value) => failure.check(value == 32767i16, Bounds()),
    None => failure.check(false, Bounds()),
  }
  failure.check(i16.wrapping_add(-32768i16, -1i16) == 32767i16, Bounds())
  failure.check(i16.saturating_add(-32768i16, -1i16) == -32768i16, Bounds())
  match i16.checked_add(-32768i16, -1i16) {
    None => {},
    Some(_) => failure.check(false, Bounds()),
  }
  failure.check(i32.wrapping_add(2147483647i32, 1i32) == -2147483648i32, Bounds())
  failure.check(i32.saturating_add(2147483647i32, 1i32) == 2147483647i32, Bounds())
  match i32.checked_add(2147483647i32, 1i32) {
    None => {},
    Some(_) => failure.check(false, Bounds()),
  }
  failure.check(i32.wrapping_add(0i32, 2147483647i32) == 2147483647i32, Bounds())
  failure.check(i32.saturating_add(0i32, 2147483647i32) == 2147483647i32, Bounds())
  match i32.checked_add(0i32, 2147483647i32) {
    Some(value) => failure.check(value == 2147483647i32, Bounds()),
    None => failure.check(false, Bounds()),
  }
  failure.check(i32.wrapping_add(-2147483648i32, -1i32) == 2147483647i32, Bounds())
  failure.check(i32.saturating_add(-2147483648i32, -1i32) == -2147483648i32, Bounds())
  match i32.checked_add(-2147483648i32, -1i32) {
    None => {},
    Some(_) => failure.check(false, Bounds()),
  }
  failure.check(
    i64.wrapping_add(9223372036854775807i64, 1i64) == -9223372036854775808i64,
    Bounds()
  )
  failure.check(
    i64.saturating_add(9223372036854775807i64, 1i64) == 9223372036854775807i64,
    Bounds()
  )
  match i64.checked_add(9223372036854775807i64, 1i64) {
    None => {},
    Some(_) => failure.check(false, Bounds()),
  }
  failure.check(
    i64.wrapping_add(0i64, 9223372036854775807i64) == 9223372036854775807i64,
    Bounds()
  )
  failure.check(
    i64.saturating_add(0i64, 9223372036854775807i64) == 9223372036854775807i64,
    Bounds()
  )
  match i64.checked_add(0i64, 9223372036854775807i64) {
    Some(value) => failure.check(value == 9223372036854775807i64, Bounds()),
    None => failure.check(false, Bounds()),
  }
  failure.check(
    i64.wrapping_add(-9223372036854775808i64, -1i64) == 9223372036854775807i64,
    Bounds()
  )
  failure.check(
    i64.saturating_add(-9223372036854775808i64, -1i64) == -9223372036854775808i64,
    Bounds()
  )
  match i64.checked_add(-9223372036854775808i64, -1i64) {
    None => {},
    Some(_) => failure.check(false, Bounds()),
  }
  failure.check(
    i128.wrapping_add(170141183460469231731687303715884105727i128, 1i128) == -170141183460469231731687303715884105728i128,
    Bounds()
  )
  failure.check(
    i128.saturating_add(170141183460469231731687303715884105727i128, 1i128) == 170141183460469231731687303715884105727i128,
    Bounds()
  )
  match i128.checked_add(170141183460469231731687303715884105727i128, 1i128) {
    None => {},
    Some(_) => failure.check(false, Bounds()),
  }
  failure.check(
    i128.wrapping_add(0i128, 170141183460469231731687303715884105727i128) == 170141183460469231731687303715884105727i128,
    Bounds()
  )
  failure.check(
    i128.saturating_add(0i128, 170141183460469231731687303715884105727i128) == 170141183460469231731687303715884105727i128,
    Bounds()
  )
  match i128.checked_add(0i128, 170141183460469231731687303715884105727i128) {
    Some(value) => failure.check(
      value == 170141183460469231731687303715884105727i128,
      Bounds()
    ),
    None => failure.check(false, Bounds()),
  }
  failure.check(
    i128.wrapping_add(-170141183460469231731687303715884105728i128, -1i128) == 170141183460469231731687303715884105727i128,
    Bounds()
  )
  failure.check(
    i128.saturating_add(-170141183460469231731687303715884105728i128, -1i128) == -170141183460469231731687303715884105728i128,
    Bounds()
  )
  match i128.checked_add(-170141183460469231731687303715884105728i128, -1i128) {
    None => {},
    Some(_) => failure.check(false, Bounds()),
  }
  Ok(())
}
