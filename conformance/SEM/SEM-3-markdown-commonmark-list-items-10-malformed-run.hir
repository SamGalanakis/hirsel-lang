// rule: SEM-3
// expect: run
// Published spec.txt vectors; tools/generate-markdown.py.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.check(
    s,
    "commonmark/List items/290/malformed",
    "  1.  A paragraph\nwith two lines.\n\n      \u{0}[&unterminated",
    "<ol>\n<li>\n<p>A paragraph\nwith two lines.</p>\n<p>�[&amp;unterminated</p>\n</li>\n</ol>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/List items/291/malformed",
    "  1.  A paragraph\n \u{0}[&unterminated",
    "<ol>\n<li>A paragraph\n�[&amp;unterminated</li>\n</ol>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/List items/292/malformed",
    "> 1. > Blockquote\u{0}[&unterminated",
    "<blockquote>\n<ol>\n<li>\n<blockquote>\n<p>Blockquote�[&amp;unterminated</p>\n</blockquote>\n</li>\n</ol>\n</blockquote>\n",
    std@1/markdown.default_options()
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
