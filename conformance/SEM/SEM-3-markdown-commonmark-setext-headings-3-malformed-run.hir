// rule: SEM-3
// expect: run
// Published spec.txt vectors; tools/generate-markdown.py.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.check(
    s,
    "commonmark/Setext headings/89/malformed",
    "Foo  \n\u{0}[&unterminated",
    "<p>Foo<br />\n�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Setext headings/90/malformed",
    "Foo\\\n\u{0}[&unterminated",
    "<p>Foo<br />\n�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Setext headings/91/malformed",
    "`Foo\n----\n`\n\n<a title=\"\u{0}[&unterminated",
    "<h2>`Foo</h2>\n<p>`</p>\n<p>&lt;a title=&quot;�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Setext headings/92/malformed",
    "> Foo\u{0}[&unterminated",
    "<blockquote>\n<p>Foo�[&amp;unterminated</p>\n</blockquote>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Setext headings/93/malformed",
    "> foo\nb\u{0}[&unterminated",
    "<blockquote>\n<p>foo\nb�[&amp;unterminated</p>\n</blockquote>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Setext headings/94/malformed",
    "- Foo\u{0}[&unterminated",
    "<ul>\n<li>Foo�[&amp;unterminated</li>\n</ul>\n",
    std@1/markdown.default_options()
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
