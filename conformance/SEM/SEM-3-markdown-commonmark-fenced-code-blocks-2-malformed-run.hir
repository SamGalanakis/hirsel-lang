// rule: SEM-3
// expect: run
// Published spec.txt vectors; tools/generate-markdown.py.
fn grant_error(take e: GrantError) -> () {}

pub fn main(rt: Io) -> Result[(), ()] {
  let s = io.stdout(rt) ? grant_error
  let mut failed: u64 = 0
  failed += harness.check(
    s,
    "commonmark/Fenced code blocks/125/malformed",
    "~~~~\naaa\n\u{0}[&unterminated",
    "<pre><code>aaa\n�[&amp;unterminated\n</code></pre>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Fenced code blocks/126/malformed",
    "``\u{0}[&unterminated",
    "<p>``�[&amp;unterminated</p>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Fenced code blocks/127/malformed",
    "`````\n\n\u{0}[&unterminated",
    "<pre><code>\n�[&amp;unterminated\n</code></pre>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Fenced code blocks/128/malformed",
    "> ```\n> \u{0}[&unterminated",
    "<blockquote>\n<pre><code>�[&amp;unterminated\n</code></pre>\n</blockquote>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Fenced code blocks/129/malformed",
    "```\n\n \u{0}[&unterminated",
    "<pre><code>\n �[&amp;unterminated\n</code></pre>\n",
    std@1/markdown.default_options()
  )
  failed += harness.check(
    s,
    "commonmark/Fenced code blocks/130/malformed",
    "```\n\u{0}[&unterminated",
    "<pre><code>�[&amp;unterminated\n</code></pre>\n",
    std@1/markdown.default_options()
  )
  failure.check(failed == 0, TextInvariant())
  Ok(())
}
