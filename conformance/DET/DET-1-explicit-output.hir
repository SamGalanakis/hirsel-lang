// rule: DET-1
// expect: run
// stdout: stable
// Given the same capability inputs "observable behaviour is identical".
pub fn main(rt: Io, args: Args) -> Result[(), LaunchError] {
  out.print(io.stdout(rt) ? Grant, "stable\n") ? Output
  Ok(())
}

pub type LaunchError = Grant(GrantError) | Output(OutputError) | Usage(ArgError) | Files(
  FileError
)
