// rule: DET-2
// expect: run
// stdout: second
// stdout: first
// Optimisation preserves "resource destruction order".
resource type Marker {
  out: Stdout,
  text: String,
}
drop(m) {
  let _ = out.print(m.out, m.text)
}

pub fn main(rt: Io, args: Args) -> Result[(), LaunchError] {
  let first = Marker(out: io.stdout(rt) ? Grant, text: "first\n")
  let second = Marker(out: io.stdout(rt) ? Grant, text: "second\n")
  Ok(())
}

pub type LaunchError = Grant(GrantError) | Output(OutputError) | Usage(ArgError) | Files(
  FileError
)
