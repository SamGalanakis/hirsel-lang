// The ALPN protocol a handshake negotiates is part of its recorded outcome, as is a refusal
// for want of a mutual protocol, so the run replays without the server.
fn client(take alpn: List[String]) -> TlsClient uses {} {
  TlsClient(roots: WebPki(), identity: None(), alpn: take alpn)
}

pub fn main(rt: Io, args: Args) -> Result[(), NetError] {
  let n = match io.net(rt) {
    Ok(n) => n,
    Error(_) => return Ok(()),
  }
  let s = net.connect(n, "localhost", 443u16, Unbounded())?
  let mut secure = tls.connect_with(n, take s, "localhost", client(["http/1.1", "h2"]))?
  let h2 = tls.negotiated_protocol(n, secure)? == Some("h2")
  let mut buffer: List[u8] = []
  let read = net.read(n, mut secure, mut buffer, 8u64)?
  tls.close(n, take secure)?
  let other = net.connect(n, "localhost", 443u16, Unbounded())?
  let refused = match tls.connect_with(n, take other, "localhost", client(["spdy/3"])) {
    Error(Tls(AlertReceived(alert))) => alert == 120u8,
    _ => false,
  }
  failure.check(h2 && read == 2u64 && refused, Arithmetic())
  Ok(())
}
