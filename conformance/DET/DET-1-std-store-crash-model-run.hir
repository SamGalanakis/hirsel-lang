// rule: DET-1
// expect: run
// steps: 3000000
// each of four rounds runs six transactions, a crash and two opens of the store
// std@1/store against a reference model: rounds of random transactions over
// eight keys, random group limits, durable() calls and compactions, each round
// stopped before a random storage write and crashed. After each reopen the
// store equals the model after some commit no earlier than the last one
// durable() acknowledged and no later than the last one committed: never part
// of a transaction, never a lost acknowledged commit.
const KEYS: u64 = 8

fn key(i: u64) -> Bytes {
  let mut out: List[u8] = [b'k']
  list.push(mut out, b'0' + int.truncate(i))
  bytes.from_list(take out)
}

// A model is the value of each key, 0 meaning absent.
fn read_state(mut s: store.Store) -> List[u64] {
  let mut state: List[u64] = []
  let snap = store.snapshot(mut s)
  for i in 0u64..KEYS {
    let v: u64 = match store.get(snap, key(i)) {
      Some(b) => int.widen(b[0]),
      None() => 0,
    }
    list.push(mut state, v)
  }
  state
}

// One round on an open store. Returns the models after each commit (the
// first is the starting model) and the index of the last acknowledged one.
fn round(
  mut s: store.Store,
  mut g: prng.Generator,
  take start: List[u64],
  first_value: u64
) -> (List[List[u64]], u64) {
  let mut next_value = first_value
  let mut history: List[List[u64]] = [copy start]
  let mut acked: u64 = 0
  let mut model = copy start
  let mut pending: List[store.Ticket] = []
  for _ in 0u64..6 {
    let mut x = store.begin(mut s)
    let writes = 1u64 + prng.u64(mut g) % 3
    for _ in 0u64..writes {
      let i = prng.u64(mut g) % KEYS
      if prng.u64(mut g) % 3 == 0 {
        txn.delete(mut x, key(i))
        model[i] = 0
      } else {
        let value = next_value % 250 + 1
        next_value += 1
        let mut v: List[u8] = []
        list.push(mut v, int.truncate(value))
        txn.put(mut x, key(i), bytes.from_list(take v))
        model[i] = value
      }
    }
    let Ok(ticket) = store.commit(mut s, take x) else {
      return (take history, acked)
    }
    list.push(mut history, copy model)
    list.push(mut pending, ticket)
    let choice = prng.u64(mut g) % 6
    if choice < 3 {
      if let Error(_) = store.durable(mut s, ticket) {
        return (take history, acked)
      }
      acked = list.len(history) - 1
    } else if choice == 3 {
      if let Error(_) = store.compact(mut s) {
        return (take history, acked)
      }
      acked = list.len(history) - 1
    }
  }
  (take history, acked)
}

pub fn main(t: Test) -> Result[(), store.StoreError] {
  let d = test.dir(t, [])
  let mut g = prng.seed(19)
  let mut model: List[u64] = [0, 0, 0, 0, 0, 0, 0, 0]
  let mut next_value: u64 = 1
  for r in 0u64..4 {
    let mut config = store.default_config()
    config.group_limit = 1u64 + prng.u64(mut g) % 3
    config.faults = StopAfterWrites(prng.u64(mut g) % 14)
    let (history, acked) = match store.open(d, config) {
      Ok(opened) => {
        let mut s = take opened
        round(mut s, mut g, copy model, next_value)
      },
      Error(_) => ([copy model], 0),
    }
    next_value += 20
    test.crash(t, d, r)
    let mut s = store.open(d, store.default_config())?
    let state = read_state(mut s)
    store.close(take s)?
    let mut matched = false
    for j in acked..list.len(history) {
      if history[j] == state {
        matched = true
      }
    }
    test.check_case(t, matched, r)
    model = take state
  }
  Ok(())
}
