// rule: RUN-3
// expect: run
// The twin of the closure: the definition's name forms the entry.
// runners: [{"name":"pool","provider":"local.threads@1","grants":null,"definitions":null}]
fn price(o: u64) -> Result[u64, String] {
  Ok(o)
}

pub fn main(rt: Io, args: Args) -> Result[(), GrantError] {
  let r = io.runner(rt, "pool")?
  failure.check(runner.compute(r, price, 1u64) == Ok(1u64), Arithmetic())
  Ok(())
}
