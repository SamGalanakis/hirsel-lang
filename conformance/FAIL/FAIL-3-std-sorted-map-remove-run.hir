// rule: FAIL-3
// expect: run
// stdout: three
// stdout: two
// stdout: one
resource type Trace {
  stdout: Stdout,
  text: String,
}
drop(x) {
  let _ = out.print(x.stdout, x.text)
}

fn compare(a: u64, b: u64) -> i32 uses {} {
  failure.check(a != 99, Bounds())
  if a < b {
    -1
  } else if a > b {
    1
  } else {
    0
  }
}

pub fn main(rt: Io, args: Args) -> Result[(), GrantError] {
  let o = io.stdout(rt)?
  let by: Order[u64] = Order(compare: compare)
  let mut m: unique SortedMap[u64, Trace] of by = sorted_map.empty(by)
  sorted_map.insert(by, mut m, 1, Trace(stdout: o, text: "one\n"))
  sorted_map.insert(by, mut m, 2, Trace(stdout: o, text: "two\n"))
  sorted_map.insert(by, mut m, 3, Trace(stdout: o, text: "three\n"))
  let _ = sorted_map.remove(by, mut m, 4)
  Ok(())
}
