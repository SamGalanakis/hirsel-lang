// rule: FAIL-3
// expect: fail MEM-14 at line 18
// stdout: duplicate
// stdout: query
// stdout: three
// stdout: two
// stdout: one
resource type Key {
  id: u64,
  stdout: Stdout,
  text: String,
}
drop(x) {
  let _ = out.print(x.stdout, x.text)
}

fn compare(a: Key, b: Key) -> i32 uses {} {
  failure.check(a.id != 99, Bounds())
  if a.id < b.id {
    -1
  } else if a.id > b.id {
    1
  } else {
    0
  }
}

pub fn main(rt: Io, args: Args) -> Result[(), GrantError] {
  let o = io.stdout(rt)?
  let by: Order[Key] = Order(compare: compare)
  let mut m: unique SortedMap[Key, String] of by = sorted_map.empty(by)
  sorted_map.insert(by, mut m, Key(id: 1, stdout: o, text: "one\n"), "one")
  sorted_map.insert(by, mut m, Key(id: 2, stdout: o, text: "two\n"), "two")
  sorted_map.insert(by, mut m, Key(id: 3, stdout: o, text: "three\n"), "three")
  sorted_map.insert(by, mut m, Key(id: 2, stdout: o, text: "duplicate\n"), "second")
  let query = Key(id: 99, stdout: o, text: "query\n")
  let value = sorted_map.get(by, m, query)
  failure.check(value == Some("second"), Bounds())
  Ok(())
}
