// rule: FAIL-4
// expect: run
// stdout: released
// Releasing a mutex also releases its owned noncopyable payload.
// Native exclusions record the missing last-handle finalizer: native mutex
// payloads are currently released at run end, which cannot implement this rule.
resource type Trace {
  stdout: Stdout,
}
drop(x) {
  let _ = out.print(x.stdout, "released\n")
}

pub fn main(rt: Io, args: Args) -> Result[(), GrantError] {
  let tasks = io.tasks(rt)?
  let stdout = io.stdout(rt)?
  let m = mutex.create(tasks, Trace(stdout: stdout))
  Ok(())
}
