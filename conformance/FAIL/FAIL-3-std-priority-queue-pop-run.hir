// rule: FAIL-3
// expect: run
// stdout: one
// stdout: three
// stdout: two
resource type Item {
  priority: i32,
  output: Stdout,
  label: String,
}
drop(x) {
  let _ = out.print(x.output, x.label)
}

@noalloc
fn compare(a: Item, b: Item) -> i32 uses {} {
  if a.priority < b.priority {
    -1
  } else if a.priority > b.priority {
    1
  } else {
    0
  }
}

@noalloc
fn compare_pop(a: Item, b: Item) -> i32 uses {} {
  failure.check(a.priority != 99, Bounds())
  compare(a, b)
}

pub fn main(rt: Io, args: Args) -> Result[(), GrantError] {
  let o = io.stdout(rt)?
  let mut h: unique priority_queue.Heap[Item] = priority_queue.empty()
  priority_queue.push(mut h, Item(priority: 1, output: o, label: "one\n"), compare)
  priority_queue.push(mut h, Item(priority: 2, output: o, label: "two\n"), compare)
  priority_queue.push(mut h, Item(priority: 3, output: o, label: "three\n"), compare)
  {
    let item = priority_queue.pop(mut h, compare_pop)
  }
  Ok(())
}
