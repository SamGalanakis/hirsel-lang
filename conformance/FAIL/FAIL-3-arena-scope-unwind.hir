// rule: FAIL-3
// expect: run
// stdout: released
// stdout: caught
// "regions and arenas opened inside are freed"; resource scope exits run during unwind.
resource type Trace {
  stdout: Stdout,
  text: String,
}
drop(x) {
  let _ = out.print(x.stdout, x.text)
}

pub fn main(rt: Io, args: Args) -> Result[(), ()] {
  let tasks = io.tasks(rt) ? grant_error
  let stdout = io.stdout(rt) ? grant_error
  let status: Result[(), Failure] = task.isolate(
    tasks,
    fn() -> () {
      arena.with(
        fn(a: Arena) -> () {
          let text: String in a = "inside"
          let value = Trace(stdout: stdout, text: "released\n")
          let n: u8 = 255
          let broken = n + 1
        }
      )
    }
  )
  let caught: bool = match status {
    Ok(value) => false,
    Error(failure) => true,
  }
  let _ = out.print(
    stdout,
    if caught {
      "caught\n"
    } else {
      "bad\n"
    }
  )
  Ok(())
}

@noalloc
fn grant_error(refusal: GrantError) -> () uses {} {
  ()
}
