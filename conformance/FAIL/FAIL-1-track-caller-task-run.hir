// rule: FAIL-1
// expect: run
@track_caller
fn child() -> u8 {
  let n: u8 = 254
  n + 1
}

pub fn main(rt: Io) -> Result[(), GrantError] {
  let tasks = io.tasks(rt) ? grant_error
  task.scope(
    tasks,
    fn(s: Scope) {
      let worker = task.async(s, child)
      let _ = task.await(s, take worker)
    }
  )
  Ok(())
}

@noalloc
fn grant_error(refusal: GrantError) -> GrantError uses {} {
  refusal
}
