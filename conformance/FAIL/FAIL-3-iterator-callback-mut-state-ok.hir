// rule: FAIL-3
// expect: run
// stdout: updated
resource type Trace {
  stdout: Stdout,
  text: String,
}
drop(x) {
  let _ = out.print(x.stdout, x.text)
}

fn step(mut s: Trace) -> Option[u8] {
  s.text = "updated\n"
  let z: u8 = 1
  let q = 1u8 / z
  None
}

pub fn main(rt: Io, args: Args) -> Result[(), GrantError] {
  let stdout = io.stdout(rt)?
  let state = Trace(stdout: stdout, text: "initial\n")
  let mut it: Iter[u8] = iter.from(take state, step)
  let first = iter.next(mut it)
  Ok(())
}
