// rule: FAIL-4
// expect: run
// stdout: payload
// stdout: sibling
// stdout: caught
// A failing last-handle finalizer still drops the payload's fields and the
// dropping task's remaining resources, then propagates to task.isolate.
resource type Trace {
  stdout: Stdout,
  text: String,
}
drop(x) {
  let _ = out.print(x.stdout, x.text)
}

resource type Parent {
  field: Trace,
}
drop(x) {
  let n: u8 = 255
  let _ = n + 1
}

pub fn main(rt: Io, args: Args) -> Result[(), GrantError] {
  let tasks = io.tasks(rt)?
  let stdout = io.stdout(rt)?
  let status: Result[(), Failure] = task.isolate(
    tasks,
    fn() -> () {
      let sibling = Trace(stdout: stdout, text: "sibling\n")
      let m = mutex.create(
        tasks,
        Parent(field: Trace(stdout: stdout, text: "payload\n"))
      )
    }
  )
  match status {
    Ok(_) => failure.check(false, Arithmetic()),
    Error(_) => {
      let _ = out.print(stdout, "caught\n")
    },
  }
  Ok(())
}
