// rule: GEN-6
// expect: reject PROV-1 at line 24
// twin: GEN/GEN-6-brand-run.hir
fn compare(a: u32, b: u32) -> i32 uses {} {
  if a < b {
    -1
  } else if a > b {
    1
  } else {
    0
  }
}

const FIRST: Order[u32] = Order(compare: compare)

const SECOND: Order[u32] = Order(compare: compare)

fn count(value: SortedMap[u32, u8] of FIRST) -> u64 uses {} {
  sorted_map.len(FIRST, value)
}

pub fn probe() -> u64 uses {} {
  let value: SortedMap[u32, u8] of SECOND = sorted_map.empty(SECOND)
  count(value)
}
