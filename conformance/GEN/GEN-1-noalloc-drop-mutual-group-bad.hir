// A recursive group's cleanup depends on its arguments: a SortedMap key
// allocates when dropped.
fn need[T: noalloc_drop](take x: T) -> () {}

type Tree[K] = Leaf | Node(List[Entry[K]])

type Entry[K] {
  key: K,
  children: Tree[K],
}

fn probe(take x: Tree[SortedMap[u8, u8]]) {
  need(take x)
}
