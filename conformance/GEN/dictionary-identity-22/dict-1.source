pub fn compare(a: u32, b: u32) -> i32 uses {} {
  if a < b { -1 } else if a > b { 1 } else { 0 }
}

pub const FIRST: Order[u32] = Order(compare: compare)

pub const SECOND: Order[u32] = Order(compare: compare)

pub type Op {
  small: fn(u32, u32) -> u32 uses {},
  wide: fn(u64, u64) -> u64 uses {},
  two: fn(Inline[u8, 2]) -> Inline[u8, 2] uses {},
  three: fn(Inline[u8, 3]) -> Inline[u8, 3] uses {},
}

pub fn left[T: plain](a: T, b: T) -> T uses {} { a }

pub fn right[T: plain](a: T, b: T) -> T uses {} { b }

pub fn bytes[n: size](value: Inline[u8, n]) -> Inline[u8, n] uses {} { value }

pub const LEFT: Op = Op(small: left, wide: left, two: bytes, three: bytes)

pub const RIGHT: Op = Op(small: right, wide: right, two: bytes, three: bytes)
