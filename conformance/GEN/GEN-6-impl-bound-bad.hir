signature Counter {
  type T: plain
  size width
  fn get(x: T) -> u64 uses {}
}

fn get_text(x: String) -> u64 uses {} {
  string.byte_len(x)
}

implementation direct: Counter {
  type T = String
  size width = 8
  get = get_text
}
