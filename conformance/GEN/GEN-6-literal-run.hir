// rule: GEN-6
// expect: run
// boundary: capture-free dictionary literals become ordinary private functions.
type Op {
  run: fn(u64) -> u64 uses {},
}

const OP: Op = Op(
  run: fn(value: u64) uses {} {
    value + 1
  }
)

const COPY: Op = Op(run: (OP).run)

pub fn main() -> Result[(), String] {
  let op = COPY
  failure.check(op.run(8) == 9, Bounds())
  Ok(())
}
