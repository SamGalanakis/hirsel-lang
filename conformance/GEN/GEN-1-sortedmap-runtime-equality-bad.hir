// rule: GEN-1
// expect: reject GEN-1 at line 9
pub fn main(rt: Io, args: Args) -> Result[(), GrantError] {
  let by = u32.order
  let mut m: SortedMap[u32, u8] of by = sorted_map.empty(by)
  u32_maps.insert(mut m, 1, 1)
  let _ = out.print(
    io.stdout(rt)?,
    if m == m {
      "eq\n"
    } else {
      "ne\n"
    }
  )
  Ok(())
}
