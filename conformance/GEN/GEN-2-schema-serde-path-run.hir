// rule: GEN-2
// expect: run
// Port of serde_path_to_error tests/deserialize.rs::test_vec at
// 7aad3f59acd6d239615ee8b315e0c666915a13bf: dependencies[1].version.
type Dependency {
  version: String,
}

fn dependency_decode(wire: std@1/json.Value, mut check: schema.CheckState) -> Result[
  Dependency,
  schema.SchemaError
] uses {} {
  schema.charge_check(mut check)?
  let Object(fields) = wire else {
    return Error(schema.invalid(mut check, "Type", Wire, "Dependency", Some("object")))
  }
  for (name, _) in fields {
    if name != "version" {
      return Error(
        schema.prefix_error(
          Field(name),
          schema.invalid(mut check, "UnknownField", Wire, "Dependency", None)
        )
      )
    }
  }
  let Some(version) = map.get(fields, "version") else {
    return Error(
      schema.prefix_error(
        Field("version"),
        schema.invalid(mut check, "Missing", Wire, "Dependency.version", None)
      )
    )
  }
  let text_boundary = schema.text_json()
  match text_boundary.decode(version, mut check) {
    Ok(value) => Ok(Dependency(version: take value)),
    Error(error) => Error(schema.prefix_error(Field("version"), take error)),
  }
}

fn dependency_encode(value: Dependency, mut check: schema.CheckState) -> Result[
  std@1/json.Value,
  schema.SchemaError
] uses {} {
  schema.charge_check(mut check)?
  let mut fields: Map[String, std@1/json.Value] = map.empty()
  let text_boundary = schema.text_json()
  let version = text_boundary.encode(value.version, mut check)?
  map.insert(mut fields, "version", take version)
  Ok(Object(take fields))
}

pub fn main() -> Result[(), ()] uses {} {
  let dependencies = schema.list_json(
    schema.Boundary(decode: dependency_decode, encode: dependency_encode)
  )
  let options = schema.default_options()
  let Error(Schema(Invalid(issues))) = schema.parse_json(
    dependencies,
    "[{\"version\":\"1.0\"},{\"version\":1}]",
    options
  ) else {
    return Error(())
  }
  let paths = schema.prefix(Field("dependencies"), take issues)
  if paths.items[0].path != [Field("dependencies"), Index(1), Field("version")] {
    return Error(())
  }
  if paths.items[0].code != "Type" {
    return Error(())
  }
  Ok(())
}
