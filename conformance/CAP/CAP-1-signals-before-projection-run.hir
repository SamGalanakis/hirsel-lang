// rule: CAP-1
// expect: signaled interrupt
// grant: clock
// signals: {"provider":"signals.script@1","kinds":["interrupt"],"script":["interrupt"]}
// stdout: sleeping
// The grant observes Interrupt, but the run never projects its Signals: the Interrupt
// delivered at the sleep's idle point, before virtual time advances, takes the default
// action and ends the run by the signal.
pub fn main(rt: Io, args: Args) -> Result[(), GrantError] {
  let stdout = io.stdout(rt)?
  let c = io.monotonic_clock(rt)?
  let now = match clock.monotonic(c) {
    Ok(now) => now,
    Error(_) => return Ok(()),
  }
  let at = match instant.checked_add(c, now, 10u64) {
    Some(at) => at,
    None() => now,
  }
  let _ = out.print(stdout, "sleeping\n")
  let _ = clock.sleep_until(c, at)
  let _ = out.print(stdout, "woke\n")
  Ok(())
}
