// rule: CAP-2
// expect: reject CLO-4 at line 29
// A carrier holds its iterator's authority, `Dir`, which a closure restricted
// to `uses {}` cannot keep.
type Source {
  dir: Dir,
  remaining: u64,
}

fn read(mut s: Source) -> Option[u64] {
  if s.remaining == 0 {
    return None
  }
  s.remaining -= 1
  match file.size(s.dir, path.of("data")) {
    Ok(n) => Some(n),
    Error(_) => None,
  }
}

fn sandbox(take g: once fn() -> () uses {}) -> () {
  g()
}

fn probe(d: Dir) -> () uses {d} {
  let pipe = carriers.wrap(iter.from(Source(dir: d, remaining: 2), read))
  sandbox(
    fn() {
      let mut held = take pipe
      let _ = carriers.next(mut held)
    }
  )
}
