// rule: CAP-1
// expect: reject CAP-1 at line 5
// A Dir names the child's working directory; it is not authority to spawn a program.
pub fn started(d: Dir) -> bool {
  match proc.spawn(
    Command(program: path.of("/bin/cat"), args: [], dir: Some(d), env: None())
  ) {
    Ok(_) => true,
    Error(_) => false,
  }
}
