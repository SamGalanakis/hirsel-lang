// rule: CAP-1
// expect: run
// An empty rule set is a Proc that runs nothing, checked before any effect.
pub fn main(rt: Io) -> Result[(), GrantError] {
  let p = io.process(rt)?
  failure.check(
    proc.run(
      p,
      Command(program: path.of("/bin/echo"), args: ["hello"], dir: None(), env: None()),
      b"",
      64,
      None()
    ) == Error(NotGranted()),
    Bounds()
  )
  let spawned: bool = match proc.spawn(
    p,
    Command(program: path.of("/bin/cat"), args: [], dir: None(), env: None())
  ) {
    Error(NotGranted()) => true,
    _ => false,
  }
  failure.check(spawned, Bounds())
  Ok(())
}
