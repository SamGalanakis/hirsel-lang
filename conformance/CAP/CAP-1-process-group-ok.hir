// rule: CAP-1
// expect: accept
// A Dir names a stage's working directory; it is not authority to spawn a pipeline.
pub fn started(p: Proc, d: Dir) -> bool {
  match proc.spawn_pipeline(
    p,
    [Command(program: path.of("/bin/cat"), args: [], dir: Some(d), env: None())],
    64u64
  ) {
    Ok(_) => true,
    Error(_) => false,
  }
}
