// rule: CAP-1
// expect: run
// entry: exercise
fn scripted(t: Test, connections: List[NetConnection], tls: PeerTls) -> Net {
  test.net(
    t,
    [
      NetPeer(
        address: "example.com",
        port: 80u16,
        resolves_to: [V4([127u8, 0u8, 0u8, 1u8])],
        tls: tls,
        connections: connections
      )
    ]
  )
}

pub fn exercise(t: Test) -> Result[(), NetError] {
  let n = scripted(t, [Open([Expect(b"yes"), Send(b"ok")])], Plain())
  let mut s = net.connect(n, "example.com", 80u16, Unbounded())?
  net.write_all(n, mut s, b"no!")?
  let mut buf: List[u8] = []
  test.check(
    t,
    match net.read(n, mut s, mut buf, 1u64) {
      Error(ConnectionReset()) => true,
      _ => false,
    }
  )
  test.check(
    t,
    match net.write_all(n, mut s, b"yes") {
      Error(ConnectionReset()) => true,
      _ => false,
    }
  )
  Ok(())
}
