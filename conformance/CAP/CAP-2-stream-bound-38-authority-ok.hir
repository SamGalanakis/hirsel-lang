// rule: CAP-2
// expect: accept
// The success/error items are inert; authority comes solely from owned state.
type Source {
  dir: Dir,
  file: File of .dir,
}

fn read(mut s: Source) -> Option[Result[Bytes, FileError]] uses {s} {
  let mut buffer: List[u8] = []
  let count = match file.read(s.dir, mut s.file, mut buffer, 1) {
    Ok(n) => n,
    Error(e) => return Some(Error(take e)),
  }
  if count == 0 {
    None
  } else {
    Some(Ok(bytes.from_list(take buffer)))
  }
}

@advance_only(input)
fn advance(mut input: stream.Flow[Bytes, stream.BoundError[FileError]]) -> Option[
  Result[Bytes, stream.BoundError[FileError]]
] uses {input} {
  stream.next(mut input)
}

fn consume(take input: stream.Flow[Bytes, stream.BoundError[FileError]]) -> () uses {input} {
  let mut flow = take input
  let _ = advance(mut flow)
  let _ = stream.to_iter(take flow)
}

fn pipeline(dir: Dir, take file: File of dir) -> () uses {dir, file} {
  consume(
    stream.bound(
      stream.from_results(iter.from(take Source(dir: dir, file: take file), read)),
      1
    )
  )
}
