// rule: CAP-2
// expect: reject CAP-2 at line 3
pub opaque type Box: plain + sendable + inert uses {} {
  s: Stdout,
}

fn sandbox(f: fn() uses {}) -> () {
  f()
}

fn need_inert[T: inert](x: T) -> () {}

pub fn main(rt: Io, args: Args) -> Result[(), GrantError] {
  let b = Box(s: io.stdout(rt)?)
  need_inert(b)
  sandbox(
    fn() uses {} {
      let _ = out.print(b.s, "effect-under-empty-uses\n")
    }
  )
  Ok(())
}
