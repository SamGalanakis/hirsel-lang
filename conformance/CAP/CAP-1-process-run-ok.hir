// rule: CAP-1
// expect: accept
// A Dir names the child's working directory; it is not authority to run a program.
pub fn status(p: Proc, d: Dir) -> Result[ProcessOutput, ProcessError] {
  proc.run(
    p,
    Command(
      program: path.of("/usr/bin/git"),
      args: ["status"],
      dir: Some(d),
      env: None()
    ),
    b"",
    65536,
    None()
  )
}
