// rule: CAP-1
// expect: accept
// A stored generic callable retains both selected actual authorities.
type Packet {
  tag: u64,
  directory: Dir,
  network: Net,
}

fn effect[S](record: S) uses {record} {}

pub fn main(d: Dir, n: Net) uses {Dir, Net} {
  let record = Packet(tag: 0u64, directory: d, network: n)
  let f: fn(Packet) -> () = effect
  f(record)
}
