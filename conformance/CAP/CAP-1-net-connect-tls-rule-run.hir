// rule: CAP-1
// expect: run
// entry: exercise
fn scripted(t: Test, connections: List[NetConnection], tls: PeerTls) -> Net {
  test.net(
    t,
    [
      NetPeer(
        address: "example.com",
        port: 80u16,
        resolves_to: [V4([127u8, 0u8, 0u8, 1u8])],
        tls: tls,
        connections: connections
      )
    ]
  )
}

pub fn exercise(t: Test) -> Result[(), NetError] {
  let n = scripted(t, [Open([]), Open([])], Certificate(["example.com"]))
  let mut s = net.connect(n, "example.com", 80u16, Unbounded())?
  test.check(
    t,
    match net.write_all(n, mut s, b"secret") {
      Error(NotGranted()) => true,
      _ => false,
    }
  )
  test.check(
    t,
    match tls.connect(n, take s, "other.com", WebPki()) {
      Error(NotGranted()) => true,
      _ => false,
    }
  )
  let plain = net.connect(n, "example.com", 80u16, Unbounded())?
  let mut secure = tls.connect(n, take plain, "example.com", WebPki())?
  net.write_all(n, mut secure, b"secret")?
  Ok(())
}
