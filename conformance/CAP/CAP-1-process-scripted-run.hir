// rule: CAP-1
// expect: run
// entry: exercise
fn output(code: i32, take stdout: Bytes) -> Result[ProcessOutput, ProcessError] {
  Ok(ProcessOutput(status: Exited(code), stdout: stdout, stderr: b""))
}

pub fn exercise(t: Test) -> Result[(), ProcessError] {
  let git = path.of("/usr/bin/git")
  let p = test.process(
    t,
    [
      ProcessScript(
        program: "/usr/bin/git",
        args: ["status"],
        outcome: output(0, b"clean\n")
      ),
      ProcessScript(
        program: "/usr/bin/git",
        args: ["status"],
        outcome: output(1, b"dirty\n")
      ),
      ProcessScript(
        program: "/usr/bin/git",
        args: ["log"],
        outcome: output(0, b"0123456789")
      ),
      ProcessScript(
        program: "/usr/bin/git",
        args: ["gc"],
        outcome: Error(PermissionDenied())
      )
    ],
    []
  )
  // Wrong paths: a search name or a noncanonical spelling is invalid input, a
  // different program is not granted, and neither consumes a script entry.
  test.check(
    t,
    proc.run(
      p,
      Command(program: path.of("git"), args: ["status"], dir: None(), env: None()),
      b"",
      64,
      None()
    ) == Error(InvalidInput())
  )
  test.check(
    t,
    proc.run(
      p,
      Command(
        program: path.of("/usr/bin/../bin/git"),
        args: ["status"],
        dir: None(),
        env: None()
      ),
      b"",
      64,
      None()
    ) == Error(InvalidInput())
  )
  test.check(
    t,
    proc.run(
      p,
      Command(
        program: path.of("/usr/bin/gti"),
        args: ["status"],
        dir: None(),
        env: None()
      ),
      b"",
      64,
      None()
    ) == Error(NotGranted())
  )
  test.check(
    t,
    proc.run(
      p,
      Command(program: git, args: ["sta\u{0}tus"], dir: None(), env: None()),
      b"",
      64,
      None()
    ) == Error(InvalidInput())
  )
  // Granted: entries serve in order, and a nonzero exit is an ordinary Ok.
  let first = proc.run(
    p,
    Command(program: git, args: ["status"], dir: None(), env: None()),
    b"input",
    64,
    None()
  )?
  test.check(t, first.status == Exited(0) && first.stdout == b"clean\n")
  test.check(
    t,
    proc.run(
      p,
      Command(program: git, args: ["status"], dir: None(), env: None()),
      b"",
      64,
      None()
    ) == output(1, b"dirty\n")
  )
  test.check(
    t,
    proc.run(
      p,
      Command(program: git, args: ["status"], dir: None(), env: None()),
      b"",
      64,
      None()
    ) == Error(NotFound())
  )
  // The bound applies to each stream; an over-long run is spent.
  test.check(
    t,
    proc.run(
      p,
      Command(program: git, args: ["log"], dir: None(), env: None()),
      b"",
      9,
      None()
    ) == Error(OutputLimit())
  )
  test.check(
    t,
    proc.run(
      p,
      Command(program: git, args: ["log"], dir: None(), env: None()),
      b"",
      10,
      None()
    ) == Error(NotFound())
  )
  test.check(
    t,
    proc.run(
      p,
      Command(program: git, args: ["gc"], dir: None(), env: None()),
      b"",
      0,
      None()
    ) == Error(PermissionDenied())
  )
  Ok(())
}
