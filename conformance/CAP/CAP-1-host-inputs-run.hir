// rule: CAP-1
// expect: run
pub fn main(e: Env, args: Args, rt: Io) -> Result[(), GrantError] {
  let s = io.stdin(rt)?
  let mut buffer: List[u8] = [7]
  failure.check(stdin.read(s, mut buffer, 0) == Error(InvalidInput()), Bounds())
  failure.check(buffer == [7], Bounds())
  let original = copy buffer
  let dest = io.stderr(rt)?
  let mut i: u64 = 0
  while i < arg.count(args) {
    let name = match arg.text(args, i) {
      Ok(text) => text,
      Error(_) => {
        failure.check(false, Bounds())
        ""
      },
    }
    let _ = err.print(dest, name)
    i += 1
  }
  let line = input.read_line(s)
  if arg.count(args) == 0 {
    failure.check(line == Ok(None()), Bounds())
  } else {
    failure.check(line == Ok(Some("λ\n")), Bounds())
    failure.check(stdin.read(s, mut buffer, 1) == Ok(1), Bounds())
    failure.check(buffer == [7, 0], Bounds())
    failure.check(input.read_all(s) == Ok(b"\xff"), Bounds())
    failure.check(env.get(e, "SET") == Ok(Some("value")), Bounds())
    failure.check(env.get(e, "UNSET") == Ok(None()), Bounds())
  }
  failure.check(original == [7], Bounds())
  failure.check(env.get(e, "SECRET") == Error(NotGranted()), Bounds())
  Ok(())
}
