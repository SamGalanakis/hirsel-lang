fn inert[T: inert](take value: T) -> () uses {} {}

fn probe(net: Net, take socket: Stream of net, limit: stream.ChunkLimit) -> () uses {net, socket} {
  let flow = stream.net_chunks(net, take socket, limit)
  inert(take flow)
}
