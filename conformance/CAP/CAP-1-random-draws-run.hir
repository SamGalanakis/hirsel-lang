// rule: CAP-1
// expect: run
// The default run grants Random under random.splitmix64@1 with seed 0. Expected
// values come from an independent SplitMix64 and Lemire model.
fn check_bytes(r: Random) -> Result[(), RandomError] {
  let empty = random.bytes(r, 0)?
  failure.check(bytes.len(empty) == 0, Arithmetic())
  let drawn = random.bytes(r, 13)?
  let expected: List[u8] = [
    175,
    205,
    29,
    123,
    57,
    168,
    32,
    226,
    244,
    101,
    185,
    161,
    106
  ]
  failure.check(bytes.len(drawn) == 13, Arithmetic())
  let mut i: u64 = 0
  while i < 13 {
    failure.check(drawn[i] == expected[i], Arithmetic())
    i += 1
  }
  Ok(())
}

fn check_samples(r: Random) -> Result[(), random.SampleError] {
  match random.u64(r) {
    Ok(value) => failure.check(value == 0x06c45d188009454f, Arithmetic()),
    Error(_) => failure.check(false, Arithmetic()),
  }
  match random.below(r, 0) {
    Error(EmptyRange()) => {},
    _ => failure.check(false, Arithmetic()),
  }
  // EmptyRange drew nothing: the next word is the fourth.
  match random.u64(r) {
    Ok(value) => failure.check(value == 0xf88bb8a8724c81ec, Arithmetic()),
    Error(_) => failure.check(false, Arithmetic()),
  }
  let small: List[u64] = [1, 3, 1, 7, 2]
  let mut i: u64 = 0
  while i < 5 {
    failure.check(random.below(r, 10)? == small[i], Arithmetic())
    i += 1
  }
  // Bound 2^63 + 1 rejects five of these eleven draws.
  let large: List[u64] = [
    0x79dc24461b465853,
    0x32bf766e9e589e84,
    0x6169937002adef7b,
    0x3e94c12e3aa9092a,
    0x61e78b8815bfbfc3,
    0x6c0d4695ad2242d6
  ]
  let mut j: u64 = 0
  while j < 6 {
    failure.check(random.below(r, 0x8000000000000001)? == large[j], Arithmetic())
    j += 1
  }
  match random.u64(r) {
    Ok(value) => failure.check(value == 0xdb01602b100b9ed7, Arithmetic()),
    Error(_) => failure.check(false, Arithmetic()),
  }
  Ok(())
}

pub fn main(rt: Io, args: Args) -> Result[(), ()] {
  match io.random(rt) {
    Ok(r) => {
      match check_bytes(r) {
        Ok(()) => {},
        Error(_) => failure.check(false, Arithmetic()),
      }
      match check_samples(r) {
        Ok(()) => {},
        Error(_) => failure.check(false, Arithmetic()),
      }
    },
    Error(_) => failure.check(false, Arithmetic()),
  }
  Ok(())
}
