// rule: CAP-1
// expect: run
pub fn main(rt: Io, args: Args) -> Result[(), GrantError] {
  let s = io.stdin(rt)?
  if arg.count(args) == 0 {
    failure.check(input.read_line(s) == Ok(None()), Bounds())
  } else {
    failure.check(input.read_line(s) == Error(InvalidUtf8()), Bounds())
    failure.check(input.read_line(s) == Ok(None()), Bounds())
  }
  Ok(())
}
