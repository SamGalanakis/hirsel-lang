// rule: CAP-1
// expect: run
// entry: exercise
// A server with two identities presents the one whose leaf names the client's SNI, and
// the first when the SNI names neither or the client sends none (an IP literal).
fn home() -> SocketAddr uses {} {
  SocketAddr(ip: V4([127u8, 0u8, 0u8, 1u8]), port: 8443u16)
}

// Self-signed P-256 identities for alpha.hirsel.test and beta.hirsel.test; they secure
// nothing.
fn alpha() -> TlsIdentity uses {} {
  TlsIdentity(
    chain: b"-----BEGIN CERTIFICATE-----\nMIIB0DCCAXegAwIBAgIUYBHLp+oGYuodLqxoxhA50xBB2UEwCgYIKoZIzj0EAwIw\nHDEaMBgGA1UEAwwRYWxwaGEuaGlyc2VsLnRlc3QwIBcNMjYxMDE4MjEwOTE0WhgP\nMjEyNjA5MjQyMTA5MTRaMBwxGjAYBgNVBAMMEWFscGhhLmhpcnNlbC50ZXN0MFkw\nEwYHKoZIzj0CAQYIKoZIzj0DAQcDQgAE7au0ixdB+sLjBrPCgisAh95HCgcGbMVj\nh0olRs0iWTPFS8RmicxQkHyT7nrRhm9/1VEf1+EwLZyPW/n7ZR1J06OBlDCBkTAd\nBgNVHQ4EFgQUR0YCm3QwnshTR7v952a9s9QJoQMwHwYDVR0jBBgwFoAUR0YCm3Qw\nnshTR7v952a9s9QJoQMwHAYDVR0RBBUwE4IRYWxwaGEuaGlyc2VsLnRlc3QwDAYD\nVR0TAQH/BAIwADAOBgNVHQ8BAf8EBAMCB4AwEwYDVR0lBAwwCgYIKwYBBQUHAwEw\nCgYIKoZIzj0EAwIDRwAwRAIgeLYTnt0CzqoZE3X9v3UgvgjC70DANY7O5SuVUuhE\nNtQCICNDEuq2R8XaAj3vjZN/foqt5Xlhl/DrvfYO4JyBeysw\n-----END CERTIFICATE-----\n",
    key: b"-----BEGIN PRIVATE KEY-----\nMIGHAgEAMBMGByqGSM49AgEGCCqGSM49AwEHBG0wawIBAQQgAQptwdbbMJ93QPZv\nROSpcV0e1bNiG70B5zkRVoKSwaehRANCAATtq7SLF0H6wuMGs8KCKwCH3kcKBwZs\nxWOHSiVGzSJZM8VLxGaJzFCQfJPuetGGb3/VUR/X4TAtnI9b+ftlHUnT\n-----END PRIVATE KEY-----\n"
  )
}

