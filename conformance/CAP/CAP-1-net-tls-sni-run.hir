fn client(i: u16, take names: List[String]) -> NetClient uses {} {
  NetClient(
    from: SocketAddr(ip: V4([192u8, 0u8, 2u8, 1u8]), port: 40000u16 + i),
    tls: Certificate(names),
    steps: [Send(b"hi")]
  )
}

fn handshake(n: Net, mut l: Listener of n) -> Result[Option[NetError], NetError] {
  let (s, _) = net.accept(n, mut l)?
  match tls.accept(
    n,
    take s,
    TlsServer(identities: [alpha(), beta()], clients: Anonymous())
  ) {
    Ok(_) => Ok(None()),
    Error(e) => Ok(Some(e)),
  }
}

pub fn exercise(t: Test) -> Result[(), NetError] {
  let n = test.net(
    t,
    [],
    [
      NetListener(
        address: "127.0.0.1",
        port: home().port,
        clients: [
          client(0u16, ["beta.hirsel.test"]),
          client(1u16, ["alpha.hirsel.test"]),
          client(2u16, ["gamma.hirsel.test", "alpha.hirsel.test"]),
          client(3u16, ["gamma.hirsel.test", "beta.hirsel.test"]),
          client(4u16, ["127.0.0.1", "alpha.hirsel.test"])
        ]
      )
    ]
  )
  let mut l = net.listen(n, home())?
  // Each SNI selects its own identity, whichever position it holds.
  test.check(t, handshake(n, mut l)? == None())
  test.check(t, handshake(n, mut l)? == None())
  // An SNI naming neither falls back to the first identity, which this client accepts and
  // the next rejects with bad_certificate.
  test.check(t, handshake(n, mut l)? == None())
  test.check(t, handshake(n, mut l)? == Some(Tls(AlertReceived(42u8))))
  // An IP literal sends no SNI: the first identity again.
  test.check(t, handshake(n, mut l)? == None())
  Ok(())
}
