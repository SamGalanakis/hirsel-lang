fn beta() -> TlsIdentity uses {} {
  TlsIdentity(
    chain: b"-----BEGIN CERTIFICATE-----\nMIIBzzCCAXSgAwIBAgIUUzLbOnuGy3GzVbVrBXKphBCMvAcwCgYIKoZIzj0EAwIw\nGzEZMBcGA1UEAwwQYmV0YS5oaXJzZWwudGVzdDAgFw0yNjEwMTgyMTA5MTRaGA8y\nMTI2MDkyNDIxMDkxNFowGzEZMBcGA1UEAwwQYmV0YS5oaXJzZWwudGVzdDBZMBMG\nByqGSM49AgEGCCqGSM49AwEHA0IABEhCKccTFEvvxoOuV9TJpt5OQHMQ53puOdEP\nwKMwrEIh1+Bt2pZOjfdZiKlQlMxwevT9Sm0qxunzlLzDGCupgVWjgZMwgZAwHQYD\nVR0OBBYEFO4RIvlzykxE3LAPFAIBKq3imQDVMB8GA1UdIwQYMBaAFO4RIvlzykxE\n3LAPFAIBKq3imQDVMBsGA1UdEQQUMBKCEGJldGEuaGlyc2VsLnRlc3QwDAYDVR0T\nAQH/BAIwADAOBgNVHQ8BAf8EBAMCB4AwEwYDVR0lBAwwCgYIKwYBBQUHAwEwCgYI\nKoZIzj0EAwIDSQAwRgIhALL/ehmqzxvFtOUiVpFTPAMWtWGpcgVjgU+gsm61hG55\nAiEAgswQRcrVDJvEDer1TwIaRMbBzwMX5DqB975G16ARPe0=\n-----END CERTIFICATE-----\n",
    key: b"-----BEGIN PRIVATE KEY-----\nMIGHAgEAMBMGByqGSM49AgEGCCqGSM49AwEHBG0wawIBAQQgNnaZ9Th9wW843Yod\nEA3EUaJa5HpyUHTuqK9/6Zs3syWhRANCAARIQinHExRL78aDrlfUyabeTkBzEOd6\nbjnRD8CjMKxCIdfgbdqWTo33WYipUJTMcHr0/UptKsbp85S8wxgrqYFV\n-----END PRIVATE KEY-----\n"
  )
}

fn peer(take address: String, take tls: PeerTls) -> NetPeer uses {} {
  NetPeer(
    address: address,
    port: 443u16,
    resolves_to: [V4([127u8, 0u8, 0u8, 1u8])],
    tls: tls,
    connections: [Open([Send(b"hi")])]
  )
}

fn serves(take identities: List[TlsIdentity]) -> PeerTls uses {} {
  Serves(TlsServer(identities: identities, clients: Anonymous(), alpn: []))
}

fn chain(n: Net, s: Stream of n) -> Result[Bytes, NetError] {
  Ok(
    match tls.peer(n, s)? {
      Some(der) => der,
      None() => b"",
    }
  )
}

pub fn main(t: Test) -> Result[(), NetError] {
  let n = test.net(
    t,
    [
      peer("beta.hirsel.test", serves([alpha(), beta()])),
      peer("127.0.0.1", serves([localhost(), alpha()])),
      peer("example.com", serves([localhost()])),
      peer("named.test", Certificate(["named.test"]))
    ],
    []
  )
  // The SNI selects beta's identity, whose DER certificate tls.peer returns; a plain
  // stream has no chain, and plaintext follows the handshake.
  let s = net.connect(n, "beta.hirsel.test", 443u16, Unbounded())?
  test.check(t, tls.peer(n, s)? == None())
  let mut secure = tls.connect(n, take s, "beta.hirsel.test", WebPki())?
  let verified = chain(n, secure)?
  test.check(
    t,
    std@1/sha256.digest_hex(verified) == "4078060b05f03fd867a0ed9b71721c0e9bb51c6d61dea9e6c385ea7065d3b6b7"
  )
  let mut buf: List[u8] = []
  test.check(t, net.read(n, mut secure, mut buf, 8u64)? == 2u64)
  // Reading EOF does not discard the verified server identity.
  test.check(t, net.read(n, mut secure, mut buf, 8u64)? == 0u64)
  test.check(t, chain(n, secure)? == verified)
  // An IP literal sends no SNI: the first identity, which names 127.0.0.1.
  let literal = net.connect(n, "127.0.0.1", 443u16, Unbounded())?
  let by_ip = tls.connect(n, take literal, "127.0.0.1", WebPki())?
  // The localhost certificate is 451 DER bytes; alpha's is 468.
  test.check(t, bytes.len(chain(n, by_ip)?) == 451u64)
  // A leaf for localhost does not name example.com.
  let other = net.connect(n, "example.com", 443u16, Unbounded())?
  test.check(
    t,
    match tls.connect(n, take other, "example.com", WebPki()) {
      Error(Tls(NameMismatch())) => true,
      _ => false,
    }
  )
  // A Certificate peer is valid by name alone and presents no certificate bytes.
  let plain = net.connect(n, "named.test", 443u16, Unbounded())?
  let named = tls.connect(n, take plain, "named.test", WebPki())?
  test.check(t, tls.peer(n, named)? == None())
  Ok(())
}
