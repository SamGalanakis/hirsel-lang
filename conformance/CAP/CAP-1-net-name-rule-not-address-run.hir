// rule: CAP-1
// expect: run
// entry: exercise
fn scripted(t: Test, connections: List[NetConnection], tls: PeerTls) -> Net {
  test.net(
    t,
    [
      NetPeer(
        address: "example.com",
        port: 80u16,
        resolves_to: [V4([127u8, 0u8, 0u8, 1u8])],
        tls: tls,
        connections: connections
      )
    ],
    []
  )
}

pub fn exercise(t: Test) -> Result[(), NetError] {
  let n = scripted(t, [Open([])], Plain())
  let addresses = net.resolve(n, "example.com", 80u16)?
  test.check(t, list.len(addresses) == 1u64)
  test.check(
    t,
    match net.connect_addr(
      n,
      SocketAddr(ip: V4([127u8, 0u8, 0u8, 1u8]), port: 80u16),
      Unbounded()
    ) {
      Error(NotGranted()) => true,
      _ => false,
    }
  )
  Ok(())
}
