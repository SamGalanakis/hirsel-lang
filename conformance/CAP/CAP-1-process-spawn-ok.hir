// rule: CAP-1
// expect: accept
// A Dir names the child's working directory; it is not authority to spawn a program.
pub fn started(p: Proc, d: Dir) -> bool {
  match proc.spawn(
    p,
    Command(
      program: path.of("/bin/cat"),
      args: [],
      dir: Some(d),
      env: None(),
      own_group: false
    )
  ) {
    Ok(_) => true,
    Error(_) => false,
  }
}
