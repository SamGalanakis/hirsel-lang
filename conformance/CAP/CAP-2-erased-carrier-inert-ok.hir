// rule: CAP-2
// expect: accept
// A carrier over a pure iterator is inert before and after it advances.
fn count(mut n: u64) -> Option[u64] {
  if n == 2 {
    return None
  }
  n += 1
  Some(n)
}

fn need[T: inert](take value: T) -> () uses {} {}

fn probe() -> () uses {} {
  let mut pipe = carriers.wrap(iter.from(0u64, count))
  let _ = carriers.next(mut pipe)
  need(take pipe)
}
