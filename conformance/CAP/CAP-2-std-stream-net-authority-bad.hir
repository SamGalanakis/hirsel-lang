// rule: CAP-2
// expect: reject CAP-2 at line 28
type Source {
  net: Net,
  socket: Stream of .net,
}

fn read(mut s: Source) -> Option[Result[Bytes, NetError]] uses {s} {
  let mut buffer: List[u8] = []
  let count = match net.read(s.net, mut s.socket, mut buffer, 1) {
    Ok(n) => n,
    Error(e) => return Some(Error(take e)),
  }
  if count == 0 {
    None
  } else {
    Some(Ok(bytes.from_list(take buffer)))
  }
}

fn inert[T: inert](take value: T) -> () uses {} {}

fn pipeline(net: Net, take socket: Stream of net) -> () uses {net, socket} {
  let mut flow = stream.from_results(
    iter.from(take Source(net: net, socket: take socket), read)
  )
  let _ = stream.next(mut flow)
  inert(stream.to_iter(take flow))
}
