// rule: CAP-1
// expect: run
// entry: main
pub type ServerError = Network(NetError) | Http(http.HttpError)

fn home() -> SocketAddr uses {} {
  SocketAddr(ip: V4([127u8, 0u8, 0u8, 1u8]), port: 8080u16)
}

fn client(port: u16, take body: Bytes, take response: Bytes) -> NetClient uses {} {
  NetClient(
    from: SocketAddr(ip: V4([192u8, 0u8, 2u8, 1u8]), port: port),
    tls: Plain(),
    steps: [Send(body), Expect(response), Close()]
  )
}

fn serve_one(tasks: Tasks, n: Net, mut listener: Listener of n) -> Result[
  u16,
  ServerError
] {
  let mut (stream, from) = net.accept(n, mut listener) ? Network
  let mut config = http.default_config()
  config.max_head_bytes = 1024
  config.max_body_bytes = 1024
  let mut connection = http.server_connection(tasks, n, take stream, config)
  let Some((current1, incoming)) = http.next_stream(mut connection, None()) ? Http else {
    return Error(Http(Closed()))
  }
  let mut exchange1 = take current1
  http.respond(mut exchange1, 200u16, [], incoming.body, true) ? Http
  Ok(from.port)
}

pub fn main(t: Test) -> Result[(), ServerError] {
  let n = test.net(
    t,
    [],
    [
      NetListener(
        address: "127.0.0.1",
        port: home().port,
        clients: [
          client(
            40001u16,
            b"POST /a HTTP/1.1\r\nContent-Length: 3\r\n\r\none",
            b"HTTP/1.1 200 \r\nContent-Length: 3\r\nConnection: close\r\n\r\none"
          ),
          client(
            40002u16,
            b"POST /b HTTP/1.1\r\nContent-Length: 3\r\n\r\ntwo",
            b"HTTP/1.1 200 \r\nContent-Length: 3\r\nConnection: close\r\n\r\ntwo"
          )
        ]
      )
    ]
  )
  let mut listener = net.listen(n, home()) ? Network
  match net.local_addr(n, listener) {
    Ok(bound) => test.check(t, bound.port == 8080u16),
    Error(_) => test.check(t, false),
  }
  let first = serve_one(test.tasks(t), n, mut listener)?
  let second = serve_one(test.tasks(t), n, mut listener)?
  test.check(t, first == 40001u16 && second == 40002u16)
  match net.accept(n, mut listener) {
    Error(ConnectionAborted()) => (),
    _ => test.check(t, false),
  }
  Ok(())
}
