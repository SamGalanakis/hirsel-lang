// rule: CAP-3
// expect: accept
// A transaction passes "a scoped capability" and bounds its result "inert".
pub fn reserve(db: Db, sku: Sku, n: u32) -> Result[Reservation, TxFailure[StockError]] {
  store.transact(
    db,
    fn(tx: Tx) {
      let have = stock.get(tx, sku)?
      if have < n {
        return Error(OutOfStock(sku))
      }
      stock.put(tx, sku, have - n)?
      Ok(reservations.insert(tx, Reservation(sku: sku, count: n))?)
    }
  )
}
