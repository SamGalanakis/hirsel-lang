// rule: CAP-1
// expect: reject CAP-1 at line 5
// A Dir names each stage's working directory; it is not authority to run a pipeline.
pub fn counted(d: Dir) -> Result[PipelineOutput, ProcessError] {
  proc.pipeline(
    [
      Command(
        program: path.of("/usr/bin/sort"),
        args: [],
        dir: Some(d),
        env: None(),
        own_group: false
      ),
      Command(
        program: path.of("/usr/bin/uniq"),
        args: ["-c"],
        dir: Some(d),
        env: None(),
        own_group: false
      )
    ],
    b"b\na\nb\n",
    65536,
    None()
  )
}
