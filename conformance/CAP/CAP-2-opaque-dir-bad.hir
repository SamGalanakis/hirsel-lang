// rule: CAP-2
// expect: reject CAP-2 at line 3
pub opaque type Box: plain + sendable + inert uses {} {
  d: Dir,
}

fn sandbox(f: fn() uses {}) -> () {
  f()
}

fn go(rt: Io) -> Result[(), FileError] {
  let d = io.dir(rt, path.of("."))?
  file.write_bytes(d, path.of("victim.txt"), b"x")?
  let b = Box(d: d)
  sandbox(
    fn() uses {} {
      let _ = file.remove(b.d, path.of("victim.txt"))
    }
  )
  let d2 = io.dir(rt, path.of("."))?
  let msg: String = match file.read_bytes(d2, path.of("victim.txt")) {
    Ok(_) => "victim still present\n",
    Error(_) => "victim removed inside uses {} closure\n",
  }
  let _ = out.print(io.stdout(rt) ? grant_error, msg)
  Ok(())
}

pub fn main(rt: Io, args: Args) -> Result[(), ()] {
  match go(rt) {
    Ok(()) => Ok(()),
    Error(_) => Error(()),
  }
}

@noalloc
fn grant_error(refusal: GrantError) -> FileError uses {} {
  NotGranted()
}
