// rule: CAP-2
// expect: accept
// The same callback may retain inert policy.
fn boundary(take maximum: u8) -> schema.Decoder[u8, u8] uses {} {
  schema.Decoder(
    decode: fn(wire: u8, mut check: schema.CheckState) -> Result[u8, schema.SchemaError] uses {} {
      if wire > maximum {
        return Error(schema.invalid(mut check, "Range", Wire, "u8", None))
      }
      Ok(wire)
    }
  )
}
