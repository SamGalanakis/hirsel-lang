// rule: CAP-2
// expect: accept
pub opaque type Box: plain + sendable uses {Stdout} {
  s: Stdout,
}

fn sandbox(f: fn() uses {Stdout}) -> () {
  f()
}

fn need_inert[T: inert](x: T) -> () {}

pub fn main(rt: Io, args: Args) -> Result[(), GrantError] {
  let b = Box(s: io.stdout(rt)?)
  sandbox(
    fn() uses {Stdout} {
      let _ = out.print(b.s, "effect-under-empty-uses\n")
    }
  )
  Ok(())
}
