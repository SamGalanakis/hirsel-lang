// rule: CAP-1
// expect: run
// entry: main
// examples/hello-web's serve loop, unmodified, against three scripted clients.
// GET and POST get the greeting, an invalid request 400, and accept after the
// last client ends the loop.
pub type ServerError = Grant(GrantError) | Network(NetError) | Http(http.HttpError)

fn serve(n: Net, mut listener: Listener of n) -> Result[(), ServerError] {
  let mut (stream, _) = net.accept(n, mut listener) ? Network
  match http.receive_request(n, mut stream, 16384, 1048576) {
    Ok(incoming) => http.respond(
      n,
      mut stream,
      200u16,
      [http.Header(name: "Content-Type", value: "text/plain")],
      b"Hello, world"
    ) ? Http,
    Error(_) => http.respond(n, mut stream, 400u16, [], b"Bad Request") ? Http,
  }
  net.close(n, take stream)
  Ok(())
}

fn client(port: u16, take request: Bytes, take response: Bytes) -> NetClient uses {} {
  NetClient(
    from: SocketAddr(ip: V4([127u8, 0u8, 0u8, 1u8]), port: port),
    steps: [Send(request), Expect(response), Close()]
  )
}

fn hello() -> Bytes uses {} {
  b"HTTP/1.1 200 \r\nContent-Type: text/plain\r\nContent-Length: 12\r\nConnection: close\r\n\r\nHello, world"
}

pub fn main(t: Test) -> Result[(), ServerError] {
  let address = SocketAddr(ip: V4([127u8, 0u8, 0u8, 1u8]), port: 8080u16)
  let n = test.net(
    t,
    [],
    [
      NetListener(
        address: address,
        clients: [
          client(50001u16, b"GET / HTTP/1.1\r\nHost: localhost\r\n\r\n", hello()),
          client(
            50002u16,
            b"POST / HTTP/1.1\r\nHost: localhost\r\nContent-Length: 3\r\n\r\nabc",
            hello()
          ),
          client(
            50003u16,
            b"BAD\x00 / HTTP/1.1\r\n\r\n",
            b"HTTP/1.1 400 \r\nContent-Length: 11\r\nConnection: close\r\n\r\nBad Request"
          )
        ]
      )
    ]
  )
  let mut listener = net.listen(
    n,
    SocketAddr(ip: V4([127u8, 0u8, 0u8, 1u8]), port: 8080u16)
  ) ? Network
  while true {
    match serve(n, mut listener) {
      Ok(()) => (),
      Error(Network(ConnectionAborted())) => return Ok(()),
      Error(e) => return Error(e),
    }
  }
  Ok(())
}
