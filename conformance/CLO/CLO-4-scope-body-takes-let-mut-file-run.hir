// rule: CLO-4
// expect: run
// "An owning once scope-body parameter may take captures without becoming global."
// A File held in a `let mut` binding, written by the caller, is taken by the scope
// body, which writes again and closes it.
pub type AppError = Grant(GrantError) | Files(FileError)

pub fn main(rt: Io) -> Result[(), AppError] {
  let tasks = io.tasks(rt) ? Grant
  let d = io.dir(rt, path.of(".")) ? Files
  let mut out = file.create(d, path.of("taken")) ? Files
  let _ = file.write(d, mut out, b"a") ? Files
  let written = task.scope(
    tasks,
    fn(s: Scope) -> Result[u64, FileError] {
      let mut owned = take out
      file.write(d, mut owned, b"b")
    }
  ) ? Files
  let bytes = file.read_bytes(d, path.of("taken")) ? Files
  failure.check(written == 1u64 && bytes == b"ab", Arithmetic())
  Ok(())
}
