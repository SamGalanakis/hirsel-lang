// rule: CLO-2
// expect: accept
// A written Iter storage contract admits replacement captures.
fn next_value(mut s: String) -> Option[u64] {
  let _ = string.byte_len(s)
  None
}

fn step(mut rt: Io) -> Option[u64] {
  None
}

fn reset(mut it: Iter[u64], take rt: Io) -> () {
  it = iter.from(take rt, step)
}

fn probe(take rt: Io, take s: String) -> Result[(), ()] {
  let mut it: Iter[u64] = iter.from(take s, next_value)
  reset(mut it, take rt)
  Ok(())
}
