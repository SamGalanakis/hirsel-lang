// rule: CLO-4
// expect: reject CLO-4 at line 11
// twin: CLO/CLO-4-stored-borrowed-capture-ok.hir
// "Returned or stored closures are global ... never borrowed parameters."
type Holder {
  action: fn() -> () uses {},
}

fn example(x: Bytes) -> Holder {
  Holder(
    action: fn() {
      let _ = x
    }
  )
}
