// rule: CLO-4
// expect: run
// grant: clock
// net: {"provider":"net.script@2","rules":[{"address":"127.0.0.1","service":"8080","operation":"listen"}],"peers":[],"listeners":[{"address":"127.0.0.1","port":8080,"clients":[{"address":"192.0.2.1","port":40001,"tls":"plain","steps":[]}]}]}
// "An owning once scope-body parameter may take captures without becoming global."
// The stream an accept destructures into a `let mut` binding is taken by the
// scope body; under a past deadline its close is canceled before any effect.
pub type AppError = Grant(GrantError) | Network(NetError)

pub fn main(rt: Io) -> Result[(), AppError] {
  let tasks = io.tasks(rt) ? Grant
  let c = io.monotonic_clock(rt) ? Grant
  let n = io.net(rt) ? Grant
  let mut listener = net.listen(
    n,
    SocketAddr(ip: V4([127u8, 0u8, 0u8, 1u8]), port: 8080u16)
  ) ? Network
  let mut (accepted, _) = net.accept(n, mut listener) ? Network
  let past_deadline = match clock.monotonic(c) {
    Ok(now) => Deadline(clock: c, at: now),
    Error(_) => return Ok(()),
  }
  let closed = task.scope_until(
    tasks,
    past_deadline,
    fn(scope: Scope) -> Result[(), NetError] {
      tls.close(n, take accepted)
    }
  )
  let canceled = match closed {
    Expired(Error(Canceled(DeadlineExceeded()))) => true,
    _ => false,
  }
  failure.check(canceled, Arithmetic())
  Ok(())
}
