// rule: CLO-4
// expect: run
// Many-callable invocations borrow the environment; handle copies retain their root.
fn invoke(take f: fn() -> ()) {
  let g = unique copy f
  g()
}

pub fn main(t: Test) -> Result[(), ()] {
  let tasks = test.tasks(t)
  let m = mutex.create(tasks, unique 0u64)
  invoke(
    fn() {
      mutex.with(
        tasks,
        m,
        fn(mut n: unique u64) uses {} {
          n += 1
        }
      )
    }
  )
  test.check(
    t,
    mutex.with(
      tasks,
      m,
      fn(mut n: unique u64) -> u64 uses {} {
        n
      }
    ) == 1
  )
  Ok(())
}
