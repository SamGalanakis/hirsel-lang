// rule: CLO-4
// expect: run
// Retained inert policy is explicit, owned and pure.
fn bounded(take allowed: List[u8]) -> schema.Boundary[u8, u8] uses {} {
  schema.Boundary(
    decode: fn(wire: u8, mut check: schema.CheckState) -> Result[u8, schema.SchemaError] uses {} {
      schema.charge_check(mut check)?
      for value in allowed {
        if value == wire {
          return Ok(wire)
        }
      }
      Error(schema.invalid(mut check, "Policy", Wire, "allowed", None))
    },
    encode: fn(value: u8, mut check: schema.CheckState) -> Result[
      u8,
      schema.SchemaError
    ] uses {} {
      schema.charge_check(mut check)?
      for wire in allowed {
        if value == wire {
          return Ok(value)
        }
      }
      Error(schema.invalid(mut check, "Policy", Wire, "allowed", None))
    }
  )
}

pub fn main() -> Result[(), ()] uses {} {
  let b = bounded([1u8, 3u8])
  let options = schema.default_options()
  let Ok(3u8) = schema.decode(b, 3u8, options) else {
    return Error(())
  }
  let Ok(1u8) = schema.encode(b, 1u8, options) else {
    return Error(())
  }
  let Error(Invalid(_)) = schema.decode(b, 2u8, options) else {
    return Error(())
  }
  let Error(Invalid(_)) = schema.encode(b, 2u8, options) else {
    return Error(())
  }
  Ok(())
}
