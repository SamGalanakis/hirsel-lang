// rule: CLO-4
// expect: reject CLO-4 at line 11
fn unproved(n: Net, mut s: Stream of n) -> () {
  // TLS uses the same Stream and net.read after tls.connect/tls.accept.
  let mut buffer: List[u8] = []
  let _ = net.read(n, mut s, mut buffer, 1)
}

@preserves_captures(s)
fn advance(n: Net, mut s: Stream of n) -> () {
  unproved(n, mut s)
}
