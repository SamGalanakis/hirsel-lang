// A shared copy changes the state's ownership evidence.
@captures(state)
fn build[S: copyable](take state: S) -> Iter[u64] {
  iter.from(
    take state,
    fn(mut held: S) -> Option[u64] {
      let shared = copy held
      None
    }
  )
}
