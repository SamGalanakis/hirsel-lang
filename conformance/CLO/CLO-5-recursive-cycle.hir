// rule: CLO-5
// expect: accept
// "Except for calls inside a recursive cycle, which are indirect."
fn apply(f: fn(u64) -> u64 uses {}, n: u64) -> u64 {
  if n == 0 {
    f(n)
  } else {
    apply(f, n - 1)
  }
}

fn example(n: u64) -> u64 {
  apply(
    fn(x: u64) {
      x + 1
    },
    n
  )
}
