// rule: CLO-3
// expect: reject CLO-3 at line 10
// "A child task borrows nothing counted from its parent."
fn example(tasks: Tasks, take xs: unique Bytes) -> () {
  task.scope(
    tasks,
    fn(s: Scope) {
      let h = task.async(
        s,
        fn() {
          let _ = xs
        }
      )
      task.await(s, take h)
    }
  )
}
