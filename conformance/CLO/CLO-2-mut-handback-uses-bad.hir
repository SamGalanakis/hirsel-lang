// rule: CLO-2
// expect: reject CLO-2 at line 25
// "Written unrestricted parameters do not meet restricted uses" (#58). A
// `mut` argument is written back through its parameter, and `set` may store a
// function holding authority, so storage typed `uses {}` cannot be handed
// to its open-`uses` parameter and then be called as `uses {}`.
fn sandbox(g: fn() -> () uses {}) -> () {
  g()
}

fn loud(rt: Stdout) -> fn() -> () {
  fn() {
    let _ = out.print(rt, "x")
  }
}

fn set(mut p: fn() -> (), rt: Stdout) -> () {
  p = loud(rt)
}

fn probe(rt: Stdout) -> () {
  let mut p: fn() -> () uses {} = fn() {
    ()
  }
  set(mut p, rt)
  sandbox(p)
}
