// rule: CLO-2
// expect: run
// Ported from Rust core::result documentation, f6c1107f.
pub fn main() -> Result[(), ()] {
  let a: Result[Result[String, u32], u32] = Ok(Ok("hello"))
  let b: Result[Result[String, u32], u32] = Ok(Error(6))
  let c: Result[Result[String, u32], u32] = Error(6)
  failure.check(results.flatten(take a) == Ok("hello"), Bounds())
  failure.check(results.flatten(take b) == Error(6u32), Bounds())
  failure.check(results.flatten(take c) == Error(6u32), Bounds())
  let nested: Result[Result[Result[String, u32], u32], u32] = Ok(Ok(Ok("hello")))
  let flattened = results.flatten(take nested)
  failure.check(flattened == Ok(Ok("hello")), Bounds())
  failure.check(results.flatten(take flattened) == Ok("hello"), Bounds())
  Ok(())
}
