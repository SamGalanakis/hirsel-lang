// rule: CLO-4
// expect: accept
// An escaping closure owns its captures, so a global function value copied
// out of borrowed storage is an owned share like any other counted copy.
// A scoped closure may make that copy and call it.
type Holder {
  action: fn() -> u64 uses {},
}

fn call_first(fs: Array[fn() -> u64 uses {}]) -> u64 {
  fn() {
    fs[0]()
  }()
}

fn call_field(h: Holder) -> u64 {
  let g = fn() {
    h.action()
  }
  g()
}

fn call_scoped(f: fn() -> u64 uses {}) -> u64 {
  let g = fn() {
    f
  }()
  g()
}
