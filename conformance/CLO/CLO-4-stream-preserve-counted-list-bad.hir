// twin: CLO/CLO-4-stream-preserve-counted-list-ok.hir
pub type Event = Data(Bytes) | Idle

resource type Request {
  input: List[Event],
}
drop(s) {}

@preserves_captures(s)
fn read(mut s: Request, take event: Event) -> () {
  list.push(mut s.input, copy event)
}
