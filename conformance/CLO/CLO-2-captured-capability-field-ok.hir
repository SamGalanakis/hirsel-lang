// rule: CLO-2
// expect: accept
// A capability read through a closure inside a restricted closure is the
// capability derived inside that frame.
type Output {
  port: Stdout,
}

@noalloc
fn port(rt: Stdout) -> Output {
  Output(port: rt)
}

pub fn main(rt: Io, args: Args) -> Result[(), GrantError] {
  let grant_stdout = io.stdout(rt)?
  let f = fn() uses {Stdout} {
    let ports = port(grant_stdout)
    out.print(
      fn() {
        ports.port
      }(),
      "ok\n"
    )
  }
  Ok(())
}
