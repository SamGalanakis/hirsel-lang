// rule: CLO-1
// expect: accept
// "Captures are borrows."
// The body knows r as a borrowed parameter, so returning it is a share local to
// the environment, as an `in r` getter of a borrowed `r` is. The closure
// binds that environment to a global r, so its result is global and owned.
type Rec {
  items: Bytes,
}

fn consume(take r: Rec) -> () {
  ()
}

fn example(take r: Rec) -> () {
  consume(
    fn() {
      r
    }()
  )
}
