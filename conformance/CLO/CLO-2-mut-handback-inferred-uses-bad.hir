// rule: CLO-2
// expect: reject CLO-2 at line 25
// twin: CLO/CLO-2-mut-handback-uses-run.hir
// An unannotated binding's type is the one inferred where it is declared.
// Here `quiet()` is `uses {}`, so the binding is, and it cannot be handed to an
// open-`uses` `mut` parameter that may store a function holding authority.
fn sandbox(g: fn() -> () uses {}) -> () {
  g()
}

fn quiet() -> fn() -> () uses {} {
  fn() {
    ()
  }
}

fn set(mut p: fn() -> (), rt: Stdout) -> () {
  p = fn() {
    let _ = out.print(rt, "x")
  }
}

fn probe(rt: Stdout) -> () {
  let mut p = quiet()
  set(mut p, rt)
  sandbox(p)
}
