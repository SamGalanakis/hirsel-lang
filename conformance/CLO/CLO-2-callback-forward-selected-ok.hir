// rule: CLO-2
// expect: accept
fn inner(f: fn() -> ()) uses {f} {
  f()
}

fn outer(f: fn() -> (), g: fn() -> ()) uses {f, g} {
  inner(g)
}

fn invoke_once(take action: once fn() -> u64) -> u64 uses {action} {
  action()
}

fn forward_once(take action: once fn() -> u64) -> u64 uses {action} {
  invoke_once(take action)
}
