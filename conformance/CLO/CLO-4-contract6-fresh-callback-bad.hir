// rule: CLO-4
// expect: reject CLO-4 at line 14
// A fresh callback cannot install an environment the selection never saw.
type Mapped[T, U] {
  inner: Iter[T],
  f: fn(T) -> U,
}

@captures(it, f)
fn map[T, U](take it: Iter[T], take f: fn(T) -> U) -> Iter[U] {
  iter.from(
    take Mapped(inner: take it, f: take f),
    fn(mut s: Mapped[T, U]) -> Option[U] {
      s.inner = iter.from(
        0u64,
        fn(mut position: u64) -> Option[T] {
          None
        }
      )
      None
    }
  )
}
