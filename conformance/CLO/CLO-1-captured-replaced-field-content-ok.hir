// rule: CLO-1
// expect: accept
// A closure knows a mutable capture's current content as its getter twin
// `get(r)` does. Once r is replaced with fresh global content, the closure's
// result is global and a take parameter may keep it. The rejected twin writes
// local content into the field after the replacement.
type Holder {
  value: Bytes,
}

fn keep(take b: Bytes) {}

fn get(r: Holder) -> Bytes in r {
  r.value
}

fn closure(take h: Holder) {
  let mut r: Holder in r = take h
  r = Holder(value: b"fresh")
  keep(
    fn() {
      r.value
    }()
  )
}

fn getter(take h: Holder) {
  let mut r: Holder in r = take h
  r = Holder(value: b"fresh")
  keep(get(r))
}
