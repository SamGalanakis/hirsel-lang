// rule: CLO-2
// expect: reject CLO-2 at line 6
// twin: CLO/CLO-2-prefetch-scope-authority-ok.hir
// Missing contract: task.scope does not forward action's selected authority.
fn scoped(tasks: Tasks, action: fn() -> ()) uses {tasks, action} {
  task.scope(
    tasks,
    fn(s: Scope) {
      action()
    }
  )
}
