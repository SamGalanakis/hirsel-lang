// rule: CLO-3
// expect: run
// net: {"provider":"net.script@2","rules":[{"address":"127.0.0.1","service":"8080","operation":"listen"}],"peers":[],"listeners":[{"address":"127.0.0.1","port":8080,"clients":[{"address":"192.0.2.1","port":40001,"tls":"plain","steps":[{"send":[104,105]},{"expect":[104,105]},"close"]}]}]}
// stdout: ok
// A Listener received by `take` moves into a child, which accepts a client and echoes it.
fn home() -> SocketAddr uses {} {
  SocketAddr(ip: V4([127u8, 0u8, 0u8, 1u8]), port: 8080u16)
}

fn echo(n: Net, take l: Listener of n) -> bool {
  let mut listener = take l
  let mut (stream, _) = match net.accept(n, mut listener) {
    Ok(accepted) => take accepted,
    Error(_) => return false,
  }
  let mut buffer: List[u8] = []
  let read = match net.read(n, mut stream, mut buffer, 2u64) {
    Ok(read) => read,
    Error(_) => return false,
  }
  let written = match net.write_all(n, mut stream, b"hi") {
    Ok(()) => true,
    Error(_) => false,
  }
  net.close(n, take stream)
  read == 2u64 && buffer == [104u8, 105u8] && written
}

fn serve(n: Net, tasks: Tasks, take l: Listener of n) -> bool {
  task.scope(
    tasks,
    fn(s: Scope) -> bool {
      let mine = take l
      let h = task.async(
        s,
        fn() -> bool {
          echo(n, take mine)
        }
      )
      task.await(s, take h)
    }
  )
}

pub fn main(rt: Io, args: Args) -> Result[(), GrantError] {
  let tasks = io.tasks(rt)?
  let n = io.net(rt)?
  let stdout = io.stdout(rt)?
  let served = match net.listen(n, home()) {
    Ok(listener) => serve(n, tasks, take listener),
    Error(_) => false,
  }
  let _ = out.print(
    stdout,
    if served {
      "ok\n"
    } else {
      "bad\n"
    }
  )
  Ok(())
}
