// rule: CLO-3
// expect: accept
// "Freeze it into a Shared ... and copy the root into each."
fn example(tasks: Tasks, take built: unique Bytes) -> () {
  let shared = shared.freeze(take built)
  task.scope(
    tasks,
    fn(s: Scope) {
      let a = task.async(
        s,
        fn() {
          let root = copy shared
          let _ = root
        }
      )
      let b = task.async(
        s,
        fn() {
          let root = copy shared
          let _ = root
        }
      )
      task.await(s, take a)
      task.await(s, take b)
    }
  )
}
