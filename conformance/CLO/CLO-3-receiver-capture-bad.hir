// rule: CLO-3
// expect: reject CLO-3 at line 10
// "Receivers by take."
fn example(tasks: Tasks, take r: Receiver[u64]) -> () {
  task.scope(
    tasks,
    fn(s: Scope) {
      let h = task.async(
        s,
        fn() {
          let _ = r
        }
      )
      task.await(s, take h)
    }
  )
}
