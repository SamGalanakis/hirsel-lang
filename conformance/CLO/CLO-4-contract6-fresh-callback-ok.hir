// rule: CLO-4
// expect: accept
// A fresh callback that only advances its state keeps the creation envelope.
type Mapped[T, U] {
  inner: Iter[T],
  f: fn(T) -> U,
}

@captures(it, f)
fn map[T, U](take it: Iter[T], take f: fn(T) -> U) -> Iter[U] {
  iter.from(
    take Mapped(inner: take it, f: take f),
    fn(mut s: Mapped[T, U]) -> Option[U] {
      match iter.next(mut s.inner) {
        Some(x) => Some(s.f(x)),
        None => None,
      }
    }
  )
}
