// rule: CLO-2
// expect: run
// stdout: ok
type Output {
  port: Stdout,
}

@noalloc
fn port(rt: Stdout) -> Output {
  Output(port: rt)
}

pub fn main(rt: Io, args: Args) -> Result[(), GrantError] {
  let grant_stdout = io.stdout(rt)?
  let f = fn() uses {Stdout} {
    let ports = port(grant_stdout)
    out.print(ports.port, "ok\n")
  }
  let _ = f()
  Ok(())
}
