// rule: CLO-4
// expect: run
// stdout: wrapped
// A closure literal receives the contextual @captures selection of its
// annotation and its body proves it.
fn count(mut position: u64) -> Option[u64] {
  if position < 3 {
    let value = position
    position += 1
    Some(value)
  } else {
    None
  }
}

fn first() -> u64 {
  let wrap: @captures(x) fn(take x: Iter[u64]) -> Iter[u64] = fn(take x: Iter[u64]) -> Iter[
    u64
  ] {
    x
  }
  let mut it = wrap(iter.from(0u64, count))
  match iter.next(mut it) {
    Some(v) => v + 1,
    None => 0,
  }
}

pub fn main(rt: Io, args: Args) -> Result[(), GrantError] {
  failure.check(first() == 1, Bounds())
  let _ = out.print(io.stdout(rt)?, "wrapped\n")
  Ok(())
}
