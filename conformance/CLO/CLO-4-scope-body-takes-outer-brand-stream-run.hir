// rule: CLO-4
// expect: run
// net: {"provider":"net.script@2","rules":[{"address":"127.0.0.1","service":"8080","operation":"listen"}],"peers":[],"listeners":[{"address":"127.0.0.1","port":8080,"clients":[{"address":"192.0.2.1","port":40001,"steps":[{"expect":[104,105]}]}]}]}
// "An owning once scope-body parameter may take captures without becoming global."
// A stream branded by the enclosing function's `Net` parameter is rebound as a
// written `let mut ... : Stream of n` inside one scope body and taken by a scope
// body nested in it.
pub type AppError = Grant(GrantError) | Network(NetError)

fn relay(tasks: Tasks, n: Net, mut listener: Listener of n) -> Result[(), NetError] {
  let mut (accepted, _) = net.accept(n, mut listener)?
  task.scope(
    tasks,
    fn(outer: Scope) -> Result[(), NetError] {
      let mut held: Stream of n = take accepted
      net.write_all(n, mut held, b"hi")?
      task.scope(
        tasks,
        fn(inner: Scope) -> Result[(), NetError] {
          tls.close(n, take held)
        }
      )
    }
  )
}

pub fn main(rt: Io) -> Result[(), AppError] {
  let tasks = io.tasks(rt) ? Grant
  let n = io.net(rt) ? Grant
  let mut listener = net.listen(
    n,
    SocketAddr(ip: V4([127u8, 0u8, 0u8, 1u8]), port: 8080u16)
  ) ? Network
  relay(tasks, n, mut listener) ? Network
  Ok(())
}
