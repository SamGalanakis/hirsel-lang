// rule: CLO-1
// expect: accept
// The same environment may be read through the closure while it lives, and
// the field may be returned directly as the content it currently holds.
type Holder {
  value: Bytes,
}

fn identity[T](x: T) -> T in x {
  x
}

fn compare(take h: Holder, seed: Bytes) -> bool {
  let mut r: Holder in r = take h
  r.value = identity(seed)
  fn() {
    r.value
  }() == b"x"
}

fn direct(take h: Holder, seed: Bytes) -> Bytes in {h, seed} {
  let mut r: Holder in r = take h
  r = Holder(value: b"fresh")
  r.value = identity(seed)
  r.value
}
