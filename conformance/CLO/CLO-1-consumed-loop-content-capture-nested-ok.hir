// rule: CLO-1
// expect: accept
// A closure over consumed local loop content is local to its environment.
// Another closure may capture it as a value local to that environment, as a
// function may pass a local argument on to a callee that uses it locally, and
// its own inferred result is then local to the same environment.
fn view(x: Bytes) -> Bytes in x {
  x
}

fn size(x: Bytes) -> u64 {
  1
}

fn pairs(p: Bytes) -> u64 {
  let xs: List[(u64, Bytes)] = [(1, view(p))]
  let mut sum: u64 = 0
  for (n, v) in take xs {
    let f = fn() {
      v
    }
    let g = fn() {
      size(f())
    }
    sum += g()
    let h = fn() {
      f()
    }
    sum += size(h())
  }
  sum
}
