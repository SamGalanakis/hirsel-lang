// rule: CLO-2
// expect: run
// Ported from Rust core::result documentation, f6c1107f.
fn square_text(take n: u32) -> Result[String, String] {
  option.ok_or(
    option.map(
      u32.checked_mul(n, n),
      fn(take sq: u32) -> String {
        u32.to_string(sq)
      }
    ),
    "overflowed"
  )
}

pub fn main() -> Result[(), ()] {
  let good: Result[u32, String] = Ok(2)
  let large: Result[u32, String] = Ok(1000000)
  let bad: Result[u32, String] = Error("not a number")
  failure.check(results.and_then(take good, square_text) == Ok("4"), Bounds())
  failure.check(
    results.and_then(take large, square_text) == Error("overflowed"),
    Bounds()
  )
  failure.check(
    results.and_then(take bad, square_text) == Error("not a number"),
    Bounds()
  )
  Ok(())
}
