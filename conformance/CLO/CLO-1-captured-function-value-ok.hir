// rule: CLO-1
// expect: accept
// A closure may return its view of a captured global function value; the
// share is as global and as sendable as the value it was captured from.
fn library(d: Dir, p: Path) -> Result[bool, FileError] {
  let read = file.read_bytes
  let same = fn() {
    read
  }()(d, p)? == read(d, p)?
  Ok(same)
}
