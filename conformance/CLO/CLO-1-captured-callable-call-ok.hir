// rule: CLO-1
// expect: accept
// A captured callable is a view of a value whose authority its creation
// fixed, so calling it through a nested closure is no more effectful.
fn probe() -> fn() -> u64 {
  let x: String in heap = "x"
  let pair = (x, 1u8)
  let inner: fn() -> u64 = fn() {
    let (s, n) = pair
    string.byte_len(s)
  }
  fn() {
    fn() {
      inner()
    }()
  }
}

fn returned() -> fn() -> u64 {
  let x: String in heap = "x"
  let pair = (x, 1u8)
  let inner: fn() -> u64 = fn() {
    let (s, n) = pair
    string.byte_len(s)
  }
  fn() {
    fn() {
      fn() {
        inner
      }()()
    }()
  }
}
