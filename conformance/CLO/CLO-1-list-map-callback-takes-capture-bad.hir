// rule: CLO-1
// expect: reject OWN-1 at line 12
// twin: CLO/CLO-4-scope-body-takes-sender-run.hir
// A list.map callback is a many callable that borrows its captures, so it cannot take a captured Sender; the twin takes it in a once callback.
pub fn main(rt: Io) -> Result[(), GrantError] {
  let tasks = io.tasks(rt)?
  let (sender, receiver): (Sender[u64], Receiver[u64]) = channel.open(tasks)
  let xs: List[u64] = [1u64, 2u64]
  let ys = list.map(
    xs,
    fn(x: u64) -> u64 {
      let mut tx = take sender
      let _ = channel.send(tasks, mut tx, x)
      x
    }
  )
  Ok(())
}
