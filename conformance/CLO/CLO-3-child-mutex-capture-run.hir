// rule: CLO-3
// expect: run
// A child closure copies its parent's Mutex handle and updates the payload.
@noalloc
fn check(x: u32) -> ()
  requires x == 1 {
  ()
}

pub fn main(rt: Io, args: Args) -> Result[(), GrantError] {
  let tasks = io.tasks(rt)?
  let m: Mutex[u32] = mutex.create(tasks, 0)
  task.scope(
    tasks,
    fn(s: Scope) {
      let h = task.async(
        s,
        fn() {
          let owned = copy m
          mutex.with(
            tasks,
            owned,
            fn(mut value: unique u32) {
              value += 1
            }
          )
        }
      )
      task.await(s, take h)
    }
  )
  check(
    mutex.with(
      tasks,
      m,
      fn(mut value: unique u32) -> u32 {
        value
      }
    )
  )
  Ok(())
}
