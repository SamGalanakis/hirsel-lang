// rule: CLO-1
// expect: run
// stdout: 15
// Nested calls return the viewed content, whose taken source is global.
// Borrowing f inside h does not place the result in h capture-slot storage.
fn view(x: String) -> String in x {
  x
}

fn total(take p: String) -> u64 {
  let xs: List[(u64, String)] = [(1, view(p)), (2, view(p))]
  let mut sum: u64 = 0
  for (n, v) in take xs {
    let f = fn() {
      v
    }
    let g = fn() {
      string.byte_len(f())
    }
    let h = fn() {
      f()
    }
    sum += n + g() + string.byte_len(h())
  }
  sum
}

pub fn main(rt: Io, args: Args) -> Result[(), GrantError] {
  let _ = out.print(io.stdout(rt)?, u64.to_string(total("abc")))
  let _ = out.print(io.stdout(rt)?, "\n")
  Ok(())
}
