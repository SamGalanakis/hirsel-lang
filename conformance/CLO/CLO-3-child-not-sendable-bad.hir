// rule: CLO-3
// expect: reject CLO-3 at line 11
// twin: CLO/CLO-3-scoped-shared-root-copy.hir
// "It captures sendable values ... by copy or take."
fn example(tasks: Tasks, take x: Bytes) -> () {
  task.scope(
    tasks,
    fn(s: Scope) {
      let h = task.async(
        s,
        fn() {
          let _ = take x
        }
      )
      task.await(s, take h)
    }
  )
}
