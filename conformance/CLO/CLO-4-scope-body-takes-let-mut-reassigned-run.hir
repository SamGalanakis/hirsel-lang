// rule: CLO-4
// expect: run
// "A global environment owns the copied or taken owner incarnations ...; ending or
// replacing the caller's bindings does not end them."
// After the scope body takes a `let mut` binding, the caller installs a new value
// in the same binding and reads it.
pub fn main(rt: Io) -> Result[(), GrantError] {
  let tasks = io.tasks(rt)?
  let mut bytes: List[u8] = [1u8, 2u8]
  let taken = task.scope(
    tasks,
    fn(s: Scope) -> u64 {
      let owned = take bytes
      list.len(owned)
    }
  )
  bytes = [3u8]
  failure.check(taken == 2u64 && list.len(bytes) == 1u64, Arithmetic())
  Ok(())
}
