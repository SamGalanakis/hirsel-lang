// rule: DROP-2
// expect: fail SEM-1 at line 11
resource type Trace {
  stdout: Stdout,
  text: String,
  boom: bool,
}
drop(x) {
  let _ = out.print(x.stdout, x.text)
  if x.boom {
    let _ = 1u8 / 0u8
  }
  ()
}

fn probe(stdout: Stdout, flag: bool) {
  let mut r = Trace(stdout: stdout, text: "old\n", boom: true)
  let later = Trace(stdout: stdout, text: "later\n", boom: false)
  if flag {
    let moved = take r
  }
  r = Trace(stdout: stdout, text: "new\n", boom: false)
}

pub fn main(rt: Io, args: Args) -> Result[(), GrantError] {
  probe(io.stdout(rt)?, false)
  Ok(())
}
