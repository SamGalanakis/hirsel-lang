// rule: DROP-2
// expect: run
// stdout: before replace
// stdout: a1
// stdout: after replace
// stdout: b
// stdout: a2
resource type Trace {
  stdout: Stdout,
  text: String,
}
drop(x) {
  let _ = out.print(x.stdout, x.text)
}

pub fn main(rt: Io, args: Args) -> Result[(), GrantError] {
  let o = io.stdout(rt)?
  let mut m: Map[u8, Trace] = map.empty()
  map.insert(mut m, 1, Trace(stdout: o, text: "a1\n"))
  map.insert(mut m, 2, Trace(stdout: o, text: "b\n"))
  let _ = out.print(o, "before replace\n")
  map.insert(mut m, 1, Trace(stdout: o, text: "a2\n"))
  let _ = out.print(o, "after replace\n")
  Ok(())
}
