// rule: DROP-2
// expect: run
// A wrapper's relation-free result moved out of its `mut` map is the
// caller's content: checked execution keeps the caller's bound for it, not
// the wrapper's access root, which ends at return (MEM-10).
resource type Token {
  label: String,
}
drop(v) {}

fn remove[V](mut m: unique SortedMap[u32, V] of u32.order, key: u32) -> unique Option[V] uses {} {
  sorted_map.remove(u32.order, mut m, key)
}

pub fn main() -> Result[(), ()] uses {} {
  let by = u32.order
  let mut m: unique SortedMap[u32, Token] of by = sorted_map.empty(by)
  sorted_map.insert(by, mut m, 1, Token(label: "owned"))
  match remove(mut m, 1) {
    Some(value) => {
      let n = string.byte_len(value.label)
    },
    None => {},
  }
  Ok(())
}
