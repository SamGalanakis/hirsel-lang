// rule: DROP-2
// expect: run
// stdout: C
// stdout: B
// stdout: A
resource type Item {
  key: u64,
  label: String,
  out: Stdout,
}
@noalloc drop(x) {
  out.print(x.out, x.label);
}

@noalloc
fn predicate(x: Item) -> bool uses {} {
  failure.check(x.key <= 3, Bounds())
  true
}

pub fn main(rt: Io, args: Args) -> Result[(), LaunchError] {
  let out = io.stdout(rt) ? Grant
  let items: List[Item] = [
    Item(key: 1, label: "A\n", out: out),
    Item(key: 2, label: "B\n", out: out),
    Item(key: 3, label: "C\n", out: out)
  ]
  list.filter(take items, predicate)
  Ok(())
}

pub type LaunchError = Grant(GrantError) | Output(OutputError)
