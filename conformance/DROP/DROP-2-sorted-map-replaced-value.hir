// rule: DROP-2
// expect: run
// stdout: before replace
// stdout: v1
// stdout: after replace
// stdout: v2
// stdout: v1b
resource type Trace {
  stdout: Stdout,
  text: String,
}
drop(x) {
  let _ = out.print(x.stdout, x.text)
}

pub fn main(rt: Io, args: Args) -> Result[(), GrantError] {
  let o = io.stdout(rt)?
  let by = u32.order
  let mut m: SortedMap[u32, Trace] of by = sorted_map.empty(by)
  u32_maps.insert(mut m, 1, Trace(stdout: o, text: "v1\n"))
  u32_maps.insert(mut m, 2, Trace(stdout: o, text: "v2\n"))
  let _ = out.print(o, "before replace\n")
  u32_maps.insert(mut m, 1, Trace(stdout: o, text: "v1b\n"))
  let _ = out.print(o, "after replace\n")
  Ok(())
}
