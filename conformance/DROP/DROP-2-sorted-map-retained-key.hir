// rule: DROP-2
// expect: run
// stdout: key retained
fn equivalent(a: u32, b: u32) -> i32 uses {} {
  0
}

pub fn main(rt: Io, args: Args) -> Result[(), GrantError] {
  let o = io.stdout(rt)?
  let by: Order[u32] = Order(compare: equivalent)
  let mut m: SortedMap[u32, u8] of by = sorted_map.empty(by)
  sorted_map.insert(by, mut m, 1, 5)
  sorted_map.insert(by, mut m, 2, 7)
  for (k, v) in m {
    if k == 1 && v == 7 {
      let _ = out.print(o, "key retained\n")
    }
  }
  Ok(())
}
