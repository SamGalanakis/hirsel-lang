// rule: DROP-2
// expect: fail MEM-14 at line 30
// stdout: 0
// stdout: 1
// stdout: source
resource type Source {
  out: Stdout,
  n: u64,
}
drop(x) {
  let _ = out.print(x.out, "source\n")
}

resource type Item {
  out: Stdout,
  n: u64,
}
drop(x) {
  let _ = out.print(x.out, u64.to_string(x.n))
  let _ = out.print(x.out, "\n")
}

fn step(mut s: Source) -> Option[Item] {
  let n = s.n
  s.n += 1
  Some(Item(out: s.out, n: n))
}

fn keep(item: Item) -> bool {
  failure.check(item.n < 1, Bounds())
  item.n == 1
}

pub fn main(rt: Io, args: Args) -> Result[(), GrantError] {
  let source = Source(out: io.stdout(rt)?, n: 0)
  let items = iter.collect(
    iter.take_n(iter.filter(iter.from(take source, step), keep), 1)
  )
  Ok(())
}
