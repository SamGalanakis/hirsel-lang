// rule: DROP-4
// expect: run
// stdout: commit
// "Fallible finalisation is an explicit consuming call"; defining module may forget.
resource type Transaction {
  stdout: Stdout,
}
drop(x) {
  let _ = out.print(x.stdout, "abort\n")
}

fn commit(take x: Transaction) -> Result[(), ()] {
  let _ = out.print(x.stdout, "commit\n")
  forget(take x)
  Ok(())
}

pub fn main(rt: Io, args: Args) -> Result[(), ()] {
  let tx = Transaction(stdout: io.stdout(rt) ? grant_error)
  commit(take tx)?
  Ok(())
}

@noalloc
fn grant_error(refusal: GrantError) -> () uses {} {
  ()
}
