// rule: DROP-2
// expect: run
// stdout: inner
// stdout: outer
// "end of the scope that owns it".
resource type Trace {
  stdout: Stdout,
  text: String,
}
drop(x) {
  let _ = out.print(x.stdout, x.text)
}

pub fn main(rt: Io, args: Args) -> Result[(), GrantError] {
  let stdout = io.stdout(rt)?
  let outer = Trace(stdout: stdout, text: "outer\n")
  let _: () = {
    let inner = Trace(stdout: stdout, text: "inner\n")
  }
  Ok(())
}
