// stdout: 31
resource type Item {
  key: u64,
  id: u64,
  output: Stdout,
}
drop(x) {
  let _ = out.print(x.output, f"{x.id}\n")
}

@noalloc
fn compare(a: Item, b: Item) -> i32 uses {} {
  if a.key < b.key {
    -1
  } else if a.key > b.key {
    1
  } else {
    0
  }
}

pub fn main(rt: Io, args: Args) -> Result[(), GrantError] {
  let o = io.stdout(rt)?
  let mut items: List[Item] = []
  for i in 0u64..40u64 {
    list.push(mut items, Item(key: (i * 7 + 13) % 11, id: i, output: o))
  }
  let mut xs = unique take items
  list.sort_stable(mut xs, compare)
  for item in take xs {
    let _ = take item
  }
  Ok(())
}
