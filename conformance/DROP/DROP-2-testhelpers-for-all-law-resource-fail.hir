}
@noalloc drop(w) {
  core@1/failure.check(w.n == 7, Arithmetic())
}

fn generate(t: Test) -> Watch {
  Watch(n: 7)
}

fn law(value: Watch) -> bool uses {} {
  core@1/failure.check(false, Arithmetic())
