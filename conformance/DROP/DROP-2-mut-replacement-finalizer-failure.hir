// rule: DROP-2
// expect: fail SEM-1 at line 11
resource type Trace {
  stdout: Stdout,
  text: String,
  boom: bool,
}
drop(x) {
  let _ = out.print(x.stdout, x.text)
  if x.boom {
    let _ = 1u8 / 0u8
  }
  ()
}

fn store(mut slot: Trace, take value: Trace) -> () {
  slot = take value
}

pub fn main(rt: Io, args: Args) -> Result[(), GrantError] {
  let stdout = io.stdout(rt)?
  let mut a = Trace(stdout: stdout, text: "old\n", boom: true)
  let b = Trace(stdout: stdout, text: "new\n", boom: false)
  store(mut a, take b)
  Ok(())
}
