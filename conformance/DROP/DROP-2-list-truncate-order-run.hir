// rule: DROP-2
// expect: run
// stdout: before
// stdout: D
// stdout: E
// stdout: three
// stdout: A
// stdout: B
// stdout: C
// stdout: zero
resource type Item {
  label: String,
  out: Stdout,
}
drop(x) {
  match out.print(x.out, x.label) {
    Ok(_) => (),
    Error(_) => failure.check(false, Bounds()),
  }
}

pub fn main(rt: Io, args: Args) -> Result[(), LaunchError] {
  let out = io.stdout(rt) ? Grant
  let mut xs: unique List[Item] = unique [
    Item(label: "A\n", out: out),
    Item(label: "B\n", out: out),
    Item(label: "C\n", out: out),
    Item(label: "D\n", out: out),
    Item(label: "E\n", out: out)
  ]
  list.truncate(mut xs, 18446744073709551615u64)
  out.print(out, "before\n") ? Output
  list.truncate(mut xs, 3)
  failure.check(list.len(xs) == 3, Bounds())
  out.print(out, "three\n") ? Output
  list.truncate(mut xs, 0)
  failure.check(list.len(xs) == 0, Bounds())
  out.print(out, "zero\n") ? Output
  Ok(())
}

pub type LaunchError = Grant(GrantError) | Output(OutputError)
