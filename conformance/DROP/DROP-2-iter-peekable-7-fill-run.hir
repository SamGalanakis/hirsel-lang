// rule: DROP-2
// expect: run
// stdout: item
// stdout: source
resource type Item {
  out: Stdout,
}
drop(item) {
  let _ = out.print(item.out, "item\n")
}

resource type Source {
  out: Stdout,
  fail: bool,
}
drop(s) {
  let _ = out.print(s.out, "source\n")
}

fn step(mut s: Source) -> Option[Item] {
  let item = Item(out: s.out)
  failure.check(!s.fail, Bounds())
  Some(take item)
}

pub fn main(rt: Io, args: Args) -> Result[(), GrantError] {
  let mut p = std@1/peekable.new(
    iter.from(Source(out: io.stdout(rt)?, fail: false), step)
  )
  let _ = std@1/peekable.fill(mut p)
  Ok(())
}
