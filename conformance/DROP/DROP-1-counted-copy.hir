// rule: DROP-1
// expect: run
// stdout: ok
// "memory is freed when unheld"; live copy retains its contents.
fn output_error[E](take e: E) -> () {}

pub fn main(rt: Io, args: Args) -> Result[(), ()] {
  let a: String = "shared"
  let b = copy a
  out.print(
    io.stdout(rt) ? grant_error,
    if a == b {
      "ok\n"
    } else {
      "bad\n"
    }
  ) ? output_error
  Ok(())
}

@noalloc
fn grant_error(refusal: GrantError) -> () uses {} {
  ()
}
