// rule: DROP-2
// expect: run
// stdout: before
// stdout: owned
// stdout: two
// stdout: after
// stdout: three
// stdout: one
resource type Trace {
  stdout: Stdout,
  text: String,
}
drop(x) {
  let _ = out.print(x.stdout, x.text)
}

pub fn main(rt: Io, args: Args) -> Result[(), GrantError] {
  let o = io.stdout(rt)?
  let mut m: unique Map[u64, Trace] = map.empty()
  map.insert(mut m, 1, Trace(stdout: o, text: "one\n"))
  map.insert(mut m, 2, Trace(stdout: o, text: "two\n"))
  map.insert(mut m, 3, Trace(stdout: o, text: "three\n"))
  failure.check(map.contains(m, 2) && !map.contains(m, 4), Bounds())
  let _ = out.print(o, "before\n")
  match map.remove(mut m, 2) {
    Some(item) => {
      let _ = out.print(o, "owned\n")
      let _ = take item
    },
    None => failure.check(false, Bounds()),
  }
  failure.check(map.len(m) == 2, Bounds())
  let _ = out.print(o, "after\n")
  Ok(())
}
