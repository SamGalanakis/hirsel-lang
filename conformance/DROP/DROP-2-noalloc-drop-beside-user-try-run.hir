// rule: DROP-2
// expect: run
// entry: exercise
resource type R: noalloc_drop {
  data: u8,
}
@noalloc drop(self) {}

fn connect(n: Net, host: String) -> Result[u8, NetError] {
  match net.connect(n, host, 80u16, Unbounded()) {
    Ok(s) => {
      net.close(n, take s)
      Ok(1u8)
    },
    Error(e) => Error(e),
  }
}

fn make(n: Net) -> Result[R, NetError] {
  let s = connect(n, "example.com")?
  Ok(R(data: 0))
}

fn scripted(t: Test, address: String) -> Net {
  test.net(
    t,
    [
      NetPeer(
        address: address,
        port: 80u16,
        resolves_to: [V4([127u8, 0u8, 0u8, 1u8])],
        tls: Plain(),
        connections: [Open([])]
      )
    ],
    []
  )
}

pub fn exercise(t: Test) -> Result[(), NetError] {
  let r = make(scripted(t, "example.com"))?
  test.check(t, r.data == 0u8)
  test.check(
    t,
    match make(scripted(t, "other.com")) {
      Error(NotGranted()) => true,
      _ => false,
    }
  )
  Ok(())
}
